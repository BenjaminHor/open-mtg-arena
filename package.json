{
  "name": "mtg-engine",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:scenarios": "vitest run --project scenarios",
    "fuzz": "node packages/cli/src/fuzz.ts",
    "replays:update": "node packages/cli/src/replays.ts",
    "golden:update": "node packages/cli/src/golden.ts update",
    "golden:add": "node packages/cli/src/golden.ts add",
    "golden:cover": "node packages/cli/src/golden-cover.ts",
    "coverage:rules": "node packages/cli/src/rules-coverage.ts",
    "bench": "node packages/cli/src/bench.ts",
    "cli": "node packages/cli/src/main.ts",
    "cards:fetch": "node --use-env-proxy packages/cards/scripts/fetch.ts",
    "cards:extract": "node packages/cards/scripts/extract.ts",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
