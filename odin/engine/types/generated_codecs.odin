decode_CastVariantPaid :: proc(v: json.Value, out: ^CastVariantPaid) -> bool {
	when COVERAGE do cov_hit("CastVariantPaid")
	if v.kind != .String do return fail("CastVariantPaid: not a string")
	str := v.text
	switch str {
	case "Ninjutsu": when COVERAGE do cov_hit("CastVariantPaid::Ninjutsu"); out^ = .Ninjutsu
	case "CommanderNinjutsu": when COVERAGE do cov_hit("CastVariantPaid::CommanderNinjutsu"); out^ = .CommanderNinjutsu
	case "Sneak": when COVERAGE do cov_hit("CastVariantPaid::Sneak"); out^ = .Sneak
	case "WebSlinging": when COVERAGE do cov_hit("CastVariantPaid::WebSlinging"); out^ = .WebSlinging
	case "Evoke": when COVERAGE do cov_hit("CastVariantPaid::Evoke"); out^ = .Evoke
	case "Suspend": when COVERAGE do cov_hit("CastVariantPaid::Suspend"); out^ = .Suspend
	case "Escape": when COVERAGE do cov_hit("CastVariantPaid::Escape"); out^ = .Escape
	case "Foretell": when COVERAGE do cov_hit("CastVariantPaid::Foretell"); out^ = .Foretell
	case "Bestow": when COVERAGE do cov_hit("CastVariantPaid::Bestow"); out^ = .Bestow
	case "Impending": when COVERAGE do cov_hit("CastVariantPaid::Impending"); out^ = .Impending
	case "Surge": when COVERAGE do cov_hit("CastVariantPaid::Surge"); out^ = .Surge
	case "Spectacle": when COVERAGE do cov_hit("CastVariantPaid::Spectacle"); out^ = .Spectacle
	case "Prowl": when COVERAGE do cov_hit("CastVariantPaid::Prowl"); out^ = .Prowl
	case "Emerge": when COVERAGE do cov_hit("CastVariantPaid::Emerge"); out^ = .Emerge
	case "Warp": when COVERAGE do cov_hit("CastVariantPaid::Warp"); out^ = .Warp
	case "Mayhem": when COVERAGE do cov_hit("CastVariantPaid::Mayhem"); out^ = .Mayhem
	case: return fail("CastVariantPaid: unknown variant")
	}
	return true
}

encode_CastVariantPaid :: proc(b: ^strings.Builder, x: CastVariantPaid) {
	@(static, rodata) NAMES := [CastVariantPaid]string{
		.Ninjutsu = "Ninjutsu",
		.CommanderNinjutsu = "CommanderNinjutsu",
		.Sneak = "Sneak",
		.WebSlinging = "WebSlinging",
		.Evoke = "Evoke",
		.Suspend = "Suspend",
		.Escape = "Escape",
		.Foretell = "Foretell",
		.Bestow = "Bestow",
		.Impending = "Impending",
		.Surge = "Surge",
		.Spectacle = "Spectacle",
		.Prowl = "Prowl",
		.Emerge = "Emerge",
		.Warp = "Warp",
		.Mayhem = "Mayhem",
	}
	json.write_string(b, NAMES[x])
}

decode_CostPaidObjectSnapshot :: proc(v: json.Value, out: ^CostPaidObjectSnapshot) -> bool {
	when COVERAGE do cov_hit("CostPaidObjectSnapshot")
	if v.kind != .Object do return fail("CostPaidObjectSnapshot: not an object")
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("CostPaidObjectSnapshot.object_id") } else { return fail("CostPaidObjectSnapshot.object_id missing") }
	if fv, found := get_any(v, "lki"); found { if !decode_LKISnapshot(fv, &out.lki) do return fail("CostPaidObjectSnapshot.lki") } else { return fail("CostPaidObjectSnapshot.lki missing") }
	if fv, found := get_any(v, "incarnation"); found { if !decode_u64(fv, &out.incarnation) do return fail("CostPaidObjectSnapshot.incarnation") } else { out.incarnation = default_CostPaidObjectSnapshot_legacy_incarnation() }
	return true
}

encode_CostPaidObjectSnapshot :: proc(b: ^strings.Builder, x: CostPaidObjectSnapshot) {
	strings.write_byte(b, '{')
	f := true
	encode_CostPaidObjectSnapshot_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CostPaidObjectSnapshot_members :: proc(b: ^strings.Builder, x: CostPaidObjectSnapshot, first: ^bool) {
	member(b, first, "object_id"); encode_ObjectId(b, x.object_id)
	member(b, first, "lki"); encode_LKISnapshot(b, x.lki)
	member(b, first, "incarnation"); encode_u64(b, x.incarnation)
}

