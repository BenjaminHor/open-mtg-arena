decode_TriggeredAbilityProvenance :: proc(v: json.Value, out: ^TriggeredAbilityProvenance) -> bool {
	when COVERAGE do cov_hit("TriggeredAbilityProvenance")
	if v.kind != .Object do return fail("TriggeredAbilityProvenance: not an object")
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("TriggeredAbilityProvenance.source_id") } else { return fail("TriggeredAbilityProvenance.source_id missing") }
	if fv, found := get_any(v, "ability"); found { if !dec_ptr_ResolvedAbility(fv, &out.ability) do return fail("TriggeredAbilityProvenance.ability") } else { return fail("TriggeredAbilityProvenance.ability missing") }
	if fv, found := get_any(v, "condition"); found { if !dec_opt_TriggerCondition(fv, &out.condition) do return fail("TriggeredAbilityProvenance.condition") }
	if fv, found := get_any(v, "trigger_event"); found { if !dec_opt_GameEvent(fv, &out.trigger_event) do return fail("TriggeredAbilityProvenance.trigger_event") }
	if fv, found := get_any(v, "description"); found { if !dec_opt_string(fv, &out.description) do return fail("TriggeredAbilityProvenance.description") }
	if fv, found := get_any(v, "source_name"); found { if !decode_string(fv, &out.source_name) do return fail("TriggeredAbilityProvenance.source_name") } else { return fail("TriggeredAbilityProvenance.source_name missing") }
	if fv, found := get_any(v, "subject_match_count"); found { if !dec_opt_u32(fv, &out.subject_match_count) do return fail("TriggeredAbilityProvenance.subject_match_count") }
	if fv, found := get_any(v, "die_result"); found { if !dec_opt_i32(fv, &out.die_result) do return fail("TriggeredAbilityProvenance.die_result") }
	if fv, found := get_any(v, "provenance"); found { if !dec_opt_SyntheticTriggerProvenance(fv, &out.provenance) do return fail("TriggeredAbilityProvenance.provenance") }
	return true
}

