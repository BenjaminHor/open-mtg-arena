		tmp: DelayedTriggerCondition_WhenDies
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DelayedTriggerCondition_WhenDies) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("DelayedTriggerCondition::WhenDies.filter") } else { return fail("DelayedTriggerCondition::WhenDies.filter missing") }
	return true
		}) { return fail("DelayedTriggerCondition::WhenDies") }
		out^ = tmp
	case "WhenLeavesPlayFiltered": when COVERAGE do cov_hit("DelayedTriggerCondition::WhenLeavesPlayFiltered");
