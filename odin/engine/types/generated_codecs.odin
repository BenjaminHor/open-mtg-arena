		tmp: GameEvent_PowerToughnessChanged
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameEvent_PowerToughnessChanged) -> bool {
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("GameEvent::PowerToughnessChanged.object_id") } else { return fail("GameEvent::PowerToughnessChanged.object_id missing") }
	if fv, found := get_any(v, "power"); found { if !decode_i32(fv, &out.power) do return fail("GameEvent::PowerToughnessChanged.power") } else { return fail("GameEvent::PowerToughnessChanged.power missing") }
	if fv, found := get_any(v, "toughness"); found { if !decode_i32(fv, &out.toughness) do return fail("GameEvent::PowerToughnessChanged.toughness") } else { return fail("GameEvent::PowerToughnessChanged.toughness missing") }
	if fv, found := get_any(v, "power_delta"); found { if !decode_i32(fv, &out.power_delta) do return fail("GameEvent::PowerToughnessChanged.power_delta") } else { return fail("GameEvent::PowerToughnessChanged.power_delta missing") }
	if fv, found := get_any(v, "toughness_delta"); found { if !decode_i32(fv, &out.toughness_delta) do return fail("GameEvent::PowerToughnessChanged.toughness_delta") } else { return fail("GameEvent::PowerToughnessChanged.toughness_delta missing") }
	return true
		}) { return fail("GameEvent::PowerToughnessChanged") }
		out^ = tmp
	case "CascadeMissed": when COVERAGE do cov_hit("GameEvent::CascadeMissed");
		tmp: GameEvent_CascadeMissed
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameEvent_CascadeMissed) -> bool {
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("GameEvent::CascadeMissed.controller") } else { return fail("GameEvent::CascadeMissed.controller missing") }
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("GameEvent::CascadeMissed.source_id") } else { return fail("GameEvent::CascadeMissed.source_id missing") }
	if fv, found := get_any(v, "exiled_count"); found { if !decode_u32(fv, &out.exiled_count) do return fail("GameEvent::CascadeMissed.exiled_count") } else { return fail("GameEvent::CascadeMissed.exiled_count missing") }
	return true
		}) { return fail("GameEvent::CascadeMissed") }
		out^ = tmp
	case "DebugActionUsed": when COVERAGE do cov_hit("GameEvent::DebugActionUsed");
		tmp: GameEvent_DebugActionUsed
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameEvent_DebugActionUsed) -> bool {
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("GameEvent::DebugActionUsed.player_id") } else { return fail("GameEvent::DebugActionUsed.player_id missing") }
	if fv, found := get_any(v, "description"); found { if !decode_string(fv, &out.description) do return fail("GameEvent::DebugActionUsed.description") } else { return fail("GameEvent::DebugActionUsed.description missing") }
	return true
		}) { return fail("GameEvent::DebugActionUsed") }
		out^ = tmp
	case "DebugPermissionGranted": when COVERAGE do cov_hit("GameEvent::DebugPermissionGranted");
		tmp: GameEvent_DebugPermissionGranted
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameEvent_DebugPermissionGranted) -> bool {
	if fv, found := get_any(v, "host"); found { if !decode_PlayerId(fv, &out.host) do return fail("GameEvent::DebugPermissionGranted.host") } else { return fail("GameEvent::DebugPermissionGranted.host missing") }
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("GameEvent::DebugPermissionGranted.player_id") } else { return fail("GameEvent::DebugPermissionGranted.player_id missing") }
	return true
		}) { return fail("GameEvent::DebugPermissionGranted") }
		out^ = tmp
	case "DebugPermissionRevoked": when COVERAGE do cov_hit("GameEvent::DebugPermissionRevoked");
		tmp: GameEvent_DebugPermissionRevoked
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameEvent_DebugPermissionRevoked) -> bool {
	if fv, found := get_any(v, "host"); found { if !decode_PlayerId(fv, &out.host) do return fail("GameEvent::DebugPermissionRevoked.host") } else { return fail("GameEvent::DebugPermissionRevoked.host missing") }
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("GameEvent::DebugPermissionRevoked.player_id") } else { return fail("GameEvent::DebugPermissionRevoked.player_id missing") }
	return true
		}) { return fail("GameEvent::DebugPermissionRevoked") }
		out^ = tmp
	case: return fail("GameEvent: unknown variant")
	}
	return true
}

encode_GameEvent :: proc(b: ^strings.Builder, x: GameEvent) {
	#partial switch y in x {
	case GameEvent_GameStarted: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "GameStarted"); strings.write_byte(b, '}')
	case GameEvent_HiddenSearchViewed: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HiddenSearchViewed"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "searcher"); encode_PlayerId(b, y.searcher)
	member(b, first, "cards"); enc_dyn_LibrarySearchCardView(b, y.cards)
	member(b, first, "audience"); enc_dyn_PlayerId(b, y.audience)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_TurnStarted: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TurnStarted"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "turn_number"); encode_u32(b, y.turn_number)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_ExtraTurnCreated: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ExtraTurnCreated"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "anchor"); encode_PlayerId(b, y.anchor)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_PhaseChanged: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PhaseChanged"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "phase"); encode_Phase(b, y.phase)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_PhaseChangedFor: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PhaseChangedFor"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "phase"); encode_Phase(b, y.phase)
	member(b, first, "player"); encode_PlayerId(b, y.player)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_PriorityPassed: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PriorityPassed"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_SpellCast: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SpellCast"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card_id"); encode_CardId(b, y.card_id)
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	if !(y.cast_mana_value == nil) { member(b, first, "cast_mana_value"); enc_opt_u32(b, y.cast_mana_value) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_Mutated: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Mutated"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "merged_id"); encode_ObjectId(b, y.merged_id)
	member(b, first, "merging_id"); encode_ObjectId(b, y.merging_id)
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_Augmented: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Augmented"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "merged_id"); encode_ObjectId(b, y.merged_id)
	member(b, first, "augmenting_id"); encode_ObjectId(b, y.augmenting_id)
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_Melded: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Melded"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "partner_id"); encode_ObjectId(b, y.partner_id)
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_SpellCopied: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SpellCopied"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card_id"); encode_CardId(b, y.card_id)
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "original_id"); encode_ObjectId(b, y.original_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_XValueChosen: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "XValueChosen"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "value"); encode_u32(b, y.value)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_AbilityActivated: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AbilityActivated"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "kind"); encode_ActivatedAbilityKind(b, y.kind)
	if !(y.departed_source_lki == nil) { member(b, first, "departed_source_lki"); enc_ptr_LKISnapshot(b, y.departed_source_lki) }
	if !(skip_GameEvent_ActivationTriggerState_is_pending_ActivationTriggerState(y.trigger_state)) { member(b, first, "trigger_state"); encode_ActivationTriggerState(b, y.trigger_state) }
	if !(y.stack_entry == nil) { member(b, first, "stack_entry"); enc_opt_ObjectId(b, y.stack_entry) }
	if !(skip_GameEvent_BoundActivationCost_is_unknown_BoundActivationCost(y.activation_cost)) { member(b, first, "activation_cost"); encode_BoundActivationCost(b, y.activation_cost) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_ZoneChanged: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ZoneChanged"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "from"); enc_opt_Zone(b, y.from)
	member(b, first, "to"); encode_Zone(b, y.to)
	member(b, first, "record"); enc_ptr_ZoneChangeRecord(b, y.record)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_LifeChanged: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "LifeChanged"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "amount"); encode_i32(b, y.amount)
	if !(skip_GameEvent_LifeTotalReading_is_unreported_LifeTotalReading(y.new_total)) { member(b, first, "new_total"); encode_LifeTotalReading(b, y.new_total) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_ManaAdded: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ManaAdded"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "mana_type"); encode_ManaType(b, y.mana_type)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	if !(skip_GameEvent_ManaTapState_is_not_from_tap_ManaTapState(y.tap_state)) { member(b, first, "tap_state"); encode_ManaTapState(b, y.tap_state) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_TappedForMana: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TappedForMana"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "produced"); enc_dyn_ManaType(b, y.produced)
	if !(skip_GameEvent_ManaTapState_is_not_from_tap_ManaTapState(y.tap_state)) { member(b, first, "tap_state"); encode_ManaTapState(b, y.tap_state) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_ManaAbilityProduced: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ManaAbilityProduced"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "produced"); enc_dyn_ManaType(b, y.produced)
	if !(skip_GameEvent_ManaAbilityTriggerState_is_pending_ManaAbilityTriggerState(y.trigger_state)) { member(b, first, "trigger_state"); encode_ManaAbilityTriggerState(b, y.trigger_state) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_ManaPoolEmptied: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ManaPoolEmptied"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "color"); encode_ManaType(b, y.color)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_ManaBurn: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ManaBurn"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "amount"); encode_u32(b, y.amount)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_ManaRecolored: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ManaRecolored"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "from"); encode_ManaType(b, y.from)
	member(b, first, "to"); encode_ManaType(b, y.to)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_PermanentTapped: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PermanentTapped"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	if !(y.caused_by == nil) { member(b, first, "caused_by"); enc_opt_ObjectId(b, y.caused_by) }
	if !(y.incarnation == nil) { member(b, first, "incarnation"); enc_opt_u64(b, y.incarnation) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_CreatureExerted: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CreatureExerted"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	if !(y.player == nil) { member(b, first, "player"); enc_opt_PlayerId(b, y.player) }
	member(b, first, "origin"); encode_ExertOrigin(b, y.origin)
	if !(y.attack_permission == nil) { member(b, first, "attack_permission"); enc_opt_TriggerDefinitionRef(b, y.attack_permission) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_CreatureEnlisted: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CreatureEnlisted"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "attacker"); encode_ObjectId(b, y.attacker)
	member(b, first, "tapped"); encode_ObjectId(b, y.tapped)
	member(b, first, "tapped_snapshot"); enc_ptr_CostPaidObjectSnapshot(b, y.tapped_snapshot)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_ArmyAmassed: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ArmyAmassed"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_Foretold: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Foretold"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_BecameForetold: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BecameForetold"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_PlayerLost: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PlayerLost"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "reasons"); enc_dyn_LossReason(b, y.reasons)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_MulliganStarted: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "MulliganStarted"); strings.write_byte(b, '}')
	case GameEvent_CardsDrawn: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CardsDrawn"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_CardDrawn: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CardDrawn"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "nth_in_turn"); encode_u32(b, y.nth_in_turn)
	member(b, first, "nth_in_step"); encode_u32(b, y.nth_in_step)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_PermanentUntapped: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PermanentUntapped"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_PermanentPhasedOut: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PermanentPhasedOut"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "indirect"); encode_bool(b, y.indirect)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_PermanentPhasedIn: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PermanentPhasedIn"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
