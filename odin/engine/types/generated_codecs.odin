decode_ResolvedObjectStatus :: proc(v: json.Value, out: ^ResolvedObjectStatus) -> bool {
	when COVERAGE do cov_hit("ResolvedObjectStatus")
	if v.kind != .String do return fail("ResolvedObjectStatus: not a string")
	str := v.text
	switch str {
	case "Tapped": when COVERAGE do cov_hit("ResolvedObjectStatus::Tapped"); out^ = .Tapped
	case "Exerted": when COVERAGE do cov_hit("ResolvedObjectStatus::Exerted"); out^ = .Exerted
	case: return fail("ResolvedObjectStatus: unknown variant")
	}
	return true
}

encode_ResolvedObjectStatus :: proc(b: ^strings.Builder, x: ResolvedObjectStatus) {
	@(static, rodata) NAMES := [ResolvedObjectStatus]string{
		.Tapped = "Tapped",
		.Exerted = "Exerted",
	}
	json.write_string(b, NAMES[x])
}

