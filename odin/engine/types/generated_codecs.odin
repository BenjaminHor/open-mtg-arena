	if fv, found := get_any(v, "singleton"); found { if !decode_bool(fv, &out.singleton) do return fail("StructuralRules.singleton") } else { return fail("StructuralRules.singleton missing") }
	if fv, found := get_any(v, "command_zone_mode"); found { if !decode_CommandZoneMode(fv, &out.command_zone_mode) do return fail("StructuralRules.command_zone_mode") } else { return fail("StructuralRules.command_zone_mode missing") }
	if fv, found := get_any(v, "range_of_influence"); found { if !dec_ptr_RangeOfInfluenceConfig(fv, &out.range_of_influence) do return fail("StructuralRules.range_of_influence") }
	if fv, found := get_any(v, "team_based"); found { if !decode_bool(fv, &out.team_based) do return fail("StructuralRules.team_based") } else { return fail("StructuralRules.team_based missing") }
	if fv, found := get_any(v, "sideboard_policy"); found { if !decode_SideboardPolicy(fv, &out.sideboard_policy) do return fail("StructuralRules.sideboard_policy") } else { return fail("StructuralRules.sideboard_policy missing") }
	if fv, found := get_any(v, "default_deck_copy_limit"); found { if !decode_DeckCopyLimit(fv, &out.default_deck_copy_limit) do return fail("StructuralRules.default_deck_copy_limit") } else { return fail("StructuralRules.default_deck_copy_limit missing") }
	if fv, found := get_any(v, "poison_counter_threshold"); found { if !decode_u8(fv, &out.poison_counter_threshold) do return fail("StructuralRules.poison_counter_threshold") } else { out.poison_counter_threshold = default_StructuralRules_default_structural_poison_counter_threshold() }
	return true
}

