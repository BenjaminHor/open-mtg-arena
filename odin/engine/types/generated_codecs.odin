decode_ObjectScope :: proc(v: json.Value, out: ^ObjectScope) -> bool {
	if v.kind != .Object do return fail("ObjectScope: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ObjectScope: no tag")
	switch tv.text {
	case "Source": out^ = ObjectScope_Source{}
	case "Target": out^ = ObjectScope_Target{}
	case "Recipient": out^ = ObjectScope_Recipient{}
	case "EventSource": out^ = ObjectScope_EventSource{}
	case "CostPaidObject": out^ = ObjectScope_CostPaidObject{}
	case "Anaphoric": out^ = ObjectScope_Anaphoric{}
	case "Demonstrative": out^ = ObjectScope_Demonstrative{}
	case "AmassedArmy": out^ = ObjectScope_AmassedArmy{}
	case "EventTarget": out^ = ObjectScope_EventTarget{}
	case "OtherRevealedCard": out^ = ObjectScope_OtherRevealedCard{}
	case "OwnedLinkedExileCard": out^ = ObjectScope_OwnedLinkedExileCard{}
	case "BatchSource": out^ = ObjectScope_BatchSource{}
	case "ChainRootTarget": out^ = ObjectScope_ChainRootTarget{}
	case "GrantingObject": out^ = ObjectScope_GrantingObject{}
	case "SpecificObject":
		tmp: ObjectScope_SpecificObject
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ObjectScope_SpecificObject) -> bool {
	if fv, found := get_any(v, "object"); found { if !decode_ObjectIncarnationRef(fv, &out.object) do return fail("ObjectScope::SpecificObject.object") } else { return fail("ObjectScope::SpecificObject.object missing") }
	return true
		}) { return fail("ObjectScope::SpecificObject") }
		out^ = tmp
	case: return fail("ObjectScope: unknown variant")
	}
	return true
}

encode_ObjectScope :: proc(b: ^strings.Builder, x: ObjectScope) {
	#partial switch y in x {
	case ObjectScope_Source: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Source"); strings.write_byte(b, '}')
	case ObjectScope_Target: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Target"); strings.write_byte(b, '}')
