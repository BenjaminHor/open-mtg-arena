	member(b, first, "value"); encode_u32(b, y.value)

	case ContinuousModification_RemoveManaCost: _ = y; member(b, first, "type"); json.write_string(b, "RemoveManaCost")
	}
}

decode_CopyScale :: proc(v: json.Value, out: ^CopyScale) -> bool {
	when COVERAGE do cov_hit("CopyScale")
	if v.kind != .Object do return fail("CopyScale: not an object")
	if fv, found := get_any(v, "counter_type"); found { if !decode_CounterType(fv, &out.counter_type) do return fail("CopyScale.counter_type") } else { return fail("CopyScale.counter_type missing") }
	if fv, found := get_any(v, "scale_property"); found { if !decode_ObjectProperty(fv, &out.scale_property) do return fail("CopyScale.scale_property") } else { return fail("CopyScale.scale_property missing") }
	return true
}

encode_CopyScale :: proc(b: ^strings.Builder, x: CopyScale) {
	strings.write_byte(b, '{')
	f := true
	encode_CopyScale_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CopyScale_members :: proc(b: ^strings.Builder, x: CopyScale, first: ^bool) {
	member(b, first, "counter_type"); encode_CounterType(b, x.counter_type)
	member(b, first, "scale_property"); encode_ObjectProperty(b, x.scale_property)
}

decode_CopyChooseScope :: proc(v: json.Value, out: ^CopyChooseScope) -> bool {
	when COVERAGE do cov_hit("CopyChooseScope")
	if v.kind != .Object do return fail("CopyChooseScope: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("CopyChooseScope: no tag")
	switch tv.text {
	case "Chooser": when COVERAGE do cov_hit("CopyChooseScope::Chooser"); out^ = CopyChooseScope_Chooser{}
	case "Neighbor": when COVERAGE do cov_hit("CopyChooseScope::Neighbor");
		tmp: CopyChooseScope_Neighbor
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CopyChooseScope_Neighbor) -> bool {
	if fv, found := get_any(v, "direction"); found { if !decode_SeatDirection(fv, &out.direction) do return fail("CopyChooseScope::Neighbor.direction") } else { return fail("CopyChooseScope::Neighbor.direction missing") }
	return true
		}) { return fail("CopyChooseScope::Neighbor") }
		out^ = tmp
	case: return fail("CopyChooseScope: unknown variant")
	}
	return true
}

encode_CopyChooseScope :: proc(b: ^strings.Builder, x: CopyChooseScope) {
	#partial switch y in x {
	case CopyChooseScope_Chooser: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Chooser"); strings.write_byte(b, '}')
	case CopyChooseScope_Neighbor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Neighbor")
	member(b, first, "direction"); encode_SeatDirection(b, y.direction)
	}; strings.write_byte(b, '}')
	}
}

encode_CopyChooseScope_members :: proc(b: ^strings.Builder, x: CopyChooseScope, first: ^bool) {
	#partial switch y in x {
	case CopyChooseScope_Chooser: _ = y; member(b, first, "type"); json.write_string(b, "Chooser")
	case CopyChooseScope_Neighbor: member(b, first, "type"); json.write_string(b, "Neighbor")
	member(b, first, "direction"); encode_SeatDirection(b, y.direction)

	}
}

