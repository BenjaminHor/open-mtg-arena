decode_DecisionPointKind :: proc(v: json.Value, out: ^DecisionPointKind) -> bool {
	when COVERAGE do cov_hit("DecisionPointKind")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("DecisionPointKind: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("DecisionPointKind: not a string or object")
	}
	switch variant {
	case "Targets": when COVERAGE do cov_hit("DecisionPointKind::Targets");
		tmp: DecisionPointKind_Targets
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^DecisionPointKind_Targets) -> bool {
	if fv, found := get_any(v, "legal_targets"); found { if !dec_dyn_TargetRef(fv, &out.legal_targets) do return fail("DecisionPointKind::Targets.legal_targets") } else { return fail("DecisionPointKind::Targets.legal_targets missing") }
	if fv, found := get_any(v, "min_targets"); found { if !decode_u32(fv, &out.min_targets) do return fail("DecisionPointKind::Targets.min_targets") } else { return fail("DecisionPointKind::Targets.min_targets missing") }
	if fv, found := get_any(v, "max_targets"); found { if !decode_u32(fv, &out.max_targets) do return fail("DecisionPointKind::Targets.max_targets") } else { return fail("DecisionPointKind::Targets.max_targets missing") }
	if fv, found := get_any(v, "ordered"); found { if !decode_bool(fv, &out.ordered) do return fail("DecisionPointKind::Targets.ordered") } else { return fail("DecisionPointKind::Targets.ordered missing") }
	return true
		}) { return fail("DecisionPointKind::Targets") }
		out^ = tmp
	case "ConvokeTaps": when COVERAGE do cov_hit("DecisionPointKind::ConvokeTaps");
		tmp: DecisionPointKind_ConvokeTaps
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^DecisionPointKind_ConvokeTaps) -> bool {
	if fv, found := get_any(v, "tappable"); found { if !dec_dyn_ObjectId(fv, &out.tappable) do return fail("DecisionPointKind::ConvokeTaps.tappable") } else { return fail("DecisionPointKind::ConvokeTaps.tappable missing") }
	return true
		}) { return fail("DecisionPointKind::ConvokeTaps") }
		out^ = tmp
	case "Mode": when COVERAGE do cov_hit("DecisionPointKind::Mode");
		tmp: DecisionPointKind_Mode
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^DecisionPointKind_Mode) -> bool {
	if fv, found := get_any(v, "available_modes"); found { if !dec_dyn_int(fv, &out.available_modes) do return fail("DecisionPointKind::Mode.available_modes") } else { return fail("DecisionPointKind::Mode.available_modes missing") }
	if fv, found := get_any(v, "min_modes"); found { if !decode_u32(fv, &out.min_modes) do return fail("DecisionPointKind::Mode.min_modes") } else { return fail("DecisionPointKind::Mode.min_modes missing") }
	if fv, found := get_any(v, "max_modes"); found { if !decode_u32(fv, &out.max_modes) do return fail("DecisionPointKind::Mode.max_modes") } else { return fail("DecisionPointKind::Mode.max_modes missing") }
	if fv, found := get_any(v, "allow_repeats"); found { if !decode_bool(fv, &out.allow_repeats) do return fail("DecisionPointKind::Mode.allow_repeats") } else { return fail("DecisionPointKind::Mode.allow_repeats missing") }
	return true
		}) { return fail("DecisionPointKind::Mode") }
		out^ = tmp
	case "MayChoice": when COVERAGE do cov_hit("DecisionPointKind::MayChoice"); out^ = DecisionPointKind_MayChoice{}
	case "UnlessBreak": when COVERAGE do cov_hit("DecisionPointKind::UnlessBreak"); out^ = DecisionPointKind_UnlessBreak{}
	case "ManaColor": when COVERAGE do cov_hit("DecisionPointKind::ManaColor");
		tmp: DecisionPointKind_ManaColor
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^DecisionPointKind_ManaColor) -> bool {
	if fv, found := get_any(v, "color"); found { if !decode_ManaColor(fv, &out.color) do return fail("DecisionPointKind::ManaColor.color") } else { return fail("DecisionPointKind::ManaColor.color missing") }
	return true
		}) { return fail("DecisionPointKind::ManaColor") }
		out^ = tmp
	case "Order": when COVERAGE do cov_hit("DecisionPointKind::Order");
		tmp: DecisionPointKind_Order
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^DecisionPointKind_Order) -> bool {
	if fv, found := get_any(v, "pos"); found { if !decode_u8(fv, &out.pos) do return fail("DecisionPointKind::Order.pos") } else { return fail("DecisionPointKind::Order.pos missing") }
	if fv, found := get_any(v, "positions"); found { if !decode_u8(fv, &out.positions) do return fail("DecisionPointKind::Order.positions") } else { return fail("DecisionPointKind::Order.positions missing") }
	return true
		}) { return fail("DecisionPointKind::Order") }
		out^ = tmp
	case: return fail("DecisionPointKind: unknown variant")
	}
	return true
}

encode_DecisionPointKind :: proc(b: ^strings.Builder, x: DecisionPointKind) {
	#partial switch y in x {
	case DecisionPointKind_Targets: strings.write_byte(b, '{'); json.write_string(b, "Targets"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "legal_targets"); enc_dyn_TargetRef(b, y.legal_targets)
	member(b, first, "min_targets"); encode_u32(b, y.min_targets)
	member(b, first, "max_targets"); encode_u32(b, y.max_targets)
	member(b, first, "ordered"); encode_bool(b, y.ordered)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DecisionPointKind_ConvokeTaps: strings.write_byte(b, '{'); json.write_string(b, "ConvokeTaps"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "tappable"); enc_dyn_ObjectId(b, y.tappable)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DecisionPointKind_Mode: strings.write_byte(b, '{'); json.write_string(b, "Mode"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "available_modes"); enc_dyn_int(b, y.available_modes)
	member(b, first, "min_modes"); encode_u32(b, y.min_modes)
	member(b, first, "max_modes"); encode_u32(b, y.max_modes)
	member(b, first, "allow_repeats"); encode_bool(b, y.allow_repeats)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DecisionPointKind_MayChoice: _ = y; json.write_string(b, "MayChoice")
	case DecisionPointKind_UnlessBreak: _ = y; json.write_string(b, "UnlessBreak")
	case DecisionPointKind_ManaColor: strings.write_byte(b, '{'); json.write_string(b, "ManaColor"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "color"); encode_ManaColor(b, y.color)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DecisionPointKind_Order: strings.write_byte(b, '{'); json.write_string(b, "Order"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "pos"); encode_u8(b, y.pos)
	member(b, first, "positions"); encode_u8(b, y.positions)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

