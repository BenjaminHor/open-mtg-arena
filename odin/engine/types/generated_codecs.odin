	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("ProposedEvent::EmptyManaPool.player_id") } else { return fail("ProposedEvent::EmptyManaPool.player_id missing") }
