decode_RestrictionExpiry :: proc(v: json.Value, out: ^RestrictionExpiry) -> bool {
	if v.kind != .Object do return fail("RestrictionExpiry: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("RestrictionExpiry: no tag")
	switch tv.text {
	case "EndOfTurn": out^ = RestrictionExpiry_EndOfTurn{}
	case "EndOfCombat": out^ = RestrictionExpiry_EndOfCombat{}
	case "UntilPlayerNextTurn":
		tmp: RestrictionExpiry_UntilPlayerNextTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^RestrictionExpiry_UntilPlayerNextTurn) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("RestrictionExpiry::UntilPlayerNextTurn.player") } else { return fail("RestrictionExpiry::UntilPlayerNextTurn.player missing") }
	return true
		}) { return fail("RestrictionExpiry::UntilPlayerNextTurn") }
		out^ = tmp
	case "UntilEndOfNextTurnOf":
		tmp: RestrictionExpiry_UntilEndOfNextTurnOf
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^RestrictionExpiry_UntilEndOfNextTurnOf) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("RestrictionExpiry::UntilEndOfNextTurnOf.player") } else { return fail("RestrictionExpiry::UntilEndOfNextTurnOf.player missing") }
	return true
		}) { return fail("RestrictionExpiry::UntilEndOfNextTurnOf") }
		out^ = tmp
	case "UntilHostLeavesPlay": out^ = RestrictionExpiry_UntilHostLeavesPlay{}
	case: return fail("RestrictionExpiry: unknown variant")
	}
	return true
}

encode_RestrictionExpiry :: proc(b: ^strings.Builder, x: RestrictionExpiry) {
	#partial switch y in x {
	case RestrictionExpiry_EndOfTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EndOfTurn"); strings.write_byte(b, '}')
	case RestrictionExpiry_EndOfCombat: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EndOfCombat"); strings.write_byte(b, '}')
	case RestrictionExpiry_UntilPlayerNextTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UntilPlayerNextTurn")
	member(b, first, "player"); encode_PlayerId(b, y.player)
	}; strings.write_byte(b, '}')
	case RestrictionExpiry_UntilEndOfNextTurnOf: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UntilEndOfNextTurnOf")
	member(b, first, "player"); encode_PlayerId(b, y.player)
	}; strings.write_byte(b, '}')
	case RestrictionExpiry_UntilHostLeavesPlay: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "UntilHostLeavesPlay"); strings.write_byte(b, '}')
	}
}

encode_RestrictionExpiry_members :: proc(b: ^strings.Builder, x: RestrictionExpiry, first: ^bool) {
	#partial switch y in x {
	case RestrictionExpiry_EndOfTurn: _ = y; member(b, first, "type"); json.write_string(b, "EndOfTurn")
	case RestrictionExpiry_EndOfCombat: _ = y; member(b, first, "type"); json.write_string(b, "EndOfCombat")
	case RestrictionExpiry_UntilPlayerNextTurn: member(b, first, "type"); json.write_string(b, "UntilPlayerNextTurn")
	member(b, first, "player"); encode_PlayerId(b, y.player)

	case RestrictionExpiry_UntilEndOfNextTurnOf: member(b, first, "type"); json.write_string(b, "UntilEndOfNextTurnOf")
	member(b, first, "player"); encode_PlayerId(b, y.player)

	case RestrictionExpiry_UntilHostLeavesPlay: _ = y; member(b, first, "type"); json.write_string(b, "UntilHostLeavesPlay")
	}
}

