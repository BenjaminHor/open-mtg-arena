dec_map_int_ptr_TriggerSourceContext :: proc(v: json.Value, out: ^map[int]^TriggerSourceContext) -> bool {
	if v.kind != .Object do return fail("expected an object (map)")
	out^ = make(map[int]^TriggerSourceContext, len(v.members))
	for m in v.members {
		key: int
		val: ^TriggerSourceContext
		ok_k := decode_int(json.Value{kind = .Number, text = m.key}, &key)
		if !ok_k || !dec_shared_TriggerSourceContext(m.value, &val) do return false
		out[key] = val
	}
	return true
}

