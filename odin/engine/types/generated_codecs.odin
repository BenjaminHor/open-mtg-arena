	if fv, found := get_any(v, "anchor"); found { if !decode_Phase(fv, &out.anchor) do return fail("InsertedPhaseResume.anchor") } else { return fail("InsertedPhaseResume.anchor missing") }
	if fv, found := get_any(v, "segment"); found { if !decode_TurnSegment(fv, &out.segment) do return fail("InsertedPhaseResume.segment") } else { return fail("InsertedPhaseResume.segment missing") }
	if fv, found := get_any(v, "entry"); found { if !decode_ExtraPhaseId(fv, &out.entry) do return fail("InsertedPhaseResume.entry") }
