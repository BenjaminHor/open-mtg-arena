	case GameEvent_PlayerCounterChanged: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PlayerCounterChanged"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
