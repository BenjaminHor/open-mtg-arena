	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingCostMoveCompletion_PublishExileTrackedSet: _ = y; json.write_string(b, "PublishExileTrackedSet")
	case PendingCostMoveCompletion_FinalizeCast: strings.write_byte(b, '{'); json.write_string(b, "FinalizeCast"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "phyrexian_choices"); enc_opt_dyn_ShardChoice(b, y.phyrexian_choices)
	member(b, first, "cascade_cast_transformed"); encode_bool(b, y.cascade_cast_transformed)
	member(b, first, "resolution_success_waiting_for"); enc_ptr_WaitingFor(b, y.resolution_success_waiting_for)
	member(b, first, "prepaid_actual_mana_spent"); enc_opt_u32(b, y.prepaid_actual_mana_spent)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingCostMoveCompletion_FinalizeDelvedCast: strings.write_byte(b, '{'); json.write_string(b, "FinalizeDelvedCast"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "phyrexian_choices"); enc_opt_dyn_ShardChoice(b, y.phyrexian_choices)
	member(b, first, "pre_payment_checks"); enc_ptr_FinalizePrePaymentChecks(b, y.pre_payment_checks)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

