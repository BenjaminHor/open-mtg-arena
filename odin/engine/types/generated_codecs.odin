	f := true
	encode_EmergeCost_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_EmergeCost_members :: proc(b: ^strings.Builder, x: EmergeCost, first: ^bool) {
	member(b, first, "mana_cost"); encode_ManaCost(b, x.mana_cost)
	member(b, first, "sacrifice_filter"); encode_TargetFilter(b, x.sacrifice_filter)
}

