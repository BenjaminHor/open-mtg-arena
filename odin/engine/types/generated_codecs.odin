decode_StepEntryResume :: proc(v: json.Value, out: ^StepEntryResume) -> bool {
	when COVERAGE do cov_hit("StepEntryResume")
	if v.kind != .String do return fail("StepEntryResume: not a string")
	str := v.text
	switch str {
	case "AfterSchemeAction": when COVERAGE do cov_hit("StepEntryResume::AfterSchemeAction"); out^ = .AfterSchemeAction
	case: return fail("StepEntryResume: unknown variant")
	}
	return true
}

