	case: return fail("TriggerCondition: unknown variant")
	}
	return true
}

encode_TriggerCondition :: proc(b: ^strings.Builder, x: TriggerCondition) {
	#partial switch y in x {
	case TriggerCondition_GainedLife: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GainedLife")
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	}; strings.write_byte(b, '}')
	case TriggerCondition_LostLife: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "LostLife"); strings.write_byte(b, '}')
	case TriggerCondition_Descended: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Descended"); strings.write_byte(b, '}')
	case TriggerCondition_ControlsType: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControlsType")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case TriggerCondition_NoSpellsCastLastTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NoSpellsCastLastTurn"); strings.write_byte(b, '}')
	case TriggerCondition_TwoOrMoreSpellsCastLastTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TwoOrMoreSpellsCastLastTurn"); strings.write_byte(b, '}')
	case TriggerCondition_DuringPlayersTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DuringPlayersTurn")
	member(b, first, "player"); encode_PlayerFilter(b, y.player)
	}; strings.write_byte(b, '}')
	case TriggerCondition_SourceEnteredThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceEnteredThisTurn"); strings.write_byte(b, '}')
	case TriggerCondition_SourceAttackedThisCombat: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceAttackedThisCombat"); strings.write_byte(b, '}')
	case TriggerCondition_ChoseOtherRingBearer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChoseOtherRingBearer"); strings.write_byte(b, '}')
	case TriggerCondition_ChoseRingBearer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChoseRingBearer"); strings.write_byte(b, '}')
	case TriggerCondition_EchoDue: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EchoDue"); strings.write_byte(b, '}')
	case TriggerCondition_MinCoAttackers: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "MinCoAttackers")
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }
	}; strings.write_byte(b, '}')
	case TriggerCondition_SolveConditionMet: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SolveConditionMet"); strings.write_byte(b, '}')
	case TriggerCondition_ClassLevelGE: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ClassLevelGE")
	member(b, first, "level"); encode_u8(b, y.level)
	}; strings.write_byte(b, '}')
	case TriggerCondition_SourceIsHarnessed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsHarnessed"); strings.write_byte(b, '}')
	case TriggerCondition_AttractionVisitRoll: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AttractionVisitRoll")
	member(b, first, "min"); encode_u8(b, y.min)
	member(b, first, "max"); encode_u8(b, y.max)
	}; strings.write_byte(b, '}')
	case TriggerCondition_WasCast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WasCast")
	if !(y.zone == nil) { member(b, first, "zone"); enc_opt_Zone(b, y.zone) }
	if !(y.controller == nil) { member(b, first, "controller"); enc_opt_ControllerRef(b, y.controller) }
	if !(y.owner == nil) { member(b, first, "owner"); enc_opt_ControllerRef(b, y.owner) }
	}; strings.write_byte(b, '}')
	case TriggerCondition_WasPlayed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "WasPlayed"); strings.write_byte(b, '}')
	case TriggerCondition_AdditionalCostPaid: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AdditionalCostPaid")
	if !(skip_TriggerCondition_AdditionalCostPaymentSource_is_any(y.source)) { member(b, first, "source"); encode_AdditionalCostPaymentSource(b, y.source) }
	if !(y.origin == nil) { member(b, first, "origin"); enc_opt_AdditionalCostOrigin(b, y.origin) }
	if !(y.origin_ordinal == nil) { member(b, first, "origin_ordinal"); enc_opt_u32(b, y.origin_ordinal) }
	if !(y.variant == nil) { member(b, first, "variant"); enc_opt_KickerVariant(b, y.variant) }
	if !(y.kicker_cost == nil) { member(b, first, "kicker_cost"); enc_opt_ManaCost(b, y.kicker_cost) }
	if !(skip_TriggerCondition_AbilityCondition_is_default_min_count(y.min_count)) { member(b, first, "min_count"); encode_u32(b, y.min_count) }
	}; strings.write_byte(b, '}')
	case TriggerCondition_SourceIsAttacking: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsAttacking"); strings.write_byte(b, '}')
	case TriggerCondition_CastVariantPaid: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastVariantPaid")
	member(b, first, "variant"); encode_CastVariantPaid(b, y.variant)
	}; strings.write_byte(b, '}')
	case TriggerCondition_CastVariantPaidPersistent: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastVariantPaidPersistent")
	member(b, first, "variant"); encode_CastVariantPaid(b, y.variant)
	}; strings.write_byte(b, '}')
	case TriggerCondition_ActivatedAbilityIsNonMana: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ActivatedAbilityIsNonMana"); strings.write_byte(b, '}')
	case TriggerCondition_DealtDamageBySourceThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DealtDamageBySourceThisTurn"); strings.write_byte(b, '}')
	case TriggerCondition_DealtDamageThisTurnBySource: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DealtDamageThisTurnBySource")
	member(b, first, "source"); encode_TargetFilter(b, y.source)
	}; strings.write_byte(b, '}')
	case TriggerCondition_FirstTimeObjectTappedThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "FirstTimeObjectTappedThisTurn"); strings.write_byte(b, '}')
	case TriggerCondition_FirstTimeObjectCountersAddedThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "FirstTimeObjectCountersAddedThisTurn"); strings.write_byte(b, '}')
	case TriggerCondition_WasType: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WasType")
	member(b, first, "card_type"); encode_CoreType(b, y.card_type)
	}; strings.write_byte(b, '}')
	case TriggerCondition_LifeTotalGE: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "LifeTotalGE")
	member(b, first, "minimum"); encode_i32(b, y.minimum)
	}; strings.write_byte(b, '}')
	case TriggerCondition_ControlCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControlCount")
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case TriggerCondition_ControlsNone: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControlsNone")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case TriggerCondition_AttackedThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AttackedThisTurn"); strings.write_byte(b, '}')
	case TriggerCondition_FirstCombatPhaseOfTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "FirstCombatPhaseOfTurn"); strings.write_byte(b, '}')
	case TriggerCondition_CastSpellThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastSpellThisTurn")
	member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case TriggerCondition_QuantityComparison: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "QuantityComparison")
	member(b, first, "lhs"); encode_QuantityExpr(b, y.lhs)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, y.rhs)
	}; strings.write_byte(b, '}')
	case TriggerCondition_QuantityQuality: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "QuantityQuality")
	member(b, first, "quantity"); encode_QuantityExpr(b, y.quantity)
	member(b, first, "quality"); encode_NumberQuality(b, y.quality)
	}; strings.write_byte(b, '}')
	case TriggerCondition_HasMaxSpeed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasMaxSpeed"); strings.write_byte(b, '}')
	case TriggerCondition_IsMonarch: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "IsMonarch")
	if !(skip_TriggerCondition_is_player_scope_controller(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }
	}; strings.write_byte(b, '}')
	case TriggerCondition_IsPoisoned: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "IsPoisoned")
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	}; strings.write_byte(b, '}')
	case TriggerCondition_HasBoon: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HasBoon")
	if !(skip_TriggerCondition_is_player_scope_controller(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }
	}; strings.write_byte(b, '}')
	case TriggerCondition_IsInitiative: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "IsInitiative"); strings.write_byte(b, '}')
	case TriggerCondition_NoMonarch: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NoMonarch"); strings.write_byte(b, '}')
	case TriggerCondition_WasStartingPlayer: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WasStartingPlayer")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)
	}; strings.write_byte(b, '}')
	case TriggerCondition_SpellCastWithVariantThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SpellCastWithVariantThisTurn")
	member(b, first, "variant"); encode_CastingVariant(b, y.variant)
	}; strings.write_byte(b, '}')
	case TriggerCondition_HasCityBlessing: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasCityBlessing"); strings.write_byte(b, '}')
	case TriggerCondition_HasEnduringStory: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasEnduringStory"); strings.write_byte(b, '}')
	case TriggerCondition_CompletedDungeon: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CompletedDungeon")
	if !(y.specific == nil) { member(b, first, "specific"); enc_opt_DungeonId(b, y.specific) }
	}; strings.write_byte(b, '}')
	case TriggerCondition_SourceIsTapped: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsTapped"); strings.write_byte(b, '}')
	case TriggerCondition_SourceIsTransformed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsTransformed"); strings.write_byte(b, '}')
	case TriggerCondition_SourceIsFaceUp: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsFaceUp"); strings.write_byte(b, '}')
	case TriggerCondition_SourceIsFaceDown: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsFaceDown"); strings.write_byte(b, '}')
	case TriggerCondition_SourceInZone: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceInZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	}; strings.write_byte(b, '}')
	case TriggerCondition_CounterAddedThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CounterAddedThisTurn"); strings.write_byte(b, '}')
	case TriggerCondition_LostLifeLastTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "LostLifeLastTurn"); strings.write_byte(b, '}')
	case TriggerCondition_DefendingPlayerControlsNone: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DefendingPlayerControlsNone")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case TriggerCondition_TributeNotPaid: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TributeNotPaid"); strings.write_byte(b, '}')
	case TriggerCondition_CastDuringPhase: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastDuringPhase")
	member(b, first, "phases"); enc_dyn_Phase(b, y.phases)
	}; strings.write_byte(b, '}')
	case TriggerCondition_CurrentPhaseIs: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CurrentPhaseIs")
	member(b, first, "phases"); enc_dyn_Phase(b, y.phases)
	}; strings.write_byte(b, '}')
	case TriggerCondition_CastTimingPermission: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastTimingPermission")
	member(b, first, "permission"); encode_CastTimingPermission(b, y.permission)
	}; strings.write_byte(b, '}')
	case TriggerCondition_ManaColorSpent: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ManaColorSpent")
	member(b, first, "color"); encode_SpentColor(b, y.color)
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	}; strings.write_byte(b, '}')
	case TriggerCondition_ManaSpentCondition: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ManaSpentCondition")
	member(b, first, "text"); encode_string(b, y.text)
	}; strings.write_byte(b, '}')
	case TriggerCondition_HadCounters: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HadCounters")
	member(b, first, "counter_type"); enc_opt_CounterType(b, y.counter_type)
	}; strings.write_byte(b, '}')
	case TriggerCondition_ControlsCommander: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControlsCommander")
	member(b, first, "ownership"); encode_CommanderOwnership(b, y.ownership)
	}; strings.write_byte(b, '}')
	case TriggerCondition_IsRenowned: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "IsRenowned")
	member(b, first, "subject"); encode_RenownSubject(b, y.subject)
	}; strings.write_byte(b, '}')
	case TriggerCondition_HasCounters: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HasCounters")
	member(b, first, "counters"); encode_CounterMatch(b, y.counters)
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	if !(y.maximum == nil) { member(b, first, "maximum"); enc_opt_u32(b, y.maximum) }
	}; strings.write_byte(b, '}')
	case TriggerCondition_ZoneChangeObjectMatchesFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ZoneChangeObjectMatchesFilter")
	if !(y.origin == nil) { member(b, first, "origin"); enc_opt_Zone(b, y.origin) }
	member(b, first, "destination"); encode_Zone(b, y.destination)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case TriggerCondition_ZoneChangeObjectIsTapped: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ZoneChangeObjectIsTapped"); strings.write_byte(b, '}')
	case TriggerCondition_SourceMatchesFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case TriggerCondition_EventDamageSourceMatchesFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "EventDamageSourceMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case TriggerCondition_EventObjectMatchesFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "EventObjectMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case TriggerCondition_DamagedPlayerIsEventSourceOwner: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DamagedPlayerIsEventSourceOwner"); strings.write_byte(b, '}')
	case TriggerCondition_ChosenLabelIs: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChosenLabelIs")
	member(b, first, "label"); encode_string(b, y.label)
	}; strings.write_byte(b, '}')
	case TriggerCondition_AttackersDeclaredCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AttackersDeclaredCount")
	member(b, first, "subject"); encode_AttackersDeclaredCountSubject(b, y.subject)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}')
	case TriggerCondition_ExceptFirstDrawInDrawStep: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ExceptFirstDrawInDrawStep"); strings.write_byte(b, '}')
	case TriggerCondition_PlacedByAbilitySource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PlacedByAbilitySource"); strings.write_byte(b, '}')
	case TriggerCondition_AddedManaWithThisAbilityThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AddedManaWithThisAbilityThisTurn"); strings.write_byte(b, '}')
	case TriggerCondition_TriggeringSpellTargetsFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TriggeringSpellTargetsFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case TriggerCondition_TriggeringSpellMatchesFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TriggeringSpellMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case TriggerCondition_And: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "And")
	member(b, first, "conditions"); enc_dyn_TriggerCondition(b, y.conditions)
	}; strings.write_byte(b, '}')
	case TriggerCondition_Or: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Or")
	member(b, first, "conditions"); enc_dyn_TriggerCondition(b, y.conditions)
	}; strings.write_byte(b, '}')
	case TriggerCondition_Not: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Not")
	member(b, first, "condition"); enc_ptr_TriggerCondition(b, y.condition)
	}; strings.write_byte(b, '}')
	case TriggerCondition_EventTime: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "EventTime")
	member(b, first, "condition"); enc_ptr_TriggerCondition(b, y.condition)
	}; strings.write_byte(b, '}')
	}
}

encode_TriggerCondition_members :: proc(b: ^strings.Builder, x: TriggerCondition, first: ^bool) {
	#partial switch y in x {
	case TriggerCondition_GainedLife: member(b, first, "type"); json.write_string(b, "GainedLife")
	member(b, first, "minimum"); encode_u32(b, y.minimum)

	case TriggerCondition_LostLife: _ = y; member(b, first, "type"); json.write_string(b, "LostLife")
	case TriggerCondition_Descended: _ = y; member(b, first, "type"); json.write_string(b, "Descended")
	case TriggerCondition_ControlsType: member(b, first, "type"); json.write_string(b, "ControlsType")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case TriggerCondition_NoSpellsCastLastTurn: _ = y; member(b, first, "type"); json.write_string(b, "NoSpellsCastLastTurn")
	case TriggerCondition_TwoOrMoreSpellsCastLastTurn: _ = y; member(b, first, "type"); json.write_string(b, "TwoOrMoreSpellsCastLastTurn")
	case TriggerCondition_DuringPlayersTurn: member(b, first, "type"); json.write_string(b, "DuringPlayersTurn")
	member(b, first, "player"); encode_PlayerFilter(b, y.player)

	case TriggerCondition_SourceEnteredThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "SourceEnteredThisTurn")
	case TriggerCondition_SourceAttackedThisCombat: _ = y; member(b, first, "type"); json.write_string(b, "SourceAttackedThisCombat")
	case TriggerCondition_ChoseOtherRingBearer: _ = y; member(b, first, "type"); json.write_string(b, "ChoseOtherRingBearer")
	case TriggerCondition_ChoseRingBearer: _ = y; member(b, first, "type"); json.write_string(b, "ChoseRingBearer")
	case TriggerCondition_EchoDue: _ = y; member(b, first, "type"); json.write_string(b, "EchoDue")
	case TriggerCondition_MinCoAttackers: member(b, first, "type"); json.write_string(b, "MinCoAttackers")
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }

	case TriggerCondition_SolveConditionMet: _ = y; member(b, first, "type"); json.write_string(b, "SolveConditionMet")
	case TriggerCondition_ClassLevelGE: member(b, first, "type"); json.write_string(b, "ClassLevelGE")
	member(b, first, "level"); encode_u8(b, y.level)

	case TriggerCondition_SourceIsHarnessed: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsHarnessed")
	case TriggerCondition_AttractionVisitRoll: member(b, first, "type"); json.write_string(b, "AttractionVisitRoll")
	member(b, first, "min"); encode_u8(b, y.min)
	member(b, first, "max"); encode_u8(b, y.max)

	case TriggerCondition_WasCast: member(b, first, "type"); json.write_string(b, "WasCast")
	if !(y.zone == nil) { member(b, first, "zone"); enc_opt_Zone(b, y.zone) }
	if !(y.controller == nil) { member(b, first, "controller"); enc_opt_ControllerRef(b, y.controller) }
	if !(y.owner == nil) { member(b, first, "owner"); enc_opt_ControllerRef(b, y.owner) }

	case TriggerCondition_WasPlayed: _ = y; member(b, first, "type"); json.write_string(b, "WasPlayed")
	case TriggerCondition_AdditionalCostPaid: member(b, first, "type"); json.write_string(b, "AdditionalCostPaid")
	if !(skip_TriggerCondition_AdditionalCostPaymentSource_is_any(y.source)) { member(b, first, "source"); encode_AdditionalCostPaymentSource(b, y.source) }
	if !(y.origin == nil) { member(b, first, "origin"); enc_opt_AdditionalCostOrigin(b, y.origin) }
	if !(y.origin_ordinal == nil) { member(b, first, "origin_ordinal"); enc_opt_u32(b, y.origin_ordinal) }
	if !(y.variant == nil) { member(b, first, "variant"); enc_opt_KickerVariant(b, y.variant) }
	if !(y.kicker_cost == nil) { member(b, first, "kicker_cost"); enc_opt_ManaCost(b, y.kicker_cost) }
	if !(skip_TriggerCondition_AbilityCondition_is_default_min_count(y.min_count)) { member(b, first, "min_count"); encode_u32(b, y.min_count) }

	case TriggerCondition_SourceIsAttacking: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsAttacking")
	case TriggerCondition_CastVariantPaid: member(b, first, "type"); json.write_string(b, "CastVariantPaid")
	member(b, first, "variant"); encode_CastVariantPaid(b, y.variant)

	case TriggerCondition_CastVariantPaidPersistent: member(b, first, "type"); json.write_string(b, "CastVariantPaidPersistent")
	member(b, first, "variant"); encode_CastVariantPaid(b, y.variant)

	case TriggerCondition_ActivatedAbilityIsNonMana: _ = y; member(b, first, "type"); json.write_string(b, "ActivatedAbilityIsNonMana")
	case TriggerCondition_DealtDamageBySourceThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "DealtDamageBySourceThisTurn")
	case TriggerCondition_DealtDamageThisTurnBySource: member(b, first, "type"); json.write_string(b, "DealtDamageThisTurnBySource")
	member(b, first, "source"); encode_TargetFilter(b, y.source)

	case TriggerCondition_FirstTimeObjectTappedThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "FirstTimeObjectTappedThisTurn")
	case TriggerCondition_FirstTimeObjectCountersAddedThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "FirstTimeObjectCountersAddedThisTurn")
	case TriggerCondition_WasType: member(b, first, "type"); json.write_string(b, "WasType")
	member(b, first, "card_type"); encode_CoreType(b, y.card_type)

	case TriggerCondition_LifeTotalGE: member(b, first, "type"); json.write_string(b, "LifeTotalGE")
	member(b, first, "minimum"); encode_i32(b, y.minimum)

	case TriggerCondition_ControlCount: member(b, first, "type"); json.write_string(b, "ControlCount")
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case TriggerCondition_ControlsNone: member(b, first, "type"); json.write_string(b, "ControlsNone")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case TriggerCondition_AttackedThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "AttackedThisTurn")
	case TriggerCondition_FirstCombatPhaseOfTurn: _ = y; member(b, first, "type"); json.write_string(b, "FirstCombatPhaseOfTurn")
	case TriggerCondition_CastSpellThisTurn: member(b, first, "type"); json.write_string(b, "CastSpellThisTurn")
	member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter)

	case TriggerCondition_QuantityComparison: member(b, first, "type"); json.write_string(b, "QuantityComparison")
	member(b, first, "lhs"); encode_QuantityExpr(b, y.lhs)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, y.rhs)

	case TriggerCondition_QuantityQuality: member(b, first, "type"); json.write_string(b, "QuantityQuality")
	member(b, first, "quantity"); encode_QuantityExpr(b, y.quantity)
	member(b, first, "quality"); encode_NumberQuality(b, y.quality)

	case TriggerCondition_HasMaxSpeed: _ = y; member(b, first, "type"); json.write_string(b, "HasMaxSpeed")
	case TriggerCondition_IsMonarch: member(b, first, "type"); json.write_string(b, "IsMonarch")
	if !(skip_TriggerCondition_is_player_scope_controller(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }

	case TriggerCondition_IsPoisoned: member(b, first, "type"); json.write_string(b, "IsPoisoned")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case TriggerCondition_HasBoon: member(b, first, "type"); json.write_string(b, "HasBoon")
	if !(skip_TriggerCondition_is_player_scope_controller(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }

	case TriggerCondition_IsInitiative: _ = y; member(b, first, "type"); json.write_string(b, "IsInitiative")
	case TriggerCondition_NoMonarch: _ = y; member(b, first, "type"); json.write_string(b, "NoMonarch")
	case TriggerCondition_WasStartingPlayer: member(b, first, "type"); json.write_string(b, "WasStartingPlayer")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)

	case TriggerCondition_SpellCastWithVariantThisTurn: member(b, first, "type"); json.write_string(b, "SpellCastWithVariantThisTurn")
	member(b, first, "variant"); encode_CastingVariant(b, y.variant)

	case TriggerCondition_HasCityBlessing: _ = y; member(b, first, "type"); json.write_string(b, "HasCityBlessing")
	case TriggerCondition_HasEnduringStory: _ = y; member(b, first, "type"); json.write_string(b, "HasEnduringStory")
	case TriggerCondition_CompletedDungeon: member(b, first, "type"); json.write_string(b, "CompletedDungeon")
	if !(y.specific == nil) { member(b, first, "specific"); enc_opt_DungeonId(b, y.specific) }

	case TriggerCondition_SourceIsTapped: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsTapped")
	case TriggerCondition_SourceIsTransformed: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsTransformed")
	case TriggerCondition_SourceIsFaceUp: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsFaceUp")
	case TriggerCondition_SourceIsFaceDown: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsFaceDown")
	case TriggerCondition_SourceInZone: member(b, first, "type"); json.write_string(b, "SourceInZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)

	case TriggerCondition_CounterAddedThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "CounterAddedThisTurn")
	case TriggerCondition_LostLifeLastTurn: _ = y; member(b, first, "type"); json.write_string(b, "LostLifeLastTurn")
	case TriggerCondition_DefendingPlayerControlsNone: member(b, first, "type"); json.write_string(b, "DefendingPlayerControlsNone")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case TriggerCondition_TributeNotPaid: _ = y; member(b, first, "type"); json.write_string(b, "TributeNotPaid")
	case TriggerCondition_CastDuringPhase: member(b, first, "type"); json.write_string(b, "CastDuringPhase")
	member(b, first, "phases"); enc_dyn_Phase(b, y.phases)

	case TriggerCondition_CurrentPhaseIs: member(b, first, "type"); json.write_string(b, "CurrentPhaseIs")
	member(b, first, "phases"); enc_dyn_Phase(b, y.phases)

	case TriggerCondition_CastTimingPermission: member(b, first, "type"); json.write_string(b, "CastTimingPermission")
	member(b, first, "permission"); encode_CastTimingPermission(b, y.permission)

	case TriggerCondition_ManaColorSpent: member(b, first, "type"); json.write_string(b, "ManaColorSpent")
	member(b, first, "color"); encode_SpentColor(b, y.color)
	member(b, first, "minimum"); encode_u32(b, y.minimum)

	case TriggerCondition_ManaSpentCondition: member(b, first, "type"); json.write_string(b, "ManaSpentCondition")
	member(b, first, "text"); encode_string(b, y.text)

	case TriggerCondition_HadCounters: member(b, first, "type"); json.write_string(b, "HadCounters")
	member(b, first, "counter_type"); enc_opt_CounterType(b, y.counter_type)

	case TriggerCondition_ControlsCommander: member(b, first, "type"); json.write_string(b, "ControlsCommander")
	member(b, first, "ownership"); encode_CommanderOwnership(b, y.ownership)

	case TriggerCondition_IsRenowned: member(b, first, "type"); json.write_string(b, "IsRenowned")
	member(b, first, "subject"); encode_RenownSubject(b, y.subject)

	case TriggerCondition_HasCounters: member(b, first, "type"); json.write_string(b, "HasCounters")
	member(b, first, "counters"); encode_CounterMatch(b, y.counters)
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	if !(y.maximum == nil) { member(b, first, "maximum"); enc_opt_u32(b, y.maximum) }

	case TriggerCondition_ZoneChangeObjectMatchesFilter: member(b, first, "type"); json.write_string(b, "ZoneChangeObjectMatchesFilter")
	if !(y.origin == nil) { member(b, first, "origin"); enc_opt_Zone(b, y.origin) }
	member(b, first, "destination"); encode_Zone(b, y.destination)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case TriggerCondition_ZoneChangeObjectIsTapped: _ = y; member(b, first, "type"); json.write_string(b, "ZoneChangeObjectIsTapped")
	case TriggerCondition_SourceMatchesFilter: member(b, first, "type"); json.write_string(b, "SourceMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case TriggerCondition_EventDamageSourceMatchesFilter: member(b, first, "type"); json.write_string(b, "EventDamageSourceMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case TriggerCondition_EventObjectMatchesFilter: member(b, first, "type"); json.write_string(b, "EventObjectMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case TriggerCondition_DamagedPlayerIsEventSourceOwner: _ = y; member(b, first, "type"); json.write_string(b, "DamagedPlayerIsEventSourceOwner")
	case TriggerCondition_ChosenLabelIs: member(b, first, "type"); json.write_string(b, "ChosenLabelIs")
	member(b, first, "label"); encode_string(b, y.label)

	case TriggerCondition_AttackersDeclaredCount: member(b, first, "type"); json.write_string(b, "AttackersDeclaredCount")
	member(b, first, "subject"); encode_AttackersDeclaredCountSubject(b, y.subject)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "count"); encode_u32(b, y.count)

	case TriggerCondition_ExceptFirstDrawInDrawStep: _ = y; member(b, first, "type"); json.write_string(b, "ExceptFirstDrawInDrawStep")
	case TriggerCondition_PlacedByAbilitySource: _ = y; member(b, first, "type"); json.write_string(b, "PlacedByAbilitySource")
	case TriggerCondition_AddedManaWithThisAbilityThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "AddedManaWithThisAbilityThisTurn")
	case TriggerCondition_TriggeringSpellTargetsFilter: member(b, first, "type"); json.write_string(b, "TriggeringSpellTargetsFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case TriggerCondition_TriggeringSpellMatchesFilter: member(b, first, "type"); json.write_string(b, "TriggeringSpellMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case TriggerCondition_And: member(b, first, "type"); json.write_string(b, "And")
	member(b, first, "conditions"); enc_dyn_TriggerCondition(b, y.conditions)

	case TriggerCondition_Or: member(b, first, "type"); json.write_string(b, "Or")
	member(b, first, "conditions"); enc_dyn_TriggerCondition(b, y.conditions)

	case TriggerCondition_Not: member(b, first, "type"); json.write_string(b, "Not")
	member(b, first, "condition"); enc_ptr_TriggerCondition(b, y.condition)

	case TriggerCondition_EventTime: member(b, first, "type"); json.write_string(b, "EventTime")
	member(b, first, "condition"); enc_ptr_TriggerCondition(b, y.condition)

	}
}

decode_StaticCondition :: proc(v: json.Value, out: ^StaticCondition) -> bool {
	if v.kind != .Object do return fail("StaticCondition: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("StaticCondition: no tag")
	switch tv.text {
	case "DevotionGE":
		tmp: StaticCondition_DevotionGE
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_DevotionGE) -> bool {
	if fv, found := get_any(v, "colors"); found { if !dec_dyn_ManaColor(fv, &out.colors) do return fail("StaticCondition::DevotionGE.colors") } else { return fail("StaticCondition::DevotionGE.colors missing") }
	if fv, found := get_any(v, "threshold"); found { if !decode_u32(fv, &out.threshold) do return fail("StaticCondition::DevotionGE.threshold") } else { return fail("StaticCondition::DevotionGE.threshold missing") }
	return true
		}) { return fail("StaticCondition::DevotionGE") }
		out^ = tmp
	case "IsPresent":
		tmp: StaticCondition_IsPresent
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_IsPresent) -> bool {
	if fv, found := get_any(v, "filter"); found { if !dec_opt_TargetFilter(fv, &out.filter) do return fail("StaticCondition::IsPresent.filter") }
	return true
		}) { return fail("StaticCondition::IsPresent") }
		out^ = tmp
	case "ChosenColorIs":
		tmp: StaticCondition_ChosenColorIs
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_ChosenColorIs) -> bool {
	if fv, found := get_any(v, "color"); found { if !decode_ManaColor(fv, &out.color) do return fail("StaticCondition::ChosenColorIs.color") } else { return fail("StaticCondition::ChosenColorIs.color missing") }
	return true
		}) { return fail("StaticCondition::ChosenColorIs") }
		out^ = tmp
	case "ChosenLabelIs":
		tmp: StaticCondition_ChosenLabelIs
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_ChosenLabelIs) -> bool {
	if fv, found := get_any(v, "label"); found { if !decode_string(fv, &out.label) do return fail("StaticCondition::ChosenLabelIs.label") } else { return fail("StaticCondition::ChosenLabelIs.label missing") }
	return true
		}) { return fail("StaticCondition::ChosenLabelIs") }
		out^ = tmp
	case "QuantityComparison":
		tmp: StaticCondition_QuantityComparison
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_QuantityComparison) -> bool {
	if fv, found := get_any(v, "lhs"); found { if !decode_QuantityExpr(fv, &out.lhs) do return fail("StaticCondition::QuantityComparison.lhs") } else { return fail("StaticCondition::QuantityComparison.lhs missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("StaticCondition::QuantityComparison.comparator") } else { return fail("StaticCondition::QuantityComparison.comparator missing") }
	if fv, found := get_any(v, "rhs"); found { if !decode_QuantityExpr(fv, &out.rhs) do return fail("StaticCondition::QuantityComparison.rhs") } else { return fail("StaticCondition::QuantityComparison.rhs missing") }
	return true
		}) { return fail("StaticCondition::QuantityComparison") }
		out^ = tmp
	case "QuantityQuality":
		tmp: StaticCondition_QuantityQuality
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_QuantityQuality) -> bool {
	if fv, found := get_any(v, "quantity"); found { if !decode_QuantityExpr(fv, &out.quantity) do return fail("StaticCondition::QuantityQuality.quantity") } else { return fail("StaticCondition::QuantityQuality.quantity missing") }
	if fv, found := get_any(v, "quality"); found { if !decode_NumberQuality(fv, &out.quality) do return fail("StaticCondition::QuantityQuality.quality") } else { return fail("StaticCondition::QuantityQuality.quality missing") }
	return true
		}) { return fail("StaticCondition::QuantityQuality") }
		out^ = tmp
	case "HasMaxSpeed": out^ = StaticCondition_HasMaxSpeed{}
	case "SpeedGE":
		tmp: StaticCondition_SpeedGE
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_SpeedGE) -> bool {
	if fv, found := get_any(v, "threshold"); found { if !decode_u8(fv, &out.threshold) do return fail("StaticCondition::SpeedGE.threshold") } else { return fail("StaticCondition::SpeedGE.threshold missing") }
	return true
		}) { return fail("StaticCondition::SpeedGE") }
		out^ = tmp
	case "And":
		tmp: StaticCondition_And
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_And) -> bool {
	if fv, found := get_any(v, "conditions"); found { if !dec_dyn_StaticCondition(fv, &out.conditions) do return fail("StaticCondition::And.conditions") } else { return fail("StaticCondition::And.conditions missing") }
	return true
		}) { return fail("StaticCondition::And") }
		out^ = tmp
	case "Or":
		tmp: StaticCondition_Or
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_Or) -> bool {
	if fv, found := get_any(v, "conditions"); found { if !dec_dyn_StaticCondition(fv, &out.conditions) do return fail("StaticCondition::Or.conditions") } else { return fail("StaticCondition::Or.conditions missing") }
	return true
		}) { return fail("StaticCondition::Or") }
		out^ = tmp
	case "Not":
		tmp: StaticCondition_Not
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_Not) -> bool {
	if fv, found := get_any(v, "condition"); found { if !dec_ptr_StaticCondition(fv, &out.condition) do return fail("StaticCondition::Not.condition") } else { return fail("StaticCondition::Not.condition missing") }
	return true
		}) { return fail("StaticCondition::Not") }
		out^ = tmp
	case "DayNightIs":
		tmp: StaticCondition_DayNightIs
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_DayNightIs) -> bool {
	if fv, found := get_any(v, "state"); found { if !decode_DayNight(fv, &out.state) do return fail("StaticCondition::DayNightIs.state") } else { return fail("StaticCondition::DayNightIs.state missing") }
	return true
		}) { return fail("StaticCondition::DayNightIs") }
		out^ = tmp
	case "HasCounters":
		tmp: StaticCondition_HasCounters
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_HasCounters) -> bool {
	if fv, found := get_any(v, "counters"); found { if !decode_CounterMatch(fv, &out.counters) do return fail("StaticCondition::HasCounters.counters") } else { return fail("StaticCondition::HasCounters.counters missing") }
	if fv, found := get_any(v, "minimum"); found { if !decode_u32(fv, &out.minimum) do return fail("StaticCondition::HasCounters.minimum") } else { return fail("StaticCondition::HasCounters.minimum missing") }
	if fv, found := get_any(v, "maximum"); found { if !dec_opt_u32(fv, &out.maximum) do return fail("StaticCondition::HasCounters.maximum") }
	return true
		}) { return fail("StaticCondition::HasCounters") }
		out^ = tmp
	case "CastVariantPaid":
		tmp: StaticCondition_CastVariantPaid
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_CastVariantPaid) -> bool {
	if fv, found := get_any(v, "variant"); found { if !decode_CastVariantPaid(fv, &out.variant) do return fail("StaticCondition::CastVariantPaid.variant") } else { return fail("StaticCondition::CastVariantPaid.variant missing") }
	return true
		}) { return fail("StaticCondition::CastVariantPaid") }
		out^ = tmp
	case "RecipientHasCounters":
		tmp: StaticCondition_RecipientHasCounters
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_RecipientHasCounters) -> bool {
	if fv, found := get_any(v, "counters"); found { if !decode_CounterMatch(fv, &out.counters) do return fail("StaticCondition::RecipientHasCounters.counters") } else { return fail("StaticCondition::RecipientHasCounters.counters missing") }
	if fv, found := get_any(v, "minimum"); found { if !decode_u32(fv, &out.minimum) do return fail("StaticCondition::RecipientHasCounters.minimum") } else { return fail("StaticCondition::RecipientHasCounters.minimum missing") }
	if fv, found := get_any(v, "maximum"); found { if !dec_opt_u32(fv, &out.maximum) do return fail("StaticCondition::RecipientHasCounters.maximum") }
	return true
		}) { return fail("StaticCondition::RecipientHasCounters") }
		out^ = tmp
	case "ClassLevelGE":
		tmp: StaticCondition_ClassLevelGE
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_ClassLevelGE) -> bool {
	if fv, found := get_any(v, "level"); found { if !decode_u8(fv, &out.level) do return fail("StaticCondition::ClassLevelGE.level") } else { return fail("StaticCondition::ClassLevelGE.level missing") }
	return true
		}) { return fail("StaticCondition::ClassLevelGE") }
		out^ = tmp
	case "DefendingPlayerControls":
		tmp: StaticCondition_DefendingPlayerControls
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_DefendingPlayerControls) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("StaticCondition::DefendingPlayerControls.filter") } else { return fail("StaticCondition::DefendingPlayerControls.filter missing") }
	return true
		}) { return fail("StaticCondition::DefendingPlayerControls") }
		out^ = tmp
	case "SourceAttackingAlone": out^ = StaticCondition_SourceAttackingAlone{}
	case "SourceIsAttacking": out^ = StaticCondition_SourceIsAttacking{}
	case "SourceIsBlocking": out^ = StaticCondition_SourceIsBlocking{}
	case "SourceIsBlocked": out^ = StaticCondition_SourceIsBlocked{}
	case "IsMonarch":
		tmp: StaticCondition_IsMonarch
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_IsMonarch) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerScope(fv, &out.player) do return fail("StaticCondition::IsMonarch.player") } else { out.player = default_StaticCondition_player_scope_controller() }
	return true
		}) { return fail("StaticCondition::IsMonarch") }
		out^ = tmp
	case "HasBoon":
		tmp: StaticCondition_HasBoon
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_HasBoon) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerScope(fv, &out.player) do return fail("StaticCondition::HasBoon.player") } else { out.player = default_StaticCondition_player_scope_controller() }
	return true
		}) { return fail("StaticCondition::HasBoon") }
		out^ = tmp
	case "IsInitiative": out^ = StaticCondition_IsInitiative{}
	case "NoMonarch": out^ = StaticCondition_NoMonarch{}
	case "HasCityBlessing": out^ = StaticCondition_HasCityBlessing{}
	case "HasEnduringStory": out^ = StaticCondition_HasEnduringStory{}
	case "CompletedADungeon": out^ = StaticCondition_CompletedADungeon{}
	case "WasStartingPlayer":
		tmp: StaticCondition_WasStartingPlayer
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_WasStartingPlayer) -> bool {
	if fv, found := get_any(v, "controller"); found { if !decode_ControllerRef(fv, &out.controller) do return fail("StaticCondition::WasStartingPlayer.controller") } else { return fail("StaticCondition::WasStartingPlayer.controller missing") }
	return true
		}) { return fail("StaticCondition::WasStartingPlayer") }
		out^ = tmp
	case "SpellCastWithVariantThisTurn":
		tmp: StaticCondition_SpellCastWithVariantThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_SpellCastWithVariantThisTurn) -> bool {
	if fv, found := get_any(v, "variant"); found { if !decode_CastingVariant(fv, &out.variant) do return fail("StaticCondition::SpellCastWithVariantThisTurn.variant") } else { return fail("StaticCondition::SpellCastWithVariantThisTurn.variant missing") }
	return true
		}) { return fail("StaticCondition::SpellCastWithVariantThisTurn") }
		out^ = tmp
	case "AnyPlayerAttackedYouLastTurn":
		tmp: StaticCondition_AnyPlayerAttackedYouLastTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_AnyPlayerAttackedYouLastTurn) -> bool {
	if fv, found := get_any(v, "scope"); found { if !decode_AttackedYouScope(fv, &out.scope) do return fail("StaticCondition::AnyPlayerAttackedYouLastTurn.scope") }
	return true
		}) { return fail("StaticCondition::AnyPlayerAttackedYouLastTurn") }
		out^ = tmp
	case "PlayerAttackedPlayer":
		tmp: StaticCondition_PlayerAttackedPlayer
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_PlayerAttackedPlayer) -> bool {
	if fv, found := get_any(v, "attacker"); found { if !decode_ControllerRef(fv, &out.attacker) do return fail("StaticCondition::PlayerAttackedPlayer.attacker") } else { return fail("StaticCondition::PlayerAttackedPlayer.attacker missing") }
	if fv, found := get_any(v, "defender"); found { if !decode_ControllerRef(fv, &out.defender) do return fail("StaticCondition::PlayerAttackedPlayer.defender") } else { return fail("StaticCondition::PlayerAttackedPlayer.defender missing") }
	return true
		}) { return fail("StaticCondition::PlayerAttackedPlayer") }
		out^ = tmp
	case "OpponentPoisonAtLeast":
		tmp: StaticCondition_OpponentPoisonAtLeast
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_OpponentPoisonAtLeast) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("StaticCondition::OpponentPoisonAtLeast.count") } else { return fail("StaticCondition::OpponentPoisonAtLeast.count missing") }
	return true
		}) { return fail("StaticCondition::OpponentPoisonAtLeast") }
		out^ = tmp
	case "PlayerIsPoisoned":
		tmp: StaticCondition_PlayerIsPoisoned
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_PlayerIsPoisoned) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerScope(fv, &out.player) do return fail("StaticCondition::PlayerIsPoisoned.player") } else { out.player = default_StaticCondition_player_scope_controller() }
	return true
		}) { return fail("StaticCondition::PlayerIsPoisoned") }
		out^ = tmp
	case "UnlessPay":
		tmp: StaticCondition_UnlessPay
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_UnlessPay) -> bool {
	if fv, found := get_any(v, "cost"); found { if !decode_ManaCost(fv, &out.cost) do return fail("StaticCondition::UnlessPay.cost") } else { return fail("StaticCondition::UnlessPay.cost missing") }
	if fv, found := get_any(v, "scaling"); found { if !decode_UnlessPayScaling(fv, &out.scaling) do return fail("StaticCondition::UnlessPay.scaling") } else { out.scaling = UnlessPayScaling(UnlessPayScaling_Flat{}) }
	if fv, found := get_any(v, "defended"); found { if !dec_opt_AttackTargetFilter(fv, &out.defended) do return fail("StaticCondition::UnlessPay.defended") }
	return true
		}) { return fail("StaticCondition::UnlessPay") }
		out^ = tmp
	case "Unrecognized":
		tmp: StaticCondition_Unrecognized
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_Unrecognized) -> bool {
	if fv, found := get_any(v, "text"); found { if !decode_string(fv, &out.text) do return fail("StaticCondition::Unrecognized.text") } else { return fail("StaticCondition::Unrecognized.text missing") }
	return true
		}) { return fail("StaticCondition::Unrecognized") }
		out^ = tmp
	case "DuringYourTurn": out^ = StaticCondition_DuringYourTurn{}
	case "FirstCombatPhaseOfTurn": out^ = StaticCondition_FirstCombatPhaseOfTurn{}
	case "DuringOpponentsTurn": out^ = StaticCondition_DuringOpponentsTurn{}
	case "SharesColorWithMostCommonColorAmongPermanents": out^ = StaticCondition_SharesColorWithMostCommonColorAmongPermanents{}
	case "SourceEnteredThisTurn": out^ = StaticCondition_SourceEnteredThisTurn{}
	case "SourceHasDealtDamage":
		tmp: StaticCondition_SourceHasDealtDamage
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_SourceHasDealtDamage) -> bool {
	if fv, found := get_any(v, "kind"); found { if !decode_DamageKindFilter(fv, &out.kind) do return fail("StaticCondition::SourceHasDealtDamage.kind") } else { out.kind = default_StaticCondition_default_damage_kind() }
	return true
		}) { return fail("StaticCondition::SourceHasDealtDamage") }
		out^ = tmp
	case "SourceExertedThisTurn": out^ = StaticCondition_SourceExertedThisTurn{}
	case "WasCast":
		tmp: StaticCondition_WasCast
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_WasCast) -> bool {
	if fv, found := get_any(v, "zone"); found { if !dec_opt_Zone(fv, &out.zone) do return fail("StaticCondition::WasCast.zone") }
	return true
		}) { return fail("StaticCondition::WasCast") }
		out^ = tmp
	case "IsRingBearer": out^ = StaticCondition_IsRingBearer{}
	case "RingLevelAtLeast":
		tmp: StaticCondition_RingLevelAtLeast
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_RingLevelAtLeast) -> bool {
	if fv, found := get_any(v, "level"); found { if !decode_u8(fv, &out.level) do return fail("StaticCondition::RingLevelAtLeast.level") } else { return fail("StaticCondition::RingLevelAtLeast.level missing") }
	return true
		}) { return fail("StaticCondition::RingLevelAtLeast") }
		out^ = tmp
	case "ControlsCommander":
		tmp: StaticCondition_ControlsCommander
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_ControlsCommander) -> bool {
	if fv, found := get_any(v, "ownership"); found { if !decode_CommanderOwnership(fv, &out.ownership) do return fail("StaticCondition::ControlsCommander.ownership") } else { return fail("StaticCondition::ControlsCommander.ownership missing") }
	return true
		}) { return fail("StaticCondition::ControlsCommander") }
		out^ = tmp
	case "SourceIsTapped": out^ = StaticCondition_SourceIsTapped{}
	case "IsTapped":
		tmp: StaticCondition_IsTapped
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_IsTapped) -> bool {
	if fv, found := get_any(v, "scope"); found { if !decode_ObjectScope(fv, &out.scope) do return fail("StaticCondition::IsTapped.scope") } else { return fail("StaticCondition::IsTapped.scope missing") }
	return true
		}) { return fail("StaticCondition::IsTapped") }
		out^ = tmp
	case "SourceIsFaceUp": out^ = StaticCondition_SourceIsFaceUp{}
	case "SourceIsSaddled": out^ = StaticCondition_SourceIsSaddled{}
	case "SourceControllerEquals":
		tmp: StaticCondition_SourceControllerEquals
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_SourceControllerEquals) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("StaticCondition::SourceControllerEquals.player") } else { return fail("StaticCondition::SourceControllerEquals.player missing") }
	return true
		}) { return fail("StaticCondition::SourceControllerEquals") }
		out^ = tmp
	case "SourceIsEquipped": out^ = StaticCondition_SourceIsEquipped{}
	case "SourceIsEnchanted": out^ = StaticCondition_SourceIsEnchanted{}
	case "SourceIsMonstrous": out^ = StaticCondition_SourceIsMonstrous{}
	case "SourceIsHarnessed": out^ = StaticCondition_SourceIsHarnessed{}
	case "SourceAttachedToCreature": out^ = StaticCondition_SourceAttachedToCreature{}
	case "SourceMatchesFilter":
		tmp: StaticCondition_SourceMatchesFilter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_SourceMatchesFilter) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("StaticCondition::SourceMatchesFilter.filter") } else { return fail("StaticCondition::SourceMatchesFilter.filter missing") }
	return true
		}) { return fail("StaticCondition::SourceMatchesFilter") }
		out^ = tmp
	case "TopOfLibraryMatches":
		tmp: StaticCondition_TopOfLibraryMatches
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_TopOfLibraryMatches) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("StaticCondition::TopOfLibraryMatches.filter") } else { return fail("StaticCondition::TopOfLibraryMatches.filter missing") }
	return true
		}) { return fail("StaticCondition::TopOfLibraryMatches") }
		out^ = tmp
	case "RecipientMatchesFilter":
		tmp: StaticCondition_RecipientMatchesFilter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_RecipientMatchesFilter) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("StaticCondition::RecipientMatchesFilter.filter") } else { return fail("StaticCondition::RecipientMatchesFilter.filter missing") }
	return true
		}) { return fail("StaticCondition::RecipientMatchesFilter") }
		out^ = tmp
	case "RecipientAttackingOwnerTarget":
		tmp: StaticCondition_RecipientAttackingOwnerTarget
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_RecipientAttackingOwnerTarget) -> bool {
	if fv, found := get_any(v, "target"); found { if !decode_AttackTargetFilter(fv, &out.target) do return fail("StaticCondition::RecipientAttackingOwnerTarget.target") } else { return fail("StaticCondition::RecipientAttackingOwnerTarget.target missing") }
	return true
		}) { return fail("StaticCondition::RecipientAttackingOwnerTarget") }
		out^ = tmp
	case "SourceIsPaired": out^ = StaticCondition_SourceIsPaired{}
	case "SourceInZone":
		tmp: StaticCondition_SourceInZone
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_SourceInZone) -> bool {
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("StaticCondition::SourceInZone.zone") } else { return fail("StaticCondition::SourceInZone.zone missing") }
	return true
		}) { return fail("StaticCondition::SourceInZone") }
		out^ = tmp
	case "EnchantedIsFaceDown": out^ = StaticCondition_EnchantedIsFaceDown{}
	case "AdditionalCostPaid": out^ = StaticCondition_AdditionalCostPaid{}
	case "CastingAsVariant":
		tmp: StaticCondition_CastingAsVariant
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_CastingAsVariant) -> bool {
	if fv, found := get_any(v, "variant"); found { if !decode_CastingVariant(fv, &out.variant) do return fail("StaticCondition::CastingAsVariant.variant") } else { return fail("StaticCondition::CastingAsVariant.variant missing") }
	return true
		}) { return fail("StaticCondition::CastingAsVariant") }
		out^ = tmp
	case "None": out^ = StaticCondition_None{}
	case: return fail("StaticCondition: unknown variant")
	}
	return true
}

encode_StaticCondition :: proc(b: ^strings.Builder, x: StaticCondition) {
	#partial switch y in x {
	case StaticCondition_DevotionGE: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DevotionGE")
	member(b, first, "colors"); enc_dyn_ManaColor(b, y.colors)
	member(b, first, "threshold"); encode_u32(b, y.threshold)
	}; strings.write_byte(b, '}')
	case StaticCondition_IsPresent: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "IsPresent")
	member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case StaticCondition_ChosenColorIs: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChosenColorIs")
	member(b, first, "color"); encode_ManaColor(b, y.color)
	}; strings.write_byte(b, '}')
	case StaticCondition_ChosenLabelIs: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChosenLabelIs")
	member(b, first, "label"); encode_string(b, y.label)
	}; strings.write_byte(b, '}')
	case StaticCondition_QuantityComparison: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "QuantityComparison")
	member(b, first, "lhs"); encode_QuantityExpr(b, y.lhs)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, y.rhs)
	}; strings.write_byte(b, '}')
	case StaticCondition_QuantityQuality: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "QuantityQuality")
	member(b, first, "quantity"); encode_QuantityExpr(b, y.quantity)
	member(b, first, "quality"); encode_NumberQuality(b, y.quality)
	}; strings.write_byte(b, '}')
	case StaticCondition_HasMaxSpeed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasMaxSpeed"); strings.write_byte(b, '}')
	case StaticCondition_SpeedGE: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SpeedGE")
	member(b, first, "threshold"); encode_u8(b, y.threshold)
	}; strings.write_byte(b, '}')
	case StaticCondition_And: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "And")
	member(b, first, "conditions"); enc_dyn_StaticCondition(b, y.conditions)
	}; strings.write_byte(b, '}')
	case StaticCondition_Or: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Or")
	member(b, first, "conditions"); enc_dyn_StaticCondition(b, y.conditions)
	}; strings.write_byte(b, '}')
	case StaticCondition_Not: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Not")
	member(b, first, "condition"); enc_ptr_StaticCondition(b, y.condition)
	}; strings.write_byte(b, '}')
	case StaticCondition_DayNightIs: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DayNightIs")
	member(b, first, "state"); encode_DayNight(b, y.state)
	}; strings.write_byte(b, '}')
	case StaticCondition_HasCounters: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HasCounters")
	member(b, first, "counters"); encode_CounterMatch(b, y.counters)
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	if !(y.maximum == nil) { member(b, first, "maximum"); enc_opt_u32(b, y.maximum) }
	}; strings.write_byte(b, '}')
	case StaticCondition_CastVariantPaid: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastVariantPaid")
	member(b, first, "variant"); encode_CastVariantPaid(b, y.variant)
	}; strings.write_byte(b, '}')
	case StaticCondition_RecipientHasCounters: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RecipientHasCounters")
	member(b, first, "counters"); encode_CounterMatch(b, y.counters)
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	if !(y.maximum == nil) { member(b, first, "maximum"); enc_opt_u32(b, y.maximum) }
	}; strings.write_byte(b, '}')
	case StaticCondition_ClassLevelGE: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ClassLevelGE")
	member(b, first, "level"); encode_u8(b, y.level)
	}; strings.write_byte(b, '}')
	case StaticCondition_DefendingPlayerControls: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DefendingPlayerControls")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case StaticCondition_SourceAttackingAlone: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceAttackingAlone"); strings.write_byte(b, '}')
	case StaticCondition_SourceIsAttacking: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsAttacking"); strings.write_byte(b, '}')
	case StaticCondition_SourceIsBlocking: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsBlocking"); strings.write_byte(b, '}')
	case StaticCondition_SourceIsBlocked: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsBlocked"); strings.write_byte(b, '}')
	case StaticCondition_IsMonarch: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "IsMonarch")
	if !(skip_StaticCondition_is_player_scope_controller(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }
	}; strings.write_byte(b, '}')
	case StaticCondition_HasBoon: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HasBoon")
	if !(skip_StaticCondition_is_player_scope_controller(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }
	}; strings.write_byte(b, '}')
	case StaticCondition_IsInitiative: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "IsInitiative"); strings.write_byte(b, '}')
	case StaticCondition_NoMonarch: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NoMonarch"); strings.write_byte(b, '}')
	case StaticCondition_HasCityBlessing: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasCityBlessing"); strings.write_byte(b, '}')
	case StaticCondition_HasEnduringStory: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasEnduringStory"); strings.write_byte(b, '}')
	case StaticCondition_CompletedADungeon: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CompletedADungeon"); strings.write_byte(b, '}')
	case StaticCondition_WasStartingPlayer: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WasStartingPlayer")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)
	}; strings.write_byte(b, '}')
	case StaticCondition_SpellCastWithVariantThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SpellCastWithVariantThisTurn")
	member(b, first, "variant"); encode_CastingVariant(b, y.variant)
	}; strings.write_byte(b, '}')
	case StaticCondition_AnyPlayerAttackedYouLastTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AnyPlayerAttackedYouLastTurn")
	if !(skip_StaticCondition_AttackedYouScope_is_any_player(y.scope)) { member(b, first, "scope"); encode_AttackedYouScope(b, y.scope) }
	}; strings.write_byte(b, '}')
	case StaticCondition_PlayerAttackedPlayer: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PlayerAttackedPlayer")
	member(b, first, "attacker"); encode_ControllerRef(b, y.attacker)
	member(b, first, "defender"); encode_ControllerRef(b, y.defender)
	}; strings.write_byte(b, '}')
	case StaticCondition_OpponentPoisonAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "OpponentPoisonAtLeast")
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}')
	case StaticCondition_PlayerIsPoisoned: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PlayerIsPoisoned")
	if !(skip_StaticCondition_is_player_scope_controller(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }
	}; strings.write_byte(b, '}')
	case StaticCondition_UnlessPay: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UnlessPay")
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	if !(skip_StaticCondition_UnlessPayScaling_is_flat(y.scaling)) { member(b, first, "scaling"); encode_UnlessPayScaling(b, y.scaling) }
	if !(y.defended == nil) { member(b, first, "defended"); enc_opt_AttackTargetFilter(b, y.defended) }
	}; strings.write_byte(b, '}')
	case StaticCondition_Unrecognized: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Unrecognized")
	member(b, first, "text"); encode_string(b, y.text)
	}; strings.write_byte(b, '}')
	case StaticCondition_DuringYourTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DuringYourTurn"); strings.write_byte(b, '}')
	case StaticCondition_FirstCombatPhaseOfTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "FirstCombatPhaseOfTurn"); strings.write_byte(b, '}')
	case StaticCondition_DuringOpponentsTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DuringOpponentsTurn"); strings.write_byte(b, '}')
	case StaticCondition_SharesColorWithMostCommonColorAmongPermanents: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SharesColorWithMostCommonColorAmongPermanents"); strings.write_byte(b, '}')
	case StaticCondition_SourceEnteredThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceEnteredThisTurn"); strings.write_byte(b, '}')
	case StaticCondition_SourceHasDealtDamage: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceHasDealtDamage")
	if !(skip_StaticCondition_is_default_damage_kind(y.kind)) { member(b, first, "kind"); encode_DamageKindFilter(b, y.kind) }
	}; strings.write_byte(b, '}')
	case StaticCondition_SourceExertedThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceExertedThisTurn"); strings.write_byte(b, '}')
	case StaticCondition_WasCast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WasCast")
	if !(y.zone == nil) { member(b, first, "zone"); enc_opt_Zone(b, y.zone) }
	}; strings.write_byte(b, '}')
	case StaticCondition_IsRingBearer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "IsRingBearer"); strings.write_byte(b, '}')
	case StaticCondition_RingLevelAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RingLevelAtLeast")
	member(b, first, "level"); encode_u8(b, y.level)
	}; strings.write_byte(b, '}')
	case StaticCondition_ControlsCommander: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControlsCommander")
	member(b, first, "ownership"); encode_CommanderOwnership(b, y.ownership)
	}; strings.write_byte(b, '}')
	case StaticCondition_SourceIsTapped: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsTapped"); strings.write_byte(b, '}')
	case StaticCondition_IsTapped: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "IsTapped")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)
	}; strings.write_byte(b, '}')
	case StaticCondition_SourceIsFaceUp: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsFaceUp"); strings.write_byte(b, '}')
	case StaticCondition_SourceIsSaddled: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsSaddled"); strings.write_byte(b, '}')
	case StaticCondition_SourceControllerEquals: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceControllerEquals")
	member(b, first, "player"); encode_PlayerId(b, y.player)
	}; strings.write_byte(b, '}')
	case StaticCondition_SourceIsEquipped: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsEquipped"); strings.write_byte(b, '}')
	case StaticCondition_SourceIsEnchanted: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsEnchanted"); strings.write_byte(b, '}')
	case StaticCondition_SourceIsMonstrous: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsMonstrous"); strings.write_byte(b, '}')
	case StaticCondition_SourceIsHarnessed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsHarnessed"); strings.write_byte(b, '}')
	case StaticCondition_SourceAttachedToCreature: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceAttachedToCreature"); strings.write_byte(b, '}')
	case StaticCondition_SourceMatchesFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case StaticCondition_TopOfLibraryMatches: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TopOfLibraryMatches")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case StaticCondition_RecipientMatchesFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RecipientMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case StaticCondition_RecipientAttackingOwnerTarget: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RecipientAttackingOwnerTarget")
	member(b, first, "target"); encode_AttackTargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case StaticCondition_SourceIsPaired: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsPaired"); strings.write_byte(b, '}')
	case StaticCondition_SourceInZone: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceInZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	}; strings.write_byte(b, '}')
	case StaticCondition_EnchantedIsFaceDown: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EnchantedIsFaceDown"); strings.write_byte(b, '}')
	case StaticCondition_AdditionalCostPaid: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AdditionalCostPaid"); strings.write_byte(b, '}')
	case StaticCondition_CastingAsVariant: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastingAsVariant")
	member(b, first, "variant"); encode_CastingVariant(b, y.variant)
	}; strings.write_byte(b, '}')
	case StaticCondition_None: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "None"); strings.write_byte(b, '}')
	}
}

encode_StaticCondition_members :: proc(b: ^strings.Builder, x: StaticCondition, first: ^bool) {
	#partial switch y in x {
	case StaticCondition_DevotionGE: member(b, first, "type"); json.write_string(b, "DevotionGE")
	member(b, first, "colors"); enc_dyn_ManaColor(b, y.colors)
	member(b, first, "threshold"); encode_u32(b, y.threshold)

	case StaticCondition_IsPresent: member(b, first, "type"); json.write_string(b, "IsPresent")
	member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter)

	case StaticCondition_ChosenColorIs: member(b, first, "type"); json.write_string(b, "ChosenColorIs")
	member(b, first, "color"); encode_ManaColor(b, y.color)

	case StaticCondition_ChosenLabelIs: member(b, first, "type"); json.write_string(b, "ChosenLabelIs")
	member(b, first, "label"); encode_string(b, y.label)

	case StaticCondition_QuantityComparison: member(b, first, "type"); json.write_string(b, "QuantityComparison")
	member(b, first, "lhs"); encode_QuantityExpr(b, y.lhs)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, y.rhs)

	case StaticCondition_QuantityQuality: member(b, first, "type"); json.write_string(b, "QuantityQuality")
	member(b, first, "quantity"); encode_QuantityExpr(b, y.quantity)
	member(b, first, "quality"); encode_NumberQuality(b, y.quality)

	case StaticCondition_HasMaxSpeed: _ = y; member(b, first, "type"); json.write_string(b, "HasMaxSpeed")
	case StaticCondition_SpeedGE: member(b, first, "type"); json.write_string(b, "SpeedGE")
	member(b, first, "threshold"); encode_u8(b, y.threshold)

	case StaticCondition_And: member(b, first, "type"); json.write_string(b, "And")
	member(b, first, "conditions"); enc_dyn_StaticCondition(b, y.conditions)

	case StaticCondition_Or: member(b, first, "type"); json.write_string(b, "Or")
	member(b, first, "conditions"); enc_dyn_StaticCondition(b, y.conditions)

	case StaticCondition_Not: member(b, first, "type"); json.write_string(b, "Not")
	member(b, first, "condition"); enc_ptr_StaticCondition(b, y.condition)

	case StaticCondition_DayNightIs: member(b, first, "type"); json.write_string(b, "DayNightIs")
	member(b, first, "state"); encode_DayNight(b, y.state)

	case StaticCondition_HasCounters: member(b, first, "type"); json.write_string(b, "HasCounters")
	member(b, first, "counters"); encode_CounterMatch(b, y.counters)
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	if !(y.maximum == nil) { member(b, first, "maximum"); enc_opt_u32(b, y.maximum) }

	case StaticCondition_CastVariantPaid: member(b, first, "type"); json.write_string(b, "CastVariantPaid")
	member(b, first, "variant"); encode_CastVariantPaid(b, y.variant)

	case StaticCondition_RecipientHasCounters: member(b, first, "type"); json.write_string(b, "RecipientHasCounters")
	member(b, first, "counters"); encode_CounterMatch(b, y.counters)
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	if !(y.maximum == nil) { member(b, first, "maximum"); enc_opt_u32(b, y.maximum) }

	case StaticCondition_ClassLevelGE: member(b, first, "type"); json.write_string(b, "ClassLevelGE")
	member(b, first, "level"); encode_u8(b, y.level)

	case StaticCondition_DefendingPlayerControls: member(b, first, "type"); json.write_string(b, "DefendingPlayerControls")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case StaticCondition_SourceAttackingAlone: _ = y; member(b, first, "type"); json.write_string(b, "SourceAttackingAlone")
	case StaticCondition_SourceIsAttacking: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsAttacking")
	case StaticCondition_SourceIsBlocking: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsBlocking")
	case StaticCondition_SourceIsBlocked: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsBlocked")
	case StaticCondition_IsMonarch: member(b, first, "type"); json.write_string(b, "IsMonarch")
	if !(skip_StaticCondition_is_player_scope_controller(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }

	case StaticCondition_HasBoon: member(b, first, "type"); json.write_string(b, "HasBoon")
	if !(skip_StaticCondition_is_player_scope_controller(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }

	case StaticCondition_IsInitiative: _ = y; member(b, first, "type"); json.write_string(b, "IsInitiative")
	case StaticCondition_NoMonarch: _ = y; member(b, first, "type"); json.write_string(b, "NoMonarch")
	case StaticCondition_HasCityBlessing: _ = y; member(b, first, "type"); json.write_string(b, "HasCityBlessing")
	case StaticCondition_HasEnduringStory: _ = y; member(b, first, "type"); json.write_string(b, "HasEnduringStory")
	case StaticCondition_CompletedADungeon: _ = y; member(b, first, "type"); json.write_string(b, "CompletedADungeon")
	case StaticCondition_WasStartingPlayer: member(b, first, "type"); json.write_string(b, "WasStartingPlayer")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)

	case StaticCondition_SpellCastWithVariantThisTurn: member(b, first, "type"); json.write_string(b, "SpellCastWithVariantThisTurn")
	member(b, first, "variant"); encode_CastingVariant(b, y.variant)

	case StaticCondition_AnyPlayerAttackedYouLastTurn: member(b, first, "type"); json.write_string(b, "AnyPlayerAttackedYouLastTurn")
	if !(skip_StaticCondition_AttackedYouScope_is_any_player(y.scope)) { member(b, first, "scope"); encode_AttackedYouScope(b, y.scope) }

	case StaticCondition_PlayerAttackedPlayer: member(b, first, "type"); json.write_string(b, "PlayerAttackedPlayer")
	member(b, first, "attacker"); encode_ControllerRef(b, y.attacker)
	member(b, first, "defender"); encode_ControllerRef(b, y.defender)

	case StaticCondition_OpponentPoisonAtLeast: member(b, first, "type"); json.write_string(b, "OpponentPoisonAtLeast")
	member(b, first, "count"); encode_u32(b, y.count)

	case StaticCondition_PlayerIsPoisoned: member(b, first, "type"); json.write_string(b, "PlayerIsPoisoned")
	if !(skip_StaticCondition_is_player_scope_controller(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }

	case StaticCondition_UnlessPay: member(b, first, "type"); json.write_string(b, "UnlessPay")
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	if !(skip_StaticCondition_UnlessPayScaling_is_flat(y.scaling)) { member(b, first, "scaling"); encode_UnlessPayScaling(b, y.scaling) }
	if !(y.defended == nil) { member(b, first, "defended"); enc_opt_AttackTargetFilter(b, y.defended) }

	case StaticCondition_Unrecognized: member(b, first, "type"); json.write_string(b, "Unrecognized")
	member(b, first, "text"); encode_string(b, y.text)

	case StaticCondition_DuringYourTurn: _ = y; member(b, first, "type"); json.write_string(b, "DuringYourTurn")
	case StaticCondition_FirstCombatPhaseOfTurn: _ = y; member(b, first, "type"); json.write_string(b, "FirstCombatPhaseOfTurn")
	case StaticCondition_DuringOpponentsTurn: _ = y; member(b, first, "type"); json.write_string(b, "DuringOpponentsTurn")
	case StaticCondition_SharesColorWithMostCommonColorAmongPermanents: _ = y; member(b, first, "type"); json.write_string(b, "SharesColorWithMostCommonColorAmongPermanents")
	case StaticCondition_SourceEnteredThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "SourceEnteredThisTurn")
	case StaticCondition_SourceHasDealtDamage: member(b, first, "type"); json.write_string(b, "SourceHasDealtDamage")
	if !(skip_StaticCondition_is_default_damage_kind(y.kind)) { member(b, first, "kind"); encode_DamageKindFilter(b, y.kind) }

	case StaticCondition_SourceExertedThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "SourceExertedThisTurn")
	case StaticCondition_WasCast: member(b, first, "type"); json.write_string(b, "WasCast")
	if !(y.zone == nil) { member(b, first, "zone"); enc_opt_Zone(b, y.zone) }

	case StaticCondition_IsRingBearer: _ = y; member(b, first, "type"); json.write_string(b, "IsRingBearer")
	case StaticCondition_RingLevelAtLeast: member(b, first, "type"); json.write_string(b, "RingLevelAtLeast")
	member(b, first, "level"); encode_u8(b, y.level)

	case StaticCondition_ControlsCommander: member(b, first, "type"); json.write_string(b, "ControlsCommander")
	member(b, first, "ownership"); encode_CommanderOwnership(b, y.ownership)

	case StaticCondition_SourceIsTapped: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsTapped")
	case StaticCondition_IsTapped: member(b, first, "type"); json.write_string(b, "IsTapped")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)

	case StaticCondition_SourceIsFaceUp: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsFaceUp")
	case StaticCondition_SourceIsSaddled: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsSaddled")
	case StaticCondition_SourceControllerEquals: member(b, first, "type"); json.write_string(b, "SourceControllerEquals")
	member(b, first, "player"); encode_PlayerId(b, y.player)

	case StaticCondition_SourceIsEquipped: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsEquipped")
	case StaticCondition_SourceIsEnchanted: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsEnchanted")
	case StaticCondition_SourceIsMonstrous: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsMonstrous")
	case StaticCondition_SourceIsHarnessed: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsHarnessed")
	case StaticCondition_SourceAttachedToCreature: _ = y; member(b, first, "type"); json.write_string(b, "SourceAttachedToCreature")
	case StaticCondition_SourceMatchesFilter: member(b, first, "type"); json.write_string(b, "SourceMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case StaticCondition_TopOfLibraryMatches: member(b, first, "type"); json.write_string(b, "TopOfLibraryMatches")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case StaticCondition_RecipientMatchesFilter: member(b, first, "type"); json.write_string(b, "RecipientMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case StaticCondition_RecipientAttackingOwnerTarget: member(b, first, "type"); json.write_string(b, "RecipientAttackingOwnerTarget")
	member(b, first, "target"); encode_AttackTargetFilter(b, y.target)

	case StaticCondition_SourceIsPaired: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsPaired")
	case StaticCondition_SourceInZone: member(b, first, "type"); json.write_string(b, "SourceInZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)

	case StaticCondition_EnchantedIsFaceDown: _ = y; member(b, first, "type"); json.write_string(b, "EnchantedIsFaceDown")
	case StaticCondition_AdditionalCostPaid: _ = y; member(b, first, "type"); json.write_string(b, "AdditionalCostPaid")
	case StaticCondition_CastingAsVariant: member(b, first, "type"); json.write_string(b, "CastingAsVariant")
	member(b, first, "variant"); encode_CastingVariant(b, y.variant)

	case StaticCondition_None: _ = y; member(b, first, "type"); json.write_string(b, "None")
	}
}

decode_CounterTriggerFilter :: proc(v: json.Value, out: ^CounterTriggerFilter) -> bool {
	if v.kind != .Object do return fail("CounterTriggerFilter: not an object")
	if fv, found := get_any(v, "counter_type"); found { if !decode_CounterType(fv, &out.counter_type) do return fail("CounterTriggerFilter.counter_type") } else { return fail("CounterTriggerFilter.counter_type missing") }
	if fv, found := get_any(v, "threshold"); found { if !dec_opt_u32(fv, &out.threshold) do return fail("CounterTriggerFilter.threshold") }
	return true
}

encode_CounterTriggerFilter :: proc(b: ^strings.Builder, x: CounterTriggerFilter) {
	strings.write_byte(b, '{')
	f := true
	encode_CounterTriggerFilter_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CounterTriggerFilter_members :: proc(b: ^strings.Builder, x: CounterTriggerFilter, first: ^bool) {
	member(b, first, "counter_type"); encode_CounterType(b, x.counter_type)
	if !(x.threshold == nil) { member(b, first, "threshold"); enc_opt_u32(b, x.threshold) }
}

decode_GotchaCondition :: proc(v: json.Value, out: ^GotchaCondition) -> bool {
	if v.kind != .Object do return fail("GotchaCondition: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("GotchaCondition: no tag")
	switch tv.text {
	case "Physical": tmp: GotchaCondition_Physical; if !decode_PhysicalTell(json.get_or_null(v, "data"), &tmp._0) do return fail("GotchaCondition::Physical"); out^ = tmp
	case "SaysAnyOf":
		tmp: GotchaCondition_SaysAnyOf
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GotchaCondition_SaysAnyOf) -> bool {
	if fv, found := get_any(v, "words"); found { if !dec_dyn_string(fv, &out.words) do return fail("GotchaCondition::SaysAnyOf.words") } else { return fail("GotchaCondition::SaysAnyOf.words missing") }
	return true
		}) { return fail("GotchaCondition::SaysAnyOf") }
		out^ = tmp
	case "SaysNumber": out^ = GotchaCondition_SaysNumber{}
	case "SaysWordInGraveyardCardName": out^ = GotchaCondition_SaysWordInGraveyardCardName{}
	case: return fail("GotchaCondition: unknown variant")
	}
	return true
}

encode_GotchaCondition :: proc(b: ^strings.Builder, x: GotchaCondition) {
	#partial switch y in x {
	case GotchaCondition_Physical: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Physical"); member(b, &f, "data"); encode_PhysicalTell(b, y._0); strings.write_byte(b, '}')
	case GotchaCondition_SaysAnyOf: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SaysAnyOf"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "words"); enc_dyn_string(b, y.words)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GotchaCondition_SaysNumber: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SaysNumber"); strings.write_byte(b, '}')
	case GotchaCondition_SaysWordInGraveyardCardName: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SaysWordInGraveyardCardName"); strings.write_byte(b, '}')
	}
}

decode_AttackTargetFilter :: proc(v: json.Value, out: ^AttackTargetFilter) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("AttackTargetFilter: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("AttackTargetFilter: not a string or object")
	}
	switch variant {
	case "Player": out^ = AttackTargetFilter_Player{}
	case "Planeswalker":
		tmp: AttackTargetFilter_Planeswalker
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^AttackTargetFilter_Planeswalker) -> bool {
	if fv, found := get_any(v, "subtype"); found { if !dec_opt_string(fv, &out.subtype) do return fail("AttackTargetFilter::Planeswalker.subtype") }
	return true
		}) { return fail("AttackTargetFilter::Planeswalker") }
		out^ = tmp
	case "PlayerOrPlaneswalker": out^ = AttackTargetFilter_PlayerOrPlaneswalker{}
	case "Battle": out^ = AttackTargetFilter_Battle{}
	case "Owner": out^ = AttackTargetFilter_Owner{}
	case "OwnerOrPlaneswalker": out^ = AttackTargetFilter_OwnerOrPlaneswalker{}
	case "PlayerOrPermanents": out^ = AttackTargetFilter_PlayerOrPermanents{}
	case "Monarch": out^ = AttackTargetFilter_Monarch{}
	case "PlayerAttackedBySourceThisTurn": out^ = AttackTargetFilter_PlayerAttackedBySourceThisTurn{}
	case: return fail("AttackTargetFilter: unknown variant")
	}
	return true
}

encode_AttackTargetFilter :: proc(b: ^strings.Builder, x: AttackTargetFilter) {
	#partial switch y in x {
	case AttackTargetFilter_Player: _ = y; json.write_string(b, "Player")
	case AttackTargetFilter_Planeswalker: strings.write_byte(b, '{'); json.write_string(b, "Planeswalker"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "subtype"); enc_opt_string(b, y.subtype)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case AttackTargetFilter_PlayerOrPlaneswalker: _ = y; json.write_string(b, "PlayerOrPlaneswalker")
	case AttackTargetFilter_Battle: _ = y; json.write_string(b, "Battle")
	case AttackTargetFilter_Owner: _ = y; json.write_string(b, "Owner")
	case AttackTargetFilter_OwnerOrPlaneswalker: _ = y; json.write_string(b, "OwnerOrPlaneswalker")
	case AttackTargetFilter_PlayerOrPermanents: _ = y; json.write_string(b, "PlayerOrPermanents")
	case AttackTargetFilter_Monarch: _ = y; json.write_string(b, "Monarch")
	case AttackTargetFilter_PlayerAttackedBySourceThisTurn: _ = y; json.write_string(b, "PlayerAttackedBySourceThisTurn")
	}
}

decode_BlockerCountThreshold :: proc(v: json.Value, out: ^BlockerCountThreshold) -> bool {
	if v.kind != .Object do return fail("BlockerCountThreshold: not an object")
	if fv, found := get_any(v, "minimum"); found { if !decode_u32(fv, &out.minimum) do return fail("BlockerCountThreshold.minimum") } else { return fail("BlockerCountThreshold.minimum missing") }
	if fv, found := get_any(v, "blocker"); found { if !dec_opt_TargetFilter(fv, &out.blocker) do return fail("BlockerCountThreshold.blocker") }
	return true
}

encode_BlockerCountThreshold :: proc(b: ^strings.Builder, x: BlockerCountThreshold) {
	strings.write_byte(b, '{')
	f := true
	encode_BlockerCountThreshold_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_BlockerCountThreshold_members :: proc(b: ^strings.Builder, x: BlockerCountThreshold, first: ^bool) {
	member(b, first, "minimum"); encode_u32(b, x.minimum)
	if !(x.blocker == nil) { member(b, first, "blocker"); enc_opt_TargetFilter(b, x.blocker) }
}

decode_PlayerActionKind :: proc(v: json.Value, out: ^PlayerActionKind) -> bool {
	if v.kind != .String do return fail("PlayerActionKind: not a string")
	str := v.text
	switch str {
	case "AcceptedOptionalEffect": out^ = .AcceptedOptionalEffect
	case "SearchedLibrary": out^ = .SearchedLibrary
	case "Scry": out^ = .Scry
	case "Surveil": out^ = .Surveil
	case "CollectEvidence": out^ = .CollectEvidence
	case "ShuffledLibrary": out^ = .ShuffledLibrary
	case "Proliferate": out^ = .Proliferate
	case "Investigate": out^ = .Investigate
	case "Forage": out^ = .Forage
	case "Draw": out^ = .Draw
	case: return fail("PlayerActionKind: unknown variant")
	}
	return true
}

encode_PlayerActionKind :: proc(b: ^strings.Builder, x: PlayerActionKind) {
	@(static, rodata) NAMES := [PlayerActionKind]string{
