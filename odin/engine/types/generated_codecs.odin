encode_CardTypeSetSource_members :: proc(b: ^strings.Builder, x: CardTypeSetSource, first: ^bool) {
	#partial switch y in x {
	case CardTypeSetSource_Zone: member(b, first, "type"); json.write_string(b, "Zone")
	member(b, first, "zone"); encode_ZoneRef(b, y.zone)
	member(b, first, "scope"); encode_CountScope(b, y.scope)

	case CardTypeSetSource_ExiledBySource: _ = y; member(b, first, "type"); json.write_string(b, "ExiledBySource")
	case CardTypeSetSource_Objects: member(b, first, "type"); json.write_string(b, "Objects")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case CardTypeSetSource_TrackedSet: member(b, first, "type"); json.write_string(b, "TrackedSet")
	if !(skip_CardTypeSetSource_TrackedAnaphorSource_is_chain_set(y.set)) { member(b, first, "set"); encode_TrackedAnaphorSource(b, y.set) }
	if !(y.caused_by == nil) { member(b, first, "caused_by"); enc_opt_ThisWayCause(b, y.caused_by) }
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }

	case CardTypeSetSource_TurnJournal: member(b, first, "type"); json.write_string(b, "TurnJournal")
	member(b, first, "journal"); encode_TurnJournalKind(b, y.journal)
	member(b, first, "scope"); encode_CountScope(b, y.scope)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }

	case CardTypeSetSource_TargetedObjects: member(b, first, "type"); json.write_string(b, "TargetedObjects")
	if !(y.slot == nil) { member(b, first, "slot"); enc_opt_int(b, y.slot) }

	case CardTypeSetSource_AnyOf: member(b, first, "type"); json.write_string(b, "AnyOf")
	member(b, first, "sources"); encode_UnionSources(b, y.sources)

	}
}

