	if fv, found := get_any(v, "lki"); found { if !dec_ptr_LKISnapshot(fv, &out.lki) do return fail("ActivationTargetFact::Object.lki") } else { return fail("ActivationTargetFact::Object.lki missing") }
	return true
		}) { return fail("ActivationTargetFact::Object") }
		out^ = tmp
	case: return fail("ActivationTargetFact: unknown variant")
	}
	return true
}

encode_ActivationTargetFact :: proc(b: ^strings.Builder, x: ActivationTargetFact) {
