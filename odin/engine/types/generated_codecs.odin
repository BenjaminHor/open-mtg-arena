decode_IllegalTargetsDisposition :: proc(v: json.Value, out: ^IllegalTargetsDisposition) -> bool {
	when COVERAGE do cov_hit("IllegalTargetsDisposition")
	if v.kind != .Object do return fail("IllegalTargetsDisposition: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("IllegalTargetsDisposition: no tag")
	str := tv.text
	switch str {
	case "DoesNotResolve": when COVERAGE do cov_hit("IllegalTargetsDisposition::DoesNotResolve"); out^ = .DoesNotResolve
	case "StillResolves": when COVERAGE do cov_hit("IllegalTargetsDisposition::StillResolves"); out^ = .StillResolves
	case: return fail("IllegalTargetsDisposition: unknown variant")
	}
	return true
}

encode_IllegalTargetsDisposition :: proc(b: ^strings.Builder, x: IllegalTargetsDisposition) {
	strings.write_byte(b, '{')
	f := true
	encode_IllegalTargetsDisposition_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_IllegalTargetsDisposition_members :: proc(b: ^strings.Builder, x: IllegalTargetsDisposition, first: ^bool) {
	_ = x
	@(static, rodata) NAMES := [IllegalTargetsDisposition]string{
		.DoesNotResolve = "DoesNotResolve",
		.StillResolves = "StillResolves",
	}
	member(b, first, "type"); json.write_string(b, NAMES[x])
}

decode_CopyCountStatus :: proc(v: json.Value, out: ^CopyCountStatus) -> bool {
	when COVERAGE do cov_hit("CopyCountStatus")
	if v.kind != .String do return fail("CopyCountStatus: not a string")
	str := v.text
	switch str {
	case "Pending": when COVERAGE do cov_hit("CopyCountStatus::Pending"); out^ = .Pending
	case "Finalized": when COVERAGE do cov_hit("CopyCountStatus::Finalized"); out^ = .Finalized
	case: return fail("CopyCountStatus: unknown variant")
	}
	return true
}

encode_CopyCountStatus :: proc(b: ^strings.Builder, x: CopyCountStatus) {
	@(static, rodata) NAMES := [CopyCountStatus]string{
		.Pending = "Pending",
		.Finalized = "Finalized",
	}
	json.write_string(b, NAMES[x])
}

decode_NotedManaPayment :: proc(v: json.Value, out: ^NotedManaPayment) -> bool {
	when COVERAGE do cov_hit("NotedManaPayment")
	if v.kind != .Object do return fail("NotedManaPayment: not an object")
	if fv, found := get_any(v, "types"); found { if !dec_dyn_ManaType(fv, &out.types) do return fail("NotedManaPayment.types") } else { return fail("NotedManaPayment.types missing") }
	if fv, found := get_any(v, "source_incarnation"); found { if !decode_u64(fv, &out.source_incarnation) do return fail("NotedManaPayment.source_incarnation") } else { return fail("NotedManaPayment.source_incarnation missing") }
	return true
}

encode_NotedManaPayment :: proc(b: ^strings.Builder, x: NotedManaPayment) {
	strings.write_byte(b, '{')
	f := true
	encode_NotedManaPayment_members(b, x, &f)
