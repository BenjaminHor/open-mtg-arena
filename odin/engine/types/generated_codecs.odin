encode_EventObjectHistorySnapshot :: proc(b: ^strings.Builder, x: EventObjectHistorySnapshot) {
	strings.write_byte(b, '{')
	f := true
	encode_EventObjectHistorySnapshot_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_EventObjectHistorySnapshot_members :: proc(b: ^strings.Builder, x: EventObjectHistorySnapshot, first: ^bool) {
	member(b, first, "was_dealt_damage_this_turn"); encode_bool(b, x.was_dealt_damage_this_turn)
	member(b, first, "entered_this_turn"); encode_bool(b, x.entered_this_turn)
	member(b, first, "attacked_defenders_this_turn"); enc_dyn_PlayerId(b, x.attacked_defenders_this_turn)
	member(b, first, "blocked_this_turn"); encode_bool(b, x.blocked_this_turn)
	member(b, first, "zone_changes_this_turn"); enc_dyn_t2_opt_Zone_Zone(b, x.zone_changes_this_turn)
	member(b, first, "counters_put_on_this_turn"); enc_dyn_EventCounterHistoryEntry(b, x.counters_put_on_this_turn)
}

decode_EventObjectRelationSnapshot :: proc(v: json.Value, out: ^EventObjectRelationSnapshot) -> bool {
	when COVERAGE do cov_hit("EventObjectRelationSnapshot")
	if v.kind != .Object do return fail("EventObjectRelationSnapshot: not an object")
	if fv, found := get_any(v, "saddled_sources"); found { if !dec_dyn_ObjectIncarnationRef(fv, &out.saddled_sources) do return fail("EventObjectRelationSnapshot.saddled_sources") } else { return fail("EventObjectRelationSnapshot.saddled_sources missing") }
	if fv, found := get_any(v, "convoked_sources"); found { if !dec_dyn_ObjectIncarnationRef(fv, &out.convoked_sources) do return fail("EventObjectRelationSnapshot.convoked_sources") } else { return fail("EventObjectRelationSnapshot.convoked_sources missing") }
	if fv, found := get_any(v, "tracked_sets"); found { if !dec_dyn_EventTrackedSetMembership(fv, &out.tracked_sets) do return fail("EventObjectRelationSnapshot.tracked_sets") } else { return fail("EventObjectRelationSnapshot.tracked_sets missing") }
	return true
}

encode_EventObjectRelationSnapshot :: proc(b: ^strings.Builder, x: EventObjectRelationSnapshot) {
	strings.write_byte(b, '{')
	f := true
	encode_EventObjectRelationSnapshot_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_EventObjectRelationSnapshot_members :: proc(b: ^strings.Builder, x: EventObjectRelationSnapshot, first: ^bool) {
	member(b, first, "saddled_sources"); enc_dyn_ObjectIncarnationRef(b, x.saddled_sources)
	member(b, first, "convoked_sources"); enc_dyn_ObjectIncarnationRef(b, x.convoked_sources)
	member(b, first, "tracked_sets"); enc_dyn_EventTrackedSetMembership(b, x.tracked_sets)
}

