	return true
		}) { return fail("PendingSacrificeMove::DirectMove") }
		out^ = tmp
	case: return fail("PendingSacrificeMove: unknown variant")
	}
	return true
}

encode_PendingSacrificeMove :: proc(b: ^strings.Builder, x: PendingSacrificeMove) {
