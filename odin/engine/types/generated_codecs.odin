decode_ManaSupertype :: proc(v: json.Value, out: ^ManaSupertype) -> bool {
	when COVERAGE do cov_hit("ManaSupertype")
	if v.kind != .String do return fail("ManaSupertype: not a string")
	str := v.text
	switch str {
	case "Snow": when COVERAGE do cov_hit("ManaSupertype::Snow"); out^ = .Snow
	case: return fail("ManaSupertype: unknown variant")
	}
	return true
}

encode_ManaSupertype :: proc(b: ^strings.Builder, x: ManaSupertype) {
	@(static, rodata) NAMES := [ManaSupertype]string{
		.Snow = "Snow",
	}
	json.write_string(b, NAMES[x])
}

decode_RulesExecutionNodeKind :: proc(v: json.Value, out: ^RulesExecutionNodeKind) -> bool {
	when COVERAGE do cov_hit("RulesExecutionNodeKind")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("RulesExecutionNodeKind: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("RulesExecutionNodeKind: not a string or object")
	}
	switch variant {
	case "Proposal": when COVERAGE do cov_hit("RulesExecutionNodeKind::Proposal"); out^ = RulesExecutionNodeKind_Proposal{}
	case "ActivatedMana": when COVERAGE do cov_hit("RulesExecutionNodeKind::ActivatedMana");
		tmp: RulesExecutionNodeKind_ActivatedMana
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^RulesExecutionNodeKind_ActivatedMana) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectIncarnationRef(fv, &out.source) do return fail("RulesExecutionNodeKind::ActivatedMana.source") } else { return fail("RulesExecutionNodeKind::ActivatedMana.source missing") }
	return true
		}) { return fail("RulesExecutionNodeKind::ActivatedMana") }
		out^ = tmp
	case "TriggeredMana": when COVERAGE do cov_hit("RulesExecutionNodeKind::TriggeredMana");
		tmp: RulesExecutionNodeKind_TriggeredMana
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^RulesExecutionNodeKind_TriggeredMana) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectIncarnationRef(fv, &out.source) do return fail("RulesExecutionNodeKind::TriggeredMana.source") } else { return fail("RulesExecutionNodeKind::TriggeredMana.source missing") }
	if fv, found := get_any(v, "trigger"); found { if !dec_opt_TriggerDefinitionRef(fv, &out.trigger) do return fail("RulesExecutionNodeKind::TriggeredMana.trigger") }
	return true
		}) { return fail("RulesExecutionNodeKind::TriggeredMana") }
		out^ = tmp
	case "Payment": when COVERAGE do cov_hit("RulesExecutionNodeKind::Payment");
		tmp: RulesExecutionNodeKind_Payment
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^RulesExecutionNodeKind_Payment) -> bool {
	if fv, found := get_any(v, "payer"); found { if !decode_PlayerId(fv, &out.payer) do return fail("RulesExecutionNodeKind::Payment.payer") } else { return fail("RulesExecutionNodeKind::Payment.payer missing") }
	if fv, found := get_any(v, "recipient"); found { if !decode_ManaPaymentRecipient(fv, &out.recipient) do return fail("RulesExecutionNodeKind::Payment.recipient") } else { return fail("RulesExecutionNodeKind::Payment.recipient missing") }
	return true
		}) { return fail("RulesExecutionNodeKind::Payment") }
		out^ = tmp
	case "PlayerLeave": when COVERAGE do cov_hit("RulesExecutionNodeKind::PlayerLeave"); out^ = RulesExecutionNodeKind_PlayerLeave{}
	case: return fail("RulesExecutionNodeKind: unknown variant")
	}
	return true
}

encode_RulesExecutionNodeKind :: proc(b: ^strings.Builder, x: RulesExecutionNodeKind) {
	#partial switch y in x {
	case RulesExecutionNodeKind_Proposal: _ = y; json.write_string(b, "Proposal")
	case RulesExecutionNodeKind_ActivatedMana: strings.write_byte(b, '{'); json.write_string(b, "ActivatedMana"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source"); encode_ObjectIncarnationRef(b, y.source)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case RulesExecutionNodeKind_TriggeredMana: strings.write_byte(b, '{'); json.write_string(b, "TriggeredMana"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source"); encode_ObjectIncarnationRef(b, y.source)
	if !(y.trigger == nil) { member(b, first, "trigger"); enc_opt_TriggerDefinitionRef(b, y.trigger) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case RulesExecutionNodeKind_Payment: strings.write_byte(b, '{'); json.write_string(b, "Payment"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "payer"); encode_PlayerId(b, y.payer)
	member(b, first, "recipient"); encode_ManaPaymentRecipient(b, y.recipient)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case RulesExecutionNodeKind_PlayerLeave: _ = y; json.write_string(b, "PlayerLeave")
	}
}

decode_ManaPaymentRecipient :: proc(v: json.Value, out: ^ManaPaymentRecipient) -> bool {
	when COVERAGE do cov_hit("ManaPaymentRecipient")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ManaPaymentRecipient: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ManaPaymentRecipient: not a string or object")
	}
	switch variant {
	case "Object": when COVERAGE do cov_hit("ManaPaymentRecipient::Object"); tmp: ManaPaymentRecipient_Object; if !decode_ObjectIncarnationRef(body, &tmp._0) do return fail("ManaPaymentRecipient::Object"); out^ = tmp
	case "Player": when COVERAGE do cov_hit("ManaPaymentRecipient::Player"); tmp: ManaPaymentRecipient_Player; if !decode_PlayerId(body, &tmp._0) do return fail("ManaPaymentRecipient::Player"); out^ = tmp
	case: return fail("ManaPaymentRecipient: unknown variant")
	}
	return true
}

encode_ManaPaymentRecipient :: proc(b: ^strings.Builder, x: ManaPaymentRecipient) {
	#partial switch y in x {
	case ManaPaymentRecipient_Object: strings.write_byte(b, '{'); json.write_string(b, "Object"); strings.write_byte(b, ':'); encode_ObjectIncarnationRef(b, y._0); strings.write_byte(b, '}')
	case ManaPaymentRecipient_Player: strings.write_byte(b, '{'); json.write_string(b, "Player"); strings.write_byte(b, ':'); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	}
}

