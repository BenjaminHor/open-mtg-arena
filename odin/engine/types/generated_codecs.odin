decode_MulliganChoice :: proc(v: json.Value, out: ^MulliganChoice) -> bool {
	when COVERAGE do cov_hit("MulliganChoice")
	if v.kind != .Object do return fail("MulliganChoice: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("MulliganChoice: no tag")
	switch tv.text {
	case "Keep": when COVERAGE do cov_hit("MulliganChoice::Keep"); out^ = MulliganChoice_Keep{}
	case "Mulligan": when COVERAGE do cov_hit("MulliganChoice::Mulligan"); out^ = MulliganChoice_Mulligan{}
	case "UseSerumPowder": when COVERAGE do cov_hit("MulliganChoice::UseSerumPowder");
		tmp: MulliganChoice_UseSerumPowder
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^MulliganChoice_UseSerumPowder) -> bool {
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("MulliganChoice::UseSerumPowder.object_id") } else { return fail("MulliganChoice::UseSerumPowder.object_id missing") }
	return true
		}) { return fail("MulliganChoice::UseSerumPowder") }
		out^ = tmp
	case "FreeReveal": when COVERAGE do cov_hit("MulliganChoice::FreeReveal"); out^ = MulliganChoice_FreeReveal{}
	case: return fail("MulliganChoice: unknown variant")
	}
	return true
}

encode_MulliganChoice :: proc(b: ^strings.Builder, x: MulliganChoice) {
	#partial switch y in x {
	case MulliganChoice_Keep: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Keep"); strings.write_byte(b, '}')
	case MulliganChoice_Mulligan: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Mulligan"); strings.write_byte(b, '}')
	case MulliganChoice_UseSerumPowder: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "UseSerumPowder"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case MulliganChoice_FreeReveal: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "FreeReveal"); strings.write_byte(b, '}')
	}
}

