decode_ExileLinkKind :: proc(v: json.Value, out: ^ExileLinkKind) -> bool {
	when COVERAGE do cov_hit("ExileLinkKind")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ExileLinkKind: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ExileLinkKind: not a string or object")
	}
	switch variant {
	case "UntilSourceLeaves": when COVERAGE do cov_hit("ExileLinkKind::UntilSourceLeaves");
		tmp: ExileLinkKind_UntilSourceLeaves
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ExileLinkKind_UntilSourceLeaves) -> bool {
	if fv, found := get_any(v, "return_zone"); found { if !decode_Zone(fv, &out.return_zone) do return fail("ExileLinkKind::UntilSourceLeaves.return_zone") } else { return fail("ExileLinkKind::UntilSourceLeaves.return_zone missing") }
	return true
		}) { return fail("ExileLinkKind::UntilSourceLeaves") }
		out^ = tmp
	case "UntilOpponentBecomesMonarch": when COVERAGE do cov_hit("ExileLinkKind::UntilOpponentBecomesMonarch");
		tmp: ExileLinkKind_UntilOpponentBecomesMonarch
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ExileLinkKind_UntilOpponentBecomesMonarch) -> bool {
	if fv, found := get_any(v, "return_zone"); found { if !decode_Zone(fv, &out.return_zone) do return fail("ExileLinkKind::UntilOpponentBecomesMonarch.return_zone") } else { return fail("ExileLinkKind::UntilOpponentBecomesMonarch.return_zone missing") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("ExileLinkKind::UntilOpponentBecomesMonarch.controller") } else { return fail("ExileLinkKind::UntilOpponentBecomesMonarch.controller missing") }
	return true
		}) { return fail("ExileLinkKind::UntilOpponentBecomesMonarch") }
		out^ = tmp
	case "TrackedBySource": when COVERAGE do cov_hit("ExileLinkKind::TrackedBySource"); out^ = ExileLinkKind_TrackedBySource{}
	case "ParadigmSource": when COVERAGE do cov_hit("ExileLinkKind::ParadigmSource");
		tmp: ExileLinkKind_ParadigmSource
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ExileLinkKind_ParadigmSource) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("ExileLinkKind::ParadigmSource.player") } else { return fail("ExileLinkKind::ParadigmSource.player missing") }
	return true
		}) { return fail("ExileLinkKind::ParadigmSource") }
		out^ = tmp
	case "Cipher": when COVERAGE do cov_hit("ExileLinkKind::Cipher"); out^ = ExileLinkKind_Cipher{}
	case "Haunt": when COVERAGE do cov_hit("ExileLinkKind::Haunt"); out^ = ExileLinkKind_Haunt{}
	case "HideawayLookable": when COVERAGE do cov_hit("ExileLinkKind::HideawayLookable");
		tmp: ExileLinkKind_HideawayLookable
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ExileLinkKind_HideawayLookable) -> bool {
	if fv, found := get_any(v, "grant"); found { if !decode_LookGrant(fv, &out.grant) do return fail("ExileLinkKind::HideawayLookable.grant") } else { return fail("ExileLinkKind::HideawayLookable.grant missing") }
	if fv, found := get_any(v, "lookers"); found { if !dec_dyn_PlayerId(fv, &out.lookers) do return fail("ExileLinkKind::HideawayLookable.lookers") } else { return fail("ExileLinkKind::HideawayLookable.lookers missing") }
	if fv, found := get_any(v, "source_incarnation"); found { if !decode_u64(fv, &out.source_incarnation) do return fail("ExileLinkKind::HideawayLookable.source_incarnation") } else { return fail("ExileLinkKind::HideawayLookable.source_incarnation missing") }
	return true
		}) { return fail("ExileLinkKind::HideawayLookable") }
		out^ = tmp
	case "CraftMaterial": when COVERAGE do cov_hit("ExileLinkKind::CraftMaterial"); out^ = ExileLinkKind_CraftMaterial{}
	case "CastCost": when COVERAGE do cov_hit("ExileLinkKind::CastCost"); out^ = ExileLinkKind_CastCost{}
	case: return fail("ExileLinkKind: unknown variant")
	}
	return true
}

encode_ExileLinkKind :: proc(b: ^strings.Builder, x: ExileLinkKind) {
	#partial switch y in x {
	case ExileLinkKind_UntilSourceLeaves: strings.write_byte(b, '{'); json.write_string(b, "UntilSourceLeaves"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "return_zone"); encode_Zone(b, y.return_zone)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ExileLinkKind_UntilOpponentBecomesMonarch: strings.write_byte(b, '{'); json.write_string(b, "UntilOpponentBecomesMonarch"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "return_zone"); encode_Zone(b, y.return_zone)
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ExileLinkKind_TrackedBySource: _ = y; json.write_string(b, "TrackedBySource")
	case ExileLinkKind_ParadigmSource: strings.write_byte(b, '{'); json.write_string(b, "ParadigmSource"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ExileLinkKind_Cipher: _ = y; json.write_string(b, "Cipher")
	case ExileLinkKind_Haunt: _ = y; json.write_string(b, "Haunt")
	case ExileLinkKind_HideawayLookable: strings.write_byte(b, '{'); json.write_string(b, "HideawayLookable"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "grant"); encode_LookGrant(b, y.grant)
	member(b, first, "lookers"); enc_dyn_PlayerId(b, y.lookers)
	member(b, first, "source_incarnation"); encode_u64(b, y.source_incarnation)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ExileLinkKind_CraftMaterial: _ = y; json.write_string(b, "CraftMaterial")
	case ExileLinkKind_CastCost: _ = y; json.write_string(b, "CastCost")
	}
}

decode_LookGrant :: proc(v: json.Value, out: ^LookGrant) -> bool {
	when COVERAGE do cov_hit("LookGrant")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("LookGrant: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("LookGrant: not a string or object")
	}
	switch variant {
	case "SourceController": when COVERAGE do cov_hit("LookGrant::SourceController"); out^ = LookGrant_SourceController{}
	case "Player": when COVERAGE do cov_hit("LookGrant::Player");
		tmp: LookGrant_Player
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^LookGrant_Player) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("LookGrant::Player.player") } else { return fail("LookGrant::Player.player missing") }
	return true
		}) { return fail("LookGrant::Player") }
		out^ = tmp
	case: return fail("LookGrant: unknown variant")
	}
	return true
}

encode_LookGrant :: proc(b: ^strings.Builder, x: LookGrant) {
	#partial switch y in x {
	case LookGrant_SourceController: _ = y; json.write_string(b, "SourceController")
	case LookGrant_Player: strings.write_byte(b, '{'); json.write_string(b, "Player"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_DelayedTriggerCondition :: proc(v: json.Value, out: ^DelayedTriggerCondition) -> bool {
