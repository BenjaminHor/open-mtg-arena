decode_PhaseTransitionProgress :: proc(v: json.Value, out: ^PhaseTransitionProgress) -> bool {
	when COVERAGE do cov_hit("PhaseTransitionProgress")
	if v.kind != .Object do return fail("PhaseTransitionProgress: not an object")
	if fv, found := get_any(v, "remaining_players"); found { if !dec_dyn_PlayerId(fv, &out.remaining_players) do return fail("PhaseTransitionProgress.remaining_players") } else { return fail("PhaseTransitionProgress.remaining_players missing") }
	if fv, found := get_any(v, "next_phase"); found { if !decode_Phase(fv, &out.next_phase) do return fail("PhaseTransitionProgress.next_phase") } else { return fail("PhaseTransitionProgress.next_phase missing") }
	if fv, found := get_any(v, "owed_life_loss"); found { if !dec_dyn_PendingEmptyPoolLifeLoss(fv, &out.owed_life_loss) do return fail("PhaseTransitionProgress.owed_life_loss") }
	if fv, found := get_any(v, "in_flight_life_loss"); found { if !dec_opt_PendingEmptyPoolLifeLoss(fv, &out.in_flight_life_loss) do return fail("PhaseTransitionProgress.in_flight_life_loss") }
	if fv, found := get_any(v, "previous_phase"); found { if !dec_opt_Phase(fv, &out.previous_phase) do return fail("PhaseTransitionProgress.previous_phase") }
	if fv, found := get_any(v, "entering_cleanup"); found { if !decode_bool(fv, &out.entering_cleanup) do return fail("PhaseTransitionProgress.entering_cleanup") } else { return fail("PhaseTransitionProgress.entering_cleanup missing") }
	if fv, found := get_any(v, "drain_state"); found { if !decode_PhaseTransitionDrainState(fv, &out.drain_state) do return fail("PhaseTransitionProgress.drain_state") }
	if fv, found := get_any(v, "scheduled_begin"); found { if !dec_opt_ExtraPhase(fv, &out.scheduled_begin) do return fail("PhaseTransitionProgress.scheduled_begin") }
	return true
}

