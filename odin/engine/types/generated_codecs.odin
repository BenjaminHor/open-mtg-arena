decode_FaceDownProfile :: proc(v: json.Value, out: ^FaceDownProfile) -> bool {
	when COVERAGE do cov_hit("FaceDownProfile")
	if v.kind != .Object do return fail("FaceDownProfile: not an object")
	if fv, found := get_any(v, "power"); found { if !dec_opt_i32(fv, &out.power) do return fail("FaceDownProfile.power") }
	if fv, found := get_any(v, "toughness"); found { if !dec_opt_i32(fv, &out.toughness) do return fail("FaceDownProfile.toughness") }
	if fv, found := get_any(v, "body"); found { if !decode_FaceDownBody(fv, &out.body) do return fail("FaceDownProfile.body") }
	if fv, found := get_any(v, "extra_core_types"); found { if !dec_dyn_CoreType(fv, &out.extra_core_types) do return fail("FaceDownProfile.extra_core_types") }
	if fv, found := get_any(v, "subtypes"); found { if !dec_dyn_string(fv, &out.subtypes) do return fail("FaceDownProfile.subtypes") }
	if fv, found := get_any(v, "ward"); found { if !dec_opt_WardCost(fv, &out.ward) do return fail("FaceDownProfile.ward") }
	if fv, found := get_any(v, "cause"); found { if !decode_FaceDownCause(fv, &out.cause) do return fail("FaceDownProfile.cause") }
	return true
}

encode_FaceDownProfile :: proc(b: ^strings.Builder, x: FaceDownProfile) {
	strings.write_byte(b, '{')
	f := true
	encode_FaceDownProfile_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_FaceDownProfile_members :: proc(b: ^strings.Builder, x: FaceDownProfile, first: ^bool) {
	if !(x.power == nil) { member(b, first, "power"); enc_opt_i32(b, x.power) }
	if !(x.toughness == nil) { member(b, first, "toughness"); enc_opt_i32(b, x.toughness) }
	if !(skip_FaceDownProfile_is_creature_body_FaceDownBody(x.body)) { member(b, first, "body"); encode_FaceDownBody(b, x.body) }
	if !((len(x.extra_core_types) == 0)) { member(b, first, "extra_core_types"); enc_dyn_CoreType(b, x.extra_core_types) }
	if !((len(x.subtypes) == 0)) { member(b, first, "subtypes"); enc_dyn_string(b, x.subtypes) }
	if !(x.ward == nil) { member(b, first, "ward"); enc_opt_WardCost(b, x.ward) }
	member(b, first, "cause"); encode_FaceDownCause(b, x.cause)
}

