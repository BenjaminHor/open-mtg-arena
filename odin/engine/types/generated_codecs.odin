	if fv, found := get_any(v, "substitution"); found { if !decode_TextSubstitutionSpec(fv, &out.substitution) do return fail("ContinuousModification::SubstituteTextWord.substitution") } else { return fail("ContinuousModification::SubstituteTextWord.substitution missing") }
