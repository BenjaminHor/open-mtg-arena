	member(b, first, "record"); encode_CyclingRecord(b, y.record)
	member(b, first, "expected_history_len"); encode_int(b, y.expected_history_len)
	member(b, first, "stack_entry"); encode_ObjectId(b, y.stack_entry)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ResolvedLedgerEdit_SpellCast: strings.write_byte(b, '{'); json.write_string(b, "SpellCast"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "record"); encode_SpellCastRecord(b, y.record)
	member(b, first, "expected_turn_count"); encode_u8(b, y.expected_turn_count)
	member(b, first, "expected_game_count"); encode_u32(b, y.expected_game_count)
	member(b, first, "expected_turn_history_len"); encode_u32(b, y.expected_turn_history_len)
	member(b, first, "expected_game_history_len"); encode_u32(b, y.expected_game_history_len)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ResolvedLedgerEdit_AbilityActivated: strings.write_byte(b, '{'); json.write_string(b, "AbilityActivated"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "key"); encode_AbilityUsageKey(b, y.key)
	member(b, first, "expected_turn_count"); encode_u32(b, y.expected_turn_count)
	member(b, first, "expected_game_count"); encode_u32(b, y.expected_game_count)
	if !(y.record == nil) { member(b, first, "record"); enc_ptr_AbilityActivationRecord(b, y.record) }
	if !(y.expected_turn_history_len == nil) { member(b, first, "expected_turn_history_len"); enc_opt_u32(b, y.expected_turn_history_len) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ResolvedLedgerEdit_CrimeCommitted: strings.write_byte(b, '{'); json.write_string(b, "CrimeCommitted"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "expected_turn_count"); encode_u32(b, y.expected_turn_count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ResolvedLedgerEdit_TriggerFired: strings.write_byte(b, '{'); json.write_string(b, "TriggerFired"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
