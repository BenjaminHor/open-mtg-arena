decode_ResolvingTriggerContext :: proc(v: json.Value, out: ^ResolvingTriggerContext) -> bool {
	when COVERAGE do cov_hit("ResolvingTriggerContext")
	if v.kind != .Object do return fail("ResolvingTriggerContext: not an object")
	if fv, found := get_any(v, "event"); found { if !dec_opt_GameEvent(fv, &out.event) do return fail("ResolvingTriggerContext.event") }
	if fv, found := get_any(v, "events"); found { if !dec_dyn_GameEvent(fv, &out.events) do return fail("ResolvingTriggerContext.events") }
	if fv, found := get_any(v, "match_count"); found { if !dec_opt_u32(fv, &out.match_count) do return fail("ResolvingTriggerContext.match_count") }
	if fv, found := get_any(v, "die_result"); found { if !dec_opt_i32(fv, &out.die_result) do return fail("ResolvingTriggerContext.die_result") }
	return true
}

encode_ResolvingTriggerContext :: proc(b: ^strings.Builder, x: ResolvingTriggerContext) {
	strings.write_byte(b, '{')
	f := true
	encode_ResolvingTriggerContext_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ResolvingTriggerContext_members :: proc(b: ^strings.Builder, x: ResolvingTriggerContext, first: ^bool) {
	member(b, first, "event"); enc_opt_GameEvent(b, x.event)
	if !((len(x.events) == 0)) { member(b, first, "events"); enc_dyn_GameEvent(b, x.events) }
	member(b, first, "match_count"); enc_opt_u32(b, x.match_count)
	member(b, first, "die_result"); enc_opt_i32(b, x.die_result)
}

decode_ConniveSubject :: proc(v: json.Value, out: ^ConniveSubject) -> bool {
	when COVERAGE do cov_hit("ConniveSubject")
	if v.kind != .Object do return fail("ConniveSubject: not an object")
	if fv, found := get_any(v, "snapshot"); found { if !decode_EventObjectSnapshot(fv, &out.snapshot) do return fail("ConniveSubject.snapshot") } else { return fail("ConniveSubject.snapshot missing") }
	return true
}

encode_ConniveSubject :: proc(b: ^strings.Builder, x: ConniveSubject) {
	strings.write_byte(b, '{')
	f := true
	encode_ConniveSubject_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ConniveSubject_members :: proc(b: ^strings.Builder, x: ConniveSubject, first: ^bool) {
	member(b, first, "snapshot"); encode_EventObjectSnapshot(b, x.snapshot)
}

