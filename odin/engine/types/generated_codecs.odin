	if fv, found := get_any(v, "who"); found { if !decode_ProhibitionScope(fv, &out.who) do return fail("StaticMode::RestrictLibrarySearchToTop.who") } else { return fail("StaticMode::RestrictLibrarySearchToTop.who missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("StaticMode::RestrictLibrarySearchToTop.count") } else { return fail("StaticMode::RestrictLibrarySearchToTop.count missing") }
