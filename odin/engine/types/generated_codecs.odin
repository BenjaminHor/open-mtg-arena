	if fv, found := get_any(v, "sources"); found { if !decode_TargetFilter(fv, &out.sources) do return fail("Effect::EachDealsDamageEqualToPower.sources") } else { return fail("Effect::EachDealsDamageEqualToPower.sources missing") }
	if fv, found := get_any(v, "recipient"); found { if !decode_TargetFilter(fv, &out.recipient) do return fail("Effect::EachDealsDamageEqualToPower.recipient") } else { return fail("Effect::EachDealsDamageEqualToPower.recipient missing") }
	if fv, found := get_any(v, "extra_source"); found { if !dec_opt_TargetFilter(fv, &out.extra_source) do return fail("Effect::EachDealsDamageEqualToPower.extra_source") }
	return true
