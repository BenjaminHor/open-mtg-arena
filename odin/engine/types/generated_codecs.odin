decode_ManaCost :: proc(v: json.Value, out: ^ManaCost) -> bool {
	if v.kind != .Object do return fail("ManaCost: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ManaCost: no tag")
	switch tv.text {
	case "NoCost": out^ = ManaCost_NoCost{}
	case "Cost":
		tmp: ManaCost_Cost
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ManaCost_Cost) -> bool {
	if fv, found := get_any(v, "shards"); found { if !dec_dyn_ManaCostShard(fv, &out.shards) do return fail("ManaCost::Cost.shards") } else { return fail("ManaCost::Cost.shards missing") }
	if fv, found := get_any(v, "generic"); found { if !decode_u32(fv, &out.generic) do return fail("ManaCost::Cost.generic") } else { return fail("ManaCost::Cost.generic missing") }
	return true
		}) { return fail("ManaCost::Cost") }
		out^ = tmp
	case "SelfManaCost": out^ = ManaCost_SelfManaCost{}
	case "SelfManaValue": out^ = ManaCost_SelfManaValue{}
	case "SelfManaCostReduced":
		tmp: ManaCost_SelfManaCostReduced
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ManaCost_SelfManaCostReduced) -> bool {
	if fv, found := get_any(v, "reduction"); found { if !decode_u32(fv, &out.reduction) do return fail("ManaCost::SelfManaCostReduced.reduction") } else { return fail("ManaCost::SelfManaCostReduced.reduction missing") }
	return true
		}) { return fail("ManaCost::SelfManaCostReduced") }
		out^ = tmp
	case: return fail("ManaCost: unknown variant")
	}
	return true
}

encode_ManaCost :: proc(b: ^strings.Builder, x: ManaCost) {
	#partial switch y in x {
	case ManaCost_NoCost: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NoCost"); strings.write_byte(b, '}')
	case ManaCost_Cost: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Cost")
	member(b, first, "shards"); enc_dyn_ManaCostShard(b, y.shards)
	member(b, first, "generic"); encode_u32(b, y.generic)
	}; strings.write_byte(b, '}')
	case ManaCost_SelfManaCost: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SelfManaCost"); strings.write_byte(b, '}')
	case ManaCost_SelfManaValue: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SelfManaValue"); strings.write_byte(b, '}')
	case ManaCost_SelfManaCostReduced: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SelfManaCostReduced")
	member(b, first, "reduction"); encode_u32(b, y.reduction)
	}; strings.write_byte(b, '}')
	}
}

encode_ManaCost_members :: proc(b: ^strings.Builder, x: ManaCost, first: ^bool) {
	#partial switch y in x {
	case ManaCost_NoCost: _ = y; member(b, first, "type"); json.write_string(b, "NoCost")
	case ManaCost_Cost: member(b, first, "type"); json.write_string(b, "Cost")
	member(b, first, "shards"); enc_dyn_ManaCostShard(b, y.shards)
	member(b, first, "generic"); encode_u32(b, y.generic)

	case ManaCost_SelfManaCost: _ = y; member(b, first, "type"); json.write_string(b, "SelfManaCost")
	case ManaCost_SelfManaValue: _ = y; member(b, first, "type"); json.write_string(b, "SelfManaValue")
	case ManaCost_SelfManaCostReduced: member(b, first, "type"); json.write_string(b, "SelfManaCostReduced")
	member(b, first, "reduction"); encode_u32(b, y.reduction)

	}
}

decode_CardType :: proc(v: json.Value, out: ^CardType) -> bool {
