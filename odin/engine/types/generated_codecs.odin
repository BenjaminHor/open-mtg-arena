}

decode_PerpetualModification :: proc(v: json.Value, out: ^PerpetualModification) -> bool {
	when COVERAGE do cov_hit("PerpetualModification")
	if v.kind != .Object do return fail("PerpetualModification: not an object")
	tv, found := json.get(v, "kind")
	if !found || tv.kind != .String do return fail("PerpetualModification: no tag")
	switch tv.text {
	case "SetBasePowerToughness": when COVERAGE do cov_hit("PerpetualModification::SetBasePowerToughness");
		tmp: PerpetualModification_SetBasePowerToughness
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PerpetualModification_SetBasePowerToughness) -> bool {
	if fv, found := get_any(v, "power"); found { if !decode_i32(fv, &out.power) do return fail("PerpetualModification::SetBasePowerToughness.power") } else { return fail("PerpetualModification::SetBasePowerToughness.power missing") }
	if fv, found := get_any(v, "toughness"); found { if !decode_i32(fv, &out.toughness) do return fail("PerpetualModification::SetBasePowerToughness.toughness") } else { return fail("PerpetualModification::SetBasePowerToughness.toughness missing") }
	return true
		}) { return fail("PerpetualModification::SetBasePowerToughness") }
		out^ = tmp
	case "ModifyPowerToughness": when COVERAGE do cov_hit("PerpetualModification::ModifyPowerToughness");
		tmp: PerpetualModification_ModifyPowerToughness
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PerpetualModification_ModifyPowerToughness) -> bool {
	if fv, found := get_any(v, "power", "power_delta"); found { if !decode_QuantityExpr(fv, &out.power) do return fail("PerpetualModification::ModifyPowerToughness.power") } else { return fail("PerpetualModification::ModifyPowerToughness.power missing") }
	if fv, found := get_any(v, "toughness", "toughness_delta"); found { if !decode_QuantityExpr(fv, &out.toughness) do return fail("PerpetualModification::ModifyPowerToughness.toughness") } else { return fail("PerpetualModification::ModifyPowerToughness.toughness missing") }
	if fv, found := get_any(v, "keywords"); found { if !dec_dyn_Keyword(fv, &out.keywords) do return fail("PerpetualModification::ModifyPowerToughness.keywords") }
	return true
		}) { return fail("PerpetualModification::ModifyPowerToughness") }
		out^ = tmp
	case "GrantKeywords": when COVERAGE do cov_hit("PerpetualModification::GrantKeywords");
		tmp: PerpetualModification_GrantKeywords
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PerpetualModification_GrantKeywords) -> bool {
	if fv, found := get_any(v, "keywords"); found { if !dec_dyn_Keyword(fv, &out.keywords) do return fail("PerpetualModification::GrantKeywords.keywords") } else { return fail("PerpetualModification::GrantKeywords.keywords missing") }
	return true
		}) { return fail("PerpetualModification::GrantKeywords") }
		out^ = tmp
	case "Become": when COVERAGE do cov_hit("PerpetualModification::Become");
		tmp: PerpetualModification_Become
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PerpetualModification_Become) -> bool {
	if fv, found := get_any(v, "creature_subtypes"); found { if !dec_dyn_string(fv, &out.creature_subtypes) do return fail("PerpetualModification::Become.creature_subtypes") } else { return fail("PerpetualModification::Become.creature_subtypes missing") }
	if fv, found := get_any(v, "power"); found { if !decode_i32(fv, &out.power) do return fail("PerpetualModification::Become.power") } else { return fail("PerpetualModification::Become.power missing") }
	if fv, found := get_any(v, "toughness"); found { if !decode_i32(fv, &out.toughness) do return fail("PerpetualModification::Become.toughness") } else { return fail("PerpetualModification::Become.toughness missing") }
	if fv, found := get_any(v, "keywords"); found { if !dec_dyn_Keyword(fv, &out.keywords) do return fail("PerpetualModification::Become.keywords") }
	return true
		}) { return fail("PerpetualModification::Become") }
		out^ = tmp
	case "ModifyCost": when COVERAGE do cov_hit("PerpetualModification::ModifyCost");
		tmp: PerpetualModification_ModifyCost
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PerpetualModification_ModifyCost) -> bool {
	if fv, found := get_any(v, "mode"); found { if !decode_CostModifyMode(fv, &out.mode) do return fail("PerpetualModification::ModifyCost.mode") } else { return fail("PerpetualModification::ModifyCost.mode missing") }
	if fv, found := get_any(v, "amount"); found { if !decode_ManaCost(fv, &out.amount) do return fail("PerpetualModification::ModifyCost.amount") } else { return fail("PerpetualModification::ModifyCost.amount missing") }
	return true
		}) { return fail("PerpetualModification::ModifyCost") }
		out^ = tmp
	case "GrantAbility": when COVERAGE do cov_hit("PerpetualModification::GrantAbility");
		tmp: PerpetualModification_GrantAbility
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PerpetualModification_GrantAbility) -> bool {
	if fv, found := get_any(v, "modifications"); found { if !dec_dyn_PerpetualGrantModification(fv, &out.modifications) do return fail("PerpetualModification::GrantAbility.modifications") } else { return fail("PerpetualModification::GrantAbility.modifications missing") }
	return true
		}) { return fail("PerpetualModification::GrantAbility") }
		out^ = tmp
	case: return fail("PerpetualModification: unknown variant")
	}
	return true
}

encode_PerpetualModification :: proc(b: ^strings.Builder, x: PerpetualModification) {
	#partial switch y in x {
	case PerpetualModification_SetBasePowerToughness: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "SetBasePowerToughness")
	member(b, first, "power"); encode_i32(b, y.power)
	member(b, first, "toughness"); encode_i32(b, y.toughness)
	}; strings.write_byte(b, '}')
	case PerpetualModification_ModifyPowerToughness: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "ModifyPowerToughness")
	member(b, first, "power"); encode_QuantityExpr(b, y.power)
	member(b, first, "toughness"); encode_QuantityExpr(b, y.toughness)
	if !((len(y.keywords) == 0)) { member(b, first, "keywords"); enc_dyn_Keyword(b, y.keywords) }
	}; strings.write_byte(b, '}')
	case PerpetualModification_GrantKeywords: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "GrantKeywords")
	member(b, first, "keywords"); enc_dyn_Keyword(b, y.keywords)
	}; strings.write_byte(b, '}')
	case PerpetualModification_Become: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "Become")
	member(b, first, "creature_subtypes"); enc_dyn_string(b, y.creature_subtypes)
	member(b, first, "power"); encode_i32(b, y.power)
	member(b, first, "toughness"); encode_i32(b, y.toughness)
	if !((len(y.keywords) == 0)) { member(b, first, "keywords"); enc_dyn_Keyword(b, y.keywords) }
	}; strings.write_byte(b, '}')
	case PerpetualModification_ModifyCost: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "ModifyCost")
	member(b, first, "mode"); encode_CostModifyMode(b, y.mode)
	member(b, first, "amount"); encode_ManaCost(b, y.amount)
	}; strings.write_byte(b, '}')
	case PerpetualModification_GrantAbility: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "GrantAbility")
	member(b, first, "modifications"); enc_dyn_PerpetualGrantModification(b, y.modifications)
	}; strings.write_byte(b, '}')
	}
}

encode_PerpetualModification_members :: proc(b: ^strings.Builder, x: PerpetualModification, first: ^bool) {
	#partial switch y in x {
	case PerpetualModification_SetBasePowerToughness: member(b, first, "kind"); json.write_string(b, "SetBasePowerToughness")
	member(b, first, "power"); encode_i32(b, y.power)
	member(b, first, "toughness"); encode_i32(b, y.toughness)

	case PerpetualModification_ModifyPowerToughness: member(b, first, "kind"); json.write_string(b, "ModifyPowerToughness")
	member(b, first, "power"); encode_QuantityExpr(b, y.power)
	member(b, first, "toughness"); encode_QuantityExpr(b, y.toughness)
	if !((len(y.keywords) == 0)) { member(b, first, "keywords"); enc_dyn_Keyword(b, y.keywords) }

	case PerpetualModification_GrantKeywords: member(b, first, "kind"); json.write_string(b, "GrantKeywords")
	member(b, first, "keywords"); enc_dyn_Keyword(b, y.keywords)

	case PerpetualModification_Become: member(b, first, "kind"); json.write_string(b, "Become")
	member(b, first, "creature_subtypes"); enc_dyn_string(b, y.creature_subtypes)
	member(b, first, "power"); encode_i32(b, y.power)
	member(b, first, "toughness"); encode_i32(b, y.toughness)
	if !((len(y.keywords) == 0)) { member(b, first, "keywords"); enc_dyn_Keyword(b, y.keywords) }

	case PerpetualModification_ModifyCost: member(b, first, "kind"); json.write_string(b, "ModifyCost")
	member(b, first, "mode"); encode_CostModifyMode(b, y.mode)
	member(b, first, "amount"); encode_ManaCost(b, y.amount)

	case PerpetualModification_GrantAbility: member(b, first, "kind"); json.write_string(b, "GrantAbility")
	member(b, first, "modifications"); enc_dyn_PerpetualGrantModification(b, y.modifications)

	}
}

decode_PrintedLoyalty :: proc(v: json.Value, out: ^PrintedLoyalty) -> bool {
	when COVERAGE do cov_hit("PrintedLoyalty")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("PrintedLoyalty: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("PrintedLoyalty: not a string or object")
	}
	switch variant {
	case "Fixed": when COVERAGE do cov_hit("PrintedLoyalty::Fixed"); tmp: PrintedLoyalty_Fixed; if !decode_u32(body, &tmp._0) do return fail("PrintedLoyalty::Fixed"); out^ = tmp
	case "X": when COVERAGE do cov_hit("PrintedLoyalty::X"); out^ = PrintedLoyalty_X{}
	case: return fail("PrintedLoyalty: unknown variant")
	}
	return true
}

encode_PrintedLoyalty :: proc(b: ^strings.Builder, x: PrintedLoyalty) {
	#partial switch y in x {
	case PrintedLoyalty_Fixed: strings.write_byte(b, '{'); json.write_string(b, "Fixed"); strings.write_byte(b, ':'); encode_u32(b, y._0); strings.write_byte(b, '}')
	case PrintedLoyalty_X: _ = y; json.write_string(b, "X")
	}
}

decode_TriggerEntry :: proc(v: json.Value, out: ^TriggerEntry) -> bool {
	when COVERAGE do cov_hit("TriggerEntry")
	if v.kind != .Object do return fail("TriggerEntry: not an object")
	if fv, found := get_any(v, "occurrence"); found { if !decode_TriggerDefinitionOccurrenceRef(fv, &out.occurrence) do return fail("TriggerEntry.occurrence") } else { return fail("TriggerEntry.occurrence missing") }
	if fv, found := get_any(v, "definition"); found { if !decode_TriggerDefinition(fv, &out.definition) do return fail("TriggerEntry.definition") } else { return fail("TriggerEntry.definition missing") }
	return true
}

encode_TriggerEntry :: proc(b: ^strings.Builder, x: TriggerEntry) {
	strings.write_byte(b, '{')
	f := true
	encode_TriggerEntry_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_TriggerEntry_members :: proc(b: ^strings.Builder, x: TriggerEntry, first: ^bool) {
	member(b, first, "occurrence"); encode_TriggerDefinitionOccurrenceRef(b, x.occurrence)
	member(b, first, "definition"); encode_TriggerDefinition(b, x.definition)
}

