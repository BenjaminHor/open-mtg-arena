	if !(skip_Effect_is_target_filter_controller_TargetFilter(y.player)) { member(b, first, "player"); encode_TargetFilter(b, y.player) }
	}; strings.write_byte(b, '}')
	case Effect_Seek: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Seek")
