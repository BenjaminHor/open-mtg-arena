	case PendingBatchZoneChangeCause_Cost: member(b, first, "type"); json.write_string(b, "cost")
	member(b, first, "source"); encode_ObjectId(b, y.source)

	case PendingBatchZoneChangeCause_SpellResolutionDefault: _ = y; member(b, first, "type"); json.write_string(b, "spell_resolution_default")
	case PendingBatchZoneChangeCause_StateBasedAction: _ = y; member(b, first, "type"); json.write_string(b, "state_based_action")
	case PendingBatchZoneChangeCause_CommanderRuleReturn: _ = y; member(b, first, "type"); json.write_string(b, "commander_rule_return")
	case PendingBatchZoneChangeCause_Draw: member(b, first, "type"); json.write_string(b, "draw")
	if !((len(y.seed_applied) == 0)) { member(b, first, "seed_applied"); enc_dyn_AppliedReplacementKey(b, y.seed_applied) }

	case PendingBatchZoneChangeCause_CastingToStack: member(b, first, "type"); json.write_string(b, "casting_to_stack")
	member(b, first, "source"); encode_ObjectId(b, y.source)

	case PendingBatchZoneChangeCause_PregameProcedure: _ = y; member(b, first, "type"); json.write_string(b, "pregame_procedure")
	case PendingBatchZoneChangeCause_PlayerLeftGame: _ = y; member(b, first, "type"); json.write_string(b, "player_left_game")
	case PendingBatchZoneChangeCause_MergedComponentRouting: _ = y; member(b, first, "type"); json.write_string(b, "merged_component_routing")
	case PendingBatchZoneChangeCause_DebugCommand: _ = y; member(b, first, "type"); json.write_string(b, "debug_command")
	}
}

decode_BatchDeliveryStage :: proc(v: json.Value, out: ^BatchDeliveryStage) -> bool {
	when COVERAGE do cov_hit("BatchDeliveryStage")
	if v.kind != .String do return fail("BatchDeliveryStage: not a string")
	str := v.text
	switch str {
	case "Approving": when COVERAGE do cov_hit("BatchDeliveryStage::Approving"); out^ = .Approving
	case "Arranging": when COVERAGE do cov_hit("BatchDeliveryStage::Arranging"); out^ = .Arranging
	case "Delivering": when COVERAGE do cov_hit("BatchDeliveryStage::Delivering"); out^ = .Delivering
	case: return fail("BatchDeliveryStage: unknown variant")
	}
	return true
}

encode_BatchDeliveryStage :: proc(b: ^strings.Builder, x: BatchDeliveryStage) {
	@(static, rodata) NAMES := [BatchDeliveryStage]string{
		.Approving = "Approving",
		.Arranging = "Arranging",
		.Delivering = "Delivering",
	}
	json.write_string(b, NAMES[x])
}

decode_StagedBatchMember :: proc(v: json.Value, out: ^StagedBatchMember) -> bool {
	when COVERAGE do cov_hit("StagedBatchMember")
	if v.kind != .Object do return fail("StagedBatchMember: not an object")
	if fv, found := get_any(v, "announcement_index"); found { if !decode_u32(fv, &out.announcement_index) do return fail("StagedBatchMember.announcement_index") } else { return fail("StagedBatchMember.announcement_index missing") }
	if fv, found := get_any(v, "request"); found { if !decode_PendingBatchZoneMoveRequest(fv, &out.request) do return fail("StagedBatchMember.request") } else { return fail("StagedBatchMember.request missing") }
	if fv, found := get_any(v, "identity"); found { if !decode_ObjectIncarnationRef(fv, &out.identity) do return fail("StagedBatchMember.identity") } else { return fail("StagedBatchMember.identity missing") }
	if fv, found := get_any(v, "expected_origin"); found { if !dec_opt_Zone(fv, &out.expected_origin) do return fail("StagedBatchMember.expected_origin") }
	if fv, found := get_any(v, "merged_departure"); found { if !dec_opt_ObjectIncarnationRef(fv, &out.merged_departure) do return fail("StagedBatchMember.merged_departure") }
	if fv, found := get_any(v, "owner"); found { if !decode_PlayerId(fv, &out.owner) do return fail("StagedBatchMember.owner") } else { return fail("StagedBatchMember.owner missing") }
	if fv, found := get_any(v, "state"); found { if !decode_StagedBatchMemberState(fv, &out.state) do return fail("StagedBatchMember.state") } else { return fail("StagedBatchMember.state missing") }
	if fv, found := get_any(v, "approved_event"); found { if !dec_opt_ProposedEvent(fv, &out.approved_event) do return fail("StagedBatchMember.approved_event") }
	if fv, found := get_any(v, "pending_outcome"); found { if !dec_opt_StagedMemberOutcome(fv, &out.pending_outcome) do return fail("StagedBatchMember.pending_outcome") }
	if fv, found := get_any(v, "terminal"); found { if !dec_opt_ZoneMoveCompletion(fv, &out.terminal) do return fail("StagedBatchMember.terminal") }
	if fv, found := get_any(v, "operation"); found { if !decode_StagedMemberOperation(fv, &out.operation) do return fail("StagedBatchMember.operation") } else { out.operation = StagedMemberOperation(StagedMemberOperation_ZoneMove{}) }
	if fv, found := get_any(v, "approved_post_replacement"); found { if !dec_opt_PostReplacementDrainStack(fv, &out.approved_post_replacement) do return fail("StagedBatchMember.approved_post_replacement") }
	if fv, found := get_any(v, "held_decision"); found { if !dec_ptr_HeldReplacementDecision(fv, &out.held_decision) do return fail("StagedBatchMember.held_decision") }
	if fv, found := get_any(v, "blocked"); found { if !decode_bool(fv, &out.blocked) do return fail("StagedBatchMember.blocked") }
	return true
}

encode_StagedBatchMember :: proc(b: ^strings.Builder, x: StagedBatchMember) {
	strings.write_byte(b, '{')
	f := true
	encode_StagedBatchMember_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_StagedBatchMember_members :: proc(b: ^strings.Builder, x: StagedBatchMember, first: ^bool) {
	member(b, first, "announcement_index"); encode_u32(b, x.announcement_index)
	member(b, first, "request"); encode_PendingBatchZoneMoveRequest(b, x.request)
	member(b, first, "identity"); encode_ObjectIncarnationRef(b, x.identity)
	if !(x.expected_origin == nil) { member(b, first, "expected_origin"); enc_opt_Zone(b, x.expected_origin) }
	if !(x.merged_departure == nil) { member(b, first, "merged_departure"); enc_opt_ObjectIncarnationRef(b, x.merged_departure) }
	member(b, first, "owner"); encode_PlayerId(b, x.owner)
	member(b, first, "state"); encode_StagedBatchMemberState(b, x.state)
	if !(x.approved_event == nil) { member(b, first, "approved_event"); enc_opt_ProposedEvent(b, x.approved_event) }
	if !(x.pending_outcome == nil) { member(b, first, "pending_outcome"); enc_opt_StagedMemberOutcome(b, x.pending_outcome) }
	if !(x.terminal == nil) { member(b, first, "terminal"); enc_opt_ZoneMoveCompletion(b, x.terminal) }
	member(b, first, "operation"); encode_StagedMemberOperation(b, x.operation)
	if !(x.approved_post_replacement == nil) { member(b, first, "approved_post_replacement"); enc_opt_PostReplacementDrainStack(b, x.approved_post_replacement) }
	if !(x.held_decision == nil) { member(b, first, "held_decision"); enc_ptr_HeldReplacementDecision(b, x.held_decision) }
	if !(!x.blocked) { member(b, first, "blocked"); encode_bool(b, x.blocked) }
}

decode_PendingEffectResolutionEvent :: proc(v: json.Value, out: ^PendingEffectResolutionEvent) -> bool {
	when COVERAGE do cov_hit("PendingEffectResolutionEvent")
	if v.kind != .String do return fail("PendingEffectResolutionEvent: not a string")
	str := v.text
	switch str {
	case "Emit": when COVERAGE do cov_hit("PendingEffectResolutionEvent::Emit"); out^ = .Emit
	case "Suppress": when COVERAGE do cov_hit("PendingEffectResolutionEvent::Suppress"); out^ = .Suppress
	case: return fail("PendingEffectResolutionEvent: unknown variant")
	}
	return true
}

encode_PendingEffectResolutionEvent :: proc(b: ^strings.Builder, x: PendingEffectResolutionEvent) {
	@(static, rodata) NAMES := [PendingEffectResolutionEvent]string{
		.Emit = "Emit",
		.Suppress = "Suppress",
	}
	json.write_string(b, NAMES[x])
}

decode_PendingCounterPostAction :: proc(v: json.Value, out: ^PendingCounterPostAction) -> bool {
	when COVERAGE do cov_hit("PendingCounterPostAction")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("PendingCounterPostAction: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("PendingCounterPostAction: not a string or object")
	}
	switch variant {
	case "EmitEffectResolved": when COVERAGE do cov_hit("PendingCounterPostAction::EmitEffectResolved");
		tmp: PendingCounterPostAction_EmitEffectResolved
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^PendingCounterPostAction_EmitEffectResolved) -> bool {
	if fv, found := get_any(v, "kind"); found { if !decode_EffectKind(fv, &out.kind) do return fail("PendingCounterPostAction::EmitEffectResolved.kind") } else { return fail("PendingCounterPostAction::EmitEffectResolved.kind missing") }
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("PendingCounterPostAction::EmitEffectResolved.source_id") } else { return fail("PendingCounterPostAction::EmitEffectResolved.source_id missing") }
	return true
		}) { return fail("PendingCounterPostAction::EmitEffectResolved") }
		out^ = tmp
	case "RecordPlayerAction": when COVERAGE do cov_hit("PendingCounterPostAction::RecordPlayerAction");
		tmp: PendingCounterPostAction_RecordPlayerAction
