	if fv, found := get_any(v, "layer_base_toughness"); found { if !dec_opt_i32(fv, &out.layer_base_toughness) do return fail("GameObject.layer_base_toughness") }
	if fv, found := get_any(v, "loyalty"); found { if !dec_opt_u32(fv, &out.loyalty) do return fail("GameObject.loyalty") }
	if fv, found := get_any(v, "printed_loyalty"); found { if !dec_opt_PrintedLoyalty(fv, &out.printed_loyalty) do return fail("GameObject.printed_loyalty") }
	if fv, found := get_any(v, "defense"); found { if !dec_opt_u32(fv, &out.defense) do return fail("GameObject.defense") }
	if fv, found := get_any(v, "token_rules_text"); found { if !dec_opt_string(fv, &out.token_rules_text) do return fail("GameObject.token_rules_text") }
	if fv, found := get_any(v, "card_types"); found { if !decode_CardType(fv, &out.card_types) do return fail("GameObject.card_types") } else { return fail("GameObject.card_types missing") }
	if fv, found := get_any(v, "attraction_lights"); found { if !dec_dyn_u8(fv, &out.attraction_lights) do return fail("GameObject.attraction_lights") }
