	member(b, first, "recipient"); encode_TargetFilter(b, y.recipient)
	member(b, first, "count_source"); encode_TargetFilter(b, y.count_source)
	}; strings.write_byte(b, '}')
	}
}

encode_ManaTargetRole_members :: proc(b: ^strings.Builder, x: ManaTargetRole, first: ^bool) {
