enc_dyn_Player :: proc(b: ^strings.Builder, x: [dynamic]Player) {
	strings.write_byte(b, '[')
	for item, i in x {
		if i > 0 do strings.write_byte(b, ',')
		encode_Player(b, item)
	}
	strings.write_byte(b, ']')
}

enc_opt_PlayerId :: proc(b: ^strings.Builder, x: Maybe(PlayerId)) {
	if y, ok := x.?; ok do encode_PlayerId(b, y)
	else do strings.write_string(b, "null")
}

enc_opt_u64 :: proc(b: ^strings.Builder, x: Maybe(u64)) {
	if y, ok := x.?; ok do encode_u64(b, y)
	else do strings.write_string(b, "null")
}

enc_opt_ActivePlayerControl :: proc(b: ^strings.Builder, x: Maybe(ActivePlayerControl)) {
	if y, ok := x.?; ok do encode_ActivePlayerControl(b, y)
	else do strings.write_string(b, "null")
}

enc_PVec_ObjectId :: proc(b: ^strings.Builder, x: PVec(ObjectId)) {
	strings.write_byte(b, '[')
	for i in 0 ..< x.len {
		if i > 0 do strings.write_byte(b, ',')
		encode_ObjectId(b, pvec_get(x, i))
	}
	strings.write_byte(b, ']')
}

enc_PVec_StackEntry :: proc(b: ^strings.Builder, x: PVec(StackEntry)) {
	strings.write_byte(b, '[')
	for i in 0 ..< x.len {
		if i > 0 do strings.write_byte(b, ',')
		encode_StackEntry(b, pvec_get(x, i))
	}
	strings.write_byte(b, ']')
}

enc_map_ObjectId_StackPaidSnapshot :: proc(b: ^strings.Builder, x: map[ObjectId]StackPaidSnapshot) {
	strings.write_byte(b, '{')
	first := true
	for k, val in x {
		if !first do strings.write_byte(b, ',')
		first = false
		strings.write_byte(b, '"'); encode_ObjectId(b, k); strings.write_byte(b, '"')
		strings.write_byte(b, ':')
		encode_StackPaidSnapshot(b, val)
	}
	strings.write_byte(b, '}')
}

enc_opt_CombatState :: proc(b: ^strings.Builder, x: Maybe(CombatState)) {
