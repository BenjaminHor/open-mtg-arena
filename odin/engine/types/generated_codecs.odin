	case ActivationTargetFact_Object: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Object"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "id"); encode_ObjectId(b, y.id)
