	case DebugAction_RemoveKeyword: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RemoveKeyword"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_SetLife: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SetLife"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "life"); encode_i32(b, y.life)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_GainLife: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "GainLife"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "amount"); encode_u32(b, y.amount)
