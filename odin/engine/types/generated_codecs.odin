	case ContinuousModification_RemoveChosenKeyword: _ = y; member(b, first, "type"); json.write_string(b, "RemoveChosenKeyword")
	case ContinuousModification_AddChosenKeyword: _ = y; member(b, first, "type"); json.write_string(b, "AddChosenKeyword")
	case ContinuousModification_SetColor: member(b, first, "type"); json.write_string(b, "SetColor")
	member(b, first, "colors"); enc_dyn_ManaColor(b, y.colors)

	case ContinuousModification_AddColor: member(b, first, "type"); json.write_string(b, "AddColor")
