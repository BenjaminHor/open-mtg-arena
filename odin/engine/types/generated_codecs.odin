decode_CopyTargetSlot :: proc(v: json.Value, out: ^CopyTargetSlot) -> bool {
	when COVERAGE do cov_hit("CopyTargetSlot")
	if v.kind != .Object do return fail("CopyTargetSlot: not an object")
	if fv, found := get_any(v, "current"); found { if !dec_opt_TargetRef(fv, &out.current) do return fail("CopyTargetSlot.current") }
	if fv, found := get_any(v, "legal_alternatives"); found { if !dec_dyn_TargetRef(fv, &out.legal_alternatives) do return fail("CopyTargetSlot.legal_alternatives") } else { return fail("CopyTargetSlot.legal_alternatives missing") }
	if fv, found := get_any(v, "address"); found { if !dec_opt_RetargetSlotAddress(fv, &out.address) do return fail("CopyTargetSlot.address") }
	if fv, found := get_any(v, "can_keep"); found { if !decode_bool(fv, &out.can_keep) do return fail("CopyTargetSlot.can_keep") }
	if fv, found := get_any(v, "can_decline"); found { if !decode_bool(fv, &out.can_decline) do return fail("CopyTargetSlot.can_decline") }
	return true
}

encode_CopyTargetSlot :: proc(b: ^strings.Builder, x: CopyTargetSlot) {
	strings.write_byte(b, '{')
	f := true
	encode_CopyTargetSlot_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CopyTargetSlot_members :: proc(b: ^strings.Builder, x: CopyTargetSlot, first: ^bool) {
	if !(x.current == nil) { member(b, first, "current"); enc_opt_TargetRef(b, x.current) }
	member(b, first, "legal_alternatives"); enc_dyn_TargetRef(b, x.legal_alternatives)
	if !(x.address == nil) { member(b, first, "address"); enc_opt_RetargetSlotAddress(b, x.address) }
	member(b, first, "can_keep"); encode_bool(b, x.can_keep)
	if !(!x.can_decline) { member(b, first, "can_decline"); encode_bool(b, x.can_decline) }
}

decode_CopyChoiceMode :: proc(v: json.Value, out: ^CopyChoiceMode) -> bool {
	when COVERAGE do cov_hit("CopyChoiceMode")
	if v.kind != .String do return fail("CopyChoiceMode: not a string")
	str := v.text
	switch str {
	case "Retarget": when COVERAGE do cov_hit("CopyChoiceMode::Retarget"); out^ = .Retarget
	case "Announce": when COVERAGE do cov_hit("CopyChoiceMode::Announce"); out^ = .Announce
	case: return fail("CopyChoiceMode: unknown variant")
	}
	return true
}

encode_CopyChoiceMode :: proc(b: ^strings.Builder, x: CopyChoiceMode) {
	@(static, rodata) NAMES := [CopyChoiceMode]string{
		.Retarget = "Retarget",
		.Announce = "Announce",
	}
	json.write_string(b, NAMES[x])
}

