	case GameEvent_PhysicalContestResolved: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PhysicalContestResolved"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "kind"); encode_ContestKind(b, y.kind)
	member(b, first, "participants"); enc__2_PlayerId(b, y.participants)
	member(b, first, "result"); encode_ContestResult(b, y.result)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_Clash: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Clash"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	member(b, first, "opponent"); encode_PlayerId(b, y.opponent)
	member(b, first, "controller_mana_value"); enc_opt_u32(b, y.controller_mana_value)
	member(b, first, "opponent_mana_value"); enc_opt_u32(b, y.opponent_mana_value)
	member(b, first, "result"); encode_ClashResult(b, y.result)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_VoteCast: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "VoteCast"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "voter"); encode_PlayerId(b, y.voter)
	member(b, first, "choice"); encode_string(b, y.choice)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_VoteResolved: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "VoteResolved"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "tallies"); enc_dyn_t2_string_u32(b, y.tallies)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_PowerToughnessChanged: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PowerToughnessChanged"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "power"); encode_i32(b, y.power)
	member(b, first, "toughness"); encode_i32(b, y.toughness)
	member(b, first, "power_delta"); encode_i32(b, y.power_delta)
	member(b, first, "toughness_delta"); encode_i32(b, y.toughness_delta)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_CascadeMissed: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CascadeMissed"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "exiled_count"); encode_u32(b, y.exiled_count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_DebugActionUsed: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DebugActionUsed"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "description"); encode_string(b, y.description)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_DebugPermissionGranted: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DebugPermissionGranted"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "host"); encode_PlayerId(b, y.host)
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_DebugPermissionRevoked: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DebugPermissionRevoked"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "host"); encode_PlayerId(b, y.host)
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_ReplayLog :: proc(v: json.Value, out: ^ReplayLog) -> bool {
	when COVERAGE do cov_hit("ReplayLog")
	if v.kind != .Object do return fail("ReplayLog: not an object")
	if fv, found := get_any(v, "format_version"); found { if !dec_opt_u32(fv, &out.format_version) do return fail("ReplayLog.format_version") }
	if fv, found := get_any(v, "header"); found { if !decode_ReplayHeader(fv, &out.header) do return fail("ReplayLog.header") } else { return fail("ReplayLog.header missing") }
	if fv, found := get_any(v, "actions"); found { if !dec_dyn_RecordedAction(fv, &out.actions) do return fail("ReplayLog.actions") } else { return fail("ReplayLog.actions missing") }
	if fv, found := get_any(v, "resolve_all_boundaries"); found { if !dec_dyn_RecordedResolveAll(fv, &out.resolve_all_boundaries) do return fail("ReplayLog.resolve_all_boundaries") }
	return true
}

encode_ReplayLog :: proc(b: ^strings.Builder, x: ReplayLog) {
	strings.write_byte(b, '{')
	f := true
	encode_ReplayLog_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ReplayLog_members :: proc(b: ^strings.Builder, x: ReplayLog, first: ^bool) {
	member(b, first, "format_version"); enc_opt_u32(b, x.format_version)
	member(b, first, "header"); encode_ReplayHeader(b, x.header)
	member(b, first, "actions"); enc_dyn_RecordedAction(b, x.actions)
	if !((len(x.resolve_all_boundaries) == 0)) { member(b, first, "resolve_all_boundaries"); enc_dyn_RecordedResolveAll(b, x.resolve_all_boundaries) }
}

decode_CardFace :: proc(v: json.Value, out: ^CardFace) -> bool {
	when COVERAGE do cov_hit("CardFace")
	if v.kind != .Object do return fail("CardFace: not an object")
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("CardFace.name") } else { return fail("CardFace.name missing") }
	if fv, found := get_any(v, "mana_cost"); found { if !decode_ManaCost(fv, &out.mana_cost) do return fail("CardFace.mana_cost") } else { return fail("CardFace.mana_cost missing") }
	if fv, found := get_any(v, "card_type"); found { if !decode_CardType(fv, &out.card_type) do return fail("CardFace.card_type") } else { return fail("CardFace.card_type missing") }
	if fv, found := get_any(v, "power"); found { if !dec_opt_PtValue(fv, &out.power) do return fail("CardFace.power") }
	if fv, found := get_any(v, "toughness"); found { if !dec_opt_PtValue(fv, &out.toughness) do return fail("CardFace.toughness") }
	if fv, found := get_any(v, "loyalty"); found { if !dec_opt_string(fv, &out.loyalty) do return fail("CardFace.loyalty") }
	if fv, found := get_any(v, "defense"); found { if !dec_opt_string(fv, &out.defense) do return fail("CardFace.defense") }
	if fv, found := get_any(v, "oracle_text"); found { if !dec_opt_string(fv, &out.oracle_text) do return fail("CardFace.oracle_text") }
	if fv, found := get_any(v, "non_ability_text"); found { if !dec_opt_string(fv, &out.non_ability_text) do return fail("CardFace.non_ability_text") }
	if fv, found := get_any(v, "flavor_name"); found { if !dec_opt_string(fv, &out.flavor_name) do return fail("CardFace.flavor_name") }
	if fv, found := get_any(v, "keywords"); found { if !dec_dyn_Keyword(fv, &out.keywords) do return fail("CardFace.keywords") } else { return fail("CardFace.keywords missing") }
	if fv, found := get_any(v, "abilities"); found { if !dec_dyn_AbilityDefinition(fv, &out.abilities) do return fail("CardFace.abilities") } else { return fail("CardFace.abilities missing") }
	if fv, found := get_any(v, "triggers"); found { if !dec_dyn_TriggerDefinition(fv, &out.triggers) do return fail("CardFace.triggers") } else { return fail("CardFace.triggers missing") }
	if fv, found := get_any(v, "static_abilities"); found { if !dec_dyn_StaticDefinition(fv, &out.static_abilities) do return fail("CardFace.static_abilities") } else { return fail("CardFace.static_abilities missing") }
	if fv, found := get_any(v, "replacements"); found { if !dec_dyn_ReplacementDefinition(fv, &out.replacements) do return fail("CardFace.replacements") } else { return fail("CardFace.replacements missing") }
	if fv, found := get_any(v, "cleave_variant"); found { if !dec_opt_CleaveVariant(fv, &out.cleave_variant) do return fail("CardFace.cleave_variant") }
	if fv, found := get_any(v, "color_override"); found { if !dec_opt_dyn_ManaColor(fv, &out.color_override) do return fail("CardFace.color_override") }
	if fv, found := get_any(v, "color_identity"); found { if !dec_dyn_ManaColor(fv, &out.color_identity) do return fail("CardFace.color_identity") }
	if fv, found := get_any(v, "scryfall_oracle_id"); found { if !dec_opt_string(fv, &out.scryfall_oracle_id) do return fail("CardFace.scryfall_oracle_id") }
	if fv, found := get_any(v, "modal"); found { if !dec_opt_ModalChoice(fv, &out.modal) do return fail("CardFace.modal") }
	if fv, found := get_any(v, "additional_cost"); found { if !dec_opt_AdditionalCost(fv, &out.additional_cost) do return fail("CardFace.additional_cost") }
	if fv, found := get_any(v, "casting_restrictions"); found { if !dec_dyn_CastingRestriction(fv, &out.casting_restrictions) do return fail("CardFace.casting_restrictions") }
	if fv, found := get_any(v, "casting_options"); found { if !dec_dyn_SpellCastingOption(fv, &out.casting_options) do return fail("CardFace.casting_options") }
	if fv, found := get_any(v, "solve_condition"); found { if !dec_opt_SolveCondition(fv, &out.solve_condition) do return fail("CardFace.solve_condition") }
	if fv, found := get_any(v, "strive_cost"); found { if !dec_opt_ManaCost(fv, &out.strive_cost) do return fail("CardFace.strive_cost") }
	if fv, found := get_any(v, "brawl_commander"); found { if !decode_bool(fv, &out.brawl_commander) do return fail("CardFace.brawl_commander") }
	if fv, found := get_any(v, "is_commander"); found { if !decode_bool(fv, &out.is_commander) do return fail("CardFace.is_commander") }
	if fv, found := get_any(v, "is_oathbreaker"); found { if !decode_bool(fv, &out.is_oathbreaker) do return fail("CardFace.is_oathbreaker") }
	if fv, found := get_any(v, "deck_copy_limit"); found { if !dec_opt_DeckCopyLimit(fv, &out.deck_copy_limit) do return fail("CardFace.deck_copy_limit") }
	if fv, found := get_any(v, "no_maximum_deck_size"); found { if !dec_opt_DeckSizeOverride(fv, &out.deck_size_override) do return fail("CardFace.deck_size_override") }
	if fv, found := get_any(v, "attraction_lights"); found { if !dec_dyn_u8(fv, &out.attraction_lights) do return fail("CardFace.attraction_lights") }
	if fv, found := get_any(v, "parse_warnings"); found { if !dec_dyn_OracleDiagnostic(fv, &out.parse_warnings) do return fail("CardFace.parse_warnings") }
	if fv, found := get_any(v, "metadata"); found { if !decode_CardMetadata(fv, &out.metadata) do return fail("CardFace.metadata") }
	if fv, found := get_any(v, "rarities"); found { if !dec_dyn_Rarity(fv, &out.rarities) do return fail("CardFace.rarities") }
	return true
}

encode_CardFace :: proc(b: ^strings.Builder, x: CardFace) {
	strings.write_byte(b, '{')
	f := true
	encode_CardFace_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CardFace_members :: proc(b: ^strings.Builder, x: CardFace, first: ^bool) {
	member(b, first, "name"); encode_string(b, x.name)
	member(b, first, "mana_cost"); encode_ManaCost(b, x.mana_cost)
	member(b, first, "card_type"); encode_CardType(b, x.card_type)
	member(b, first, "power"); enc_opt_PtValue(b, x.power)
	member(b, first, "toughness"); enc_opt_PtValue(b, x.toughness)
	member(b, first, "loyalty"); enc_opt_string(b, x.loyalty)
	member(b, first, "defense"); enc_opt_string(b, x.defense)
	member(b, first, "oracle_text"); enc_opt_string(b, x.oracle_text)
	member(b, first, "non_ability_text"); enc_opt_string(b, x.non_ability_text)
	member(b, first, "flavor_name"); enc_opt_string(b, x.flavor_name)
	member(b, first, "keywords"); enc_dyn_Keyword(b, x.keywords)
	member(b, first, "abilities"); enc_dyn_AbilityDefinition(b, x.abilities)
	member(b, first, "triggers"); enc_dyn_TriggerDefinition(b, x.triggers)
	member(b, first, "static_abilities"); enc_dyn_StaticDefinition(b, x.static_abilities)
	member(b, first, "replacements"); enc_dyn_ReplacementDefinition(b, x.replacements)
	if !(x.cleave_variant == nil) { member(b, first, "cleave_variant"); enc_opt_CleaveVariant(b, x.cleave_variant) }
	member(b, first, "color_override"); enc_opt_dyn_ManaColor(b, x.color_override)
	if !((len(x.color_identity) == 0)) { member(b, first, "color_identity"); enc_dyn_ManaColor(b, x.color_identity) }
	member(b, first, "scryfall_oracle_id"); enc_opt_string(b, x.scryfall_oracle_id)
	if !(x.modal == nil) { member(b, first, "modal"); enc_opt_ModalChoice(b, x.modal) }
	if !(x.additional_cost == nil) { member(b, first, "additional_cost"); enc_opt_AdditionalCost(b, x.additional_cost) }
	if !((len(x.casting_restrictions) == 0)) { member(b, first, "casting_restrictions"); enc_dyn_CastingRestriction(b, x.casting_restrictions) }
	if !((len(x.casting_options) == 0)) { member(b, first, "casting_options"); enc_dyn_SpellCastingOption(b, x.casting_options) }
	if !(x.solve_condition == nil) { member(b, first, "solve_condition"); enc_opt_SolveCondition(b, x.solve_condition) }
	if !(x.strive_cost == nil) { member(b, first, "strive_cost"); enc_opt_ManaCost(b, x.strive_cost) }
	if !(!x.brawl_commander) { member(b, first, "brawl_commander"); encode_bool(b, x.brawl_commander) }
	if !(!x.is_commander) { member(b, first, "is_commander"); encode_bool(b, x.is_commander) }
	if !(!x.is_oathbreaker) { member(b, first, "is_oathbreaker"); encode_bool(b, x.is_oathbreaker) }
	if !(x.deck_copy_limit == nil) { member(b, first, "deck_copy_limit"); enc_opt_DeckCopyLimit(b, x.deck_copy_limit) }
	if !(x.deck_size_override == nil) { member(b, first, "no_maximum_deck_size"); enc_opt_DeckSizeOverride(b, x.deck_size_override) }
	if !((len(x.attraction_lights) == 0)) { member(b, first, "attraction_lights"); enc_dyn_u8(b, x.attraction_lights) }
	if !((len(x.parse_warnings) == 0)) { member(b, first, "parse_warnings"); enc_dyn_OracleDiagnostic(b, x.parse_warnings) }
	if !(skip_CardFace_CardMetadata_is_empty_CardMetadata(x.metadata)) { member(b, first, "metadata"); encode_CardMetadata(b, x.metadata) }
	if !((len(x.rarities) == 0)) { member(b, first, "rarities"); enc_dyn_Rarity(b, x.rarities) }
}

decode_Ruling :: proc(v: json.Value, out: ^Ruling) -> bool {
	when COVERAGE do cov_hit("Ruling")
	if v.kind != .Object do return fail("Ruling: not an object")
	if fv, found := get_any(v, "date"); found { if !decode_string(fv, &out.date) do return fail("Ruling.date") } else { return fail("Ruling.date missing") }
	if fv, found := get_any(v, "text"); found { if !decode_string(fv, &out.text) do return fail("Ruling.text") } else { return fail("Ruling.text missing") }
	return true
}

encode_Ruling :: proc(b: ^strings.Builder, x: Ruling) {
	strings.write_byte(b, '{')
	f := true
	encode_Ruling_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_Ruling_members :: proc(b: ^strings.Builder, x: Ruling, first: ^bool) {
	member(b, first, "date"); encode_string(b, x.date)
	member(b, first, "text"); encode_string(b, x.text)
}

decode_BracketSignals :: proc(v: json.Value, out: ^BracketSignals) -> bool {
	when COVERAGE do cov_hit("BracketSignals")
	if v.kind != .Object do return fail("BracketSignals: not an object")
	if fv, found := get_any(v, "game_changer"); found { if !decode_bool(fv, &out.game_changer) do return fail("BracketSignals.game_changer") }
	if fv, found := get_any(v, "mass_land_denial"); found { if !decode_bool(fv, &out.mass_land_denial) do return fail("BracketSignals.mass_land_denial") }
	if fv, found := get_any(v, "extra_turn"); found { if !decode_bool(fv, &out.extra_turn) do return fail("BracketSignals.extra_turn") }
	if fv, found := get_any(v, "efficient_tutor"); found { if !decode_bool(fv, &out.efficient_tutor) do return fail("BracketSignals.efficient_tutor") }
	return true
}

encode_BracketSignals :: proc(b: ^strings.Builder, x: BracketSignals) {
	strings.write_byte(b, '{')
	f := true
	encode_BracketSignals_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_BracketSignals_members :: proc(b: ^strings.Builder, x: BracketSignals, first: ^bool) {
	member(b, first, "game_changer"); encode_bool(b, x.game_changer)
	member(b, first, "mass_land_denial"); encode_bool(b, x.mass_land_denial)
	member(b, first, "extra_turn"); encode_bool(b, x.extra_turn)
	member(b, first, "efficient_tutor"); encode_bool(b, x.efficient_tutor)
}

decode_ManaCost :: proc(v: json.Value, out: ^ManaCost) -> bool {
	when COVERAGE do cov_hit("ManaCost")
	if v.kind != .Object do return fail("ManaCost: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ManaCost: no tag")
	switch tv.text {
	case "NoCost": when COVERAGE do cov_hit("ManaCost::NoCost"); out^ = ManaCost_NoCost{}
	case "Cost": when COVERAGE do cov_hit("ManaCost::Cost");
		tmp: ManaCost_Cost
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ManaCost_Cost) -> bool {
	if fv, found := get_any(v, "shards"); found { if !dec_dyn_ManaCostShard(fv, &out.shards) do return fail("ManaCost::Cost.shards") } else { return fail("ManaCost::Cost.shards missing") }
	if fv, found := get_any(v, "generic"); found { if !decode_u32(fv, &out.generic) do return fail("ManaCost::Cost.generic") } else { return fail("ManaCost::Cost.generic missing") }
	return true
		}) { return fail("ManaCost::Cost") }
		out^ = tmp
	case "SelfManaCost": when COVERAGE do cov_hit("ManaCost::SelfManaCost"); out^ = ManaCost_SelfManaCost{}
	case "SelfManaValue": when COVERAGE do cov_hit("ManaCost::SelfManaValue"); out^ = ManaCost_SelfManaValue{}
	case "SelfManaCostReduced": when COVERAGE do cov_hit("ManaCost::SelfManaCostReduced");
		tmp: ManaCost_SelfManaCostReduced
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ManaCost_SelfManaCostReduced) -> bool {
	if fv, found := get_any(v, "reduction"); found { if !decode_u32(fv, &out.reduction) do return fail("ManaCost::SelfManaCostReduced.reduction") } else { return fail("ManaCost::SelfManaCostReduced.reduction missing") }
	return true
		}) { return fail("ManaCost::SelfManaCostReduced") }
		out^ = tmp
	case: return fail("ManaCost: unknown variant")
	}
	return true
}

encode_ManaCost :: proc(b: ^strings.Builder, x: ManaCost) {
	#partial switch y in x {
	case ManaCost_NoCost: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NoCost"); strings.write_byte(b, '}')
	case ManaCost_Cost: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Cost")
	member(b, first, "shards"); enc_dyn_ManaCostShard(b, y.shards)
	member(b, first, "generic"); encode_u32(b, y.generic)
	}; strings.write_byte(b, '}')
	case ManaCost_SelfManaCost: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SelfManaCost"); strings.write_byte(b, '}')
	case ManaCost_SelfManaValue: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SelfManaValue"); strings.write_byte(b, '}')
	case ManaCost_SelfManaCostReduced: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SelfManaCostReduced")
	member(b, first, "reduction"); encode_u32(b, y.reduction)
	}; strings.write_byte(b, '}')
	}
}

encode_ManaCost_members :: proc(b: ^strings.Builder, x: ManaCost, first: ^bool) {
	#partial switch y in x {
	case ManaCost_NoCost: _ = y; member(b, first, "type"); json.write_string(b, "NoCost")
	case ManaCost_Cost: member(b, first, "type"); json.write_string(b, "Cost")
	member(b, first, "shards"); enc_dyn_ManaCostShard(b, y.shards)
	member(b, first, "generic"); encode_u32(b, y.generic)

	case ManaCost_SelfManaCost: _ = y; member(b, first, "type"); json.write_string(b, "SelfManaCost")
	case ManaCost_SelfManaValue: _ = y; member(b, first, "type"); json.write_string(b, "SelfManaValue")
	case ManaCost_SelfManaCostReduced: member(b, first, "type"); json.write_string(b, "SelfManaCostReduced")
	member(b, first, "reduction"); encode_u32(b, y.reduction)

	}
}

decode_CardType :: proc(v: json.Value, out: ^CardType) -> bool {
	when COVERAGE do cov_hit("CardType")
	if v.kind != .Object do return fail("CardType: not an object")
	if fv, found := get_any(v, "supertypes"); found { if !dec_dyn_Supertype(fv, &out.supertypes) do return fail("CardType.supertypes") } else { return fail("CardType.supertypes missing") }
	if fv, found := get_any(v, "core_types"); found { if !dec_dyn_CoreType(fv, &out.core_types) do return fail("CardType.core_types") } else { return fail("CardType.core_types missing") }
	if fv, found := get_any(v, "subtypes"); found { if !dec_dyn_string(fv, &out.subtypes) do return fail("CardType.subtypes") } else { return fail("CardType.subtypes missing") }
	return true
}

encode_CardType :: proc(b: ^strings.Builder, x: CardType) {
	strings.write_byte(b, '{')
	f := true
	encode_CardType_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CardType_members :: proc(b: ^strings.Builder, x: CardType, first: ^bool) {
	member(b, first, "supertypes"); enc_dyn_Supertype(b, x.supertypes)
	member(b, first, "core_types"); enc_dyn_CoreType(b, x.core_types)
	member(b, first, "subtypes"); enc_dyn_string(b, x.subtypes)
}

decode_PtValue :: proc(v: json.Value, out: ^PtValue) -> bool {
	when COVERAGE do cov_hit("PtValue")
	if v.kind != .Object do return fail("PtValue: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("PtValue: no tag")
	switch tv.text {
	case "Fixed": when COVERAGE do cov_hit("PtValue::Fixed"); tmp: PtValue_Fixed; if !decode_i32(json.get_or_null(v, "value"), &tmp._0) do return fail("PtValue::Fixed"); out^ = tmp
	case "Variable": when COVERAGE do cov_hit("PtValue::Variable"); tmp: PtValue_Variable; if !decode_string(json.get_or_null(v, "value"), &tmp._0) do return fail("PtValue::Variable"); out^ = tmp
	case "Quantity": when COVERAGE do cov_hit("PtValue::Quantity"); tmp: PtValue_Quantity; if !decode_QuantityExpr(json.get_or_null(v, "value"), &tmp._0) do return fail("PtValue::Quantity"); out^ = tmp
	case: return fail("PtValue: unknown variant")
	}
	return true
}

encode_PtValue :: proc(b: ^strings.Builder, x: PtValue) {
	#partial switch y in x {
	case PtValue_Fixed: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Fixed"); member(b, &f, "value"); encode_i32(b, y._0); strings.write_byte(b, '}')
	case PtValue_Variable: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Variable"); member(b, &f, "value"); encode_string(b, y._0); strings.write_byte(b, '}')
	case PtValue_Quantity: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Quantity"); member(b, &f, "value"); encode_QuantityExpr(b, y._0); strings.write_byte(b, '}')
	}
}

decode_Keyword :: proc(v: json.Value, out: ^Keyword) -> bool {
	when COVERAGE do cov_hit("Keyword")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("Keyword: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("Keyword: not a string or object")
	}
	switch variant {
	case "Flying": when COVERAGE do cov_hit("Keyword::Flying"); out^ = Keyword_Flying{}
	case "FirstStrike": when COVERAGE do cov_hit("Keyword::FirstStrike"); out^ = Keyword_FirstStrike{}
	case "DoubleStrike": when COVERAGE do cov_hit("Keyword::DoubleStrike"); out^ = Keyword_DoubleStrike{}
