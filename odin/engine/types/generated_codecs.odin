		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_RetainPrintedTriggerFromSource) -> bool {
	if fv, found := get_any(v, "source_trigger_index"); found { if !decode_int(fv, &out.source_trigger_index) do return fail("ContinuousModification::RetainPrintedTriggerFromSource.source_trigger_index") } else { return fail("ContinuousModification::RetainPrintedTriggerFromSource.source_trigger_index missing") }
