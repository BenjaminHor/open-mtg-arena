decode_CleaveFormState :: proc(v: json.Value, out: ^CleaveFormState) -> bool {
	when COVERAGE do cov_hit("CleaveFormState")
	if v.kind != .Object do return fail("CleaveFormState: not an object")
	if fv, found := get_any(v, "abilities"); found { if !dec_shared_dyn_AbilityDefinition(fv, &out.abilities) do return fail("CleaveFormState.abilities") } else { return fail("CleaveFormState.abilities missing") }
	if fv, found := get_any(v, "triggers"); found { if !decode_Definitions_TriggerEntry(fv, &out.triggers) do return fail("CleaveFormState.triggers") } else { return fail("CleaveFormState.triggers missing") }
	if fv, found := get_any(v, "statics"); found { if !decode_Definitions_StaticDefinition(fv, &out.statics) do return fail("CleaveFormState.statics") } else { return fail("CleaveFormState.statics missing") }
	if fv, found := get_any(v, "replacements"); found { if !decode_Definitions_ReplacementDefinition(fv, &out.replacements) do return fail("CleaveFormState.replacements") } else { return fail("CleaveFormState.replacements missing") }
	if fv, found := get_any(v, "base_abilities"); found { if !dec_shared_dyn_AbilityDefinition(fv, &out.base_abilities) do return fail("CleaveFormState.base_abilities") } else { return fail("CleaveFormState.base_abilities missing") }
	if fv, found := get_any(v, "base_triggers"); found { if !dec_shared_dyn_TriggerDefinition(fv, &out.base_triggers) do return fail("CleaveFormState.base_triggers") } else { return fail("CleaveFormState.base_triggers missing") }
	if fv, found := get_any(v, "base_trigger_printed_origins"); found { if !dec_dyn_opt_TriggerPrintedOrigin(fv, &out.base_trigger_printed_origins) do return fail("CleaveFormState.base_trigger_printed_origins") }
	if fv, found := get_any(v, "trigger_base_set_instance"); found { if !decode_TriggerBaseSetInstanceRef(fv, &out.trigger_base_set_instance) do return fail("CleaveFormState.trigger_base_set_instance") } else { return fail("CleaveFormState.trigger_base_set_instance missing") }
	if fv, found := get_any(v, "next_trigger_base_set_instance"); found { if !decode_u64(fv, &out.next_trigger_base_set_instance) do return fail("CleaveFormState.next_trigger_base_set_instance") } else { return fail("CleaveFormState.next_trigger_base_set_instance missing") }
	if fv, found := get_any(v, "base_statics"); found { if !dec_shared_dyn_StaticDefinition(fv, &out.base_statics) do return fail("CleaveFormState.base_statics") } else { return fail("CleaveFormState.base_statics missing") }
	if fv, found := get_any(v, "base_replacements"); found { if !dec_shared_dyn_ReplacementDefinition(fv, &out.base_replacements) do return fail("CleaveFormState.base_replacements") } else { return fail("CleaveFormState.base_replacements missing") }
	return true
}

encode_CleaveFormState :: proc(b: ^strings.Builder, x: CleaveFormState) {
	strings.write_byte(b, '{')
	f := true
	encode_CleaveFormState_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CleaveFormState_members :: proc(b: ^strings.Builder, x: CleaveFormState, first: ^bool) {
	member(b, first, "abilities"); enc_shared_dyn_AbilityDefinition(b, x.abilities)
	member(b, first, "triggers"); encode_Definitions_TriggerEntry(b, x.triggers)
	member(b, first, "statics"); encode_Definitions_StaticDefinition(b, x.statics)
	member(b, first, "replacements"); encode_Definitions_ReplacementDefinition(b, x.replacements)
	member(b, first, "base_abilities"); enc_shared_dyn_AbilityDefinition(b, x.base_abilities)
	member(b, first, "base_triggers"); enc_shared_dyn_TriggerDefinition(b, x.base_triggers)
	if !((len(x.base_trigger_printed_origins) == 0)) { member(b, first, "base_trigger_printed_origins"); enc_dyn_opt_TriggerPrintedOrigin(b, x.base_trigger_printed_origins) }
	member(b, first, "trigger_base_set_instance"); encode_TriggerBaseSetInstanceRef(b, x.trigger_base_set_instance)
	member(b, first, "next_trigger_base_set_instance"); encode_u64(b, x.next_trigger_base_set_instance)
	member(b, first, "base_statics"); enc_shared_dyn_StaticDefinition(b, x.base_statics)
	member(b, first, "base_replacements"); enc_shared_dyn_ReplacementDefinition(b, x.base_replacements)
}

decode_ManaPip :: proc(v: json.Value, out: ^ManaPip) -> bool {
	when COVERAGE do cov_hit("ManaPip")
	if v.kind != .Object do return fail("ManaPip: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ManaPip: no tag")
	switch tv.text {
	case "Color": when COVERAGE do cov_hit("ManaPip::Color"); tmp: ManaPip_Color; if !decode_ManaColor(json.get_or_null(v, "data"), &tmp._0) do return fail("ManaPip::Color"); out^ = tmp
	case "Colorless": when COVERAGE do cov_hit("ManaPip::Colorless"); out^ = ManaPip_Colorless{}
	case "OneOfColors": when COVERAGE do cov_hit("ManaPip::OneOfColors"); tmp: ManaPip_OneOfColors; if !dec_dyn_ManaColor(json.get_or_null(v, "data"), &tmp._0) do return fail("ManaPip::OneOfColors"); out^ = tmp
	case "CombinationOfColors": when COVERAGE do cov_hit("ManaPip::CombinationOfColors"); tmp: ManaPip_CombinationOfColors; if !dec_dyn_ManaColor(json.get_or_null(v, "data"), &tmp._0) do return fail("ManaPip::CombinationOfColors"); out^ = tmp
	case "AnyInCommandersIdentity": when COVERAGE do cov_hit("ManaPip::AnyInCommandersIdentity"); out^ = ManaPip_AnyInCommandersIdentity{}
	case: return fail("ManaPip: unknown variant")
	}
	return true
}

encode_ManaPip :: proc(b: ^strings.Builder, x: ManaPip) {
	#partial switch y in x {
	case ManaPip_Color: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Color"); member(b, &f, "data"); encode_ManaColor(b, y._0); strings.write_byte(b, '}')
	case ManaPip_Colorless: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Colorless"); strings.write_byte(b, '}')
	case ManaPip_OneOfColors: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OneOfColors"); member(b, &f, "data"); enc_dyn_ManaColor(b, y._0); strings.write_byte(b, '}')
	case ManaPip_CombinationOfColors: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CombinationOfColors"); member(b, &f, "data"); enc_dyn_ManaColor(b, y._0); strings.write_byte(b, '}')
	case ManaPip_AnyInCommandersIdentity: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AnyInCommandersIdentity"); strings.write_byte(b, '}')
	}
}

