	case Effect_TurnFaceDown: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TurnFaceDown")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	if !(y.profile == nil) { member(b, first, "profile"); enc_opt_FaceDownProfile(b, y.profile) }
	}; strings.write_byte(b, '}')
	case Effect_ExtraTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ExtraTurn")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	if !(skip_Effect_is_default_quantity_one(y.count)) { member(b, first, "count"); encode_QuantityExpr(b, y.count) }
	}; strings.write_byte(b, '}')
	case Effect_GrantExtraLoyaltyActivations: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GrantExtraLoyaltyActivations")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case Effect_SkipNextTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SkipNextTurn")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	case Effect_SkipNextStep: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SkipNextStep")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "step"); encode_StepSkipTarget(b, y.step)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "scope"); encode_SkipScope(b, y.scope)
	}; strings.write_byte(b, '}')
	case Effect_AdditionalPhase: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AdditionalPhase")
	member(b, first, "recipient"); encode_ExtraPhaseRecipient(b, y.recipient)
	member(b, first, "segment"); encode_TurnSegment(b, y.segment)
	member(b, first, "after"); encode_ExtraPhaseAnchor(b, y.after)
	member(b, first, "followed_by"); enc_dyn_TurnSegment(b, y.followed_by)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "attacker_restriction"); enc_opt_TargetFilter(b, y.attacker_restriction)
	}; strings.write_byte(b, '}')
	case Effect_ModifyAnnouncedX: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ModifyAnnouncedX")
	member(b, first, "modification"); encode_XModification(b, y.modification)
	}; strings.write_byte(b, '}')
	case Effect_Double: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Double")
	member(b, first, "target_kind"); encode_DoubleTarget(b, y.target_kind)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case Effect_RuntimeHandled: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RuntimeHandled")
	member(b, first, "handler"); encode_RuntimeHandler(b, y.handler)
	}; strings.write_byte(b, '}')
	case Effect_Incubate: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Incubate")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	case Effect_Amass: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Amass")
	member(b, first, "subtype"); encode_string(b, y.subtype)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	if !(skip_Effect_is_target_filter_controller(y.player)) { member(b, first, "player"); encode_TargetFilter(b, y.player) }
	}; strings.write_byte(b, '}')
	case Effect_EmpowerJace: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "EmpowerJace")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	case Effect_Monstrosity: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Monstrosity")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	case Effect_HordePlayCard: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HordePlayCard")
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}')
	case Effect_Specialize: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Specialize"); strings.write_byte(b, '}')
	case Effect_Renown: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Renown")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	case Effect_Bolster: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Bolster")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	case Effect_Adapt: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Adapt")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	case Effect_Learn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Learn"); strings.write_byte(b, '}')
	case Effect_Forage: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Forage"); strings.write_byte(b, '}')
	case Effect_CompletePlayerAction: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CompletePlayerAction")
	member(b, first, "parent_kind"); encode_EffectKind(b, y.parent_kind)
	member(b, first, "action"); encode_PlayerActionKind(b, y.action)
	member(b, first, "required_result"); encode_EffectResolutionResult(b, y.required_result)
	}; strings.write_byte(b, '}')
	case Effect_Harness: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Harness"); strings.write_byte(b, '}')
	case Effect_CollectEvidence: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CollectEvidence")
	member(b, first, "amount"); encode_u32(b, y.amount)
	}; strings.write_byte(b, '}')
	case Effect_Endure: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Endure")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	member(b, first, "subject"); encode_TargetFilter(b, y.subject)
	}; strings.write_byte(b, '}')
	case Effect_BlightEffect: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "BlightEffect")
	member(b, first, "count"); encode_u32(b, y.count)
	if !(skip_Effect_is_target_filter_controller(y.player)) { member(b, first, "player"); encode_TargetFilter(b, y.player) }
	}; strings.write_byte(b, '}')
	case Effect_Seek: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Seek")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	if !(y.from_top == nil) { member(b, first, "from_top"); enc_opt_int(b, y.from_top) }
	member(b, first, "destination"); encode_Zone(b, y.destination)
	member(b, first, "enter_tapped"); encode_with_etb_tap_bool_compat(b, y.enter_tapped)
	}; strings.write_byte(b, '}')
	case Effect_SetLifeTotal: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetLifeTotal")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	}; strings.write_byte(b, '}')
	case Effect_ExchangeLifeWithStat: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ExchangeLifeWithStat")
	member(b, first, "player"); encode_TargetFilter(b, y.player)
	member(b, first, "stat"); encode_PtStat(b, y.stat)
	}; strings.write_byte(b, '}')
	case Effect_ExchangeLifeTotals: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ExchangeLifeTotals")
	member(b, first, "player_a"); encode_TargetFilter(b, y.player_a)
	member(b, first, "player_b"); encode_TargetFilter(b, y.player_b)
	}; strings.write_byte(b, '}')
	case Effect_SetDayNight: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetDayNight")
	member(b, first, "to"); encode_DayNight(b, y.to)
	}; strings.write_byte(b, '}')
	case Effect_GiveControl: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GiveControl")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "recipient"); encode_TargetFilter(b, y.recipient)
	}; strings.write_byte(b, '}')
	case Effect_RemoveFromCombat: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RemoveFromCombat")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case Effect_BecomeBlocked: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "BecomeBlocked")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case Effect_Conjure: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Conjure")
	member(b, first, "cards"); enc_dyn_ConjureCard(b, y.cards)
	member(b, first, "destination"); encode_Zone(b, y.destination)
	member(b, first, "tapped"); encode_bool(b, y.tapped)
	if !(y.library_position == nil) { member(b, first, "library_position"); enc_opt_LibraryPosition(b, y.library_position) }
	if !(y.library_players == nil) { member(b, first, "library_players"); enc_opt_PlayerFilter(b, y.library_players) }
	}; strings.write_byte(b, '}')
	case Effect_CreateCardCopyByName: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CreateCardCopyByName")
	if !(y.name == nil) { member(b, first, "name"); enc_opt_string(b, y.name) }
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	case Effect_ApplyPerpetual: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ApplyPerpetual")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "modification"); encode_PerpetualModification(b, y.modification)
	}; strings.write_byte(b, '}')
	case Effect_Intensify: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Intensify")
	member(b, first, "scope"); encode_IntensityScope(b, y.scope)
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	}; strings.write_byte(b, '}')
	case Effect_DraftFromSpellbook: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DraftFromSpellbook")
	member(b, first, "destination"); encode_Zone(b, y.destination)
	member(b, first, "tapped"); encode_bool(b, y.tapped)
	member(b, first, "selection"); encode_SpellbookSelection(b, y.selection)
	}; strings.write_byte(b, '}')
	case Effect_ChooseOneOf: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChooseOneOf")
	member(b, first, "chooser"); encode_PlayerFilter(b, y.chooser)
	member(b, first, "branches"); enc_dyn_AbilityDefinition(b, y.branches)
	if !(skip_Effect_ChooseOneOfKind_is_ordinary(y.kind)) { member(b, first, "kind"); encode_ChooseOneOfKind(b, y.kind) }
	}; strings.write_byte(b, '}')
	case Effect_Unimplemented: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Unimplemented")
	member(b, first, "name"); encode_string(b, y.name)
	member(b, first, "description"); enc_opt_string(b, y.description)
	}; strings.write_byte(b, '}')
	}
}

encode_Effect_members :: proc(b: ^strings.Builder, x: Effect, first: ^bool) {
	#partial switch y in x {
	case Effect_StartYourEngines: member(b, first, "type"); json.write_string(b, "StartYourEngines")
	member(b, first, "player_scope"); encode_PlayerFilter(b, y.player_scope)

	case Effect_ChangeSpeed: member(b, first, "type"); json.write_string(b, "ChangeSpeed")
	member(b, first, "player_scope"); encode_PlayerFilter(b, y.player_scope)
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	member(b, first, "direction"); encode_SpeedDelta(b, y.direction)
	if !(y.floor == nil) { member(b, first, "floor"); enc_opt_u8(b, y.floor) }

	case Effect_DealDamage: member(b, first, "type"); json.write_string(b, "DealDamage")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	if !(y.damage_source == nil) { member(b, first, "damage_source"); enc_opt_DamageSource(b, y.damage_source) }
	if !(y.excess == nil) { member(b, first, "excess"); enc_opt_ExcessRecipient(b, y.excess) }

	case Effect_ApplyPostReplacementDamage: member(b, first, "type"); json.write_string(b, "ApplyPostReplacementDamage")
	member(b, first, "context"); encode_DamageContextSnapshot(b, y.context_)
	member(b, first, "target"); encode_TargetRef(b, y.target)
	member(b, first, "amount"); encode_u32(b, y.amount)
	member(b, first, "is_combat"); encode_bool(b, y.is_combat)

	case Effect_ResumeDamageBatch: member(b, first, "type"); json.write_string(b, "ResumeDamageBatch")
	member(b, first, "kind"); encode_EffectKind(b, y.kind)
	member(b, first, "replaced"); enc_dyn_ReplacedDamagePortion(b, y.replaced)
	member(b, first, "remaining"); enc_dyn_RawDamagePortion(b, y.remaining)
	if !(y.awaiting == nil) { member(b, first, "awaiting"); enc_opt_RawDamagePortion(b, y.awaiting) }

	case Effect_EachDealsDamageEqualToPower: member(b, first, "type"); json.write_string(b, "EachDealsDamageEqualToPower")
	member(b, first, "sources"); encode_TargetFilter(b, y.sources)
	member(b, first, "recipient"); encode_TargetFilter(b, y.recipient)
	if !(y.extra_source == nil) { member(b, first, "extra_source"); enc_opt_TargetFilter(b, y.extra_source) }

	case Effect_EachSourceDealsDamage: member(b, first, "type"); json.write_string(b, "EachSourceDealsDamage")
	member(b, first, "sources"); encode_TargetFilter(b, y.sources)
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	member(b, first, "recipient"); encode_EachDamageRecipient(b, y.recipient)

	case Effect_Draw: member(b, first, "type"); json.write_string(b, "Draw")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "target"); encode_TargetFilter(b, y.target)

	case Effect_Pump: member(b, first, "type"); json.write_string(b, "Pump")
	member(b, first, "power"); encode_PtValue(b, y.power)
	member(b, first, "toughness"); encode_PtValue(b, y.toughness)
	member(b, first, "target"); encode_TargetFilter(b, y.target)

	case Effect_PairWith: member(b, first, "type"); json.write_string(b, "PairWith")
	member(b, first, "target"); encode_TargetFilter(b, y.target)

	case Effect_Destroy: member(b, first, "type"); json.write_string(b, "Destroy")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "cant_regenerate"); encode_bool(b, y.cant_regenerate)

	case Effect_Regenerate: member(b, first, "type"); json.write_string(b, "Regenerate")
	member(b, first, "target"); encode_TargetFilter(b, y.target)

	case Effect_RemoveAllDamage: member(b, first, "type"); json.write_string(b, "RemoveAllDamage")
	member(b, first, "target"); encode_TargetFilter(b, y.target)

	case Effect_Counter: member(b, first, "type"); json.write_string(b, "Counter")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	if !(y.source_rider == nil) { member(b, first, "source_rider"); enc_opt_CounterSourceRider(b, y.source_rider) }
	if !(y.countered_spell_zone == nil) { member(b, first, "countered_spell_zone"); enc_opt_SpellStackToGraveyardReplacement(b, y.countered_spell_zone) }

	case Effect_CounterAll: member(b, first, "type"); json.write_string(b, "CounterAll")
	member(b, first, "target"); encode_TargetFilter(b, y.target)

	case Effect_Token: member(b, first, "type"); json.write_string(b, "Token")
	member(b, first, "name"); encode_string(b, y.name)
	member(b, first, "power"); encode_PtValue(b, y.power)
	member(b, first, "toughness"); encode_PtValue(b, y.toughness)
	member(b, first, "types"); enc_dyn_string(b, y.types)
	member(b, first, "colors"); enc_dyn_ManaColor(b, y.colors)
	member(b, first, "keywords"); enc_dyn_Keyword(b, y.keywords)
	member(b, first, "tapped"); encode_bool(b, y.tapped)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "owner"); encode_TargetFilter(b, y.owner)
	if !(y.attach_to == nil) { member(b, first, "attach_to"); enc_opt_TargetFilter(b, y.attach_to) }
	member(b, first, "enters_attacking"); encode_bool(b, y.enters_attacking)
	if !(skip_Effect_TokenAttackDestination_is_controller_chooses(y.attack_destination)) { member(b, first, "attack_destination"); encode_TokenAttackDestination(b, y.attack_destination) }
	if !(len(y.supertypes) == 0) { member(b, first, "supertypes"); enc_dyn_Supertype(b, y.supertypes) }
	if !(len(y.static_abilities) == 0) { member(b, first, "static_abilities"); enc_dyn_StaticDefinition(b, y.static_abilities) }
	if !(len(y.enter_with_counters) == 0) { member(b, first, "enter_with_counters"); enc_dyn_t2_CounterType_QuantityExpr(b, y.enter_with_counters) }

	case Effect_GainLife: member(b, first, "type"); json.write_string(b, "GainLife")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	if !(skip_Effect_is_target_filter_controller(y.player)) { member(b, first, "player"); encode_TargetFilter(b, y.player) }

	case Effect_LoseLife: member(b, first, "type"); json.write_string(b, "LoseLife")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	if !(y.target == nil) { member(b, first, "target"); enc_opt_TargetFilter(b, y.target) }

	case Effect_SetTapState: member(b, first, "type"); json.write_string(b, "SetTapState")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "scope"); encode_EffectScope(b, y.scope)
	member(b, first, "state"); encode_TapStateChange(b, y.state)

	case Effect_RemoveCounter: member(b, first, "type"); json.write_string(b, "RemoveCounter")
	member(b, first, "counter_type"); enc_opt_CounterType(b, y.counter_type)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	if !(skip_Effect_EffectScope_is_single(y.scope)) { member(b, first, "scope"); encode_EffectScope(b, y.scope) }

	case Effect_Sacrifice: member(b, first, "type"); json.write_string(b, "Sacrifice")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	if !(y.min_count == 0) { member(b, first, "min_count"); encode_int(b, y.min_count) }

	case Effect_DiscardCard: member(b, first, "type"); json.write_string(b, "DiscardCard")
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "target"); encode_TargetFilter(b, y.target)

	case Effect_Mill: member(b, first, "type"); json.write_string(b, "Mill")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "destination"); encode_Zone(b, y.destination)
	if !(skip_Effect_LibraryPosition_is_top(y.position)) { member(b, first, "position"); encode_LibraryPosition(b, y.position) }

	case Effect_Scry: member(b, first, "type"); json.write_string(b, "Scry")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "target"); encode_TargetFilter(b, y.target)

	case Effect_PumpAll: member(b, first, "type"); json.write_string(b, "PumpAll")
	member(b, first, "power"); encode_PtValue(b, y.power)
	member(b, first, "toughness"); encode_PtValue(b, y.toughness)
	member(b, first, "target"); encode_TargetFilter(b, y.target)

	case Effect_DamageAll: member(b, first, "type"); json.write_string(b, "DamageAll")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	if !(y.player_filter == nil) { member(b, first, "player_filter"); enc_opt_PlayerFilter(b, y.player_filter) }
	if !(y.damage_source == nil) { member(b, first, "damage_source"); enc_opt_DamageSource(b, y.damage_source) }

	case Effect_DamageEachPlayer: member(b, first, "type"); json.write_string(b, "DamageEachPlayer")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	member(b, first, "player_filter"); encode_PlayerFilter(b, y.player_filter)

	case Effect_DestroyAll: member(b, first, "type"); json.write_string(b, "DestroyAll")
