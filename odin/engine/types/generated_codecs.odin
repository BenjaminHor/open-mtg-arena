encode_BoundSearchFoundGrant_members :: proc(b: ^strings.Builder, x: BoundSearchFoundGrant, first: ^bool) {
	member(b, first, "source"); encode_ObjectIncarnationRef(b, x.source)
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	member(b, first, "grantee"); encode_PlayerId(b, x.grantee)
	if !(x.mana_spend_permission == nil) { member(b, first, "mana_spend_permission"); enc_opt_ManaSpendPermission(b, x.mana_spend_permission) }
}

decode_PendingSearchFoundContinuation :: proc(v: json.Value, out: ^PendingSearchFoundContinuation) -> bool {
	when COVERAGE do cov_hit("PendingSearchFoundContinuation")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("PendingSearchFoundContinuation: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("PendingSearchFoundContinuation: not a string or object")
	}
	switch variant {
	case "Standard": when COVERAGE do cov_hit("PendingSearchFoundContinuation::Standard");
		tmp: PendingSearchFoundContinuation_Standard
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^PendingSearchFoundContinuation_Standard) -> bool {
	if fv, found := get_any(v, "split"); found { if !dec_opt_SearchDestinationSplit(fv, &out.split) do return fail("PendingSearchFoundContinuation::Standard.split") }
	return true
		}) { return fail("PendingSearchFoundContinuation::Standard") }
		out^ = tmp
	case "Scoped": when COVERAGE do cov_hit("PendingSearchFoundContinuation::Scoped"); out^ = PendingSearchFoundContinuation_Scoped{}
	case: return fail("PendingSearchFoundContinuation: unknown variant")
	}
	return true
}

encode_PendingSearchFoundContinuation :: proc(b: ^strings.Builder, x: PendingSearchFoundContinuation) {
	#partial switch y in x {
	case PendingSearchFoundContinuation_Standard: strings.write_byte(b, '{'); json.write_string(b, "Standard"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	if !(y.split == nil) { member(b, first, "split"); enc_opt_SearchDestinationSplit(b, y.split) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingSearchFoundContinuation_Scoped: _ = y; json.write_string(b, "Scoped")
	}
}

