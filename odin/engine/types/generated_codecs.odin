	if v.kind != .Object do return fail("PendingCombatPhaseSkip: not an object")
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("PendingCombatPhaseSkip.player") } else { return fail("PendingCombatPhaseSkip.player missing") }
	if fv, found := get_any(v, "duration"); found { if !dec_opt_Duration(fv, &out.duration) do return fail("PendingCombatPhaseSkip.duration") }
	return true
}

encode_PendingCombatPhaseSkip :: proc(b: ^strings.Builder, x: PendingCombatPhaseSkip) {
	strings.write_byte(b, '{')
	f := true
	encode_PendingCombatPhaseSkip_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PendingCombatPhaseSkip_members :: proc(b: ^strings.Builder, x: PendingCombatPhaseSkip, first: ^bool) {
	member(b, first, "player"); encode_PlayerId(b, x.player)
	member(b, first, "duration"); enc_opt_Duration(b, x.duration)
}

