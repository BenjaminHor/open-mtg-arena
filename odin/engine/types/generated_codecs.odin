	if fv, found := get_any(v, "selections"); found { if !dec_dyn_t2_PlayerId_dyn_ObjectIncarnationRef(fv, &out.selections) do return fail("ScopedLibrarySearchPhase::CollectSelections.selections") } else { return fail("ScopedLibrarySearchPhase::CollectSelections.selections missing") }
