	when COVERAGE do cov_hit("NextSpellModifier")
	if v.kind != .Object do return fail("NextSpellModifier: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("NextSpellModifier: no tag")
	switch tv.text {
	case "CantBeCountered": when COVERAGE do cov_hit("NextSpellModifier::CantBeCountered"); out^ = NextSpellModifier_CantBeCountered{}
	case "HasKeyword": when COVERAGE do cov_hit("NextSpellModifier::HasKeyword");
		tmp: NextSpellModifier_HasKeyword
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^NextSpellModifier_HasKeyword) -> bool {
	if fv, found := get_any(v, "keyword"); found { if !decode_Keyword(fv, &out.keyword) do return fail("NextSpellModifier::HasKeyword.keyword") } else { return fail("NextSpellModifier::HasKeyword.keyword missing") }
	return true
		}) { return fail("NextSpellModifier::HasKeyword") }
		out^ = tmp
	case "CastAsThoughFlash": when COVERAGE do cov_hit("NextSpellModifier::CastAsThoughFlash"); out^ = NextSpellModifier_CastAsThoughFlash{}
	case "WithoutPayingManaCost": when COVERAGE do cov_hit("NextSpellModifier::WithoutPayingManaCost"); out^ = NextSpellModifier_WithoutPayingManaCost{}
	case: return fail("NextSpellModifier: unknown variant")
	}
	return true
}

encode_NextSpellModifier :: proc(b: ^strings.Builder, x: NextSpellModifier) {
	#partial switch y in x {
	case NextSpellModifier_CantBeCountered: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CantBeCountered"); strings.write_byte(b, '}')
	case NextSpellModifier_HasKeyword: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HasKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)
	}; strings.write_byte(b, '}')
	case NextSpellModifier_CastAsThoughFlash: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CastAsThoughFlash"); strings.write_byte(b, '}')
	case NextSpellModifier_WithoutPayingManaCost: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "WithoutPayingManaCost"); strings.write_byte(b, '}')
	}
}

encode_NextSpellModifier_members :: proc(b: ^strings.Builder, x: NextSpellModifier, first: ^bool) {
	#partial switch y in x {
	case NextSpellModifier_CantBeCountered: _ = y; member(b, first, "type"); json.write_string(b, "CantBeCountered")
	case NextSpellModifier_HasKeyword: member(b, first, "type"); json.write_string(b, "HasKeyword")
