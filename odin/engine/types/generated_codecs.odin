	member(b, first, "exclude_source"); encode_SourceExclusion(b, y.exclude_source)
	}; strings.write_byte(b, '}')
	case AttackersDeclaredCountSubject_Controller: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Controller")
	member(b, first, "scope"); encode_ControllerRef(b, y.scope)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }
	}; strings.write_byte(b, '}')
	case AttackersDeclaredCountSubject_AttackTarget: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AttackTarget")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)
