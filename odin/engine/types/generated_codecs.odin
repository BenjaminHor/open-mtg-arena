decode_StaticMode :: proc(v: json.Value, out: ^StaticMode) -> bool {
	when COVERAGE do cov_hit("StaticMode")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("StaticMode: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("StaticMode: not a string or object")
	}
	switch variant {
	case "Continuous": when COVERAGE do cov_hit("StaticMode::Continuous"); out^ = StaticMode_Continuous{}
	case "DamageNotRemovedDuringCleanup": when COVERAGE do cov_hit("StaticMode::DamageNotRemovedDuringCleanup"); out^ = StaticMode_DamageNotRemovedDuringCleanup{}
	case "LethalDamageDeterminedByPower": when COVERAGE do cov_hit("StaticMode::LethalDamageDeterminedByPower"); out^ = StaticMode_LethalDamageDeterminedByPower{}
	case "CantAttack": when COVERAGE do cov_hit("StaticMode::CantAttack"); out^ = StaticMode_CantAttack{}
	case "CantBlock": when COVERAGE do cov_hit("StaticMode::CantBlock"); out^ = StaticMode_CantBlock{}
	case "CantAttackOrBlock": when COVERAGE do cov_hit("StaticMode::CantAttackOrBlock"); out^ = StaticMode_CantAttackOrBlock{}
	case "AttackOnlyNeighbor": when COVERAGE do cov_hit("StaticMode::AttackOnlyNeighbor"); out^ = StaticMode_AttackOnlyNeighbor{}
	case "CantBecomeSuspected": when COVERAGE do cov_hit("StaticMode::CantBecomeSuspected"); out^ = StaticMode_CantBecomeSuspected{}
	case "MaxAttackersEachCombat": when COVERAGE do cov_hit("StaticMode::MaxAttackersEachCombat");
		tmp: StaticMode_MaxAttackersEachCombat
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_MaxAttackersEachCombat) -> bool {
	if fv, found := get_any(v, "max"); found { if !decode_u32(fv, &out.max) do return fail("StaticMode::MaxAttackersEachCombat.max") } else { return fail("StaticMode::MaxAttackersEachCombat.max missing") }
	if fv, found := get_any(v, "defender"); found { if !dec_opt_AttackDefenderScope(fv, &out.defender) do return fail("StaticMode::MaxAttackersEachCombat.defender") }
	return true
		}) { return fail("StaticMode::MaxAttackersEachCombat") }
		out^ = tmp
	case "MaxBlockersEachCombat": when COVERAGE do cov_hit("StaticMode::MaxBlockersEachCombat");
		tmp: StaticMode_MaxBlockersEachCombat
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_MaxBlockersEachCombat) -> bool {
	if fv, found := get_any(v, "max"); found { if !decode_u32(fv, &out.max) do return fail("StaticMode::MaxBlockersEachCombat.max") } else { return fail("StaticMode::MaxBlockersEachCombat.max missing") }
	return true
		}) { return fail("StaticMode::MaxBlockersEachCombat") }
		out^ = tmp
	case "CantBeTargeted": when COVERAGE do cov_hit("StaticMode::CantBeTargeted");
		tmp: StaticMode_CantBeTargeted
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_CantBeTargeted) -> bool {
	if fv, found := get_any(v, "who"); found { if !decode_ProhibitionScope(fv, &out.who) do return fail("StaticMode::CantBeTargeted.who") } else { out.who = default_StaticMode_default_prohibition_all_players() }
	return true
		}) { return fail("StaticMode::CantBeTargeted") }
		out^ = tmp
	case "CantBeCast": when COVERAGE do cov_hit("StaticMode::CantBeCast");
		tmp: StaticMode_CantBeCast
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_CantBeCast) -> bool {
	if fv, found := get_any(v, "who"); found { if !decode_ProhibitionScope(fv, &out.who) do return fail("StaticMode::CantBeCast.who") } else { return fail("StaticMode::CantBeCast.who missing") }
	return true
		}) { return fail("StaticMode::CantBeCast") }
