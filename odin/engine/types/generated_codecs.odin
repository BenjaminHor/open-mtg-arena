	if fv, found := get_any(v, "phyrexian_choices"); found { if !dec_opt_dyn_ShardChoice(fv, &out.phyrexian_choices) do return fail("PendingCostMoveCompletion::FinalizeCast.phyrexian_choices") }
	if fv, found := get_any(v, "cascade_cast_transformed"); found { if !decode_bool(fv, &out.cascade_cast_transformed) do return fail("PendingCostMoveCompletion::FinalizeCast.cascade_cast_transformed") } else { return fail("PendingCostMoveCompletion::FinalizeCast.cascade_cast_transformed missing") }
	if fv, found := get_any(v, "resolution_success_waiting_for"); found { if !dec_ptr_WaitingFor(fv, &out.resolution_success_waiting_for) do return fail("PendingCostMoveCompletion::FinalizeCast.resolution_success_waiting_for") }
	if fv, found := get_any(v, "prepaid_actual_mana_spent"); found { if !dec_opt_u32(fv, &out.prepaid_actual_mana_spent) do return fail("PendingCostMoveCompletion::FinalizeCast.prepaid_actual_mana_spent") }
	return true
		}) { return fail("PendingCostMoveCompletion::FinalizeCast") }
