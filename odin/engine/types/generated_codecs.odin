}

encode_ProposedEvent :: proc(b: ^strings.Builder, x: ProposedEvent) {
	#partial switch y in x {
	case ProposedEvent_ZoneChange: strings.write_byte(b, '{'); json.write_string(b, "ZoneChange"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "from"); encode_Zone(b, y.from)
	member(b, first, "to"); encode_Zone(b, y.to)
	member(b, first, "library_placement"); enc_ptr_LibraryPosition(b, y.library_placement)
	member(b, first, "cause"); enc_opt_ObjectId(b, y.cause)
	if !(y.attach_to == nil) { member(b, first, "attach_to"); enc_opt_AttachTarget(b, y.attach_to) }
	member(b, first, "enter_tapped"); encode_EtbTapState(b, y.enter_tapped)
	member(b, first, "enters_attacking"); encode_bool(b, y.enters_attacking)
	if !((len(y.enter_with_counters) == 0)) { member(b, first, "enter_with_counters"); enc_dyn_t2_CounterType_u32(b, y.enter_with_counters) }
	if !(y.enter_with_grants == nil) { member(b, first, "enter_with_grants"); enc_ptr_EnterWithGrants(b, y.enter_with_grants) }
	if !(y.controller_override == nil) { member(b, first, "controller_override"); enc_opt_PlayerId(b, y.controller_override) }
	member(b, first, "enter_transformed"); encode_bool(b, y.enter_transformed)
	if !(y.face_down_profile == nil) { member(b, first, "face_down_profile"); enc_ptr_FaceDownProfile(b, y.face_down_profile) }
	if !(skip_ProposedEvent_ExileConcealment_is_public_ExileConcealment(y.face_down_in_exile)) { member(b, first, "face_down_in_exile"); encode_ExileConcealment(b, y.face_down_in_exile) }
	if !(skip_ProposedEvent_ChainReferentIntent_is_silent_ChainReferentIntent(y.chain_referent)) { member(b, first, "chain_referent"); encode_ChainReferentIntent(b, y.chain_referent) }
	if !(y.enter_as_copy == nil) { member(b, first, "enter_as_copy"); enc_ptr_CopyTokenSpec(b, y.enter_as_copy) }
	if !(y.enter_with_choices == nil) { member(b, first, "enter_with_choices"); enc_ptr_EntryChoices(b, y.enter_with_choices) }
	if !(y.discard_frame == nil) { member(b, first, "discard_frame"); enc_opt_DiscardFrameId(b, y.discard_frame) }
	if !(y.performed_by == nil) { member(b, first, "performed_by"); enc_opt_PlayerId(b, y.performed_by) }
	if !(y.with_entry_effect == nil) { member(b, first, "with_entry_effect"); enc_ptr_WithEntryEffect(b, y.with_entry_effect) }
	if !(y.co_entrants == nil) { member(b, first, "co_entrants"); enc_ptr_CoEntrants(b, y.co_entrants) }
	if !(skip_ProposedEvent_EntryOwnershipActor_is_unrecorded_EntryOwnershipActor(y.ownership_actor)) { member(b, first, "ownership_actor"); encode_EntryOwnershipActor(b, y.ownership_actor) }
	if !(skip_ProposedEvent_LibraryShuffleMode_is_per_object_LibraryShuffleMode(y.library_shuffle)) { member(b, first, "library_shuffle"); encode_LibraryShuffleMode(b, y.library_shuffle) }
	if !(y.merged_departure == nil) { member(b, first, "merged_departure"); enc_opt_ObjectIncarnationRef(b, y.merged_departure) }
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_Damage: strings.write_byte(b, '{'); json.write_string(b, "Damage"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "target"); encode_TargetRef(b, y.target)
	member(b, first, "amount"); encode_u32(b, y.amount)
	member(b, first, "is_combat"); encode_bool(b, y.is_combat)
	if !(y.source_name == nil) { member(b, first, "source_name"); enc_opt_string(b, y.source_name) }
	if !(y.source_incarnation == nil) { member(b, first, "source_incarnation"); enc_opt_u64(b, y.source_incarnation) }
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_Draw: strings.write_byte(b, '{'); json.write_string(b, "Draw"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "count"); encode_u32(b, y.count)
	if !(skip_ProposedEvent_DrawEventStage_is_individual_DrawEventStage(y.stage)) { member(b, first, "stage"); encode_DrawEventStage(b, y.stage) }
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_SearchFound: strings.write_byte(b, '{'); json.write_string(b, "SearchFound"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "searcher"); encode_PlayerId(b, y.searcher)
	if !(y.library_owner == nil) { member(b, first, "library_owner"); enc_opt_PlayerId(b, y.library_owner) }
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "disposition"); encode_SearchFoundDisposition(b, y.disposition)
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_Scry: strings.write_byte(b, '{'); json.write_string(b, "Scry"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_Mill: strings.write_byte(b, '{'); json.write_string(b, "Mill"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "destination"); encode_Zone(b, y.destination)
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_CoinFlip: strings.write_byte(b, '{'); json.write_string(b, "CoinFlip"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_RollDice: strings.write_byte(b, '{'); json.write_string(b, "RollDice"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "sides"); encode_u8(b, y.sides)
	if !((len(y.ignore_rules) == 0)) { member(b, first, "ignore_rules"); enc_dyn_DieRollIgnoreRule(b, y.ignore_rules) }
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_Explore: strings.write_byte(b, '{'); json.write_string(b, "Explore"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_Connive: strings.write_byte(b, '{'); json.write_string(b, "Connive"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "subject"); enc_ptr_EventObjectSnapshot(b, y.subject)
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_Proliferate: strings.write_byte(b, '{'); json.write_string(b, "Proliferate"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_LifeGain: strings.write_byte(b, '{'); json.write_string(b, "LifeGain"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "amount"); encode_u32(b, y.amount)
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_LifeLoss: strings.write_byte(b, '{'); json.write_string(b, "LifeLoss"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "amount"); encode_u32(b, y.amount)
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_AddCounter: strings.write_byte(b, '{'); json.write_string(b, "AddCounter"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	encode_CounterPlacement_members(b, y.placement, first)
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_RemoveCounter: strings.write_byte(b, '{'); json.write_string(b, "RemoveCounter"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_MoveCounter: strings.write_byte(b, '{'); json.write_string(b, "MoveCounter"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "actor"); encode_PlayerId(b, y.actor)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "destination_id"); encode_ObjectId(b, y.destination_id)
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	member(b, first, "remove_count"); encode_u32(b, y.remove_count)
	member(b, first, "add_count"); encode_u32(b, y.add_count)
	member(b, first, "stage"); encode_CounterMoveStage(b, y.stage)
	member(b, first, "cause"); encode_CounterCause(b, y.cause)
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, y.applied)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ProposedEvent_CreateToken: strings.write_byte(b, '{'); json.write_string(b, "CreateToken"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "owner"); encode_PlayerId(b, y.owner)
	member(b, first, "spec"); enc_ptr_TokenSpec(b, y.spec)
	if !(y.copy == nil) { member(b, first, "copy"); enc_ptr_CopyTokenSpec(b, y.copy) }
	member(b, first, "enter_tapped"); encode_EtbTapState(b, y.enter_tapped)
	member(b, first, "count"); encode_u32(b, y.count)
