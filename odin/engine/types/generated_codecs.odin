	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("ManaProduction::AnyOneColorAmongPermanents.count") } else { out.count = default_ManaProduction_default_quantity_one() }
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("ManaProduction::AnyOneColorAmongPermanents.filter") } else { return fail("ManaProduction::AnyOneColorAmongPermanents.filter missing") }
	if fv, found := get_any(v, "contribution"); found { if !decode_ManaContribution(fv, &out.contribution) do return fail("ManaProduction::AnyOneColorAmongPermanents.contribution") } else { out.contribution = default_ManaProduction_default_mana_contribution() }
	return true
		}) { return fail("ManaProduction::AnyOneColorAmongPermanents") }
		out^ = tmp
	case "TriggerEventManaType": when COVERAGE do cov_hit("ManaProduction::TriggerEventManaType"); out^ = ManaProduction_TriggerEventManaType{}
