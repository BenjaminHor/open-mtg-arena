decode_EtbTapState :: proc(v: json.Value, out: ^EtbTapState) -> bool {
	when COVERAGE do cov_hit("EtbTapState")
	if v.kind != .String do return fail("EtbTapState: not a string")
	str := v.text
	switch str {
	case "Unspecified": when COVERAGE do cov_hit("EtbTapState::Unspecified"); out^ = .Unspecified
	case "Tapped": when COVERAGE do cov_hit("EtbTapState::Tapped"); out^ = .Tapped
	case "Untapped": when COVERAGE do cov_hit("EtbTapState::Untapped"); out^ = .Untapped
	case: return fail("EtbTapState: unknown variant")
	}
	return true
}

encode_EtbTapState :: proc(b: ^strings.Builder, x: EtbTapState) {
	@(static, rodata) NAMES := [EtbTapState]string{
		.Unspecified = "Unspecified",
		.Tapped = "Tapped",
		.Untapped = "Untapped",
	}
	json.write_string(b, NAMES[x])
}

