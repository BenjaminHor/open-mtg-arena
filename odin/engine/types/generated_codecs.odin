	if fv, found := get_any(v, "kinds"); found { if !dec_dyn_CounterType(fv, &out.kinds) do return fail("CounterKindDomain::Printed.kinds") } else { return fail("CounterKindDomain::Printed.kinds missing") }
	if fv, found := get_any(v, "excluding_kinds_on_target"); found { if !decode_bool(fv, &out.excluding_kinds_on_target) do return fail("CounterKindDomain::Printed.excluding_kinds_on_target") }
	return true
		}) { return fail("CounterKindDomain::Printed") }
		out^ = tmp
	case: return fail("CounterKindDomain: unknown variant")
	}
	return true
}

encode_CounterKindDomain :: proc(b: ^strings.Builder, x: CounterKindDomain) {
	#partial switch y in x {
	case CounterKindDomain_OnTarget: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OnTarget"); strings.write_byte(b, '}')
	case CounterKindDomain_Printed: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Printed")
	member(b, first, "kinds"); enc_dyn_CounterType(b, y.kinds)
	member(b, first, "excluding_kinds_on_target"); encode_bool(b, y.excluding_kinds_on_target)
	}; strings.write_byte(b, '}')
	}
}

encode_CounterKindDomain_members :: proc(b: ^strings.Builder, x: CounterKindDomain, first: ^bool) {
	#partial switch y in x {
	case CounterKindDomain_OnTarget: _ = y; member(b, first, "type"); json.write_string(b, "OnTarget")
	case CounterKindDomain_Printed: member(b, first, "type"); json.write_string(b, "Printed")
	member(b, first, "kinds"); enc_dyn_CounterType(b, y.kinds)
	member(b, first, "excluding_kinds_on_target"); encode_bool(b, y.excluding_kinds_on_target)

	}
}

decode_CounterKindChooser :: proc(v: json.Value, out: ^CounterKindChooser) -> bool {
	when COVERAGE do cov_hit("CounterKindChooser")
	if v.kind != .Object do return fail("CounterKindChooser: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("CounterKindChooser: no tag")
	str := tv.text
	switch str {
	case "Controller": when COVERAGE do cov_hit("CounterKindChooser::Controller"); out^ = .Controller
	case "Random": when COVERAGE do cov_hit("CounterKindChooser::Random"); out^ = .Random
	case: return fail("CounterKindChooser: unknown variant")
	}
	return true
}

encode_CounterKindChooser :: proc(b: ^strings.Builder, x: CounterKindChooser) {
	strings.write_byte(b, '{')
	f := true
	encode_CounterKindChooser_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CounterKindChooser_members :: proc(b: ^strings.Builder, x: CounterKindChooser, first: ^bool) {
	_ = x
	@(static, rodata) NAMES := [CounterKindChooser]string{
		.Controller = "Controller",
		.Random = "Random",
	}
	member(b, first, "type"); json.write_string(b, NAMES[x])
}

