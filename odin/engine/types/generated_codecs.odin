	member(b, first, "viewer"); encode_PlayerId(b, x.viewer)
	member(b, first, "owner"); encode_PlayerId(b, x.owner)
	member(b, first, "zone"); encode_Zone(b, x.zone)
	member(b, first, "identity"); encode_ObjectIncarnationRef(b, x.identity)
	if !(x.library_epoch == nil) { member(b, first, "library_epoch"); enc_opt_u64(b, x.library_epoch) }
}

