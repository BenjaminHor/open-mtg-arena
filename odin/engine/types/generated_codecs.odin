	str := tv.text
	switch str {
	case "Optional": out^ = .Optional
	case "OpponentMay": out^ = .OpponentMay
	case "Condition": out^ = .Condition
	case "RepeatFor": out^ = .RepeatFor
	case "PlayerScope": out^ = .PlayerScope
	case "Duration": out^ = .Duration
	case: return fail("CascadeSlot: unknown variant")
	}
	return true
}

encode_CascadeSlot :: proc(b: ^strings.Builder, x: CascadeSlot) {
	strings.write_byte(b, '{')
	f := true
	encode_CascadeSlot_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CascadeSlot_members :: proc(b: ^strings.Builder, x: CascadeSlot, first: ^bool) {
	_ = x
	@(static, rodata) NAMES := [CascadeSlot]string{
		.Optional = "Optional",
		.OpponentMay = "OpponentMay",
		.Condition = "Condition",
		.RepeatFor = "RepeatFor",
		.PlayerScope = "PlayerScope",
		.Duration = "Duration",
	}
	member(b, first, "type"); json.write_string(b, NAMES[x])
}

