decode_ZoneDeliveryExileTracking :: proc(v: json.Value, out: ^ZoneDeliveryExileTracking) -> bool {
	when COVERAGE do cov_hit("ZoneDeliveryExileTracking")
	if v.kind != .String do return fail("ZoneDeliveryExileTracking: not a string")
	str := v.text
	switch str {
	case "None": when COVERAGE do cov_hit("ZoneDeliveryExileTracking::None"); out^ = .None
	case "TrackBySource": when COVERAGE do cov_hit("ZoneDeliveryExileTracking::TrackBySource"); out^ = .TrackBySource
	case: return fail("ZoneDeliveryExileTracking: unknown variant")
	}
	return true
}

