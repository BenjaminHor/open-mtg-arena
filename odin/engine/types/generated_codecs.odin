	if fv, found := get_any(v, "settled"); found { if !dec_opt_ChangeZoneSettled(fv, &out.settled) do return fail("BatchCompletion::ChangeZonePopulationSettled.settled") }
	return true
		}) { return fail("BatchCompletion::ChangeZonePopulationSettled") }
		out^ = tmp
	case: return fail("BatchCompletion: unknown variant")
	}
	return true
}

encode_BatchCompletion :: proc(b: ^strings.Builder, x: BatchCompletion) {
	#partial switch y in x {
	case BatchCompletion_RecordInstructionZoneResult: strings.write_byte(b, '{'); json.write_string(b, "RecordInstructionZoneResult"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "occurrence_id"); encode_ReturnResultOccurrenceId(b, y.occurrence_id)
	member(b, first, "result_id"); encode_ReturnResultId(b, y.result_id)
	member(b, first, "settled_records"); enc_opt_dyn_ZoneChangeRecord(b, y.settled_records)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case BatchCompletion_ReturnAsAuraNoTargetComplete: strings.write_byte(b, '{'); json.write_string(b, "ReturnAsAuraNoTargetComplete"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case BatchCompletion_ExploreLandDeliveryComplete: strings.write_byte(b, '{'); json.write_string(b, "ExploreLandDeliveryComplete"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "explorer_id"); encode_ObjectId(b, y.explorer_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case BatchCompletion_CloakExileDeliveryComplete: strings.write_byte(b, '{'); json.write_string(b, "CloakExileDeliveryComplete"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "members"); enc_dyn_CloakExileMember(b, y.members)
	member(b, first, "enters_under"); enc_opt_PlayerId(b, y.enters_under)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case BatchCompletion_ExileFaceDownPileDeliveryComplete: strings.write_byte(b, '{'); json.write_string(b, "ExileFaceDownPileDeliveryComplete"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "members"); enc_dyn_ObjectId(b, y.members)
	member(b, first, "required_member_count"); encode_int(b, y.required_member_count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case BatchCompletion_ExileFaceDownPileReturnComplete: strings.write_byte(b, '{'); json.write_string(b, "ExileFaceDownPileReturnComplete"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case BatchCompletion_CastFromZoneExileDeliveryComplete: strings.write_byte(b, '{'); json.write_string(b, "CastFromZoneExileDeliveryComplete"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "ability"); enc_ptr_ResolvedAbility(b, y.ability)
