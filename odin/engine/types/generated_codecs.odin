	switch str {
	case "Ordinary": when COVERAGE do cov_hit("DelayedTriggerKind::Ordinary"); out^ = .Ordinary
	case "Boon": when COVERAGE do cov_hit("DelayedTriggerKind::Boon"); out^ = .Boon
	case: return fail("DelayedTriggerKind: unknown variant")
