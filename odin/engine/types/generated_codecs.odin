	case DebugAction_Attach: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Attach"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "target"); encode_AttachTarget(b, y.target)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_Detach: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Detach"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_GrantKeyword: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "GrantKeyword"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)
