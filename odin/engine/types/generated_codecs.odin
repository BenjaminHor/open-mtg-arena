decode_StackEntry :: proc(v: json.Value, out: ^StackEntry) -> bool {
	when COVERAGE do cov_hit("StackEntry")
	if v.kind != .Object do return fail("StackEntry: not an object")
	if fv, found := get_any(v, "id"); found { if !decode_ObjectId(fv, &out.id) do return fail("StackEntry.id") } else { return fail("StackEntry.id missing") }
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("StackEntry.source_id") } else { return fail("StackEntry.source_id missing") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("StackEntry.controller") } else { return fail("StackEntry.controller missing") }
	if fv, found := get_any(v, "kind"); found { if !decode_StackEntryKind(fv, &out.kind) do return fail("StackEntry.kind") } else { return fail("StackEntry.kind missing") }
	return true
}

encode_StackEntry :: proc(b: ^strings.Builder, x: StackEntry) {
	strings.write_byte(b, '{')
	f := true
	encode_StackEntry_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_StackEntry_members :: proc(b: ^strings.Builder, x: StackEntry, first: ^bool) {
	member(b, first, "id"); encode_ObjectId(b, x.id)
	member(b, first, "source_id"); encode_ObjectId(b, x.source_id)
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	member(b, first, "kind"); encode_StackEntryKind(b, x.kind)
}

decode_StackPaidSnapshot :: proc(v: json.Value, out: ^StackPaidSnapshot) -> bool {
	when COVERAGE do cov_hit("StackPaidSnapshot")
	if v.kind != .Object do return fail("StackPaidSnapshot: not an object")
	if fv, found := get_any(v, "actual_mana_spent"); found { if !decode_u32(fv, &out.actual_mana_spent) do return fail("StackPaidSnapshot.actual_mana_spent") }
	if fv, found := get_any(v, "x_value"); found { if !dec_opt_u32(fv, &out.x_value) do return fail("StackPaidSnapshot.x_value") }
	if fv, found := get_any(v, "distinct_colors_spent"); found { if !decode_u32(fv, &out.distinct_colors_spent) do return fail("StackPaidSnapshot.distinct_colors_spent") }
	if fv, found := get_any(v, "kickers_paid"); found { if !decode_int(fv, &out.kickers_paid) do return fail("StackPaidSnapshot.kickers_paid") }
	if fv, found := get_any(v, "additional_cost_payment_count"); found { if !decode_u32(fv, &out.additional_cost_payment_count) do return fail("StackPaidSnapshot.additional_cost_payment_count") }
	if fv, found := get_any(v, "additional_cost_payments"); found { if !dec_dyn_AdditionalCostInstancePayment(fv, &out.additional_cost_payments) do return fail("StackPaidSnapshot.additional_cost_payments") }
	if fv, found := get_any(v, "additional_cost_paid"); found { if !decode_bool(fv, &out.additional_cost_paid) do return fail("StackPaidSnapshot.additional_cost_paid") }
	if fv, found := get_any(v, "casting_variant"); found { if !decode_CastingVariant(fv, &out.casting_variant) do return fail("StackPaidSnapshot.casting_variant") } else { out.casting_variant = CastingVariant(CastingVariant_Normal{}) }
	if fv, found := get_any(v, "cast_transformed"); found { if !decode_bool(fv, &out.cast_transformed) do return fail("StackPaidSnapshot.cast_transformed") }
	if fv, found := get_any(v, "convoked_creatures"); found { if !decode_int(fv, &out.convoked_creatures) do return fail("StackPaidSnapshot.convoked_creatures") }
	return true
}

encode_StackPaidSnapshot :: proc(b: ^strings.Builder, x: StackPaidSnapshot) {
	strings.write_byte(b, '{')
	f := true
	encode_StackPaidSnapshot_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_StackPaidSnapshot_members :: proc(b: ^strings.Builder, x: StackPaidSnapshot, first: ^bool) {
	if !(x.actual_mana_spent == 0) { member(b, first, "actual_mana_spent"); encode_u32(b, x.actual_mana_spent) }
	if !(x.x_value == nil) { member(b, first, "x_value"); enc_opt_u32(b, x.x_value) }
	if !(x.distinct_colors_spent == 0) { member(b, first, "distinct_colors_spent"); encode_u32(b, x.distinct_colors_spent) }
	if !(x.kickers_paid == 0) { member(b, first, "kickers_paid"); encode_int(b, x.kickers_paid) }
	if !(x.additional_cost_payment_count == 0) { member(b, first, "additional_cost_payment_count"); encode_u32(b, x.additional_cost_payment_count) }
	if !((len(x.additional_cost_payments) == 0)) { member(b, first, "additional_cost_payments"); enc_dyn_AdditionalCostInstancePayment(b, x.additional_cost_payments) }
	if !(!x.additional_cost_paid) { member(b, first, "additional_cost_paid"); encode_bool(b, x.additional_cost_paid) }
	if !(skip_StackPaidSnapshot_CastingVariant_is_normal_CastingVariant(x.casting_variant)) { member(b, first, "casting_variant"); encode_CastingVariant(b, x.casting_variant) }
	if !(!x.cast_transformed) { member(b, first, "cast_transformed"); encode_bool(b, x.cast_transformed) }
	if !(x.convoked_creatures == 0) { member(b, first, "convoked_creatures"); encode_int(b, x.convoked_creatures) }
}

