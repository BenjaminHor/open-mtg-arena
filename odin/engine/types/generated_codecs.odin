decode_ScheduledTurnControl :: proc(v: json.Value, out: ^ScheduledTurnControl) -> bool {
	when COVERAGE do cov_hit("ScheduledTurnControl")
	if v.kind != .Object do return fail("ScheduledTurnControl: not an object")
	if fv, found := get_any(v, "target_player"); found { if !decode_PlayerId(fv, &out.target_player) do return fail("ScheduledTurnControl.target_player") } else { return fail("ScheduledTurnControl.target_player missing") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("ScheduledTurnControl.controller") } else { return fail("ScheduledTurnControl.controller missing") }
