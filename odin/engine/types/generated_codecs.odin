	case "Unknown": when COVERAGE do cov_hit("BoundActivationCost::Unknown"); out^ = BoundActivationCost_Unknown{}
	case "Costless": when COVERAGE do cov_hit("BoundActivationCost::Costless"); out^ = BoundActivationCost_Costless{}
	case "Cost": when COVERAGE do cov_hit("BoundActivationCost::Cost"); tmp: BoundActivationCost_Cost; if !dec_ptr_AbilityCost(body, &tmp._0) do return fail("BoundActivationCost::Cost"); out^ = tmp
	case: return fail("BoundActivationCost: unknown variant")
	}
	return true
}

encode_BoundActivationCost :: proc(b: ^strings.Builder, x: BoundActivationCost) {
	#partial switch y in x {
	case BoundActivationCost_Unknown: _ = y; json.write_string(b, "Unknown")
	case BoundActivationCost_Costless: _ = y; json.write_string(b, "Costless")
	case BoundActivationCost_Cost: strings.write_byte(b, '{'); json.write_string(b, "Cost"); strings.write_byte(b, ':'); enc_ptr_AbilityCost(b, y._0); strings.write_byte(b, '}')
	}
}

