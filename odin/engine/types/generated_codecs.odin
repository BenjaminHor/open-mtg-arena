	case "ColorlessWhite": when COVERAGE do cov_hit("ManaCostShard::ColorlessWhite"); out^ = .ColorlessWhite
	case "ColorlessBlue": when COVERAGE do cov_hit("ManaCostShard::ColorlessBlue"); out^ = .ColorlessBlue
	case "ColorlessBlack": when COVERAGE do cov_hit("ManaCostShard::ColorlessBlack"); out^ = .ColorlessBlack
	case "ColorlessRed": when COVERAGE do cov_hit("ManaCostShard::ColorlessRed"); out^ = .ColorlessRed
	case "ColorlessGreen": when COVERAGE do cov_hit("ManaCostShard::ColorlessGreen"); out^ = .ColorlessGreen
	case: return fail("ManaCostShard: unknown variant")
	}
	return true
}

encode_ManaCostShard :: proc(b: ^strings.Builder, x: ManaCostShard) {
	@(static, rodata) NAMES := [ManaCostShard]string{
		.White = "White",
