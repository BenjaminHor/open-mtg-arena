		tmp: AbilityCost_Discard
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_Discard) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("AbilityCost::Discard.count") } else { out.count = default_AbilityCost_default_quantity_one() }
	if fv, found := get_any(v, "filter"); found { if !dec_opt_TargetFilter(fv, &out.filter) do return fail("AbilityCost::Discard.filter") }
	if fv, found := get_any(v, "random"); found { if !decode_with_card_selection_bool_compat(fv, &out.selection) do return fail("AbilityCost::Discard.selection") }
	if fv, found := get_any(v, "self_ref"); found { if !decode_with_discard_self_scope_bool_compat(fv, &out.self_scope) do return fail("AbilityCost::Discard.self_scope") }
	return true
		}) { return fail("AbilityCost::Discard") }
		out^ = tmp
	case "Exile": when COVERAGE do cov_hit("AbilityCost::Exile");
		tmp: AbilityCost_Exile
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_Exile) -> bool {
