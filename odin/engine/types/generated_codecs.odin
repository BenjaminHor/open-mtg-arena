decode_CoreType :: proc(v: json.Value, out: ^CoreType) -> bool {
	when COVERAGE do cov_hit("CoreType")
	if v.kind != .String do return fail("CoreType: not a string")
	str := v.text
	switch str {
	case "Artifact": when COVERAGE do cov_hit("CoreType::Artifact"); out^ = .Artifact
	case "Creature": when COVERAGE do cov_hit("CoreType::Creature"); out^ = .Creature
	case "Enchantment": when COVERAGE do cov_hit("CoreType::Enchantment"); out^ = .Enchantment
	case "Instant": when COVERAGE do cov_hit("CoreType::Instant"); out^ = .Instant
	case "Land": when COVERAGE do cov_hit("CoreType::Land"); out^ = .Land
	case "Planeswalker": when COVERAGE do cov_hit("CoreType::Planeswalker"); out^ = .Planeswalker
	case "Sorcery": when COVERAGE do cov_hit("CoreType::Sorcery"); out^ = .Sorcery
	case "Tribal": when COVERAGE do cov_hit("CoreType::Tribal"); out^ = .Tribal
	case "Battle": when COVERAGE do cov_hit("CoreType::Battle"); out^ = .Battle
	case "Kindred": when COVERAGE do cov_hit("CoreType::Kindred"); out^ = .Kindred
	case "Dungeon": when COVERAGE do cov_hit("CoreType::Dungeon"); out^ = .Dungeon
	case "Plane": when COVERAGE do cov_hit("CoreType::Plane"); out^ = .Plane
	case "Phenomenon": when COVERAGE do cov_hit("CoreType::Phenomenon"); out^ = .Phenomenon
	case "Scheme": when COVERAGE do cov_hit("CoreType::Scheme"); out^ = .Scheme
	case "Conspiracy": when COVERAGE do cov_hit("CoreType::Conspiracy"); out^ = .Conspiracy
	case "Boss": when COVERAGE do cov_hit("CoreType::Boss"); out^ = .Boss
	case "Event": when COVERAGE do cov_hit("CoreType::Event"); out^ = .Event
	case "Vanguard": when COVERAGE do cov_hit("CoreType::Vanguard"); out^ = .Vanguard
	case: return fail("CoreType: unknown variant")
	}
	return true
}

encode_CoreType :: proc(b: ^strings.Builder, x: CoreType) {
	@(static, rodata) NAMES := [CoreType]string{
		.Artifact = "Artifact",
		.Creature = "Creature",
		.Enchantment = "Enchantment",
		.Instant = "Instant",
		.Land = "Land",
		.Planeswalker = "Planeswalker",
		.Sorcery = "Sorcery",
		.Tribal = "Tribal",
		.Battle = "Battle",
		.Kindred = "Kindred",
		.Dungeon = "Dungeon",
		.Plane = "Plane",
		.Phenomenon = "Phenomenon",
		.Scheme = "Scheme",
		.Conspiracy = "Conspiracy",
		.Boss = "Boss",
		.Event = "Event",
		.Vanguard = "Vanguard",
	}
	json.write_string(b, NAMES[x])
}

decode_AbilityActivationRecord :: proc(v: json.Value, out: ^AbilityActivationRecord) -> bool {
	when COVERAGE do cov_hit("AbilityActivationRecord")
	if v.kind != .Object do return fail("AbilityActivationRecord: not an object")
	if fv, found := get_any(v, "activator"); found { if !decode_PlayerId(fv, &out.activator) do return fail("AbilityActivationRecord.activator") } else { return fail("AbilityActivationRecord.activator missing") }
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("AbilityActivationRecord.source") } else { return fail("AbilityActivationRecord.source missing") }
	if fv, found := get_any(v, "source_lki"); found { if !decode_LKISnapshot(fv, &out.source_lki) do return fail("AbilityActivationRecord.source_lki") } else { return fail("AbilityActivationRecord.source_lki missing") }
	if fv, found := get_any(v, "source_zone"); found { if !decode_Zone(fv, &out.source_zone) do return fail("AbilityActivationRecord.source_zone") } else { out.source_zone = default_AbilityActivationRecord_battlefield_zone() }
	if fv, found := get_any(v, "ability_tag"); found { if !dec_opt_AbilityTag(fv, &out.ability_tag) do return fail("AbilityActivationRecord.ability_tag") }
	if fv, found := get_any(v, "is_loyalty_ability"); found { if !decode_bool(fv, &out.is_loyalty_ability) do return fail("AbilityActivationRecord.is_loyalty_ability") }
	if fv, found := get_any(v, "activation_cost"); found { if !decode_BoundActivationCost(fv, &out.activation_cost) do return fail("AbilityActivationRecord.activation_cost") } else { out.activation_cost = BoundActivationCost(BoundActivationCost_Unknown{}) }
	if fv, found := get_any(v, "targets"); found { if !dec_dyn_ActivationTargetFact(fv, &out.targets) do return fail("AbilityActivationRecord.targets") }
	return true
}

encode_AbilityActivationRecord :: proc(b: ^strings.Builder, x: AbilityActivationRecord) {
	strings.write_byte(b, '{')
	f := true
	encode_AbilityActivationRecord_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_AbilityActivationRecord_members :: proc(b: ^strings.Builder, x: AbilityActivationRecord, first: ^bool) {
	member(b, first, "activator"); encode_PlayerId(b, x.activator)
	member(b, first, "source"); encode_ObjectId(b, x.source)
	member(b, first, "source_lki"); encode_LKISnapshot(b, x.source_lki)
	if !(skip_AbilityActivationRecord_is_battlefield_zone_Zone(x.source_zone)) { member(b, first, "source_zone"); encode_Zone(b, x.source_zone) }
	if !(x.ability_tag == nil) { member(b, first, "ability_tag"); enc_opt_AbilityTag(b, x.ability_tag) }
	if !(!x.is_loyalty_ability) { member(b, first, "is_loyalty_ability"); encode_bool(b, x.is_loyalty_ability) }
	if !(skip_AbilityActivationRecord_BoundActivationCost_is_unknown_BoundActivationCost(x.activation_cost)) { member(b, first, "activation_cost"); encode_BoundActivationCost(b, x.activation_cost) }
	if !((len(x.targets) == 0)) { member(b, first, "targets"); enc_dyn_ActivationTargetFact(b, x.targets) }
}

