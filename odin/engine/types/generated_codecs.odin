	if fv, found := get_any(v, "scope"); found { if !decode_ObjectScope(fv, &out.scope) do return fail("ManaProduction::AnyCombinationOfObjectColors.scope") } else { return fail("ManaProduction::AnyCombinationOfObjectColors.scope missing") }
	return true
		}) { return fail("ManaProduction::AnyCombinationOfObjectColors") }
		out^ = tmp
	case "AnyTypeProduceableBy": when COVERAGE do cov_hit("ManaProduction::AnyTypeProduceableBy");
		tmp: ManaProduction_AnyTypeProduceableBy
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ManaProduction_AnyTypeProduceableBy) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("ManaProduction::AnyTypeProduceableBy.count") } else { out.count = default_ManaProduction_default_quantity_one() }
	if fv, found := get_any(v, "land_filter"); found { if !decode_TargetFilter(fv, &out.land_filter) do return fail("ManaProduction::AnyTypeProduceableBy.land_filter") } else { return fail("ManaProduction::AnyTypeProduceableBy.land_filter missing") }
	return true
		}) { return fail("ManaProduction::AnyTypeProduceableBy") }
		out^ = tmp
	case "ChoiceAmongExiledColors": when COVERAGE do cov_hit("ManaProduction::ChoiceAmongExiledColors");
