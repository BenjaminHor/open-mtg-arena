decode_LibrarySearchDeliveryResume :: proc(v: json.Value, out: ^LibrarySearchDeliveryResume) -> bool {
	when COVERAGE do cov_hit("LibrarySearchDeliveryResume")
	if v.kind != .Object do return fail("LibrarySearchDeliveryResume: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("LibrarySearchDeliveryResume: no tag")
	switch tv.text {
	case "standard": when COVERAGE do cov_hit("LibrarySearchDeliveryResume::standard");
		tmp: LibrarySearchDeliveryResume_Standard
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^LibrarySearchDeliveryResume_Standard) -> bool {
	if fv, found := get_any(v, "searcher"); found { if !decode_PlayerId(fv, &out.searcher) do return fail("LibrarySearchDeliveryResume::Standard.searcher") } else { return fail("LibrarySearchDeliveryResume::Standard.searcher missing") }
	if fv, found := get_any(v, "hidden_search_audiences"); found { if !dec_dyn_HiddenSearchAudience(fv, &out.hidden_search_audiences) do return fail("LibrarySearchDeliveryResume::Standard.hidden_search_audiences") }
	return true
		}) { return fail("LibrarySearchDeliveryResume::Standard") }
		out^ = tmp
	case "scoped": when COVERAGE do cov_hit("LibrarySearchDeliveryResume::scoped");
		tmp: LibrarySearchDeliveryResume_Scoped
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^LibrarySearchDeliveryResume_Scoped) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("LibrarySearchDeliveryResume::Scoped.player") } else { return fail("LibrarySearchDeliveryResume::Scoped.player missing") }
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("LibrarySearchDeliveryResume::Scoped.source_id") } else { return fail("LibrarySearchDeliveryResume::Scoped.source_id missing") }
	if fv, found := get_any(v, "search_keys"); found { if !dec_dyn_PlayerId(fv, &out.search_keys) do return fail("LibrarySearchDeliveryResume::Scoped.search_keys") } else { return fail("LibrarySearchDeliveryResume::Scoped.search_keys missing") }
	if fv, found := get_any(v, "grants"); found { if !dec_dyn_t2_ObjectIncarnationRef_BoundSearchFoundGrant(fv, &out.grants) do return fail("LibrarySearchDeliveryResume::Scoped.grants") }
	if fv, found := get_any(v, "after_scope"); found { if !dec_ptr_ResolvedAbility(fv, &out.after_scope) do return fail("LibrarySearchDeliveryResume::Scoped.after_scope") }
	return true
		}) { return fail("LibrarySearchDeliveryResume::Scoped") }
		out^ = tmp
	case: return fail("LibrarySearchDeliveryResume: unknown variant")
	}
	return true
}

encode_LibrarySearchDeliveryResume :: proc(b: ^strings.Builder, x: LibrarySearchDeliveryResume) {
	#partial switch y in x {
	case LibrarySearchDeliveryResume_Standard: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "standard")
	member(b, first, "searcher"); encode_PlayerId(b, y.searcher)
	if !((len(y.hidden_search_audiences) == 0)) { member(b, first, "hidden_search_audiences"); enc_dyn_HiddenSearchAudience(b, y.hidden_search_audiences) }
	}; strings.write_byte(b, '}')
	case LibrarySearchDeliveryResume_Scoped: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "scoped")
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "search_keys"); enc_dyn_PlayerId(b, y.search_keys)
	if !((len(y.grants) == 0)) { member(b, first, "grants"); enc_dyn_t2_ObjectIncarnationRef_BoundSearchFoundGrant(b, y.grants) }
	if !(y.after_scope == nil) { member(b, first, "after_scope"); enc_ptr_ResolvedAbility(b, y.after_scope) }
	}; strings.write_byte(b, '}')
	}
}

encode_LibrarySearchDeliveryResume_members :: proc(b: ^strings.Builder, x: LibrarySearchDeliveryResume, first: ^bool) {
	#partial switch y in x {
	case LibrarySearchDeliveryResume_Standard: member(b, first, "type"); json.write_string(b, "standard")
	member(b, first, "searcher"); encode_PlayerId(b, y.searcher)
	if !((len(y.hidden_search_audiences) == 0)) { member(b, first, "hidden_search_audiences"); enc_dyn_HiddenSearchAudience(b, y.hidden_search_audiences) }

	case LibrarySearchDeliveryResume_Scoped: member(b, first, "type"); json.write_string(b, "scoped")
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "search_keys"); enc_dyn_PlayerId(b, y.search_keys)
	if !((len(y.grants) == 0)) { member(b, first, "grants"); enc_dyn_t2_ObjectIncarnationRef_BoundSearchFoundGrant(b, y.grants) }
	if !(y.after_scope == nil) { member(b, first, "after_scope"); enc_ptr_ResolvedAbility(b, y.after_scope) }

	}
}

