	if !decode_PlayerId(v.items[0], &out._0) do return false
	if !decode_u32(v.items[1], &out._1) do return false
	return true
}

dec_PVec_t2_PlayerId_u32 :: proc(v: json.Value, out: ^PVec(Tuple2(PlayerId, u32))) -> bool {
	if v.kind != .Array do return fail("expected an array")
	out^ = {}
	for item in v.items {
		x: Tuple2(PlayerId, u32)
		if !dec_t2_PlayerId_u32(item, &x) do return false
		pvec_push_new(out, x)
	}
	return true
}

dec_map_PlayerId_i32 :: proc(v: json.Value, out: ^map[PlayerId]i32) -> bool {
	if v.kind != .Object do return fail("expected an object (map)")
	out^ = make(map[PlayerId]i32, len(v.members))
	for m in v.members {
		key: PlayerId
		val: i32
		ok_k := decode_PlayerId(json.Value{kind = .Number, text = m.key}, &key)
		if !ok_k || !decode_i32(m.value, &val) do return false
		out[key] = val
	}
	return true
}

