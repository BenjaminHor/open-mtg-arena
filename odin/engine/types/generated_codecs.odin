encode_LearnOption :: proc(b: ^strings.Builder, x: LearnOption) {
	#partial switch y in x {
	case LearnOption_Rummage: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Rummage"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card_id"); encode_ObjectId(b, y.card_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case LearnOption_Skip: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Skip"); strings.write_byte(b, '}')
	}
}

decode_ShardChoice :: proc(v: json.Value, out: ^ShardChoice) -> bool {
	when COVERAGE do cov_hit("ShardChoice")
	if v.kind != .Object do return fail("ShardChoice: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ShardChoice: no tag")
	str := tv.text
	switch str {
	case "PayMana": when COVERAGE do cov_hit("ShardChoice::PayMana"); out^ = .PayMana
	case "PayLife": when COVERAGE do cov_hit("ShardChoice::PayLife"); out^ = .PayLife
	case: return fail("ShardChoice: unknown variant")
	}
	return true
}

encode_ShardChoice :: proc(b: ^strings.Builder, x: ShardChoice) {
	strings.write_byte(b, '{')
	f := true
	encode_ShardChoice_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ShardChoice_members :: proc(b: ^strings.Builder, x: ShardChoice, first: ^bool) {
	_ = x
	@(static, rodata) NAMES := [ShardChoice]string{
		.PayMana = "PayMana",
		.PayLife = "PayLife",
	}
	member(b, first, "type"); json.write_string(b, NAMES[x])
}

decode_ManaChoice :: proc(v: json.Value, out: ^ManaChoice) -> bool {
	when COVERAGE do cov_hit("ManaChoice")
	if v.kind != .Object do return fail("ManaChoice: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ManaChoice: no tag")
	switch tv.text {
	case "SingleColor": when COVERAGE do cov_hit("ManaChoice::SingleColor"); tmp: ManaChoice_SingleColor; if !decode_ManaType(json.get_or_null(v, "data"), &tmp._0) do return fail("ManaChoice::SingleColor"); out^ = tmp
	case "Combination": when COVERAGE do cov_hit("ManaChoice::Combination"); tmp: ManaChoice_Combination; if !dec_dyn_ManaType(json.get_or_null(v, "data"), &tmp._0) do return fail("ManaChoice::Combination"); out^ = tmp
	case: return fail("ManaChoice: unknown variant")
	}
	return true
}

encode_ManaChoice :: proc(b: ^strings.Builder, x: ManaChoice) {
	#partial switch y in x {
	case ManaChoice_SingleColor: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SingleColor"); member(b, &f, "data"); encode_ManaType(b, y._0); strings.write_byte(b, '}')
	case ManaChoice_Combination: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Combination"); member(b, &f, "data"); enc_dyn_ManaType(b, y._0); strings.write_byte(b, '}')
	}
}

decode_DebugAction :: proc(v: json.Value, out: ^DebugAction) -> bool {
	when COVERAGE do cov_hit("DebugAction")
	if v.kind != .Object do return fail("DebugAction: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("DebugAction: no tag")
	switch tv.text {
	case "MoveToZone": when COVERAGE do cov_hit("DebugAction::MoveToZone");
		tmp: DebugAction_MoveToZone
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^DebugAction_MoveToZone) -> bool {
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("DebugAction::MoveToZone.object_id") } else { return fail("DebugAction::MoveToZone.object_id missing") }
	if fv, found := get_any(v, "to_zone"); found { if !decode_Zone(fv, &out.to_zone) do return fail("DebugAction::MoveToZone.to_zone") } else { return fail("DebugAction::MoveToZone.to_zone missing") }
	if fv, found := get_any(v, "library_position"); found { if !dec_opt_LibraryPosition(fv, &out.library_position) do return fail("DebugAction::MoveToZone.library_position") }
	if fv, found := get_any(v, "simulate"); found { if !decode_bool(fv, &out.simulate) do return fail("DebugAction::MoveToZone.simulate") }
	return true
		}) { return fail("DebugAction::MoveToZone") }
		out^ = tmp
	case "CreateCard": when COVERAGE do cov_hit("DebugAction::CreateCard");
		tmp: DebugAction_CreateCard
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^DebugAction_CreateCard) -> bool {
	if fv, found := get_any(v, "card_name"); found { if !decode_string(fv, &out.card_name) do return fail("DebugAction::CreateCard.card_name") } else { return fail("DebugAction::CreateCard.card_name missing") }
	if fv, found := get_any(v, "owner"); found { if !decode_PlayerId(fv, &out.owner) do return fail("DebugAction::CreateCard.owner") } else { return fail("DebugAction::CreateCard.owner missing") }
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("DebugAction::CreateCard.zone") } else { return fail("DebugAction::CreateCard.zone missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("DebugAction::CreateCard.count") } else { out.count = default_DebugAction_default_debug_create_count() }
	if fv, found := get_any(v, "attach_to"); found { if !dec_opt_AttachTarget(fv, &out.attach_to) do return fail("DebugAction::CreateCard.attach_to") }
	if fv, found := get_any(v, "run_etb"); found { if !decode_bool(fv, &out.run_etb) do return fail("DebugAction::CreateCard.run_etb") } else { out.run_etb = default_DebugAction_default_true() }
	if fv, found := get_any(v, "nonlegendary"); found { if !decode_bool(fv, &out.nonlegendary) do return fail("DebugAction::CreateCard.nonlegendary") }
	if fv, found := get_any(v, "creation_kind"); found { if !decode_DebugCardCreationKind(fv, &out.creation_kind) do return fail("DebugAction::CreateCard.creation_kind") }
	return true
		}) { return fail("DebugAction::CreateCard") }
		out^ = tmp
	case "RemoveObject": when COVERAGE do cov_hit("DebugAction::RemoveObject");
		tmp: DebugAction_RemoveObject
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^DebugAction_RemoveObject) -> bool {
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("DebugAction::RemoveObject.object_id") } else { return fail("DebugAction::RemoveObject.object_id missing") }
	return true
		}) { return fail("DebugAction::RemoveObject") }
		out^ = tmp
	case "Sacrifice": when COVERAGE do cov_hit("DebugAction::Sacrifice");
		tmp: DebugAction_Sacrifice
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^DebugAction_Sacrifice) -> bool {
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("DebugAction::Sacrifice.object_id") } else { return fail("DebugAction::Sacrifice.object_id missing") }
	return true
		}) { return fail("DebugAction::Sacrifice") }
		out^ = tmp
	case "DrawCards": when COVERAGE do cov_hit("DebugAction::DrawCards");
		tmp: DebugAction_DrawCards
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^DebugAction_DrawCards) -> bool {
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("DebugAction::DrawCards.player_id") } else { return fail("DebugAction::DrawCards.player_id missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("DebugAction::DrawCards.count") } else { return fail("DebugAction::DrawCards.count missing") }
	return true
