	if v.kind != .Object do return fail("ActivationTargetFact: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ActivationTargetFact: no tag")
	switch tv.text {
	case "Player": when COVERAGE do cov_hit("ActivationTargetFact::Player"); tmp: ActivationTargetFact_Player; if !decode_PlayerId(json.get_or_null(v, "data"), &tmp._0) do return fail("ActivationTargetFact::Player"); out^ = tmp
	case "Object": when COVERAGE do cov_hit("ActivationTargetFact::Object");
		tmp: ActivationTargetFact_Object
