decode_EffectOutcomeSignal :: proc(v: json.Value, out: ^EffectOutcomeSignal) -> bool {
	when COVERAGE do cov_hit("EffectOutcomeSignal")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("EffectOutcomeSignal: externally tagged object needs one key")
