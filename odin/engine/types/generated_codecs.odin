	if fv, found := get_any(v, "counter"); found { if !decode_CounterType(fv, &out.counter) do return fail("HeroEventApplyStep::AddCounters.counter") } else { return fail("HeroEventApplyStep::AddCounters.counter missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("HeroEventApplyStep::AddCounters.count") } else { return fail("HeroEventApplyStep::AddCounters.count missing") }
