	if fv, found := get_any(v, "remaining"); found { if !dec_dyn_PendingCombatLeg(fv, &out.remaining) do return fail("PendingCombatPhaseCRemnant.remaining") } else { return fail("PendingCombatPhaseCRemnant.remaining missing") }
	if fv, found := get_any(v, "lifelink_by_source"); found { if !dec_dyn_t3_ObjectId_PlayerId_u32(fv, &out.lifelink_by_source) do return fail("PendingCombatPhaseCRemnant.lifelink_by_source") } else { return fail("PendingCombatPhaseCRemnant.lifelink_by_source missing") }
	if fv, found := get_any(v, "combat_damage_to_players"); found { if !dec_dyn_t3_PlayerId_dyn_t2_ObjectId_u32_u32(fv, &out.combat_damage_to_players) do return fail("PendingCombatPhaseCRemnant.combat_damage_to_players") } else { return fail("PendingCombatPhaseCRemnant.combat_damage_to_players missing") }
	if fv, found := get_any(v, "source_incarnations"); found { if !dec_dyn_ObjectIncarnationRef(fv, &out.source_incarnations) do return fail("PendingCombatPhaseCRemnant.source_incarnations") } else { return fail("PendingCombatPhaseCRemnant.source_incarnations missing") }
	if fv, found := get_any(v, "staged_gains"); found { if !dec_dyn_PendingLifelinkGain(fv, &out.staged_gains) do return fail("PendingCombatPhaseCRemnant.staged_gains") }
	return true
}

encode_PendingCombatPhaseCRemnant :: proc(b: ^strings.Builder, x: PendingCombatPhaseCRemnant) {
	strings.write_byte(b, '{')
	f := true
	encode_PendingCombatPhaseCRemnant_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PendingCombatPhaseCRemnant_members :: proc(b: ^strings.Builder, x: PendingCombatPhaseCRemnant, first: ^bool) {
	member(b, first, "remaining"); enc_dyn_PendingCombatLeg(b, x.remaining)
	member(b, first, "lifelink_by_source"); enc_dyn_t3_ObjectId_PlayerId_u32(b, x.lifelink_by_source)
	member(b, first, "combat_damage_to_players"); enc_dyn_t3_PlayerId_dyn_t2_ObjectId_u32_u32(b, x.combat_damage_to_players)
	member(b, first, "source_incarnations"); enc_dyn_ObjectIncarnationRef(b, x.source_incarnations)
	if !((len(x.staged_gains) == 0)) { member(b, first, "staged_gains"); enc_dyn_PendingLifelinkGain(b, x.staged_gains) }
}

decode_EntryAttackDestination :: proc(v: json.Value, out: ^EntryAttackDestination) -> bool {
	when COVERAGE do cov_hit("EntryAttackDestination")
	if v.kind != .Object do return fail("EntryAttackDestination: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("EntryAttackDestination: no tag")
	switch tv.text {
	case "AnyDefender": when COVERAGE do cov_hit("EntryAttackDestination::AnyDefender"); out^ = EntryAttackDestination_AnyDefender{}
	case "PlayerOrPlaneswalker": when COVERAGE do cov_hit("EntryAttackDestination::PlayerOrPlaneswalker"); out^ = EntryAttackDestination_PlayerOrPlaneswalker{}
	case "Exact": when COVERAGE do cov_hit("EntryAttackDestination::Exact");
		tmp: EntryAttackDestination_Exact
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^EntryAttackDestination_Exact) -> bool {
	if fv, found := get_any(v, "target"); found { if !decode_AttackTarget(fv, &out.target) do return fail("EntryAttackDestination::Exact.target") } else { return fail("EntryAttackDestination::Exact.target missing") }
	return true
		}) { return fail("EntryAttackDestination::Exact") }
		out^ = tmp
	case: return fail("EntryAttackDestination: unknown variant")
	}
	return true
}

encode_EntryAttackDestination :: proc(b: ^strings.Builder, x: EntryAttackDestination) {
	#partial switch y in x {
	case EntryAttackDestination_AnyDefender: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AnyDefender"); strings.write_byte(b, '}')
	case EntryAttackDestination_PlayerOrPlaneswalker: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PlayerOrPlaneswalker"); strings.write_byte(b, '}')
	case EntryAttackDestination_Exact: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Exact"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "target"); encode_AttackTarget(b, y.target)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_LiminalEntryKind :: proc(v: json.Value, out: ^LiminalEntryKind) -> bool {
	when COVERAGE do cov_hit("LiminalEntryKind")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("LiminalEntryKind: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("LiminalEntryKind: not a string or object")
	}
	switch variant {
	case "Token": when COVERAGE do cov_hit("LiminalEntryKind::Token"); out^ = LiminalEntryKind_Token{}
	case "Meld": when COVERAGE do cov_hit("LiminalEntryKind::Meld");
		tmp: LiminalEntryKind_Meld
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^LiminalEntryKind_Meld) -> bool {
	if fv, found := get_any(v, "context"); found { if !decode_MeldSelection(fv, &out.context_) do return fail("LiminalEntryKind::Meld.context") } else { return fail("LiminalEntryKind::Meld.context missing") }
	if fv, found := get_any(v, "attack_target"); found { if !dec_opt_AttackTarget(fv, &out.attack_target) do return fail("LiminalEntryKind::Meld.attack_target") }
	return true
		}) { return fail("LiminalEntryKind::Meld") }
		out^ = tmp
	case "TransformedEntry": when COVERAGE do cov_hit("LiminalEntryKind::TransformedEntry"); out^ = LiminalEntryKind_TransformedEntry{}
	case: return fail("LiminalEntryKind: unknown variant")
	}
	return true
}

encode_LiminalEntryKind :: proc(b: ^strings.Builder, x: LiminalEntryKind) {
	#partial switch y in x {
	case LiminalEntryKind_Token: _ = y; json.write_string(b, "Token")
	case LiminalEntryKind_Meld: strings.write_byte(b, '{'); json.write_string(b, "Meld"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "context"); encode_MeldSelection(b, y.context_)
	if !(y.attack_target == nil) { member(b, first, "attack_target"); enc_opt_AttackTarget(b, y.attack_target) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case LiminalEntryKind_TransformedEntry: _ = y; json.write_string(b, "TransformedEntry")
	}
}

decode_TokenCopySettlement :: proc(v: json.Value, out: ^TokenCopySettlement) -> bool {
	when COVERAGE do cov_hit("TokenCopySettlement")
	if v.kind != .Object do return fail("TokenCopySettlement: not an object")
	if fv, found := get_any(v, "target_id"); found { if !decode_ObjectId(fv, &out.target_id) do return fail("TokenCopySettlement.target_id") } else { return fail("TokenCopySettlement.target_id missing") }
	if fv, found := get_any(v, "ability"); found { if !decode_ResolvedAbility(fv, &out.ability) do return fail("TokenCopySettlement.ability") } else { return fail("TokenCopySettlement.ability missing") }
	if fv, found := get_any(v, "held_exceptions"); found { if !dec_dyn_ContinuousModification(fv, &out.held_exceptions) do return fail("TokenCopySettlement.held_exceptions") } else { return fail("TokenCopySettlement.held_exceptions missing") }
	if fv, found := get_any(v, "original"); found { if !decode_LiminalEntrant(fv, &out.original) do return fail("TokenCopySettlement.original") } else { return fail("TokenCopySettlement.original missing") }
	if fv, found := get_any(v, "copy_values"); found { if !dec_ptr_CopiableValues(fv, &out.copy_values) do return fail("TokenCopySettlement.copy_values") } else { return fail("TokenCopySettlement.copy_values missing") }
	if fv, found := get_any(v, "copy_display"); found { if !decode_DisplayIdentity(fv, &out.copy_display) do return fail("TokenCopySettlement.copy_display") } else { return fail("TokenCopySettlement.copy_display missing") }
	if fv, found := get_any(v, "copy_incarnation"); found { if !decode_ObjectIncarnationRef(fv, &out.copy_incarnation) do return fail("TokenCopySettlement.copy_incarnation") } else { return fail("TokenCopySettlement.copy_incarnation missing") }
	if fv, found := get_any(v, "staged_name"); found { if !decode_string(fv, &out.staged_name) do return fail("TokenCopySettlement.staged_name") } else { return fail("TokenCopySettlement.staged_name missing") }
	if fv, found := get_any(v, "superseded_replacements"); found { if !dec_opt_int(fv, &out.superseded_replacements) do return fail("TokenCopySettlement.superseded_replacements") }
	return true
}

encode_TokenCopySettlement :: proc(b: ^strings.Builder, x: TokenCopySettlement) {
	strings.write_byte(b, '{')
	f := true
	encode_TokenCopySettlement_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_TokenCopySettlement_members :: proc(b: ^strings.Builder, x: TokenCopySettlement, first: ^bool) {
	member(b, first, "target_id"); encode_ObjectId(b, x.target_id)
	member(b, first, "ability"); encode_ResolvedAbility(b, x.ability)
	member(b, first, "held_exceptions"); enc_dyn_ContinuousModification(b, x.held_exceptions)
	member(b, first, "original"); encode_LiminalEntrant(b, x.original)
	member(b, first, "copy_values"); enc_ptr_CopiableValues(b, x.copy_values)
	member(b, first, "copy_display"); encode_DisplayIdentity(b, x.copy_display)
	member(b, first, "copy_incarnation"); encode_ObjectIncarnationRef(b, x.copy_incarnation)
	member(b, first, "staged_name"); encode_string(b, x.staged_name)
	member(b, first, "superseded_replacements"); enc_opt_int(b, x.superseded_replacements)
}

decode_FaceDownCause :: proc(v: json.Value, out: ^FaceDownCause) -> bool {
	when COVERAGE do cov_hit("FaceDownCause")
	if v.kind != .String do return fail("FaceDownCause: not a string")
	str := v.text
	switch str {
	case "Manifest": when COVERAGE do cov_hit("FaceDownCause::Manifest"); out^ = .Manifest
	case "Morph": when COVERAGE do cov_hit("FaceDownCause::Morph"); out^ = .Morph
	case "Cloak": when COVERAGE do cov_hit("FaceDownCause::Cloak"); out^ = .Cloak
	case "Disguise": when COVERAGE do cov_hit("FaceDownCause::Disguise"); out^ = .Disguise
	case "TurnedFaceDown": when COVERAGE do cov_hit("FaceDownCause::TurnedFaceDown"); out^ = .TurnedFaceDown
	case: return fail("FaceDownCause: unknown variant")
	}
	return true
}

encode_FaceDownCause :: proc(b: ^strings.Builder, x: FaceDownCause) {
	@(static, rodata) NAMES := [FaceDownCause]string{
		.Manifest = "Manifest",
		.Morph = "Morph",
		.Cloak = "Cloak",
		.Disguise = "Disguise",
		.TurnedFaceDown = "TurnedFaceDown",
	}
	json.write_string(b, NAMES[x])
}

