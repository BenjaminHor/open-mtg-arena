decode_SplitDamagePortion :: proc(v: json.Value, out: ^SplitDamagePortion) -> bool {
	when COVERAGE do cov_hit("SplitDamagePortion")
	if v.kind != .Object do return fail("SplitDamagePortion: not an object")
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("SplitDamagePortion.source") } else { return fail("SplitDamagePortion.source missing") }
	if fv, found := get_any(v, "target"); found { if !decode_TargetRef(fv, &out.target) do return fail("SplitDamagePortion.target") } else { return fail("SplitDamagePortion.target missing") }
	if fv, found := get_any(v, "amount"); found { if !decode_u32(fv, &out.amount) do return fail("SplitDamagePortion.amount") } else { return fail("SplitDamagePortion.amount missing") }
	if fv, found := get_any(v, "is_combat"); found { if !decode_bool(fv, &out.is_combat) do return fail("SplitDamagePortion.is_combat") }
	if fv, found := get_any(v, "applied"); found { if !dec_dyn_AppliedReplacementKey(fv, &out.applied) do return fail("SplitDamagePortion.applied") }
	return true
}

encode_SplitDamagePortion :: proc(b: ^strings.Builder, x: SplitDamagePortion) {
