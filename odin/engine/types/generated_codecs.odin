	case RestrictionExpiry_EndOfTurn: _ = y; member(b, first, "type"); json.write_string(b, "EndOfTurn")
	case RestrictionExpiry_EndOfCombat: _ = y; member(b, first, "type"); json.write_string(b, "EndOfCombat")
	case RestrictionExpiry_UntilPlayerNextTurn: member(b, first, "type"); json.write_string(b, "UntilPlayerNextTurn")
