decode_ReplacedDamagePortion :: proc(v: json.Value, out: ^ReplacedDamagePortion) -> bool {
	if v.kind != .Object do return fail("ReplacedDamagePortion: not an object")
	if fv, found := get_any(v, "context"); found { if !decode_DamageContextSnapshot(fv, &out.context_) do return fail("ReplacedDamagePortion.context") } else { return fail("ReplacedDamagePortion.context missing") }
	if fv, found := get_any(v, "target"); found { if !decode_TargetRef(fv, &out.target) do return fail("ReplacedDamagePortion.target") } else { return fail("ReplacedDamagePortion.target missing") }
	if fv, found := get_any(v, "amount"); found { if !decode_u32(fv, &out.amount) do return fail("ReplacedDamagePortion.amount") } else { return fail("ReplacedDamagePortion.amount missing") }
	if fv, found := get_any(v, "is_combat"); found { if !decode_bool(fv, &out.is_combat) do return fail("ReplacedDamagePortion.is_combat") }
	return true
}

encode_ReplacedDamagePortion :: proc(b: ^strings.Builder, x: ReplacedDamagePortion) {
