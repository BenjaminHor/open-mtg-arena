	if fv, found := get_any(v, "colors"); found { if !dec_dyn_ManaColor(fv, &out.colors) do return fail("ManaProduction::Mixed.colors") } else { return fail("ManaProduction::Mixed.colors missing") }
	return true
		}) { return fail("ManaProduction::Mixed") }
