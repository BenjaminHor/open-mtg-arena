	case WaitingFor_ChooseXValue: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChooseXValue"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
