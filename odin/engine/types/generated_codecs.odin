decode_ChainStep :: proc(v: json.Value, out: ^ChainStep) -> bool {
	when COVERAGE do cov_hit("ChainStep")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ChainStep: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ChainStep: not a string or object")
	}
	switch variant {
	case "SubAbility": when COVERAGE do cov_hit("ChainStep::SubAbility"); out^ = ChainStep_SubAbility{}
	case "ElseAbility": when COVERAGE do cov_hit("ChainStep::ElseAbility"); out^ = ChainStep_ElseAbility{}
	case "CoinFlipBranch": when COVERAGE do cov_hit("ChainStep::CoinFlipBranch");
		tmp: ChainStep_CoinFlipBranch
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ChainStep_CoinFlipBranch) -> bool {
	if fv, found := get_any(v, "result"); found { if !decode_CoinFlipResult(fv, &out.result) do return fail("ChainStep::CoinFlipBranch.result") } else { return fail("ChainStep::CoinFlipBranch.result missing") }
	return true
		}) { return fail("ChainStep::CoinFlipBranch") }
		out^ = tmp
	case: return fail("ChainStep: unknown variant")
	}
	return true
}

encode_ChainStep :: proc(b: ^strings.Builder, x: ChainStep) {
	#partial switch y in x {
	case ChainStep_SubAbility: _ = y; json.write_string(b, "SubAbility")
	case ChainStep_ElseAbility: _ = y; json.write_string(b, "ElseAbility")
	case ChainStep_CoinFlipBranch: strings.write_byte(b, '{'); json.write_string(b, "CoinFlipBranch"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "result"); encode_CoinFlipResult(b, y.result)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

