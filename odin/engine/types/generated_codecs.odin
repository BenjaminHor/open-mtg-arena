		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_HasAnyAttachmentOf) -> bool {
	if fv, found := get_any(v, "kinds"); found { if !dec_dyn_AttachmentKind(fv, &out.kinds) do return fail("FilterProp::HasAnyAttachmentOf.kinds") } else { return fail("FilterProp::HasAnyAttachmentOf.kinds missing") }
	if fv, found := get_any(v, "controller"); found { if !dec_opt_ControllerRef(fv, &out.controller) do return fail("FilterProp::HasAnyAttachmentOf.controller") }
	return true
		}) { return fail("FilterProp::HasAnyAttachmentOf") }
		out^ = tmp
	case "Another": out^ = FilterProp_Another{}
	case "Unpaired": out^ = FilterProp_Unpaired{}
	case "OtherThanTriggerObject": out^ = FilterProp_OtherThanTriggerObject{}
	case "HasColor":
		tmp: FilterProp_HasColor
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_HasColor) -> bool {
	if fv, found := get_any(v, "color"); found { if !decode_ManaColor(fv, &out.color) do return fail("FilterProp::HasColor.color") } else { return fail("FilterProp::HasColor.color missing") }
	return true
