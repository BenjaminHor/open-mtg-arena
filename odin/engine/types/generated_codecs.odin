decode_PlayerDeckList :: proc(v: json.Value, out: ^PlayerDeckList) -> bool {
	when COVERAGE do cov_hit("PlayerDeckList")
	if v.kind != .Object do return fail("PlayerDeckList: not an object")
	if fv, found := get_any(v, "main_deck"); found { if !dec_dyn_string(fv, &out.main_deck) do return fail("PlayerDeckList.main_deck") } else { return fail("PlayerDeckList.main_deck missing") }
	if fv, found := get_any(v, "sideboard"); found { if !dec_dyn_string(fv, &out.sideboard) do return fail("PlayerDeckList.sideboard") }
	if fv, found := get_any(v, "commander"); found { if !dec_dyn_string(fv, &out.commander) do return fail("PlayerDeckList.commander") }
	if fv, found := get_any(v, "companion"); found { if !dec_dyn_string(fv, &out.companion) do return fail("PlayerDeckList.companion") }
	if fv, found := get_any(v, "attraction_deck"); found { if !dec_dyn_string(fv, &out.attraction_deck) do return fail("PlayerDeckList.attraction_deck") }
	if fv, found := get_any(v, "planar_deck"); found { if !dec_dyn_string(fv, &out.planar_deck) do return fail("PlayerDeckList.planar_deck") }
	if fv, found := get_any(v, "scheme_deck"); found { if !dec_dyn_string(fv, &out.scheme_deck) do return fail("PlayerDeckList.scheme_deck") }
	if fv, found := get_any(v, "contraption_deck"); found { if !dec_dyn_string(fv, &out.contraption_deck) do return fail("PlayerDeckList.contraption_deck") }
	if fv, found := get_any(v, "sticker_sheets"); found { if !dec_dyn_string(fv, &out.sticker_sheets) do return fail("PlayerDeckList.sticker_sheets") }
	if fv, found := get_any(v, "signature_spell"); found { if !dec_dyn_string(fv, &out.signature_spell) do return fail("PlayerDeckList.signature_spell") }
	if fv, found := get_any(v, "bracket_tier"); found { if !dec_opt_CommanderBracketTier(fv, &out.bracket_tier) do return fail("PlayerDeckList.bracket_tier") }
	if fv, found := get_any(v, "combo_declaration"); found { if !decode_ComboDeclaration(fv, &out.combo_declaration) do return fail("PlayerDeckList.combo_declaration") } else { out.combo_declaration = default_ComboDeclaration() }
	if fv, found := get_any(v, "printings"); found { if !dec_dyn_DeckPrinting(fv, &out.printings) do return fail("PlayerDeckList.printings") }
	return true
}

encode_PlayerDeckList :: proc(b: ^strings.Builder, x: PlayerDeckList) {
	strings.write_byte(b, '{')
	f := true
	encode_PlayerDeckList_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PlayerDeckList_members :: proc(b: ^strings.Builder, x: PlayerDeckList, first: ^bool) {
	member(b, first, "main_deck"); enc_dyn_string(b, x.main_deck)
	member(b, first, "sideboard"); enc_dyn_string(b, x.sideboard)
	member(b, first, "commander"); enc_dyn_string(b, x.commander)
	member(b, first, "companion"); enc_dyn_string(b, x.companion)
	member(b, first, "attraction_deck"); enc_dyn_string(b, x.attraction_deck)
	member(b, first, "planar_deck"); enc_dyn_string(b, x.planar_deck)
	member(b, first, "scheme_deck"); enc_dyn_string(b, x.scheme_deck)
	member(b, first, "contraption_deck"); enc_dyn_string(b, x.contraption_deck)
	member(b, first, "sticker_sheets"); enc_dyn_string(b, x.sticker_sheets)
	member(b, first, "signature_spell"); enc_dyn_string(b, x.signature_spell)
	member(b, first, "bracket_tier"); enc_opt_CommanderBracketTier(b, x.bracket_tier)
	member(b, first, "combo_declaration"); encode_ComboDeclaration(b, x.combo_declaration)
	if !((len(x.printings) == 0)) { member(b, first, "printings"); enc_dyn_DeckPrinting(b, x.printings) }
}

decode_ComboDeclaration :: proc(v: json.Value, out: ^ComboDeclaration) -> bool {
	when COVERAGE do cov_hit("ComboDeclaration")
	if v.kind != .Object do return fail("ComboDeclaration: not an object")
	tv, found := json.get(v, "kind")
	if !found || tv.kind != .String do return fail("ComboDeclaration: no tag")
	switch tv.text {
	case "undeclared": when COVERAGE do cov_hit("ComboDeclaration::undeclared"); out^ = ComboDeclaration_Undeclared{}
	case "none_intended": when COVERAGE do cov_hit("ComboDeclaration::none_intended"); out^ = ComboDeclaration_NoneIntended{}
	case "intended": when COVERAGE do cov_hit("ComboDeclaration::intended");
		tmp: ComboDeclaration_Intended
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ComboDeclaration_Intended) -> bool {
	if fv, found := get_any(v, "window"); found { if !dec_opt_ComboWindow(fv, &out.window) do return fail("ComboDeclaration::Intended.window") }
	return true
		}) { return fail("ComboDeclaration::Intended") }
		out^ = tmp
	case: return fail("ComboDeclaration: unknown variant")
	}
	return true
}

encode_ComboDeclaration :: proc(b: ^strings.Builder, x: ComboDeclaration) {
	#partial switch y in x {
	case ComboDeclaration_Undeclared: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "kind"); json.write_string(b, "undeclared"); strings.write_byte(b, '}')
	case ComboDeclaration_NoneIntended: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "kind"); json.write_string(b, "none_intended"); strings.write_byte(b, '}')
	case ComboDeclaration_Intended: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "intended")
	member(b, first, "window"); enc_opt_ComboWindow(b, y.window)
	}; strings.write_byte(b, '}')
	}
}

encode_ComboDeclaration_members :: proc(b: ^strings.Builder, x: ComboDeclaration, first: ^bool) {
	#partial switch y in x {
	case ComboDeclaration_Undeclared: _ = y; member(b, first, "kind"); json.write_string(b, "undeclared")
