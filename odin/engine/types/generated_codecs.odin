	case FilterProp_Renowned: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Renowned"); strings.write_byte(b, '}')
	case FilterProp_Goaded: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Goaded"); strings.write_byte(b, '}')
	case FilterProp_Prepared: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Prepared"); strings.write_byte(b, '}')
	case FilterProp_ToughnessGTPower: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ToughnessGTPower"); strings.write_byte(b, '}')
