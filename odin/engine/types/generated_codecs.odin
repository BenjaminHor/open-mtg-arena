	case "optimized": when COVERAGE do cov_hit("CommanderBracketTier::optimized"); out^ = .Optimized
	case "cedh": when COVERAGE do cov_hit("CommanderBracketTier::cedh"); out^ = .Cedh
	case: return fail("CommanderBracketTier: unknown variant")
	}
	return true
}

encode_CommanderBracketTier :: proc(b: ^strings.Builder, x: CommanderBracketTier) {
	@(static, rodata) NAMES := [CommanderBracketTier]string{
		.Exhibition = "exhibition",
		.Core = "core",
		.Upgraded = "upgraded",
		.Optimized = "optimized",
		.Cedh = "cedh",
	}
	json.write_string(b, NAMES[x])
}

