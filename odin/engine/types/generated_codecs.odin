	if fv, found := get_any(v, "printed_occurrence"); found { if !decode_int(fv, &out.printed_occurrence) do return fail("TriggerPrintedOrigin.printed_occurrence") } else { return fail("TriggerPrintedOrigin.printed_occurrence missing") }
