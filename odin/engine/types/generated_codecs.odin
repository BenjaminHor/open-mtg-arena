decode_TriggerObservationTime :: proc(v: json.Value, out: ^TriggerObservationTime) -> bool {
	when COVERAGE do cov_hit("TriggerObservationTime")
	if v.kind != .String do return fail("TriggerObservationTime: not a string")
	str := v.text
	switch str {
	case "ImmediatelyBefore": when COVERAGE do cov_hit("TriggerObservationTime::ImmediatelyBefore"); out^ = .ImmediatelyBefore
	case "ImmediatelyAfter": when COVERAGE do cov_hit("TriggerObservationTime::ImmediatelyAfter"); out^ = .ImmediatelyAfter
	case: return fail("TriggerObservationTime: unknown variant")
	}
	return true
}

encode_TriggerObservationTime :: proc(b: ^strings.Builder, x: TriggerObservationTime) {
	@(static, rodata) NAMES := [TriggerObservationTime]string{
		.ImmediatelyBefore = "ImmediatelyBefore",
		.ImmediatelyAfter = "ImmediatelyAfter",
	}
	json.write_string(b, NAMES[x])
}

