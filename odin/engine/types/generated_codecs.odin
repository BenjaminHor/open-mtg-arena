	member(b, first, "player"); encode_PlayerScope(b, y.player)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case QuantityRef_PlayerActionsThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PlayerActionsThisTurn")
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	member(b, first, "action"); encode_PlayerActionKind(b, y.action)
	}; strings.write_byte(b, '}')
	case QuantityRef_DungeonsCompleted: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DungeonsCompleted"); strings.write_byte(b, '}')
	case QuantityRef_CostXPaid: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CostXPaid"); strings.write_byte(b, '}')
	case QuantityRef_KickerCount: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "KickerCount"); strings.write_byte(b, '}')
	case QuantityRef_AdditionalCostPaymentCount: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AdditionalCostPaymentCount"); strings.write_byte(b, '}')
	case QuantityRef_AdditionalCostPaymentCountFor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AdditionalCostPaymentCountFor")
	member(b, first, "origin"); encode_AdditionalCostOrigin(b, y.origin)
	if !(y.origin_ordinal == nil) { member(b, first, "origin_ordinal"); enc_opt_u32(b, y.origin_ordinal) }
	}; strings.write_byte(b, '}')
	case QuantityRef_ConvokedCreatureCount: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ConvokedCreatureCount"); strings.write_byte(b, '}')
	case QuantityRef_TimesCostPaidThisResolution: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TimesCostPaidThisResolution"); strings.write_byte(b, '}')
	case QuantityRef_ManaSpentToCast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ManaSpentToCast")
	member(b, first, "scope"); encode_CastManaObjectScope(b, y.scope)
	member(b, first, "metric"); encode_CastManaSpentMetric(b, y.metric)
	}; strings.write_byte(b, '}')
	case QuantityRef_ColorsInCommandersColorIdentity: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ColorsInCommandersColorIdentity"); strings.write_byte(b, '}')
	case QuantityRef_CommanderCastFromCommandZoneCount: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CommanderCastFromCommandZoneCount"); strings.write_byte(b, '}')
	case QuantityRef_CommanderManaValue: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CommanderManaValue")
	member(b, first, "owner"); encode_ControllerRef(b, y.owner)
	}; strings.write_byte(b, '}')
	case QuantityRef_DistinctColorsAmong: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DistinctColorsAmong")
