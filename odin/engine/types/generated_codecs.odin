	if fv, found := get_any(v, "ability"); found { if !dec_ptr_ResolvedAbility(fv, &out.ability) do return fail("DelayedTrigger.ability") } else { return fail("DelayedTrigger.ability missing") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("DelayedTrigger.controller") } else { return fail("DelayedTrigger.controller missing") }
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("DelayedTrigger.source_id") } else { return fail("DelayedTrigger.source_id missing") }
	if fv, found := get_any(v, "one_shot"); found { if !decode_bool(fv, &out.one_shot) do return fail("DelayedTrigger.one_shot") } else { return fail("DelayedTrigger.one_shot missing") }
	if fv, found := get_any(v, "kind"); found { if !decode_DelayedTriggerKind(fv, &out.kind) do return fail("DelayedTrigger.kind") }
	if fv, found := get_any(v, "provenance"); found { if !decode_DelayedInstallIdentity(fv, &out.provenance) do return fail("DelayedTrigger.provenance") } else { out.provenance = DelayedInstallIdentity(DelayedInstallIdentity_LegacyDelayed{}) }
	return true
}

