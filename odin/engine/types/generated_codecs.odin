	}
}

decode_DamageContextSnapshot :: proc(v: json.Value, out: ^DamageContextSnapshot) -> bool {
	if v.kind != .Object do return fail("DamageContextSnapshot: not an object")
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("DamageContextSnapshot.source_id") } else { return fail("DamageContextSnapshot.source_id missing") }
	if fv, found := get_any(v, "source_incarnation"); found { if !dec_opt_u64(fv, &out.source_incarnation) do return fail("DamageContextSnapshot.source_incarnation") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("DamageContextSnapshot.controller") } else { return fail("DamageContextSnapshot.controller missing") }
	if fv, found := get_any(v, "source_is_creature"); found { if !decode_bool(fv, &out.source_is_creature) do return fail("DamageContextSnapshot.source_is_creature") } else { return fail("DamageContextSnapshot.source_is_creature missing") }
	if fv, found := get_any(v, "has_deathtouch"); found { if !decode_bool(fv, &out.has_deathtouch) do return fail("DamageContextSnapshot.has_deathtouch") } else { return fail("DamageContextSnapshot.has_deathtouch missing") }
	if fv, found := get_any(v, "has_lifelink"); found { if !decode_bool(fv, &out.has_lifelink) do return fail("DamageContextSnapshot.has_lifelink") } else { return fail("DamageContextSnapshot.has_lifelink missing") }
	if fv, found := get_any(v, "has_wither"); found { if !decode_bool(fv, &out.has_wither) do return fail("DamageContextSnapshot.has_wither") } else { return fail("DamageContextSnapshot.has_wither missing") }
	if fv, found := get_any(v, "has_infect"); found { if !decode_bool(fv, &out.has_infect) do return fail("DamageContextSnapshot.has_infect") } else { return fail("DamageContextSnapshot.has_infect missing") }
	if fv, found := get_any(v, "combat_damage_poison"); found { if !decode_u32(fv, &out.combat_damage_poison) do return fail("DamageContextSnapshot.combat_damage_poison") } else { return fail("DamageContextSnapshot.combat_damage_poison missing") }
	if fv, found := get_any(v, "excess_recipient"); found { if !dec_opt_ExcessRecipient(fv, &out.excess_recipient) do return fail("DamageContextSnapshot.excess_recipient") }
	if fv, found := get_any(v, "lifelink_bonus"); found { if !decode_u32(fv, &out.lifelink_bonus) do return fail("DamageContextSnapshot.lifelink_bonus") }
	return true
}

encode_DamageContextSnapshot :: proc(b: ^strings.Builder, x: DamageContextSnapshot) {
	strings.write_byte(b, '{')
	f := true
	encode_DamageContextSnapshot_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_DamageContextSnapshot_members :: proc(b: ^strings.Builder, x: DamageContextSnapshot, first: ^bool) {
	member(b, first, "source_id"); encode_ObjectId(b, x.source_id)
	if !(x.source_incarnation == nil) { member(b, first, "source_incarnation"); enc_opt_u64(b, x.source_incarnation) }
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	member(b, first, "source_is_creature"); encode_bool(b, x.source_is_creature)
	member(b, first, "has_deathtouch"); encode_bool(b, x.has_deathtouch)
	member(b, first, "has_lifelink"); encode_bool(b, x.has_lifelink)
	member(b, first, "has_wither"); encode_bool(b, x.has_wither)
	member(b, first, "has_infect"); encode_bool(b, x.has_infect)
	member(b, first, "combat_damage_poison"); encode_u32(b, x.combat_damage_poison)
	if !(x.excess_recipient == nil) { member(b, first, "excess_recipient"); enc_opt_ExcessRecipient(b, x.excess_recipient) }
	if !(x.lifelink_bonus == 0) { member(b, first, "lifelink_bonus"); encode_u32(b, x.lifelink_bonus) }
}

decode_TargetRef :: proc(v: json.Value, out: ^TargetRef) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("TargetRef: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("TargetRef: not a string or object")
	}
	switch variant {
	case "Object": tmp: TargetRef_Object; if !decode_ObjectId(body, &tmp._0) do return fail("TargetRef::Object"); out^ = tmp
	case "Player": tmp: TargetRef_Player; if !decode_PlayerId(body, &tmp._0) do return fail("TargetRef::Player"); out^ = tmp
	case: return fail("TargetRef: unknown variant")
	}
	return true
}

encode_TargetRef :: proc(b: ^strings.Builder, x: TargetRef) {
	#partial switch y in x {
	case TargetRef_Object: strings.write_byte(b, '{'); json.write_string(b, "Object"); strings.write_byte(b, ':'); encode_ObjectId(b, y._0); strings.write_byte(b, '}')
	case TargetRef_Player: strings.write_byte(b, '{'); json.write_string(b, "Player"); strings.write_byte(b, ':'); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	}
}

