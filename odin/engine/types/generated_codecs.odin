decode_ContinuationXAnnouncement :: proc(v: json.Value, out: ^ContinuationXAnnouncement) -> bool {
	when COVERAGE do cov_hit("ContinuationXAnnouncement")
	if v.kind != .String do return fail("ContinuationXAnnouncement: not a string")
	str := v.text
	switch str {
	case "TappedCount": when COVERAGE do cov_hit("ContinuationXAnnouncement::TappedCount"); out^ = .TappedCount
	case "PaidAmount": when COVERAGE do cov_hit("ContinuationXAnnouncement::PaidAmount"); out^ = .PaidAmount
	case: return fail("ContinuationXAnnouncement: unknown variant")
	}
	return true
}

encode_ContinuationXAnnouncement :: proc(b: ^strings.Builder, x: ContinuationXAnnouncement) {
	@(static, rodata) NAMES := [ContinuationXAnnouncement]string{
