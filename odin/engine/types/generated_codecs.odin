decode_CastAuthorityChoice :: proc(v: json.Value, out: ^CastAuthorityChoice) -> bool {
	when COVERAGE do cov_hit("CastAuthorityChoice")
	if v.kind != .Object do return fail("CastAuthorityChoice: not an object")
	if fv, found := get_any(v, "announcement"); found { if !decode_AnnouncedGraveyardPermission(fv, &out.announcement) do return fail("CastAuthorityChoice.announcement") } else { return fail("CastAuthorityChoice.announcement missing") }
	if fv, found := get_any(v, "extra_cost"); found { if !dec_opt_CastExtraCost(fv, &out.extra_cost) do return fail("CastAuthorityChoice.extra_cost") }
	if fv, found := get_any(v, "enters_with_counter"); found { if !dec_opt_CounterType(fv, &out.enters_with_counter) do return fail("CastAuthorityChoice.enters_with_counter") }
	if fv, found := get_any(v, "frequency"); found { if !decode_CastFrequency(fv, &out.frequency) do return fail("CastAuthorityChoice.frequency") } else { return fail("CastAuthorityChoice.frequency missing") }
	if fv, found := get_any(v, "graveyard_destination_replacement"); found { if !dec_opt_Zone(fv, &out.graveyard_destination_replacement) do return fail("CastAuthorityChoice.graveyard_destination_replacement") }
	return true
}

encode_CastAuthorityChoice :: proc(b: ^strings.Builder, x: CastAuthorityChoice) {
	strings.write_byte(b, '{')
	f := true
	encode_CastAuthorityChoice_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CastAuthorityChoice_members :: proc(b: ^strings.Builder, x: CastAuthorityChoice, first: ^bool) {
	member(b, first, "announcement"); encode_AnnouncedGraveyardPermission(b, x.announcement)
	if !(x.extra_cost == nil) { member(b, first, "extra_cost"); enc_opt_CastExtraCost(b, x.extra_cost) }
	if !(x.enters_with_counter == nil) { member(b, first, "enters_with_counter"); enc_opt_CounterType(b, x.enters_with_counter) }
	member(b, first, "frequency"); encode_CastFrequency(b, x.frequency)
	if !(x.graveyard_destination_replacement == nil) { member(b, first, "graveyard_destination_replacement"); enc_opt_Zone(b, x.graveyard_destination_replacement) }
}

