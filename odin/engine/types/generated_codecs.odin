}

encode_ChosenCounterCountCondition_members :: proc(b: ^strings.Builder, x: ChosenCounterCountCondition, first: ^bool) {
	member(b, first, "comparator"); encode_Comparator(b, x.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, x.rhs)
}

