decode_ProductKnowledgeFact :: proc(v: json.Value, out: ^ProductKnowledgeFact) -> bool {
	when COVERAGE do cov_hit("ProductKnowledgeFact")
	if v.kind != .Object do return fail("ProductKnowledgeFact: not an object")
	if fv, found := get_any(v, "viewer"); found { if !decode_PlayerId(fv, &out.viewer) do return fail("ProductKnowledgeFact.viewer") } else { return fail("ProductKnowledgeFact.viewer missing") }
	if fv, found := get_any(v, "owner"); found { if !decode_PlayerId(fv, &out.owner) do return fail("ProductKnowledgeFact.owner") } else { return fail("ProductKnowledgeFact.owner missing") }
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("ProductKnowledgeFact.zone") } else { return fail("ProductKnowledgeFact.zone missing") }
	if fv, found := get_any(v, "identity"); found { if !decode_ObjectIncarnationRef(fv, &out.identity) do return fail("ProductKnowledgeFact.identity") } else { return fail("ProductKnowledgeFact.identity missing") }
	if fv, found := get_any(v, "library_epoch"); found { if !dec_opt_u64(fv, &out.library_epoch) do return fail("ProductKnowledgeFact.library_epoch") }
	return true
}

