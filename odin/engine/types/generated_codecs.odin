decode_DamageAmountThreshold :: proc(v: json.Value, out: ^DamageAmountThreshold) -> bool {
	if v.kind != .Object do return fail("DamageAmountThreshold: not an object")
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("DamageAmountThreshold.comparator") } else { return fail("DamageAmountThreshold.comparator missing") }
	if fv, found := get_any(v, "threshold"); found { if !decode_u32(fv, &out.threshold) do return fail("DamageAmountThreshold.threshold") } else { return fail("DamageAmountThreshold.threshold missing") }
	if fv, found := get_any(v, "scope"); found { if !decode_DamageAmountScope(fv, &out.scope) do return fail("DamageAmountThreshold.scope") }
	return true
}

encode_DamageAmountThreshold :: proc(b: ^strings.Builder, x: DamageAmountThreshold) {
	strings.write_byte(b, '{')
	f := true
	encode_DamageAmountThreshold_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_DamageAmountThreshold_members :: proc(b: ^strings.Builder, x: DamageAmountThreshold, first: ^bool) {
	member(b, first, "comparator"); encode_Comparator(b, x.comparator)
	member(b, first, "threshold"); encode_u32(b, x.threshold)
	if !(skip_DamageAmountThreshold_is_per_source_damage_scope(x.scope)) { member(b, first, "scope"); encode_DamageAmountScope(b, x.scope) }
}

