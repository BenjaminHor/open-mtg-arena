decode_AttachTarget :: proc(v: json.Value, out: ^AttachTarget) -> bool {
	when COVERAGE do cov_hit("AttachTarget")
	if v.kind != .Object do return fail("AttachTarget: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("AttachTarget: no tag")
	switch tv.text {
	case "Object": when COVERAGE do cov_hit("AttachTarget::Object"); tmp: AttachTarget_Object; if !decode_ObjectId(json.get_or_null(v, "data"), &tmp._0) do return fail("AttachTarget::Object"); out^ = tmp
	case "Player": when COVERAGE do cov_hit("AttachTarget::Player"); tmp: AttachTarget_Player; if !decode_PlayerId(json.get_or_null(v, "data"), &tmp._0) do return fail("AttachTarget::Player"); out^ = tmp
	case: return fail("AttachTarget: unknown variant")
	}
	return true
}

encode_AttachTarget :: proc(b: ^strings.Builder, x: AttachTarget) {
	#partial switch y in x {
	case AttachTarget_Object: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Object"); member(b, &f, "data"); encode_ObjectId(b, y._0); strings.write_byte(b, '}')
	case AttachTarget_Player: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Player"); member(b, &f, "data"); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	}
}

decode_ResolutionPaymentOrigin :: proc(v: json.Value, out: ^ResolutionPaymentOrigin) -> bool {
	when COVERAGE do cov_hit("ResolutionPaymentOrigin")
	if v.kind != .String do return fail("ResolutionPaymentOrigin: not a string")
	str := v.text
	switch str {
	case "FreshChoice": when COVERAGE do cov_hit("ResolutionPaymentOrigin::FreshChoice"); out^ = .FreshChoice
	case "LatchedSuffix": when COVERAGE do cov_hit("ResolutionPaymentOrigin::LatchedSuffix"); out^ = .LatchedSuffix
	case: return fail("ResolutionPaymentOrigin: unknown variant")
	}
	return true
}

encode_ResolutionPaymentOrigin :: proc(b: ^strings.Builder, x: ResolutionPaymentOrigin) {
	@(static, rodata) NAMES := [ResolutionPaymentOrigin]string{
		.FreshChoice = "FreshChoice",
		.LatchedSuffix = "LatchedSuffix",
	}
	json.write_string(b, NAMES[x])
}

