		tmp: ProposedEvent_Sacrifice
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ProposedEvent_Sacrifice) -> bool {
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("ProposedEvent::Sacrifice.object_id") } else { return fail("ProposedEvent::Sacrifice.object_id missing") }
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("ProposedEvent::Sacrifice.player_id") } else { return fail("ProposedEvent::Sacrifice.player_id missing") }
	if fv, found := get_any(v, "applied"); found { if !dec_dyn_AppliedReplacementKey(fv, &out.applied) do return fail("ProposedEvent::Sacrifice.applied") } else { return fail("ProposedEvent::Sacrifice.applied missing") }
	return true
		}) { return fail("ProposedEvent::Sacrifice") }
		out^ = tmp
	case "BeginTurn": when COVERAGE do cov_hit("ProposedEvent::BeginTurn");
		tmp: ProposedEvent_BeginTurn
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ProposedEvent_BeginTurn) -> bool {
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("ProposedEvent::BeginTurn.player_id") } else { return fail("ProposedEvent::BeginTurn.player_id missing") }
	if fv, found := get_any(v, "is_extra_turn"); found { if !decode_bool(fv, &out.is_extra_turn) do return fail("ProposedEvent::BeginTurn.is_extra_turn") } else { return fail("ProposedEvent::BeginTurn.is_extra_turn missing") }
	if fv, found := get_any(v, "applied"); found { if !dec_dyn_AppliedReplacementKey(fv, &out.applied) do return fail("ProposedEvent::BeginTurn.applied") } else { return fail("ProposedEvent::BeginTurn.applied missing") }
	return true
