	if fv, found := get_any(v, "quantity"); found { if !decode_QuantityRef(fv, &out.quantity) do return fail("UnlessPayScaling::PerQuantityRef.quantity") } else { return fail("UnlessPayScaling::PerQuantityRef.quantity missing") }
	return true
		}) { return fail("UnlessPayScaling::PerQuantityRef") }
		out^ = tmp
	case "PerAffectedAndQuantityRef": when COVERAGE do cov_hit("UnlessPayScaling::PerAffectedAndQuantityRef");
		tmp: UnlessPayScaling_PerAffectedAndQuantityRef
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^UnlessPayScaling_PerAffectedAndQuantityRef) -> bool {
	if fv, found := get_any(v, "quantity"); found { if !decode_QuantityRef(fv, &out.quantity) do return fail("UnlessPayScaling::PerAffectedAndQuantityRef.quantity") } else { return fail("UnlessPayScaling::PerAffectedAndQuantityRef.quantity missing") }
	return true
		}) { return fail("UnlessPayScaling::PerAffectedAndQuantityRef") }
		out^ = tmp
	case "PerAffectedWithRef": when COVERAGE do cov_hit("UnlessPayScaling::PerAffectedWithRef");
		tmp: UnlessPayScaling_PerAffectedWithRef
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^UnlessPayScaling_PerAffectedWithRef) -> bool {
	if fv, found := get_any(v, "quantity"); found { if !decode_QuantityRef(fv, &out.quantity) do return fail("UnlessPayScaling::PerAffectedWithRef.quantity") } else { return fail("UnlessPayScaling::PerAffectedWithRef.quantity missing") }
	return true
		}) { return fail("UnlessPayScaling::PerAffectedWithRef") }
		out^ = tmp
	case: return fail("UnlessPayScaling: unknown variant")
	}
	return true
}

encode_UnlessPayScaling :: proc(b: ^strings.Builder, x: UnlessPayScaling) {
	#partial switch y in x {
	case UnlessPayScaling_Flat: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Flat"); strings.write_byte(b, '}')
	case UnlessPayScaling_PerAffectedCreature: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PerAffectedCreature"); strings.write_byte(b, '}')
	case UnlessPayScaling_PerQuantityRef: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PerQuantityRef"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "quantity"); encode_QuantityRef(b, y.quantity)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case UnlessPayScaling_PerAffectedAndQuantityRef: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PerAffectedAndQuantityRef"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "quantity"); encode_QuantityRef(b, y.quantity)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case UnlessPayScaling_PerAffectedWithRef: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PerAffectedWithRef"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "quantity"); encode_QuantityRef(b, y.quantity)
