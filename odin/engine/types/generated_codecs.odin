decode_TargetPin :: proc(v: json.Value, out: ^TargetPin) -> bool {
	when COVERAGE do cov_hit("TargetPin")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("TargetPin: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("TargetPin: not a string or object")
	}
	switch variant {
	case "ByIdentity": when COVERAGE do cov_hit("TargetPin::ByIdentity"); tmp: TargetPin_ByIdentity; if !decode_YieldTarget(body, &tmp._0) do return fail("TargetPin::ByIdentity"); out^ = tmp
	case "Player": when COVERAGE do cov_hit("TargetPin::Player"); tmp: TargetPin_Player; if !decode_PlayerId(body, &tmp._0) do return fail("TargetPin::Player"); out^ = tmp
	case "Scheduled": when COVERAGE do cov_hit("TargetPin::Scheduled"); tmp: TargetPin_Scheduled; if !decode_TargetSchedule(body, &tmp._0) do return fail("TargetPin::Scheduled"); out^ = tmp
	case: return fail("TargetPin: unknown variant")
	}
	return true
}

encode_TargetPin :: proc(b: ^strings.Builder, x: TargetPin) {
	#partial switch y in x {
	case TargetPin_ByIdentity: strings.write_byte(b, '{'); json.write_string(b, "ByIdentity"); strings.write_byte(b, ':'); encode_YieldTarget(b, y._0); strings.write_byte(b, '}')
	case TargetPin_Player: strings.write_byte(b, '{'); json.write_string(b, "Player"); strings.write_byte(b, ':'); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	case TargetPin_Scheduled: strings.write_byte(b, '{'); json.write_string(b, "Scheduled"); strings.write_byte(b, ':'); encode_TargetSchedule(b, y._0); strings.write_byte(b, '}')
	}
}

