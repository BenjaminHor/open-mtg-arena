decode_ReductionProvenance :: proc(v: json.Value, out: ^ReductionProvenance) -> bool {
	when COVERAGE do cov_hit("ReductionProvenance")
	if v.kind != .Object do return fail("ReductionProvenance: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ReductionProvenance: no tag")
	switch tv.text {
	case "Static": when COVERAGE do cov_hit("ReductionProvenance::Static");
		tmp: ReductionProvenance_Static
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^ReductionProvenance_Static) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("ReductionProvenance::Static.source") } else { return fail("ReductionProvenance::Static.source missing") }
	if fv, found := get_any(v, "ordinal"); found { if !decode_u8(fv, &out.ordinal) do return fail("ReductionProvenance::Static.ordinal") } else { return fail("ReductionProvenance::Static.ordinal missing") }
	return true
		}) { return fail("ReductionProvenance::Static") }
		out^ = tmp
	case "Defiler": when COVERAGE do cov_hit("ReductionProvenance::Defiler"); out^ = ReductionProvenance_Defiler{}
	case "CastingPermission": when COVERAGE do cov_hit("ReductionProvenance::CastingPermission"); out^ = ReductionProvenance_CastingPermission{}
	case "PendingOneShot": when COVERAGE do cov_hit("ReductionProvenance::PendingOneShot");
		tmp: ReductionProvenance_PendingOneShot
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^ReductionProvenance_PendingOneShot) -> bool {
	if fv, found := get_any(v, "index"); found { if !decode_int(fv, &out.index) do return fail("ReductionProvenance::PendingOneShot.index") } else { return fail("ReductionProvenance::PendingOneShot.index missing") }
	return true
		}) { return fail("ReductionProvenance::PendingOneShot") }
		out^ = tmp
	case "Affinity": when COVERAGE do cov_hit("ReductionProvenance::Affinity"); out^ = ReductionProvenance_Affinity{}
	case "Undaunted": when COVERAGE do cov_hit("ReductionProvenance::Undaunted"); out^ = ReductionProvenance_Undaunted{}
	case "AbilityCostRider": when COVERAGE do cov_hit("ReductionProvenance::AbilityCostRider"); out^ = ReductionProvenance_AbilityCostRider{}
	case "TransientEffect": when COVERAGE do cov_hit("ReductionProvenance::TransientEffect");
		tmp: ReductionProvenance_TransientEffect
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^ReductionProvenance_TransientEffect) -> bool {
	if fv, found := get_any(v, "effect"); found { if !decode_u64(fv, &out.effect) do return fail("ReductionProvenance::TransientEffect.effect") } else { return fail("ReductionProvenance::TransientEffect.effect missing") }
	if fv, found := get_any(v, "ordinal"); found { if !decode_u8(fv, &out.ordinal) do return fail("ReductionProvenance::TransientEffect.ordinal") } else { return fail("ReductionProvenance::TransientEffect.ordinal missing") }
	return true
		}) { return fail("ReductionProvenance::TransientEffect") }
		out^ = tmp
	case "SacrificedForCost": when COVERAGE do cov_hit("ReductionProvenance::SacrificedForCost"); tmp: ReductionProvenance_SacrificedForCost; if !decode_SpellCostSource(json.get_or_null(v, "data"), &tmp._0) do return fail("ReductionProvenance::SacrificedForCost"); out^ = tmp
	case: return fail("ReductionProvenance: unknown variant")
	}
	return true
}

encode_ReductionProvenance :: proc(b: ^strings.Builder, x: ReductionProvenance) {
	#partial switch y in x {
	case ReductionProvenance_Static: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Static"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "ordinal"); encode_u8(b, y.ordinal)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ReductionProvenance_Defiler: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Defiler"); strings.write_byte(b, '}')
	case ReductionProvenance_CastingPermission: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CastingPermission"); strings.write_byte(b, '}')
	case ReductionProvenance_PendingOneShot: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PendingOneShot"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "index"); encode_int(b, y.index)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ReductionProvenance_Affinity: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Affinity"); strings.write_byte(b, '}')
	case ReductionProvenance_Undaunted: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Undaunted"); strings.write_byte(b, '}')
	case ReductionProvenance_AbilityCostRider: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AbilityCostRider"); strings.write_byte(b, '}')
	case ReductionProvenance_TransientEffect: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TransientEffect"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "effect"); encode_u64(b, y.effect)
	member(b, first, "ordinal"); encode_u8(b, y.ordinal)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ReductionProvenance_SacrificedForCost: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SacrificedForCost"); member(b, &f, "data"); encode_SpellCostSource(b, y._0); strings.write_byte(b, '}')
	}
}

