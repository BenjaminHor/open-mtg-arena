	switch tv.text {
	case "Mana": when COVERAGE do cov_hit("EternalizeCost::Mana"); tmp: EternalizeCost_Mana; if !decode_ManaCost(json.get_or_null(v, "data"), &tmp._0) do return fail("EternalizeCost::Mana"); out^ = tmp
	case "NonMana": when COVERAGE do cov_hit("EternalizeCost::NonMana"); tmp: EternalizeCost_NonMana; if !decode_AbilityCost(json.get_or_null(v, "data"), &tmp._0) do return fail("EternalizeCost::NonMana"); out^ = tmp
	case: return fail("EternalizeCost: unknown variant")
	}
	return true
}

encode_EternalizeCost :: proc(b: ^strings.Builder, x: EternalizeCost) {
	#partial switch y in x {
	case EternalizeCost_Mana: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Mana"); member(b, &f, "data"); encode_ManaCost(b, y._0); strings.write_byte(b, '}')
	case EternalizeCost_NonMana: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NonMana"); member(b, &f, "data"); encode_AbilityCost(b, y._0); strings.write_byte(b, '}')
	}
}

decode_ProtectionTarget :: proc(v: json.Value, out: ^ProtectionTarget) -> bool {
	when COVERAGE do cov_hit("ProtectionTarget")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ProtectionTarget: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ProtectionTarget: not a string or object")
	}
	switch variant {
	case "Color": when COVERAGE do cov_hit("ProtectionTarget::Color"); tmp: ProtectionTarget_Color; if !decode_ManaColor(body, &tmp._0) do return fail("ProtectionTarget::Color"); out^ = tmp
	case "CardType": when COVERAGE do cov_hit("ProtectionTarget::CardType"); tmp: ProtectionTarget_CardType; if !decode_string(body, &tmp._0) do return fail("ProtectionTarget::CardType"); out^ = tmp
	case "Quality": when COVERAGE do cov_hit("ProtectionTarget::Quality"); tmp: ProtectionTarget_Quality; if !decode_string(body, &tmp._0) do return fail("ProtectionTarget::Quality"); out^ = tmp
	case "Multicolored": when COVERAGE do cov_hit("ProtectionTarget::Multicolored"); out^ = ProtectionTarget_Multicolored{}
	case "ChosenColor": when COVERAGE do cov_hit("ProtectionTarget::ChosenColor"); out^ = ProtectionTarget_ChosenColor{}
	case "ChosenCardType": when COVERAGE do cov_hit("ProtectionTarget::ChosenCardType"); out^ = ProtectionTarget_ChosenCardType{}
	case "ChosenCardName": when COVERAGE do cov_hit("ProtectionTarget::ChosenCardName"); out^ = ProtectionTarget_ChosenCardName{}
	case "ChosenPlayer": when COVERAGE do cov_hit("ProtectionTarget::ChosenPlayer"); out^ = ProtectionTarget_ChosenPlayer{}
	case "Everything": when COVERAGE do cov_hit("ProtectionTarget::Everything"); out^ = ProtectionTarget_Everything{}
	case "Filter": when COVERAGE do cov_hit("ProtectionTarget::Filter"); tmp: ProtectionTarget_Filter; if !decode_TargetFilter(body, &tmp._0) do return fail("ProtectionTarget::Filter"); out^ = tmp
	case "FromPlayer": when COVERAGE do cov_hit("ProtectionTarget::FromPlayer"); tmp: ProtectionTarget_FromPlayer; if !decode_ControllerRef(body, &tmp._0) do return fail("ProtectionTarget::FromPlayer"); out^ = tmp
	case "EachColor": when COVERAGE do cov_hit("ProtectionTarget::EachColor"); tmp: ProtectionTarget_EachColor; if !decode_ProtectionColorSet(body, &tmp._0) do return fail("ProtectionTarget::EachColor"); out^ = tmp
	case: return fail("ProtectionTarget: unknown variant")
	}
	return true
}

encode_ProtectionTarget :: proc(b: ^strings.Builder, x: ProtectionTarget) {
	#partial switch y in x {
	case ProtectionTarget_Color: strings.write_byte(b, '{'); json.write_string(b, "Color"); strings.write_byte(b, ':'); encode_ManaColor(b, y._0); strings.write_byte(b, '}')
	case ProtectionTarget_CardType: strings.write_byte(b, '{'); json.write_string(b, "CardType"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	case ProtectionTarget_Quality: strings.write_byte(b, '{'); json.write_string(b, "Quality"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	case ProtectionTarget_Multicolored: _ = y; json.write_string(b, "Multicolored")
	case ProtectionTarget_ChosenColor: _ = y; json.write_string(b, "ChosenColor")
	case ProtectionTarget_ChosenCardType: _ = y; json.write_string(b, "ChosenCardType")
	case ProtectionTarget_ChosenCardName: _ = y; json.write_string(b, "ChosenCardName")
	case ProtectionTarget_ChosenPlayer: _ = y; json.write_string(b, "ChosenPlayer")
	case ProtectionTarget_Everything: _ = y; json.write_string(b, "Everything")
	case ProtectionTarget_Filter: strings.write_byte(b, '{'); json.write_string(b, "Filter"); strings.write_byte(b, ':'); encode_TargetFilter(b, y._0); strings.write_byte(b, '}')
	case ProtectionTarget_FromPlayer: strings.write_byte(b, '{'); json.write_string(b, "FromPlayer"); strings.write_byte(b, ':'); encode_ControllerRef(b, y._0); strings.write_byte(b, '}')
	case ProtectionTarget_EachColor: strings.write_byte(b, '{'); json.write_string(b, "EachColor"); strings.write_byte(b, ':'); encode_ProtectionColorSet(b, y._0); strings.write_byte(b, '}')
	}
}

decode_CyclingCost :: proc(v: json.Value, out: ^CyclingCost) -> bool {
	when COVERAGE do cov_hit("CyclingCost")
	if v.kind != .Object do return fail("CyclingCost: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("CyclingCost: no tag")
	switch tv.text {
	case "Mana": when COVERAGE do cov_hit("CyclingCost::Mana"); tmp: CyclingCost_Mana; if !decode_ManaCost(json.get_or_null(v, "data"), &tmp._0) do return fail("CyclingCost::Mana"); out^ = tmp
	case "NonMana": when COVERAGE do cov_hit("CyclingCost::NonMana"); tmp: CyclingCost_NonMana; if !decode_AbilityCost(json.get_or_null(v, "data"), &tmp._0) do return fail("CyclingCost::NonMana"); out^ = tmp
	case: return fail("CyclingCost: unknown variant")
	}
	return true
}

encode_CyclingCost :: proc(b: ^strings.Builder, x: CyclingCost) {
