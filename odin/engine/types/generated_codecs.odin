		if len(v.members) != 1 do return fail("TriggerMode: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("TriggerMode: not a string or object")
	}
	switch variant {
	case "ChangesZone": out^ = TriggerMode_ChangesZone{}
	case "ChangesZoneAll": out^ = TriggerMode_ChangesZoneAll{}
	case "ChangesController":
		tmp: TriggerMode_ChangesController
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^TriggerMode_ChangesController) -> bool {
	if fv, found := get_any(v, "side"); found { if !decode_ControlChangeSide(fv, &out.side) do return fail("TriggerMode::ChangesController.side") } else { return fail("TriggerMode::ChangesController.side missing") }
	return true
		}) { return fail("TriggerMode::ChangesController") }
		out^ = tmp
	case "LeavesBattlefield": out^ = TriggerMode_LeavesBattlefield{}
	case "DamageDone": out^ = TriggerMode_DamageDone{}
	case "DamageDoneOnce": out^ = TriggerMode_DamageDoneOnce{}
	case "DamageAll": out^ = TriggerMode_DamageAll{}
	case "DamageDealtOnce": out^ = TriggerMode_DamageDealtOnce{}
	case "DamageDoneOnceByController": out^ = TriggerMode_DamageDoneOnceByController{}
	case "DamageReceived": out^ = TriggerMode_DamageReceived{}
	case "DamagePreventedOnce": out^ = TriggerMode_DamagePreventedOnce{}
	case "ExcessDamage": out^ = TriggerMode_ExcessDamage{}
	case "ExcessDamageAll": out^ = TriggerMode_ExcessDamageAll{}
