	case ParsedCondition_YouAttackedWithAtLeast: member(b, first, "type"); json.write_string(b, "YouAttackedWithAtLeast")
	member(b, first, "count"); encode_u32(b, y.count)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }

	case ParsedCondition_YouPlayedLandThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "YouPlayedLandThisTurn")
	case ParsedCondition_YouCastSpellThisTurn: member(b, first, "type"); json.write_string(b, "YouCastSpellThisTurn")
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }

	case ParsedCondition_YouCastNoncreatureSpellThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "YouCastNoncreatureSpellThisTurn")
	case ParsedCondition_YouCastSpellCountAtLeast: member(b, first, "type"); json.write_string(b, "YouCastSpellCountAtLeast")
	member(b, first, "count"); encode_u32(b, y.count)

	case ParsedCondition_YouGainedLifeThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "YouGainedLifeThisTurn")
	case ParsedCondition_YouCreatedTokenThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "YouCreatedTokenThisTurn")
	case ParsedCondition_YouDiscardedCardThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "YouDiscardedCardThisTurn")
	case ParsedCondition_YouSacrificedArtifactThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "YouSacrificedArtifactThisTurn")
	case ParsedCondition_CreatureDiedThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "CreatureDiedThisTurn")
	case ParsedCondition_YouHadCreatureEnterThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "YouHadCreatureEnterThisTurn")
	case ParsedCondition_YouHadAngelOrBerserkerEnterThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "YouHadAngelOrBerserkerEnterThisTurn")
	case ParsedCondition_YouHadArtifactEnterThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "YouHadArtifactEnterThisTurn")
	case ParsedCondition_BattlefieldEntriesThisTurn: member(b, first, "type"); json.write_string(b, "BattlefieldEntriesThisTurn")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "count"); encode_u32(b, y.count)

	case ParsedCondition_CardsLeftYourGraveyardThisTurnAtLeast: member(b, first, "type"); json.write_string(b, "CardsLeftYourGraveyardThisTurnAtLeast")
	member(b, first, "count"); encode_u32(b, y.count)

	case ParsedCondition_PlayerCountAtLeast: member(b, first, "type"); json.write_string(b, "PlayerCountAtLeast")
	member(b, first, "filter"); encode_PlayerFilter(b, y.filter)
	member(b, first, "minimum"); encode_int(b, y.minimum)

	case ParsedCondition_HasCityBlessing: _ = y; member(b, first, "type"); json.write_string(b, "HasCityBlessing")
	case ParsedCondition_HasEnduringStory: _ = y; member(b, first, "type"); json.write_string(b, "HasEnduringStory")
	case ParsedCondition_CompletedDungeon: member(b, first, "type"); json.write_string(b, "CompletedDungeon")
	if !(y.specific == nil) { member(b, first, "specific"); enc_opt_DungeonId(b, y.specific) }

	case ParsedCondition_HasMaxSpeed: _ = y; member(b, first, "type"); json.write_string(b, "HasMaxSpeed")
	case ParsedCondition_IsYourTurn: _ = y; member(b, first, "type"); json.write_string(b, "IsYourTurn")
	case ParsedCondition_IsOpponentsTurn: _ = y; member(b, first, "type"); json.write_string(b, "IsOpponentsTurn")
	case ParsedCondition_CurrentPhaseIs: member(b, first, "type"); json.write_string(b, "CurrentPhaseIs")
	member(b, first, "phases"); enc_dyn_Phase(b, y.phases)

	case ParsedCondition_SpellTargetsFilter: member(b, first, "type"); json.write_string(b, "SpellTargetsFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case ParsedCondition_ControlsCommander: member(b, first, "type"); json.write_string(b, "ControlsCommander")
	member(b, first, "ownership"); encode_CommanderOwnership(b, y.ownership)

	case ParsedCondition_And: member(b, first, "type"); json.write_string(b, "And")
	member(b, first, "conditions"); enc_dyn_ParsedCondition(b, y.conditions)

	case ParsedCondition_Or: member(b, first, "type"); json.write_string(b, "Or")
	member(b, first, "conditions"); enc_dyn_ParsedCondition(b, y.conditions)

	case ParsedCondition_Not: member(b, first, "type"); json.write_string(b, "Not")
	member(b, first, "condition"); enc_ptr_ParsedCondition(b, y.condition)

	}
}

decode_PlayerId :: proc(v: json.Value, out: ^PlayerId) -> bool {
	return decode_u8(v, cast(^u8)out)
}

encode_PlayerId :: proc(b: ^strings.Builder, x: PlayerId) {
	encode_u8(b, cast(u8)x)
}

decode_ObjectId :: proc(v: json.Value, out: ^ObjectId) -> bool {
	return decode_u64(v, cast(^u64)out)
}

encode_ObjectId :: proc(b: ^strings.Builder, x: ObjectId) {
	encode_u64(b, cast(u64)x)
}

decode_ProtectionDoesNotRemove :: proc(v: json.Value, out: ^ProtectionDoesNotRemove) -> bool {
	if v.kind != .String do return fail("ProtectionDoesNotRemove: not a string")
	str := v.text
	switch str {
	case "Source": out^ = .Source
	case "Auras": out^ = .Auras
	case "ControlledAttachmentsAlreadyAttached": out^ = .ControlledAttachmentsAlreadyAttached
	case: return fail("ProtectionDoesNotRemove: unknown variant")
	}
	return true
}

encode_ProtectionDoesNotRemove :: proc(b: ^strings.Builder, x: ProtectionDoesNotRemove) {
	@(static, rodata) NAMES := [ProtectionDoesNotRemove]string{
		.Source = "Source",
		.Auras = "Auras",
		.ControlledAttachmentsAlreadyAttached = "ControlledAttachmentsAlreadyAttached",
	}
	json.write_string(b, NAMES[x])
}

decode_ReplacementEvent :: proc(v: json.Value, out: ^ReplacementEvent) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ReplacementEvent: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ReplacementEvent: not a string or object")
	}
	switch variant {
	case "DamageDone": out^ = ReplacementEvent_DamageDone{}
	case "Destroy": out^ = ReplacementEvent_Destroy{}
	case "Discard": out^ = ReplacementEvent_Discard{}
	case "Draw": out^ = ReplacementEvent_Draw{}
	case "LoseLife": out^ = ReplacementEvent_LoseLife{}
	case "GainLife": out^ = ReplacementEvent_GainLife{}
	case "TurnFaceUp": out^ = ReplacementEvent_TurnFaceUp{}
	case "Counter": out^ = ReplacementEvent_Counter{}
	case "ChangeZone": out^ = ReplacementEvent_ChangeZone{}
	case "Moved": out^ = ReplacementEvent_Moved{}
	case "AddCounter", "AddPlayerCounter": out^ = ReplacementEvent_AddCounter{}
	case "RemoveCounter": out^ = ReplacementEvent_RemoveCounter{}
	case "CreateToken": out^ = ReplacementEvent_CreateToken{}
	case "Tap": out^ = ReplacementEvent_Tap{}
	case "Untap": out^ = ReplacementEvent_Untap{}
	case "DealtDamage": out^ = ReplacementEvent_DealtDamage{}
	case "Mill": out^ = ReplacementEvent_Mill{}
	case "PayLife": out^ = ReplacementEvent_PayLife{}
	case "LifeReduced": out^ = ReplacementEvent_LifeReduced{}
	case "Attached": out^ = ReplacementEvent_Attached{}
	case "SearchFound": out^ = ReplacementEvent_SearchFound{}
	case "DrawCards": out^ = ReplacementEvent_DrawCards{}
	case "ProduceMana": out^ = ReplacementEvent_ProduceMana{}
	case "Scry": out^ = ReplacementEvent_Scry{}
	case "CoinFlip": out^ = ReplacementEvent_CoinFlip{}
	case "RollDice": out^ = ReplacementEvent_RollDice{}
	case "Transform": out^ = ReplacementEvent_Transform{}
	case "Explore": out^ = ReplacementEvent_Explore{}
	case "Connive": out^ = ReplacementEvent_Connive{}
	case "AssembleContraption": out^ = ReplacementEvent_AssembleContraption{}
	case "BeginPhase": out^ = ReplacementEvent_BeginPhase{}
	case "BeginTurn": out^ = ReplacementEvent_BeginTurn{}
	case "Cascade": out^ = ReplacementEvent_Cascade{}
	case "CopySpell": out^ = ReplacementEvent_CopySpell{}
	case "DeclareBlocker": out^ = ReplacementEvent_DeclareBlocker{}
	case "GameLoss": out^ = ReplacementEvent_GameLoss{}
	case "GameWin": out^ = ReplacementEvent_GameWin{}
	case "Learn": out^ = ReplacementEvent_Learn{}
	case "LoseMana": out^ = ReplacementEvent_LoseMana{}
	case "PlanarDiceResult": out^ = ReplacementEvent_PlanarDiceResult{}
	case "Planeswalk": out^ = ReplacementEvent_Planeswalk{}
	case "Proliferate": out^ = ReplacementEvent_Proliferate{}
	case "Other": tmp: ReplacementEvent_Other; if !decode_string(body, &tmp._0) do return fail("ReplacementEvent::Other"); out^ = tmp
	case: return fail("ReplacementEvent: unknown variant")
	}
	return true
}

encode_ReplacementEvent :: proc(b: ^strings.Builder, x: ReplacementEvent) {
	#partial switch y in x {
	case ReplacementEvent_DamageDone: _ = y; json.write_string(b, "DamageDone")
	case ReplacementEvent_Destroy: _ = y; json.write_string(b, "Destroy")
	case ReplacementEvent_Discard: _ = y; json.write_string(b, "Discard")
	case ReplacementEvent_Draw: _ = y; json.write_string(b, "Draw")
	case ReplacementEvent_LoseLife: _ = y; json.write_string(b, "LoseLife")
	case ReplacementEvent_GainLife: _ = y; json.write_string(b, "GainLife")
	case ReplacementEvent_TurnFaceUp: _ = y; json.write_string(b, "TurnFaceUp")
	case ReplacementEvent_Counter: _ = y; json.write_string(b, "Counter")
	case ReplacementEvent_ChangeZone: _ = y; json.write_string(b, "ChangeZone")
	case ReplacementEvent_Moved: _ = y; json.write_string(b, "Moved")
	case ReplacementEvent_AddCounter: _ = y; json.write_string(b, "AddCounter")
	case ReplacementEvent_RemoveCounter: _ = y; json.write_string(b, "RemoveCounter")
	case ReplacementEvent_CreateToken: _ = y; json.write_string(b, "CreateToken")
	case ReplacementEvent_Tap: _ = y; json.write_string(b, "Tap")
	case ReplacementEvent_Untap: _ = y; json.write_string(b, "Untap")
	case ReplacementEvent_DealtDamage: _ = y; json.write_string(b, "DealtDamage")
	case ReplacementEvent_Mill: _ = y; json.write_string(b, "Mill")
	case ReplacementEvent_PayLife: _ = y; json.write_string(b, "PayLife")
	case ReplacementEvent_LifeReduced: _ = y; json.write_string(b, "LifeReduced")
	case ReplacementEvent_Attached: _ = y; json.write_string(b, "Attached")
	case ReplacementEvent_SearchFound: _ = y; json.write_string(b, "SearchFound")
	case ReplacementEvent_DrawCards: _ = y; json.write_string(b, "DrawCards")
	case ReplacementEvent_ProduceMana: _ = y; json.write_string(b, "ProduceMana")
	case ReplacementEvent_Scry: _ = y; json.write_string(b, "Scry")
	case ReplacementEvent_CoinFlip: _ = y; json.write_string(b, "CoinFlip")
	case ReplacementEvent_RollDice: _ = y; json.write_string(b, "RollDice")
	case ReplacementEvent_Transform: _ = y; json.write_string(b, "Transform")
	case ReplacementEvent_Explore: _ = y; json.write_string(b, "Explore")
	case ReplacementEvent_Connive: _ = y; json.write_string(b, "Connive")
	case ReplacementEvent_AssembleContraption: _ = y; json.write_string(b, "AssembleContraption")
	case ReplacementEvent_BeginPhase: _ = y; json.write_string(b, "BeginPhase")
	case ReplacementEvent_BeginTurn: _ = y; json.write_string(b, "BeginTurn")
	case ReplacementEvent_Cascade: _ = y; json.write_string(b, "Cascade")
	case ReplacementEvent_CopySpell: _ = y; json.write_string(b, "CopySpell")
	case ReplacementEvent_DeclareBlocker: _ = y; json.write_string(b, "DeclareBlocker")
	case ReplacementEvent_GameLoss: _ = y; json.write_string(b, "GameLoss")
	case ReplacementEvent_GameWin: _ = y; json.write_string(b, "GameWin")
	case ReplacementEvent_Learn: _ = y; json.write_string(b, "Learn")
	case ReplacementEvent_LoseMana: _ = y; json.write_string(b, "LoseMana")
	case ReplacementEvent_PlanarDiceResult: _ = y; json.write_string(b, "PlanarDiceResult")
	case ReplacementEvent_Planeswalk: _ = y; json.write_string(b, "Planeswalk")
	case ReplacementEvent_Proliferate: _ = y; json.write_string(b, "Proliferate")
	case ReplacementEvent_Other: strings.write_byte(b, '{'); json.write_string(b, "Other"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	}
}

decode_ReplacementContinuationId :: proc(v: json.Value, out: ^ReplacementContinuationId) -> bool {
	return decode_u64(v, cast(^u64)out)
}

encode_ReplacementContinuationId :: proc(b: ^strings.Builder, x: ReplacementContinuationId) {
	encode_u64(b, cast(u64)x)
}

decode_ReplacementMode :: proc(v: json.Value, out: ^ReplacementMode) -> bool {
	if v.kind != .Object do return fail("ReplacementMode: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ReplacementMode: no tag")
	switch tv.text {
	case "Mandatory": out^ = ReplacementMode_Mandatory{}
	case "Optional":
		tmp: ReplacementMode_Optional
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementMode_Optional) -> bool {
	if fv, found := get_any(v, "decline"); found { if !dec_ptr_AbilityDefinition(fv, &out.decline) do return fail("ReplacementMode::Optional.decline") }
	return true
		}) { return fail("ReplacementMode::Optional") }
		out^ = tmp
	case "MayCost":
		tmp: ReplacementMode_MayCost
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementMode_MayCost) -> bool {
	if fv, found := get_any(v, "cost"); found { if !decode_AbilityCost(fv, &out.cost) do return fail("ReplacementMode::MayCost.cost") } else { return fail("ReplacementMode::MayCost.cost missing") }
	if fv, found := get_any(v, "decline"); found { if !dec_ptr_AbilityDefinition(fv, &out.decline) do return fail("ReplacementMode::MayCost.decline") }
	return true
		}) { return fail("ReplacementMode::MayCost") }
		out^ = tmp
	case: return fail("ReplacementMode: unknown variant")
	}
	return true
}

encode_ReplacementMode :: proc(b: ^strings.Builder, x: ReplacementMode) {
	#partial switch y in x {
	case ReplacementMode_Mandatory: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Mandatory"); strings.write_byte(b, '}')
	case ReplacementMode_Optional: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Optional")
	member(b, first, "decline"); enc_ptr_AbilityDefinition(b, y.decline)
	}; strings.write_byte(b, '}')
	case ReplacementMode_MayCost: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "MayCost")
	member(b, first, "cost"); encode_AbilityCost(b, y.cost)
	member(b, first, "decline"); enc_ptr_AbilityDefinition(b, y.decline)
	}; strings.write_byte(b, '}')
	}
}

encode_ReplacementMode_members :: proc(b: ^strings.Builder, x: ReplacementMode, first: ^bool) {
	#partial switch y in x {
	case ReplacementMode_Mandatory: _ = y; member(b, first, "type"); json.write_string(b, "Mandatory")
	case ReplacementMode_Optional: member(b, first, "type"); json.write_string(b, "Optional")
	member(b, first, "decline"); enc_ptr_AbilityDefinition(b, y.decline)

	case ReplacementMode_MayCost: member(b, first, "type"); json.write_string(b, "MayCost")
	member(b, first, "cost"); encode_AbilityCost(b, y.cost)
	member(b, first, "decline"); enc_ptr_AbilityDefinition(b, y.decline)

	}
}

decode_ReplacementChoiceAuthority :: proc(v: json.Value, out: ^ReplacementChoiceAuthority) -> bool {
	if v.kind != .String do return fail("ReplacementChoiceAuthority: not a string")
	str := v.text
	switch str {
	case "AffectedPlayer": out^ = .AffectedPlayer
	case "SourceController": out^ = .SourceController
	case: return fail("ReplacementChoiceAuthority: unknown variant")
	}
	return true
}

encode_ReplacementChoiceAuthority :: proc(b: ^strings.Builder, x: ReplacementChoiceAuthority) {
	@(static, rodata) NAMES := [ReplacementChoiceAuthority]string{
		.AffectedPlayer = "AffectedPlayer",
		.SourceController = "SourceController",
	}
	json.write_string(b, NAMES[x])
}

decode_ReplacementCondition :: proc(v: json.Value, out: ^ReplacementCondition) -> bool {
	if v.kind != .Object do return fail("ReplacementCondition: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ReplacementCondition: no tag")
	switch tv.text {
	case "And":
		tmp: ReplacementCondition_And
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_And) -> bool {
	if fv, found := get_any(v, "conditions"); found { if !dec_dyn_ReplacementCondition(fv, &out.conditions) do return fail("ReplacementCondition::And.conditions") } else { return fail("ReplacementCondition::And.conditions missing") }
	return true
		}) { return fail("ReplacementCondition::And") }
		out^ = tmp
	case "UnlessControlsSubtype":
		tmp: ReplacementCondition_UnlessControlsSubtype
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_UnlessControlsSubtype) -> bool {
	if fv, found := get_any(v, "subtypes"); found { if !dec_dyn_string(fv, &out.subtypes) do return fail("ReplacementCondition::UnlessControlsSubtype.subtypes") } else { return fail("ReplacementCondition::UnlessControlsSubtype.subtypes missing") }
	return true
		}) { return fail("ReplacementCondition::UnlessControlsSubtype") }
		out^ = tmp
	case "UnlessControlsOtherLeq":
		tmp: ReplacementCondition_UnlessControlsOtherLeq
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_UnlessControlsOtherLeq) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("ReplacementCondition::UnlessControlsOtherLeq.count") } else { return fail("ReplacementCondition::UnlessControlsOtherLeq.count missing") }
	if fv, found := get_any(v, "filter"); found { if !decode_TypedFilter(fv, &out.filter) do return fail("ReplacementCondition::UnlessControlsOtherLeq.filter") } else { return fail("ReplacementCondition::UnlessControlsOtherLeq.filter missing") }
	return true
		}) { return fail("ReplacementCondition::UnlessControlsOtherLeq") }
		out^ = tmp
	case "UnlessControlsMatching":
		tmp: ReplacementCondition_UnlessControlsMatching
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_UnlessControlsMatching) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("ReplacementCondition::UnlessControlsMatching.filter") } else { return fail("ReplacementCondition::UnlessControlsMatching.filter missing") }
	return true
		}) { return fail("ReplacementCondition::UnlessControlsMatching") }
		out^ = tmp
	case "UnlessControlsCountMatching":
		tmp: ReplacementCondition_UnlessControlsCountMatching
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_UnlessControlsCountMatching) -> bool {
	if fv, found := get_any(v, "minimum"); found { if !decode_u32(fv, &out.minimum) do return fail("ReplacementCondition::UnlessControlsCountMatching.minimum") } else { return fail("ReplacementCondition::UnlessControlsCountMatching.minimum missing") }
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("ReplacementCondition::UnlessControlsCountMatching.filter") } else { return fail("ReplacementCondition::UnlessControlsCountMatching.filter missing") }
	return true
		}) { return fail("ReplacementCondition::UnlessControlsCountMatching") }
		out^ = tmp
	case "UnlessPlayerLifeAtMost":
		tmp: ReplacementCondition_UnlessPlayerLifeAtMost
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_UnlessPlayerLifeAtMost) -> bool {
	if fv, found := get_any(v, "amount"); found { if !decode_u32(fv, &out.amount) do return fail("ReplacementCondition::UnlessPlayerLifeAtMost.amount") } else { return fail("ReplacementCondition::UnlessPlayerLifeAtMost.amount missing") }
	return true
		}) { return fail("ReplacementCondition::UnlessPlayerLifeAtMost") }
		out^ = tmp
	case "UnlessMultipleOpponents": out^ = ReplacementCondition_UnlessMultipleOpponents{}
	case "UnlessYourTurn": out^ = ReplacementCondition_UnlessYourTurn{}
	case "UnlessQuantity":
		tmp: ReplacementCondition_UnlessQuantity
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_UnlessQuantity) -> bool {
	if fv, found := get_any(v, "lhs"); found { if !decode_QuantityExpr(fv, &out.lhs) do return fail("ReplacementCondition::UnlessQuantity.lhs") } else { return fail("ReplacementCondition::UnlessQuantity.lhs missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("ReplacementCondition::UnlessQuantity.comparator") } else { return fail("ReplacementCondition::UnlessQuantity.comparator missing") }
	if fv, found := get_any(v, "rhs"); found { if !decode_QuantityExpr(fv, &out.rhs) do return fail("ReplacementCondition::UnlessQuantity.rhs") } else { return fail("ReplacementCondition::UnlessQuantity.rhs missing") }
	if fv, found := get_any(v, "active_player_req"); found { if !dec_opt_ControllerRef(fv, &out.active_player_req) do return fail("ReplacementCondition::UnlessQuantity.active_player_req") }
	return true
		}) { return fail("ReplacementCondition::UnlessQuantity") }
		out^ = tmp
	case "OnlyIfQuantity":
		tmp: ReplacementCondition_OnlyIfQuantity
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_OnlyIfQuantity) -> bool {
	if fv, found := get_any(v, "lhs"); found { if !decode_QuantityExpr(fv, &out.lhs) do return fail("ReplacementCondition::OnlyIfQuantity.lhs") } else { return fail("ReplacementCondition::OnlyIfQuantity.lhs missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("ReplacementCondition::OnlyIfQuantity.comparator") } else { return fail("ReplacementCondition::OnlyIfQuantity.comparator missing") }
	if fv, found := get_any(v, "rhs"); found { if !decode_QuantityExpr(fv, &out.rhs) do return fail("ReplacementCondition::OnlyIfQuantity.rhs") } else { return fail("ReplacementCondition::OnlyIfQuantity.rhs missing") }
	if fv, found := get_any(v, "active_player_req"); found { if !dec_opt_ControllerRef(fv, &out.active_player_req) do return fail("ReplacementCondition::OnlyIfQuantity.active_player_req") }
	return true
		}) { return fail("ReplacementCondition::OnlyIfQuantity") }
		out^ = tmp
	case "HasMaxSpeed": out^ = ReplacementCondition_HasMaxSpeed{}
	case "CastViaEscape": out^ = ReplacementCondition_CastViaEscape{}
	case "CastVariantPaid":
		tmp: ReplacementCondition_CastVariantPaid
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_CastVariantPaid) -> bool {
	if fv, found := get_any(v, "variant"); found { if !decode_CastVariantPaid(fv, &out.variant) do return fail("ReplacementCondition::CastVariantPaid.variant") } else { return fail("ReplacementCondition::CastVariantPaid.variant missing") }
	return true
		}) { return fail("ReplacementCondition::CastVariantPaid") }
		out^ = tmp
	case "TurnUpCostSourcePaid":
		tmp: ReplacementCondition_TurnUpCostSourcePaid
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_TurnUpCostSourcePaid) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_TurnUpCostSource(fv, &out.source) do return fail("ReplacementCondition::TurnUpCostSourcePaid.source") } else { return fail("ReplacementCondition::TurnUpCostSourcePaid.source missing") }
	return true
		}) { return fail("ReplacementCondition::TurnUpCostSourcePaid") }
		out^ = tmp
	case "CastFromZone":
		tmp: ReplacementCondition_CastFromZone
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_CastFromZone) -> bool {
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("ReplacementCondition::CastFromZone.zone") } else { return fail("ReplacementCondition::CastFromZone.zone missing") }
	return true
		}) { return fail("ReplacementCondition::CastFromZone") }
		out^ = tmp
	case "EnteredFromZone":
		tmp: ReplacementCondition_EnteredFromZone
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_EnteredFromZone) -> bool {
	if fv, found := get_any(v, "origin_constraint"); found { if !dec_opt_OriginConstraint(fv, &out.origin_constraint) do return fail("ReplacementCondition::EnteredFromZone.origin_constraint") }
	if fv, found := get_any(v, "cast_origin"); found { if !dec_opt_Zone(fv, &out.cast_origin) do return fail("ReplacementCondition::EnteredFromZone.cast_origin") }
	return true
		}) { return fail("ReplacementCondition::EnteredFromZone") }
		out^ = tmp
	case "YouAttackedThisTurn": out^ = ReplacementCondition_YouAttackedThisTurn{}
	case "OpponentDamagedThisTurn": out^ = ReplacementCondition_OpponentDamagedThisTurn{}
	case "CastViaKicker":
		tmp: ReplacementCondition_CastViaKicker
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_CastViaKicker) -> bool {
	if fv, found := get_any(v, "variant"); found { if !dec_opt_KickerVariant(fv, &out.variant) do return fail("ReplacementCondition::CastViaKicker.variant") }
	if fv, found := get_any(v, "kicker_cost"); found { if !dec_opt_ManaCost(fv, &out.kicker_cost) do return fail("ReplacementCondition::CastViaKicker.kicker_cost") }
	return true
		}) { return fail("ReplacementCondition::CastViaKicker") }
		out^ = tmp
	case "SourceTappedState":
		tmp: ReplacementCondition_SourceTappedState
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_SourceTappedState) -> bool {
	if fv, found := get_any(v, "tapped"); found { if !decode_bool(fv, &out.tapped) do return fail("ReplacementCondition::SourceTappedState.tapped") } else { return fail("ReplacementCondition::SourceTappedState.tapped missing") }
	return true
		}) { return fail("ReplacementCondition::SourceTappedState") }
		out^ = tmp
	case "DealtDamageThisTurnBySource":
		tmp: ReplacementCondition_DealtDamageThisTurnBySource
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_DealtDamageThisTurnBySource) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_TargetFilter(fv, &out.source) do return fail("ReplacementCondition::DealtDamageThisTurnBySource.source") } else { return fail("ReplacementCondition::DealtDamageThisTurnBySource.source missing") }
	return true
		}) { return fail("ReplacementCondition::DealtDamageThisTurnBySource") }
		out^ = tmp
	case "EventSourceControlledBy":
		tmp: ReplacementCondition_EventSourceControlledBy
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_EventSourceControlledBy) -> bool {
	if fv, found := get_any(v, "controller"); found { if !decode_ControllerRef(fv, &out.controller) do return fail("ReplacementCondition::EventSourceControlledBy.controller") } else { return fail("ReplacementCondition::EventSourceControlledBy.controller missing") }
	return true
		}) { return fail("ReplacementCondition::EventSourceControlledBy") }
		out^ = tmp
	case "EffectCausedDiscard": out^ = ReplacementCondition_EffectCausedDiscard{}
	case "EffectCausedPlacement": out^ = ReplacementCondition_EffectCausedPlacement{}
	case "OnlyExtraTurn": out^ = ReplacementCondition_OnlyExtraTurn{}
	case "TokenSubtypeMatches":
		tmp: ReplacementCondition_TokenSubtypeMatches
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_TokenSubtypeMatches) -> bool {
	if fv, found := get_any(v, "subtypes"); found { if !dec_dyn_string(fv, &out.subtypes) do return fail("ReplacementCondition::TokenSubtypeMatches.subtypes") } else { return fail("ReplacementCondition::TokenSubtypeMatches.subtypes missing") }
	return true
		}) { return fail("ReplacementCondition::TokenSubtypeMatches") }
		out^ = tmp
	case "TokenCoreTypeMatches":
		tmp: ReplacementCondition_TokenCoreTypeMatches
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_TokenCoreTypeMatches) -> bool {
	if fv, found := get_any(v, "core_types"); found { if !dec_dyn_CoreType(fv, &out.core_types) do return fail("ReplacementCondition::TokenCoreTypeMatches.core_types") } else { return fail("ReplacementCondition::TokenCoreTypeMatches.core_types missing") }
	return true
		}) { return fail("ReplacementCondition::TokenCoreTypeMatches") }
		out^ = tmp
	case "FirstTokenCreationEachTurn":
		tmp: ReplacementCondition_FirstTokenCreationEachTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_FirstTokenCreationEachTurn) -> bool {
	if fv, found := get_any(v, "active_player_req"); found { if !dec_opt_ControllerRef(fv, &out.active_player_req) do return fail("ReplacementCondition::FirstTokenCreationEachTurn.active_player_req") }
	return true
		}) { return fail("ReplacementCondition::FirstTokenCreationEachTurn") }
		out^ = tmp
	case "ExceptFirstDrawInDrawStep": out^ = ReplacementCondition_ExceptFirstDrawInDrawStep{}
	case "IfControlsMatching":
		tmp: ReplacementCondition_IfControlsMatching
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_IfControlsMatching) -> bool {
	if fv, found := get_any(v, "minimum"); found { if !decode_u32(fv, &out.minimum) do return fail("ReplacementCondition::IfControlsMatching.minimum") } else { out.minimum = default_ReplacementCondition_default_one() }
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("ReplacementCondition::IfControlsMatching.filter") } else { return fail("ReplacementCondition::IfControlsMatching.filter missing") }
	return true
		}) { return fail("ReplacementCondition::IfControlsMatching") }
		out^ = tmp
	case "OnlyIfStatic":
		tmp: ReplacementCondition_OnlyIfStatic
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_OnlyIfStatic) -> bool {
	if fv, found := get_any(v, "condition"); found { if !dec_ptr_StaticCondition(fv, &out.condition) do return fail("ReplacementCondition::OnlyIfStatic.condition") } else { return fail("ReplacementCondition::OnlyIfStatic.condition missing") }
	return true
		}) { return fail("ReplacementCondition::OnlyIfStatic") }
		out^ = tmp
	case "ClassLevelGE":
		tmp: ReplacementCondition_ClassLevelGE
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_ClassLevelGE) -> bool {
	if fv, found := get_any(v, "level"); found { if !decode_u8(fv, &out.level) do return fail("ReplacementCondition::ClassLevelGE.level") } else { return fail("ReplacementCondition::ClassLevelGE.level missing") }
	return true
		}) { return fail("ReplacementCondition::ClassLevelGE") }
		out^ = tmp
	case "DuringUntapStep": out^ = ReplacementCondition_DuringUntapStep{}
	case "DuringDrawStep":
		tmp: ReplacementCondition_DuringDrawStep
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_DuringDrawStep) -> bool {
	if fv, found := get_any(v, "active_player_req"); found { if !dec_opt_ControllerRef(fv, &out.active_player_req) do return fail("ReplacementCondition::DuringDrawStep.active_player_req") }
	return true
		}) { return fail("ReplacementCondition::DuringDrawStep") }
		out^ = tmp
	case "ControllerControlsSource":
		tmp: ReplacementCondition_ControllerControlsSource
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_ControllerControlsSource) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("ReplacementCondition::ControllerControlsSource.source") } else { return fail("ReplacementCondition::ControllerControlsSource.source missing") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("ReplacementCondition::ControllerControlsSource.controller") } else { return fail("ReplacementCondition::ControllerControlsSource.controller missing") }
	return true
		}) { return fail("ReplacementCondition::ControllerControlsSource") }
		out^ = tmp
	case "Unrecognized":
		tmp: ReplacementCondition_Unrecognized
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementCondition_Unrecognized) -> bool {
	if fv, found := get_any(v, "text"); found { if !decode_string(fv, &out.text) do return fail("ReplacementCondition::Unrecognized.text") } else { return fail("ReplacementCondition::Unrecognized.text missing") }
	return true
		}) { return fail("ReplacementCondition::Unrecognized") }
		out^ = tmp
	case: return fail("ReplacementCondition: unknown variant")
	}
	return true
}

encode_ReplacementCondition :: proc(b: ^strings.Builder, x: ReplacementCondition) {
	#partial switch y in x {
	case ReplacementCondition_And: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "And")
	member(b, first, "conditions"); enc_dyn_ReplacementCondition(b, y.conditions)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_UnlessControlsSubtype: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UnlessControlsSubtype")
	member(b, first, "subtypes"); enc_dyn_string(b, y.subtypes)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_UnlessControlsOtherLeq: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UnlessControlsOtherLeq")
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "filter"); encode_TypedFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_UnlessControlsMatching: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UnlessControlsMatching")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_UnlessControlsCountMatching: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UnlessControlsCountMatching")
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_UnlessPlayerLifeAtMost: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UnlessPlayerLifeAtMost")
	member(b, first, "amount"); encode_u32(b, y.amount)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_UnlessMultipleOpponents: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "UnlessMultipleOpponents"); strings.write_byte(b, '}')
	case ReplacementCondition_UnlessYourTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "UnlessYourTurn"); strings.write_byte(b, '}')
	case ReplacementCondition_UnlessQuantity: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UnlessQuantity")
	member(b, first, "lhs"); encode_QuantityExpr(b, y.lhs)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, y.rhs)
	if !(y.active_player_req == nil) { member(b, first, "active_player_req"); enc_opt_ControllerRef(b, y.active_player_req) }
	}; strings.write_byte(b, '}')
	case ReplacementCondition_OnlyIfQuantity: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "OnlyIfQuantity")
	member(b, first, "lhs"); encode_QuantityExpr(b, y.lhs)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, y.rhs)
	if !(y.active_player_req == nil) { member(b, first, "active_player_req"); enc_opt_ControllerRef(b, y.active_player_req) }
	}; strings.write_byte(b, '}')
	case ReplacementCondition_HasMaxSpeed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasMaxSpeed"); strings.write_byte(b, '}')
	case ReplacementCondition_CastViaEscape: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CastViaEscape"); strings.write_byte(b, '}')
	case ReplacementCondition_CastVariantPaid: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastVariantPaid")
	member(b, first, "variant"); encode_CastVariantPaid(b, y.variant)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_TurnUpCostSourcePaid: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TurnUpCostSourcePaid")
	member(b, first, "source"); encode_TurnUpCostSource(b, y.source)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_CastFromZone: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastFromZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_EnteredFromZone: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "EnteredFromZone")
	if !(y.origin_constraint == nil) { member(b, first, "origin_constraint"); enc_opt_OriginConstraint(b, y.origin_constraint) }
	if !(y.cast_origin == nil) { member(b, first, "cast_origin"); enc_opt_Zone(b, y.cast_origin) }
	}; strings.write_byte(b, '}')
	case ReplacementCondition_YouAttackedThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "YouAttackedThisTurn"); strings.write_byte(b, '}')
	case ReplacementCondition_OpponentDamagedThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpponentDamagedThisTurn"); strings.write_byte(b, '}')
	case ReplacementCondition_CastViaKicker: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastViaKicker")
	if !(y.variant == nil) { member(b, first, "variant"); enc_opt_KickerVariant(b, y.variant) }
	if !(y.kicker_cost == nil) { member(b, first, "kicker_cost"); enc_opt_ManaCost(b, y.kicker_cost) }
	}; strings.write_byte(b, '}')
	case ReplacementCondition_SourceTappedState: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceTappedState")
	member(b, first, "tapped"); encode_bool(b, y.tapped)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_DealtDamageThisTurnBySource: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DealtDamageThisTurnBySource")
	member(b, first, "source"); encode_TargetFilter(b, y.source)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_EventSourceControlledBy: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "EventSourceControlledBy")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_EffectCausedDiscard: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EffectCausedDiscard"); strings.write_byte(b, '}')
	case ReplacementCondition_EffectCausedPlacement: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EffectCausedPlacement"); strings.write_byte(b, '}')
	case ReplacementCondition_OnlyExtraTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OnlyExtraTurn"); strings.write_byte(b, '}')
	case ReplacementCondition_TokenSubtypeMatches: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TokenSubtypeMatches")
	member(b, first, "subtypes"); enc_dyn_string(b, y.subtypes)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_TokenCoreTypeMatches: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TokenCoreTypeMatches")
	member(b, first, "core_types"); enc_dyn_CoreType(b, y.core_types)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_FirstTokenCreationEachTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "FirstTokenCreationEachTurn")
	if !(y.active_player_req == nil) { member(b, first, "active_player_req"); enc_opt_ControllerRef(b, y.active_player_req) }
	}; strings.write_byte(b, '}')
	case ReplacementCondition_ExceptFirstDrawInDrawStep: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ExceptFirstDrawInDrawStep"); strings.write_byte(b, '}')
	case ReplacementCondition_IfControlsMatching: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "IfControlsMatching")
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_OnlyIfStatic: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "OnlyIfStatic")
	member(b, first, "condition"); enc_ptr_StaticCondition(b, y.condition)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_ClassLevelGE: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ClassLevelGE")
	member(b, first, "level"); encode_u8(b, y.level)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_DuringUntapStep: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DuringUntapStep"); strings.write_byte(b, '}')
	case ReplacementCondition_DuringDrawStep: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DuringDrawStep")
	if !(y.active_player_req == nil) { member(b, first, "active_player_req"); enc_opt_ControllerRef(b, y.active_player_req) }
	}; strings.write_byte(b, '}')
	case ReplacementCondition_ControllerControlsSource: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControllerControlsSource")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	}; strings.write_byte(b, '}')
	case ReplacementCondition_Unrecognized: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Unrecognized")
	member(b, first, "text"); encode_string(b, y.text)
	}; strings.write_byte(b, '}')
	}
}

encode_ReplacementCondition_members :: proc(b: ^strings.Builder, x: ReplacementCondition, first: ^bool) {
	#partial switch y in x {
	case ReplacementCondition_And: member(b, first, "type"); json.write_string(b, "And")
	member(b, first, "conditions"); enc_dyn_ReplacementCondition(b, y.conditions)

	case ReplacementCondition_UnlessControlsSubtype: member(b, first, "type"); json.write_string(b, "UnlessControlsSubtype")
	member(b, first, "subtypes"); enc_dyn_string(b, y.subtypes)

	case ReplacementCondition_UnlessControlsOtherLeq: member(b, first, "type"); json.write_string(b, "UnlessControlsOtherLeq")
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "filter"); encode_TypedFilter(b, y.filter)

	case ReplacementCondition_UnlessControlsMatching: member(b, first, "type"); json.write_string(b, "UnlessControlsMatching")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case ReplacementCondition_UnlessControlsCountMatching: member(b, first, "type"); json.write_string(b, "UnlessControlsCountMatching")
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case ReplacementCondition_UnlessPlayerLifeAtMost: member(b, first, "type"); json.write_string(b, "UnlessPlayerLifeAtMost")
	member(b, first, "amount"); encode_u32(b, y.amount)

	case ReplacementCondition_UnlessMultipleOpponents: _ = y; member(b, first, "type"); json.write_string(b, "UnlessMultipleOpponents")
	case ReplacementCondition_UnlessYourTurn: _ = y; member(b, first, "type"); json.write_string(b, "UnlessYourTurn")
	case ReplacementCondition_UnlessQuantity: member(b, first, "type"); json.write_string(b, "UnlessQuantity")
	member(b, first, "lhs"); encode_QuantityExpr(b, y.lhs)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, y.rhs)
	if !(y.active_player_req == nil) { member(b, first, "active_player_req"); enc_opt_ControllerRef(b, y.active_player_req) }

	case ReplacementCondition_OnlyIfQuantity: member(b, first, "type"); json.write_string(b, "OnlyIfQuantity")
	member(b, first, "lhs"); encode_QuantityExpr(b, y.lhs)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, y.rhs)
	if !(y.active_player_req == nil) { member(b, first, "active_player_req"); enc_opt_ControllerRef(b, y.active_player_req) }

	case ReplacementCondition_HasMaxSpeed: _ = y; member(b, first, "type"); json.write_string(b, "HasMaxSpeed")
	case ReplacementCondition_CastViaEscape: _ = y; member(b, first, "type"); json.write_string(b, "CastViaEscape")
	case ReplacementCondition_CastVariantPaid: member(b, first, "type"); json.write_string(b, "CastVariantPaid")
	member(b, first, "variant"); encode_CastVariantPaid(b, y.variant)

	case ReplacementCondition_TurnUpCostSourcePaid: member(b, first, "type"); json.write_string(b, "TurnUpCostSourcePaid")
	member(b, first, "source"); encode_TurnUpCostSource(b, y.source)

	case ReplacementCondition_CastFromZone: member(b, first, "type"); json.write_string(b, "CastFromZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)

	case ReplacementCondition_EnteredFromZone: member(b, first, "type"); json.write_string(b, "EnteredFromZone")
	if !(y.origin_constraint == nil) { member(b, first, "origin_constraint"); enc_opt_OriginConstraint(b, y.origin_constraint) }
	if !(y.cast_origin == nil) { member(b, first, "cast_origin"); enc_opt_Zone(b, y.cast_origin) }

	case ReplacementCondition_YouAttackedThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "YouAttackedThisTurn")
	case ReplacementCondition_OpponentDamagedThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "OpponentDamagedThisTurn")
	case ReplacementCondition_CastViaKicker: member(b, first, "type"); json.write_string(b, "CastViaKicker")
	if !(y.variant == nil) { member(b, first, "variant"); enc_opt_KickerVariant(b, y.variant) }
	if !(y.kicker_cost == nil) { member(b, first, "kicker_cost"); enc_opt_ManaCost(b, y.kicker_cost) }

	case ReplacementCondition_SourceTappedState: member(b, first, "type"); json.write_string(b, "SourceTappedState")
	member(b, first, "tapped"); encode_bool(b, y.tapped)

	case ReplacementCondition_DealtDamageThisTurnBySource: member(b, first, "type"); json.write_string(b, "DealtDamageThisTurnBySource")
	member(b, first, "source"); encode_TargetFilter(b, y.source)

	case ReplacementCondition_EventSourceControlledBy: member(b, first, "type"); json.write_string(b, "EventSourceControlledBy")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)

	case ReplacementCondition_EffectCausedDiscard: _ = y; member(b, first, "type"); json.write_string(b, "EffectCausedDiscard")
	case ReplacementCondition_EffectCausedPlacement: _ = y; member(b, first, "type"); json.write_string(b, "EffectCausedPlacement")
	case ReplacementCondition_OnlyExtraTurn: _ = y; member(b, first, "type"); json.write_string(b, "OnlyExtraTurn")
	case ReplacementCondition_TokenSubtypeMatches: member(b, first, "type"); json.write_string(b, "TokenSubtypeMatches")
	member(b, first, "subtypes"); enc_dyn_string(b, y.subtypes)

	case ReplacementCondition_TokenCoreTypeMatches: member(b, first, "type"); json.write_string(b, "TokenCoreTypeMatches")
	member(b, first, "core_types"); enc_dyn_CoreType(b, y.core_types)

	case ReplacementCondition_FirstTokenCreationEachTurn: member(b, first, "type"); json.write_string(b, "FirstTokenCreationEachTurn")
	if !(y.active_player_req == nil) { member(b, first, "active_player_req"); enc_opt_ControllerRef(b, y.active_player_req) }

	case ReplacementCondition_ExceptFirstDrawInDrawStep: _ = y; member(b, first, "type"); json.write_string(b, "ExceptFirstDrawInDrawStep")
	case ReplacementCondition_IfControlsMatching: member(b, first, "type"); json.write_string(b, "IfControlsMatching")
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case ReplacementCondition_OnlyIfStatic: member(b, first, "type"); json.write_string(b, "OnlyIfStatic")
	member(b, first, "condition"); enc_ptr_StaticCondition(b, y.condition)

	case ReplacementCondition_ClassLevelGE: member(b, first, "type"); json.write_string(b, "ClassLevelGE")
	member(b, first, "level"); encode_u8(b, y.level)

	case ReplacementCondition_DuringUntapStep: _ = y; member(b, first, "type"); json.write_string(b, "DuringUntapStep")
	case ReplacementCondition_DuringDrawStep: member(b, first, "type"); json.write_string(b, "DuringDrawStep")
	if !(y.active_player_req == nil) { member(b, first, "active_player_req"); enc_opt_ControllerRef(b, y.active_player_req) }

	case ReplacementCondition_ControllerControlsSource: member(b, first, "type"); json.write_string(b, "ControllerControlsSource")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "controller"); encode_PlayerId(b, y.controller)

	case ReplacementCondition_Unrecognized: member(b, first, "type"); json.write_string(b, "Unrecognized")
	member(b, first, "text"); encode_string(b, y.text)

	}
}

decode_DamageModification :: proc(v: json.Value, out: ^DamageModification) -> bool {
	if v.kind != .Object do return fail("DamageModification: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("DamageModification: no tag")
	switch tv.text {
	case "Double": out^ = DamageModification_Double{}
	case "Triple": out^ = DamageModification_Triple{}
	case "Plus":
		tmp: DamageModification_Plus
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DamageModification_Plus) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_QuantityExpr(fv, &out.value) do return fail("DamageModification::Plus.value") } else { return fail("DamageModification::Plus.value missing") }
	return true
		}) { return fail("DamageModification::Plus") }
		out^ = tmp
	case "Minus":
		tmp: DamageModification_Minus
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DamageModification_Minus) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_u32(fv, &out.value) do return fail("DamageModification::Minus.value") } else { return fail("DamageModification::Minus.value missing") }
	return true
		}) { return fail("DamageModification::Minus") }
		out^ = tmp
	case "PreventionMinus":
		tmp: DamageModification_PreventionMinus
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DamageModification_PreventionMinus) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_PreventionFormula(fv, &out.value) do return fail("DamageModification::PreventionMinus.value") } else { return fail("DamageModification::PreventionMinus.value missing") }
	return true
		}) { return fail("DamageModification::PreventionMinus") }
		out^ = tmp
	case "SetToSourcePower": out^ = DamageModification_SetToSourcePower{}
	case "SetTo":
		tmp: DamageModification_SetTo
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DamageModification_SetTo) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_u32(fv, &out.value) do return fail("DamageModification::SetTo.value") } else { return fail("DamageModification::SetTo.value missing") }
	return true
		}) { return fail("DamageModification::SetTo") }
		out^ = tmp
	case "LifeFloor":
		tmp: DamageModification_LifeFloor
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DamageModification_LifeFloor) -> bool {
	if fv, found := get_any(v, "minimum"); found { if !decode_i32(fv, &out.minimum) do return fail("DamageModification::LifeFloor.minimum") } else { return fail("DamageModification::LifeFloor.minimum missing") }
	return true
		}) { return fail("DamageModification::LifeFloor") }
		out^ = tmp
	case: return fail("DamageModification: unknown variant")
	}
	return true
}

encode_DamageModification :: proc(b: ^strings.Builder, x: DamageModification) {
	#partial switch y in x {
	case DamageModification_Double: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Double"); strings.write_byte(b, '}')
	case DamageModification_Triple: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Triple"); strings.write_byte(b, '}')
	case DamageModification_Plus: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Plus")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)
	}; strings.write_byte(b, '}')
	case DamageModification_Minus: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Minus")
	member(b, first, "value"); encode_u32(b, y.value)
	}; strings.write_byte(b, '}')
	case DamageModification_PreventionMinus: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PreventionMinus")
	member(b, first, "value"); encode_PreventionFormula(b, y.value)
	}; strings.write_byte(b, '}')
	case DamageModification_SetToSourcePower: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SetToSourcePower"); strings.write_byte(b, '}')
	case DamageModification_SetTo: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetTo")
	member(b, first, "value"); encode_u32(b, y.value)
	}; strings.write_byte(b, '}')
	case DamageModification_LifeFloor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "LifeFloor")
	member(b, first, "minimum"); encode_i32(b, y.minimum)
	}; strings.write_byte(b, '}')
	}
}

encode_DamageModification_members :: proc(b: ^strings.Builder, x: DamageModification, first: ^bool) {
	#partial switch y in x {
	case DamageModification_Double: _ = y; member(b, first, "type"); json.write_string(b, "Double")
	case DamageModification_Triple: _ = y; member(b, first, "type"); json.write_string(b, "Triple")
	case DamageModification_Plus: member(b, first, "type"); json.write_string(b, "Plus")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)

	case DamageModification_Minus: member(b, first, "type"); json.write_string(b, "Minus")
	member(b, first, "value"); encode_u32(b, y.value)

	case DamageModification_PreventionMinus: member(b, first, "type"); json.write_string(b, "PreventionMinus")
	member(b, first, "value"); encode_PreventionFormula(b, y.value)

	case DamageModification_SetToSourcePower: _ = y; member(b, first, "type"); json.write_string(b, "SetToSourcePower")
	case DamageModification_SetTo: member(b, first, "type"); json.write_string(b, "SetTo")
	member(b, first, "value"); encode_u32(b, y.value)

	case DamageModification_LifeFloor: member(b, first, "type"); json.write_string(b, "LifeFloor")
	member(b, first, "minimum"); encode_i32(b, y.minimum)

	}
}

decode_DamageTargetFilter :: proc(v: json.Value, out: ^DamageTargetFilter) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("DamageTargetFilter: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("DamageTargetFilter: not a string or object")
	}
	switch variant {
	case "CreatureOnly": out^ = DamageTargetFilter_CreatureOnly{}
	case "Player":
		tmp: DamageTargetFilter_Player
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^DamageTargetFilter_Player) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_DamageTargetPlayerScope(fv, &out.player) do return fail("DamageTargetFilter::Player.player") } else { return fail("DamageTargetFilter::Player.player missing") }
	return true
		}) { return fail("DamageTargetFilter::Player") }
		out^ = tmp
	case "PlayerOrPermanentsControlledBy":
		tmp: DamageTargetFilter_PlayerOrPermanentsControlledBy
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^DamageTargetFilter_PlayerOrPermanentsControlledBy) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_DamageTargetPlayerScope(fv, &out.player) do return fail("DamageTargetFilter::PlayerOrPermanentsControlledBy.player") } else { return fail("DamageTargetFilter::PlayerOrPermanentsControlledBy.player missing") }
	if fv, found := get_any(v, "permanent_type"); found { if !dec_opt_CoreType(fv, &out.permanent_type) do return fail("DamageTargetFilter::PlayerOrPermanentsControlledBy.permanent_type") }
	if fv, found := get_any(v, "source_scope"); found { if !decode_SourceExclusion(fv, &out.source_scope) do return fail("DamageTargetFilter::PlayerOrPermanentsControlledBy.source_scope") }
	return true
		}) { return fail("DamageTargetFilter::PlayerOrPermanentsControlledBy") }
		out^ = tmp
	case: return fail("DamageTargetFilter: unknown variant")
	}
	return true
}

encode_DamageTargetFilter :: proc(b: ^strings.Builder, x: DamageTargetFilter) {
	#partial switch y in x {
	case DamageTargetFilter_CreatureOnly: _ = y; json.write_string(b, "CreatureOnly")
	case DamageTargetFilter_Player: strings.write_byte(b, '{'); json.write_string(b, "Player"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_DamageTargetPlayerScope(b, y.player)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DamageTargetFilter_PlayerOrPermanentsControlledBy: strings.write_byte(b, '{'); json.write_string(b, "PlayerOrPermanentsControlledBy"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_DamageTargetPlayerScope(b, y.player)
	member(b, first, "permanent_type"); enc_opt_CoreType(b, y.permanent_type)
	if !(skip_DamageTargetFilter_SourceExclusion_is_include(y.source_scope)) { member(b, first, "source_scope"); encode_SourceExclusion(b, y.source_scope) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_CombatDamageScope :: proc(v: json.Value, out: ^CombatDamageScope) -> bool {
	if v.kind != .String do return fail("CombatDamageScope: not a string")
	str := v.text
	switch str {
	case "CombatOnly": out^ = .CombatOnly
	case "NoncombatOnly": out^ = .NoncombatOnly
	case: return fail("CombatDamageScope: unknown variant")
	}
	return true
}

encode_CombatDamageScope :: proc(b: ^strings.Builder, x: CombatDamageScope) {
	@(static, rodata) NAMES := [CombatDamageScope]string{
		.CombatOnly = "CombatOnly",
		.NoncombatOnly = "NoncombatOnly",
	}
	json.write_string(b, NAMES[x])
}

