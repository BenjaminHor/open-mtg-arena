decode_CountedTake :: proc(v: json.Value, out: ^CountedTake) -> bool {
	when COVERAGE do cov_hit("CountedTake")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("CountedTake: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("CountedTake: not a string or object")
	}
	switch variant {
	case "Performs": when COVERAGE do cov_hit("CountedTake::Performs"); out^ = CountedTake_Performs{}
	case "Unperformable": when COVERAGE do cov_hit("CountedTake::Unperformable"); tmp: CountedTake_Unperformable; if !decode_UnperformableCause(body, &tmp._0) do return fail("CountedTake::Unperformable"); out^ = tmp
	case: return fail("CountedTake: unknown variant")
	}
	return true
}

encode_CountedTake :: proc(b: ^strings.Builder, x: CountedTake) {
	#partial switch y in x {
	case CountedTake_Performs: _ = y; json.write_string(b, "Performs")
	case CountedTake_Unperformable: strings.write_byte(b, '{'); json.write_string(b, "Unperformable"); strings.write_byte(b, ':'); encode_UnperformableCause(b, y._0); strings.write_byte(b, '}')
	}
}

decode_ConfirmedPeriod :: proc(v: json.Value, out: ^ConfirmedPeriod) -> bool {
	when COVERAGE do cov_hit("ConfirmedPeriod")
	if v.kind != .Object do return fail("ConfirmedPeriod: not an object")
	if fv, found := get_any(v, "items"); found { if !dec_dyn_PeriodItem(fv, &out.items) do return fail("ConfirmedPeriod.items") } else { return fail("ConfirmedPeriod.items missing") }
	if fv, found := get_any(v, "growth"); found { if !decode_CoveredGrowth(fv, &out.growth) do return fail("ConfirmedPeriod.growth") }
	if fv, found := get_any(v, "reach"); found { if !decode_PeriodReach(fv, &out.reach) do return fail("ConfirmedPeriod.reach") }
	if fv, found := get_any(v, "choices"); found { if !dec_dyn_PinnedDecision(fv, &out.choices) do return fail("ConfirmedPeriod.choices") }
	if fv, found := get_any(v, "counted_by"); found { if !decode_CountedBy(fv, &out.counted_by) do return fail("ConfirmedPeriod.counted_by") } else { out.counted_by = CountedBy(CountedBy_Threshold{}) }
	if fv, found := get_any(v, "performance"); found { if !dec_opt_PeriodPerformance(fv, &out.performance) do return fail("ConfirmedPeriod.performance") }
	if fv, found := get_any(v, "performed"); found { if !dec_dyn_PerformedReach(fv, &out.performed) do return fail("ConfirmedPeriod.performed") }
	if fv, found := get_any(v, "recorded"); found { if !dec_opt_PerformedReach(fv, &out.recorded) do return fail("ConfirmedPeriod.recorded") }
	if fv, found := get_any(v, "outcomes"); found { if !decode_Outcomes(fv, &out.outcomes) do return fail("ConfirmedPeriod.outcomes") }
	return true
}

encode_ConfirmedPeriod :: proc(b: ^strings.Builder, x: ConfirmedPeriod) {
	strings.write_byte(b, '{')
	f := true
	encode_ConfirmedPeriod_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ConfirmedPeriod_members :: proc(b: ^strings.Builder, x: ConfirmedPeriod, first: ^bool) {
	member(b, first, "items"); enc_dyn_PeriodItem(b, x.items)
	member(b, first, "growth"); encode_CoveredGrowth(b, x.growth)
	member(b, first, "reach"); encode_PeriodReach(b, x.reach)
	member(b, first, "choices"); enc_dyn_PinnedDecision(b, x.choices)
	if !(skip_ConfirmedPeriod_CountedBy_is_threshold_CountedBy(x.counted_by)) { member(b, first, "counted_by"); encode_CountedBy(b, x.counted_by) }
	if !(x.performance == nil) { member(b, first, "performance"); enc_opt_PeriodPerformance(b, x.performance) }
	if !((len(x.performed) == 0)) { member(b, first, "performed"); enc_dyn_PerformedReach(b, x.performed) }
	if !(x.recorded == nil) { member(b, first, "recorded"); enc_opt_PerformedReach(b, x.recorded) }
	if !(skip_ConfirmedPeriod_Outcomes_is_refused_Outcomes(x.outcomes)) { member(b, first, "outcomes"); encode_Outcomes(b, x.outcomes) }
}

decode_ShortcutProposal :: proc(v: json.Value, out: ^ShortcutProposal) -> bool {
	when COVERAGE do cov_hit("ShortcutProposal")
	if v.kind != .Object do return fail("ShortcutProposal: not an object")
	if fv, found := get_any(v, "proposer"); found { if !decode_PlayerId(fv, &out.proposer) do return fail("ShortcutProposal.proposer") } else { return fail("ShortcutProposal.proposer missing") }
	if fv, found := get_any(v, "predicted_winner"); found { if !dec_opt_PlayerId(fv, &out.predicted_winner) do return fail("ShortcutProposal.predicted_winner") }
	if fv, found := get_any(v, "count"); found { if !decode_IterationCount(fv, &out.count) do return fail("ShortcutProposal.count") } else { return fail("ShortcutProposal.count missing") }
	if fv, found := get_any(v, "unbounded"); found { if !dec_dyn_ResourceAxis(fv, &out.unbounded) do return fail("ShortcutProposal.unbounded") } else { return fail("ShortcutProposal.unbounded missing") }
	if fv, found := get_any(v, "rising"); found { if !dec_dyn_ResourceAxis(fv, &out.rising) do return fail("ShortcutProposal.rising") }
	if fv, found := get_any(v, "win_kind"); found { if !dec_opt_WinKind(fv, &out.win_kind) do return fail("ShortcutProposal.win_kind") }
	if fv, found := get_any(v, "win_kind_at"); found { if !dec_opt_u32(fv, &out.win_kind_at) do return fail("ShortcutProposal.win_kind_at") }
	if fv, found := get_any(v, "template"); found { if !dec_opt_DecisionTemplate(fv, &out.template) do return fail("ShortcutProposal.template") }
	if fv, found := get_any(v, "per_cycle"); found { if !dec_opt_PeriodSignature(fv, &out.per_cycle) do return fail("ShortcutProposal.per_cycle") }
	if fv, found := get_any(v, "shortened_by"); found { if !dec_opt_PlayerId(fv, &out.shortened_by) do return fail("ShortcutProposal.shortened_by") }
	if fv, found := get_any(v, "counted_take"); found { if !decode_CountedTake(fv, &out.counted_take) do return fail("ShortcutProposal.counted_take") } else { out.counted_take = CountedTake(CountedTake_Performs{}) }
	if fv, found := get_any(v, "period"); found { if !decode_ConfirmedPeriod(fv, &out.period) do return fail("ShortcutProposal.period") } else { out.period = default_ConfirmedPeriod() }
	if fv, found := get_any(v, "leading_aims"); found { if !dec_dyn_t2_DecisionSlot_PlayerId(fv, &out.leading_aims) do return fail("ShortcutProposal.leading_aims") }
	if fv, found := get_any(v, "published_declaration"); found { if !dec_opt_DecisionTemplate(fv, &out.published_declaration) do return fail("ShortcutProposal.published_declaration") }
	return true
}

encode_ShortcutProposal :: proc(b: ^strings.Builder, x: ShortcutProposal) {
	strings.write_byte(b, '{')
	f := true
	encode_ShortcutProposal_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ShortcutProposal_members :: proc(b: ^strings.Builder, x: ShortcutProposal, first: ^bool) {
	member(b, first, "proposer"); encode_PlayerId(b, x.proposer)
	member(b, first, "predicted_winner"); enc_opt_PlayerId(b, x.predicted_winner)
	member(b, first, "count"); encode_IterationCount(b, x.count)
	member(b, first, "unbounded"); enc_dyn_ResourceAxis(b, x.unbounded)
	if !((len(x.rising) == 0)) { member(b, first, "rising"); enc_dyn_ResourceAxis(b, x.rising) }
	if !(x.win_kind == nil) { member(b, first, "win_kind"); enc_opt_WinKind(b, x.win_kind) }
	if !(x.win_kind_at == nil) { member(b, first, "win_kind_at"); enc_opt_u32(b, x.win_kind_at) }
	if !(x.template == nil) { member(b, first, "template"); enc_opt_DecisionTemplate(b, x.template) }
	if !(x.per_cycle == nil) { member(b, first, "per_cycle"); enc_opt_PeriodSignature(b, x.per_cycle) }
	if !(x.shortened_by == nil) { member(b, first, "shortened_by"); enc_opt_PlayerId(b, x.shortened_by) }
	if !(skip_ShortcutProposal_CountedTake_is_performs_CountedTake(x.counted_take)) { member(b, first, "counted_take"); encode_CountedTake(b, x.counted_take) }
	if !(skip_ShortcutProposal_ConfirmedPeriod_is_empty_ConfirmedPeriod(x.period)) { member(b, first, "period"); encode_ConfirmedPeriod(b, x.period) }
	if !((len(x.leading_aims) == 0)) { member(b, first, "leading_aims"); enc_dyn_t2_DecisionSlot_PlayerId(b, x.leading_aims) }
	if !(x.published_declaration == nil) { member(b, first, "published_declaration"); enc_opt_DecisionTemplate(b, x.published_declaration) }
}

decode_DoorLockOp :: proc(v: json.Value, out: ^DoorLockOp) -> bool {
	when COVERAGE do cov_hit("DoorLockOp")
	if v.kind != .Object do return fail("DoorLockOp: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("DoorLockOp: no tag")
	str := tv.text
	switch str {
	case "Unlock": when COVERAGE do cov_hit("DoorLockOp::Unlock"); out^ = .Unlock
	case "Lock": when COVERAGE do cov_hit("DoorLockOp::Lock"); out^ = .Lock
	case "LockOrUnlock": when COVERAGE do cov_hit("DoorLockOp::LockOrUnlock"); out^ = .LockOrUnlock
	case: return fail("DoorLockOp: unknown variant")
	}
	return true
}

encode_DoorLockOp :: proc(b: ^strings.Builder, x: DoorLockOp) {
	strings.write_byte(b, '{')
	f := true
	encode_DoorLockOp_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_DoorLockOp_members :: proc(b: ^strings.Builder, x: DoorLockOp, first: ^bool) {
	_ = x
	@(static, rodata) NAMES := [DoorLockOp]string{
		.Unlock = "Unlock",
		.Lock = "Lock",
		.LockOrUnlock = "LockOrUnlock",
	}
	member(b, first, "type"); json.write_string(b, NAMES[x])
}

