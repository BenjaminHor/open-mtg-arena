	when COVERAGE do cov_hit("PausedCounterCostRemoval")
	if v.kind != .Object do return fail("PausedCounterCostRemoval: not an object")
	if fv, found := get_any(v, "in_flight"); found { if !decode_PendingCounterRemovalInFlight(fv, &out.in_flight) do return fail("PausedCounterCostRemoval.in_flight") } else { return fail("PausedCounterCostRemoval.in_flight missing") }
