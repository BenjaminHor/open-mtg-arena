	case ObjectScope_Demonstrative: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Demonstrative"); strings.write_byte(b, '}')
	case ObjectScope_AmassedArmy: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AmassedArmy"); strings.write_byte(b, '}')
	case ObjectScope_EventTarget: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EventTarget"); strings.write_byte(b, '}')
	case ObjectScope_OtherRevealedCard: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OtherRevealedCard"); strings.write_byte(b, '}')
	case ObjectScope_OwnedLinkedExileCard: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OwnedLinkedExileCard"); strings.write_byte(b, '}')
	case ObjectScope_BatchSource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BatchSource"); strings.write_byte(b, '}')
	case ObjectScope_ChainRootTarget: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChainRootTarget"); strings.write_byte(b, '}')
	case ObjectScope_GrantingObject: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "GrantingObject"); strings.write_byte(b, '}')
	case ObjectScope_SpecificObject: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SpecificObject")
	member(b, first, "object"); encode_ObjectIncarnationRef(b, y.object)
	}; strings.write_byte(b, '}')
	}
}

