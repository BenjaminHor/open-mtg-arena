	case "CantTap": when COVERAGE do cov_hit("StaticMode::CantTap"); out^ = StaticMode_CantTap{}
	case "CantUntap": when COVERAGE do cov_hit("StaticMode::CantUntap"); out^ = StaticMode_CantUntap{}
	case "MustBeBlocked": when COVERAGE do cov_hit("StaticMode::MustBeBlocked");
		tmp: StaticMode_MustBeBlocked
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_MustBeBlocked) -> bool {
	if fv, found := get_any(v, "by"); found { if !dec_opt_TargetFilter(fv, &out.by) do return fail("StaticMode::MustBeBlocked.by") }
	return true
		}) { return fail("StaticMode::MustBeBlocked") }
		out^ = tmp
	case "MustBeBlockedByAll": when COVERAGE do cov_hit("StaticMode::MustBeBlockedByAll");
		tmp: StaticMode_MustBeBlockedByAll
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_MustBeBlockedByAll) -> bool {
	if fv, found := get_any(v, "blockers"); found { if !dec_opt_TargetFilter(fv, &out.blockers) do return fail("StaticMode::MustBeBlockedByAll.blockers") }
	return true
		}) { return fail("StaticMode::MustBeBlockedByAll") }
		out^ = tmp
	case "Goaded": when COVERAGE do cov_hit("StaticMode::Goaded"); out^ = StaticMode_Goaded{}
	case "MustAttackAwayFromSource": when COVERAGE do cov_hit("StaticMode::MustAttackAwayFromSource"); out^ = StaticMode_MustAttackAwayFromSource{}
	case "CombatAlone": when COVERAGE do cov_hit("StaticMode::CombatAlone");
		tmp: StaticMode_CombatAlone
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_CombatAlone) -> bool {
	if fv, found := get_any(v, "action"); found { if !decode_CombatAloneAction(fv, &out.action) do return fail("StaticMode::CombatAlone.action") } else { return fail("StaticMode::CombatAlone.action missing") }
	if fv, found := get_any(v, "requirement"); found { if !decode_CombatAloneRequirement(fv, &out.requirement) do return fail("StaticMode::CombatAlone.requirement") } else { return fail("StaticMode::CombatAlone.requirement missing") }
	return true
		}) { return fail("StaticMode::CombatAlone") }
		out^ = tmp
	case "CantCrew": when COVERAGE do cov_hit("StaticMode::CantCrew"); out^ = StaticMode_CantCrew{}
	case "CantPhaseIn": when COVERAGE do cov_hit("StaticMode::CantPhaseIn"); out^ = StaticMode_CantPhaseIn{}
