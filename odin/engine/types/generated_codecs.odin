decode_TransientContinuousEffect :: proc(v: json.Value, out: ^TransientContinuousEffect) -> bool {
	when COVERAGE do cov_hit("TransientContinuousEffect")
	if v.kind != .Object do return fail("TransientContinuousEffect: not an object")
	if fv, found := get_any(v, "id"); found { if !decode_u64(fv, &out.id) do return fail("TransientContinuousEffect.id") } else { return fail("TransientContinuousEffect.id missing") }
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("TransientContinuousEffect.source_id") } else { return fail("TransientContinuousEffect.source_id missing") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("TransientContinuousEffect.controller") } else { return fail("TransientContinuousEffect.controller missing") }
	if fv, found := get_any(v, "timestamp"); found { if !decode_u64(fv, &out.timestamp) do return fail("TransientContinuousEffect.timestamp") } else { return fail("TransientContinuousEffect.timestamp missing") }
	if fv, found := get_any(v, "duration"); found { if !decode_Duration(fv, &out.duration) do return fail("TransientContinuousEffect.duration") } else { return fail("TransientContinuousEffect.duration missing") }
	if fv, found := get_any(v, "affected"); found { if !decode_TargetFilter(fv, &out.affected) do return fail("TransientContinuousEffect.affected") } else { return fail("TransientContinuousEffect.affected missing") }
	if fv, found := get_any(v, "affected_recipient"); found { if !dec_opt_ObjectIncarnationRef(fv, &out.affected_recipient) do return fail("TransientContinuousEffect.affected_recipient") }
	if fv, found := get_any(v, "modifications"); found { if !dec_dyn_ContinuousModification(fv, &out.modifications) do return fail("TransientContinuousEffect.modifications") } else { return fail("TransientContinuousEffect.modifications missing") }
	if fv, found := get_any(v, "condition"); found { if !dec_opt_StaticCondition(fv, &out.condition) do return fail("TransientContinuousEffect.condition") }
	if fv, found := get_any(v, "duration_subject"); found { if !dec_opt_ObjectIncarnationRef(fv, &out.duration_subject) do return fail("TransientContinuousEffect.duration_subject") }
	if fv, found := get_any(v, "duration_event_source"); found { if !dec_ptr_TriggerSourceContext(fv, &out.duration_event_source) do return fail("TransientContinuousEffect.duration_event_source") }
	if fv, found := get_any(v, "end_permission"); found { if !dec_opt_EndEffectPermission(fv, &out.end_permission) do return fail("TransientContinuousEffect.end_permission") }
	if fv, found := get_any(v, "granting_object"); found { if !dec_opt_ObjectIncarnationRef(fv, &out.granting_object) do return fail("TransientContinuousEffect.granting_object") }
	if fv, found := get_any(v, "source_name"); found { if !decode_string(fv, &out.source_name) do return fail("TransientContinuousEffect.source_name") }
	if fv, found := get_any(v, "bound_actor"); found { if !dec_opt_PlayerId(fv, &out.bound_actor) do return fail("TransientContinuousEffect.bound_actor") }
	return true
}

encode_TransientContinuousEffect :: proc(b: ^strings.Builder, x: TransientContinuousEffect) {
	strings.write_byte(b, '{')
	f := true
	encode_TransientContinuousEffect_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_TransientContinuousEffect_members :: proc(b: ^strings.Builder, x: TransientContinuousEffect, first: ^bool) {
	member(b, first, "id"); encode_u64(b, x.id)
	member(b, first, "source_id"); encode_ObjectId(b, x.source_id)
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	member(b, first, "timestamp"); encode_u64(b, x.timestamp)
	member(b, first, "duration"); encode_Duration(b, x.duration)
	member(b, first, "affected"); encode_TargetFilter(b, x.affected)
	if !(x.affected_recipient == nil) { member(b, first, "affected_recipient"); enc_opt_ObjectIncarnationRef(b, x.affected_recipient) }
	member(b, first, "modifications"); enc_dyn_ContinuousModification(b, x.modifications)
	if !(x.condition == nil) { member(b, first, "condition"); enc_opt_StaticCondition(b, x.condition) }
	if !(x.duration_subject == nil) { member(b, first, "duration_subject"); enc_opt_ObjectIncarnationRef(b, x.duration_subject) }
	if !(x.duration_event_source == nil) { member(b, first, "duration_event_source"); enc_ptr_TriggerSourceContext(b, x.duration_event_source) }
	if !(x.end_permission == nil) { member(b, first, "end_permission"); enc_opt_EndEffectPermission(b, x.end_permission) }
	if !(x.granting_object == nil) { member(b, first, "granting_object"); enc_opt_ObjectIncarnationRef(b, x.granting_object) }
	member(b, first, "source_name"); encode_string(b, x.source_name)
	if !(x.bound_actor == nil) { member(b, first, "bound_actor"); enc_opt_PlayerId(b, x.bound_actor) }
}

