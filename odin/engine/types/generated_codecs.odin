decode_ProposedEvent :: proc(v: json.Value, out: ^ProposedEvent) -> bool {
	when COVERAGE do cov_hit("ProposedEvent")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ProposedEvent: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ProposedEvent: not a string or object")
	}
	switch variant {
	case "ZoneChange": when COVERAGE do cov_hit("ProposedEvent::ZoneChange");
		tmp: ProposedEvent_ZoneChange
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ProposedEvent_ZoneChange) -> bool {
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("ProposedEvent::ZoneChange.object_id") } else { return fail("ProposedEvent::ZoneChange.object_id missing") }
	if fv, found := get_any(v, "from"); found { if !decode_Zone(fv, &out.from) do return fail("ProposedEvent::ZoneChange.from") } else { return fail("ProposedEvent::ZoneChange.from missing") }
	if fv, found := get_any(v, "to"); found { if !decode_Zone(fv, &out.to) do return fail("ProposedEvent::ZoneChange.to") } else { return fail("ProposedEvent::ZoneChange.to missing") }
	if fv, found := get_any(v, "library_placement"); found { if !dec_ptr_LibraryPosition(fv, &out.library_placement) do return fail("ProposedEvent::ZoneChange.library_placement") }
	if fv, found := get_any(v, "cause"); found { if !dec_opt_ObjectId(fv, &out.cause) do return fail("ProposedEvent::ZoneChange.cause") }
	if fv, found := get_any(v, "attach_to"); found { if !dec_opt_AttachTarget(fv, &out.attach_to) do return fail("ProposedEvent::ZoneChange.attach_to") }
	if fv, found := get_any(v, "enter_tapped"); found { if !decode_EtbTapState(fv, &out.enter_tapped) do return fail("ProposedEvent::ZoneChange.enter_tapped") }
	if fv, found := get_any(v, "enters_attacking"); found { if !decode_bool(fv, &out.enters_attacking) do return fail("ProposedEvent::ZoneChange.enters_attacking") }
	if fv, found := get_any(v, "enter_with_counters"); found { if !dec_dyn_t2_CounterType_u32(fv, &out.enter_with_counters) do return fail("ProposedEvent::ZoneChange.enter_with_counters") }
	if fv, found := get_any(v, "enter_with_grants"); found { if !dec_ptr_EnterWithGrants(fv, &out.enter_with_grants) do return fail("ProposedEvent::ZoneChange.enter_with_grants") }
	if fv, found := get_any(v, "controller_override"); found { if !dec_opt_PlayerId(fv, &out.controller_override) do return fail("ProposedEvent::ZoneChange.controller_override") }
