	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("DelayedInstallIdentity: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("DelayedInstallIdentity: not a string or object")
	}
	switch variant {
	case "LegacyDelayed": when COVERAGE do cov_hit("DelayedInstallIdentity::LegacyDelayed"); out^ = DelayedInstallIdentity_LegacyDelayed{}
	case "ReceiptEligible": when COVERAGE do cov_hit("DelayedInstallIdentity::ReceiptEligible"); tmp: DelayedInstallIdentity_ReceiptEligible; if !decode_DelayedTriggerOrigin(body, &tmp._0) do return fail("DelayedInstallIdentity::ReceiptEligible"); out^ = tmp
	case: return fail("DelayedInstallIdentity: unknown variant")
	}
	return true
}

encode_DelayedInstallIdentity :: proc(b: ^strings.Builder, x: DelayedInstallIdentity) {
	#partial switch y in x {
	case DelayedInstallIdentity_LegacyDelayed: _ = y; json.write_string(b, "LegacyDelayed")
	case DelayedInstallIdentity_ReceiptEligible: strings.write_byte(b, '{'); json.write_string(b, "ReceiptEligible"); strings.write_byte(b, ':'); encode_DelayedTriggerOrigin(b, y._0); strings.write_byte(b, '}')
