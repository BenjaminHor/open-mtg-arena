decode_ForEachCategoryAction :: proc(v: json.Value, out: ^ForEachCategoryAction) -> bool {
	if v.kind != .Object do return fail("ForEachCategoryAction: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ForEachCategoryAction: no tag")
	switch tv.text {
	case "exile_from_pool":
		tmp: ForEachCategoryAction_ExileFromPool
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ForEachCategoryAction_ExileFromPool) -> bool {
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("ForEachCategoryAction::ExileFromPool.zone") } else { return fail("ForEachCategoryAction::ExileFromPool.zone missing") }
	if fv, found := get_any(v, "up_to"); found { if !decode_bool(fv, &out.up_to) do return fail("ForEachCategoryAction::ExileFromPool.up_to") } else { out.up_to = default_ForEachCategoryAction_default_true() }
	return true
		}) { return fail("ForEachCategoryAction::ExileFromPool") }
		out^ = tmp
	case "put_counter":
		tmp: ForEachCategoryAction_PutCounter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ForEachCategoryAction_PutCounter) -> bool {
	if fv, found := get_any(v, "target"); found { if !decode_TargetFilter(fv, &out.target) do return fail("ForEachCategoryAction::PutCounter.target") } else { return fail("ForEachCategoryAction::PutCounter.target missing") }
	if fv, found := get_any(v, "counter_type"); found { if !decode_CounterType(fv, &out.counter_type) do return fail("ForEachCategoryAction::PutCounter.counter_type") } else { return fail("ForEachCategoryAction::PutCounter.counter_type missing") }
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("ForEachCategoryAction::PutCounter.count") } else { return fail("ForEachCategoryAction::PutCounter.count missing") }
	return true
		}) { return fail("ForEachCategoryAction::PutCounter") }
		out^ = tmp
	case: return fail("ForEachCategoryAction: unknown variant")
	}
	return true
}

encode_ForEachCategoryAction :: proc(b: ^strings.Builder, x: ForEachCategoryAction) {
	#partial switch y in x {
	case ForEachCategoryAction_ExileFromPool: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "exile_from_pool")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	member(b, first, "up_to"); encode_bool(b, y.up_to)
	}; strings.write_byte(b, '}')
	case ForEachCategoryAction_PutCounter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "put_counter")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	}
}

encode_ForEachCategoryAction_members :: proc(b: ^strings.Builder, x: ForEachCategoryAction, first: ^bool) {
	#partial switch y in x {
	case ForEachCategoryAction_ExileFromPool: member(b, first, "type"); json.write_string(b, "exile_from_pool")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	member(b, first, "up_to"); encode_bool(b, y.up_to)

	case ForEachCategoryAction_PutCounter: member(b, first, "type"); json.write_string(b, "put_counter")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)

	}
}

