encode_QuantityRef_members :: proc(b: ^strings.Builder, x: QuantityRef, first: ^bool) {
	#partial switch y in x {
	case QuantityRef_HandSize: member(b, first, "type"); json.write_string(b, "HandSize")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case QuantityRef_LifeTotal: member(b, first, "type"); json.write_string(b, "LifeTotal")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case QuantityRef_GraveyardSize: member(b, first, "type"); json.write_string(b, "GraveyardSize")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case QuantityRef_LifeAboveStarting: _ = y; member(b, first, "type"); json.write_string(b, "LifeAboveStarting")
	case QuantityRef_StartingLifeTotal: member(b, first, "type"); json.write_string(b, "StartingLifeTotal")
	if !(skip_QuantityRef_is_player_scope_controller_PlayerScope(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }

	case QuantityRef_StartingDeckSize: member(b, first, "type"); json.write_string(b, "StartingDeckSize")
	if !(skip_QuantityRef_is_player_scope_controller_PlayerScope(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }

	case QuantityRef_TriggeringDiscoverValue: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringDiscoverValue")
	case QuantityRef_TriggeringScryLookCount: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringScryLookCount")
