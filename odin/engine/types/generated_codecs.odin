decode_AdditionalCostInstancePayment :: proc(v: json.Value, out: ^AdditionalCostInstancePayment) -> bool {
	when COVERAGE do cov_hit("AdditionalCostInstancePayment")
	if v.kind != .Object do return fail("AdditionalCostInstancePayment: not an object")
	if fv, found := get_any(v, "origin"); found { if !decode_AdditionalCostOrigin(fv, &out.origin) do return fail("AdditionalCostInstancePayment.origin") } else { out.origin = AdditionalCostOrigin.Other }
	if fv, found := get_any(v, "origin_ordinal"); found { if !decode_u32(fv, &out.origin_ordinal) do return fail("AdditionalCostInstancePayment.origin_ordinal") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("AdditionalCostInstancePayment.count") }
	if fv, found := get_any(v, "grant_source"); found { if !dec_opt_ObjectId(fv, &out.grant_source) do return fail("AdditionalCostInstancePayment.grant_source") }
	return true
}

encode_AdditionalCostInstancePayment :: proc(b: ^strings.Builder, x: AdditionalCostInstancePayment) {
	strings.write_byte(b, '{')
	f := true
	encode_AdditionalCostInstancePayment_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_AdditionalCostInstancePayment_members :: proc(b: ^strings.Builder, x: AdditionalCostInstancePayment, first: ^bool) {
	if !(skip_AdditionalCostInstancePayment_AdditionalCostOrigin_is_other_AdditionalCostOrigin(x.origin)) { member(b, first, "origin"); encode_AdditionalCostOrigin(b, x.origin) }
	if !(x.origin_ordinal == 0) { member(b, first, "origin_ordinal"); encode_u32(b, x.origin_ordinal) }
	if !(x.count == 0) { member(b, first, "count"); encode_u32(b, x.count) }
	if !(x.grant_source == nil) { member(b, first, "grant_source"); enc_opt_ObjectId(b, x.grant_source) }
}

