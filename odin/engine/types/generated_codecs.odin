	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaitingFor_AssistChoosePlayer: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AssistChoosePlayer"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "candidates"); enc_dyn_PlayerId(b, y.candidates)
