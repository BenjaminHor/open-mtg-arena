	case "Legs": when COVERAGE do cov_hit("UnpaidCostRemainder::Legs"); tmp: UnpaidCostRemainder_Legs; if !decode_AbilityCost(body, &tmp._0) do return fail("UnpaidCostRemainder::Legs"); out^ = tmp
