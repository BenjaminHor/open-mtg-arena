decode_RoomCopiableHalves :: proc(v: json.Value, out: ^RoomCopiableHalves) -> bool {
	if v.kind != .Object do return fail("RoomCopiableHalves: not an object")
	if fv, found := get_any(v, "left"); found { if !decode_RoomHalfIdentity(fv, &out.left) do return fail("RoomCopiableHalves.left") } else { return fail("RoomCopiableHalves.left missing") }
	if fv, found := get_any(v, "right"); found { if !dec_opt_RoomHalfIdentity(fv, &out.right) do return fail("RoomCopiableHalves.right") }
	return true
}

