decode_CostReduction :: proc(v: json.Value, out: ^CostReduction) -> bool {
	if v.kind != .Object do return fail("CostReduction: not an object")
	if fv, found := get_any(v, "mode"); found { if !decode_CostModifyMode(fv, &out.mode) do return fail("CostReduction.mode") }
	if fv, found := get_any(v, "amount_per"); found { if !decode_u32(fv, &out.amount_per) do return fail("CostReduction.amount_per") } else { return fail("CostReduction.amount_per missing") }
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("CostReduction.count") } else { return fail("CostReduction.count missing") }
	if fv, found := get_any(v, "condition"); found { if !dec_opt_ParsedCondition(fv, &out.condition) do return fail("CostReduction.condition") }
	return true
}

encode_CostReduction :: proc(b: ^strings.Builder, x: CostReduction) {
