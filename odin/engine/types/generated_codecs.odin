decode_ParkedDamageBatch :: proc(v: json.Value, out: ^ParkedDamageBatch) -> bool {
	when COVERAGE do cov_hit("ParkedDamageBatch")
	if v.kind != .Object do return fail("ParkedDamageBatch: not an object")
	if fv, found := get_any(v, "deferred"); found { if !dec_dyn_DeferredDamageChoice(fv, &out.deferred) do return fail("ParkedDamageBatch.deferred") }
	if fv, found := get_any(v, "held"); found { if !dec_dyn_HeldBatchRider(fv, &out.held) do return fail("ParkedDamageBatch.held") }
	if fv, found := get_any(v, "split"); found { if !dec_dyn_SplitDamagePortion(fv, &out.split) do return fail("ParkedDamageBatch.split") }
	if fv, found := get_any(v, "outcomes"); found { if !dec_opt_EventOutcomes(fv, &out.outcomes) do return fail("ParkedDamageBatch.outcomes") }
	if fv, found := get_any(v, "prevention_tally"); found { if !dec_dyn_PreventedDamageEntry(fv, &out.prevention_tally) do return fail("ParkedDamageBatch.prevention_tally") }
	return true
}

encode_ParkedDamageBatch :: proc(b: ^strings.Builder, x: ParkedDamageBatch) {
	strings.write_byte(b, '{')
	f := true
	encode_ParkedDamageBatch_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ParkedDamageBatch_members :: proc(b: ^strings.Builder, x: ParkedDamageBatch, first: ^bool) {
	if !((len(x.deferred) == 0)) { member(b, first, "deferred"); enc_dyn_DeferredDamageChoice(b, x.deferred) }
	if !((len(x.held) == 0)) { member(b, first, "held"); enc_dyn_HeldBatchRider(b, x.held) }
	if !((len(x.split) == 0)) { member(b, first, "split"); enc_dyn_SplitDamagePortion(b, x.split) }
	if !(x.outcomes == nil) { member(b, first, "outcomes"); enc_opt_EventOutcomes(b, x.outcomes) }
	if !((len(x.prevention_tally) == 0)) { member(b, first, "prevention_tally"); enc_dyn_PreventedDamageEntry(b, x.prevention_tally) }
}

