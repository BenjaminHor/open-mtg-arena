	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_SpeedChanged: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SpeedChanged"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
