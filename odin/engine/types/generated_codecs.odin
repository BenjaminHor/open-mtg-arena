	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("AssistState: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("AssistState: not a string or object")
	}
	switch variant {
	case "NotOffered": when COVERAGE do cov_hit("AssistState::NotOffered"); out^ = AssistState_NotOffered{}
	case "Offered": when COVERAGE do cov_hit("AssistState::Offered"); out^ = AssistState_Offered{}
	case "Committed": when COVERAGE do cov_hit("AssistState::Committed");
		tmp: AssistState_Committed
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^AssistState_Committed) -> bool {
	if fv, found := get_any(v, "helper"); found { if !decode_PlayerId(fv, &out.helper) do return fail("AssistState::Committed.helper") } else { return fail("AssistState::Committed.helper missing") }
	if fv, found := get_any(v, "generic"); found { if !decode_u32(fv, &out.generic) do return fail("AssistState::Committed.generic") } else { return fail("AssistState::Committed.generic missing") }
	return true
		}) { return fail("AssistState::Committed") }
		out^ = tmp
	case "PaymentStarted": when COVERAGE do cov_hit("AssistState::PaymentStarted");
		tmp: AssistState_PaymentStarted
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^AssistState_PaymentStarted) -> bool {
	if fv, found := get_any(v, "helper"); found { if !decode_PlayerId(fv, &out.helper) do return fail("AssistState::PaymentStarted.helper") } else { return fail("AssistState::PaymentStarted.helper missing") }
	if fv, found := get_any(v, "generic"); found { if !decode_u32(fv, &out.generic) do return fail("AssistState::PaymentStarted.generic") } else { return fail("AssistState::PaymentStarted.generic missing") }
	return true
		}) { return fail("AssistState::PaymentStarted") }
		out^ = tmp
	case "Paid": when COVERAGE do cov_hit("AssistState::Paid");
		tmp: AssistState_Paid
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^AssistState_Paid) -> bool {
	if fv, found := get_any(v, "helper"); found { if !decode_PlayerId(fv, &out.helper) do return fail("AssistState::Paid.helper") } else { return fail("AssistState::Paid.helper missing") }
	if fv, found := get_any(v, "generic"); found { if !decode_u32(fv, &out.generic) do return fail("AssistState::Paid.generic") } else { return fail("AssistState::Paid.generic missing") }
	return true
		}) { return fail("AssistState::Paid") }
		out^ = tmp
	case: return fail("AssistState: unknown variant")
	}
	return true
}

encode_AssistState :: proc(b: ^strings.Builder, x: AssistState) {
	#partial switch y in x {
	case AssistState_NotOffered: _ = y; json.write_string(b, "NotOffered")
	case AssistState_Offered: _ = y; json.write_string(b, "Offered")
	case AssistState_Committed: strings.write_byte(b, '{'); json.write_string(b, "Committed"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "helper"); encode_PlayerId(b, y.helper)
	member(b, first, "generic"); encode_u32(b, y.generic)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case AssistState_PaymentStarted: strings.write_byte(b, '{'); json.write_string(b, "PaymentStarted"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "helper"); encode_PlayerId(b, y.helper)
	member(b, first, "generic"); encode_u32(b, y.generic)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case AssistState_Paid: strings.write_byte(b, '{'); json.write_string(b, "Paid"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "helper"); encode_PlayerId(b, y.helper)
	member(b, first, "generic"); encode_u32(b, y.generic)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_ActivationResidual :: proc(v: json.Value, out: ^ActivationResidual) -> bool {
	when COVERAGE do cov_hit("ActivationResidual")
	if v.kind != .String do return fail("ActivationResidual: not a string")
	str := v.text
	switch str {
	case "None": when COVERAGE do cov_hit("ActivationResidual::None"); out^ = .None
	case "XMana": when COVERAGE do cov_hit("ActivationResidual::XMana"); out^ = .XMana
	case "ManaLeg": when COVERAGE do cov_hit("ActivationResidual::ManaLeg"); out^ = .ManaLeg
	case: return fail("ActivationResidual: unknown variant")
	}
	return true
}

encode_ActivationResidual :: proc(b: ^strings.Builder, x: ActivationResidual) {
	@(static, rodata) NAMES := [ActivationResidual]string{
		.None = "None",
		.XMana = "XMana",
		.ManaLeg = "ManaLeg",
	}
	json.write_string(b, NAMES[x])
}

