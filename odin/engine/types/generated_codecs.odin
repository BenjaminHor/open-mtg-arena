decode_RepeatContinuation :: proc(v: json.Value, out: ^RepeatContinuation) -> bool {
	if v.kind != .Object do return fail("RepeatContinuation: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("RepeatContinuation: no tag")
	switch tv.text {
	case "ControllerChoice": out^ = RepeatContinuation_ControllerChoice{}
	case "UntilStopConditions":
		tmp: RepeatContinuation_UntilStopConditions
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^RepeatContinuation_UntilStopConditions) -> bool {
	if fv, found := get_any(v, "stop_on_put_to_hand"); found { if !decode_bool(fv, &out.stop_on_put_to_hand) do return fail("RepeatContinuation::UntilStopConditions.stop_on_put_to_hand") } else { return fail("RepeatContinuation::UntilStopConditions.stop_on_put_to_hand missing") }
	if fv, found := get_any(v, "stop_on_duplicate_exiled_names"); found { if !decode_bool(fv, &out.stop_on_duplicate_exiled_names) do return fail("RepeatContinuation::UntilStopConditions.stop_on_duplicate_exiled_names") } else { return fail("RepeatContinuation::UntilStopConditions.stop_on_duplicate_exiled_names missing") }
	return true
		}) { return fail("RepeatContinuation::UntilStopConditions") }
		out^ = tmp
	case "WhileCondition":
		tmp: RepeatContinuation_WhileCondition
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^RepeatContinuation_WhileCondition) -> bool {
	if fv, found := get_any(v, "condition"); found { if !dec_ptr_AbilityCondition(fv, &out.condition) do return fail("RepeatContinuation::WhileCondition.condition") } else { return fail("RepeatContinuation::WhileCondition.condition missing") }
	if fv, found := get_any(v, "max_iterations"); found { if !dec_opt_u32(fv, &out.max_iterations) do return fail("RepeatContinuation::WhileCondition.max_iterations") }
	return true
		}) { return fail("RepeatContinuation::WhileCondition") }
		out^ = tmp
	case: return fail("RepeatContinuation: unknown variant")
	}
	return true
}

encode_RepeatContinuation :: proc(b: ^strings.Builder, x: RepeatContinuation) {
	#partial switch y in x {
	case RepeatContinuation_ControllerChoice: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ControllerChoice"); strings.write_byte(b, '}')
	case RepeatContinuation_UntilStopConditions: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "UntilStopConditions"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "stop_on_put_to_hand"); encode_bool(b, y.stop_on_put_to_hand)
	member(b, first, "stop_on_duplicate_exiled_names"); encode_bool(b, y.stop_on_duplicate_exiled_names)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case RepeatContinuation_WhileCondition: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "WhileCondition"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "condition"); enc_ptr_AbilityCondition(b, y.condition)
	if !(y.max_iterations == nil) { member(b, first, "max_iterations"); enc_opt_u32(b, y.max_iterations) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

