	member(b, first, "owner"); encode_PlayerId(b, x.owner)
	member(b, first, "root"); enc_ptr_ResolvedAbility(b, x.root)
	if !((len(x.transcript) == 0)) { member(b, first, "transcript"); enc_dyn_ResolutionPaymentTranscriptEntry(b, x.transcript) }
	member(b, first, "base_waiting_for"); encode_WaitingFor(b, x.base_waiting_for)
	if !(x.resolving_trigger_context == nil) { member(b, first, "resolving_trigger_context"); enc_opt_ResolvingTriggerContext(b, x.resolving_trigger_context) }
	if !(x.recovered == nil) { member(b, first, "recovered"); enc_ptr_PaymentRecoveryCheckpoint(b, x.recovered) }
}

