decode_PendingCombatDamageReplacement :: proc(v: json.Value, out: ^PendingCombatDamageReplacement) -> bool {
	when COVERAGE do cov_hit("PendingCombatDamageReplacement")
	if v.kind != .Object do return fail("PendingCombatDamageReplacement: not an object")
	if fv, found := get_any(v, "entries"); found { if !dec_dyn_PendingCombatDamageEntry(fv, &out.entries) do return fail("PendingCombatDamageReplacement.entries") } else { return fail("PendingCombatDamageReplacement.entries missing") }
	if fv, found := get_any(v, "resolved"); found { if !dec_dyn_PendingCombatLegProgress(fv, &out.resolved) do return fail("PendingCombatDamageReplacement.resolved") } else { return fail("PendingCombatDamageReplacement.resolved missing") }
	if fv, found := get_any(v, "one_shot_applications"); found { if !dec_dyn_t2_AppliedReplacementKey_ObjectId(fv, &out.one_shot_applications) do return fail("PendingCombatDamageReplacement.one_shot_applications") }
	if fv, found := get_any(v, "settled_guards"); found { if !dec_dyn_SettledDamageGuard(fv, &out.settled_guards) do return fail("PendingCombatDamageReplacement.settled_guards") }
	return true
}

