encode_ResolutionCastCleanup_members :: proc(b: ^strings.Builder, x: ResolutionCastCleanup, first: ^bool) {
	member(b, first, "source_id"); encode_ObjectId(b, x.source_id)
	if !(x.offer_id == nil) { member(b, first, "offer_id"); enc_opt_ResolutionCastOfferId(b, x.offer_id) }
	member(b, first, "face_policy"); encode_ResolutionCastFacePolicy(b, x.face_policy)
	member(b, first, "exiled_misses"); enc_dyn_ObjectId(b, x.exiled_misses)
	member(b, first, "reject_action"); encode_ResolutionMvRejectAction(b, x.reject_action)
	member(b, first, "success_action"); encode_ResolutionCastSuccessAction(b, x.success_action)
	if !((len(x.delayed_trigger_receipts) == 0)) { member(b, first, "delayed_trigger_receipts"); enc_dyn_ResolutionCastDelayedTriggerReceipt(b, x.delayed_trigger_receipts) }
	if !(x.indicated_action == nil) { member(b, first, "indicated_action"); enc_ptr_IndicatedActionLimit(b, x.indicated_action) }
}

decode_EmergeSacrificeQuality :: proc(v: json.Value, out: ^EmergeSacrificeQuality) -> bool {
	when COVERAGE do cov_hit("EmergeSacrificeQuality")
	if v.kind != .Object do return fail("EmergeSacrificeQuality: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("EmergeSacrificeQuality: no tag")
	switch tv.text {
	case "Artifact": when COVERAGE do cov_hit("EmergeSacrificeQuality::Artifact"); out^ = EmergeSacrificeQuality_Artifact{}
	case "Battle": when COVERAGE do cov_hit("EmergeSacrificeQuality::Battle"); out^ = EmergeSacrificeQuality_Battle{}
	case "Card": when COVERAGE do cov_hit("EmergeSacrificeQuality::Card"); out^ = EmergeSacrificeQuality_Card{}
	case "Creature": when COVERAGE do cov_hit("EmergeSacrificeQuality::Creature"); out^ = EmergeSacrificeQuality_Creature{}
	case "Enchantment": when COVERAGE do cov_hit("EmergeSacrificeQuality::Enchantment"); out^ = EmergeSacrificeQuality_Enchantment{}
	case "Instant": when COVERAGE do cov_hit("EmergeSacrificeQuality::Instant"); out^ = EmergeSacrificeQuality_Instant{}
	case "Kindred": when COVERAGE do cov_hit("EmergeSacrificeQuality::Kindred"); out^ = EmergeSacrificeQuality_Kindred{}
	case "Land": when COVERAGE do cov_hit("EmergeSacrificeQuality::Land"); out^ = EmergeSacrificeQuality_Land{}
	case "Permanent": when COVERAGE do cov_hit("EmergeSacrificeQuality::Permanent"); out^ = EmergeSacrificeQuality_Permanent{}
	case "Planeswalker": when COVERAGE do cov_hit("EmergeSacrificeQuality::Planeswalker"); out^ = EmergeSacrificeQuality_Planeswalker{}
	case "Sorcery": when COVERAGE do cov_hit("EmergeSacrificeQuality::Sorcery"); out^ = EmergeSacrificeQuality_Sorcery{}
	case "Subtype": when COVERAGE do cov_hit("EmergeSacrificeQuality::Subtype"); tmp: EmergeSacrificeQuality_Subtype; if !decode_string(json.get_or_null(v, "data"), &tmp._0) do return fail("EmergeSacrificeQuality::Subtype"); out^ = tmp
	case: return fail("EmergeSacrificeQuality: unknown variant")
	}
	return true
}

encode_EmergeSacrificeQuality :: proc(b: ^strings.Builder, x: EmergeSacrificeQuality) {
	#partial switch y in x {
	case EmergeSacrificeQuality_Artifact: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Artifact"); strings.write_byte(b, '}')
	case EmergeSacrificeQuality_Battle: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Battle"); strings.write_byte(b, '}')
	case EmergeSacrificeQuality_Card: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Card"); strings.write_byte(b, '}')
	case EmergeSacrificeQuality_Creature: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Creature"); strings.write_byte(b, '}')
	case EmergeSacrificeQuality_Enchantment: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Enchantment"); strings.write_byte(b, '}')
	case EmergeSacrificeQuality_Instant: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Instant"); strings.write_byte(b, '}')
	case EmergeSacrificeQuality_Kindred: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Kindred"); strings.write_byte(b, '}')
	case EmergeSacrificeQuality_Land: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Land"); strings.write_byte(b, '}')
	case EmergeSacrificeQuality_Permanent: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Permanent"); strings.write_byte(b, '}')
	case EmergeSacrificeQuality_Planeswalker: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Planeswalker"); strings.write_byte(b, '}')
	case EmergeSacrificeQuality_Sorcery: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Sorcery"); strings.write_byte(b, '}')
	case EmergeSacrificeQuality_Subtype: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Subtype"); member(b, &f, "data"); encode_string(b, y._0); strings.write_byte(b, '}')
	}
}

