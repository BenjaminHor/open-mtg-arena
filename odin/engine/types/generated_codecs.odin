decode_DeckList :: proc(v: json.Value, out: ^DeckList) -> bool {
	when COVERAGE do cov_hit("DeckList")
	if v.kind != .Object do return fail("DeckList: not an object")
	if fv, found := get_any(v, "booster_pack_pool"); found { if !dec_opt_dyn_string(fv, &out.booster_pack_pool) do return fail("DeckList.booster_pack_pool") }
	if fv, found := get_any(v, "player"); found { if !decode_PlayerDeckList(fv, &out.player) do return fail("DeckList.player") } else { return fail("DeckList.player missing") }
	if fv, found := get_any(v, "opponent"); found { if !decode_PlayerDeckList(fv, &out.opponent) do return fail("DeckList.opponent") } else { return fail("DeckList.opponent missing") }
	if fv, found := get_any(v, "ai_decks"); found { if !dec_dyn_PlayerDeckList(fv, &out.ai_decks) do return fail("DeckList.ai_decks") }
	if fv, found := get_any(v, "ai_difficulties"); found { if !dec_dyn_string(fv, &out.ai_difficulties) do return fail("DeckList.ai_difficulties") }
	if fv, found := get_any(v, "draft_set_codes", "draft_set_code"); found { if !dec_dyn_string(fv, &out.draft_set_codes) do return fail("DeckList.draft_set_codes") }
	return true
}

