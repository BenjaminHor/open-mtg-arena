decode_CardPredicateChoice :: proc(v: json.Value, out: ^CardPredicateChoice) -> bool {
	when COVERAGE do cov_hit("CardPredicateChoice")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("CardPredicateChoice: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("CardPredicateChoice: not a string or object")
	}
	switch variant {
	case "Land": when COVERAGE do cov_hit("CardPredicateChoice::Land"); out^ = CardPredicateChoice_Land{}
	case "Nonland": when COVERAGE do cov_hit("CardPredicateChoice::Nonland"); out^ = CardPredicateChoice_Nonland{}
	case "Color": when COVERAGE do cov_hit("CardPredicateChoice::Color"); tmp: CardPredicateChoice_Color; if !decode_ManaColor(body, &tmp._0) do return fail("CardPredicateChoice::Color"); out^ = tmp
	case: return fail("CardPredicateChoice: unknown variant")
	}
	return true
}

encode_CardPredicateChoice :: proc(b: ^strings.Builder, x: CardPredicateChoice) {
	#partial switch y in x {
	case CardPredicateChoice_Land: _ = y; json.write_string(b, "Land")
