decode_SearchSelectionConstraint :: proc(v: json.Value, out: ^SearchSelectionConstraint) -> bool {
	if v.kind != .Object do return fail("SearchSelectionConstraint: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("SearchSelectionConstraint: no tag")
	switch tv.text {
	case "None": out^ = SearchSelectionConstraint_None{}
	case "SharesQualities", "DistinctQualities":
		tmp: SearchSelectionConstraint_SharesQualities
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^SearchSelectionConstraint_SharesQualities) -> bool {
	if fv, found := get_any(v, "qualities"); found { if !dec_dyn_SharedQuality(fv, &out.qualities) do return fail("SearchSelectionConstraint::SharesQualities.qualities") } else { return fail("SearchSelectionConstraint::SharesQualities.qualities missing") }
	if fv, found := get_any(v, "relation"); found { if !decode_SharedQualityRelation(fv, &out.relation) do return fail("SearchSelectionConstraint::SharesQualities.relation") } else { out.relation = default_SearchSelectionConstraint_default_legacy_distinct_qualities_relation() }
	return true
		}) { return fail("SearchSelectionConstraint::SharesQualities") }
		out^ = tmp
	case "TotalManaValue":
		tmp: SearchSelectionConstraint_TotalManaValue
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^SearchSelectionConstraint_TotalManaValue) -> bool {
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("SearchSelectionConstraint::TotalManaValue.comparator") } else { return fail("SearchSelectionConstraint::TotalManaValue.comparator missing") }
	if fv, found := get_any(v, "value"); found { if !decode_i32(fv, &out.value) do return fail("SearchSelectionConstraint::TotalManaValue.value") } else { return fail("SearchSelectionConstraint::TotalManaValue.value missing") }
	return true
		}) { return fail("SearchSelectionConstraint::TotalManaValue") }
		out^ = tmp
	case "MatchEachFilter":
		tmp: SearchSelectionConstraint_MatchEachFilter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^SearchSelectionConstraint_MatchEachFilter) -> bool {
	if fv, found := get_any(v, "filters"); found { if !dec_dyn_TargetFilter(fv, &out.filters) do return fail("SearchSelectionConstraint::MatchEachFilter.filters") } else { return fail("SearchSelectionConstraint::MatchEachFilter.filters missing") }
	return true
		}) { return fail("SearchSelectionConstraint::MatchEachFilter") }
		out^ = tmp
	case: return fail("SearchSelectionConstraint: unknown variant")
	}
	return true
}

encode_SearchSelectionConstraint :: proc(b: ^strings.Builder, x: SearchSelectionConstraint) {
	#partial switch y in x {
	case SearchSelectionConstraint_None: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "None"); strings.write_byte(b, '}')
	case SearchSelectionConstraint_SharesQualities: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SharesQualities")
	member(b, first, "qualities"); enc_dyn_SharedQuality(b, y.qualities)
	member(b, first, "relation"); encode_SharedQualityRelation(b, y.relation)
	}; strings.write_byte(b, '}')
	case SearchSelectionConstraint_TotalManaValue: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TotalManaValue")
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_i32(b, y.value)
	}; strings.write_byte(b, '}')
	case SearchSelectionConstraint_MatchEachFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "MatchEachFilter")
	member(b, first, "filters"); enc_dyn_TargetFilter(b, y.filters)
	}; strings.write_byte(b, '}')
	}
}

encode_SearchSelectionConstraint_members :: proc(b: ^strings.Builder, x: SearchSelectionConstraint, first: ^bool) {
	#partial switch y in x {
	case SearchSelectionConstraint_None: _ = y; member(b, first, "type"); json.write_string(b, "None")
	case SearchSelectionConstraint_SharesQualities: member(b, first, "type"); json.write_string(b, "SharesQualities")
	member(b, first, "qualities"); enc_dyn_SharedQuality(b, y.qualities)
	member(b, first, "relation"); encode_SharedQualityRelation(b, y.relation)

	case SearchSelectionConstraint_TotalManaValue: member(b, first, "type"); json.write_string(b, "TotalManaValue")
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_i32(b, y.value)

	case SearchSelectionConstraint_MatchEachFilter: member(b, first, "type"); json.write_string(b, "MatchEachFilter")
	member(b, first, "filters"); enc_dyn_TargetFilter(b, y.filters)

	}
}

decode_SearchDestinationSplit :: proc(v: json.Value, out: ^SearchDestinationSplit) -> bool {
	if v.kind != .Object do return fail("SearchDestinationSplit: not an object")
	if fv, found := get_any(v, "primary_destination"); found { if !decode_Zone(fv, &out.primary_destination) do return fail("SearchDestinationSplit.primary_destination") } else { return fail("SearchDestinationSplit.primary_destination missing") }
	if fv, found := get_any(v, "primary_count"); found { if !decode_u32(fv, &out.primary_count) do return fail("SearchDestinationSplit.primary_count") } else { return fail("SearchDestinationSplit.primary_count missing") }
	if fv, found := get_any(v, "primary_enter_tapped"); found { if !decode_with_etb_tap_bool_compat(fv, &out.primary_enter_tapped) do return fail("SearchDestinationSplit.primary_enter_tapped") }
	if fv, found := get_any(v, "rest_destination"); found { if !decode_Zone(fv, &out.rest_destination) do return fail("SearchDestinationSplit.rest_destination") } else { return fail("SearchDestinationSplit.rest_destination missing") }
	return true
}

encode_SearchDestinationSplit :: proc(b: ^strings.Builder, x: SearchDestinationSplit) {
	strings.write_byte(b, '{')
	f := true
	encode_SearchDestinationSplit_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_SearchDestinationSplit_members :: proc(b: ^strings.Builder, x: SearchDestinationSplit, first: ^bool) {
	member(b, first, "primary_destination"); encode_Zone(b, x.primary_destination)
	member(b, first, "primary_count"); encode_u32(b, x.primary_count)
	if !(skip_SearchDestinationSplit_EtbTapState_is_unspecified(x.primary_enter_tapped)) { member(b, first, "primary_enter_tapped"); encode_with_etb_tap_bool_compat(b, x.primary_enter_tapped) }
	member(b, first, "rest_destination"); encode_Zone(b, x.rest_destination)
}

