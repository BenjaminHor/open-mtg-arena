	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_GiveEnergy: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "GiveEnergy"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_AddMana: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AddMana"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "mana"); enc_dyn_ManaType(b, y.mana)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_SetInfiniteMana: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SetInfiniteMana"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
