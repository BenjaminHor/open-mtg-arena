encode_TargetFilter_members :: proc(b: ^strings.Builder, x: TargetFilter, first: ^bool) {
	#partial switch y in x {
	case TargetFilter_None: _ = y; member(b, first, "type"); json.write_string(b, "None")
	case TargetFilter_Any: _ = y; member(b, first, "type"); json.write_string(b, "Any")
	case TargetFilter_Player: _ = y; member(b, first, "type"); json.write_string(b, "Player")
	case TargetFilter_Controller: _ = y; member(b, first, "type"); json.write_string(b, "Controller")
	case TargetFilter_SourceController: _ = y; member(b, first, "type"); json.write_string(b, "SourceController")
	case TargetFilter_ControllerAndControlledPermanents: member(b, first, "type"); json.write_string(b, "ControllerAndControlledPermanents")
	member(b, first, "permanent_type"); enc_opt_CoreType(b, y.permanent_type)
	if !(skip_TargetFilter_SourceExclusion_is_include_SourceExclusion(y.source_scope)) { member(b, first, "source_scope"); encode_SourceExclusion(b, y.source_scope) }

	case TargetFilter_Opponent: _ = y; member(b, first, "type"); json.write_string(b, "Opponent")
	case TargetFilter_SelfRef: _ = y; member(b, first, "type"); json.write_string(b, "SelfRef")
	case TargetFilter_GrantingObject: member(b, first, "type"); json.write_string(b, "GrantingObject")
	if !(y.bound == nil) { member(b, first, "bound"); enc_opt_ObjectIncarnationRef(b, y.bound) }

	case TargetFilter_SourceOrPaired: _ = y; member(b, first, "type"); json.write_string(b, "SourceOrPaired")
	case TargetFilter_Typed: member(b, first, "type"); json.write_string(b, "Typed"); encode_TypedFilter_members(b, y._0, first)
	case TargetFilter_Not: member(b, first, "type"); json.write_string(b, "Not")
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)

	case TargetFilter_Or: member(b, first, "type"); json.write_string(b, "Or")
	member(b, first, "filters"); enc_dyn_TargetFilter(b, y.filters)

	case TargetFilter_And: member(b, first, "type"); json.write_string(b, "And")
	member(b, first, "filters"); enc_dyn_TargetFilter(b, y.filters)

	case TargetFilter_StackAbility: member(b, first, "type"); json.write_string(b, "StackAbility")
	if !(y.controller == nil) { member(b, first, "controller"); enc_opt_ControllerRef(b, y.controller) }
	if !(y.tag == nil) { member(b, first, "tag"); enc_opt_AbilityTag(b, y.tag) }
	if !(y.kind == nil) { member(b, first, "kind"); enc_opt_StackAbilityKind(b, y.kind) }

	case TargetFilter_StackSpell: _ = y; member(b, first, "type"); json.write_string(b, "StackSpell")
	case TargetFilter_CastingSpell: _ = y; member(b, first, "type"); json.write_string(b, "CastingSpell")
	case TargetFilter_SpecificObject: member(b, first, "type"); json.write_string(b, "SpecificObject")
	member(b, first, "id"); encode_ObjectId(b, y.id)

	case TargetFilter_SpecificPlayer: member(b, first, "type"); json.write_string(b, "SpecificPlayer")
	member(b, first, "id"); encode_PlayerId(b, y.id)

	case TargetFilter_PlayerWhoChoseLabel: member(b, first, "type"); json.write_string(b, "PlayerWhoChoseLabel")
	member(b, first, "label"); encode_string(b, y.label)

	case TargetFilter_PlayerMatching: member(b, first, "type"); json.write_string(b, "PlayerMatching")
	member(b, first, "player"); enc_ptr_PlayerFilter(b, y.player)

	case TargetFilter_Neighbor: member(b, first, "type"); json.write_string(b, "Neighbor")
	member(b, first, "direction"); encode_SeatDirection(b, y.direction)

	case TargetFilter_ScopedPlayer: _ = y; member(b, first, "type"); json.write_string(b, "ScopedPlayer")
	case TargetFilter_AttachedTo: _ = y; member(b, first, "type"); json.write_string(b, "AttachedTo")
	case TargetFilter_LastCreated: _ = y; member(b, first, "type"); json.write_string(b, "LastCreated")
	case TargetFilter_LastRevealed: _ = y; member(b, first, "type"); json.write_string(b, "LastRevealed")
	case TargetFilter_LastZoneChanged: _ = y; member(b, first, "type"); json.write_string(b, "LastZoneChanged")
	case TargetFilter_CostPaidObject: _ = y; member(b, first, "type"); json.write_string(b, "CostPaidObject")
	case TargetFilter_AmassedArmy: _ = y; member(b, first, "type"); json.write_string(b, "AmassedArmy")
	case TargetFilter_ChosenCard: _ = y; member(b, first, "type"); json.write_string(b, "ChosenCard")
	case TargetFilter_TrackedSet: member(b, first, "type"); json.write_string(b, "TrackedSet")
	member(b, first, "id"); encode_TrackedSetId(b, y.id)

	case TargetFilter_TrackedSetFiltered: member(b, first, "type"); json.write_string(b, "TrackedSetFiltered")
	member(b, first, "id"); encode_TrackedSetId(b, y.id)
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)
	if !(y.caused_by == nil) { member(b, first, "caused_by"); enc_opt_ThisWayCause(b, y.caused_by) }

	case TargetFilter_ChoiceAssignment: member(b, first, "type"); json.write_string(b, "ChoiceAssignment")
	member(b, first, "side"); encode_ChoiceAssignmentSide(b, y.side)

	case TargetFilter_ExiledBySource: _ = y; member(b, first, "type"); json.write_string(b, "ExiledBySource")
	case TargetFilter_ExiledCardByIndex: member(b, first, "type"); json.write_string(b, "ExiledCardByIndex")
	member(b, first, "index"); encode_u32(b, y.index)

	case TargetFilter_TriggeringSpellController: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringSpellController")
	case TargetFilter_TriggeringSpellOwner: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringSpellOwner")
	case TargetFilter_TriggeringPlayer: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringPlayer")
	case TargetFilter_TriggeringSource: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringSource")
	case TargetFilter_AttackedPlayerOrPlaneswalker: _ = y; member(b, first, "type"); json.write_string(b, "AttackedPlayerOrPlaneswalker")
	case TargetFilter_EventTarget: _ = y; member(b, first, "type"); json.write_string(b, "EventTarget")
	case TargetFilter_TriggeringSourceController: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringSourceController")
	case TargetFilter_EventTargetController: _ = y; member(b, first, "type"); json.write_string(b, "EventTargetController")
	case TargetFilter_ParentTarget: _ = y; member(b, first, "type"); json.write_string(b, "ParentTarget")
	case TargetFilter_ParentTargetSlot: member(b, first, "type"); json.write_string(b, "ParentTargetSlot")
	member(b, first, "index"); encode_int(b, y.index)

	case TargetFilter_DeclaredPlayer: member(b, first, "type"); json.write_string(b, "DeclaredPlayer")
	member(b, first, "group"); encode_ChosenGroupId(b, y.group)

	case TargetFilter_ParentTargetController: _ = y; member(b, first, "type"); json.write_string(b, "ParentTargetController")
	case TargetFilter_ParentTargetOwner: _ = y; member(b, first, "type"); json.write_string(b, "ParentTargetOwner")
	case TargetFilter_AffectedObjectOwner: _ = y; member(b, first, "type"); json.write_string(b, "AffectedObjectOwner")
	case TargetFilter_SourceChosenPlayer: _ = y; member(b, first, "type"); json.write_string(b, "SourceChosenPlayer")
	case TargetFilter_OriginalController: _ = y; member(b, first, "type"); json.write_string(b, "OriginalController")
	case TargetFilter_OriginalSource: _ = y; member(b, first, "type"); json.write_string(b, "OriginalSource")
	case TargetFilter_PostReplacementSourceController: _ = y; member(b, first, "type"); json.write_string(b, "PostReplacementSourceController")
	case TargetFilter_PostReplacementDamageSource: _ = y; member(b, first, "type"); json.write_string(b, "PostReplacementDamageSource")
	case TargetFilter_PostReplacementDamageTarget: _ = y; member(b, first, "type"); json.write_string(b, "PostReplacementDamageTarget")
	case TargetFilter_PostReplacementDamageTargetOwner: _ = y; member(b, first, "type"); json.write_string(b, "PostReplacementDamageTargetOwner")
	case TargetFilter_DefendingPlayer: _ = y; member(b, first, "type"); json.write_string(b, "DefendingPlayer")
	case TargetFilter_HasChosenName: _ = y; member(b, first, "type"); json.write_string(b, "HasChosenName")
	case TargetFilter_ChosenDamageSource: member(b, first, "type"); json.write_string(b, "ChosenDamageSource")
	if !(y.filter == nil) { member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter) }

	case TargetFilter_Named: member(b, first, "type"); json.write_string(b, "Named")
	member(b, first, "name"); encode_string(b, y.name)

	case TargetFilter_Owner: _ = y; member(b, first, "type"); json.write_string(b, "Owner")
	case TargetFilter_AllPlayers: _ = y; member(b, first, "type"); json.write_string(b, "AllPlayers")
	}
}

decode_FormatConfig :: proc(v: json.Value, out: ^FormatConfig) -> bool {
	when COVERAGE do cov_hit("FormatConfig")
	if v.kind != .Object do return fail("FormatConfig: not an object")
	if fv, found := get_any(v, "format"); found { if !decode_GameFormat(fv, &out.format) do return fail("FormatConfig.format") } else { return fail("FormatConfig.format missing") }
	if fv, found := get_any(v, "starting_life"); found { if !decode_i32(fv, &out.starting_life) do return fail("FormatConfig.starting_life") } else { return fail("FormatConfig.starting_life missing") }
	if fv, found := get_any(v, "min_players"); found { if !decode_u8(fv, &out.min_players) do return fail("FormatConfig.min_players") } else { return fail("FormatConfig.min_players missing") }
	if fv, found := get_any(v, "max_players"); found { if !decode_u8(fv, &out.max_players) do return fail("FormatConfig.max_players") } else { return fail("FormatConfig.max_players missing") }
	if fv, found := get_any(v, "deck_size"); found { if !decode_DeckSizeRule(fv, &out.deck_size) do return fail("FormatConfig.deck_size") } else { return fail("FormatConfig.deck_size missing") }
	if fv, found := get_any(v, "deck_size_origin"); found { if !decode_DeckSizeOrigin(fv, &out.deck_size_origin) do return fail("FormatConfig.deck_size_origin") }
	if fv, found := get_any(v, "singleton"); found { if !decode_bool(fv, &out.singleton) do return fail("FormatConfig.singleton") } else { return fail("FormatConfig.singleton missing") }
	if fv, found := get_any(v, "command_zone"); found { if !decode_bool(fv, &out.command_zone) do return fail("FormatConfig.command_zone") } else { return fail("FormatConfig.command_zone missing") }
	if fv, found := get_any(v, "commander_damage_threshold"); found { if !dec_opt_u8(fv, &out.commander_damage_threshold) do return fail("FormatConfig.commander_damage_threshold") }
	if fv, found := get_any(v, "poison_counter_threshold"); found { if !dec_opt_u8(fv, &out.poison_counter_threshold) do return fail("FormatConfig.poison_counter_threshold") }
	if fv, found := get_any(v, "range_of_influence"); found { if !dec_ptr_RangeOfInfluenceConfig(fv, &out.range_of_influence) do return fail("FormatConfig.range_of_influence") }
	if fv, found := get_any(v, "team_based"); found { if !decode_bool(fv, &out.team_based) do return fail("FormatConfig.team_based") } else { return fail("FormatConfig.team_based missing") }
	if fv, found := get_any(v, "archenemy_player"); found { if !dec_opt_PlayerId(fv, &out.archenemy_player) do return fail("FormatConfig.archenemy_player") }
	if fv, found := get_any(v, "uses_commander"); found { if !decode_bool(fv, &out.uses_commander) do return fail("FormatConfig.uses_commander") } else { return fail("FormatConfig.uses_commander missing") }
	if fv, found := get_any(v, "supplies_fixed_deck"); found { if !decode_bool(fv, &out.supplies_fixed_deck) do return fail("FormatConfig.supplies_fixed_deck") }
	if fv, found := get_any(v, "sideboard_policy"); found { if !decode_SideboardPolicy(fv, &out.sideboard_policy) do return fail("FormatConfig.sideboard_policy") } else { out.sideboard_policy = default_FormatConfig_default_sideboard_policy_fallback() }
	if fv, found := get_any(v, "default_deck_copy_limit"); found { if !decode_DeckCopyLimit(fv, &out.default_deck_copy_limit) do return fail("FormatConfig.default_deck_copy_limit") } else { out.default_deck_copy_limit = default_FormatConfig_default_deck_copy_limit_fallback() }
	if fv, found := get_any(v, "allow_debug_actions"); found { if !decode_bool(fv, &out.allow_debug_actions) do return fail("FormatConfig.allow_debug_actions") }
	if fv, found := get_any(v, "horde_ruleset"); found { if !dec_opt_HordeRuleset(fv, &out.horde_ruleset) do return fail("FormatConfig.horde_ruleset") }
	if fv, found := get_any(v, "custom_rules"); found { if !dec_ptr_CustomFormatRules(fv, &out.custom_rules) do return fail("FormatConfig.custom_rules") }
	return true
}

encode_FormatConfig :: proc(b: ^strings.Builder, x: FormatConfig) {
	strings.write_byte(b, '{')
	f := true
	encode_FormatConfig_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_FormatConfig_members :: proc(b: ^strings.Builder, x: FormatConfig, first: ^bool) {
	member(b, first, "format"); encode_GameFormat(b, x.format)
	member(b, first, "starting_life"); encode_i32(b, x.starting_life)
	member(b, first, "min_players"); encode_u8(b, x.min_players)
	member(b, first, "max_players"); encode_u8(b, x.max_players)
	member(b, first, "deck_size"); encode_DeckSizeRule(b, x.deck_size)
	if !(skip_FormatConfig_DeckSizeOrigin_is_registry_DeckSizeOrigin(x.deck_size_origin)) { member(b, first, "deck_size_origin"); encode_DeckSizeOrigin(b, x.deck_size_origin) }
	member(b, first, "singleton"); encode_bool(b, x.singleton)
	member(b, first, "command_zone"); encode_bool(b, x.command_zone)
	member(b, first, "commander_damage_threshold"); enc_opt_u8(b, x.commander_damage_threshold)
	member(b, first, "poison_counter_threshold"); enc_opt_u8(b, x.poison_counter_threshold)
	member(b, first, "range_of_influence"); enc_ptr_RangeOfInfluenceConfig(b, x.range_of_influence)
	member(b, first, "team_based"); encode_bool(b, x.team_based)
	if !(x.archenemy_player == nil) { member(b, first, "archenemy_player"); enc_opt_PlayerId(b, x.archenemy_player) }
	member(b, first, "uses_commander"); encode_bool(b, x.uses_commander)
	member(b, first, "supplies_fixed_deck"); encode_bool(b, x.supplies_fixed_deck)
	member(b, first, "sideboard_policy"); encode_SideboardPolicy(b, x.sideboard_policy)
	member(b, first, "default_deck_copy_limit"); encode_DeckCopyLimit(b, x.default_deck_copy_limit)
	member(b, first, "allow_debug_actions"); encode_bool(b, x.allow_debug_actions)
	if !(x.horde_ruleset == nil) { member(b, first, "horde_ruleset"); enc_opt_HordeRuleset(b, x.horde_ruleset) }
	if !(x.custom_rules == nil) { member(b, first, "custom_rules"); enc_ptr_CustomFormatRules(b, x.custom_rules) }
}

decode_CommanderDamageEntry :: proc(v: json.Value, out: ^CommanderDamageEntry) -> bool {
	when COVERAGE do cov_hit("CommanderDamageEntry")
	if v.kind != .Object do return fail("CommanderDamageEntry: not an object")
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("CommanderDamageEntry.player") } else { return fail("CommanderDamageEntry.player missing") }
	if fv, found := get_any(v, "commander"); found { if !decode_ObjectId(fv, &out.commander) do return fail("CommanderDamageEntry.commander") } else { return fail("CommanderDamageEntry.commander missing") }
	if fv, found := get_any(v, "damage"); found { if !decode_u32(fv, &out.damage) do return fail("CommanderDamageEntry.damage") } else { return fail("CommanderDamageEntry.damage missing") }
	return true
}

