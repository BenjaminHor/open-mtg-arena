		tmp: PendingCostMoveCompletion_CompleteSelectedReturnToHand
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^PendingCostMoveCompletion_CompleteSelectedReturnToHand) -> bool {
	if fv, found := get_any(v, "selected"); found { if !dec_dyn_ObjectId(fv, &out.selected) do return fail("PendingCostMoveCompletion::CompleteSelectedReturnToHand.selected") } else { return fail("PendingCostMoveCompletion::CompleteSelectedReturnToHand.selected missing") }
	if fv, found := get_any(v, "automatic_remaining"); found { if !dec_opt_AbilityCost(fv, &out.automatic_remaining) do return fail("PendingCostMoveCompletion::CompleteSelectedReturnToHand.automatic_remaining") }
	return true
		}) { return fail("PendingCostMoveCompletion::CompleteSelectedReturnToHand") }
		out^ = tmp
