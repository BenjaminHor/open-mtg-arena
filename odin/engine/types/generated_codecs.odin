	when COVERAGE do cov_hit("CastingVariantFace")
	if v.kind != .String do return fail("CastingVariantFace: not a string")
	str := v.text
	switch str {
	case "Current": when COVERAGE do cov_hit("CastingVariantFace::Current"); out^ = .Current
	case "Left": when COVERAGE do cov_hit("CastingVariantFace::Left"); out^ = .Left
	case "Right": when COVERAGE do cov_hit("CastingVariantFace::Right"); out^ = .Right
	case: return fail("CastingVariantFace: unknown variant")
	}
	return true
}

