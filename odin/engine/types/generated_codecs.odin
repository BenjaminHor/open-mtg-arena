	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ParitySource: no tag")
	switch tv.text {
	case "Fixed": tmp: ParitySource_Fixed; if !decode_Parity(json.get_or_null(v, "value"), &tmp._0) do return fail("ParitySource::Fixed"); out^ = tmp
	case "LastNamedChoice": out^ = ParitySource_LastNamedChoice{}
	case "SourceChosen": out^ = ParitySource_SourceChosen{}
	case: return fail("ParitySource: unknown variant")
	}
	return true
}

