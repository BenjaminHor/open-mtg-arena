	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_SuppressTriggers: strings.write_byte(b, '{'); json.write_string(b, "SuppressTriggers"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source_filter"); encode_TargetFilter(b, y.source_filter)
	member(b, first, "trigger_source_filter"); enc_opt_TargetFilter(b, y.trigger_source_filter)
	member(b, first, "events"); enc_dyn_SuppressedTriggerEvent(b, y.events)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantBeBlocked: _ = y; json.write_string(b, "CantBeBlocked")
	case StaticMode_CantBeBlockedExceptBy: strings.write_byte(b, '{'); json.write_string(b, "CantBeBlockedExceptBy"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "kind"); encode_BlockExceptionKind(b, y.kind)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantBeBlockedBy: strings.write_byte(b, '{'); json.write_string(b, "CantBeBlockedBy"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantBeBlockedByMoreThan: strings.write_byte(b, '{'); json.write_string(b, "CantBeBlockedByMoreThan"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "max"); encode_u32(b, y.max)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantBeBlockedUnlessAllBlock: _ = y; json.write_string(b, "CantBeBlockedUnlessAllBlock")
	case StaticMode_AttachmentRestriction: strings.write_byte(b, '{'); json.write_string(b, "AttachmentRestriction"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_Protection: _ = y; json.write_string(b, "Protection")
	case StaticMode_Indestructible: _ = y; json.write_string(b, "Indestructible")
	case StaticMode_CantBeDestroyed: _ = y; json.write_string(b, "CantBeDestroyed")
	case StaticMode_CantBeRegenerated: _ = y; json.write_string(b, "CantBeRegenerated")
	case StaticMode_FlashBack: _ = y; json.write_string(b, "FlashBack")
	case StaticMode_Shroud: _ = y; json.write_string(b, "Shroud")
	case StaticMode_Hexproof: _ = y; json.write_string(b, "Hexproof")
	case StaticMode_Vigilance: _ = y; json.write_string(b, "Vigilance")
	case StaticMode_Menace: _ = y; json.write_string(b, "Menace")
	case StaticMode_Reach: _ = y; json.write_string(b, "Reach")
	case StaticMode_Flying: _ = y; json.write_string(b, "Flying")
	case StaticMode_Trample: _ = y; json.write_string(b, "Trample")
	case StaticMode_Deathtouch: _ = y; json.write_string(b, "Deathtouch")
	case StaticMode_Lifelink: _ = y; json.write_string(b, "Lifelink")
	case StaticMode_CantTap: _ = y; json.write_string(b, "CantTap")
	case StaticMode_CantUntap: _ = y; json.write_string(b, "CantUntap")
	case StaticMode_MustBeBlocked: strings.write_byte(b, '{'); json.write_string(b, "MustBeBlocked"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "by"); enc_opt_TargetFilter(b, y.by)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_MustBeBlockedByAll: strings.write_byte(b, '{'); json.write_string(b, "MustBeBlockedByAll"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	if !(y.blockers == nil) { member(b, first, "blockers"); enc_opt_TargetFilter(b, y.blockers) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_Goaded: _ = y; json.write_string(b, "Goaded")
	case StaticMode_MustAttackAwayFromSource: _ = y; json.write_string(b, "MustAttackAwayFromSource")
	case StaticMode_CombatAlone: strings.write_byte(b, '{'); json.write_string(b, "CombatAlone"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "action"); encode_CombatAloneAction(b, y.action)
	member(b, first, "requirement"); encode_CombatAloneRequirement(b, y.requirement)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantCrew: _ = y; json.write_string(b, "CantCrew")
	case StaticMode_CantPhaseIn: _ = y; json.write_string(b, "CantPhaseIn")
	case StaticMode_CrewContribution: strings.write_byte(b, '{'); json.write_string(b, "CrewContribution"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "kind"); encode_CrewContributionKind(b, y.kind)
	member(b, first, "actions"); enc_dyn_CrewAction(b, y.actions)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_MayLookAtTopOfLibrary: _ = y; json.write_string(b, "MayLookAtTopOfLibrary")
	case StaticMode_MayLookAtFaceDown: _ = y; json.write_string(b, "MayLookAtFaceDown")
	case StaticMode_CantBeTurnedFaceUp: _ = y; json.write_string(b, "CantBeTurnedFaceUp")
	case StaticMode_MayChooseNotToUntap: _ = y; json.write_string(b, "MayChooseNotToUntap")
	case StaticMode_AdditionalLandDrop: strings.write_byte(b, '{'); json.write_string(b, "AdditionalLandDrop"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "count"); encode_u8(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_EmblemStatic: _ = y; json.write_string(b, "EmblemStatic")
	case StaticMode_BlockRestriction: strings.write_byte(b, '{'); json.write_string(b, "BlockRestriction"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_NoMaximumHandSize: _ = y; json.write_string(b, "NoMaximumHandSize")
	case StaticMode_MaximumHandSize: strings.write_byte(b, '{'); json.write_string(b, "MaximumHandSize"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "modification"); encode_HandSizeModification(b, y.modification)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_MayPlayAdditionalLand: _ = y; json.write_string(b, "MayPlayAdditionalLand")
	case StaticMode_CantHaveKeyword: strings.write_byte(b, '{'); json.write_string(b, "CantHaveKeyword"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantWinTheGame: _ = y; json.write_string(b, "CantWinTheGame")
	case StaticMode_CantLoseTheGame: _ = y; json.write_string(b, "CantLoseTheGame")
	case StaticMode_LegendRuleDoesntApply: _ = y; json.write_string(b, "LegendRuleDoesntApply")
	case StaticMode_SpeedCanIncreaseBeyondFour: _ = y; json.write_string(b, "SpeedCanIncreaseBeyondFour")
	case StaticMode_DefilerCostReduction: strings.write_byte(b, '{'); json.write_string(b, "DefilerCostReduction"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "color"); encode_ManaColor(b, y.color)
	member(b, first, "life_cost"); encode_u32(b, y.life_cost)
	member(b, first, "mana_reduction"); encode_ManaCost(b, y.mana_reduction)
	if !(skip_StaticMode_CostReductionReach_is_spills_to_generic(y.reach)) { member(b, first, "reach"); encode_CostReductionReach(b, y.reach) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_SkipStep: strings.write_byte(b, '{'); json.write_string(b, "SkipStep"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "step"); encode_Phase(b, y.step)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_SpendManaAsAnyColor: strings.write_byte(b, '{'); json.write_string(b, "SpendManaAsAnyColor"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	if !(y.spell_filter == nil) { member(b, first, "spell_filter"); enc_opt_TargetFilter(b, y.spell_filter) }
	if !(y.activation_source_filter == nil) { member(b, first, "activation_source_filter"); enc_opt_TargetFilter(b, y.activation_source_filter) }
	if !(skip_StaticMode_ManaSpendPermission_is_any_color(y.concession)) { member(b, first, "concession"); encode_ManaSpendPermission(b, y.concession) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_PayLifeAsColoredMana: strings.write_byte(b, '{'); json.write_string(b, "PayLifeAsColoredMana"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "color"); encode_ManaColor(b, y.color)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_StepEndUnspentMana: strings.write_byte(b, '{'); json.write_string(b, "StepEndUnspentMana"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "filter"); enc_opt_ManaColor(b, y.filter)
	member(b, first, "action"); encode_StepEndManaAction(b, y.action)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_UnspentManaLossCausesLifeLoss: _ = y; json.write_string(b, "UnspentManaLossCausesLifeLoss")
	case StaticMode_WinFirstCoinFlipSetEachTurn: _ = y; json.write_string(b, "WinFirstCoinFlipSetEachTurn")
	case StaticMode_CanAttackWithDefender: _ = y; json.write_string(b, "CanAttackWithDefender")
	case StaticMode_IgnoreLandwalkForBlocking: strings.write_byte(b, '{'); json.write_string(b, "IgnoreLandwalkForBlocking"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "qualifier"); enc_opt_string(b, y.qualifier)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CanActivateAbilitiesAsThoughHaste: _ = y; json.write_string(b, "CanActivateAbilitiesAsThoughHaste")
	case StaticMode_CanBlockShadow: _ = y; json.write_string(b, "CanBlockShadow")
	case StaticMode_AssignNoCombatDamage: _ = y; json.write_string(b, "AssignNoCombatDamage")
	case StaticMode_UntapsDuringEachOtherPlayersUntapStep: _ = y; json.write_string(b, "UntapsDuringEachOtherPlayersUntapStep")
	case StaticMode_MaxUntapPerType: strings.write_byte(b, '{'); json.write_string(b, "MaxUntapPerType"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "max"); encode_u32(b, y.max)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_EntersWithAdditionalCounters: strings.write_byte(b, '{'); json.write_string(b, "EntersWithAdditionalCounters"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CountersCantBeRemoved: strings.write_byte(b, '{'); json.write_string(b, "CountersCantBeRemoved"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CountsAsNamed: strings.write_byte(b, '{'); json.write_string(b, "CountsAsNamed"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "name"); encode_string(b, y.name)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_Other: strings.write_byte(b, '{'); json.write_string(b, "Other"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	}
}

decode_ContinuousModification :: proc(v: json.Value, out: ^ContinuousModification) -> bool {
	if v.kind != .Object do return fail("ContinuousModification: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ContinuousModification: no tag")
	switch tv.text {
	case "CopyValues":
		tmp: ContinuousModification_CopyValues
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_CopyValues) -> bool {
	if fv, found := get_any(v, "values"); found { if !dec_ptr_CopiableValues(fv, &out.values) do return fail("ContinuousModification::CopyValues.values") } else { return fail("ContinuousModification::CopyValues.values missing") }
	if !decode_DisplayIdentity(v, &out.display) do return fail("ContinuousModification::CopyValues.display (flattened)")
	return true
		}) { return fail("ContinuousModification::CopyValues") }
		out^ = tmp
	case "CopyChosen": out^ = ContinuousModification_CopyChosen{}
	case "SetName":
		tmp: ContinuousModification_SetName
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_SetName) -> bool {
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("ContinuousModification::SetName.name") } else { return fail("ContinuousModification::SetName.name missing") }
	return true
		}) { return fail("ContinuousModification::SetName") }
		out^ = tmp
	case "SetTextName":
		tmp: ContinuousModification_SetTextName
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_SetTextName) -> bool {
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("ContinuousModification::SetTextName.name") } else { return fail("ContinuousModification::SetTextName.name missing") }
	return true
		}) { return fail("ContinuousModification::SetTextName") }
		out^ = tmp
	case "SubstituteTextWord":
		tmp: ContinuousModification_SubstituteTextWord
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_SubstituteTextWord) -> bool {
	if fv, found := get_any(v, "substitution"); found { if !decode_TextSubstitutionSpec(fv, &out.substitution) do return fail("ContinuousModification::SubstituteTextWord.substitution") } else { return fail("ContinuousModification::SubstituteTextWord.substitution missing") }
	return true
		}) { return fail("ContinuousModification::SubstituteTextWord") }
		out^ = tmp
	case "AddPower":
		tmp: ContinuousModification_AddPower
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_AddPower) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_i32(fv, &out.value) do return fail("ContinuousModification::AddPower.value") } else { return fail("ContinuousModification::AddPower.value missing") }
	return true
		}) { return fail("ContinuousModification::AddPower") }
		out^ = tmp
	case "AddToughness":
		tmp: ContinuousModification_AddToughness
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_AddToughness) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_i32(fv, &out.value) do return fail("ContinuousModification::AddToughness.value") } else { return fail("ContinuousModification::AddToughness.value missing") }
	return true
		}) { return fail("ContinuousModification::AddToughness") }
		out^ = tmp
	case "SetPower":
		tmp: ContinuousModification_SetPower
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_SetPower) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_i32(fv, &out.value) do return fail("ContinuousModification::SetPower.value") } else { return fail("ContinuousModification::SetPower.value missing") }
	return true
		}) { return fail("ContinuousModification::SetPower") }
		out^ = tmp
	case "SetToughness":
		tmp: ContinuousModification_SetToughness
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_SetToughness) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_i32(fv, &out.value) do return fail("ContinuousModification::SetToughness.value") } else { return fail("ContinuousModification::SetToughness.value missing") }
	return true
		}) { return fail("ContinuousModification::SetToughness") }
		out^ = tmp
	case "AddKeyword":
		tmp: ContinuousModification_AddKeyword
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_AddKeyword) -> bool {
	if fv, found := get_any(v, "keyword"); found { if !decode_Keyword(fv, &out.keyword) do return fail("ContinuousModification::AddKeyword.keyword") } else { return fail("ContinuousModification::AddKeyword.keyword missing") }
	return true
		}) { return fail("ContinuousModification::AddKeyword") }
		out^ = tmp
	case "RemoveKeyword":
		tmp: ContinuousModification_RemoveKeyword
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_RemoveKeyword) -> bool {
	if fv, found := get_any(v, "keyword"); found { if !decode_Keyword(fv, &out.keyword) do return fail("ContinuousModification::RemoveKeyword.keyword") } else { return fail("ContinuousModification::RemoveKeyword.keyword missing") }
	return true
		}) { return fail("ContinuousModification::RemoveKeyword") }
		out^ = tmp
	case "GrantAbility":
		tmp: ContinuousModification_GrantAbility
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_GrantAbility) -> bool {
	if fv, found := get_any(v, "definition"); found { if !dec_ptr_AbilityDefinition(fv, &out.definition) do return fail("ContinuousModification::GrantAbility.definition") } else { return fail("ContinuousModification::GrantAbility.definition missing") }
	return true
		}) { return fail("ContinuousModification::GrantAbility") }
		out^ = tmp
