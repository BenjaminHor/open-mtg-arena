	if fv, found := get_any(v, "choice_count"); found { if !decode_int(fv, &out.choice_count) do return fail("AnnouncerElection.choice_count") } else { return fail("AnnouncerElection.choice_count missing") }
	if fv, found := get_any(v, "target_type"); found { if !dec_opt_CoreType(fv, &out.target_type) do return fail("AnnouncerElection.target_type") }
