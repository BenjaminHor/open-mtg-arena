		.SkipLowUseWindows = "SkipLowUseWindows",
		.FullControl = "FullControl",
	}
	json.write_string(b, NAMES[x])
}

decode_ResourceAxis :: proc(v: json.Value, out: ^ResourceAxis) -> bool {
	when COVERAGE do cov_hit("ResourceAxis")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ResourceAxis: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ResourceAxis: not a string or object")
	}
	switch variant {
	case "Mana": when COVERAGE do cov_hit("ResourceAxis::Mana"); tmp: ResourceAxis_Mana; if !decode_ManaType(body, &tmp._0) do return fail("ResourceAxis::Mana"); out^ = tmp
	case "Life": when COVERAGE do cov_hit("ResourceAxis::Life"); tmp: ResourceAxis_Life; if !decode_PlayerId(body, &tmp._0) do return fail("ResourceAxis::Life"); out^ = tmp
	case "DamageDealt": when COVERAGE do cov_hit("ResourceAxis::DamageDealt"); tmp: ResourceAxis_DamageDealt; if !decode_PlayerId(body, &tmp._0) do return fail("ResourceAxis::DamageDealt"); out^ = tmp
	case "LibraryDelta": when COVERAGE do cov_hit("ResourceAxis::LibraryDelta"); tmp: ResourceAxis_LibraryDelta; if !decode_PlayerId(body, &tmp._0) do return fail("ResourceAxis::LibraryDelta"); out^ = tmp
	case "Counter": when COVERAGE do cov_hit("ResourceAxis::Counter");
		data := body
		if data.kind != .Array || len(data.items) != 2 do return fail("ResourceAxis::Counter")
		tmp: ResourceAxis_Counter
		if !decode_CounterClass(data.items[0], &tmp._0) do return fail("ResourceAxis::Counter._0")
		if !decode_ObjectClass(data.items[1], &tmp._1) do return fail("ResourceAxis::Counter._1")
		out^ = tmp
	case "Trigger": when COVERAGE do cov_hit("ResourceAxis::Trigger"); tmp: ResourceAxis_Trigger; if !decode_TriggerKind(body, &tmp._0) do return fail("ResourceAxis::Trigger"); out^ = tmp
	case "TokensCreated": when COVERAGE do cov_hit("ResourceAxis::TokensCreated"); out^ = ResourceAxis_TokensCreated{}
	case "CardsDrawn": when COVERAGE do cov_hit("ResourceAxis::CardsDrawn"); out^ = ResourceAxis_CardsDrawn{}
	case "Casts": when COVERAGE do cov_hit("ResourceAxis::Casts"); out^ = ResourceAxis_Casts{}
	case "LandfallTriggers": when COVERAGE do cov_hit("ResourceAxis::LandfallTriggers"); out^ = ResourceAxis_LandfallTriggers{}
	case "CombatPhases": when COVERAGE do cov_hit("ResourceAxis::CombatPhases"); out^ = ResourceAxis_CombatPhases{}
	case "ExtraTurns": when COVERAGE do cov_hit("ResourceAxis::ExtraTurns"); out^ = ResourceAxis_ExtraTurns{}
	case "DeathTriggers": when COVERAGE do cov_hit("ResourceAxis::DeathTriggers"); out^ = ResourceAxis_DeathTriggers{}
	case "EtbTriggers": when COVERAGE do cov_hit("ResourceAxis::EtbTriggers"); out^ = ResourceAxis_EtbTriggers{}
	case "LtbTriggers": when COVERAGE do cov_hit("ResourceAxis::LtbTriggers"); out^ = ResourceAxis_LtbTriggers{}
	case "SacTriggers": when COVERAGE do cov_hit("ResourceAxis::SacTriggers"); out^ = ResourceAxis_SacTriggers{}
	case "Poison": when COVERAGE do cov_hit("ResourceAxis::Poison"); tmp: ResourceAxis_Poison; if !decode_PlayerId(body, &tmp._0) do return fail("ResourceAxis::Poison"); out^ = tmp
	case "Energy": when COVERAGE do cov_hit("ResourceAxis::Energy"); tmp: ResourceAxis_Energy; if !decode_PlayerId(body, &tmp._0) do return fail("ResourceAxis::Energy"); out^ = tmp
	case: return fail("ResourceAxis: unknown variant")
	}
	return true
}

encode_ResourceAxis :: proc(b: ^strings.Builder, x: ResourceAxis) {
	#partial switch y in x {
	case ResourceAxis_Mana: strings.write_byte(b, '{'); json.write_string(b, "Mana"); strings.write_byte(b, ':'); encode_ManaType(b, y._0); strings.write_byte(b, '}')
	case ResourceAxis_Life: strings.write_byte(b, '{'); json.write_string(b, "Life"); strings.write_byte(b, ':'); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	case ResourceAxis_DamageDealt: strings.write_byte(b, '{'); json.write_string(b, "DamageDealt"); strings.write_byte(b, ':'); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	case ResourceAxis_LibraryDelta: strings.write_byte(b, '{'); json.write_string(b, "LibraryDelta"); strings.write_byte(b, ':'); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	case ResourceAxis_Counter: strings.write_byte(b, '{'); json.write_string(b, "Counter"); strings.write_byte(b, ':'); strings.write_byte(b, '['); encode_CounterClass(b, y._0); strings.write_byte(b, ','); encode_ObjectClass(b, y._1); strings.write_byte(b, ']'); strings.write_byte(b, '}')
	case ResourceAxis_Trigger: strings.write_byte(b, '{'); json.write_string(b, "Trigger"); strings.write_byte(b, ':'); encode_TriggerKind(b, y._0); strings.write_byte(b, '}')
	case ResourceAxis_TokensCreated: _ = y; json.write_string(b, "TokensCreated")
	case ResourceAxis_CardsDrawn: _ = y; json.write_string(b, "CardsDrawn")
	case ResourceAxis_Casts: _ = y; json.write_string(b, "Casts")
	case ResourceAxis_LandfallTriggers: _ = y; json.write_string(b, "LandfallTriggers")
	case ResourceAxis_CombatPhases: _ = y; json.write_string(b, "CombatPhases")
	case ResourceAxis_ExtraTurns: _ = y; json.write_string(b, "ExtraTurns")
	case ResourceAxis_DeathTriggers: _ = y; json.write_string(b, "DeathTriggers")
	case ResourceAxis_EtbTriggers: _ = y; json.write_string(b, "EtbTriggers")
	case ResourceAxis_LtbTriggers: _ = y; json.write_string(b, "LtbTriggers")
	case ResourceAxis_SacTriggers: _ = y; json.write_string(b, "SacTriggers")
	case ResourceAxis_Poison: strings.write_byte(b, '{'); json.write_string(b, "Poison"); strings.write_byte(b, ':'); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	case ResourceAxis_Energy: strings.write_byte(b, '{'); json.write_string(b, "Energy"); strings.write_byte(b, ':'); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	}
}

