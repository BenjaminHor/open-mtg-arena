	member(b, first, "is_mana_ability"); encode_bool(b, y.is_mana_ability)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_CreatureExploited: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CreatureExploited"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "exploiter"); encode_ObjectId(b, y.exploiter)
