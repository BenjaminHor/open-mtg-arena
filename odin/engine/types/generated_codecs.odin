decode_PermissionGrant :: proc(v: json.Value, out: ^PermissionGrant) -> bool {
	when COVERAGE do cov_hit("PermissionGrant")
	if v.kind != .Object do return fail("PermissionGrant: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("PermissionGrant: no tag")
	switch tv.text {
	case "Static": when COVERAGE do cov_hit("PermissionGrant::Static");
		tmp: PermissionGrant_Static
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PermissionGrant_Static) -> bool {
	if fv, found := get_any(v, "index"); found { if !decode_u32(fv, &out.index) do return fail("PermissionGrant::Static.index") } else { return fail("PermissionGrant::Static.index missing") }
	return true
		}) { return fail("PermissionGrant::Static") }
		out^ = tmp
	case "Transient": when COVERAGE do cov_hit("PermissionGrant::Transient");
		tmp: PermissionGrant_Transient
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PermissionGrant_Transient) -> bool {
	if fv, found := get_any(v, "effect_id"); found { if !decode_u64(fv, &out.effect_id) do return fail("PermissionGrant::Transient.effect_id") } else { return fail("PermissionGrant::Transient.effect_id missing") }
	if fv, found := get_any(v, "modification"); found { if !decode_u32(fv, &out.modification) do return fail("PermissionGrant::Transient.modification") } else { return fail("PermissionGrant::Transient.modification missing") }
	return true
		}) { return fail("PermissionGrant::Transient") }
		out^ = tmp
	case: return fail("PermissionGrant: unknown variant")
	}
	return true
}

encode_PermissionGrant :: proc(b: ^strings.Builder, x: PermissionGrant) {
	#partial switch y in x {
	case PermissionGrant_Static: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Static")
	member(b, first, "index"); encode_u32(b, y.index)
	}; strings.write_byte(b, '}')
	case PermissionGrant_Transient: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Transient")
	member(b, first, "effect_id"); encode_u64(b, y.effect_id)
	member(b, first, "modification"); encode_u32(b, y.modification)
	}; strings.write_byte(b, '}')
	}
}

encode_PermissionGrant_members :: proc(b: ^strings.Builder, x: PermissionGrant, first: ^bool) {
	#partial switch y in x {
	case PermissionGrant_Static: member(b, first, "type"); json.write_string(b, "Static")
	member(b, first, "index"); encode_u32(b, y.index)

	case PermissionGrant_Transient: member(b, first, "type"); json.write_string(b, "Transient")
	member(b, first, "effect_id"); encode_u64(b, y.effect_id)
	member(b, first, "modification"); encode_u32(b, y.modification)

	}
}

decode_AbilityCost :: proc(v: json.Value, out: ^AbilityCost) -> bool {
