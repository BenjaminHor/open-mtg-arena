	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "recipient"); encode_TargetFilter(b, y.recipient)
	}; strings.write_byte(b, '}')
	case Effect_RemoveFromCombat: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RemoveFromCombat")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case Effect_BecomeBlocked: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "BecomeBlocked")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case Effect_Conjure: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Conjure")
	member(b, first, "cards"); enc_dyn_ConjureCard(b, y.cards)
	member(b, first, "destination"); encode_Zone(b, y.destination)
	member(b, first, "tapped"); encode_bool(b, y.tapped)
	if !(y.library_position == nil) { member(b, first, "library_position"); enc_opt_LibraryPosition(b, y.library_position) }
	if !(y.library_players == nil) { member(b, first, "library_players"); enc_opt_PlayerFilter(b, y.library_players) }
	}; strings.write_byte(b, '}')
	case Effect_CreateCardCopyByName: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CreateCardCopyByName")
	if !(y.name == nil) { member(b, first, "name"); enc_opt_string(b, y.name) }
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	case Effect_ApplyPerpetual: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ApplyPerpetual")
