	case "SetBasicLandType": when COVERAGE do cov_hit("ContinuousModification::SetBasicLandType");
		tmp: ContinuousModification_SetBasicLandType
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_SetBasicLandType) -> bool {
	if fv, found := get_any(v, "land_type"); found { if !decode_BasicLandType(fv, &out.land_type) do return fail("ContinuousModification::SetBasicLandType.land_type") } else { return fail("ContinuousModification::SetBasicLandType.land_type missing") }
	return true
		}) { return fail("ContinuousModification::SetBasicLandType") }
		out^ = tmp
	case "SetChosenBasicLandType": when COVERAGE do cov_hit("ContinuousModification::SetChosenBasicLandType"); out^ = ContinuousModification_SetChosenBasicLandType{}
	case "SetChosenName": when COVERAGE do cov_hit("ContinuousModification::SetChosenName"); out^ = ContinuousModification_SetChosenName{}
	case "RetainPrintedTriggerFromSource": when COVERAGE do cov_hit("ContinuousModification::RetainPrintedTriggerFromSource");
		tmp: ContinuousModification_RetainPrintedTriggerFromSource
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_RetainPrintedTriggerFromSource) -> bool {
	if fv, found := get_any(v, "source_trigger_index"); found { if !decode_int(fv, &out.source_trigger_index) do return fail("ContinuousModification::RetainPrintedTriggerFromSource.source_trigger_index") } else { return fail("ContinuousModification::RetainPrintedTriggerFromSource.source_trigger_index missing") }
	return true
		}) { return fail("ContinuousModification::RetainPrintedTriggerFromSource") }
		out^ = tmp
	case "RetainPrintedAbilityFromSource": when COVERAGE do cov_hit("ContinuousModification::RetainPrintedAbilityFromSource");
		tmp: ContinuousModification_RetainPrintedAbilityFromSource
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_RetainPrintedAbilityFromSource) -> bool {
	if fv, found := get_any(v, "source_ability_index"); found { if !decode_int(fv, &out.source_ability_index) do return fail("ContinuousModification::RetainPrintedAbilityFromSource.source_ability_index") } else { return fail("ContinuousModification::RetainPrintedAbilityFromSource.source_ability_index missing") }
	return true
		}) { return fail("ContinuousModification::RetainPrintedAbilityFromSource") }
		out^ = tmp
	case "RetainAllOtherAbilitiesFromSource": when COVERAGE do cov_hit("ContinuousModification::RetainAllOtherAbilitiesFromSource"); out^ = ContinuousModification_RetainAllOtherAbilitiesFromSource{}
	case "AddSupertype": when COVERAGE do cov_hit("ContinuousModification::AddSupertype");
		tmp: ContinuousModification_AddSupertype
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_AddSupertype) -> bool {
	if fv, found := get_any(v, "supertype"); found { if !decode_Supertype(fv, &out.supertype) do return fail("ContinuousModification::AddSupertype.supertype") } else { return fail("ContinuousModification::AddSupertype.supertype missing") }
	return true
		}) { return fail("ContinuousModification::AddSupertype") }
		out^ = tmp
	case "RemoveSupertype": when COVERAGE do cov_hit("ContinuousModification::RemoveSupertype");
		tmp: ContinuousModification_RemoveSupertype
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_RemoveSupertype) -> bool {
	if fv, found := get_any(v, "supertype"); found { if !decode_Supertype(fv, &out.supertype) do return fail("ContinuousModification::RemoveSupertype.supertype") } else { return fail("ContinuousModification::RemoveSupertype.supertype missing") }
	return true
		}) { return fail("ContinuousModification::RemoveSupertype") }
		out^ = tmp
	case "AddCounterOnEnter": when COVERAGE do cov_hit("ContinuousModification::AddCounterOnEnter");
		tmp: ContinuousModification_AddCounterOnEnter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_AddCounterOnEnter) -> bool {
	if fv, found := get_any(v, "counter_type"); found { if !decode_CounterType(fv, &out.counter_type) do return fail("ContinuousModification::AddCounterOnEnter.counter_type") } else { return fail("ContinuousModification::AddCounterOnEnter.counter_type missing") }
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("ContinuousModification::AddCounterOnEnter.count") } else { return fail("ContinuousModification::AddCounterOnEnter.count missing") }
	if fv, found := get_any(v, "if_type"); found { if !dec_opt_CoreType(fv, &out.if_type) do return fail("ContinuousModification::AddCounterOnEnter.if_type") }
	return true
		}) { return fail("ContinuousModification::AddCounterOnEnter") }
		out^ = tmp
	case "SetStartingLoyalty": when COVERAGE do cov_hit("ContinuousModification::SetStartingLoyalty");
		tmp: ContinuousModification_SetStartingLoyalty
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_SetStartingLoyalty) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_u32(fv, &out.value) do return fail("ContinuousModification::SetStartingLoyalty.value") } else { return fail("ContinuousModification::SetStartingLoyalty.value missing") }
	return true
		}) { return fail("ContinuousModification::SetStartingLoyalty") }
		out^ = tmp
	case "RemoveManaCost": when COVERAGE do cov_hit("ContinuousModification::RemoveManaCost"); out^ = ContinuousModification_RemoveManaCost{}
	case: return fail("ContinuousModification: unknown variant")
	}
	return true
}

encode_ContinuousModification :: proc(b: ^strings.Builder, x: ContinuousModification) {
	#partial switch y in x {
	case ContinuousModification_CopyValues: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CopyValues")
	member(b, first, "values"); enc_ptr_CopiableValues(b, y.values)
	encode_DisplayIdentity_members(b, y.display, first)
	}; strings.write_byte(b, '}')
	case ContinuousModification_CopyChosen: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CopyChosen"); strings.write_byte(b, '}')
	case ContinuousModification_SetName: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetName")
	member(b, first, "name"); encode_string(b, y.name)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SetTextName: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetTextName")
	member(b, first, "name"); encode_string(b, y.name)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SubstituteTextWord: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SubstituteTextWord")
	member(b, first, "substitution"); encode_TextSubstitutionSpec(b, y.substitution)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddPower: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddPower")
	member(b, first, "value"); encode_i32(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddToughness: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddToughness")
	member(b, first, "value"); encode_i32(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SetPower: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetPower")
	member(b, first, "value"); encode_i32(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SetToughness: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetToughness")
	member(b, first, "value"); encode_i32(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddKeyword: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)
	}; strings.write_byte(b, '}')
	case ContinuousModification_RemoveKeyword: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RemoveKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)
	}; strings.write_byte(b, '}')
	case ContinuousModification_GrantAbility: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GrantAbility")
	member(b, first, "definition"); enc_ptr_AbilityDefinition(b, y.definition)
	}; strings.write_byte(b, '}')
	case ContinuousModification_GrantAllActivatedAbilitiesOf: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GrantAllActivatedAbilitiesOf")
	member(b, first, "source"); encode_TargetFilter(b, y.source)
	if !(y.cap == nil) { member(b, first, "cap"); enc_opt_ActivationRestriction(b, y.cap) }
	if !(y.kind == nil) { member(b, first, "kind"); enc_opt_ActivatedAbilityKind(b, y.kind) }
	}; strings.write_byte(b, '}')
	case ContinuousModification_GrantAllTriggeredAbilitiesOf: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GrantAllTriggeredAbilitiesOf")
	member(b, first, "source"); encode_TargetFilter(b, y.source)
	}; strings.write_byte(b, '}')
	case ContinuousModification_GrantTrigger: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GrantTrigger")
	member(b, first, "trigger"); enc_ptr_TriggerDefinition(b, y.trigger)
	}; strings.write_byte(b, '}')
	case ContinuousModification_GrantReplacement: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GrantReplacement")
	member(b, first, "replacement"); enc_ptr_ReplacementDefinition(b, y.replacement)
	}; strings.write_byte(b, '}')
	case ContinuousModification_RemoveAllAbilities: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RemoveAllAbilities"); strings.write_byte(b, '}')
	case ContinuousModification_AddType: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddType")
	member(b, first, "core_type"); encode_CoreType(b, y.core_type)
	}; strings.write_byte(b, '}')
	case ContinuousModification_RemoveType: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RemoveType")
	member(b, first, "core_type"); encode_CoreType(b, y.core_type)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddSubtype: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddSubtype")
	member(b, first, "subtype"); encode_string(b, y.subtype)
	}; strings.write_byte(b, '}')
	case ContinuousModification_RemoveSubtype: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RemoveSubtype")
	member(b, first, "subtype"); encode_string(b, y.subtype)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SetCardTypes: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetCardTypes")
	member(b, first, "core_types"); enc_dyn_CoreType(b, y.core_types)
	}; strings.write_byte(b, '}')
	case ContinuousModification_RemoveAllSubtypes: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RemoveAllSubtypes")
	member(b, first, "set"); encode_SubtypeSet(b, y.set)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SetDynamicPower: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetDynamicPower")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SetDynamicToughness: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetDynamicToughness")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SetPowerDynamic: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetPowerDynamic")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SetToughnessDynamic: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetToughnessDynamic")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddDynamicPower: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddDynamicPower")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddDynamicToughness: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddDynamicToughness")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddDynamicKeyword: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddDynamicKeyword")
	member(b, first, "kind"); encode_DynamicKeywordKind(b, y.kind)
	member(b, first, "value"); encode_QuantityExpr(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddKeywordWithDerivedCost: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddKeywordWithDerivedCost")
	member(b, first, "kind"); encode_CostBearingKeywordKind(b, y.kind)
	member(b, first, "derivation"); encode_CostDerivation(b, y.derivation)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddAllCreatureTypes: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AddAllCreatureTypes"); strings.write_byte(b, '}')
	case ContinuousModification_AddAllBasicLandTypes: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AddAllBasicLandTypes"); strings.write_byte(b, '}')
	case ContinuousModification_AddAllLandTypes: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AddAllLandTypes"); strings.write_byte(b, '}')
	case ContinuousModification_AddChosenSubtype: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddChosenSubtype")
	member(b, first, "kind"); encode_ChosenSubtypeKind(b, y.kind)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddChosenColor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddChosenColor")
	member(b, first, "mode"); encode_ColorChangeMode(b, y.mode)
	}; strings.write_byte(b, '}')
	case ContinuousModification_RemoveChosenKeyword: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RemoveChosenKeyword"); strings.write_byte(b, '}')
	case ContinuousModification_AddChosenKeyword: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AddChosenKeyword"); strings.write_byte(b, '}')
	case ContinuousModification_SetColor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetColor")
	member(b, first, "colors"); enc_dyn_ManaColor(b, y.colors)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddColor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddColor")
	member(b, first, "color"); encode_ManaColor(b, y.color)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddStaticMode: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddStaticMode")
	member(b, first, "mode"); encode_StaticMode(b, y.mode)
	}; strings.write_byte(b, '}')
	case ContinuousModification_GrantStaticAbility: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GrantStaticAbility")
	member(b, first, "definition"); enc_ptr_StaticDefinition(b, y.definition)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SwitchPowerToughness: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SwitchPowerToughness"); strings.write_byte(b, '}')
	case ContinuousModification_AssignDamageFromToughness: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AssignDamageFromToughness"); strings.write_byte(b, '}')
	case ContinuousModification_AssignDamageAsThoughUnblocked: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AssignDamageAsThoughUnblocked"); strings.write_byte(b, '}')
	case ContinuousModification_AssignNoCombatDamage: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AssignNoCombatDamage"); strings.write_byte(b, '}')
	case ContinuousModification_ChangeController: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChangeController"); strings.write_byte(b, '}')
	case ContinuousModification_ChangeControllerToDesignation: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChangeControllerToDesignation")
	member(b, first, "designation"); encode_Designation(b, y.designation)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SetBasicLandType: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetBasicLandType")
	member(b, first, "land_type"); encode_BasicLandType(b, y.land_type)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SetChosenBasicLandType: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SetChosenBasicLandType"); strings.write_byte(b, '}')
	case ContinuousModification_SetChosenName: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SetChosenName"); strings.write_byte(b, '}')
	case ContinuousModification_RetainPrintedTriggerFromSource: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RetainPrintedTriggerFromSource")
	member(b, first, "source_trigger_index"); encode_int(b, y.source_trigger_index)
	}; strings.write_byte(b, '}')
	case ContinuousModification_RetainPrintedAbilityFromSource: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RetainPrintedAbilityFromSource")
	member(b, first, "source_ability_index"); encode_int(b, y.source_ability_index)
	}; strings.write_byte(b, '}')
	case ContinuousModification_RetainAllOtherAbilitiesFromSource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RetainAllOtherAbilitiesFromSource"); strings.write_byte(b, '}')
	case ContinuousModification_AddSupertype: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddSupertype")
	member(b, first, "supertype"); encode_Supertype(b, y.supertype)
	}; strings.write_byte(b, '}')
	case ContinuousModification_RemoveSupertype: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RemoveSupertype")
	member(b, first, "supertype"); encode_Supertype(b, y.supertype)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddCounterOnEnter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddCounterOnEnter")
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "if_type"); enc_opt_CoreType(b, y.if_type)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SetStartingLoyalty: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetStartingLoyalty")
	member(b, first, "value"); encode_u32(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_RemoveManaCost: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RemoveManaCost"); strings.write_byte(b, '}')
	}
}

encode_ContinuousModification_members :: proc(b: ^strings.Builder, x: ContinuousModification, first: ^bool) {
	#partial switch y in x {
	case ContinuousModification_CopyValues: member(b, first, "type"); json.write_string(b, "CopyValues")
	member(b, first, "values"); enc_ptr_CopiableValues(b, y.values)
	encode_DisplayIdentity_members(b, y.display, first)

	case ContinuousModification_CopyChosen: _ = y; member(b, first, "type"); json.write_string(b, "CopyChosen")
	case ContinuousModification_SetName: member(b, first, "type"); json.write_string(b, "SetName")
	member(b, first, "name"); encode_string(b, y.name)

	case ContinuousModification_SetTextName: member(b, first, "type"); json.write_string(b, "SetTextName")
	member(b, first, "name"); encode_string(b, y.name)

	case ContinuousModification_SubstituteTextWord: member(b, first, "type"); json.write_string(b, "SubstituteTextWord")
	member(b, first, "substitution"); encode_TextSubstitutionSpec(b, y.substitution)

	case ContinuousModification_AddPower: member(b, first, "type"); json.write_string(b, "AddPower")
	member(b, first, "value"); encode_i32(b, y.value)

	case ContinuousModification_AddToughness: member(b, first, "type"); json.write_string(b, "AddToughness")
	member(b, first, "value"); encode_i32(b, y.value)

	case ContinuousModification_SetPower: member(b, first, "type"); json.write_string(b, "SetPower")
	member(b, first, "value"); encode_i32(b, y.value)

	case ContinuousModification_SetToughness: member(b, first, "type"); json.write_string(b, "SetToughness")
	member(b, first, "value"); encode_i32(b, y.value)

	case ContinuousModification_AddKeyword: member(b, first, "type"); json.write_string(b, "AddKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)

	case ContinuousModification_RemoveKeyword: member(b, first, "type"); json.write_string(b, "RemoveKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)

	case ContinuousModification_GrantAbility: member(b, first, "type"); json.write_string(b, "GrantAbility")
	member(b, first, "definition"); enc_ptr_AbilityDefinition(b, y.definition)

	case ContinuousModification_GrantAllActivatedAbilitiesOf: member(b, first, "type"); json.write_string(b, "GrantAllActivatedAbilitiesOf")
	member(b, first, "source"); encode_TargetFilter(b, y.source)
	if !(y.cap == nil) { member(b, first, "cap"); enc_opt_ActivationRestriction(b, y.cap) }
	if !(y.kind == nil) { member(b, first, "kind"); enc_opt_ActivatedAbilityKind(b, y.kind) }

	case ContinuousModification_GrantAllTriggeredAbilitiesOf: member(b, first, "type"); json.write_string(b, "GrantAllTriggeredAbilitiesOf")
	member(b, first, "source"); encode_TargetFilter(b, y.source)

	case ContinuousModification_GrantTrigger: member(b, first, "type"); json.write_string(b, "GrantTrigger")
	member(b, first, "trigger"); enc_ptr_TriggerDefinition(b, y.trigger)

	case ContinuousModification_GrantReplacement: member(b, first, "type"); json.write_string(b, "GrantReplacement")
	member(b, first, "replacement"); enc_ptr_ReplacementDefinition(b, y.replacement)

