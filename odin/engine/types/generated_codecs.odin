decode_PendingHordeReveal :: proc(v: json.Value, out: ^PendingHordeReveal) -> bool {
	when COVERAGE do cov_hit("PendingHordeReveal")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("PendingHordeReveal: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("PendingHordeReveal: not a string or object")
	}
	switch variant {
	case "NontokenCast": when COVERAGE do cov_hit("PendingHordeReveal::NontokenCast");
		tmp: PendingHordeReveal_NontokenCast
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^PendingHordeReveal_NontokenCast) -> bool {
	if fv, found := get_any(v, "card"); found { if !decode_ObjectId(fv, &out.card) do return fail("PendingHordeReveal::NontokenCast.card") } else { return fail("PendingHordeReveal::NontokenCast.card missing") }
	if fv, found := get_any(v, "revealed_rarity"); found { if !dec_opt_Rarity(fv, &out.revealed_rarity) do return fail("PendingHordeReveal::NontokenCast.revealed_rarity") }
	return true
		}) { return fail("PendingHordeReveal::NontokenCast") }
		out^ = tmp
	case "EventDispatch": when COVERAGE do cov_hit("PendingHordeReveal::EventDispatch");
		tmp: PendingHordeReveal_EventDispatch
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^PendingHordeReveal_EventDispatch) -> bool {
	if fv, found := get_any(v, "card"); found { if !decode_ObjectId(fv, &out.card) do return fail("PendingHordeReveal::EventDispatch.card") } else { return fail("PendingHordeReveal::EventDispatch.card missing") }
	if fv, found := get_any(v, "fired"); found { if !dec_dyn_ObjectId(fv, &out.fired) do return fail("PendingHordeReveal::EventDispatch.fired") } else { return fail("PendingHordeReveal::EventDispatch.fired missing") }
	return true
		}) { return fail("PendingHordeReveal::EventDispatch") }
		out^ = tmp
	case "TokenCreation": when COVERAGE do cov_hit("PendingHordeReveal::TokenCreation");
		tmp: PendingHordeReveal_TokenCreation
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^PendingHordeReveal_TokenCreation) -> bool {
	if fv, found := get_any(v, "card"); found { if !decode_ObjectId(fv, &out.card) do return fail("PendingHordeReveal::TokenCreation.card") } else { return fail("PendingHordeReveal::TokenCreation.card missing") }
	if fv, found := get_any(v, "before"); found { if !dec_dyn_ObjectId(fv, &out.before) do return fail("PendingHordeReveal::TokenCreation.before") } else { return fail("PendingHordeReveal::TokenCreation.before missing") }
	if fv, found := get_any(v, "pinned"); found { if !dec_opt_TokenImageRef(fv, &out.pinned) do return fail("PendingHordeReveal::TokenCreation.pinned") }
	if fv, found := get_any(v, "revealed_name"); found { if !decode_string(fv, &out.revealed_name) do return fail("PendingHordeReveal::TokenCreation.revealed_name") } else { return fail("PendingHordeReveal::TokenCreation.revealed_name missing") }
	return true
		}) { return fail("PendingHordeReveal::TokenCreation") }
		out^ = tmp
	case "AmassArmy": when COVERAGE do cov_hit("PendingHordeReveal::AmassArmy");
		tmp: PendingHordeReveal_AmassArmy
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^PendingHordeReveal_AmassArmy) -> bool {
	if fv, found := get_any(v, "card"); found { if !decode_ObjectId(fv, &out.card) do return fail("PendingHordeReveal::AmassArmy.card") } else { return fail("PendingHordeReveal::AmassArmy.card missing") }
	return true
		}) { return fail("PendingHordeReveal::AmassArmy") }
		out^ = tmp
	case: return fail("PendingHordeReveal: unknown variant")
	}
	return true
}

encode_PendingHordeReveal :: proc(b: ^strings.Builder, x: PendingHordeReveal) {
	#partial switch y in x {
	case PendingHordeReveal_NontokenCast: strings.write_byte(b, '{'); json.write_string(b, "NontokenCast"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card"); encode_ObjectId(b, y.card)
	member(b, first, "revealed_rarity"); enc_opt_Rarity(b, y.revealed_rarity)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingHordeReveal_EventDispatch: strings.write_byte(b, '{'); json.write_string(b, "EventDispatch"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card"); encode_ObjectId(b, y.card)
	member(b, first, "fired"); enc_dyn_ObjectId(b, y.fired)
