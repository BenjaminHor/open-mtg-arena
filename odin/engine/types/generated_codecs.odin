	if v.kind != .Object do return fail("CopiableValues: not an object")
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("CopiableValues.name") } else { return fail("CopiableValues.name missing") }
	if fv, found := get_any(v, "mana_cost"); found { if !decode_ManaCost(fv, &out.mana_cost) do return fail("CopiableValues.mana_cost") } else { return fail("CopiableValues.mana_cost missing") }
	if fv, found := get_any(v, "color"); found { if !dec_dyn_ManaColor(fv, &out.color) do return fail("CopiableValues.color") } else { return fail("CopiableValues.color missing") }
	if fv, found := get_any(v, "card_types"); found { if !decode_CardType(fv, &out.card_types) do return fail("CopiableValues.card_types") } else { return fail("CopiableValues.card_types missing") }
	if fv, found := get_any(v, "power"); found { if !dec_opt_i32(fv, &out.power) do return fail("CopiableValues.power") }
	if fv, found := get_any(v, "toughness"); found { if !dec_opt_i32(fv, &out.toughness) do return fail("CopiableValues.toughness") }
	if fv, found := get_any(v, "loyalty"); found { if !dec_opt_u32(fv, &out.loyalty) do return fail("CopiableValues.loyalty") }
	if fv, found := get_any(v, "printed_loyalty"); found { if !dec_opt_PrintedLoyalty(fv, &out.printed_loyalty) do return fail("CopiableValues.printed_loyalty") }
	if fv, found := get_any(v, "keywords"); found { if !dec_dyn_Keyword(fv, &out.keywords) do return fail("CopiableValues.keywords") } else { return fail("CopiableValues.keywords missing") }
	if fv, found := get_any(v, "abilities"); found { if !dec_shared_dyn_AbilityDefinition(fv, &out.abilities) do return fail("CopiableValues.abilities") } else { return fail("CopiableValues.abilities missing") }
	if fv, found := get_any(v, "trigger_definitions"); found { if !dec_shared_dyn_TriggerDefinition(fv, &out.trigger_definitions) do return fail("CopiableValues.trigger_definitions") } else { return fail("CopiableValues.trigger_definitions missing") }
	if fv, found := get_any(v, "trigger_printed_origins"); found { if !dec_shared_dyn_opt_TriggerPrintedOrigin(fv, &out.trigger_printed_origins) do return fail("CopiableValues.trigger_printed_origins") }
	if fv, found := get_any(v, "replacement_definitions"); found { if !dec_shared_dyn_ReplacementDefinition(fv, &out.replacement_definitions) do return fail("CopiableValues.replacement_definitions") } else { return fail("CopiableValues.replacement_definitions missing") }
	if fv, found := get_any(v, "static_definitions"); found { if !dec_shared_dyn_StaticDefinition(fv, &out.static_definitions) do return fail("CopiableValues.static_definitions") } else { return fail("CopiableValues.static_definitions missing") }
	if fv, found := get_any(v, "room_halves"); found { if !dec_opt_RoomCopiableHalves(fv, &out.room_halves) do return fail("CopiableValues.room_halves") }
	if fv, found := get_any(v, "prepare_face"); found { if !dec_shared_BackFaceData(fv, &out.prepare_face) do return fail("CopiableValues.prepare_face") }
	if fv, found := get_any(v, "name_origin"); found { if !decode_CopiedNameOrigin(fv, &out.name_origin) do return fail("CopiableValues.name_origin") }
	return true
}

