decode_ChosenGroupId :: proc(v: json.Value, out: ^ChosenGroupId) -> bool {
	return decode_u32(v, cast(^u32)out)
}

encode_ChosenGroupId :: proc(b: ^strings.Builder, x: ChosenGroupId) {
	encode_u32(b, cast(u32)x)
}

decode_ReturnResultId :: proc(v: json.Value, out: ^ReturnResultId) -> bool {
	return decode_u32(v, cast(^u32)out)
}

encode_ReturnResultId :: proc(b: ^strings.Builder, x: ReturnResultId) {
	encode_u32(b, cast(u32)x)
}

decode_ReturnResultReadSpec :: proc(v: json.Value, out: ^ReturnResultReadSpec) -> bool {
	if v.kind != .Object do return fail("ReturnResultReadSpec: not an object")
	if fv, found := get_any(v, "noun"); found { if !decode_TargetFilter(fv, &out.noun) do return fail("ReturnResultReadSpec.noun") } else { return fail("ReturnResultReadSpec.noun missing") }
	if fv, found := get_any(v, "destination"); found { if !decode_Zone(fv, &out.destination) do return fail("ReturnResultReadSpec.destination") } else { return fail("ReturnResultReadSpec.destination missing") }
	if fv, found := get_any(v, "recipient"); found { if !decode_ControllerRef(fv, &out.recipient) do return fail("ReturnResultReadSpec.recipient") } else { return fail("ReturnResultReadSpec.recipient missing") }
	return true
}

encode_ReturnResultReadSpec :: proc(b: ^strings.Builder, x: ReturnResultReadSpec) {
	strings.write_byte(b, '{')
	f := true
	encode_ReturnResultReadSpec_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ReturnResultReadSpec_members :: proc(b: ^strings.Builder, x: ReturnResultReadSpec, first: ^bool) {
	member(b, first, "noun"); encode_TargetFilter(b, x.noun)
	member(b, first, "destination"); encode_Zone(b, x.destination)
	member(b, first, "recipient"); encode_ControllerRef(b, x.recipient)
}

decode_Duration :: proc(v: json.Value, out: ^Duration) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("Duration: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("Duration: not a string or object")
	}
	switch variant {
	case "UntilEndOfTurn": out^ = Duration_UntilEndOfTurn{}
	case "UntilEndOfCombat": out^ = Duration_UntilEndOfCombat{}
	case "UntilNextTurnOf":
		tmp: Duration_UntilNextTurnOf
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^Duration_UntilNextTurnOf) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerScope(fv, &out.player) do return fail("Duration::UntilNextTurnOf.player") } else { return fail("Duration::UntilNextTurnOf.player missing") }
	return true
		}) { return fail("Duration::UntilNextTurnOf") }
		out^ = tmp
	case "UntilEndOfNextTurnOf":
		tmp: Duration_UntilEndOfNextTurnOf
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^Duration_UntilEndOfNextTurnOf) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerScope(fv, &out.player) do return fail("Duration::UntilEndOfNextTurnOf.player") } else { return fail("Duration::UntilEndOfNextTurnOf.player missing") }
	return true
		}) { return fail("Duration::UntilEndOfNextTurnOf") }
		out^ = tmp
	case "UntilHostLeavesPlay": out^ = Duration_UntilHostLeavesPlay{}
	case "WhileHostOnBattlefield": out^ = Duration_WhileHostOnBattlefield{}
	case "WhileControllingHost": out^ = Duration_WhileControllingHost{}
	case "UntilNextStepOf", "UntilNextUntapStepOf":
		tmp: Duration_UntilNextStepOf
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^Duration_UntilNextStepOf) -> bool {
	if fv, found := get_any(v, "step"); found { if !decode_Phase(fv, &out.step) do return fail("Duration::UntilNextStepOf.step") }
	if fv, found := get_any(v, "player"); found { if !decode_PlayerScope(fv, &out.player) do return fail("Duration::UntilNextStepOf.player") } else { return fail("Duration::UntilNextStepOf.player missing") }
	return true
		}) { return fail("Duration::UntilNextStepOf") }
		out^ = tmp
	case "ForAsLongAs":
		tmp: Duration_ForAsLongAs
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^Duration_ForAsLongAs) -> bool {
	if fv, found := get_any(v, "condition"); found { if !decode_StaticCondition(fv, &out.condition) do return fail("Duration::ForAsLongAs.condition") } else { return fail("Duration::ForAsLongAs.condition missing") }
	return true
		}) { return fail("Duration::ForAsLongAs") }
		out^ = tmp
	case "UntilSourceExilesAnotherCard": out^ = Duration_UntilSourceExilesAnotherCard{}
	case "UntilOpponentBecomesMonarch": out^ = Duration_UntilOpponentBecomesMonarch{}
	case "UntilEvent":
		tmp: Duration_UntilEvent
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^Duration_UntilEvent) -> bool {
	if fv, found := get_any(v, "event"); found { if !dec_ptr_TriggerDefinition(fv, &out.event) do return fail("Duration::UntilEvent.event") } else { return fail("Duration::UntilEvent.event missing") }
	return true
		}) { return fail("Duration::UntilEvent") }
		out^ = tmp
	case "Permanent": out^ = Duration_Permanent{}
	case: return fail("Duration: unknown variant")
	}
	return true
}

encode_Duration :: proc(b: ^strings.Builder, x: Duration) {
	#partial switch y in x {
	case Duration_UntilEndOfTurn: _ = y; json.write_string(b, "UntilEndOfTurn")
	case Duration_UntilEndOfCombat: _ = y; json.write_string(b, "UntilEndOfCombat")
	case Duration_UntilNextTurnOf: strings.write_byte(b, '{'); json.write_string(b, "UntilNextTurnOf"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case Duration_UntilEndOfNextTurnOf: strings.write_byte(b, '{'); json.write_string(b, "UntilEndOfNextTurnOf"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case Duration_UntilHostLeavesPlay: _ = y; json.write_string(b, "UntilHostLeavesPlay")
	case Duration_WhileHostOnBattlefield: _ = y; json.write_string(b, "WhileHostOnBattlefield")
	case Duration_WhileControllingHost: _ = y; json.write_string(b, "WhileControllingHost")
	case Duration_UntilNextStepOf: strings.write_byte(b, '{'); json.write_string(b, "UntilNextStepOf"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "step"); encode_Phase(b, y.step)
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case Duration_ForAsLongAs: strings.write_byte(b, '{'); json.write_string(b, "ForAsLongAs"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "condition"); encode_StaticCondition(b, y.condition)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case Duration_UntilSourceExilesAnotherCard: _ = y; json.write_string(b, "UntilSourceExilesAnotherCard")
	case Duration_UntilOpponentBecomesMonarch: _ = y; json.write_string(b, "UntilOpponentBecomesMonarch")
	case Duration_UntilEvent: strings.write_byte(b, '{'); json.write_string(b, "UntilEvent"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "event"); enc_ptr_TriggerDefinition(b, y.event)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case Duration_Permanent: _ = y; json.write_string(b, "Permanent")
	}
}

decode_ActivationManaPaymentRestriction :: proc(v: json.Value, out: ^ActivationManaPaymentRestriction) -> bool {
	if v.kind != .String do return fail("ActivationManaPaymentRestriction: not a string")
	str := v.text
	switch str {
	case "OnlySourceChosenColor": out^ = .OnlySourceChosenColor
	case: return fail("ActivationManaPaymentRestriction: unknown variant")
	}
	return true
}

encode_ActivationManaPaymentRestriction :: proc(b: ^strings.Builder, x: ActivationManaPaymentRestriction) {
	@(static, rodata) NAMES := [ActivationManaPaymentRestriction]string{
		.OnlySourceChosenColor = "OnlySourceChosenColor",
	}
	json.write_string(b, NAMES[x])
}

decode_PlayerFilter :: proc(v: json.Value, out: ^PlayerFilter) -> bool {
	if v.kind != .Object do return fail("PlayerFilter: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("PlayerFilter: no tag")
	switch tv.text {
	case "Controller": out^ = PlayerFilter_Controller{}
	case "Opponent": out^ = PlayerFilter_Opponent{}
	case "DefendingPlayer": out^ = PlayerFilter_DefendingPlayer{}
	case "OpponentLostLife": out^ = PlayerFilter_OpponentLostLife{}
	case "OpponentGainedLife": out^ = PlayerFilter_OpponentGainedLife{}
	case "HasLostTheGame": out^ = PlayerFilter_HasLostTheGame{}
	case "OpponentDealtDamage", "OpponentDealtCombatDamage":
		tmp: PlayerFilter_OpponentDealtDamage
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerFilter_OpponentDealtDamage) -> bool {
	if fv, found := get_any(v, "kind"); found { if !decode_DamageKindFilter(fv, &out.kind) do return fail("PlayerFilter::OpponentDealtDamage.kind") } else { out.kind = default_PlayerFilter_damage_kind_combat_only() }
	if fv, found := get_any(v, "source"); found { if !dec_ptr_TargetFilter(fv, &out.source) do return fail("PlayerFilter::OpponentDealtDamage.source") }
	if fv, found := get_any(v, "min_sources"); found { if !decode_u32(fv, &out.min_sources) do return fail("PlayerFilter::OpponentDealtDamage.min_sources") } else { out.min_sources = default_PlayerFilter_default_one() }
	if fv, found := get_any(v, "relation"); found { if !decode_PlayerRelation(fv, &out.relation) do return fail("PlayerFilter::OpponentDealtDamage.relation") } else { out.relation = default_PlayerFilter_player_relation_opponent() }
	return true
		}) { return fail("PlayerFilter::OpponentDealtDamage") }
		out^ = tmp
	case "OpponentAttacked":
		tmp: PlayerFilter_OpponentAttacked
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerFilter_OpponentAttacked) -> bool {
	if fv, found := get_any(v, "subject"); found { if !decode_AttackSubject(fv, &out.subject) do return fail("PlayerFilter::OpponentAttacked.subject") } else { return fail("PlayerFilter::OpponentAttacked.subject missing") }
	if fv, found := get_any(v, "scope"); found { if !decode_CombatHistoryScope(fv, &out.scope) do return fail("PlayerFilter::OpponentAttacked.scope") } else { return fail("PlayerFilter::OpponentAttacked.scope missing") }
	return true
		}) { return fail("PlayerFilter::OpponentAttacked") }
		out^ = tmp
	case "OpponentAttackingEnchantedPlayer": out^ = PlayerFilter_OpponentAttackingEnchantedPlayer{}
	case "All": out^ = PlayerFilter_All{}
	case "AllExcept":
		tmp: PlayerFilter_AllExcept
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerFilter_AllExcept) -> bool {
	if fv, found := get_any(v, "exclude"); found { if !dec_ptr_PlayerFilter(fv, &out.exclude) do return fail("PlayerFilter::AllExcept.exclude") } else { return fail("PlayerFilter::AllExcept.exclude missing") }
	if fv, found := get_any(v, "relation"); found { if !decode_PlayerRelation(fv, &out.relation) do return fail("PlayerFilter::AllExcept.relation") } else { out.relation = default_PlayerFilter_player_relation_all() }
	return true
		}) { return fail("PlayerFilter::AllExcept") }
		out^ = tmp
	case "HighestSpeed": out^ = PlayerFilter_HighestSpeed{}
	case "ZoneChangedThisWay": out^ = PlayerFilter_ZoneChangedThisWay{}
	case "PerformedActionThisWay":
		tmp: PlayerFilter_PerformedActionThisWay
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerFilter_PerformedActionThisWay) -> bool {
	if fv, found := get_any(v, "relation"); found { if !decode_PlayerRelation(fv, &out.relation) do return fail("PlayerFilter::PerformedActionThisWay.relation") } else { return fail("PlayerFilter::PerformedActionThisWay.relation missing") }
	if fv, found := get_any(v, "action"); found { if !decode_PlayerActionKind(fv, &out.action) do return fail("PlayerFilter::PerformedActionThisWay.action") } else { return fail("PlayerFilter::PerformedActionThisWay.action missing") }
	return true
		}) { return fail("PlayerFilter::PerformedActionThisWay") }
		out^ = tmp
	case "OwnersOfCardsExiledBySource": out^ = PlayerFilter_OwnersOfCardsExiledBySource{}
	case "TriggeringPlayer": out^ = PlayerFilter_TriggeringPlayer{}
	case "OpponentOtherThanTriggering": out^ = PlayerFilter_OpponentOtherThanTriggering{}
	case "OpponentOfTriggeringPlayer": out^ = PlayerFilter_OpponentOfTriggeringPlayer{}
	case "OpponentOfTriggeringPlayerNotAttacked": out^ = PlayerFilter_OpponentOfTriggeringPlayerNotAttacked{}
	case "VotedFor":
		tmp: PlayerFilter_VotedFor
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerFilter_VotedFor) -> bool {
	if fv, found := get_any(v, "choice_index"); found { if !decode_u32(fv, &out.choice_index) do return fail("PlayerFilter::VotedFor.choice_index") } else { return fail("PlayerFilter::VotedFor.choice_index missing") }
	return true
		}) { return fail("PlayerFilter::VotedFor") }
		out^ = tmp
	case "ParentObjectTargetController": out^ = PlayerFilter_ParentObjectTargetController{}
	case "ControlsCount", "ControlsPermanent":
		tmp: PlayerFilter_ControlsCount
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerFilter_ControlsCount) -> bool {
	if fv, found := get_any(v, "relation"); found { if !decode_PlayerRelation(fv, &out.relation) do return fail("PlayerFilter::ControlsCount.relation") } else { return fail("PlayerFilter::ControlsCount.relation missing") }
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("PlayerFilter::ControlsCount.filter") } else { return fail("PlayerFilter::ControlsCount.filter missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("PlayerFilter::ControlsCount.comparator") } else { out.comparator = default_PlayerFilter_default_comparator_ge() }
	if fv, found := get_any(v, "count"); found { if !dec_ptr_QuantityExpr(fv, &out.count) do return fail("PlayerFilter::ControlsCount.count") } else { out.count = default_PlayerFilter_default_controls_count_one() }
	return true
		}) { return fail("PlayerFilter::ControlsCount") }
		out^ = tmp
	case "PlayerAttribute":
		tmp: PlayerFilter_PlayerAttribute
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerFilter_PlayerAttribute) -> bool {
	if fv, found := get_any(v, "relation"); found { if !decode_PlayerRelation(fv, &out.relation) do return fail("PlayerFilter::PlayerAttribute.relation") } else { return fail("PlayerFilter::PlayerAttribute.relation missing") }
	if fv, found := get_any(v, "attr"); found { if !dec_ptr_QuantityRef(fv, &out.attr) do return fail("PlayerFilter::PlayerAttribute.attr") } else { return fail("PlayerFilter::PlayerAttribute.attr missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("PlayerFilter::PlayerAttribute.comparator") } else { return fail("PlayerFilter::PlayerAttribute.comparator missing") }
	if fv, found := get_any(v, "value"); found { if !dec_ptr_QuantityExpr(fv, &out.value) do return fail("PlayerFilter::PlayerAttribute.value") } else { return fail("PlayerFilter::PlayerAttribute.value missing") }
	return true
		}) { return fail("PlayerFilter::PlayerAttribute") }
		out^ = tmp
	case "ChosenPlayer":
		tmp: PlayerFilter_ChosenPlayer
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerFilter_ChosenPlayer) -> bool {
	if fv, found := get_any(v, "index"); found { if !decode_u8(fv, &out.index) do return fail("PlayerFilter::ChosenPlayer.index") } else { return fail("PlayerFilter::ChosenPlayer.index missing") }
	return true
		}) { return fail("PlayerFilter::ChosenPlayer") }
		out^ = tmp
	case "ParentObjectTargetOwner": out^ = PlayerFilter_ParentObjectTargetOwner{}
	case "GrantingObjectCaster": out^ = PlayerFilter_GrantingObjectCaster{}
	case "AnyOf":
		tmp: PlayerFilter_AnyOf
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerFilter_AnyOf) -> bool {
	if fv, found := get_any(v, "filters"); found { if !dec_dyn_PlayerFilter(fv, &out.filters) do return fail("PlayerFilter::AnyOf.filters") } else { return fail("PlayerFilter::AnyOf.filters missing") }
	return true
		}) { return fail("PlayerFilter::AnyOf") }
		out^ = tmp
	case "TargetPlayer": out^ = PlayerFilter_TargetPlayer{}
	case "TrackedSetPossessor":
		tmp: PlayerFilter_TrackedSetPossessor
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerFilter_TrackedSetPossessor) -> bool {
	if fv, found := get_any(v, "relation"); found { if !decode_PlayerRelation(fv, &out.relation) do return fail("PlayerFilter::TrackedSetPossessor.relation") } else { return fail("PlayerFilter::TrackedSetPossessor.relation missing") }
	if fv, found := get_any(v, "possession"); found { if !decode_PossessionAxis(fv, &out.possession) do return fail("PlayerFilter::TrackedSetPossessor.possession") } else { return fail("PlayerFilter::TrackedSetPossessor.possession missing") }
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("PlayerFilter::TrackedSetPossessor.filter") } else { return fail("PlayerFilter::TrackedSetPossessor.filter missing") }
	if fv, found := get_any(v, "caused_by"); found { if !dec_opt_ThisWayCause(fv, &out.caused_by) do return fail("PlayerFilter::TrackedSetPossessor.caused_by") }
	return true
		}) { return fail("PlayerFilter::TrackedSetPossessor") }
		out^ = tmp
	case: return fail("PlayerFilter: unknown variant")
	}
	return true
}

encode_PlayerFilter :: proc(b: ^strings.Builder, x: PlayerFilter) {
	#partial switch y in x {
	case PlayerFilter_Controller: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Controller"); strings.write_byte(b, '}')
	case PlayerFilter_Opponent: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Opponent"); strings.write_byte(b, '}')
	case PlayerFilter_DefendingPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DefendingPlayer"); strings.write_byte(b, '}')
	case PlayerFilter_OpponentLostLife: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpponentLostLife"); strings.write_byte(b, '}')
	case PlayerFilter_OpponentGainedLife: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpponentGainedLife"); strings.write_byte(b, '}')
	case PlayerFilter_HasLostTheGame: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasLostTheGame"); strings.write_byte(b, '}')
	case PlayerFilter_OpponentDealtDamage: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "OpponentDealtDamage")
	member(b, first, "kind"); encode_DamageKindFilter(b, y.kind)
	if !(y.source == nil) { member(b, first, "source"); enc_ptr_TargetFilter(b, y.source) }
	if !(skip_PlayerFilter_is_one(y.min_sources)) { member(b, first, "min_sources"); encode_u32(b, y.min_sources) }
	if !(skip_PlayerFilter_is_player_relation_opponent(y.relation)) { member(b, first, "relation"); encode_PlayerRelation(b, y.relation) }
	}; strings.write_byte(b, '}')
	case PlayerFilter_OpponentAttacked: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "OpponentAttacked")
	member(b, first, "subject"); encode_AttackSubject(b, y.subject)
	member(b, first, "scope"); encode_CombatHistoryScope(b, y.scope)
	}; strings.write_byte(b, '}')
	case PlayerFilter_OpponentAttackingEnchantedPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpponentAttackingEnchantedPlayer"); strings.write_byte(b, '}')
	case PlayerFilter_All: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "All"); strings.write_byte(b, '}')
	case PlayerFilter_AllExcept: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AllExcept")
	member(b, first, "exclude"); enc_ptr_PlayerFilter(b, y.exclude)
	if !(skip_PlayerFilter_is_player_relation_all(y.relation)) { member(b, first, "relation"); encode_PlayerRelation(b, y.relation) }
	}; strings.write_byte(b, '}')
	case PlayerFilter_HighestSpeed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HighestSpeed"); strings.write_byte(b, '}')
	case PlayerFilter_ZoneChangedThisWay: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ZoneChangedThisWay"); strings.write_byte(b, '}')
	case PlayerFilter_PerformedActionThisWay: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PerformedActionThisWay")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "action"); encode_PlayerActionKind(b, y.action)
	}; strings.write_byte(b, '}')
	case PlayerFilter_OwnersOfCardsExiledBySource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OwnersOfCardsExiledBySource"); strings.write_byte(b, '}')
	case PlayerFilter_TriggeringPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TriggeringPlayer"); strings.write_byte(b, '}')
	case PlayerFilter_OpponentOtherThanTriggering: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpponentOtherThanTriggering"); strings.write_byte(b, '}')
	case PlayerFilter_OpponentOfTriggeringPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpponentOfTriggeringPlayer"); strings.write_byte(b, '}')
	case PlayerFilter_OpponentOfTriggeringPlayerNotAttacked: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpponentOfTriggeringPlayerNotAttacked"); strings.write_byte(b, '}')
	case PlayerFilter_VotedFor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "VotedFor")
	member(b, first, "choice_index"); encode_u32(b, y.choice_index)
	}; strings.write_byte(b, '}')
	case PlayerFilter_ParentObjectTargetController: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ParentObjectTargetController"); strings.write_byte(b, '}')
	case PlayerFilter_ControlsCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControlsCount")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "count"); enc_ptr_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	case PlayerFilter_PlayerAttribute: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PlayerAttribute")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "attr"); enc_ptr_QuantityRef(b, y.attr)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); enc_ptr_QuantityExpr(b, y.value)
	}; strings.write_byte(b, '}')
	case PlayerFilter_ChosenPlayer: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChosenPlayer")
	member(b, first, "index"); encode_u8(b, y.index)
	}; strings.write_byte(b, '}')
	case PlayerFilter_ParentObjectTargetOwner: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ParentObjectTargetOwner"); strings.write_byte(b, '}')
	case PlayerFilter_GrantingObjectCaster: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "GrantingObjectCaster"); strings.write_byte(b, '}')
	case PlayerFilter_AnyOf: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AnyOf")
	member(b, first, "filters"); enc_dyn_PlayerFilter(b, y.filters)
	}; strings.write_byte(b, '}')
	case PlayerFilter_TargetPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TargetPlayer"); strings.write_byte(b, '}')
	case PlayerFilter_TrackedSetPossessor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TrackedSetPossessor")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "possession"); encode_PossessionAxis(b, y.possession)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	if !(y.caused_by == nil) { member(b, first, "caused_by"); enc_opt_ThisWayCause(b, y.caused_by) }
	}; strings.write_byte(b, '}')
	}
}

encode_PlayerFilter_members :: proc(b: ^strings.Builder, x: PlayerFilter, first: ^bool) {
	#partial switch y in x {
	case PlayerFilter_Controller: _ = y; member(b, first, "type"); json.write_string(b, "Controller")
	case PlayerFilter_Opponent: _ = y; member(b, first, "type"); json.write_string(b, "Opponent")
	case PlayerFilter_DefendingPlayer: _ = y; member(b, first, "type"); json.write_string(b, "DefendingPlayer")
	case PlayerFilter_OpponentLostLife: _ = y; member(b, first, "type"); json.write_string(b, "OpponentLostLife")
	case PlayerFilter_OpponentGainedLife: _ = y; member(b, first, "type"); json.write_string(b, "OpponentGainedLife")
	case PlayerFilter_HasLostTheGame: _ = y; member(b, first, "type"); json.write_string(b, "HasLostTheGame")
	case PlayerFilter_OpponentDealtDamage: member(b, first, "type"); json.write_string(b, "OpponentDealtDamage")
	member(b, first, "kind"); encode_DamageKindFilter(b, y.kind)
	if !(y.source == nil) { member(b, first, "source"); enc_ptr_TargetFilter(b, y.source) }
	if !(skip_PlayerFilter_is_one(y.min_sources)) { member(b, first, "min_sources"); encode_u32(b, y.min_sources) }
	if !(skip_PlayerFilter_is_player_relation_opponent(y.relation)) { member(b, first, "relation"); encode_PlayerRelation(b, y.relation) }

	case PlayerFilter_OpponentAttacked: member(b, first, "type"); json.write_string(b, "OpponentAttacked")
	member(b, first, "subject"); encode_AttackSubject(b, y.subject)
	member(b, first, "scope"); encode_CombatHistoryScope(b, y.scope)

	case PlayerFilter_OpponentAttackingEnchantedPlayer: _ = y; member(b, first, "type"); json.write_string(b, "OpponentAttackingEnchantedPlayer")
	case PlayerFilter_All: _ = y; member(b, first, "type"); json.write_string(b, "All")
	case PlayerFilter_AllExcept: member(b, first, "type"); json.write_string(b, "AllExcept")
	member(b, first, "exclude"); enc_ptr_PlayerFilter(b, y.exclude)
	if !(skip_PlayerFilter_is_player_relation_all(y.relation)) { member(b, first, "relation"); encode_PlayerRelation(b, y.relation) }

	case PlayerFilter_HighestSpeed: _ = y; member(b, first, "type"); json.write_string(b, "HighestSpeed")
	case PlayerFilter_ZoneChangedThisWay: _ = y; member(b, first, "type"); json.write_string(b, "ZoneChangedThisWay")
	case PlayerFilter_PerformedActionThisWay: member(b, first, "type"); json.write_string(b, "PerformedActionThisWay")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "action"); encode_PlayerActionKind(b, y.action)

	case PlayerFilter_OwnersOfCardsExiledBySource: _ = y; member(b, first, "type"); json.write_string(b, "OwnersOfCardsExiledBySource")
	case PlayerFilter_TriggeringPlayer: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringPlayer")
	case PlayerFilter_OpponentOtherThanTriggering: _ = y; member(b, first, "type"); json.write_string(b, "OpponentOtherThanTriggering")
	case PlayerFilter_OpponentOfTriggeringPlayer: _ = y; member(b, first, "type"); json.write_string(b, "OpponentOfTriggeringPlayer")
	case PlayerFilter_OpponentOfTriggeringPlayerNotAttacked: _ = y; member(b, first, "type"); json.write_string(b, "OpponentOfTriggeringPlayerNotAttacked")
	case PlayerFilter_VotedFor: member(b, first, "type"); json.write_string(b, "VotedFor")
	member(b, first, "choice_index"); encode_u32(b, y.choice_index)

	case PlayerFilter_ParentObjectTargetController: _ = y; member(b, first, "type"); json.write_string(b, "ParentObjectTargetController")
	case PlayerFilter_ControlsCount: member(b, first, "type"); json.write_string(b, "ControlsCount")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "count"); enc_ptr_QuantityExpr(b, y.count)

	case PlayerFilter_PlayerAttribute: member(b, first, "type"); json.write_string(b, "PlayerAttribute")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "attr"); enc_ptr_QuantityRef(b, y.attr)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); enc_ptr_QuantityExpr(b, y.value)

	case PlayerFilter_ChosenPlayer: member(b, first, "type"); json.write_string(b, "ChosenPlayer")
	member(b, first, "index"); encode_u8(b, y.index)

	case PlayerFilter_ParentObjectTargetOwner: _ = y; member(b, first, "type"); json.write_string(b, "ParentObjectTargetOwner")
	case PlayerFilter_GrantingObjectCaster: _ = y; member(b, first, "type"); json.write_string(b, "GrantingObjectCaster")
	case PlayerFilter_AnyOf: member(b, first, "type"); json.write_string(b, "AnyOf")
	member(b, first, "filters"); enc_dyn_PlayerFilter(b, y.filters)

	case PlayerFilter_TargetPlayer: _ = y; member(b, first, "type"); json.write_string(b, "TargetPlayer")
	case PlayerFilter_TrackedSetPossessor: member(b, first, "type"); json.write_string(b, "TrackedSetPossessor")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "possession"); encode_PossessionAxis(b, y.possession)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	if !(y.caused_by == nil) { member(b, first, "caused_by"); enc_opt_ThisWayCause(b, y.caused_by) }

	}
}

decode_Zone :: proc(v: json.Value, out: ^Zone) -> bool {
	if v.kind != .String do return fail("Zone: not a string")
	str := v.text
	switch str {
	case "Library": out^ = .Library
	case "Hand": out^ = .Hand
	case "Battlefield": out^ = .Battlefield
	case "Graveyard": out^ = .Graveyard
	case "Stack": out^ = .Stack
	case "Exile": out^ = .Exile
	case "Command": out^ = .Command
	case: return fail("Zone: unknown variant")
	}
	return true
}

encode_Zone :: proc(b: ^strings.Builder, x: Zone) {
	@(static, rodata) NAMES := [Zone]string{
		.Library = "Library",
		.Hand = "Hand",
		.Battlefield = "Battlefield",
		.Graveyard = "Graveyard",
		.Stack = "Stack",
		.Exile = "Exile",
		.Command = "Command",
	}
	json.write_string(b, NAMES[x])
}

decode_AbilityTag :: proc(v: json.Value, out: ^AbilityTag) -> bool {
	if v.kind != .Object do return fail("AbilityTag: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("AbilityTag: no tag")
	str := tv.text
	switch str {
	case "Boast": out^ = .Boast
	case "Evolve": out^ = .Evolve
	case "Exhaust": out^ = .Exhaust
	case "Outlast": out^ = .Outlast
	case "Cycling": out^ = .Cycling
	case "Backup": out^ = .Backup
	case "PowerUp": out^ = .PowerUp
	case "Equip": out^ = .Equip
	case "Augment": out^ = .Augment
	case: return fail("AbilityTag: unknown variant")
	}
	return true
}

encode_AbilityTag :: proc(b: ^strings.Builder, x: AbilityTag) {
	strings.write_byte(b, '{')
	f := true
	encode_AbilityTag_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_AbilityTag_members :: proc(b: ^strings.Builder, x: AbilityTag, first: ^bool) {
	_ = x
	@(static, rodata) NAMES := [AbilityTag]string{
		.Boast = "Boast",
		.Evolve = "Evolve",
		.Exhaust = "Exhaust",
		.Outlast = "Outlast",
		.Cycling = "Cycling",
		.Backup = "Backup",
		.PowerUp = "PowerUp",
		.Equip = "Equip",
		.Augment = "Augment",
	}
	member(b, first, "type"); json.write_string(b, NAMES[x])
}

decode_AbilityCondition :: proc(v: json.Value, out: ^AbilityCondition) -> bool {
	if v.kind != .Object do return fail("AbilityCondition: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("AbilityCondition: no tag")
	switch tv.text {
	case "TriggerEventTargetDamagedBySourceThisTurn": out^ = AbilityCondition_TriggerEventTargetDamagedBySourceThisTurn{}
	case "TriggerEventTargetExploitedBySource": out^ = AbilityCondition_TriggerEventTargetExploitedBySource{}
	case "AdditionalCostPaid":
		tmp: AbilityCondition_AdditionalCostPaid
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_AdditionalCostPaid) -> bool {
	if fv, found := get_any(v, "subject"); found { if !decode_ObjectScope(fv, &out.subject) do return fail("AbilityCondition::AdditionalCostPaid.subject") } else { out.subject = default_AbilityCondition_AbilityCondition_default_subject_source() }
	if fv, found := get_any(v, "source"); found { if !decode_AdditionalCostPaymentSource(fv, &out.source) do return fail("AbilityCondition::AdditionalCostPaid.source") }
	if fv, found := get_any(v, "origin"); found { if !dec_opt_AdditionalCostOrigin(fv, &out.origin) do return fail("AbilityCondition::AdditionalCostPaid.origin") }
	if fv, found := get_any(v, "origin_ordinal"); found { if !dec_opt_u32(fv, &out.origin_ordinal) do return fail("AbilityCondition::AdditionalCostPaid.origin_ordinal") }
	if fv, found := get_any(v, "variant"); found { if !dec_opt_KickerVariant(fv, &out.variant) do return fail("AbilityCondition::AdditionalCostPaid.variant") }
	if fv, found := get_any(v, "kicker_cost"); found { if !dec_opt_ManaCost(fv, &out.kicker_cost) do return fail("AbilityCondition::AdditionalCostPaid.kicker_cost") }
	if fv, found := get_any(v, "min_count"); found { if !decode_u32(fv, &out.min_count) do return fail("AbilityCondition::AdditionalCostPaid.min_count") } else { out.min_count = default_AbilityCondition_AbilityCondition_default_min_count() }
	return true
		}) { return fail("AbilityCondition::AdditionalCostPaid") }
		out^ = tmp
	case "AdditionalCostPaidInstead": out^ = AbilityCondition_AdditionalCostPaidInstead{}
	case "AlternativeManaCostPaid": out^ = AbilityCondition_AlternativeManaCostPaid{}
	case "EffectOutcome":
		tmp: AbilityCondition_EffectOutcome
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_EffectOutcome) -> bool {
	if fv, found := get_any(v, "signal"); found { if !decode_EffectOutcomeSignal(fv, &out.signal) do return fail("AbilityCondition::EffectOutcome.signal") } else { return fail("AbilityCondition::EffectOutcome.signal missing") }
	return true
		}) { return fail("AbilityCondition::EffectOutcome") }
		out^ = tmp
	case "EventOutcomeWon": out^ = AbilityCondition_EventOutcomeWon{}
	case "CoinFlipOutcome":
		tmp: AbilityCondition_CoinFlipOutcome
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_CoinFlipOutcome) -> bool {
	if fv, found := get_any(v, "result"); found { if !decode_CoinFlipResult(fv, &out.result) do return fail("AbilityCondition::CoinFlipOutcome.result") } else { return fail("AbilityCondition::CoinFlipOutcome.result missing") }
	return true
		}) { return fail("AbilityCondition::CoinFlipOutcome") }
		out^ = tmp
	case "ChosenLabelIs":
		tmp: AbilityCondition_ChosenLabelIs
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_ChosenLabelIs) -> bool {
	if fv, found := get_any(v, "label"); found { if !decode_string(fv, &out.label) do return fail("AbilityCondition::ChosenLabelIs.label") } else { return fail("AbilityCondition::ChosenLabelIs.label missing") }
	return true
		}) { return fail("AbilityCondition::ChosenLabelIs") }
		out^ = tmp
	case "WhenYouDo": out^ = AbilityCondition_WhenYouDo{}
	case "WasCast", "CastFromZone":
		tmp: AbilityCondition_WasCast
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_WasCast) -> bool {
	if fv, found := get_any(v, "zone"); found { if !dec_opt_Zone(fv, &out.zone) do return fail("AbilityCondition::WasCast.zone") }
	return true
		}) { return fail("AbilityCondition::WasCast") }
		out^ = tmp
	case "CastDuringPhase":
		tmp: AbilityCondition_CastDuringPhase
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_CastDuringPhase) -> bool {
	if fv, found := get_any(v, "phases"); found { if !dec_dyn_Phase(fv, &out.phases) do return fail("AbilityCondition::CastDuringPhase.phases") } else { return fail("AbilityCondition::CastDuringPhase.phases missing") }
	return true
		}) { return fail("AbilityCondition::CastDuringPhase") }
		out^ = tmp
	case "CurrentPhaseIs":
		tmp: AbilityCondition_CurrentPhaseIs
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_CurrentPhaseIs) -> bool {
	if fv, found := get_any(v, "phases"); found { if !dec_dyn_Phase(fv, &out.phases) do return fail("AbilityCondition::CurrentPhaseIs.phases") } else { return fail("AbilityCondition::CurrentPhaseIs.phases missing") }
	return true
		}) { return fail("AbilityCondition::CurrentPhaseIs") }
		out^ = tmp
	case "CastTimingPermission":
		tmp: AbilityCondition_CastTimingPermission
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_CastTimingPermission) -> bool {
	if fv, found := get_any(v, "permission"); found { if !decode_CastTimingPermission(fv, &out.permission) do return fail("AbilityCondition::CastTimingPermission.permission") } else { return fail("AbilityCondition::CastTimingPermission.permission missing") }
	return true
		}) { return fail("AbilityCondition::CastTimingPermission") }
		out^ = tmp
	case "ManaColorSpent":
		tmp: AbilityCondition_ManaColorSpent
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_ManaColorSpent) -> bool {
	if fv, found := get_any(v, "color"); found { if !decode_SpentColor(fv, &out.color) do return fail("AbilityCondition::ManaColorSpent.color") } else { return fail("AbilityCondition::ManaColorSpent.color missing") }
	if fv, found := get_any(v, "minimum"); found { if !decode_u32(fv, &out.minimum) do return fail("AbilityCondition::ManaColorSpent.minimum") } else { return fail("AbilityCondition::ManaColorSpent.minimum missing") }
	return true
		}) { return fail("AbilityCondition::ManaColorSpent") }
		out^ = tmp
	case "RevealedHasCardType":
		tmp: AbilityCondition_RevealedHasCardType
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_RevealedHasCardType) -> bool {
	if fv, found := get_any(v, "card_types", "card_type"); found { if !dec_dyn_CoreType(fv, &out.card_types) do return fail("AbilityCondition::RevealedHasCardType.card_types") }
	if fv, found := get_any(v, "additional_filter"); found { if !dec_opt_FilterProp(fv, &out.additional_filter) do return fail("AbilityCondition::RevealedHasCardType.additional_filter") }
	if fv, found := get_any(v, "subtype_filter"); found { if !dec_ptr_TargetFilter(fv, &out.subtype_filter) do return fail("AbilityCondition::RevealedHasCardType.subtype_filter") }
	return true
		}) { return fail("AbilityCondition::RevealedHasCardType") }
		out^ = tmp
	case "ObjectsShareQuality":
		tmp: AbilityCondition_ObjectsShareQuality
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_ObjectsShareQuality) -> bool {
	if fv, found := get_any(v, "subject"); found { if !decode_TargetFilter(fv, &out.subject) do return fail("AbilityCondition::ObjectsShareQuality.subject") } else { return fail("AbilityCondition::ObjectsShareQuality.subject missing") }
	if fv, found := get_any(v, "reference"); found { if !decode_TargetFilter(fv, &out.reference) do return fail("AbilityCondition::ObjectsShareQuality.reference") } else { return fail("AbilityCondition::ObjectsShareQuality.reference missing") }
	if fv, found := get_any(v, "quality"); found { if !decode_SharedQuality(fv, &out.quality) do return fail("AbilityCondition::ObjectsShareQuality.quality") } else { return fail("AbilityCondition::ObjectsShareQuality.quality missing") }
	return true
		}) { return fail("AbilityCondition::ObjectsShareQuality") }
		out^ = tmp
	case "TargetSharesNameWithOtherExiledThisWay":
		tmp: AbilityCondition_TargetSharesNameWithOtherExiledThisWay
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_TargetSharesNameWithOtherExiledThisWay) -> bool {
	if fv, found := get_any(v, "target"); found { if !decode_TargetFilter(fv, &out.target) do return fail("AbilityCondition::TargetSharesNameWithOtherExiledThisWay.target") } else { return fail("AbilityCondition::TargetSharesNameWithOtherExiledThisWay.target missing") }
	return true
		}) { return fail("AbilityCondition::TargetSharesNameWithOtherExiledThisWay") }
		out^ = tmp
	case "SourceEnteredThisTurn": out^ = AbilityCondition_SourceEnteredThisTurn{}
	case "CastVariantPaid":
		tmp: AbilityCondition_CastVariantPaid
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_CastVariantPaid) -> bool {
	if fv, found := get_any(v, "variant"); found { if !decode_CastVariantPaid(fv, &out.variant) do return fail("AbilityCondition::CastVariantPaid.variant") } else { return fail("AbilityCondition::CastVariantPaid.variant missing") }
	if fv, found := get_any(v, "subject"); found { if !decode_ObjectScope(fv, &out.subject) do return fail("AbilityCondition::CastVariantPaid.subject") } else { out.subject = default_AbilityCondition_AbilityCondition_default_subject_source() }
	return true
		}) { return fail("AbilityCondition::CastVariantPaid") }
		out^ = tmp
	case "CastVariantPaidInstead":
		tmp: AbilityCondition_CastVariantPaidInstead
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_CastVariantPaidInstead) -> bool {
	if fv, found := get_any(v, "variant"); found { if !decode_CastVariantPaid(fv, &out.variant) do return fail("AbilityCondition::CastVariantPaidInstead.variant") } else { return fail("AbilityCondition::CastVariantPaidInstead.variant missing") }
	return true
		}) { return fail("AbilityCondition::CastVariantPaidInstead") }
		out^ = tmp
	case "QuantityCheck":
		tmp: AbilityCondition_QuantityCheck
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_QuantityCheck) -> bool {
	if fv, found := get_any(v, "lhs"); found { if !decode_QuantityExpr(fv, &out.lhs) do return fail("AbilityCondition::QuantityCheck.lhs") } else { return fail("AbilityCondition::QuantityCheck.lhs missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("AbilityCondition::QuantityCheck.comparator") } else { return fail("AbilityCondition::QuantityCheck.comparator missing") }
	if fv, found := get_any(v, "rhs"); found { if !decode_QuantityExpr(fv, &out.rhs) do return fail("AbilityCondition::QuantityCheck.rhs") } else { return fail("AbilityCondition::QuantityCheck.rhs missing") }
	return true
		}) { return fail("AbilityCondition::QuantityCheck") }
		out^ = tmp
	case "QuantityQuality":
		tmp: AbilityCondition_QuantityQuality
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_QuantityQuality) -> bool {
	if fv, found := get_any(v, "quantity"); found { if !decode_QuantityExpr(fv, &out.quantity) do return fail("AbilityCondition::QuantityQuality.quantity") } else { return fail("AbilityCondition::QuantityQuality.quantity missing") }
	if fv, found := get_any(v, "quality"); found { if !decode_NumberQuality(fv, &out.quality) do return fail("AbilityCondition::QuantityQuality.quality") } else { return fail("AbilityCondition::QuantityQuality.quality missing") }
	return true
		}) { return fail("AbilityCondition::QuantityQuality") }
		out^ = tmp
	case "PreviousEffectAmount":
		tmp: AbilityCondition_PreviousEffectAmount
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_PreviousEffectAmount) -> bool {
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("AbilityCondition::PreviousEffectAmount.comparator") } else { return fail("AbilityCondition::PreviousEffectAmount.comparator missing") }
	if fv, found := get_any(v, "rhs"); found { if !decode_QuantityExpr(fv, &out.rhs) do return fail("AbilityCondition::PreviousEffectAmount.rhs") } else { return fail("AbilityCondition::PreviousEffectAmount.rhs missing") }
	if fv, found := get_any(v, "channel"); found { if !decode_DamageChannel(fv, &out.channel) do return fail("AbilityCondition::PreviousEffectAmount.channel") }
	return true
		}) { return fail("AbilityCondition::PreviousEffectAmount") }
		out^ = tmp
	case "HasMaxSpeed": out^ = AbilityCondition_HasMaxSpeed{}
	case "IsMonarch": out^ = AbilityCondition_IsMonarch{}
	case "IsInitiative": out^ = AbilityCondition_IsInitiative{}
	case "HasCityBlessing": out^ = AbilityCondition_HasCityBlessing{}
	case "HasEnduringStory": out^ = AbilityCondition_HasEnduringStory{}
	case "ControlsCommander":
		tmp: AbilityCondition_ControlsCommander
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_ControlsCommander) -> bool {
	if fv, found := get_any(v, "ownership"); found { if !decode_CommanderOwnership(fv, &out.ownership) do return fail("AbilityCondition::ControlsCommander.ownership") } else { return fail("AbilityCondition::ControlsCommander.ownership missing") }
	return true
		}) { return fail("AbilityCondition::ControlsCommander") }
		out^ = tmp
	case "DiscardedCardMatchesFilter":
		tmp: AbilityCondition_DiscardedCardMatchesFilter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_DiscardedCardMatchesFilter) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("AbilityCondition::DiscardedCardMatchesFilter.filter") } else { return fail("AbilityCondition::DiscardedCardMatchesFilter.filter missing") }
	return true
		}) { return fail("AbilityCondition::DiscardedCardMatchesFilter") }
		out^ = tmp
	case "IsRingBearer": out^ = AbilityCondition_IsRingBearer{}
	case "CompletedDungeon":
		tmp: AbilityCondition_CompletedDungeon
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_CompletedDungeon) -> bool {
	if fv, found := get_any(v, "specific"); found { if !dec_opt_DungeonId(fv, &out.specific) do return fail("AbilityCondition::CompletedDungeon.specific") }
	return true
		}) { return fail("AbilityCondition::CompletedDungeon") }
		out^ = tmp
	case "TargetHasKeywordInstead":
		tmp: AbilityCondition_TargetHasKeywordInstead
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_TargetHasKeywordInstead) -> bool {
	if fv, found := get_any(v, "keyword"); found { if !decode_Keyword(fv, &out.keyword) do return fail("AbilityCondition::TargetHasKeywordInstead.keyword") } else { return fail("AbilityCondition::TargetHasKeywordInstead.keyword missing") }
	return true
		}) { return fail("AbilityCondition::TargetHasKeywordInstead") }
		out^ = tmp
	case "TargetMatchesFilter":
		tmp: AbilityCondition_TargetMatchesFilter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_TargetMatchesFilter) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("AbilityCondition::TargetMatchesFilter.filter") } else { return fail("AbilityCondition::TargetMatchesFilter.filter missing") }
	if fv, found := get_any(v, "use_lki"); found { if !decode_bool(fv, &out.use_lki) do return fail("AbilityCondition::TargetMatchesFilter.use_lki") }
	if fv, found := get_any(v, "subject_slot"); found { if !dec_opt_int(fv, &out.subject_slot) do return fail("AbilityCondition::TargetMatchesFilter.subject_slot") }
	if fv, found := get_any(v, "subject"); found { if !decode_ObjectScope(fv, &out.subject) do return fail("AbilityCondition::TargetMatchesFilter.subject") } else { out.subject = default_AbilityCondition_AbilityCondition_default_subject_target() }
	return true
		}) { return fail("AbilityCondition::TargetMatchesFilter") }
		out^ = tmp
	case "HasObjectTarget": out^ = AbilityCondition_HasObjectTarget{}
	case "TriggeringSpellTargetsFilter":
		tmp: AbilityCondition_TriggeringSpellTargetsFilter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_TriggeringSpellTargetsFilter) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("AbilityCondition::TriggeringSpellTargetsFilter.filter") } else { return fail("AbilityCondition::TriggeringSpellTargetsFilter.filter missing") }
	return true
		}) { return fail("AbilityCondition::TriggeringSpellTargetsFilter") }
		out^ = tmp
	case "SourceMatchesFilter":
		tmp: AbilityCondition_SourceMatchesFilter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_SourceMatchesFilter) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("AbilityCondition::SourceMatchesFilter.filter") } else { return fail("AbilityCondition::SourceMatchesFilter.filter missing") }
	return true
		}) { return fail("AbilityCondition::SourceMatchesFilter") }
		out^ = tmp
	case "PostReplacementDamageSourceMatchesFilter":
		tmp: AbilityCondition_PostReplacementDamageSourceMatchesFilter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_PostReplacementDamageSourceMatchesFilter) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("AbilityCondition::PostReplacementDamageSourceMatchesFilter.filter") } else { return fail("AbilityCondition::PostReplacementDamageSourceMatchesFilter.filter missing") }
	return true
		}) { return fail("AbilityCondition::PostReplacementDamageSourceMatchesFilter") }
		out^ = tmp
	case "ZoneChangeObjectMatchesFilter":
		tmp: AbilityCondition_ZoneChangeObjectMatchesFilter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_ZoneChangeObjectMatchesFilter) -> bool {
	if fv, found := get_any(v, "origin"); found { if !dec_opt_Zone(fv, &out.origin) do return fail("AbilityCondition::ZoneChangeObjectMatchesFilter.origin") }
	if fv, found := get_any(v, "destination"); found { if !decode_Zone(fv, &out.destination) do return fail("AbilityCondition::ZoneChangeObjectMatchesFilter.destination") } else { return fail("AbilityCondition::ZoneChangeObjectMatchesFilter.destination missing") }
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("AbilityCondition::ZoneChangeObjectMatchesFilter.filter") } else { return fail("AbilityCondition::ZoneChangeObjectMatchesFilter.filter missing") }
	return true
		}) { return fail("AbilityCondition::ZoneChangeObjectMatchesFilter") }
		out^ = tmp
	case "ControllerControlsMatching":
		tmp: AbilityCondition_ControllerControlsMatching
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_ControllerControlsMatching) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("AbilityCondition::ControllerControlsMatching.filter") } else { return fail("AbilityCondition::ControllerControlsMatching.filter missing") }
	return true
		}) { return fail("AbilityCondition::ControllerControlsMatching") }
		out^ = tmp
	case "ControllerControlledMatchingAsCast":
		tmp: AbilityCondition_ControllerControlledMatchingAsCast
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_ControllerControlledMatchingAsCast) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("AbilityCondition::ControllerControlledMatchingAsCast.filter") } else { return fail("AbilityCondition::ControllerControlledMatchingAsCast.filter missing") }
	return true
		}) { return fail("AbilityCondition::ControllerControlledMatchingAsCast") }
		out^ = tmp
	case "IsYourTurn": out^ = AbilityCondition_IsYourTurn{}
	case "WasStartingPlayer":
		tmp: AbilityCondition_WasStartingPlayer
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_WasStartingPlayer) -> bool {
	if fv, found := get_any(v, "controller"); found { if !decode_ControllerRef(fv, &out.controller) do return fail("AbilityCondition::WasStartingPlayer.controller") } else { return fail("AbilityCondition::WasStartingPlayer.controller missing") }
	return true
		}) { return fail("AbilityCondition::WasStartingPlayer") }
		out^ = tmp
	case "SpellCastWithVariantThisTurn":
		tmp: AbilityCondition_SpellCastWithVariantThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_SpellCastWithVariantThisTurn) -> bool {
	if fv, found := get_any(v, "variant"); found { if !decode_CastingVariant(fv, &out.variant) do return fail("AbilityCondition::SpellCastWithVariantThisTurn.variant") } else { return fail("AbilityCondition::SpellCastWithVariantThisTurn.variant missing") }
	return true
		}) { return fail("AbilityCondition::SpellCastWithVariantThisTurn") }
		out^ = tmp
	case "FirstCombatPhaseOfTurn": out^ = AbilityCondition_FirstCombatPhaseOfTurn{}
	case "FirstEndStepOfTurn": out^ = AbilityCondition_FirstEndStepOfTurn{}
	case "ZoneChangedThisWay":
		tmp: AbilityCondition_ZoneChangedThisWay
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_ZoneChangedThisWay) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("AbilityCondition::ZoneChangedThisWay.filter") } else { return fail("AbilityCondition::ZoneChangedThisWay.filter missing") }
	if fv, found := get_any(v, "destination"); found { if !dec_opt_Zone(fv, &out.destination) do return fail("AbilityCondition::ZoneChangedThisWay.destination") }
	return true
		}) { return fail("AbilityCondition::ZoneChangedThisWay") }
		out^ = tmp
	case "CostPaidObjectMatchesFilter":
		tmp: AbilityCondition_CostPaidObjectMatchesFilter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_CostPaidObjectMatchesFilter) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("AbilityCondition::CostPaidObjectMatchesFilter.filter") } else { return fail("AbilityCondition::CostPaidObjectMatchesFilter.filter missing") }
	return true
		}) { return fail("AbilityCondition::CostPaidObjectMatchesFilter") }
		out^ = tmp
	case "SourceIsTapped": out^ = AbilityCondition_SourceIsTapped{}
	case "SourceAttachedToCreature": out^ = AbilityCondition_SourceAttachedToCreature{}
	case "ConditionInstead":
		tmp: AbilityCondition_ConditionInstead
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_ConditionInstead) -> bool {
	if fv, found := get_any(v, "inner"); found { if !dec_ptr_AbilityCondition(fv, &out.inner) do return fail("AbilityCondition::ConditionInstead.inner") } else { return fail("AbilityCondition::ConditionInstead.inner missing") }
	return true
		}) { return fail("AbilityCondition::ConditionInstead") }
		out^ = tmp
	case "And":
		tmp: AbilityCondition_And
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_And) -> bool {
	if fv, found := get_any(v, "conditions"); found { if !dec_dyn_AbilityCondition(fv, &out.conditions) do return fail("AbilityCondition::And.conditions") } else { return fail("AbilityCondition::And.conditions missing") }
	return true
		}) { return fail("AbilityCondition::And") }
		out^ = tmp
	case "Or":
		tmp: AbilityCondition_Or
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_Or) -> bool {
	if fv, found := get_any(v, "conditions"); found { if !dec_dyn_AbilityCondition(fv, &out.conditions) do return fail("AbilityCondition::Or.conditions") } else { return fail("AbilityCondition::Or.conditions missing") }
	return true
		}) { return fail("AbilityCondition::Or") }
		out^ = tmp
	case "Not":
		tmp: AbilityCondition_Not
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_Not) -> bool {
	if fv, found := get_any(v, "condition"); found { if !dec_ptr_AbilityCondition(fv, &out.condition) do return fail("AbilityCondition::Not.condition") } else { return fail("AbilityCondition::Not.condition missing") }
	return true
		}) { return fail("AbilityCondition::Not") }
		out^ = tmp
	case "DayNightIsNeither": out^ = AbilityCondition_DayNightIsNeither{}
	case "DayNightIs":
		tmp: AbilityCondition_DayNightIs
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_DayNightIs) -> bool {
	if fv, found := get_any(v, "state"); found { if !decode_DayNight(fv, &out.state) do return fail("AbilityCondition::DayNightIs.state") } else { return fail("AbilityCondition::DayNightIs.state missing") }
	return true
		}) { return fail("AbilityCondition::DayNightIs") }
		out^ = tmp
	case "AbilityUseCountThisTurn", "NthResolutionThisTurn":
		tmp: AbilityCondition_AbilityUseCountThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_AbilityUseCountThisTurn) -> bool {
	if fv, found := get_any(v, "tally"); found { if !decode_AbilityUseTally(fv, &out.tally) do return fail("AbilityCondition::AbilityUseCountThisTurn.tally") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("AbilityCondition::AbilityUseCountThisTurn.comparator") } else { out.comparator = default_AbilityCondition_AbilityCondition_default_use_comparator() }
	if fv, found := get_any(v, "n"); found { if !decode_u32(fv, &out.n) do return fail("AbilityCondition::AbilityUseCountThisTurn.n") } else { return fail("AbilityCondition::AbilityUseCountThisTurn.n missing") }
	return true
		}) { return fail("AbilityCondition::AbilityUseCountThisTurn") }
		out^ = tmp
	case "SourceLacksKeyword":
		tmp: AbilityCondition_SourceLacksKeyword
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_SourceLacksKeyword) -> bool {
	if fv, found := get_any(v, "keyword"); found { if !decode_Keyword(fv, &out.keyword) do return fail("AbilityCondition::SourceLacksKeyword.keyword") } else { return fail("AbilityCondition::SourceLacksKeyword.keyword missing") }
	return true
		}) { return fail("AbilityCondition::SourceLacksKeyword") }
		out^ = tmp
	case "ScopedPlayerMatches":
		tmp: AbilityCondition_ScopedPlayerMatches
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_ScopedPlayerMatches) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_PlayerFilter(fv, &out.filter) do return fail("AbilityCondition::ScopedPlayerMatches.filter") } else { return fail("AbilityCondition::ScopedPlayerMatches.filter missing") }
	return true
		}) { return fail("AbilityCondition::ScopedPlayerMatches") }
		out^ = tmp
	case "PlayerAttackedPlayer":
		tmp: AbilityCondition_PlayerAttackedPlayer
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_PlayerAttackedPlayer) -> bool {
	if fv, found := get_any(v, "attacker"); found { if !decode_PlayerScope(fv, &out.attacker) do return fail("AbilityCondition::PlayerAttackedPlayer.attacker") } else { return fail("AbilityCondition::PlayerAttackedPlayer.attacker missing") }
	if fv, found := get_any(v, "defender"); found { if !decode_PlayerScope(fv, &out.defender) do return fail("AbilityCondition::PlayerAttackedPlayer.defender") } else { return fail("AbilityCondition::PlayerAttackedPlayer.defender missing") }
	return true
		}) { return fail("AbilityCondition::PlayerAttackedPlayer") }
		out^ = tmp
	case: return fail("AbilityCondition: unknown variant")
	}
	return true
}

encode_AbilityCondition :: proc(b: ^strings.Builder, x: AbilityCondition) {
	#partial switch y in x {
	case AbilityCondition_TriggerEventTargetDamagedBySourceThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TriggerEventTargetDamagedBySourceThisTurn"); strings.write_byte(b, '}')
	case AbilityCondition_TriggerEventTargetExploitedBySource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TriggerEventTargetExploitedBySource"); strings.write_byte(b, '}')
	case AbilityCondition_AdditionalCostPaid: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AdditionalCostPaid")
	if !(skip_AbilityCondition_AbilityCondition_is_subject_source(y.subject)) { member(b, first, "subject"); encode_ObjectScope(b, y.subject) }
	if !(skip_AbilityCondition_AdditionalCostPaymentSource_is_any(y.source)) { member(b, first, "source"); encode_AdditionalCostPaymentSource(b, y.source) }
	if !(y.origin == nil) { member(b, first, "origin"); enc_opt_AdditionalCostOrigin(b, y.origin) }
	if !(y.origin_ordinal == nil) { member(b, first, "origin_ordinal"); enc_opt_u32(b, y.origin_ordinal) }
	if !(y.variant == nil) { member(b, first, "variant"); enc_opt_KickerVariant(b, y.variant) }
	if !(y.kicker_cost == nil) { member(b, first, "kicker_cost"); enc_opt_ManaCost(b, y.kicker_cost) }
	if !(skip_AbilityCondition_AbilityCondition_is_default_min_count(y.min_count)) { member(b, first, "min_count"); encode_u32(b, y.min_count) }
	}; strings.write_byte(b, '}')
	case AbilityCondition_AdditionalCostPaidInstead: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AdditionalCostPaidInstead"); strings.write_byte(b, '}')
	case AbilityCondition_AlternativeManaCostPaid: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AlternativeManaCostPaid"); strings.write_byte(b, '}')
	case AbilityCondition_EffectOutcome: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "EffectOutcome")
	member(b, first, "signal"); encode_EffectOutcomeSignal(b, y.signal)
	}; strings.write_byte(b, '}')
	case AbilityCondition_EventOutcomeWon: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EventOutcomeWon"); strings.write_byte(b, '}')
	case AbilityCondition_CoinFlipOutcome: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CoinFlipOutcome")
	member(b, first, "result"); encode_CoinFlipResult(b, y.result)
	}; strings.write_byte(b, '}')
	case AbilityCondition_ChosenLabelIs: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChosenLabelIs")
	member(b, first, "label"); encode_string(b, y.label)
	}; strings.write_byte(b, '}')
	case AbilityCondition_WhenYouDo: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "WhenYouDo"); strings.write_byte(b, '}')
	case AbilityCondition_WasCast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WasCast")
	if !(y.zone == nil) { member(b, first, "zone"); enc_opt_Zone(b, y.zone) }
	}; strings.write_byte(b, '}')
	case AbilityCondition_CastDuringPhase: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastDuringPhase")
	member(b, first, "phases"); enc_dyn_Phase(b, y.phases)
	}; strings.write_byte(b, '}')
	case AbilityCondition_CurrentPhaseIs: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CurrentPhaseIs")
	member(b, first, "phases"); enc_dyn_Phase(b, y.phases)
	}; strings.write_byte(b, '}')
	case AbilityCondition_CastTimingPermission: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastTimingPermission")
	member(b, first, "permission"); encode_CastTimingPermission(b, y.permission)
	}; strings.write_byte(b, '}')
	case AbilityCondition_ManaColorSpent: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ManaColorSpent")
	member(b, first, "color"); encode_SpentColor(b, y.color)
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	}; strings.write_byte(b, '}')
	case AbilityCondition_RevealedHasCardType: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RevealedHasCardType")
	member(b, first, "card_types"); enc_dyn_CoreType(b, y.card_types)
	if !(y.additional_filter == nil) { member(b, first, "additional_filter"); enc_opt_FilterProp(b, y.additional_filter) }
	if !(y.subtype_filter == nil) { member(b, first, "subtype_filter"); enc_ptr_TargetFilter(b, y.subtype_filter) }
	}; strings.write_byte(b, '}')
	case AbilityCondition_ObjectsShareQuality: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ObjectsShareQuality")
	member(b, first, "subject"); encode_TargetFilter(b, y.subject)
	member(b, first, "reference"); encode_TargetFilter(b, y.reference)
	member(b, first, "quality"); encode_SharedQuality(b, y.quality)
	}; strings.write_byte(b, '}')
	case AbilityCondition_TargetSharesNameWithOtherExiledThisWay: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TargetSharesNameWithOtherExiledThisWay")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case AbilityCondition_SourceEnteredThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceEnteredThisTurn"); strings.write_byte(b, '}')
	case AbilityCondition_CastVariantPaid: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastVariantPaid")
	member(b, first, "variant"); encode_CastVariantPaid(b, y.variant)
	if !(skip_AbilityCondition_AbilityCondition_is_subject_source(y.subject)) { member(b, first, "subject"); encode_ObjectScope(b, y.subject) }
	}; strings.write_byte(b, '}')
	case AbilityCondition_CastVariantPaidInstead: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastVariantPaidInstead")
	member(b, first, "variant"); encode_CastVariantPaid(b, y.variant)
	}; strings.write_byte(b, '}')
	case AbilityCondition_QuantityCheck: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "QuantityCheck")
	member(b, first, "lhs"); encode_QuantityExpr(b, y.lhs)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, y.rhs)
	}; strings.write_byte(b, '}')
	case AbilityCondition_QuantityQuality: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "QuantityQuality")
	member(b, first, "quantity"); encode_QuantityExpr(b, y.quantity)
	member(b, first, "quality"); encode_NumberQuality(b, y.quality)
	}; strings.write_byte(b, '}')
	case AbilityCondition_PreviousEffectAmount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PreviousEffectAmount")
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, y.rhs)
	if !(skip_AbilityCondition_is_total_damage_channel(y.channel)) { member(b, first, "channel"); encode_DamageChannel(b, y.channel) }
	}; strings.write_byte(b, '}')
	case AbilityCondition_HasMaxSpeed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasMaxSpeed"); strings.write_byte(b, '}')
	case AbilityCondition_IsMonarch: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "IsMonarch"); strings.write_byte(b, '}')
	case AbilityCondition_IsInitiative: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "IsInitiative"); strings.write_byte(b, '}')
	case AbilityCondition_HasCityBlessing: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasCityBlessing"); strings.write_byte(b, '}')
	case AbilityCondition_HasEnduringStory: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasEnduringStory"); strings.write_byte(b, '}')
	case AbilityCondition_ControlsCommander: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControlsCommander")
	member(b, first, "ownership"); encode_CommanderOwnership(b, y.ownership)
	}; strings.write_byte(b, '}')
	case AbilityCondition_DiscardedCardMatchesFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DiscardedCardMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case AbilityCondition_IsRingBearer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "IsRingBearer"); strings.write_byte(b, '}')
	case AbilityCondition_CompletedDungeon: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CompletedDungeon")
	if !(y.specific == nil) { member(b, first, "specific"); enc_opt_DungeonId(b, y.specific) }
	}; strings.write_byte(b, '}')
	case AbilityCondition_TargetHasKeywordInstead: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TargetHasKeywordInstead")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)
	}; strings.write_byte(b, '}')
	case AbilityCondition_TargetMatchesFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TargetMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "use_lki"); encode_bool(b, y.use_lki)
	if !(y.subject_slot == nil) { member(b, first, "subject_slot"); enc_opt_int(b, y.subject_slot) }
	if !(skip_AbilityCondition_AbilityCondition_is_subject_target(y.subject)) { member(b, first, "subject"); encode_ObjectScope(b, y.subject) }
	}; strings.write_byte(b, '}')
	case AbilityCondition_HasObjectTarget: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasObjectTarget"); strings.write_byte(b, '}')
	case AbilityCondition_TriggeringSpellTargetsFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TriggeringSpellTargetsFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case AbilityCondition_SourceMatchesFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case AbilityCondition_PostReplacementDamageSourceMatchesFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PostReplacementDamageSourceMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case AbilityCondition_ZoneChangeObjectMatchesFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ZoneChangeObjectMatchesFilter")
	if !(y.origin == nil) { member(b, first, "origin"); enc_opt_Zone(b, y.origin) }
	member(b, first, "destination"); encode_Zone(b, y.destination)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case AbilityCondition_ControllerControlsMatching: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControllerControlsMatching")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case AbilityCondition_ControllerControlledMatchingAsCast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControllerControlledMatchingAsCast")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case AbilityCondition_IsYourTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "IsYourTurn"); strings.write_byte(b, '}')
	case AbilityCondition_WasStartingPlayer: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WasStartingPlayer")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)
	}; strings.write_byte(b, '}')
	case AbilityCondition_SpellCastWithVariantThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SpellCastWithVariantThisTurn")
	member(b, first, "variant"); encode_CastingVariant(b, y.variant)
	}; strings.write_byte(b, '}')
	case AbilityCondition_FirstCombatPhaseOfTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "FirstCombatPhaseOfTurn"); strings.write_byte(b, '}')
	case AbilityCondition_FirstEndStepOfTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "FirstEndStepOfTurn"); strings.write_byte(b, '}')
	case AbilityCondition_ZoneChangedThisWay: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ZoneChangedThisWay")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	if !(y.destination == nil) { member(b, first, "destination"); enc_opt_Zone(b, y.destination) }
	}; strings.write_byte(b, '}')
	case AbilityCondition_CostPaidObjectMatchesFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CostPaidObjectMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case AbilityCondition_SourceIsTapped: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsTapped"); strings.write_byte(b, '}')
	case AbilityCondition_SourceAttachedToCreature: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceAttachedToCreature"); strings.write_byte(b, '}')
	case AbilityCondition_ConditionInstead: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ConditionInstead")
	member(b, first, "inner"); enc_ptr_AbilityCondition(b, y.inner)
	}; strings.write_byte(b, '}')
	case AbilityCondition_And: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "And")
	member(b, first, "conditions"); enc_dyn_AbilityCondition(b, y.conditions)
	}; strings.write_byte(b, '}')
	case AbilityCondition_Or: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Or")
	member(b, first, "conditions"); enc_dyn_AbilityCondition(b, y.conditions)
	}; strings.write_byte(b, '}')
	case AbilityCondition_Not: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Not")
	member(b, first, "condition"); enc_ptr_AbilityCondition(b, y.condition)
	}; strings.write_byte(b, '}')
	case AbilityCondition_DayNightIsNeither: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DayNightIsNeither"); strings.write_byte(b, '}')
	case AbilityCondition_DayNightIs: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DayNightIs")
	member(b, first, "state"); encode_DayNight(b, y.state)
	}; strings.write_byte(b, '}')
	case AbilityCondition_AbilityUseCountThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AbilityUseCountThisTurn")
	if !(skip_AbilityCondition_AbilityUseTally_is_resolved(y.tally)) { member(b, first, "tally"); encode_AbilityUseTally(b, y.tally) }
	if !(skip_AbilityCondition_AbilityCondition_is_default_use_comparator(y.comparator)) { member(b, first, "comparator"); encode_Comparator(b, y.comparator) }
	member(b, first, "n"); encode_u32(b, y.n)
	}; strings.write_byte(b, '}')
	case AbilityCondition_SourceLacksKeyword: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceLacksKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)
	}; strings.write_byte(b, '}')
	case AbilityCondition_ScopedPlayerMatches: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ScopedPlayerMatches")
	member(b, first, "filter"); encode_PlayerFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case AbilityCondition_PlayerAttackedPlayer: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PlayerAttackedPlayer")
	member(b, first, "attacker"); encode_PlayerScope(b, y.attacker)
	member(b, first, "defender"); encode_PlayerScope(b, y.defender)
	}; strings.write_byte(b, '}')
	}
}

encode_AbilityCondition_members :: proc(b: ^strings.Builder, x: AbilityCondition, first: ^bool) {
	#partial switch y in x {
	case AbilityCondition_TriggerEventTargetDamagedBySourceThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "TriggerEventTargetDamagedBySourceThisTurn")
	case AbilityCondition_TriggerEventTargetExploitedBySource: _ = y; member(b, first, "type"); json.write_string(b, "TriggerEventTargetExploitedBySource")
	case AbilityCondition_AdditionalCostPaid: member(b, first, "type"); json.write_string(b, "AdditionalCostPaid")
	if !(skip_AbilityCondition_AbilityCondition_is_subject_source(y.subject)) { member(b, first, "subject"); encode_ObjectScope(b, y.subject) }
	if !(skip_AbilityCondition_AdditionalCostPaymentSource_is_any(y.source)) { member(b, first, "source"); encode_AdditionalCostPaymentSource(b, y.source) }
	if !(y.origin == nil) { member(b, first, "origin"); enc_opt_AdditionalCostOrigin(b, y.origin) }
	if !(y.origin_ordinal == nil) { member(b, first, "origin_ordinal"); enc_opt_u32(b, y.origin_ordinal) }
	if !(y.variant == nil) { member(b, first, "variant"); enc_opt_KickerVariant(b, y.variant) }
	if !(y.kicker_cost == nil) { member(b, first, "kicker_cost"); enc_opt_ManaCost(b, y.kicker_cost) }
	if !(skip_AbilityCondition_AbilityCondition_is_default_min_count(y.min_count)) { member(b, first, "min_count"); encode_u32(b, y.min_count) }

	case AbilityCondition_AdditionalCostPaidInstead: _ = y; member(b, first, "type"); json.write_string(b, "AdditionalCostPaidInstead")
	case AbilityCondition_AlternativeManaCostPaid: _ = y; member(b, first, "type"); json.write_string(b, "AlternativeManaCostPaid")
	case AbilityCondition_EffectOutcome: member(b, first, "type"); json.write_string(b, "EffectOutcome")
	member(b, first, "signal"); encode_EffectOutcomeSignal(b, y.signal)

	case AbilityCondition_EventOutcomeWon: _ = y; member(b, first, "type"); json.write_string(b, "EventOutcomeWon")
	case AbilityCondition_CoinFlipOutcome: member(b, first, "type"); json.write_string(b, "CoinFlipOutcome")
	member(b, first, "result"); encode_CoinFlipResult(b, y.result)

	case AbilityCondition_ChosenLabelIs: member(b, first, "type"); json.write_string(b, "ChosenLabelIs")
	member(b, first, "label"); encode_string(b, y.label)

	case AbilityCondition_WhenYouDo: _ = y; member(b, first, "type"); json.write_string(b, "WhenYouDo")
	case AbilityCondition_WasCast: member(b, first, "type"); json.write_string(b, "WasCast")
	if !(y.zone == nil) { member(b, first, "zone"); enc_opt_Zone(b, y.zone) }

	case AbilityCondition_CastDuringPhase: member(b, first, "type"); json.write_string(b, "CastDuringPhase")
	member(b, first, "phases"); enc_dyn_Phase(b, y.phases)

	case AbilityCondition_CurrentPhaseIs: member(b, first, "type"); json.write_string(b, "CurrentPhaseIs")
	member(b, first, "phases"); enc_dyn_Phase(b, y.phases)

	case AbilityCondition_CastTimingPermission: member(b, first, "type"); json.write_string(b, "CastTimingPermission")
	member(b, first, "permission"); encode_CastTimingPermission(b, y.permission)

	case AbilityCondition_ManaColorSpent: member(b, first, "type"); json.write_string(b, "ManaColorSpent")
	member(b, first, "color"); encode_SpentColor(b, y.color)
	member(b, first, "minimum"); encode_u32(b, y.minimum)

	case AbilityCondition_RevealedHasCardType: member(b, first, "type"); json.write_string(b, "RevealedHasCardType")
	member(b, first, "card_types"); enc_dyn_CoreType(b, y.card_types)
	if !(y.additional_filter == nil) { member(b, first, "additional_filter"); enc_opt_FilterProp(b, y.additional_filter) }
	if !(y.subtype_filter == nil) { member(b, first, "subtype_filter"); enc_ptr_TargetFilter(b, y.subtype_filter) }

	case AbilityCondition_ObjectsShareQuality: member(b, first, "type"); json.write_string(b, "ObjectsShareQuality")
	member(b, first, "subject"); encode_TargetFilter(b, y.subject)
	member(b, first, "reference"); encode_TargetFilter(b, y.reference)
	member(b, first, "quality"); encode_SharedQuality(b, y.quality)

	case AbilityCondition_TargetSharesNameWithOtherExiledThisWay: member(b, first, "type"); json.write_string(b, "TargetSharesNameWithOtherExiledThisWay")
	member(b, first, "target"); encode_TargetFilter(b, y.target)

	case AbilityCondition_SourceEnteredThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "SourceEnteredThisTurn")
	case AbilityCondition_CastVariantPaid: member(b, first, "type"); json.write_string(b, "CastVariantPaid")
	member(b, first, "variant"); encode_CastVariantPaid(b, y.variant)
	if !(skip_AbilityCondition_AbilityCondition_is_subject_source(y.subject)) { member(b, first, "subject"); encode_ObjectScope(b, y.subject) }

	case AbilityCondition_CastVariantPaidInstead: member(b, first, "type"); json.write_string(b, "CastVariantPaidInstead")
	member(b, first, "variant"); encode_CastVariantPaid(b, y.variant)

	case AbilityCondition_QuantityCheck: member(b, first, "type"); json.write_string(b, "QuantityCheck")
	member(b, first, "lhs"); encode_QuantityExpr(b, y.lhs)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, y.rhs)

	case AbilityCondition_QuantityQuality: member(b, first, "type"); json.write_string(b, "QuantityQuality")
	member(b, first, "quantity"); encode_QuantityExpr(b, y.quantity)
	member(b, first, "quality"); encode_NumberQuality(b, y.quality)

	case AbilityCondition_PreviousEffectAmount: member(b, first, "type"); json.write_string(b, "PreviousEffectAmount")
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, y.rhs)
	if !(skip_AbilityCondition_is_total_damage_channel(y.channel)) { member(b, first, "channel"); encode_DamageChannel(b, y.channel) }

	case AbilityCondition_HasMaxSpeed: _ = y; member(b, first, "type"); json.write_string(b, "HasMaxSpeed")
	case AbilityCondition_IsMonarch: _ = y; member(b, first, "type"); json.write_string(b, "IsMonarch")
	case AbilityCondition_IsInitiative: _ = y; member(b, first, "type"); json.write_string(b, "IsInitiative")
	case AbilityCondition_HasCityBlessing: _ = y; member(b, first, "type"); json.write_string(b, "HasCityBlessing")
	case AbilityCondition_HasEnduringStory: _ = y; member(b, first, "type"); json.write_string(b, "HasEnduringStory")
	case AbilityCondition_ControlsCommander: member(b, first, "type"); json.write_string(b, "ControlsCommander")
	member(b, first, "ownership"); encode_CommanderOwnership(b, y.ownership)

	case AbilityCondition_DiscardedCardMatchesFilter: member(b, first, "type"); json.write_string(b, "DiscardedCardMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case AbilityCondition_IsRingBearer: _ = y; member(b, first, "type"); json.write_string(b, "IsRingBearer")
	case AbilityCondition_CompletedDungeon: member(b, first, "type"); json.write_string(b, "CompletedDungeon")
	if !(y.specific == nil) { member(b, first, "specific"); enc_opt_DungeonId(b, y.specific) }

	case AbilityCondition_TargetHasKeywordInstead: member(b, first, "type"); json.write_string(b, "TargetHasKeywordInstead")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)

	case AbilityCondition_TargetMatchesFilter: member(b, first, "type"); json.write_string(b, "TargetMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "use_lki"); encode_bool(b, y.use_lki)
	if !(y.subject_slot == nil) { member(b, first, "subject_slot"); enc_opt_int(b, y.subject_slot) }
	if !(skip_AbilityCondition_AbilityCondition_is_subject_target(y.subject)) { member(b, first, "subject"); encode_ObjectScope(b, y.subject) }

	case AbilityCondition_HasObjectTarget: _ = y; member(b, first, "type"); json.write_string(b, "HasObjectTarget")
	case AbilityCondition_TriggeringSpellTargetsFilter: member(b, first, "type"); json.write_string(b, "TriggeringSpellTargetsFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case AbilityCondition_SourceMatchesFilter: member(b, first, "type"); json.write_string(b, "SourceMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case AbilityCondition_PostReplacementDamageSourceMatchesFilter: member(b, first, "type"); json.write_string(b, "PostReplacementDamageSourceMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case AbilityCondition_ZoneChangeObjectMatchesFilter: member(b, first, "type"); json.write_string(b, "ZoneChangeObjectMatchesFilter")
	if !(y.origin == nil) { member(b, first, "origin"); enc_opt_Zone(b, y.origin) }
	member(b, first, "destination"); encode_Zone(b, y.destination)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case AbilityCondition_ControllerControlsMatching: member(b, first, "type"); json.write_string(b, "ControllerControlsMatching")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case AbilityCondition_ControllerControlledMatchingAsCast: member(b, first, "type"); json.write_string(b, "ControllerControlledMatchingAsCast")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case AbilityCondition_IsYourTurn: _ = y; member(b, first, "type"); json.write_string(b, "IsYourTurn")
	case AbilityCondition_WasStartingPlayer: member(b, first, "type"); json.write_string(b, "WasStartingPlayer")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)

	case AbilityCondition_SpellCastWithVariantThisTurn: member(b, first, "type"); json.write_string(b, "SpellCastWithVariantThisTurn")
	member(b, first, "variant"); encode_CastingVariant(b, y.variant)

	case AbilityCondition_FirstCombatPhaseOfTurn: _ = y; member(b, first, "type"); json.write_string(b, "FirstCombatPhaseOfTurn")
	case AbilityCondition_FirstEndStepOfTurn: _ = y; member(b, first, "type"); json.write_string(b, "FirstEndStepOfTurn")
	case AbilityCondition_ZoneChangedThisWay: member(b, first, "type"); json.write_string(b, "ZoneChangedThisWay")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	if !(y.destination == nil) { member(b, first, "destination"); enc_opt_Zone(b, y.destination) }

	case AbilityCondition_CostPaidObjectMatchesFilter: member(b, first, "type"); json.write_string(b, "CostPaidObjectMatchesFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case AbilityCondition_SourceIsTapped: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsTapped")
	case AbilityCondition_SourceAttachedToCreature: _ = y; member(b, first, "type"); json.write_string(b, "SourceAttachedToCreature")
	case AbilityCondition_ConditionInstead: member(b, first, "type"); json.write_string(b, "ConditionInstead")
	member(b, first, "inner"); enc_ptr_AbilityCondition(b, y.inner)

	case AbilityCondition_And: member(b, first, "type"); json.write_string(b, "And")
	member(b, first, "conditions"); enc_dyn_AbilityCondition(b, y.conditions)

	case AbilityCondition_Or: member(b, first, "type"); json.write_string(b, "Or")
	member(b, first, "conditions"); enc_dyn_AbilityCondition(b, y.conditions)

	case AbilityCondition_Not: member(b, first, "type"); json.write_string(b, "Not")
	member(b, first, "condition"); enc_ptr_AbilityCondition(b, y.condition)

	case AbilityCondition_DayNightIsNeither: _ = y; member(b, first, "type"); json.write_string(b, "DayNightIsNeither")
	case AbilityCondition_DayNightIs: member(b, first, "type"); json.write_string(b, "DayNightIs")
	member(b, first, "state"); encode_DayNight(b, y.state)

	case AbilityCondition_AbilityUseCountThisTurn: member(b, first, "type"); json.write_string(b, "AbilityUseCountThisTurn")
	if !(skip_AbilityCondition_AbilityUseTally_is_resolved(y.tally)) { member(b, first, "tally"); encode_AbilityUseTally(b, y.tally) }
	if !(skip_AbilityCondition_AbilityCondition_is_default_use_comparator(y.comparator)) { member(b, first, "comparator"); encode_Comparator(b, y.comparator) }
	member(b, first, "n"); encode_u32(b, y.n)

	case AbilityCondition_SourceLacksKeyword: member(b, first, "type"); json.write_string(b, "SourceLacksKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)

	case AbilityCondition_ScopedPlayerMatches: member(b, first, "type"); json.write_string(b, "ScopedPlayerMatches")
	member(b, first, "filter"); encode_PlayerFilter(b, y.filter)

	case AbilityCondition_PlayerAttackedPlayer: member(b, first, "type"); json.write_string(b, "PlayerAttackedPlayer")
	member(b, first, "attacker"); encode_PlayerScope(b, y.attacker)
	member(b, first, "defender"); encode_PlayerScope(b, y.defender)

	}
}

decode_OpponentMayScope :: proc(v: json.Value, out: ^OpponentMayScope) -> bool {
	if v.kind != .String do return fail("OpponentMayScope: not a string")
	str := v.text
	switch str {
	case "AnyOpponent": out^ = .AnyOpponent
	case "AnyPlayer": out^ = .AnyPlayer
	case "AnyOtherPlayer": out^ = .AnyOtherPlayer
	case: return fail("OpponentMayScope: unknown variant")
	}
	return true
}

encode_OpponentMayScope :: proc(b: ^strings.Builder, x: OpponentMayScope) {
	@(static, rodata) NAMES := [OpponentMayScope]string{
		.AnyOpponent = "AnyOpponent",
		.AnyPlayer = "AnyPlayer",
		.AnyOtherPlayer = "AnyOtherPlayer",
	}
	json.write_string(b, NAMES[x])
}

decode_MultiTargetSpec :: proc(v: json.Value, out: ^MultiTargetSpec) -> bool {
	if v.kind != .Object do return fail("MultiTargetSpec: not an object")
	if fv, found := get_any(v, "min"); found { if !decode_with_multi_target_min(fv, &out.min) do return fail("MultiTargetSpec.min") } else { return fail("MultiTargetSpec.min missing") }
	if fv, found := get_any(v, "max"); found { if !dec_opt_QuantityExpr(fv, &out.max) do return fail("MultiTargetSpec.max") }
	return true
}

encode_MultiTargetSpec :: proc(b: ^strings.Builder, x: MultiTargetSpec) {
	strings.write_byte(b, '{')
	f := true
	encode_MultiTargetSpec_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_MultiTargetSpec_members :: proc(b: ^strings.Builder, x: MultiTargetSpec, first: ^bool) {
	member(b, first, "min"); encode_with_multi_target_min(b, x.min)
	member(b, first, "max"); enc_opt_QuantityExpr(b, x.max)
}

decode_TargetSelectionConstraint :: proc(v: json.Value, out: ^TargetSelectionConstraint) -> bool {
	if v.kind != .Object do return fail("TargetSelectionConstraint: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("TargetSelectionConstraint: no tag")
	switch tv.text {
	case "DifferentTargetPlayers": out^ = TargetSelectionConstraint_DifferentTargetPlayers{}
	case "DifferentObjectControllers": out^ = TargetSelectionConstraint_DifferentObjectControllers{}
	case "SameZoneOwner":
		tmp: TargetSelectionConstraint_SameZoneOwner
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetSelectionConstraint_SameZoneOwner) -> bool {
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("TargetSelectionConstraint::SameZoneOwner.zone") } else { return fail("TargetSelectionConstraint::SameZoneOwner.zone missing") }
	return true
		}) { return fail("TargetSelectionConstraint::SameZoneOwner") }
		out^ = tmp
	case "TotalManaValue":
		tmp: TargetSelectionConstraint_TotalManaValue
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetSelectionConstraint_TotalManaValue) -> bool {
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("TargetSelectionConstraint::TotalManaValue.comparator") } else { return fail("TargetSelectionConstraint::TotalManaValue.comparator missing") }
	if fv, found := get_any(v, "value"); found { if !decode_QuantityExpr(fv, &out.value) do return fail("TargetSelectionConstraint::TotalManaValue.value") } else { return fail("TargetSelectionConstraint::TotalManaValue.value missing") }
	return true
		}) { return fail("TargetSelectionConstraint::TotalManaValue") }
		out^ = tmp
	case: return fail("TargetSelectionConstraint: unknown variant")
	}
	return true
}

encode_TargetSelectionConstraint :: proc(b: ^strings.Builder, x: TargetSelectionConstraint) {
	#partial switch y in x {
	case TargetSelectionConstraint_DifferentTargetPlayers: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DifferentTargetPlayers"); strings.write_byte(b, '}')
	case TargetSelectionConstraint_DifferentObjectControllers: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DifferentObjectControllers"); strings.write_byte(b, '}')
	case TargetSelectionConstraint_SameZoneOwner: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SameZoneOwner")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	}; strings.write_byte(b, '}')
	case TargetSelectionConstraint_TotalManaValue: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TotalManaValue")
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_QuantityExpr(b, y.value)
	}; strings.write_byte(b, '}')
	}
}

encode_TargetSelectionConstraint_members :: proc(b: ^strings.Builder, x: TargetSelectionConstraint, first: ^bool) {
	#partial switch y in x {
	case TargetSelectionConstraint_DifferentTargetPlayers: _ = y; member(b, first, "type"); json.write_string(b, "DifferentTargetPlayers")
	case TargetSelectionConstraint_DifferentObjectControllers: _ = y; member(b, first, "type"); json.write_string(b, "DifferentObjectControllers")
	case TargetSelectionConstraint_SameZoneOwner: member(b, first, "type"); json.write_string(b, "SameZoneOwner")
	member(b, first, "zone"); encode_Zone(b, y.zone)

	case TargetSelectionConstraint_TotalManaValue: member(b, first, "type"); json.write_string(b, "TotalManaValue")
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_QuantityExpr(b, y.value)

	}
}

decode_TargetChoiceTiming :: proc(v: json.Value, out: ^TargetChoiceTiming) -> bool {
	if v.kind != .String do return fail("TargetChoiceTiming: not a string")
	str := v.text
	switch str {
	case "Stack": out^ = .Stack
	case "Resolution": out^ = .Resolution
	case: return fail("TargetChoiceTiming: unknown variant")
	}
	return true
}

encode_TargetChoiceTiming :: proc(b: ^strings.Builder, x: TargetChoiceTiming) {
	@(static, rodata) NAMES := [TargetChoiceTiming]string{
		.Stack = "Stack",
		.Resolution = "Resolution",
	}
	json.write_string(b, NAMES[x])
}

decode_DistributionUnit :: proc(v: json.Value, out: ^DistributionUnit) -> bool {
	if v.kind != .Object do return fail("DistributionUnit: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("DistributionUnit: no tag")
	switch tv.text {
	case "Damage": out^ = DistributionUnit_Damage{}
	case "EvenSplitDamage": out^ = DistributionUnit_EvenSplitDamage{}
	case "Counters": tmp: DistributionUnit_Counters; if !decode_string(json.get_or_null(v, "data"), &tmp._0) do return fail("DistributionUnit::Counters"); out^ = tmp
	case "Life": out^ = DistributionUnit_Life{}
	case: return fail("DistributionUnit: unknown variant")
	}
	return true
}

encode_DistributionUnit :: proc(b: ^strings.Builder, x: DistributionUnit) {
	#partial switch y in x {
	case DistributionUnit_Damage: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Damage"); strings.write_byte(b, '}')
	case DistributionUnit_EvenSplitDamage: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EvenSplitDamage"); strings.write_byte(b, '}')
	case DistributionUnit_Counters: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Counters"); member(b, &f, "data"); encode_string(b, y._0); strings.write_byte(b, '}')
	case DistributionUnit_Life: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Life"); strings.write_byte(b, '}')
	}
}

