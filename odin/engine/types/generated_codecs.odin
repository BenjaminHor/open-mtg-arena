		out^ = tmp
	case "ParentObjectTargetOwner": when COVERAGE do cov_hit("PlayerFilter::ParentObjectTargetOwner"); out^ = PlayerFilter_ParentObjectTargetOwner{}
	case "GrantingObjectCaster": when COVERAGE do cov_hit("PlayerFilter::GrantingObjectCaster"); out^ = PlayerFilter_GrantingObjectCaster{}
	case "AnyOf": when COVERAGE do cov_hit("PlayerFilter::AnyOf");
		tmp: PlayerFilter_AnyOf
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerFilter_AnyOf) -> bool {
	if fv, found := get_any(v, "filters"); found { if !dec_dyn_PlayerFilter(fv, &out.filters) do return fail("PlayerFilter::AnyOf.filters") } else { return fail("PlayerFilter::AnyOf.filters missing") }
	return true
		}) { return fail("PlayerFilter::AnyOf") }
		out^ = tmp
	case "TargetPlayer": when COVERAGE do cov_hit("PlayerFilter::TargetPlayer"); out^ = PlayerFilter_TargetPlayer{}
	case "TrackedSetPossessor": when COVERAGE do cov_hit("PlayerFilter::TrackedSetPossessor");
		tmp: PlayerFilter_TrackedSetPossessor
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerFilter_TrackedSetPossessor) -> bool {
	if fv, found := get_any(v, "relation"); found { if !decode_PlayerRelation(fv, &out.relation) do return fail("PlayerFilter::TrackedSetPossessor.relation") } else { return fail("PlayerFilter::TrackedSetPossessor.relation missing") }
	if fv, found := get_any(v, "possession"); found { if !decode_PossessionAxis(fv, &out.possession) do return fail("PlayerFilter::TrackedSetPossessor.possession") } else { return fail("PlayerFilter::TrackedSetPossessor.possession missing") }
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("PlayerFilter::TrackedSetPossessor.filter") } else { return fail("PlayerFilter::TrackedSetPossessor.filter missing") }
	if fv, found := get_any(v, "caused_by"); found { if !dec_opt_ThisWayCause(fv, &out.caused_by) do return fail("PlayerFilter::TrackedSetPossessor.caused_by") }
	return true
		}) { return fail("PlayerFilter::TrackedSetPossessor") }
		out^ = tmp
	case: return fail("PlayerFilter: unknown variant")
	}
	return true
}

encode_PlayerFilter :: proc(b: ^strings.Builder, x: PlayerFilter) {
	#partial switch y in x {
	case PlayerFilter_Controller: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Controller"); strings.write_byte(b, '}')
	case PlayerFilter_Opponent: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Opponent"); strings.write_byte(b, '}')
	case PlayerFilter_DefendingPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DefendingPlayer"); strings.write_byte(b, '}')
	case PlayerFilter_OpponentLostLife: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpponentLostLife"); strings.write_byte(b, '}')
	case PlayerFilter_OpponentGainedLife: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpponentGainedLife"); strings.write_byte(b, '}')
	case PlayerFilter_HasLostTheGame: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasLostTheGame"); strings.write_byte(b, '}')
	case PlayerFilter_OpponentDealtDamage: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "OpponentDealtDamage")
	member(b, first, "kind"); encode_DamageKindFilter(b, y.kind)
	if !(y.source == nil) { member(b, first, "source"); enc_ptr_TargetFilter(b, y.source) }
	if !(skip_PlayerFilter_is_one_u32(y.min_sources)) { member(b, first, "min_sources"); encode_u32(b, y.min_sources) }
	if !(skip_PlayerFilter_is_player_relation_opponent_PlayerRelation(y.relation)) { member(b, first, "relation"); encode_PlayerRelation(b, y.relation) }
	}; strings.write_byte(b, '}')
	case PlayerFilter_OpponentAttacked: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "OpponentAttacked")
	member(b, first, "subject"); encode_AttackSubject(b, y.subject)
	member(b, first, "scope"); encode_CombatHistoryScope(b, y.scope)
	}; strings.write_byte(b, '}')
	case PlayerFilter_OpponentAttackingEnchantedPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpponentAttackingEnchantedPlayer"); strings.write_byte(b, '}')
	case PlayerFilter_All: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "All"); strings.write_byte(b, '}')
	case PlayerFilter_AllExcept: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AllExcept")
	member(b, first, "exclude"); enc_ptr_PlayerFilter(b, y.exclude)
	if !(skip_PlayerFilter_is_player_relation_all_PlayerRelation(y.relation)) { member(b, first, "relation"); encode_PlayerRelation(b, y.relation) }
	}; strings.write_byte(b, '}')
	case PlayerFilter_HighestSpeed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HighestSpeed"); strings.write_byte(b, '}')
	case PlayerFilter_ZoneChangedThisWay: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ZoneChangedThisWay"); strings.write_byte(b, '}')
	case PlayerFilter_PerformedActionThisWay: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PerformedActionThisWay")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "action"); encode_PlayerActionKind(b, y.action)
	}; strings.write_byte(b, '}')
	case PlayerFilter_OwnersOfCardsExiledBySource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OwnersOfCardsExiledBySource"); strings.write_byte(b, '}')
	case PlayerFilter_TriggeringPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TriggeringPlayer"); strings.write_byte(b, '}')
	case PlayerFilter_OpponentOtherThanTriggering: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpponentOtherThanTriggering"); strings.write_byte(b, '}')
	case PlayerFilter_OpponentOfTriggeringPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpponentOfTriggeringPlayer"); strings.write_byte(b, '}')
	case PlayerFilter_OpponentOfTriggeringPlayerNotAttacked: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpponentOfTriggeringPlayerNotAttacked"); strings.write_byte(b, '}')
	case PlayerFilter_VotedFor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "VotedFor")
	member(b, first, "choice_index"); encode_u32(b, y.choice_index)
	}; strings.write_byte(b, '}')
	case PlayerFilter_ParentObjectTargetController: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ParentObjectTargetController"); strings.write_byte(b, '}')
	case PlayerFilter_ControlsCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControlsCount")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "count"); enc_ptr_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	case PlayerFilter_PlayerAttribute: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PlayerAttribute")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "attr"); enc_ptr_QuantityRef(b, y.attr)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); enc_ptr_QuantityExpr(b, y.value)
	}; strings.write_byte(b, '}')
	case PlayerFilter_ChosenPlayer: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChosenPlayer")
	member(b, first, "index"); encode_u8(b, y.index)
	}; strings.write_byte(b, '}')
	case PlayerFilter_ParentObjectTargetOwner: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ParentObjectTargetOwner"); strings.write_byte(b, '}')
	case PlayerFilter_GrantingObjectCaster: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "GrantingObjectCaster"); strings.write_byte(b, '}')
	case PlayerFilter_AnyOf: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AnyOf")
	member(b, first, "filters"); enc_dyn_PlayerFilter(b, y.filters)
	}; strings.write_byte(b, '}')
	case PlayerFilter_TargetPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TargetPlayer"); strings.write_byte(b, '}')
	case PlayerFilter_TrackedSetPossessor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TrackedSetPossessor")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "possession"); encode_PossessionAxis(b, y.possession)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	if !(y.caused_by == nil) { member(b, first, "caused_by"); enc_opt_ThisWayCause(b, y.caused_by) }
	}; strings.write_byte(b, '}')
	}
}

encode_PlayerFilter_members :: proc(b: ^strings.Builder, x: PlayerFilter, first: ^bool) {
	#partial switch y in x {
	case PlayerFilter_Controller: _ = y; member(b, first, "type"); json.write_string(b, "Controller")
	case PlayerFilter_Opponent: _ = y; member(b, first, "type"); json.write_string(b, "Opponent")
	case PlayerFilter_DefendingPlayer: _ = y; member(b, first, "type"); json.write_string(b, "DefendingPlayer")
	case PlayerFilter_OpponentLostLife: _ = y; member(b, first, "type"); json.write_string(b, "OpponentLostLife")
	case PlayerFilter_OpponentGainedLife: _ = y; member(b, first, "type"); json.write_string(b, "OpponentGainedLife")
	case PlayerFilter_HasLostTheGame: _ = y; member(b, first, "type"); json.write_string(b, "HasLostTheGame")
	case PlayerFilter_OpponentDealtDamage: member(b, first, "type"); json.write_string(b, "OpponentDealtDamage")
	member(b, first, "kind"); encode_DamageKindFilter(b, y.kind)
	if !(y.source == nil) { member(b, first, "source"); enc_ptr_TargetFilter(b, y.source) }
	if !(skip_PlayerFilter_is_one_u32(y.min_sources)) { member(b, first, "min_sources"); encode_u32(b, y.min_sources) }
	if !(skip_PlayerFilter_is_player_relation_opponent_PlayerRelation(y.relation)) { member(b, first, "relation"); encode_PlayerRelation(b, y.relation) }

	case PlayerFilter_OpponentAttacked: member(b, first, "type"); json.write_string(b, "OpponentAttacked")
	member(b, first, "subject"); encode_AttackSubject(b, y.subject)
	member(b, first, "scope"); encode_CombatHistoryScope(b, y.scope)

	case PlayerFilter_OpponentAttackingEnchantedPlayer: _ = y; member(b, first, "type"); json.write_string(b, "OpponentAttackingEnchantedPlayer")
	case PlayerFilter_All: _ = y; member(b, first, "type"); json.write_string(b, "All")
	case PlayerFilter_AllExcept: member(b, first, "type"); json.write_string(b, "AllExcept")
	member(b, first, "exclude"); enc_ptr_PlayerFilter(b, y.exclude)
	if !(skip_PlayerFilter_is_player_relation_all_PlayerRelation(y.relation)) { member(b, first, "relation"); encode_PlayerRelation(b, y.relation) }

	case PlayerFilter_HighestSpeed: _ = y; member(b, first, "type"); json.write_string(b, "HighestSpeed")
	case PlayerFilter_ZoneChangedThisWay: _ = y; member(b, first, "type"); json.write_string(b, "ZoneChangedThisWay")
	case PlayerFilter_PerformedActionThisWay: member(b, first, "type"); json.write_string(b, "PerformedActionThisWay")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "action"); encode_PlayerActionKind(b, y.action)

	case PlayerFilter_OwnersOfCardsExiledBySource: _ = y; member(b, first, "type"); json.write_string(b, "OwnersOfCardsExiledBySource")
	case PlayerFilter_TriggeringPlayer: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringPlayer")
	case PlayerFilter_OpponentOtherThanTriggering: _ = y; member(b, first, "type"); json.write_string(b, "OpponentOtherThanTriggering")
	case PlayerFilter_OpponentOfTriggeringPlayer: _ = y; member(b, first, "type"); json.write_string(b, "OpponentOfTriggeringPlayer")
	case PlayerFilter_OpponentOfTriggeringPlayerNotAttacked: _ = y; member(b, first, "type"); json.write_string(b, "OpponentOfTriggeringPlayerNotAttacked")
	case PlayerFilter_VotedFor: member(b, first, "type"); json.write_string(b, "VotedFor")
	member(b, first, "choice_index"); encode_u32(b, y.choice_index)

	case PlayerFilter_ParentObjectTargetController: _ = y; member(b, first, "type"); json.write_string(b, "ParentObjectTargetController")
	case PlayerFilter_ControlsCount: member(b, first, "type"); json.write_string(b, "ControlsCount")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "count"); enc_ptr_QuantityExpr(b, y.count)

	case PlayerFilter_PlayerAttribute: member(b, first, "type"); json.write_string(b, "PlayerAttribute")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "attr"); enc_ptr_QuantityRef(b, y.attr)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); enc_ptr_QuantityExpr(b, y.value)

	case PlayerFilter_ChosenPlayer: member(b, first, "type"); json.write_string(b, "ChosenPlayer")
	member(b, first, "index"); encode_u8(b, y.index)

	case PlayerFilter_ParentObjectTargetOwner: _ = y; member(b, first, "type"); json.write_string(b, "ParentObjectTargetOwner")
	case PlayerFilter_GrantingObjectCaster: _ = y; member(b, first, "type"); json.write_string(b, "GrantingObjectCaster")
	case PlayerFilter_AnyOf: member(b, first, "type"); json.write_string(b, "AnyOf")
	member(b, first, "filters"); enc_dyn_PlayerFilter(b, y.filters)

	case PlayerFilter_TargetPlayer: _ = y; member(b, first, "type"); json.write_string(b, "TargetPlayer")
	case PlayerFilter_TrackedSetPossessor: member(b, first, "type"); json.write_string(b, "TrackedSetPossessor")
	member(b, first, "relation"); encode_PlayerRelation(b, y.relation)
	member(b, first, "possession"); encode_PossessionAxis(b, y.possession)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	if !(y.caused_by == nil) { member(b, first, "caused_by"); enc_opt_ThisWayCause(b, y.caused_by) }

	}
}

decode_ControllerRef :: proc(v: json.Value, out: ^ControllerRef) -> bool {
	when COVERAGE do cov_hit("ControllerRef")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ControllerRef: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ControllerRef: not a string or object")
	}
	switch variant {
	case "You": when COVERAGE do cov_hit("ControllerRef::You"); out^ = ControllerRef_You{}
	case "Opponent": when COVERAGE do cov_hit("ControllerRef::Opponent"); out^ = ControllerRef_Opponent{}
	case "ScopedPlayer": when COVERAGE do cov_hit("ControllerRef::ScopedPlayer"); out^ = ControllerRef_ScopedPlayer{}
	case "TargetPlayer": when COVERAGE do cov_hit("ControllerRef::TargetPlayer"); out^ = ControllerRef_TargetPlayer{}
	case "TargetOpponent": when COVERAGE do cov_hit("ControllerRef::TargetOpponent"); out^ = ControllerRef_TargetOpponent{}
	case "ParentTargetController": when COVERAGE do cov_hit("ControllerRef::ParentTargetController"); out^ = ControllerRef_ParentTargetController{}
	case "EventTargetController": when COVERAGE do cov_hit("ControllerRef::EventTargetController"); out^ = ControllerRef_EventTargetController{}
	case "ParentTargetOwner": when COVERAGE do cov_hit("ControllerRef::ParentTargetOwner"); out^ = ControllerRef_ParentTargetOwner{}
	case "DefendingPlayer": when COVERAGE do cov_hit("ControllerRef::DefendingPlayer"); out^ = ControllerRef_DefendingPlayer{}
	case "ChosenPlayer": when COVERAGE do cov_hit("ControllerRef::ChosenPlayer");
		tmp: ControllerRef_ChosenPlayer
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ControllerRef_ChosenPlayer) -> bool {
	if fv, found := get_any(v, "index"); found { if !decode_u8(fv, &out.index) do return fail("ControllerRef::ChosenPlayer.index") } else { return fail("ControllerRef::ChosenPlayer.index missing") }
	return true
		}) { return fail("ControllerRef::ChosenPlayer") }
		out^ = tmp
	case "DeclaredPlayer": when COVERAGE do cov_hit("ControllerRef::DeclaredPlayer");
		tmp: ControllerRef_DeclaredPlayer
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ControllerRef_DeclaredPlayer) -> bool {
	if fv, found := get_any(v, "group"); found { if !decode_ChosenGroupId(fv, &out.group) do return fail("ControllerRef::DeclaredPlayer.group") } else { return fail("ControllerRef::DeclaredPlayer.group missing") }
	return true
		}) { return fail("ControllerRef::DeclaredPlayer") }
		out^ = tmp
	case "SourceChosenPlayer": when COVERAGE do cov_hit("ControllerRef::SourceChosenPlayer"); out^ = ControllerRef_SourceChosenPlayer{}
	case "TriggeringPlayer": when COVERAGE do cov_hit("ControllerRef::TriggeringPlayer"); out^ = ControllerRef_TriggeringPlayer{}
	case "EnchantedPlayer": when COVERAGE do cov_hit("ControllerRef::EnchantedPlayer"); out^ = ControllerRef_EnchantedPlayer{}
	case "ActivePlayer": when COVERAGE do cov_hit("ControllerRef::ActivePlayer"); out^ = ControllerRef_ActivePlayer{}
	case "SpecificPlayer": when COVERAGE do cov_hit("ControllerRef::SpecificPlayer");
		tmp: ControllerRef_SpecificPlayer
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ControllerRef_SpecificPlayer) -> bool {
	if fv, found := get_any(v, "id"); found { if !decode_PlayerId(fv, &out.id) do return fail("ControllerRef::SpecificPlayer.id") } else { return fail("ControllerRef::SpecificPlayer.id missing") }
	return true
		}) { return fail("ControllerRef::SpecificPlayer") }
		out^ = tmp
	case: return fail("ControllerRef: unknown variant")
	}
	return true
}

encode_ControllerRef :: proc(b: ^strings.Builder, x: ControllerRef) {
	#partial switch y in x {
	case ControllerRef_You: _ = y; json.write_string(b, "You")
	case ControllerRef_Opponent: _ = y; json.write_string(b, "Opponent")
	case ControllerRef_ScopedPlayer: _ = y; json.write_string(b, "ScopedPlayer")
	case ControllerRef_TargetPlayer: _ = y; json.write_string(b, "TargetPlayer")
	case ControllerRef_TargetOpponent: _ = y; json.write_string(b, "TargetOpponent")
	case ControllerRef_ParentTargetController: _ = y; json.write_string(b, "ParentTargetController")
	case ControllerRef_EventTargetController: _ = y; json.write_string(b, "EventTargetController")
	case ControllerRef_ParentTargetOwner: _ = y; json.write_string(b, "ParentTargetOwner")
	case ControllerRef_DefendingPlayer: _ = y; json.write_string(b, "DefendingPlayer")
	case ControllerRef_ChosenPlayer: strings.write_byte(b, '{'); json.write_string(b, "ChosenPlayer"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "index"); encode_u8(b, y.index)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ControllerRef_DeclaredPlayer: strings.write_byte(b, '{'); json.write_string(b, "DeclaredPlayer"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "group"); encode_ChosenGroupId(b, y.group)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ControllerRef_SourceChosenPlayer: _ = y; json.write_string(b, "SourceChosenPlayer")
	case ControllerRef_TriggeringPlayer: _ = y; json.write_string(b, "TriggeringPlayer")
	case ControllerRef_EnchantedPlayer: _ = y; json.write_string(b, "EnchantedPlayer")
	case ControllerRef_ActivePlayer: _ = y; json.write_string(b, "ActivePlayer")
	case ControllerRef_SpecificPlayer: strings.write_byte(b, '{'); json.write_string(b, "SpecificPlayer"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "id"); encode_PlayerId(b, y.id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_AdditionalCostPaymentSource :: proc(v: json.Value, out: ^AdditionalCostPaymentSource) -> bool {
	when COVERAGE do cov_hit("AdditionalCostPaymentSource")
	if v.kind != .String do return fail("AdditionalCostPaymentSource: not a string")
	str := v.text
	switch str {
	case "Any": when COVERAGE do cov_hit("AdditionalCostPaymentSource::Any"); out^ = .Any
	case "Kicker": when COVERAGE do cov_hit("AdditionalCostPaymentSource::Kicker"); out^ = .Kicker
	case "NonKicker": when COVERAGE do cov_hit("AdditionalCostPaymentSource::NonKicker"); out^ = .NonKicker
	case: return fail("AdditionalCostPaymentSource: unknown variant")
	}
	return true
}

encode_AdditionalCostPaymentSource :: proc(b: ^strings.Builder, x: AdditionalCostPaymentSource) {
	@(static, rodata) NAMES := [AdditionalCostPaymentSource]string{
		.Any = "Any",
		.Kicker = "Kicker",
		.NonKicker = "NonKicker",
	}
	json.write_string(b, NAMES[x])
}

decode_NumberQuality :: proc(v: json.Value, out: ^NumberQuality) -> bool {
	when COVERAGE do cov_hit("NumberQuality")
	if v.kind != .Object do return fail("NumberQuality: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("NumberQuality: no tag")
	switch tv.text {
	case "Parity": when COVERAGE do cov_hit("NumberQuality::Parity"); tmp: NumberQuality_Parity; if !decode_Parity(json.get_or_null(v, "value"), &tmp._0) do return fail("NumberQuality::Parity"); out^ = tmp
	case "Prime": when COVERAGE do cov_hit("NumberQuality::Prime"); out^ = NumberQuality_Prime{}
	case: return fail("NumberQuality: unknown variant")
	}
	return true
}

encode_NumberQuality :: proc(b: ^strings.Builder, x: NumberQuality) {
	#partial switch y in x {
	case NumberQuality_Parity: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Parity"); member(b, &f, "value"); encode_Parity(b, y._0); strings.write_byte(b, '}')
	case NumberQuality_Prime: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Prime"); strings.write_byte(b, '}')
	}
}

decode_SpentColor :: proc(v: json.Value, out: ^SpentColor) -> bool {
	when COVERAGE do cov_hit("SpentColor")
	if v.kind != .Object do return fail("SpentColor: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("SpentColor: no tag")
	switch tv.text {
	case "ColorWord": when COVERAGE do cov_hit("SpentColor::ColorWord");
		tmp: SpentColor_ColorWord
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^SpentColor_ColorWord) -> bool {
	if fv, found := get_any(v, "color"); found { if !decode_ManaColor(fv, &out.color) do return fail("SpentColor::ColorWord.color") } else { return fail("SpentColor::ColorWord.color missing") }
	return true
		}) { return fail("SpentColor::ColorWord") }
		out^ = tmp
	case "ManaSymbol": when COVERAGE do cov_hit("SpentColor::ManaSymbol");
