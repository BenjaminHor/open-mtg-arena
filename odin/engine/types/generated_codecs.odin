decode_ResolvedAbility :: proc(v: json.Value, out: ^ResolvedAbility) -> bool {
	when COVERAGE do cov_hit("ResolvedAbility")
	if v.kind != .Object do return fail("ResolvedAbility: not an object")
	if fv, found := get_any(v, "effect"); found { if !decode_Effect(fv, &out.effect) do return fail("ResolvedAbility.effect") } else { return fail("ResolvedAbility.effect missing") }
	if fv, found := get_any(v, "targets"); found { if !dec_dyn_TargetRef(fv, &out.targets) do return fail("ResolvedAbility.targets") } else { return fail("ResolvedAbility.targets missing") }
	if fv, found := get_any(v, "declares_chosen_group"); found { if !dec_opt_ChosenGroupId(fv, &out.declares_chosen_group) do return fail("ResolvedAbility.declares_chosen_group") }
	if fv, found := get_any(v, "reads_chosen_group"); found { if !dec_opt_ChosenGroupId(fv, &out.reads_chosen_group) do return fail("ResolvedAbility.reads_chosen_group") }
	if fv, found := get_any(v, "declares_return_result"); found { if !dec_opt_ReturnResultId(fv, &out.declares_return_result) do return fail("ResolvedAbility.declares_return_result") }
	if fv, found := get_any(v, "reads_return_result"); found { if !dec_opt_t2_ReturnResultId_ReturnResultReadSpec(fv, &out.reads_return_result) do return fail("ResolvedAbility.reads_return_result") }
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("ResolvedAbility.source_id") } else { return fail("ResolvedAbility.source_id missing") }
	if fv, found := get_any(v, "cast_occurrence"); found { if !dec_opt_CastOccurrence(fv, &out.cast_occurrence) do return fail("ResolvedAbility.cast_occurrence") }
	if fv, found := get_any(v, "cycling_occurrence"); found { if !dec_opt_CyclingOccurrence(fv, &out.cycling_occurrence) do return fail("ResolvedAbility.cycling_occurrence") }
	if fv, found := get_any(v, "source_incarnation"); found { if !dec_opt_u64(fv, &out.source_incarnation) do return fail("ResolvedAbility.source_incarnation") }
	if fv, found := get_any(v, "announced_source_incarnation"); found { if !dec_opt_u64(fv, &out.announced_source_incarnation) do return fail("ResolvedAbility.announced_source_incarnation") }
	if fv, found := get_any(v, "trigger_source"); found { if !dec_opt_TriggerSourceContext(fv, &out.trigger_source) do return fail("ResolvedAbility.trigger_source") }
	if fv, found := get_any(v, "trigger_definition_ref"); found { if !dec_opt_TriggerDefinitionRef(fv, &out.trigger_definition_ref) do return fail("ResolvedAbility.trigger_definition_ref") }
	if fv, found := get_any(v, "delayed_origin"); found { if !dec_ptr_DelayedAbilityOrigin(fv, &out.delayed_origin) do return fail("ResolvedAbility.delayed_origin") }
	if fv, found := get_any(v, "force_block_attacker"); found { if !dec_opt_ObjectIncarnationRef(fv, &out.force_block_attacker) do return fail("ResolvedAbility.force_block_attacker") }
	if fv, found := get_any(v, "target_incarnations"); found { if !dec_dyn_ObjectIncarnationRef(fv, &out.target_incarnations) do return fail("ResolvedAbility.target_incarnations") }
	if fv, found := get_any(v, "target_pins"); found { if !dec_dyn_opt_ObjectIncarnationRef(fv, &out.target_pins) do return fail("ResolvedAbility.target_pins") }
	if fv, found := get_any(v, "selected_target_incarnations"); found { if !dec_dyn_ObjectIncarnationRef(fv, &out.legacy_selected_target_incarnations) do return fail("ResolvedAbility.legacy_selected_target_incarnations") }
	if fv, found := get_any(v, "chosen_target_slots"); found { if !decode_ChosenTargetSlots(fv, &out.chosen_target_slots) do return fail("ResolvedAbility.chosen_target_slots") } else { out.chosen_target_slots = ChosenTargetSlots(ChosenTargetSlots_Unrecorded{}) }
	if fv, found := get_any(v, "activation_cost_reduction"); found { if !dec_opt_CostReduction(fv, &out.activation_cost_reduction) do return fail("ResolvedAbility.activation_cost_reduction") }
	if fv, found := get_any(v, "activation_record"); found { if !dec_ptr_AbilityActivationRecord(fv, &out.activation_record) do return fail("ResolvedAbility.activation_record") }
	if fv, found := get_any(v, "announced_usage_key"); found { if !dec_ptr_AbilityUsageKey(fv, &out.announced_usage_key) do return fail("ResolvedAbility.announced_usage_key") }
	if fv, found := get_any(v, "illegal_target_slots"); found { if !dec_dyn_int(fv, &out.illegal_target_slots) do return fail("ResolvedAbility.illegal_target_slots") }
	if fv, found := get_any(v, "unjudged_target_slots"); found { if !dec_dyn_int(fv, &out.unjudged_target_slots) do return fail("ResolvedAbility.unjudged_target_slots") }
	if fv, found := get_any(v, "illegal_local_target_slots"); found { if !dec_dyn_int(fv, &out.illegal_local_target_slots) do return fail("ResolvedAbility.illegal_local_target_slots") }
	if fv, found := get_any(v, "declared_player_target_slots"); found { if !dec_dyn_DeclaredPlayerTargetSlot(fv, &out.declared_player_target_slots) do return fail("ResolvedAbility.declared_player_target_slots") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("ResolvedAbility.controller") } else { return fail("ResolvedAbility.controller missing") }
	if fv, found := get_any(v, "original_controller"); found { if !dec_opt_PlayerId(fv, &out.original_controller) do return fail("ResolvedAbility.original_controller") }
	if fv, found := get_any(v, "scoped_player"); found { if !dec_opt_PlayerId(fv, &out.scoped_player) do return fail("ResolvedAbility.scoped_player") }
	if fv, found := get_any(v, "kind"); found { if !decode_AbilityKind(fv, &out.kind) do return fail("ResolvedAbility.kind") }
	if fv, found := get_any(v, "sub_ability"); found { if !dec_ptr_ResolvedAbility(fv, &out.sub_ability) do return fail("ResolvedAbility.sub_ability") }
	if fv, found := get_any(v, "else_ability"); found { if !dec_ptr_ResolvedAbility(fv, &out.else_ability) do return fail("ResolvedAbility.else_ability") }
	if fv, found := get_any(v, "coin_branches"); found { if !dec_ptr_ResolvedCoinBranches(fv, &out.coin_branches) do return fail("ResolvedAbility.coin_branches") }
	if fv, found := get_any(v, "duration"); found { if !dec_opt_Duration(fv, &out.duration) do return fail("ResolvedAbility.duration") }
	if fv, found := get_any(v, "condition"); found { if !dec_opt_AbilityCondition(fv, &out.condition) do return fail("ResolvedAbility.condition") }
	if fv, found := get_any(v, "context"); found { if !decode_SpellContext(fv, &out.context_) do return fail("ResolvedAbility.context") }
	if fv, found := get_any(v, "optional_targeting"); found { if !decode_bool(fv, &out.optional_targeting) do return fail("ResolvedAbility.optional_targeting") }
	if fv, found := get_any(v, "optional"); found { if !decode_bool(fv, &out.optional) do return fail("ResolvedAbility.optional") }
	if fv, found := get_any(v, "optional_player"); found { if !dec_opt_TargetFilter(fv, &out.optional_player) do return fail("ResolvedAbility.optional_player") }
	if fv, found := get_any(v, "optional_for"); found { if !dec_opt_OpponentMayScope(fv, &out.optional_for) do return fail("ResolvedAbility.optional_for") }
	if fv, found := get_any(v, "multi_target"); found { if !dec_opt_MultiTargetSpec(fv, &out.multi_target) do return fail("ResolvedAbility.multi_target") }
	if fv, found := get_any(v, "target_constraints"); found { if !dec_dyn_TargetSelectionConstraint(fv, &out.target_constraints) do return fail("ResolvedAbility.target_constraints") }
	if fv, found := get_any(v, "target_choice_timing"); found { if !decode_TargetChoiceTiming(fv, &out.target_choice_timing) do return fail("ResolvedAbility.target_choice_timing") }
	if fv, found := get_any(v, "description"); found { if !dec_opt_string(fv, &out.description) do return fail("ResolvedAbility.description") }
	if fv, found := get_any(v, "selected_mode_labels"); found { if !dec_dyn_string(fv, &out.selected_mode_labels) do return fail("ResolvedAbility.selected_mode_labels") }
	if fv, found := get_any(v, "modal_instruction_ordinal"); found { if !dec_opt_int(fv, &out.modal_instruction_ordinal) do return fail("ResolvedAbility.modal_instruction_ordinal") }
	if fv, found := get_any(v, "detached_remainder"); found { if !decode_DetachedRemainder(fv, &out.detached_remainder) do return fail("ResolvedAbility.detached_remainder") }
	if fv, found := get_any(v, "repeat_for"); found { if !dec_opt_QuantityExpr(fv, &out.repeat_for) do return fail("ResolvedAbility.repeat_for") }
	if fv, found := get_any(v, "repeat_timing"); found { if !decode_RepeatForTiming(fv, &out.repeat_timing) do return fail("ResolvedAbility.repeat_timing") }
	if fv, found := get_any(v, "min_x_value"); found { if !decode_u32(fv, &out.min_x_value) do return fail("ResolvedAbility.min_x_value") }
	if fv, found := get_any(v, "announced_x"); found { if !dec_opt_QuantityExpr(fv, &out.announced_x) do return fail("ResolvedAbility.announced_x") }
	if fv, found := get_any(v, "cant_be_copied"); found { if !decode_bool(fv, &out.cant_be_copied) do return fail("ResolvedAbility.cant_be_copied") }
	if fv, found := get_any(v, "illegal_targets_disposition"); found { if !decode_IllegalTargetsDisposition(fv, &out.illegal_targets_disposition) do return fail("ResolvedAbility.illegal_targets_disposition") }
	if fv, found := get_any(v, "copy_count_status"); found { if !decode_CopyCountStatus(fv, &out.copy_count_status) do return fail("ResolvedAbility.copy_count_status") }
	if fv, found := get_any(v, "forward_result"); found { if !decode_bool(fv, &out.forward_result) do return fail("ResolvedAbility.forward_result") }
	if fv, found := get_any(v, "unless_pay"); found { if !dec_opt_UnlessPayModifier(fv, &out.unless_pay) do return fail("ResolvedAbility.unless_pay") }
	if fv, found := get_any(v, "distribution"); found { if !dec_opt_dyn_t2_TargetRef_u32(fv, &out.distribution) do return fail("ResolvedAbility.distribution") }
	if fv, found := get_any(v, "distribute"); found { if !dec_opt_DistributionUnit(fv, &out.distribute) do return fail("ResolvedAbility.distribute") }
	if fv, found := get_any(v, "player_scope"); found { if !dec_opt_PlayerFilter(fv, &out.player_scope) do return fail("ResolvedAbility.player_scope") }
	if fv, found := get_any(v, "starting_with"); found { if !dec_opt_ControllerRef(fv, &out.starting_with) do return fail("ResolvedAbility.starting_with") }
	if fv, found := get_any(v, "chosen_x"); found { if !dec_opt_u32(fv, &out.chosen_x) do return fail("ResolvedAbility.chosen_x") }
	if fv, found := get_any(v, "cost_paid_object"); found { if !dec_opt_CostPaidObjectSnapshot(fv, &out.cost_paid_object) do return fail("ResolvedAbility.cost_paid_object") }
	if fv, found := get_any(v, "noted_mana_payment"); found { if !dec_opt_NotedManaPayment(fv, &out.noted_mana_payment) do return fail("ResolvedAbility.noted_mana_payment") }
	if fv, found := get_any(v, "cost_paid_objects", "cost_paid_object_ids"); found { if !dec_dyn_CostPaidObjectRecord(fv, &out.cost_paid_objects) do return fail("ResolvedAbility.cost_paid_objects") }
	if fv, found := get_any(v, "effect_context_object"); found { if !dec_opt_CostPaidObjectSnapshot(fv, &out.effect_context_object) do return fail("ResolvedAbility.effect_context_object") }
	if fv, found := get_any(v, "amassed_army_object"); found { if !dec_opt_CostPaidObjectSnapshot(fv, &out.amassed_army_object) do return fail("ResolvedAbility.amassed_army_object") }
	if fv, found := get_any(v, "ability_index"); found { if !dec_opt_int(fv, &out.ability_index) do return fail("ResolvedAbility.ability_index") }
	if fv, found := get_any(v, "may_trigger_origin"); found { if !dec_opt_MayTriggerOrigin(fv, &out.may_trigger_origin) do return fail("ResolvedAbility.may_trigger_origin") }
	if fv, found := get_any(v, "target_selection_mode"); found { if !decode_TargetSelectionMode(fv, &out.target_selection_mode) do return fail("ResolvedAbility.target_selection_mode") }
	if fv, found := get_any(v, "target_chooser"); found { if !dec_opt_TargetFilter(fv, &out.target_chooser) do return fail("ResolvedAbility.target_chooser") }
	if fv, found := get_any(v, "chosen_players"); found { if !dec_dyn_PlayerId(fv, &out.chosen_players) do return fail("ResolvedAbility.chosen_players") }
	if fv, found := get_any(v, "repeat_until"); found { if !dec_opt_RepeatContinuation(fv, &out.repeat_until) do return fail("ResolvedAbility.repeat_until") }
	if fv, found := get_any(v, "replacement_applied"); found { if !dec_dyn_AppliedReplacementKey(fv, &out.replacement_applied) do return fail("ResolvedAbility.replacement_applied") }
	if fv, found := get_any(v, "sub_link"); found { if !decode_SubAbilityLink(fv, &out.sub_link) do return fail("ResolvedAbility.sub_link") }
	if fv, found := get_any(v, "target_reads"); found { if !decode_TargetReadOrigin(fv, &out.target_reads) do return fail("ResolvedAbility.target_reads") }
	if fv, found := get_any(v, "entry_onset"); found { if !decode_ContinuousEffectOnset(fv, &out.entry_onset) do return fail("ResolvedAbility.entry_onset") }
	if fv, found := get_any(v, "sibling_condition"); found { if !decode_SiblingCondition(fv, &out.sibling_condition) do return fail("ResolvedAbility.sibling_condition") }
	if fv, found := get_any(v, "instruction_join"); found { if !decode_InstructionJoin(fv, &out.instruction_join) do return fail("ResolvedAbility.instruction_join") }
	if fv, found := get_any(v, "modal"); found { if !dec_opt_ModalChoice(fv, &out.modal) do return fail("ResolvedAbility.modal") }
	if fv, found := get_any(v, "mode_abilities"); found { if !dec_dyn_AbilityDefinition(fv, &out.mode_abilities) do return fail("ResolvedAbility.mode_abilities") }
	if fv, found := get_any(v, "parent_target_missing_reason"); found { if !dec_opt_ParentTargetMissingReason(fv, &out.parent_target_missing_reason) do return fail("ResolvedAbility.parent_target_missing_reason") }
	if fv, found := get_any(v, "control_change_instruction"); found { if !dec_opt_ControlChangeInstructionCarrier(fv, &out.control_change_instruction) do return fail("ResolvedAbility.control_change_instruction") }
	return true
}

encode_ResolvedAbility :: proc(b: ^strings.Builder, x: ResolvedAbility) {
	strings.write_byte(b, '{')
	f := true
	encode_ResolvedAbility_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ResolvedAbility_members :: proc(b: ^strings.Builder, x: ResolvedAbility, first: ^bool) {
	member(b, first, "effect"); encode_Effect(b, x.effect)
	member(b, first, "targets"); enc_dyn_TargetRef(b, x.targets)
	if !(x.declares_chosen_group == nil) { member(b, first, "declares_chosen_group"); enc_opt_ChosenGroupId(b, x.declares_chosen_group) }
	if !(x.reads_chosen_group == nil) { member(b, first, "reads_chosen_group"); enc_opt_ChosenGroupId(b, x.reads_chosen_group) }
	if !(x.declares_return_result == nil) { member(b, first, "declares_return_result"); enc_opt_ReturnResultId(b, x.declares_return_result) }
	if !(x.reads_return_result == nil) { member(b, first, "reads_return_result"); enc_opt_t2_ReturnResultId_ReturnResultReadSpec(b, x.reads_return_result) }
	member(b, first, "source_id"); encode_ObjectId(b, x.source_id)
	if !(x.cast_occurrence == nil) { member(b, first, "cast_occurrence"); enc_opt_CastOccurrence(b, x.cast_occurrence) }
	if !(x.cycling_occurrence == nil) { member(b, first, "cycling_occurrence"); enc_opt_CyclingOccurrence(b, x.cycling_occurrence) }
	if !(x.source_incarnation == nil) { member(b, first, "source_incarnation"); enc_opt_u64(b, x.source_incarnation) }
	if !(x.announced_source_incarnation == nil) { member(b, first, "announced_source_incarnation"); enc_opt_u64(b, x.announced_source_incarnation) }
	if !(x.trigger_source == nil) { member(b, first, "trigger_source"); enc_opt_TriggerSourceContext(b, x.trigger_source) }
	if !(x.trigger_definition_ref == nil) { member(b, first, "trigger_definition_ref"); enc_opt_TriggerDefinitionRef(b, x.trigger_definition_ref) }
	if !(x.delayed_origin == nil) { member(b, first, "delayed_origin"); enc_ptr_DelayedAbilityOrigin(b, x.delayed_origin) }
	if !(x.force_block_attacker == nil) { member(b, first, "force_block_attacker"); enc_opt_ObjectIncarnationRef(b, x.force_block_attacker) }
	if !((len(x.target_incarnations) == 0)) { member(b, first, "target_incarnations"); enc_dyn_ObjectIncarnationRef(b, x.target_incarnations) }
	if !((len(x.target_pins) == 0)) { member(b, first, "target_pins"); enc_dyn_opt_ObjectIncarnationRef(b, x.target_pins) }
	if !(skip_ResolvedAbility_ChosenTargetSlots_is_unrecorded_ChosenTargetSlots(x.chosen_target_slots)) { member(b, first, "chosen_target_slots"); encode_ChosenTargetSlots(b, x.chosen_target_slots) }
	if !(x.activation_cost_reduction == nil) { member(b, first, "activation_cost_reduction"); enc_opt_CostReduction(b, x.activation_cost_reduction) }
	if !(x.activation_record == nil) { member(b, first, "activation_record"); enc_ptr_AbilityActivationRecord(b, x.activation_record) }
	if !(x.announced_usage_key == nil) { member(b, first, "announced_usage_key"); enc_ptr_AbilityUsageKey(b, x.announced_usage_key) }
	if !((len(x.illegal_target_slots) == 0)) { member(b, first, "illegal_target_slots"); enc_dyn_int(b, x.illegal_target_slots) }
	if !((len(x.unjudged_target_slots) == 0)) { member(b, first, "unjudged_target_slots"); enc_dyn_int(b, x.unjudged_target_slots) }
	if !((len(x.illegal_local_target_slots) == 0)) { member(b, first, "illegal_local_target_slots"); enc_dyn_int(b, x.illegal_local_target_slots) }
	if !((len(x.declared_player_target_slots) == 0)) { member(b, first, "declared_player_target_slots"); enc_dyn_DeclaredPlayerTargetSlot(b, x.declared_player_target_slots) }
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	if !(x.original_controller == nil) { member(b, first, "original_controller"); enc_opt_PlayerId(b, x.original_controller) }
	if !(x.scoped_player == nil) { member(b, first, "scoped_player"); enc_opt_PlayerId(b, x.scoped_player) }
	member(b, first, "kind"); encode_AbilityKind(b, x.kind)
	member(b, first, "sub_ability"); enc_ptr_ResolvedAbility(b, x.sub_ability)
	if !(x.else_ability == nil) { member(b, first, "else_ability"); enc_ptr_ResolvedAbility(b, x.else_ability) }
	if !(x.coin_branches == nil) { member(b, first, "coin_branches"); enc_ptr_ResolvedCoinBranches(b, x.coin_branches) }
	member(b, first, "duration"); enc_opt_Duration(b, x.duration)
	member(b, first, "condition"); enc_opt_AbilityCondition(b, x.condition)
	member(b, first, "context"); encode_SpellContext(b, x.context_)
	member(b, first, "optional_targeting"); encode_bool(b, x.optional_targeting)
	member(b, first, "optional"); encode_bool(b, x.optional)
	if !(x.optional_player == nil) { member(b, first, "optional_player"); enc_opt_TargetFilter(b, x.optional_player) }
	if !(x.optional_for == nil) { member(b, first, "optional_for"); enc_opt_OpponentMayScope(b, x.optional_for) }
	if !(x.multi_target == nil) { member(b, first, "multi_target"); enc_opt_MultiTargetSpec(b, x.multi_target) }
	if !((len(x.target_constraints) == 0)) { member(b, first, "target_constraints"); enc_dyn_TargetSelectionConstraint(b, x.target_constraints) }
	if !(skip_ResolvedAbility_TargetChoiceTiming_is_stack_TargetChoiceTiming(x.target_choice_timing)) { member(b, first, "target_choice_timing"); encode_TargetChoiceTiming(b, x.target_choice_timing) }
	if !(x.description == nil) { member(b, first, "description"); enc_opt_string(b, x.description) }
	if !((len(x.selected_mode_labels) == 0)) { member(b, first, "selected_mode_labels"); enc_dyn_string(b, x.selected_mode_labels) }
	if !(x.modal_instruction_ordinal == nil) { member(b, first, "modal_instruction_ordinal"); enc_opt_int(b, x.modal_instruction_ordinal) }
	member(b, first, "detached_remainder"); encode_DetachedRemainder(b, x.detached_remainder)
	if !(x.repeat_for == nil) { member(b, first, "repeat_for"); enc_opt_QuantityExpr(b, x.repeat_for) }
	if !(skip_ResolvedAbility_RepeatForTiming_is_sequential_RepeatForTiming(x.repeat_timing)) { member(b, first, "repeat_timing"); encode_RepeatForTiming(b, x.repeat_timing) }
	if !(x.min_x_value == 0) { member(b, first, "min_x_value"); encode_u32(b, x.min_x_value) }
	if !(x.announced_x == nil) { member(b, first, "announced_x"); enc_opt_QuantityExpr(b, x.announced_x) }
	if !(!x.cant_be_copied) { member(b, first, "cant_be_copied"); encode_bool(b, x.cant_be_copied) }
	if !(skip_ResolvedAbility_IllegalTargetsDisposition_is_does_not_resolve_IllegalTargetsDisposition(x.illegal_targets_disposition)) { member(b, first, "illegal_targets_disposition"); encode_IllegalTargetsDisposition(b, x.illegal_targets_disposition) }
	if !(skip_ResolvedAbility_CopyCountStatus_is_pending_CopyCountStatus(x.copy_count_status)) { member(b, first, "copy_count_status"); encode_CopyCountStatus(b, x.copy_count_status) }
	member(b, first, "forward_result"); encode_bool(b, x.forward_result)
	if !(x.unless_pay == nil) { member(b, first, "unless_pay"); enc_opt_UnlessPayModifier(b, x.unless_pay) }
	if !(x.distribution == nil) { member(b, first, "distribution"); enc_opt_dyn_t2_TargetRef_u32(b, x.distribution) }
	if !(x.distribute == nil) { member(b, first, "distribute"); enc_opt_DistributionUnit(b, x.distribute) }
	if !(x.player_scope == nil) { member(b, first, "player_scope"); enc_opt_PlayerFilter(b, x.player_scope) }
	if !(x.starting_with == nil) { member(b, first, "starting_with"); enc_opt_ControllerRef(b, x.starting_with) }
	if !(x.chosen_x == nil) { member(b, first, "chosen_x"); enc_opt_u32(b, x.chosen_x) }
	if !(x.cost_paid_object == nil) { member(b, first, "cost_paid_object"); enc_opt_CostPaidObjectSnapshot(b, x.cost_paid_object) }
	if !(x.noted_mana_payment == nil) { member(b, first, "noted_mana_payment"); enc_opt_NotedManaPayment(b, x.noted_mana_payment) }
	if !((len(x.cost_paid_objects) == 0)) { member(b, first, "cost_paid_objects"); enc_dyn_CostPaidObjectRecord(b, x.cost_paid_objects) }
	if !(x.effect_context_object == nil) { member(b, first, "effect_context_object"); enc_opt_CostPaidObjectSnapshot(b, x.effect_context_object) }
	if !(x.amassed_army_object == nil) { member(b, first, "amassed_army_object"); enc_opt_CostPaidObjectSnapshot(b, x.amassed_army_object) }
	if !(x.ability_index == nil) { member(b, first, "ability_index"); enc_opt_int(b, x.ability_index) }
	if !(x.may_trigger_origin == nil) { member(b, first, "may_trigger_origin"); enc_opt_MayTriggerOrigin(b, x.may_trigger_origin) }
	if !(skip_ResolvedAbility_TargetSelectionMode_is_chosen_TargetSelectionMode(x.target_selection_mode)) { member(b, first, "target_selection_mode"); encode_TargetSelectionMode(b, x.target_selection_mode) }
	if !(x.target_chooser == nil) { member(b, first, "target_chooser"); enc_opt_TargetFilter(b, x.target_chooser) }
	if !((len(x.chosen_players) == 0)) { member(b, first, "chosen_players"); enc_dyn_PlayerId(b, x.chosen_players) }
	if !(x.repeat_until == nil) { member(b, first, "repeat_until"); enc_opt_RepeatContinuation(b, x.repeat_until) }
	if !((len(x.replacement_applied) == 0)) { member(b, first, "replacement_applied"); enc_dyn_AppliedReplacementKey(b, x.replacement_applied) }
	if !(skip_ResolvedAbility_SubAbilityLink_is_continuation_SubAbilityLink(x.sub_link)) { member(b, first, "sub_link"); encode_SubAbilityLink(b, x.sub_link) }
	if !(skip_ResolvedAbility_TargetReadOrigin_is_own_TargetReadOrigin(x.target_reads)) { member(b, first, "target_reads"); encode_TargetReadOrigin(b, x.target_reads) }
	if !(skip_ResolvedAbility_ContinuousEffectOnset_is_when_followed_ContinuousEffectOnset(x.entry_onset)) { member(b, first, "entry_onset"); encode_ContinuousEffectOnset(b, x.entry_onset) }
	if !(skip_ResolvedAbility_SiblingCondition_is_default_SiblingCondition(x.sibling_condition)) { member(b, first, "sibling_condition"); encode_SiblingCondition(b, x.sibling_condition) }
	if !(skip_ResolvedAbility_InstructionJoin_is_own_InstructionJoin(x.instruction_join)) { member(b, first, "instruction_join"); encode_InstructionJoin(b, x.instruction_join) }
	if !(x.modal == nil) { member(b, first, "modal"); enc_opt_ModalChoice(b, x.modal) }
	if !((len(x.mode_abilities) == 0)) { member(b, first, "mode_abilities"); enc_dyn_AbilityDefinition(b, x.mode_abilities) }
	if !(x.parent_target_missing_reason == nil) { member(b, first, "parent_target_missing_reason"); enc_opt_ParentTargetMissingReason(b, x.parent_target_missing_reason) }
	if !(x.control_change_instruction == nil) { member(b, first, "control_change_instruction"); enc_opt_ControlChangeInstructionCarrier(b, x.control_change_instruction) }
}

decode_GameRestriction :: proc(v: json.Value, out: ^GameRestriction) -> bool {
	when COVERAGE do cov_hit("GameRestriction")
	if v.kind != .Object do return fail("GameRestriction: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("GameRestriction: no tag")
	switch tv.text {
	case "DamagePreventionDisabled": when COVERAGE do cov_hit("GameRestriction::DamagePreventionDisabled");
		tmp: GameRestriction_DamagePreventionDisabled
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^GameRestriction_DamagePreventionDisabled) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("GameRestriction::DamagePreventionDisabled.source") } else { return fail("GameRestriction::DamagePreventionDisabled.source missing") }
	if fv, found := get_any(v, "expiry"); found { if !decode_RestrictionExpiry(fv, &out.expiry) do return fail("GameRestriction::DamagePreventionDisabled.expiry") } else { return fail("GameRestriction::DamagePreventionDisabled.expiry missing") }
	if fv, found := get_any(v, "scope"); found { if !dec_opt_RestrictionScope(fv, &out.scope) do return fail("GameRestriction::DamagePreventionDisabled.scope") }
	return true
		}) { return fail("GameRestriction::DamagePreventionDisabled") }
		out^ = tmp
	case "ProhibitActivity": when COVERAGE do cov_hit("GameRestriction::ProhibitActivity");
		tmp: GameRestriction_ProhibitActivity
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^GameRestriction_ProhibitActivity) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("GameRestriction::ProhibitActivity.source") } else { return fail("GameRestriction::ProhibitActivity.source missing") }
	if fv, found := get_any(v, "affected_players"); found { if !decode_RestrictionPlayerScope(fv, &out.affected_players) do return fail("GameRestriction::ProhibitActivity.affected_players") } else { return fail("GameRestriction::ProhibitActivity.affected_players missing") }
	if fv, found := get_any(v, "expiry"); found { if !decode_RestrictionExpiry(fv, &out.expiry) do return fail("GameRestriction::ProhibitActivity.expiry") } else { return fail("GameRestriction::ProhibitActivity.expiry missing") }
	if fv, found := get_any(v, "activity"); found { if !decode_ProhibitedActivity(fv, &out.activity) do return fail("GameRestriction::ProhibitActivity.activity") } else { return fail("GameRestriction::ProhibitActivity.activity missing") }
	return true
		}) { return fail("GameRestriction::ProhibitActivity") }
		out^ = tmp
	case "CantEnterBattlefieldFrom": when COVERAGE do cov_hit("GameRestriction::CantEnterBattlefieldFrom");
		tmp: GameRestriction_CantEnterBattlefieldFrom
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^GameRestriction_CantEnterBattlefieldFrom) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("GameRestriction::CantEnterBattlefieldFrom.source") } else { return fail("GameRestriction::CantEnterBattlefieldFrom.source missing") }
	if fv, found := get_any(v, "expiry"); found { if !decode_RestrictionExpiry(fv, &out.expiry) do return fail("GameRestriction::CantEnterBattlefieldFrom.expiry") } else { return fail("GameRestriction::CantEnterBattlefieldFrom.expiry missing") }
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("GameRestriction::CantEnterBattlefieldFrom.filter") } else { return fail("GameRestriction::CantEnterBattlefieldFrom.filter missing") }
	return true
		}) { return fail("GameRestriction::CantEnterBattlefieldFrom") }
		out^ = tmp
	case: return fail("GameRestriction: unknown variant")
	}
	return true
}

encode_GameRestriction :: proc(b: ^strings.Builder, x: GameRestriction) {
	#partial switch y in x {
	case GameRestriction_DamagePreventionDisabled: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DamagePreventionDisabled")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "expiry"); encode_RestrictionExpiry(b, y.expiry)
	if !(y.scope == nil) { member(b, first, "scope"); enc_opt_RestrictionScope(b, y.scope) }
	}; strings.write_byte(b, '}')
	case GameRestriction_ProhibitActivity: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ProhibitActivity")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "affected_players"); encode_RestrictionPlayerScope(b, y.affected_players)
	member(b, first, "expiry"); encode_RestrictionExpiry(b, y.expiry)
	member(b, first, "activity"); encode_ProhibitedActivity(b, y.activity)
	}; strings.write_byte(b, '}')
	case GameRestriction_CantEnterBattlefieldFrom: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CantEnterBattlefieldFrom")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "expiry"); encode_RestrictionExpiry(b, y.expiry)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	}
}

encode_GameRestriction_members :: proc(b: ^strings.Builder, x: GameRestriction, first: ^bool) {
	#partial switch y in x {
	case GameRestriction_DamagePreventionDisabled: member(b, first, "type"); json.write_string(b, "DamagePreventionDisabled")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "expiry"); encode_RestrictionExpiry(b, y.expiry)
	if !(y.scope == nil) { member(b, first, "scope"); enc_opt_RestrictionScope(b, y.scope) }

	case GameRestriction_ProhibitActivity: member(b, first, "type"); json.write_string(b, "ProhibitActivity")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "affected_players"); encode_RestrictionPlayerScope(b, y.affected_players)
	member(b, first, "expiry"); encode_RestrictionExpiry(b, y.expiry)
	member(b, first, "activity"); encode_ProhibitedActivity(b, y.activity)

	case GameRestriction_CantEnterBattlefieldFrom: member(b, first, "type"); json.write_string(b, "CantEnterBattlefieldFrom")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "expiry"); encode_RestrictionExpiry(b, y.expiry)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	}
}

decode_StepEndManaScanEntry :: proc(v: json.Value, out: ^StepEndManaScanEntry) -> bool {
	when COVERAGE do cov_hit("StepEndManaScanEntry")
	if v.kind != .Object do return fail("StepEndManaScanEntry: not an object")
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("StepEndManaScanEntry.source") } else { return fail("StepEndManaScanEntry.source missing") }
