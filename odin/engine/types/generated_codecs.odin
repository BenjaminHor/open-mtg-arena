encode_FaceDownProfile_members :: proc(b: ^strings.Builder, x: FaceDownProfile, first: ^bool) {
	if !(x.power == nil) { member(b, first, "power"); enc_opt_i32(b, x.power) }
	if !(x.toughness == nil) { member(b, first, "toughness"); enc_opt_i32(b, x.toughness) }
	if !(skip_FaceDownProfile_is_creature_body(x.body)) { member(b, first, "body"); encode_FaceDownBody(b, x.body) }
	if !(len(x.extra_core_types) == 0) { member(b, first, "extra_core_types"); enc_dyn_CoreType(b, x.extra_core_types) }
	if !(len(x.subtypes) == 0) { member(b, first, "subtypes"); enc_dyn_string(b, x.subtypes) }
	if !(x.ward == nil) { member(b, first, "ward"); enc_opt_WardCost(b, x.ward) }
	member(b, first, "cause"); encode_FaceDownCause(b, x.cause)
}

