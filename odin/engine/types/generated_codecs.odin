decode_OracleSourceSpan :: proc(v: json.Value, out: ^OracleSourceSpan) -> bool {
	when COVERAGE do cov_hit("OracleSourceSpan")
	if v.kind != .Object do return fail("OracleSourceSpan: not an object")
	if fv, found := get_any(v, "first_line"); found { if !decode_int(fv, &out.first_line) do return fail("OracleSourceSpan.first_line") } else { return fail("OracleSourceSpan.first_line missing") }
	if fv, found := get_any(v, "last_line"); found { if !decode_int(fv, &out.last_line) do return fail("OracleSourceSpan.last_line") } else { return fail("OracleSourceSpan.last_line missing") }
	if fv, found := get_any(v, "start_byte"); found { if !decode_int(fv, &out.start_byte) do return fail("OracleSourceSpan.start_byte") } else { return fail("OracleSourceSpan.start_byte missing") }
	if fv, found := get_any(v, "end_byte"); found { if !decode_int(fv, &out.end_byte) do return fail("OracleSourceSpan.end_byte") } else { return fail("OracleSourceSpan.end_byte missing") }
	if fv, found := get_any(v, "precision"); found { if !decode_SpanPrecision(fv, &out.precision) do return fail("OracleSourceSpan.precision") } else { return fail("OracleSourceSpan.precision missing") }
	if fv, found := get_any(v, "ordinal_within_span"); found { if !decode_u32(fv, &out.ordinal_within_span) do return fail("OracleSourceSpan.ordinal_within_span") } else { return fail("OracleSourceSpan.ordinal_within_span missing") }
	return true
}

encode_OracleSourceSpan :: proc(b: ^strings.Builder, x: OracleSourceSpan) {
	strings.write_byte(b, '{')
	f := true
	encode_OracleSourceSpan_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_OracleSourceSpan_members :: proc(b: ^strings.Builder, x: OracleSourceSpan, first: ^bool) {
	member(b, first, "first_line"); encode_int(b, x.first_line)
	member(b, first, "last_line"); encode_int(b, x.last_line)
	member(b, first, "start_byte"); encode_int(b, x.start_byte)
	member(b, first, "end_byte"); encode_int(b, x.end_byte)
	member(b, first, "precision"); encode_SpanPrecision(b, x.precision)
	member(b, first, "ordinal_within_span"); encode_u32(b, x.ordinal_within_span)
}

