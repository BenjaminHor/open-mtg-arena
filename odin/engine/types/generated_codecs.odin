	if !found || tv.kind != .String do return fail("TieResolution: no tag")
	switch tv.text {
	case "Breaker": tmp: TieResolution_Breaker; if !decode_u8(json.get_or_null(v, "data"), &tmp._0) do return fail("TieResolution::Breaker"); out^ = tmp
	case "AllTied": out^ = TieResolution_AllTied{}
	case: return fail("TieResolution: unknown variant")
	}
	return true
}

