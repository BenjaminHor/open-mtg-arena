decode_TriggerDefinitionOccurrenceRef :: proc(v: json.Value, out: ^TriggerDefinitionOccurrenceRef) -> bool {
	if v.kind != .Object do return fail("TriggerDefinitionOccurrenceRef: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("TriggerDefinitionOccurrenceRef: no tag")
	switch tv.text {
	case "Printed":
		tmp: TriggerDefinitionOccurrenceRef_Printed
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^TriggerDefinitionOccurrenceRef_Printed) -> bool {
	if fv, found := get_any(v, "base_set"); found { if !decode_TriggerBaseSetInstanceRef(fv, &out.base_set) do return fail("TriggerDefinitionOccurrenceRef::Printed.base_set") } else { return fail("TriggerDefinitionOccurrenceRef::Printed.base_set missing") }
	if fv, found := get_any(v, "printed_index"); found { if !decode_int(fv, &out.printed_index) do return fail("TriggerDefinitionOccurrenceRef::Printed.printed_index") } else { return fail("TriggerDefinitionOccurrenceRef::Printed.printed_index missing") }
	return true
		}) { return fail("TriggerDefinitionOccurrenceRef::Printed") }
		out^ = tmp
	case "CopiedValue":
		tmp: TriggerDefinitionOccurrenceRef_CopiedValue
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^TriggerDefinitionOccurrenceRef_CopiedValue) -> bool {
	if fv, found := get_any(v, "copy_effect"); found { if !decode_CopyEffectInstanceRef(fv, &out.copy_effect) do return fail("TriggerDefinitionOccurrenceRef::CopiedValue.copy_effect") } else { return fail("TriggerDefinitionOccurrenceRef::CopiedValue.copy_effect missing") }
	if fv, found := get_any(v, "copied_slot"); found { if !decode_int(fv, &out.copied_slot) do return fail("TriggerDefinitionOccurrenceRef::CopiedValue.copied_slot") } else { return fail("TriggerDefinitionOccurrenceRef::CopiedValue.copied_slot missing") }
	if fv, found := get_any(v, "printed_origin"); found { if !dec_opt_TriggerPrintedOrigin(fv, &out.printed_origin) do return fail("TriggerDefinitionOccurrenceRef::CopiedValue.printed_origin") }
	return true
		}) { return fail("TriggerDefinitionOccurrenceRef::CopiedValue") }
		out^ = tmp
	case "KeywordCompanion":
		tmp: TriggerDefinitionOccurrenceRef_KeywordCompanion
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^TriggerDefinitionOccurrenceRef_KeywordCompanion) -> bool {
	if fv, found := get_any(v, "grant_instance"); found { if !decode_TriggerGrantInstanceRef(fv, &out.grant_instance) do return fail("TriggerDefinitionOccurrenceRef::KeywordCompanion.grant_instance") } else { return fail("TriggerDefinitionOccurrenceRef::KeywordCompanion.grant_instance missing") }
	if fv, found := get_any(v, "companion_index"); found { if !decode_int(fv, &out.companion_index) do return fail("TriggerDefinitionOccurrenceRef::KeywordCompanion.companion_index") } else { return fail("TriggerDefinitionOccurrenceRef::KeywordCompanion.companion_index missing") }
	return true
		}) { return fail("TriggerDefinitionOccurrenceRef::KeywordCompanion") }
		out^ = tmp
	case "CopyRetained":
		tmp: TriggerDefinitionOccurrenceRef_CopyRetained
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^TriggerDefinitionOccurrenceRef_CopyRetained) -> bool {
	if fv, found := get_any(v, "grant_instance"); found { if !decode_TriggerGrantInstanceRef(fv, &out.grant_instance) do return fail("TriggerDefinitionOccurrenceRef::CopyRetained.grant_instance") } else { return fail("TriggerDefinitionOccurrenceRef::CopyRetained.grant_instance missing") }
	if fv, found := get_any(v, "source_base_set"); found { if !decode_TriggerBaseSetInstanceRef(fv, &out.source_base_set) do return fail("TriggerDefinitionOccurrenceRef::CopyRetained.source_base_set") } else { return fail("TriggerDefinitionOccurrenceRef::CopyRetained.source_base_set missing") }
	if fv, found := get_any(v, "source_printed_index"); found { if !decode_int(fv, &out.source_printed_index) do return fail("TriggerDefinitionOccurrenceRef::CopyRetained.source_printed_index") } else { return fail("TriggerDefinitionOccurrenceRef::CopyRetained.source_printed_index missing") }
	return true
		}) { return fail("TriggerDefinitionOccurrenceRef::CopyRetained") }
		out^ = tmp
	case "Granted":
		tmp: TriggerDefinitionOccurrenceRef_Granted
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^TriggerDefinitionOccurrenceRef_Granted) -> bool {
	if fv, found := get_any(v, "grant_instance"); found { if !decode_TriggerGrantInstanceRef(fv, &out.grant_instance) do return fail("TriggerDefinitionOccurrenceRef::Granted.grant_instance") } else { return fail("TriggerDefinitionOccurrenceRef::Granted.grant_instance missing") }
	return true
		}) { return fail("TriggerDefinitionOccurrenceRef::Granted") }
		out^ = tmp
	case "ExpandedGrant":
		tmp: TriggerDefinitionOccurrenceRef_ExpandedGrant
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^TriggerDefinitionOccurrenceRef_ExpandedGrant) -> bool {
	if fv, found := get_any(v, "grant_instance"); found { if !decode_TriggerGrantInstanceRef(fv, &out.grant_instance) do return fail("TriggerDefinitionOccurrenceRef::ExpandedGrant.grant_instance") } else { return fail("TriggerDefinitionOccurrenceRef::ExpandedGrant.grant_instance missing") }
	if fv, found := get_any(v, "provider"); found { if !dec_ptr_TriggerDefinitionRef(fv, &out.provider) do return fail("TriggerDefinitionOccurrenceRef::ExpandedGrant.provider") } else { return fail("TriggerDefinitionOccurrenceRef::ExpandedGrant.provider missing") }
