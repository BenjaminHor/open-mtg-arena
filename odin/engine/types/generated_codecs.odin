		tmp: StaticCondition_DevotionGE
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_DevotionGE) -> bool {
	if fv, found := get_any(v, "colors"); found { if !dec_dyn_ManaColor(fv, &out.colors) do return fail("StaticCondition::DevotionGE.colors") } else { return fail("StaticCondition::DevotionGE.colors missing") }
	if fv, found := get_any(v, "threshold"); found { if !decode_u32(fv, &out.threshold) do return fail("StaticCondition::DevotionGE.threshold") } else { return fail("StaticCondition::DevotionGE.threshold missing") }
	return true
		}) { return fail("StaticCondition::DevotionGE") }
		out^ = tmp
	case "IsPresent": when COVERAGE do cov_hit("StaticCondition::IsPresent");
		tmp: StaticCondition_IsPresent
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_IsPresent) -> bool {
	if fv, found := get_any(v, "filter"); found { if !dec_opt_TargetFilter(fv, &out.filter) do return fail("StaticCondition::IsPresent.filter") }
	return true
		}) { return fail("StaticCondition::IsPresent") }
		out^ = tmp
	case "ChosenColorIs": when COVERAGE do cov_hit("StaticCondition::ChosenColorIs");
		tmp: StaticCondition_ChosenColorIs
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_ChosenColorIs) -> bool {
	if fv, found := get_any(v, "color"); found { if !decode_ManaColor(fv, &out.color) do return fail("StaticCondition::ChosenColorIs.color") } else { return fail("StaticCondition::ChosenColorIs.color missing") }
	return true
		}) { return fail("StaticCondition::ChosenColorIs") }
		out^ = tmp
	case "ChosenLabelIs": when COVERAGE do cov_hit("StaticCondition::ChosenLabelIs");
		tmp: StaticCondition_ChosenLabelIs
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_ChosenLabelIs) -> bool {
	if fv, found := get_any(v, "label"); found { if !decode_string(fv, &out.label) do return fail("StaticCondition::ChosenLabelIs.label") } else { return fail("StaticCondition::ChosenLabelIs.label missing") }
	return true
		}) { return fail("StaticCondition::ChosenLabelIs") }
		out^ = tmp
	case "QuantityComparison": when COVERAGE do cov_hit("StaticCondition::QuantityComparison");
		tmp: StaticCondition_QuantityComparison
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_QuantityComparison) -> bool {
	if fv, found := get_any(v, "lhs"); found { if !decode_QuantityExpr(fv, &out.lhs) do return fail("StaticCondition::QuantityComparison.lhs") } else { return fail("StaticCondition::QuantityComparison.lhs missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("StaticCondition::QuantityComparison.comparator") } else { return fail("StaticCondition::QuantityComparison.comparator missing") }
	if fv, found := get_any(v, "rhs"); found { if !decode_QuantityExpr(fv, &out.rhs) do return fail("StaticCondition::QuantityComparison.rhs") } else { return fail("StaticCondition::QuantityComparison.rhs missing") }
	return true
		}) { return fail("StaticCondition::QuantityComparison") }
		out^ = tmp
	case "QuantityQuality": when COVERAGE do cov_hit("StaticCondition::QuantityQuality");
		tmp: StaticCondition_QuantityQuality
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^StaticCondition_QuantityQuality) -> bool {
	if fv, found := get_any(v, "quantity"); found { if !decode_QuantityExpr(fv, &out.quantity) do return fail("StaticCondition::QuantityQuality.quantity") } else { return fail("StaticCondition::QuantityQuality.quantity missing") }
	if fv, found := get_any(v, "quality"); found { if !decode_NumberQuality(fv, &out.quality) do return fail("StaticCondition::QuantityQuality.quality") } else { return fail("StaticCondition::QuantityQuality.quality missing") }
	return true
		}) { return fail("StaticCondition::QuantityQuality") }
