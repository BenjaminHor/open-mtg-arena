	when COVERAGE do cov_hit("CopyTokenEntryTail")
	if v.kind != .Object do return fail("CopyTokenEntryTail: not an object")
	if fv, found := get_any(v, "owner"); found { if !decode_PlayerId(fv, &out.owner) do return fail("CopyTokenEntryTail.owner") } else { return fail("CopyTokenEntryTail.owner missing") }
	if fv, found := get_any(v, "copy"); found { if !dec_ptr_CopyTokenSpec(fv, &out.copy) do return fail("CopyTokenEntryTail.copy") } else { return fail("CopyTokenEntryTail.copy missing") }
	if fv, found := get_any(v, "enter_tapped"); found { if !decode_EtbTapState(fv, &out.enter_tapped) do return fail("CopyTokenEntryTail.enter_tapped") } else { return fail("CopyTokenEntryTail.enter_tapped missing") }
	if fv, found := get_any(v, "enter_with_counters"); found { if !dec_dyn_t2_CounterType_u32(fv, &out.enter_with_counters) do return fail("CopyTokenEntryTail.enter_with_counters") } else { return fail("CopyTokenEntryTail.enter_with_counters missing") }
	if fv, found := get_any(v, "etb_counters"); found { if !dec_dyn_t2_CounterType_u32(fv, &out.etb_counters) do return fail("CopyTokenEntryTail.etb_counters") } else { return fail("CopyTokenEntryTail.etb_counters missing") }
	if fv, found := get_any(v, "remaining_count"); found { if !decode_u32(fv, &out.remaining_count) do return fail("CopyTokenEntryTail.remaining_count") } else { return fail("CopyTokenEntryTail.remaining_count missing") }
	if fv, found := get_any(v, "attack_destination"); found { if !decode_EntryAttackDestination(fv, &out.attack_destination) do return fail("CopyTokenEntryTail.attack_destination") } else { out.attack_destination = EntryAttackDestination(EntryAttackDestination_AnyDefender{}) }
	return true
}

