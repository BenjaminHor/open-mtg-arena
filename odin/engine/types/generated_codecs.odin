	case "FromPlayer": when COVERAGE do cov_hit("MatchedProtectionQuality::FromPlayer"); tmp: MatchedProtectionQuality_FromPlayer; if !decode_ProtectionPlayerScope(body, &tmp._0) do return fail("MatchedProtectionQuality::FromPlayer"); out^ = tmp
