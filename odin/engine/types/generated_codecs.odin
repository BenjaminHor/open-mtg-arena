		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^PinnedDecision_MayChoice) -> bool {
	if fv, found := get_any(v, "slot"); found { if !decode_DecisionSlot(fv, &out.slot) do return fail("PinnedDecision::MayChoice.slot") } else { return fail("PinnedDecision::MayChoice.slot missing") }
	if fv, found := get_any(v, "take"); found { if !decode_MayChoiceOption(fv, &out.take) do return fail("PinnedDecision::MayChoice.take") } else { return fail("PinnedDecision::MayChoice.take missing") }
	return true
		}) { return fail("PinnedDecision::MayChoice") }
		out^ = tmp
	case "UnlessBreak": when COVERAGE do cov_hit("PinnedDecision::UnlessBreak");
		tmp: PinnedDecision_UnlessBreak
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^PinnedDecision_UnlessBreak) -> bool {
	if fv, found := get_any(v, "slot"); found { if !decode_DecisionSlot(fv, &out.slot) do return fail("PinnedDecision::UnlessBreak.slot") } else { return fail("PinnedDecision::UnlessBreak.slot missing") }
	if fv, found := get_any(v, "pay"); found { if !decode_UnlessPaymentOption(fv, &out.pay) do return fail("PinnedDecision::UnlessBreak.pay") } else { return fail("PinnedDecision::UnlessBreak.pay missing") }
	return true
		}) { return fail("PinnedDecision::UnlessBreak") }
		out^ = tmp
	case "ConvokeTaps": when COVERAGE do cov_hit("PinnedDecision::ConvokeTaps");
		tmp: PinnedDecision_ConvokeTaps
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^PinnedDecision_ConvokeTaps) -> bool {
	if fv, found := get_any(v, "slot"); found { if !decode_DecisionSlot(fv, &out.slot) do return fail("PinnedDecision::ConvokeTaps.slot") } else { return fail("PinnedDecision::ConvokeTaps.slot missing") }
	return true
		}) { return fail("PinnedDecision::ConvokeTaps") }
		out^ = tmp
	case "ManaColor": when COVERAGE do cov_hit("PinnedDecision::ManaColor");
		tmp: PinnedDecision_ManaColor
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^PinnedDecision_ManaColor) -> bool {
	if fv, found := get_any(v, "slot"); found { if !decode_DecisionSlot(fv, &out.slot) do return fail("PinnedDecision::ManaColor.slot") } else { return fail("PinnedDecision::ManaColor.slot missing") }
	if fv, found := get_any(v, "color"); found { if !decode_ManaColor(fv, &out.color) do return fail("PinnedDecision::ManaColor.color") } else { return fail("PinnedDecision::ManaColor.color missing") }
	return true
		}) { return fail("PinnedDecision::ManaColor") }
		out^ = tmp
	case: return fail("PinnedDecision: unknown variant")
	}
	return true
}

encode_PinnedDecision :: proc(b: ^strings.Builder, x: PinnedDecision) {
	#partial switch y in x {
	case PinnedDecision_Order: strings.write_byte(b, '{'); json.write_string(b, "Order"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "slot"); encode_DecisionSlot(b, y.slot)
	member(b, first, "pos"); encode_u8(b, y.pos)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PinnedDecision_Targets: strings.write_byte(b, '{'); json.write_string(b, "Targets"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "slot"); encode_DecisionSlot(b, y.slot)
	member(b, first, "targets"); enc_dyn_TargetPin(b, y.targets)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PinnedDecision_Mode: strings.write_byte(b, '{'); json.write_string(b, "Mode"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "slot"); encode_DecisionSlot(b, y.slot)
	member(b, first, "indices"); enc_dyn_int(b, y.indices)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PinnedDecision_MayChoice: strings.write_byte(b, '{'); json.write_string(b, "MayChoice"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "slot"); encode_DecisionSlot(b, y.slot)
	member(b, first, "take"); encode_MayChoiceOption(b, y.take)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PinnedDecision_UnlessBreak: strings.write_byte(b, '{'); json.write_string(b, "UnlessBreak"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "slot"); encode_DecisionSlot(b, y.slot)
	member(b, first, "pay"); encode_UnlessPaymentOption(b, y.pay)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PinnedDecision_ConvokeTaps: strings.write_byte(b, '{'); json.write_string(b, "ConvokeTaps"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "slot"); encode_DecisionSlot(b, y.slot)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PinnedDecision_ManaColor: strings.write_byte(b, '{'); json.write_string(b, "ManaColor"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "slot"); encode_DecisionSlot(b, y.slot)
	member(b, first, "color"); encode_ManaColor(b, y.color)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_ReplayMode :: proc(v: json.Value, out: ^ReplayMode) -> bool {
	when COVERAGE do cov_hit("ReplayMode")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ReplayMode: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ReplayMode: not a string or object")
	}
	switch variant {
	case "Static": when COVERAGE do cov_hit("ReplayMode::Static"); out^ = ReplayMode_Static{}
	case "Scheduled": when COVERAGE do cov_hit("ReplayMode::Scheduled");
		tmp: ReplayMode_Scheduled
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ReplayMode_Scheduled) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_IterationCount(fv, &out.count) do return fail("ReplayMode::Scheduled.count") } else { return fail("ReplayMode::Scheduled.count missing") }
	return true
		}) { return fail("ReplayMode::Scheduled") }
		out^ = tmp
	case: return fail("ReplayMode: unknown variant")
	}
	return true
}

encode_ReplayMode :: proc(b: ^strings.Builder, x: ReplayMode) {
	#partial switch y in x {
	case ReplayMode_Static: _ = y; json.write_string(b, "Static")
	case ReplayMode_Scheduled: strings.write_byte(b, '{'); json.write_string(b, "Scheduled"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "count"); encode_IterationCount(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

