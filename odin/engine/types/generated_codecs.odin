	case Keyword_Cleave: strings.write_byte(b, '{'); json.write_string(b, "Cleave"); strings.write_byte(b, ':'); encode_ManaCost(b, y._0); strings.write_byte(b, '}')
	case Keyword_Undaunted: _ = y; json.write_string(b, "Undaunted")
	case Keyword_Paradigm: _ = y; json.write_string(b, "Paradigm")
	case Keyword_Station: _ = y; json.write_string(b, "Station")
	case Keyword_Replicate: strings.write_byte(b, '{'); json.write_string(b, "Replicate"); strings.write_byte(b, ':'); encode_ManaCost(b, y._0); strings.write_byte(b, '}')
	case Keyword_Awaken: strings.write_byte(b, '{'); json.write_string(b, "Awaken"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case Keyword_ForMirrodin: _ = y; json.write_string(b, "ForMirrodin")
	case Keyword_MoreThanMeetsTheEye: strings.write_byte(b, '{'); json.write_string(b, "MoreThanMeetsTheEye"); strings.write_byte(b, ':'); encode_ManaCost(b, y._0); strings.write_byte(b, '}')
	case Keyword_Freerunning: strings.write_byte(b, '{'); json.write_string(b, "Freerunning"); strings.write_byte(b, ':'); encode_ManaCost(b, y._0); strings.write_byte(b, '}')
	case Keyword_Increment: _ = y; json.write_string(b, "Increment")
	case Keyword_Specialize: strings.write_byte(b, '{'); json.write_string(b, "Specialize"); strings.write_byte(b, ':'); encode_ManaCost(b, y._0); strings.write_byte(b, '}')
	case Keyword_Offering: strings.write_byte(b, '{'); json.write_string(b, "Offering"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	case Keyword_Unknown: strings.write_byte(b, '{'); json.write_string(b, "Unknown"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	}
}

decode_AbilityDefinition :: proc(v: json.Value, out: ^AbilityDefinition) -> bool {
	when COVERAGE do cov_hit("AbilityDefinition")
	if v.kind != .Object do return fail("AbilityDefinition: not an object")
	if fv, found := get_any(v, "kind"); found { if !decode_AbilityKind(fv, &out.kind) do return fail("AbilityDefinition.kind") } else { return fail("AbilityDefinition.kind missing") }
	if fv, found := get_any(v, "effect"); found { if !dec_ptr_Effect(fv, &out.effect) do return fail("AbilityDefinition.effect") } else { return fail("AbilityDefinition.effect missing") }
	if fv, found := get_any(v, "declares_chosen_group"); found { if !dec_opt_ChosenGroupId(fv, &out.declares_chosen_group) do return fail("AbilityDefinition.declares_chosen_group") }
	if fv, found := get_any(v, "reads_chosen_group"); found { if !dec_opt_ChosenGroupId(fv, &out.reads_chosen_group) do return fail("AbilityDefinition.reads_chosen_group") }
	if fv, found := get_any(v, "declares_return_result"); found { if !dec_opt_ReturnResultId(fv, &out.declares_return_result) do return fail("AbilityDefinition.declares_return_result") }
	if fv, found := get_any(v, "reads_return_result"); found { if !dec_opt_t2_ReturnResultId_ReturnResultReadSpec(fv, &out.reads_return_result) do return fail("AbilityDefinition.reads_return_result") }
	if fv, found := get_any(v, "cost"); found { if !dec_opt_AbilityCost(fv, &out.cost) do return fail("AbilityDefinition.cost") }
	if fv, found := get_any(v, "sub_ability"); found { if !dec_ptr_AbilityDefinition(fv, &out.sub_ability) do return fail("AbilityDefinition.sub_ability") }
	if fv, found := get_any(v, "else_ability"); found { if !dec_ptr_AbilityDefinition(fv, &out.else_ability) do return fail("AbilityDefinition.else_ability") }
	if fv, found := get_any(v, "duration"); found { if !dec_opt_Duration(fv, &out.duration) do return fail("AbilityDefinition.duration") }
	if fv, found := get_any(v, "description"); found { if !dec_opt_string(fv, &out.description) do return fail("AbilityDefinition.description") }
	if fv, found := get_any(v, "target_prompt"); found { if !dec_opt_string(fv, &out.target_prompt) do return fail("AbilityDefinition.target_prompt") }
	if fv, found := get_any(v, "activation_restrictions"); found { if !dec_dyn_ActivationRestriction(fv, &out.activation_restrictions) do return fail("AbilityDefinition.activation_restrictions") }
	if fv, found := get_any(v, "activation_mana_payment_restriction"); found { if !dec_opt_ActivationManaPaymentRestriction(fv, &out.activation_mana_payment_restriction) do return fail("AbilityDefinition.activation_mana_payment_restriction") }
	if fv, found := get_any(v, "activator_filter"); found { if !dec_opt_PlayerFilter(fv, &out.activator_filter) do return fail("AbilityDefinition.activator_filter") }
	if fv, found := get_any(v, "activation_zone"); found { if !dec_opt_Zone(fv, &out.activation_zone) do return fail("AbilityDefinition.activation_zone") }
	if fv, found := get_any(v, "ability_tag"); found { if !dec_opt_AbilityTag(fv, &out.ability_tag) do return fail("AbilityDefinition.ability_tag") }
	if fv, found := get_any(v, "condition"); found { if !dec_opt_AbilityCondition(fv, &out.condition) do return fail("AbilityDefinition.condition") }
	if fv, found := get_any(v, "optional_targeting"); found { if !decode_bool(fv, &out.optional_targeting) do return fail("AbilityDefinition.optional_targeting") }
	if fv, found := get_any(v, "optional"); found { if !decode_bool(fv, &out.optional) do return fail("AbilityDefinition.optional") }
	if fv, found := get_any(v, "optional_player"); found { if !dec_opt_TargetFilter(fv, &out.optional_player) do return fail("AbilityDefinition.optional_player") }
	if fv, found := get_any(v, "optional_for"); found { if !dec_opt_OpponentMayScope(fv, &out.optional_for) do return fail("AbilityDefinition.optional_for") }
	if fv, found := get_any(v, "multi_target"); found { if !dec_opt_MultiTargetSpec(fv, &out.multi_target) do return fail("AbilityDefinition.multi_target") }
	if fv, found := get_any(v, "target_constraints"); found { if !dec_dyn_TargetSelectionConstraint(fv, &out.target_constraints) do return fail("AbilityDefinition.target_constraints") }
	if fv, found := get_any(v, "target_choice_timing"); found { if !decode_TargetChoiceTiming(fv, &out.target_choice_timing) do return fail("AbilityDefinition.target_choice_timing") }
	if fv, found := get_any(v, "distribute"); found { if !dec_opt_DistributionUnit(fv, &out.distribute) do return fail("AbilityDefinition.distribute") }
	if fv, found := get_any(v, "unless_pay"); found { if !dec_opt_UnlessPayModifier(fv, &out.unless_pay) do return fail("AbilityDefinition.unless_pay") }
	if fv, found := get_any(v, "modal"); found { if !dec_opt_ModalChoice(fv, &out.modal) do return fail("AbilityDefinition.modal") }
	if fv, found := get_any(v, "mode_abilities"); found { if !dec_dyn_AbilityDefinition(fv, &out.mode_abilities) do return fail("AbilityDefinition.mode_abilities") }
	if fv, found := get_any(v, "repeat_for"); found { if !dec_opt_QuantityExpr(fv, &out.repeat_for) do return fail("AbilityDefinition.repeat_for") }
	if fv, found := get_any(v, "repeat_timing"); found { if !decode_RepeatForTiming(fv, &out.repeat_timing) do return fail("AbilityDefinition.repeat_timing") }
	if fv, found := get_any(v, "min_x_value"); found { if !decode_u32(fv, &out.min_x_value) do return fail("AbilityDefinition.min_x_value") }
	if fv, found := get_any(v, "announced_x"); found { if !dec_opt_QuantityExpr(fv, &out.announced_x) do return fail("AbilityDefinition.announced_x") }
	if fv, found := get_any(v, "cant_be_copied"); found { if !decode_bool(fv, &out.cant_be_copied) do return fail("AbilityDefinition.cant_be_copied") }
	if fv, found := get_any(v, "illegal_targets_disposition"); found { if !decode_IllegalTargetsDisposition(fv, &out.illegal_targets_disposition) do return fail("AbilityDefinition.illegal_targets_disposition") }
	if fv, found := get_any(v, "cost_reduction"); found { if !dec_opt_CostReduction(fv, &out.cost_reduction) do return fail("AbilityDefinition.cost_reduction") }
	if fv, found := get_any(v, "forward_result"); found { if !decode_bool(fv, &out.forward_result) do return fail("AbilityDefinition.forward_result") }
	if fv, found := get_any(v, "player_scope"); found { if !dec_opt_PlayerFilter(fv, &out.player_scope) do return fail("AbilityDefinition.player_scope") }
	if fv, found := get_any(v, "starting_with"); found { if !dec_opt_ControllerRef(fv, &out.starting_with) do return fail("AbilityDefinition.starting_with") }
	if fv, found := get_any(v, "target_selection_mode"); found { if !decode_TargetSelectionMode(fv, &out.target_selection_mode) do return fail("AbilityDefinition.target_selection_mode") }
	if fv, found := get_any(v, "target_chooser"); found { if !dec_opt_TargetFilter(fv, &out.target_chooser) do return fail("AbilityDefinition.target_chooser") }
	if fv, found := get_any(v, "repeat_until"); found { if !dec_opt_RepeatContinuation(fv, &out.repeat_until) do return fail("AbilityDefinition.repeat_until") }
	if fv, found := get_any(v, "sub_link"); found { if !decode_SubAbilityLink(fv, &out.sub_link) do return fail("AbilityDefinition.sub_link") }
	if fv, found := get_any(v, "target_reads"); found { if !decode_TargetReadOrigin(fv, &out.target_reads) do return fail("AbilityDefinition.target_reads") }
	if fv, found := get_any(v, "entry_onset"); found { if !decode_ContinuousEffectOnset(fv, &out.entry_onset) do return fail("AbilityDefinition.entry_onset") }
	if fv, found := get_any(v, "iteration_kind_binding"); found { if !dec_opt_IterationKindBinding(fv, &out.iteration_kind_binding) do return fail("AbilityDefinition.iteration_kind_binding") }
	if fv, found := get_any(v, "sibling_condition"); found { if !decode_SiblingCondition(fv, &out.sibling_condition) do return fail("AbilityDefinition.sibling_condition") }
	if fv, found := get_any(v, "instruction_join"); found { if !decode_InstructionJoin(fv, &out.instruction_join) do return fail("AbilityDefinition.instruction_join") }
	if fv, found := get_any(v, "unlowered_guard"); found { if !dec_opt_UnloweredGuard(fv, &out.unlowered_guard) do return fail("AbilityDefinition.unlowered_guard") }
	if fv, found := get_any(v, "linked_exile_return"); found { if !dec_opt_LinkedExileReturn(fv, &out.linked_exile_return) do return fail("AbilityDefinition.linked_exile_return") }
	if fv, found := get_any(v, "face_down_in_exile"); found { if !decode_ExileConcealment(fv, &out.face_down_in_exile) do return fail("AbilityDefinition.face_down_in_exile") }
	if fv, found := get_any(v, "granting_object"); found { if !dec_opt_ObjectIncarnationRef(fv, &out.granting_object) do return fail("AbilityDefinition.granting_object") }
	if fv, found := get_any(v, "grant_chain"); found { if !dec_dyn_ObjectIncarnationRef(fv, &out.grant_chain) do return fail("AbilityDefinition.grant_chain") }
	return true
}

encode_AbilityDefinition :: proc(b: ^strings.Builder, x: AbilityDefinition) {
	strings.write_byte(b, '{')
	f := true
	encode_AbilityDefinition_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_AbilityDefinition_members :: proc(b: ^strings.Builder, x: AbilityDefinition, first: ^bool) {
	member(b, first, "kind"); encode_AbilityKind(b, x.kind)
	member(b, first, "effect"); enc_ptr_Effect(b, x.effect)
	if !(x.declares_chosen_group == nil) { member(b, first, "declares_chosen_group"); enc_opt_ChosenGroupId(b, x.declares_chosen_group) }
	if !(x.reads_chosen_group == nil) { member(b, first, "reads_chosen_group"); enc_opt_ChosenGroupId(b, x.reads_chosen_group) }
	if !(x.declares_return_result == nil) { member(b, first, "declares_return_result"); enc_opt_ReturnResultId(b, x.declares_return_result) }
	if !(x.reads_return_result == nil) { member(b, first, "reads_return_result"); enc_opt_t2_ReturnResultId_ReturnResultReadSpec(b, x.reads_return_result) }
	member(b, first, "cost"); enc_opt_AbilityCost(b, x.cost)
	member(b, first, "sub_ability"); enc_ptr_AbilityDefinition(b, x.sub_ability)
	if !(x.else_ability == nil) { member(b, first, "else_ability"); enc_ptr_AbilityDefinition(b, x.else_ability) }
	member(b, first, "duration"); enc_opt_Duration(b, x.duration)
	member(b, first, "description"); enc_opt_string(b, x.description)
	member(b, first, "target_prompt"); enc_opt_string(b, x.target_prompt)
	if !((len(x.activation_restrictions) == 0)) { member(b, first, "activation_restrictions"); enc_dyn_ActivationRestriction(b, x.activation_restrictions) }
	if !(x.activation_mana_payment_restriction == nil) { member(b, first, "activation_mana_payment_restriction"); enc_opt_ActivationManaPaymentRestriction(b, x.activation_mana_payment_restriction) }
	if !(x.activator_filter == nil) { member(b, first, "activator_filter"); enc_opt_PlayerFilter(b, x.activator_filter) }
	if !(x.activation_zone == nil) { member(b, first, "activation_zone"); enc_opt_Zone(b, x.activation_zone) }
	if !(x.ability_tag == nil) { member(b, first, "ability_tag"); enc_opt_AbilityTag(b, x.ability_tag) }
	member(b, first, "condition"); enc_opt_AbilityCondition(b, x.condition)
	member(b, first, "optional_targeting"); encode_bool(b, x.optional_targeting)
	member(b, first, "optional"); encode_bool(b, x.optional)
	if !(x.optional_player == nil) { member(b, first, "optional_player"); enc_opt_TargetFilter(b, x.optional_player) }
	if !(x.optional_for == nil) { member(b, first, "optional_for"); enc_opt_OpponentMayScope(b, x.optional_for) }
	if !(x.multi_target == nil) { member(b, first, "multi_target"); enc_opt_MultiTargetSpec(b, x.multi_target) }
	if !((len(x.target_constraints) == 0)) { member(b, first, "target_constraints"); enc_dyn_TargetSelectionConstraint(b, x.target_constraints) }
	if !(skip_AbilityDefinition_TargetChoiceTiming_is_stack_TargetChoiceTiming(x.target_choice_timing)) { member(b, first, "target_choice_timing"); encode_TargetChoiceTiming(b, x.target_choice_timing) }
	if !(x.distribute == nil) { member(b, first, "distribute"); enc_opt_DistributionUnit(b, x.distribute) }
	if !(x.unless_pay == nil) { member(b, first, "unless_pay"); enc_opt_UnlessPayModifier(b, x.unless_pay) }
	if !(x.modal == nil) { member(b, first, "modal"); enc_opt_ModalChoice(b, x.modal) }
	if !((len(x.mode_abilities) == 0)) { member(b, first, "mode_abilities"); enc_dyn_AbilityDefinition(b, x.mode_abilities) }
	if !(x.repeat_for == nil) { member(b, first, "repeat_for"); enc_opt_QuantityExpr(b, x.repeat_for) }
	if !(skip_AbilityDefinition_RepeatForTiming_is_sequential_RepeatForTiming(x.repeat_timing)) { member(b, first, "repeat_timing"); encode_RepeatForTiming(b, x.repeat_timing) }
	if !(x.min_x_value == 0) { member(b, first, "min_x_value"); encode_u32(b, x.min_x_value) }
	if !(x.announced_x == nil) { member(b, first, "announced_x"); enc_opt_QuantityExpr(b, x.announced_x) }
	if !(!x.cant_be_copied) { member(b, first, "cant_be_copied"); encode_bool(b, x.cant_be_copied) }
	if !(skip_AbilityDefinition_IllegalTargetsDisposition_is_does_not_resolve_IllegalTargetsDisposition(x.illegal_targets_disposition)) { member(b, first, "illegal_targets_disposition"); encode_IllegalTargetsDisposition(b, x.illegal_targets_disposition) }
	if !(x.cost_reduction == nil) { member(b, first, "cost_reduction"); enc_opt_CostReduction(b, x.cost_reduction) }
	member(b, first, "forward_result"); encode_bool(b, x.forward_result)
	if !(x.player_scope == nil) { member(b, first, "player_scope"); enc_opt_PlayerFilter(b, x.player_scope) }
	if !(x.starting_with == nil) { member(b, first, "starting_with"); enc_opt_ControllerRef(b, x.starting_with) }
	if !(skip_AbilityDefinition_TargetSelectionMode_is_chosen_TargetSelectionMode(x.target_selection_mode)) { member(b, first, "target_selection_mode"); encode_TargetSelectionMode(b, x.target_selection_mode) }
	if !(x.target_chooser == nil) { member(b, first, "target_chooser"); enc_opt_TargetFilter(b, x.target_chooser) }
	if !(x.repeat_until == nil) { member(b, first, "repeat_until"); enc_opt_RepeatContinuation(b, x.repeat_until) }
	if !(skip_AbilityDefinition_SubAbilityLink_is_continuation_SubAbilityLink(x.sub_link)) { member(b, first, "sub_link"); encode_SubAbilityLink(b, x.sub_link) }
	if !(skip_AbilityDefinition_TargetReadOrigin_is_own_TargetReadOrigin(x.target_reads)) { member(b, first, "target_reads"); encode_TargetReadOrigin(b, x.target_reads) }
	if !(skip_AbilityDefinition_ContinuousEffectOnset_is_when_followed_ContinuousEffectOnset(x.entry_onset)) { member(b, first, "entry_onset"); encode_ContinuousEffectOnset(b, x.entry_onset) }
	if !(x.iteration_kind_binding == nil) { member(b, first, "iteration_kind_binding"); enc_opt_IterationKindBinding(b, x.iteration_kind_binding) }
	if !(skip_AbilityDefinition_SiblingCondition_is_default_SiblingCondition(x.sibling_condition)) { member(b, first, "sibling_condition"); encode_SiblingCondition(b, x.sibling_condition) }
	if !(skip_AbilityDefinition_InstructionJoin_is_own_InstructionJoin(x.instruction_join)) { member(b, first, "instruction_join"); encode_InstructionJoin(b, x.instruction_join) }
	if !(x.unlowered_guard == nil) { member(b, first, "unlowered_guard"); enc_opt_UnloweredGuard(b, x.unlowered_guard) }
	if !(x.linked_exile_return == nil) { member(b, first, "linked_exile_return"); enc_opt_LinkedExileReturn(b, x.linked_exile_return) }
	if !(skip_AbilityDefinition_ExileConcealment_is_public_ExileConcealment(x.face_down_in_exile)) { member(b, first, "face_down_in_exile"); encode_ExileConcealment(b, x.face_down_in_exile) }
	if !(x.granting_object == nil) { member(b, first, "granting_object"); enc_opt_ObjectIncarnationRef(b, x.granting_object) }
	if !((len(x.grant_chain) == 0)) { member(b, first, "grant_chain"); enc_dyn_ObjectIncarnationRef(b, x.grant_chain) }
	encode_AbilityDefinition_computed(b, x, first)
}

decode_TriggerDefinition :: proc(v: json.Value, out: ^TriggerDefinition) -> bool {
	when COVERAGE do cov_hit("TriggerDefinition")
	if v.kind != .Object do return fail("TriggerDefinition: not an object")
	if fv, found := get_any(v, "mode"); found { if !decode_TriggerMode(fv, &out.mode) do return fail("TriggerDefinition.mode") } else { return fail("TriggerDefinition.mode missing") }
	if fv, found := get_any(v, "execute"); found { if !dec_ptr_AbilityDefinition(fv, &out.execute) do return fail("TriggerDefinition.execute") }
	if fv, found := get_any(v, "valid_card"); found { if !dec_opt_TargetFilter(fv, &out.valid_card) do return fail("TriggerDefinition.valid_card") }
	if fv, found := get_any(v, "origin"); found { if !dec_opt_Zone(fv, &out.origin) do return fail("TriggerDefinition.origin") }
	if fv, found := get_any(v, "origin_zones"); found { if !dec_dyn_Zone(fv, &out.origin_zones) do return fail("TriggerDefinition.origin_zones") }
	if fv, found := get_any(v, "zone_change_clauses"); found { if !dec_dyn_ZoneChangeClause(fv, &out.zone_change_clauses) do return fail("TriggerDefinition.zone_change_clauses") }
	if fv, found := get_any(v, "destination"); found { if !dec_opt_Zone(fv, &out.destination) do return fail("TriggerDefinition.destination") }
	if fv, found := get_any(v, "destination_constraint"); found { if !decode_OriginConstraint(fv, &out.destination_constraint) do return fail("TriggerDefinition.destination_constraint") } else { out.destination_constraint = default_TriggerDefinition_OriginConstraint_any_default() }
	if fv, found := get_any(v, "trigger_zones"); found { if !dec_dyn_Zone(fv, &out.trigger_zones) do return fail("TriggerDefinition.trigger_zones") }
	if fv, found := get_any(v, "phase"); found { if !dec_opt_Phase(fv, &out.phase) do return fail("TriggerDefinition.phase") }
	if fv, found := get_any(v, "optional"); found { if !decode_bool(fv, &out.optional) do return fail("TriggerDefinition.optional") }
	if fv, found := get_any(v, "damage_kind"); found { if !decode_DamageKindFilter(fv, &out.damage_kind) do return fail("TriggerDefinition.damage_kind") }
	if fv, found := get_any(v, "secondary"); found { if !decode_bool(fv, &out.secondary) do return fail("TriggerDefinition.secondary") }
	if fv, found := get_any(v, "valid_target"); found { if !dec_opt_TargetFilter(fv, &out.valid_target) do return fail("TriggerDefinition.valid_target") }
	if fv, found := get_any(v, "valid_subject_player"); found { if !dec_opt_TargetFilter(fv, &out.valid_subject_player) do return fail("TriggerDefinition.valid_subject_player") }
	if fv, found := get_any(v, "valid_source"); found { if !dec_opt_TargetFilter(fv, &out.valid_source) do return fail("TriggerDefinition.valid_source") }
	if fv, found := get_any(v, "spell_cast_origin"); found { if !decode_OriginConstraint(fv, &out.spell_cast_origin) do return fail("TriggerDefinition.spell_cast_origin") } else { out.spell_cast_origin = default_TriggerDefinition_OriginConstraint_any_default() }
	if fv, found := get_any(v, "description"); found { if !dec_opt_string(fv, &out.description) do return fail("TriggerDefinition.description") }
	if fv, found := get_any(v, "constraint"); found { if !dec_opt_TriggerConstraint(fv, &out.constraint) do return fail("TriggerDefinition.constraint") }
	if fv, found := get_any(v, "limit_leader_offset"); found { if !dec_opt_int(fv, &out.limit_leader_offset) do return fail("TriggerDefinition.limit_leader_offset") }
	if fv, found := get_any(v, "condition"); found { if !dec_opt_TriggerCondition(fv, &out.condition) do return fail("TriggerDefinition.condition") }
	if fv, found := get_any(v, "attack_cost_condition"); found { if !dec_opt_StaticCondition(fv, &out.attack_cost_condition) do return fail("TriggerDefinition.attack_cost_condition") }
	if fv, found := get_any(v, "counter_filter"); found { if !dec_opt_CounterTriggerFilter(fv, &out.counter_filter) do return fail("TriggerDefinition.counter_filter") }
	if fv, found := get_any(v, "saga_chapter"); found { if !dec_opt_u32(fv, &out.saga_chapter) do return fail("TriggerDefinition.saga_chapter") }
	if fv, found := get_any(v, "unless_pay"); found { if !dec_opt_UnlessPayModifier(fv, &out.unless_pay) do return fail("TriggerDefinition.unless_pay") }
	if fv, found := get_any(v, "batched"); found { if !decode_bool(fv, &out.batched) do return fail("TriggerDefinition.batched") }
	if fv, found := get_any(v, "die_sides"); found { if !dec_opt_u8(fv, &out.die_sides) do return fail("TriggerDefinition.die_sides") }
	if fv, found := get_any(v, "gotcha_condition"); found { if !dec_opt_GotchaCondition(fv, &out.gotcha_condition) do return fail("TriggerDefinition.gotcha_condition") }
	if fv, found := get_any(v, "expend_threshold"); found { if !dec_opt_u32(fv, &out.expend_threshold) do return fail("TriggerDefinition.expend_threshold") }
	if fv, found := get_any(v, "attack_target_filter"); found { if !dec_opt_AttackTargetFilter(fv, &out.attack_target_filter) do return fail("TriggerDefinition.attack_target_filter") }
	if fv, found := get_any(v, "blocker_count"); found { if !dec_opt_BlockerCountThreshold(fv, &out.blocker_count) do return fail("TriggerDefinition.blocker_count") }
	if fv, found := get_any(v, "player_actions"); found { if !dec_opt_dyn_PlayerActionKind(fv, &out.player_actions) do return fail("TriggerDefinition.player_actions") }
	if fv, found := get_any(v, "scry_bottom_count"); found { if !dec_opt_t2_Comparator_u32(fv, &out.scry_bottom_count) do return fail("TriggerDefinition.scry_bottom_count") }
	if fv, found := get_any(v, "damage_amount"); found { if !decode_with_damage_amount_compat(fv, &out.damage_amount) do return fail("TriggerDefinition.damage_amount") }
	if fv, found := get_any(v, "life_amount"); found { if !dec_opt_t2_Comparator_u32(fv, &out.life_amount) do return fail("TriggerDefinition.life_amount") }
	if fv, found := get_any(v, "coin_flip_result"); found { if !dec_opt_CoinFlipResult(fv, &out.coin_flip_result) do return fail("TriggerDefinition.coin_flip_result") }
	if fv, found := get_any(v, "die_result"); found { if !dec_opt_DieResultFilter(fv, &out.die_result) do return fail("TriggerDefinition.die_result") }
	if fv, found := get_any(v, "taps_for_mana_produced"); found { if !dec_opt_dyn_ManaType(fv, &out.taps_for_mana_produced) do return fail("TriggerDefinition.taps_for_mana_produced") }
	if fv, found := get_any(v, "mana_ability_produced"); found { if !dec_opt_ManaAbilityProducedFilter(fv, &out.mana_ability_produced) do return fail("TriggerDefinition.mana_ability_produced") }
	if fv, found := get_any(v, "clash_result"); found { if !dec_opt_ClashResult(fv, &out.clash_result) do return fail("TriggerDefinition.clash_result") }
	if fv, found := get_any(v, "room_door"); found { if !dec_opt_RoomDoor(fv, &out.room_door) do return fail("TriggerDefinition.room_door") }
	if fv, found := get_any(v, "granting_object"); found { if !dec_opt_ObjectIncarnationRef(fv, &out.granting_object) do return fail("TriggerDefinition.granting_object") }
	return true
}

encode_TriggerDefinition :: proc(b: ^strings.Builder, x: TriggerDefinition) {
	strings.write_byte(b, '{')
	f := true
	encode_TriggerDefinition_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_TriggerDefinition_members :: proc(b: ^strings.Builder, x: TriggerDefinition, first: ^bool) {
	member(b, first, "mode"); encode_TriggerMode(b, x.mode)
	member(b, first, "execute"); enc_ptr_AbilityDefinition(b, x.execute)
	member(b, first, "valid_card"); enc_opt_TargetFilter(b, x.valid_card)
	member(b, first, "origin"); enc_opt_Zone(b, x.origin)
	if !((len(x.origin_zones) == 0)) { member(b, first, "origin_zones"); enc_dyn_Zone(b, x.origin_zones) }
	if !((len(x.zone_change_clauses) == 0)) { member(b, first, "zone_change_clauses"); enc_dyn_ZoneChangeClause(b, x.zone_change_clauses) }
	member(b, first, "destination"); enc_opt_Zone(b, x.destination)
	if !(skip_TriggerDefinition_OriginConstraint_is_any_OriginConstraint(x.destination_constraint)) { member(b, first, "destination_constraint"); encode_OriginConstraint(b, x.destination_constraint) }
	member(b, first, "trigger_zones"); enc_dyn_Zone(b, x.trigger_zones)
	member(b, first, "phase"); enc_opt_Phase(b, x.phase)
	member(b, first, "optional"); encode_bool(b, x.optional)
	member(b, first, "damage_kind"); encode_DamageKindFilter(b, x.damage_kind)
	member(b, first, "secondary"); encode_bool(b, x.secondary)
	member(b, first, "valid_target"); enc_opt_TargetFilter(b, x.valid_target)
	if !(x.valid_subject_player == nil) { member(b, first, "valid_subject_player"); enc_opt_TargetFilter(b, x.valid_subject_player) }
	member(b, first, "valid_source"); enc_opt_TargetFilter(b, x.valid_source)
	if !(skip_TriggerDefinition_OriginConstraint_is_any_OriginConstraint(x.spell_cast_origin)) { member(b, first, "spell_cast_origin"); encode_OriginConstraint(b, x.spell_cast_origin) }
	member(b, first, "description"); enc_opt_string(b, x.description)
	member(b, first, "constraint"); enc_opt_TriggerConstraint(b, x.constraint)
	if !(x.limit_leader_offset == nil) { member(b, first, "limit_leader_offset"); enc_opt_int(b, x.limit_leader_offset) }
	member(b, first, "condition"); enc_opt_TriggerCondition(b, x.condition)
	if !(x.attack_cost_condition == nil) { member(b, first, "attack_cost_condition"); enc_opt_StaticCondition(b, x.attack_cost_condition) }
	if !(x.counter_filter == nil) { member(b, first, "counter_filter"); enc_opt_CounterTriggerFilter(b, x.counter_filter) }
	if !(x.saga_chapter == nil) { member(b, first, "saga_chapter"); enc_opt_u32(b, x.saga_chapter) }
	if !(x.unless_pay == nil) { member(b, first, "unless_pay"); enc_opt_UnlessPayModifier(b, x.unless_pay) }
	member(b, first, "batched"); encode_bool(b, x.batched)
	if !(x.die_sides == nil) { member(b, first, "die_sides"); enc_opt_u8(b, x.die_sides) }
	if !(x.gotcha_condition == nil) { member(b, first, "gotcha_condition"); enc_opt_GotchaCondition(b, x.gotcha_condition) }
	if !(x.expend_threshold == nil) { member(b, first, "expend_threshold"); enc_opt_u32(b, x.expend_threshold) }
	if !(x.attack_target_filter == nil) { member(b, first, "attack_target_filter"); enc_opt_AttackTargetFilter(b, x.attack_target_filter) }
	if !(x.blocker_count == nil) { member(b, first, "blocker_count"); enc_opt_BlockerCountThreshold(b, x.blocker_count) }
	if !(x.player_actions == nil) { member(b, first, "player_actions"); enc_opt_dyn_PlayerActionKind(b, x.player_actions) }
	if !(x.scry_bottom_count == nil) { member(b, first, "scry_bottom_count"); enc_opt_t2_Comparator_u32(b, x.scry_bottom_count) }
	if !(x.damage_amount == nil) { member(b, first, "damage_amount"); encode_with_damage_amount_compat(b, x.damage_amount) }
	if !(x.life_amount == nil) { member(b, first, "life_amount"); enc_opt_t2_Comparator_u32(b, x.life_amount) }
	if !(x.coin_flip_result == nil) { member(b, first, "coin_flip_result"); enc_opt_CoinFlipResult(b, x.coin_flip_result) }
	if !(x.die_result == nil) { member(b, first, "die_result"); enc_opt_DieResultFilter(b, x.die_result) }
	if !(x.taps_for_mana_produced == nil) { member(b, first, "taps_for_mana_produced"); enc_opt_dyn_ManaType(b, x.taps_for_mana_produced) }
	if !(x.mana_ability_produced == nil) { member(b, first, "mana_ability_produced"); enc_opt_ManaAbilityProducedFilter(b, x.mana_ability_produced) }
	if !(x.clash_result == nil) { member(b, first, "clash_result"); enc_opt_ClashResult(b, x.clash_result) }
	if !(x.room_door == nil) { member(b, first, "room_door"); enc_opt_RoomDoor(b, x.room_door) }
	if !(x.granting_object == nil) { member(b, first, "granting_object"); enc_opt_ObjectIncarnationRef(b, x.granting_object) }
}

decode_StaticDefinition :: proc(v: json.Value, out: ^StaticDefinition) -> bool {
	when COVERAGE do cov_hit("StaticDefinition")
	if v.kind != .Object do return fail("StaticDefinition: not an object")
	if fv, found := get_any(v, "mode"); found { if !decode_StaticMode(fv, &out.mode) do return fail("StaticDefinition.mode") } else { return fail("StaticDefinition.mode missing") }
	if fv, found := get_any(v, "affected"); found { if !dec_opt_TargetFilter(fv, &out.affected) do return fail("StaticDefinition.affected") }
	if fv, found := get_any(v, "modifications"); found { if !dec_dyn_ContinuousModification(fv, &out.modifications) do return fail("StaticDefinition.modifications") }
	if fv, found := get_any(v, "condition"); found { if !dec_opt_StaticCondition(fv, &out.condition) do return fail("StaticDefinition.condition") }
	if fv, found := get_any(v, "per_player_condition"); found { if !dec_opt_ParsedCondition(fv, &out.per_player_condition) do return fail("StaticDefinition.per_player_condition") }
	if fv, found := get_any(v, "affected_zone"); found { if !dec_opt_Zone(fv, &out.affected_zone) do return fail("StaticDefinition.affected_zone") }
	if fv, found := get_any(v, "effect_zone"); found { if !dec_opt_Zone(fv, &out.effect_zone) do return fail("StaticDefinition.effect_zone") }
	if fv, found := get_any(v, "active_zones"); found { if !dec_dyn_Zone(fv, &out.active_zones) do return fail("StaticDefinition.active_zones") }
	if fv, found := get_any(v, "characteristic_defining"); found { if !decode_bool(fv, &out.characteristic_defining) do return fail("StaticDefinition.characteristic_defining") }
	if fv, found := get_any(v, "description"); found { if !dec_opt_string(fv, &out.description) do return fail("StaticDefinition.description") }
	if fv, found := get_any(v, "attack_defended"); found { if !dec_opt_AttackTargetFilter(fv, &out.attack_defended) do return fail("StaticDefinition.attack_defended") }
	if fv, found := get_any(v, "source_controller"); found { if !dec_opt_PlayerId(fv, &out.source_controller) do return fail("StaticDefinition.source_controller") }
	if fv, found := get_any(v, "source_object"); found { if !dec_opt_ObjectId(fv, &out.source_object) do return fail("StaticDefinition.source_object") }
	if fv, found := get_any(v, "bypass_beneficiary"); found { if !dec_opt_ControllerRef(fv, &out.bypass_beneficiary) do return fail("StaticDefinition.bypass_beneficiary") }
	if fv, found := get_any(v, "protection_does_not_remove"); found { if !dec_opt_ProtectionDoesNotRemove(fv, &out.protection_does_not_remove) do return fail("StaticDefinition.protection_does_not_remove") }
	if fv, found := get_any(v, "room_door"); found { if !dec_opt_RoomDoor(fv, &out.room_door) do return fail("StaticDefinition.room_door") }
	if fv, found := get_any(v, "granting_object"); found { if !dec_opt_ObjectIncarnationRef(fv, &out.granting_object) do return fail("StaticDefinition.granting_object") }
	if fv, found := get_any(v, "bound_actor"); found { if !dec_opt_ControllerRef(fv, &out.bound_actor) do return fail("StaticDefinition.bound_actor") }
	return true
}

encode_StaticDefinition :: proc(b: ^strings.Builder, x: StaticDefinition) {
	strings.write_byte(b, '{')
	f := true
	encode_StaticDefinition_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_StaticDefinition_members :: proc(b: ^strings.Builder, x: StaticDefinition, first: ^bool) {
	member(b, first, "mode"); encode_StaticMode(b, x.mode)
	member(b, first, "affected"); enc_opt_TargetFilter(b, x.affected)
	member(b, first, "modifications"); enc_dyn_ContinuousModification(b, x.modifications)
	member(b, first, "condition"); enc_opt_StaticCondition(b, x.condition)
	if !(x.per_player_condition == nil) { member(b, first, "per_player_condition"); enc_opt_ParsedCondition(b, x.per_player_condition) }
	member(b, first, "affected_zone"); enc_opt_Zone(b, x.affected_zone)
	member(b, first, "effect_zone"); enc_opt_Zone(b, x.effect_zone)
	member(b, first, "active_zones"); enc_dyn_Zone(b, x.active_zones)
	member(b, first, "characteristic_defining"); encode_bool(b, x.characteristic_defining)
	member(b, first, "description"); enc_opt_string(b, x.description)
	if !(x.attack_defended == nil) { member(b, first, "attack_defended"); enc_opt_AttackTargetFilter(b, x.attack_defended) }
	if !(x.source_controller == nil) { member(b, first, "source_controller"); enc_opt_PlayerId(b, x.source_controller) }
	if !(x.source_object == nil) { member(b, first, "source_object"); enc_opt_ObjectId(b, x.source_object) }
	if !(x.bypass_beneficiary == nil) { member(b, first, "bypass_beneficiary"); enc_opt_ControllerRef(b, x.bypass_beneficiary) }
	if !(x.protection_does_not_remove == nil) { member(b, first, "protection_does_not_remove"); enc_opt_ProtectionDoesNotRemove(b, x.protection_does_not_remove) }
	if !(x.room_door == nil) { member(b, first, "room_door"); enc_opt_RoomDoor(b, x.room_door) }
	if !(x.granting_object == nil) { member(b, first, "granting_object"); enc_opt_ObjectIncarnationRef(b, x.granting_object) }
	if !(x.bound_actor == nil) { member(b, first, "bound_actor"); enc_opt_ControllerRef(b, x.bound_actor) }
}

decode_ReplacementDefinition :: proc(v: json.Value, out: ^ReplacementDefinition) -> bool {
	when COVERAGE do cov_hit("ReplacementDefinition")
	if v.kind != .Object do return fail("ReplacementDefinition: not an object")
	if fv, found := get_any(v, "event"); found { if !decode_ReplacementEvent(fv, &out.event) do return fail("ReplacementDefinition.event") } else { return fail("ReplacementDefinition.event missing") }
	if fv, found := get_any(v, "execute"); found { if !dec_ptr_AbilityDefinition(fv, &out.execute) do return fail("ReplacementDefinition.execute") }
	if fv, found := get_any(v, "runtime_execute"); found { if !dec_opt_ReplacementContinuationId(fv, &out.runtime_execute) do return fail("ReplacementDefinition.runtime_execute") }
	if fv, found := get_any(v, "mode"); found { if !decode_ReplacementMode(fv, &out.mode) do return fail("ReplacementDefinition.mode") } else { out.mode = ReplacementMode(ReplacementMode_Mandatory{}) }
	if fv, found := get_any(v, "choice_authority"); found { if !decode_ReplacementChoiceAuthority(fv, &out.choice_authority) do return fail("ReplacementDefinition.choice_authority") }
	if fv, found := get_any(v, "valid_card"); found { if !dec_opt_TargetFilter(fv, &out.valid_card) do return fail("ReplacementDefinition.valid_card") }
	if fv, found := get_any(v, "triggering_spell"); found { if !dec_opt_ObjectIncarnationRef(fv, &out.triggering_spell) do return fail("ReplacementDefinition.triggering_spell") }
	if fv, found := get_any(v, "description"); found { if !dec_opt_string(fv, &out.description) do return fail("ReplacementDefinition.description") }
	if fv, found := get_any(v, "condition"); found { if !dec_opt_ReplacementCondition(fv, &out.condition) do return fail("ReplacementDefinition.condition") }
	if fv, found := get_any(v, "destination_zone"); found { if !dec_opt_Zone(fv, &out.destination_zone) do return fail("ReplacementDefinition.destination_zone") }
	if fv, found := get_any(v, "active_zones"); found { if !dec_dyn_Zone(fv, &out.active_zones) do return fail("ReplacementDefinition.active_zones") }
	if fv, found := get_any(v, "damage_modification"); found { if !dec_opt_DamageModification(fv, &out.damage_modification) do return fail("ReplacementDefinition.damage_modification") }
	if fv, found := get_any(v, "damage_source_filter"); found { if !dec_opt_TargetFilter(fv, &out.damage_source_filter) do return fail("ReplacementDefinition.damage_source_filter") }
	if fv, found := get_any(v, "damage_target_filter"); found { if !dec_opt_DamageTargetFilter(fv, &out.damage_target_filter) do return fail("ReplacementDefinition.damage_target_filter") }
	if fv, found := get_any(v, "target_recipient_incarnation"); found { if !dec_opt_u64(fv, &out.target_recipient_incarnation) do return fail("ReplacementDefinition.target_recipient_incarnation") }
	if fv, found := get_any(v, "combat_scope"); found { if !dec_opt_CombatDamageScope(fv, &out.combat_scope) do return fail("ReplacementDefinition.combat_scope") }
	if fv, found := get_any(v, "draw_scope"); found { if !dec_opt_DrawReplacementScope(fv, &out.draw_scope) do return fail("ReplacementDefinition.draw_scope") }
	if fv, found := get_any(v, "die_ignore_rule"); found { if !dec_opt_DieRollIgnoreRule(fv, &out.die_ignore_rule) do return fail("ReplacementDefinition.die_ignore_rule") }
	if fv, found := get_any(v, "planeswalk_scope"); found { if !dec_opt_PlaneswalkReplacementScope(fv, &out.planeswalk_scope) do return fail("ReplacementDefinition.planeswalk_scope") }
	if fv, found := get_any(v, "shield_kind"); found { if !decode_ShieldKind(fv, &out.shield_kind) do return fail("ReplacementDefinition.shield_kind") } else { out.shield_kind = ShieldKind(ShieldKind_None{}) }
	if fv, found := get_any(v, "quantity_modification"); found { if !dec_opt_QuantityModification(fv, &out.quantity_modification) do return fail("ReplacementDefinition.quantity_modification") }
	if fv, found := get_any(v, "token_owner_scope"); found { if !dec_opt_ControllerRef(fv, &out.token_owner_scope) do return fail("ReplacementDefinition.token_owner_scope") }
	if fv, found := get_any(v, "token_owner_redirect"); found { if !dec_opt_ControllerRef(fv, &out.token_owner_redirect) do return fail("ReplacementDefinition.token_owner_redirect") }
	if fv, found := get_any(v, "valid_player"); found { if !dec_opt_ReplacementPlayerScope(fv, &out.valid_player) do return fail("ReplacementDefinition.valid_player") }
	if fv, found := get_any(v, "consume_on_apply"); found { if !decode_bool(fv, &out.consume_on_apply) do return fail("ReplacementDefinition.consume_on_apply") }
	if fv, found := get_any(v, "is_consumed"); found { if !decode_bool(fv, &out.is_consumed) do return fail("ReplacementDefinition.is_consumed") }
	if fv, found := get_any(v, "expiry"); found { if !dec_opt_RestrictionExpiry(fv, &out.expiry) do return fail("ReplacementDefinition.expiry") }
	if fv, found := get_any(v, "redirect_target"); found { if !dec_opt_TargetFilter(fv, &out.redirect_target) do return fail("ReplacementDefinition.redirect_target") }
	if fv, found := get_any(v, "mana_modification"); found { if !dec_opt_ManaModification(fv, &out.mana_modification) do return fail("ReplacementDefinition.mana_modification") }
	if fv, found := get_any(v, "mana_replacement_scope"); found { if !decode_ManaReplacementScope(fv, &out.mana_replacement_scope) do return fail("ReplacementDefinition.mana_replacement_scope") }
	if fv, found := get_any(v, "additional_token_spec"); found { if !dec_ptr_TokenSpec(fv, &out.additional_token_spec) do return fail("ReplacementDefinition.additional_token_spec") }
	if fv, found := get_any(v, "ensure_token_specs"); found { if !dec_opt_dyn_TokenSpec(fv, &out.ensure_token_specs) do return fail("ReplacementDefinition.ensure_token_specs") }
	if fv, found := get_any(v, "counter_match"); found { if !dec_opt_CounterMatch(fv, &out.counter_match) do return fail("ReplacementDefinition.counter_match") }
	if fv, found := get_any(v, "enters_under"); found { if !dec_opt_ControllerRef(fv, &out.enters_under) do return fail("ReplacementDefinition.enters_under") }
	if fv, found := get_any(v, "source_controller"); found { if !dec_opt_PlayerId(fv, &out.source_controller) do return fail("ReplacementDefinition.source_controller") }
	if fv, found := get_any(v, "source_object"); found { if !dec_opt_ObjectId(fv, &out.source_object) do return fail("ReplacementDefinition.source_object") }
	if fv, found := get_any(v, "origin"); found { if !decode_ReplacementOrigin(fv, &out.origin) do return fail("ReplacementDefinition.origin") }
	if fv, found := get_any(v, "counter_replacement_subject"); found { if !decode_CounterReplacementSubject(fv, &out.counter_replacement_subject) do return fail("ReplacementDefinition.counter_replacement_subject") }
	if fv, found := get_any(v, "granting_object"); found { if !dec_opt_ObjectIncarnationRef(fv, &out.granting_object) do return fail("ReplacementDefinition.granting_object") }
	if fv, found := get_any(v, "entry_payment_max"); found { if !dec_opt_QuantityExpr(fv, &out.entry_payment_max) do return fail("ReplacementDefinition.entry_payment_max") }
	return true
}

encode_ReplacementDefinition :: proc(b: ^strings.Builder, x: ReplacementDefinition) {
	strings.write_byte(b, '{')
	f := true
	encode_ReplacementDefinition_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ReplacementDefinition_members :: proc(b: ^strings.Builder, x: ReplacementDefinition, first: ^bool) {
	member(b, first, "event"); encode_ReplacementEvent(b, x.event)
	member(b, first, "execute"); enc_ptr_AbilityDefinition(b, x.execute)
	if !(x.runtime_execute == nil) { member(b, first, "runtime_execute"); enc_opt_ReplacementContinuationId(b, x.runtime_execute) }
	member(b, first, "mode"); encode_ReplacementMode(b, x.mode)
	if !(skip_ReplacementDefinition_ReplacementChoiceAuthority_is_affected_player_ReplacementChoiceAuthority(x.choice_authority)) { member(b, first, "choice_authority"); encode_ReplacementChoiceAuthority(b, x.choice_authority) }
	member(b, first, "valid_card"); enc_opt_TargetFilter(b, x.valid_card)
	if !(x.triggering_spell == nil) { member(b, first, "triggering_spell"); enc_opt_ObjectIncarnationRef(b, x.triggering_spell) }
	member(b, first, "description"); enc_opt_string(b, x.description)
	member(b, first, "condition"); enc_opt_ReplacementCondition(b, x.condition)
	if !(x.destination_zone == nil) { member(b, first, "destination_zone"); enc_opt_Zone(b, x.destination_zone) }
	if !((len(x.active_zones) == 0)) { member(b, first, "active_zones"); enc_dyn_Zone(b, x.active_zones) }
	if !(x.damage_modification == nil) { member(b, first, "damage_modification"); enc_opt_DamageModification(b, x.damage_modification) }
	if !(x.damage_source_filter == nil) { member(b, first, "damage_source_filter"); enc_opt_TargetFilter(b, x.damage_source_filter) }
	if !(x.damage_target_filter == nil) { member(b, first, "damage_target_filter"); enc_opt_DamageTargetFilter(b, x.damage_target_filter) }
	if !(x.target_recipient_incarnation == nil) { member(b, first, "target_recipient_incarnation"); enc_opt_u64(b, x.target_recipient_incarnation) }
	if !(x.combat_scope == nil) { member(b, first, "combat_scope"); enc_opt_CombatDamageScope(b, x.combat_scope) }
	if !(x.draw_scope == nil) { member(b, first, "draw_scope"); enc_opt_DrawReplacementScope(b, x.draw_scope) }
	if !(x.die_ignore_rule == nil) { member(b, first, "die_ignore_rule"); enc_opt_DieRollIgnoreRule(b, x.die_ignore_rule) }
	if !(x.planeswalk_scope == nil) { member(b, first, "planeswalk_scope"); enc_opt_PlaneswalkReplacementScope(b, x.planeswalk_scope) }
	if !(skip_ReplacementDefinition_ShieldKind_is_none_ShieldKind(x.shield_kind)) { member(b, first, "shield_kind"); encode_ShieldKind(b, x.shield_kind) }
	if !(x.quantity_modification == nil) { member(b, first, "quantity_modification"); enc_opt_QuantityModification(b, x.quantity_modification) }
	if !(x.token_owner_scope == nil) { member(b, first, "token_owner_scope"); enc_opt_ControllerRef(b, x.token_owner_scope) }
	if !(x.token_owner_redirect == nil) { member(b, first, "token_owner_redirect"); enc_opt_ControllerRef(b, x.token_owner_redirect) }
	if !(x.valid_player == nil) { member(b, first, "valid_player"); enc_opt_ReplacementPlayerScope(b, x.valid_player) }
	if !(!x.consume_on_apply) { member(b, first, "consume_on_apply"); encode_bool(b, x.consume_on_apply) }
	if !(!x.is_consumed) { member(b, first, "is_consumed"); encode_bool(b, x.is_consumed) }
	if !(x.expiry == nil) { member(b, first, "expiry"); enc_opt_RestrictionExpiry(b, x.expiry) }
	if !(x.redirect_target == nil) { member(b, first, "redirect_target"); enc_opt_TargetFilter(b, x.redirect_target) }
	if !(x.mana_modification == nil) { member(b, first, "mana_modification"); enc_opt_ManaModification(b, x.mana_modification) }
	if !(skip_ReplacementDefinition_ManaReplacementScope_is_any_ManaReplacementScope(x.mana_replacement_scope)) { member(b, first, "mana_replacement_scope"); encode_ManaReplacementScope(b, x.mana_replacement_scope) }
	if !(x.additional_token_spec == nil) { member(b, first, "additional_token_spec"); enc_ptr_TokenSpec(b, x.additional_token_spec) }
	if !(x.ensure_token_specs == nil) { member(b, first, "ensure_token_specs"); enc_opt_dyn_TokenSpec(b, x.ensure_token_specs) }
	if !(x.counter_match == nil) { member(b, first, "counter_match"); enc_opt_CounterMatch(b, x.counter_match) }
	if !(x.enters_under == nil) { member(b, first, "enters_under"); enc_opt_ControllerRef(b, x.enters_under) }
	if !(x.source_controller == nil) { member(b, first, "source_controller"); enc_opt_PlayerId(b, x.source_controller) }
	if !(x.source_object == nil) { member(b, first, "source_object"); enc_opt_ObjectId(b, x.source_object) }
	if !(skip_ReplacementDefinition_ReplacementOrigin_is_characteristic_ReplacementOrigin(x.origin)) { member(b, first, "origin"); encode_ReplacementOrigin(b, x.origin) }
	if !(skip_ReplacementDefinition_CounterReplacementSubject_is_default_CounterReplacementSubject(x.counter_replacement_subject)) { member(b, first, "counter_replacement_subject"); encode_CounterReplacementSubject(b, x.counter_replacement_subject) }
	if !(x.granting_object == nil) { member(b, first, "granting_object"); enc_opt_ObjectIncarnationRef(b, x.granting_object) }
	if !(x.entry_payment_max == nil) { member(b, first, "entry_payment_max"); enc_opt_QuantityExpr(b, x.entry_payment_max) }
}

decode_CleaveVariant :: proc(v: json.Value, out: ^CleaveVariant) -> bool {
	when COVERAGE do cov_hit("CleaveVariant")
	if v.kind != .Object do return fail("CleaveVariant: not an object")
	if fv, found := get_any(v, "abilities"); found { if !dec_dyn_AbilityDefinition(fv, &out.abilities) do return fail("CleaveVariant.abilities") } else { return fail("CleaveVariant.abilities missing") }
	if fv, found := get_any(v, "triggers"); found { if !dec_dyn_TriggerDefinition(fv, &out.triggers) do return fail("CleaveVariant.triggers") } else { return fail("CleaveVariant.triggers missing") }
	if fv, found := get_any(v, "static_abilities"); found { if !dec_dyn_StaticDefinition(fv, &out.static_abilities) do return fail("CleaveVariant.static_abilities") } else { return fail("CleaveVariant.static_abilities missing") }
	if fv, found := get_any(v, "replacements"); found { if !dec_dyn_ReplacementDefinition(fv, &out.replacements) do return fail("CleaveVariant.replacements") } else { return fail("CleaveVariant.replacements missing") }
	return true
}

encode_CleaveVariant :: proc(b: ^strings.Builder, x: CleaveVariant) {
	strings.write_byte(b, '{')
	f := true
	encode_CleaveVariant_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CleaveVariant_members :: proc(b: ^strings.Builder, x: CleaveVariant, first: ^bool) {
	member(b, first, "abilities"); enc_dyn_AbilityDefinition(b, x.abilities)
	member(b, first, "triggers"); enc_dyn_TriggerDefinition(b, x.triggers)
	member(b, first, "static_abilities"); enc_dyn_StaticDefinition(b, x.static_abilities)
	member(b, first, "replacements"); enc_dyn_ReplacementDefinition(b, x.replacements)
}

decode_ManaColor :: proc(v: json.Value, out: ^ManaColor) -> bool {
	when COVERAGE do cov_hit("ManaColor")
	if v.kind != .String do return fail("ManaColor: not a string")
	str := v.text
	switch str {
	case "White": when COVERAGE do cov_hit("ManaColor::White"); out^ = .White
	case "Blue": when COVERAGE do cov_hit("ManaColor::Blue"); out^ = .Blue
	case "Black": when COVERAGE do cov_hit("ManaColor::Black"); out^ = .Black
	case "Red": when COVERAGE do cov_hit("ManaColor::Red"); out^ = .Red
	case "Green": when COVERAGE do cov_hit("ManaColor::Green"); out^ = .Green
	case: return fail("ManaColor: unknown variant")
	}
	return true
}

encode_ManaColor :: proc(b: ^strings.Builder, x: ManaColor) {
	@(static, rodata) NAMES := [ManaColor]string{
		.White = "White",
		.Blue = "Blue",
		.Black = "Black",
		.Red = "Red",
		.Green = "Green",
	}
	json.write_string(b, NAMES[x])
}

decode_ModalChoice :: proc(v: json.Value, out: ^ModalChoice) -> bool {
	when COVERAGE do cov_hit("ModalChoice")
	if v.kind != .Object do return fail("ModalChoice: not an object")
	if fv, found := get_any(v, "min_choices"); found { if !decode_int(fv, &out.min_choices) do return fail("ModalChoice.min_choices") } else { return fail("ModalChoice.min_choices missing") }
	if fv, found := get_any(v, "max_choices"); found { if !decode_int(fv, &out.max_choices) do return fail("ModalChoice.max_choices") } else { return fail("ModalChoice.max_choices missing") }
	if fv, found := get_any(v, "mode_count"); found { if !decode_int(fv, &out.mode_count) do return fail("ModalChoice.mode_count") } else { return fail("ModalChoice.mode_count missing") }
	if fv, found := get_any(v, "mode_descriptions"); found { if !dec_dyn_string(fv, &out.mode_descriptions) do return fail("ModalChoice.mode_descriptions") }
	if fv, found := get_any(v, "allow_repeat_modes"); found { if !decode_bool(fv, &out.allow_repeat_modes) do return fail("ModalChoice.allow_repeat_modes") }
	if fv, found := get_any(v, "constraints"); found { if !dec_dyn_ModalSelectionConstraint(fv, &out.constraints) do return fail("ModalChoice.constraints") }
	if fv, found := get_any(v, "mode_costs"); found { if !dec_dyn_ManaCost(fv, &out.mode_costs) do return fail("ModalChoice.mode_costs") }
	if fv, found := get_any(v, "mode_pawprints"); found { if !dec_dyn_u8(fv, &out.mode_pawprints) do return fail("ModalChoice.mode_pawprints") }
	if fv, found := get_any(v, "entwine_cost"); found { if !dec_ptr_AbilityCost(fv, &out.entwine_cost) do return fail("ModalChoice.entwine_cost") }
	if fv, found := get_any(v, "chooser"); found { if !decode_PlayerFilter(fv, &out.chooser) do return fail("ModalChoice.chooser") } else { out.chooser = default_ModalChoice_default_player_filter_controller() }
	if fv, found := get_any(v, "selection"); found { if !decode_TargetSelectionMode(fv, &out.selection) do return fail("ModalChoice.selection") }
	if fv, found := get_any(v, "dynamic_max_choices"); found { if !dec_opt_QuantityExpr(fv, &out.dynamic_max_choices) do return fail("ModalChoice.dynamic_max_choices") }
	return true
}

encode_ModalChoice :: proc(b: ^strings.Builder, x: ModalChoice) {
	strings.write_byte(b, '{')
	f := true
	encode_ModalChoice_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ModalChoice_members :: proc(b: ^strings.Builder, x: ModalChoice, first: ^bool) {
	member(b, first, "min_choices"); encode_int(b, x.min_choices)
	member(b, first, "max_choices"); encode_int(b, x.max_choices)
	member(b, first, "mode_count"); encode_int(b, x.mode_count)
	member(b, first, "mode_descriptions"); enc_dyn_string(b, x.mode_descriptions)
	member(b, first, "allow_repeat_modes"); encode_bool(b, x.allow_repeat_modes)
	if !((len(x.constraints) == 0)) { member(b, first, "constraints"); enc_dyn_ModalSelectionConstraint(b, x.constraints) }
	if !((len(x.mode_costs) == 0)) { member(b, first, "mode_costs"); enc_dyn_ManaCost(b, x.mode_costs) }
	if !((len(x.mode_pawprints) == 0)) { member(b, first, "mode_pawprints"); enc_dyn_u8(b, x.mode_pawprints) }
	if !(x.entwine_cost == nil) { member(b, first, "entwine_cost"); enc_ptr_AbilityCost(b, x.entwine_cost) }
	member(b, first, "chooser"); encode_PlayerFilter(b, x.chooser)
	if !(skip_ModalChoice_TargetSelectionMode_is_chosen_TargetSelectionMode(x.selection)) { member(b, first, "selection"); encode_TargetSelectionMode(b, x.selection) }
	if !(x.dynamic_max_choices == nil) { member(b, first, "dynamic_max_choices"); enc_opt_QuantityExpr(b, x.dynamic_max_choices) }
}

decode_AdditionalCost :: proc(v: json.Value, out: ^AdditionalCost) -> bool {
	when COVERAGE do cov_hit("AdditionalCost")
	if v.kind != .Object do return fail("AdditionalCost: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("AdditionalCost: no tag")
	switch tv.text {
	case "Optional": when COVERAGE do cov_hit("AdditionalCost::Optional");
		tmp: AdditionalCost_Optional
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^AdditionalCost_Optional) -> bool {
	if fv, found := get_any(v, "cost"); found { if !decode_AbilityCost(fv, &out.cost) do return fail("AdditionalCost::Optional.cost") } else { return fail("AdditionalCost::Optional.cost missing") }
	if fv, found := get_any(v, "repeatable"); found { if !decode_with_additional_cost_repeatability_bool_compat(fv, &out.repeatability) do return fail("AdditionalCost::Optional.repeatability") }
	return true
		}) { return fail("AdditionalCost::Optional") }
		out^ = tmp
	case "Kicker": when COVERAGE do cov_hit("AdditionalCost::Kicker");
		tmp: AdditionalCost_Kicker
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^AdditionalCost_Kicker) -> bool {
	if fv, found := get_any(v, "costs"); found { if !dec_dyn_AbilityCost(fv, &out.costs) do return fail("AdditionalCost::Kicker.costs") } else { return fail("AdditionalCost::Kicker.costs missing") }
	if fv, found := get_any(v, "repeatable"); found { if !decode_with_additional_cost_repeatability_bool_compat(fv, &out.repeatability) do return fail("AdditionalCost::Kicker.repeatability") }
	return true
		}) { return fail("AdditionalCost::Kicker") }
		out^ = tmp
	case "Choice": when COVERAGE do cov_hit("AdditionalCost::Choice"); tmp: AdditionalCost_Choice; if !dec_dyn_AbilityCost(json.get_or_null(v, "data"), &tmp._0) do return fail("AdditionalCost::Choice"); out^ = tmp
	case "Required": when COVERAGE do cov_hit("AdditionalCost::Required"); tmp: AdditionalCost_Required; if !decode_AbilityCost(json.get_or_null(v, "data"), &tmp._0) do return fail("AdditionalCost::Required"); out^ = tmp
	case: return fail("AdditionalCost: unknown variant")
	}
	return true
}

encode_AdditionalCost :: proc(b: ^strings.Builder, x: AdditionalCost) {
	#partial switch y in x {
	case AdditionalCost_Optional: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Optional"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "cost"); encode_AbilityCost(b, y.cost)
	if !(skip_AdditionalCost_AdditionalCostRepeatability_is_once_AdditionalCostRepeatability(y.repeatability)) { member(b, first, "repeatable"); encode_with_additional_cost_repeatability_bool_compat(b, y.repeatability) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case AdditionalCost_Kicker: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Kicker"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "costs"); enc_dyn_AbilityCost(b, y.costs)
	if !(skip_AdditionalCost_AdditionalCostRepeatability_is_once_AdditionalCostRepeatability(y.repeatability)) { member(b, first, "repeatable"); encode_with_additional_cost_repeatability_bool_compat(b, y.repeatability) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case AdditionalCost_Choice: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Choice"); member(b, &f, "data"); enc_dyn_AbilityCost(b, y._0); strings.write_byte(b, '}')
	case AdditionalCost_Required: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Required"); member(b, &f, "data"); encode_AbilityCost(b, y._0); strings.write_byte(b, '}')
	}
}

decode_CastingRestriction :: proc(v: json.Value, out: ^CastingRestriction) -> bool {
	when COVERAGE do cov_hit("CastingRestriction")
	if v.kind != .Object do return fail("CastingRestriction: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("CastingRestriction: no tag")
	switch tv.text {
	case "AsSorcery": when COVERAGE do cov_hit("CastingRestriction::AsSorcery"); out^ = CastingRestriction_AsSorcery{}
	case "DuringCombat": when COVERAGE do cov_hit("CastingRestriction::DuringCombat"); out^ = CastingRestriction_DuringCombat{}
	case "DuringOpponentsTurn": when COVERAGE do cov_hit("CastingRestriction::DuringOpponentsTurn"); out^ = CastingRestriction_DuringOpponentsTurn{}
	case "DuringYourTurn": when COVERAGE do cov_hit("CastingRestriction::DuringYourTurn"); out^ = CastingRestriction_DuringYourTurn{}
	case "DuringYourUpkeep": when COVERAGE do cov_hit("CastingRestriction::DuringYourUpkeep"); out^ = CastingRestriction_DuringYourUpkeep{}
	case "DuringOpponentsUpkeep": when COVERAGE do cov_hit("CastingRestriction::DuringOpponentsUpkeep"); out^ = CastingRestriction_DuringOpponentsUpkeep{}
	case "DuringAnyUpkeep": when COVERAGE do cov_hit("CastingRestriction::DuringAnyUpkeep"); out^ = CastingRestriction_DuringAnyUpkeep{}
	case "DuringYourEndStep": when COVERAGE do cov_hit("CastingRestriction::DuringYourEndStep"); out^ = CastingRestriction_DuringYourEndStep{}
	case "DuringOpponentsEndStep": when COVERAGE do cov_hit("CastingRestriction::DuringOpponentsEndStep"); out^ = CastingRestriction_DuringOpponentsEndStep{}
	case "DeclareAttackersStep": when COVERAGE do cov_hit("CastingRestriction::DeclareAttackersStep"); out^ = CastingRestriction_DeclareAttackersStep{}
	case "DeclareBlockersStep": when COVERAGE do cov_hit("CastingRestriction::DeclareBlockersStep"); out^ = CastingRestriction_DeclareBlockersStep{}
	case "BeforeAttackersDeclared": when COVERAGE do cov_hit("CastingRestriction::BeforeAttackersDeclared"); out^ = CastingRestriction_BeforeAttackersDeclared{}
	case "BeforeBlockersDeclared": when COVERAGE do cov_hit("CastingRestriction::BeforeBlockersDeclared"); out^ = CastingRestriction_BeforeBlockersDeclared{}
	case "AfterBlockersDeclared": when COVERAGE do cov_hit("CastingRestriction::AfterBlockersDeclared"); out^ = CastingRestriction_AfterBlockersDeclared{}
	case "BeforeCombatDamage": when COVERAGE do cov_hit("CastingRestriction::BeforeCombatDamage"); out^ = CastingRestriction_BeforeCombatDamage{}
	case "AfterCombat": when COVERAGE do cov_hit("CastingRestriction::AfterCombat"); out^ = CastingRestriction_AfterCombat{}
	case "RequiresCondition": when COVERAGE do cov_hit("CastingRestriction::RequiresCondition");
		tmp: CastingRestriction_RequiresCondition
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^CastingRestriction_RequiresCondition) -> bool {
	if fv, found := get_any(v, "condition"); found { if !dec_opt_ParsedCondition(fv, &out.condition) do return fail("CastingRestriction::RequiresCondition.condition") }
	return true
		}) { return fail("CastingRestriction::RequiresCondition") }
		out^ = tmp
	case "CantSpendMana": when COVERAGE do cov_hit("CastingRestriction::CantSpendMana"); out^ = CastingRestriction_CantSpendMana{}
	case "SpendOnlyOnX": when COVERAGE do cov_hit("CastingRestriction::SpendOnlyOnX");
		tmp: CastingRestriction_SpendOnlyOnX
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^CastingRestriction_SpendOnlyOnX) -> bool {
	if fv, found := get_any(v, "colors"); found { if !dec_dyn_ManaColor(fv, &out.colors) do return fail("CastingRestriction::SpendOnlyOnX.colors") } else { return fail("CastingRestriction::SpendOnlyOnX.colors missing") }
	return true
		}) { return fail("CastingRestriction::SpendOnlyOnX") }
		out^ = tmp
	case "OnlyFromZones": when COVERAGE do cov_hit("CastingRestriction::OnlyFromZones");
		tmp: CastingRestriction_OnlyFromZones
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^CastingRestriction_OnlyFromZones) -> bool {
	if fv, found := get_any(v, "zones"); found { if !dec_dyn_Zone(fv, &out.zones) do return fail("CastingRestriction::OnlyFromZones.zones") } else { return fail("CastingRestriction::OnlyFromZones.zones missing") }
	if fv, found := get_any(v, "pool"); found { if !decode_GraveyardPermissionPool(fv, &out.pool) do return fail("CastingRestriction::OnlyFromZones.pool") }
	return true
		}) { return fail("CastingRestriction::OnlyFromZones") }
		out^ = tmp
	case: return fail("CastingRestriction: unknown variant")
	}
	return true
}

encode_CastingRestriction :: proc(b: ^strings.Builder, x: CastingRestriction) {
	#partial switch y in x {
	case CastingRestriction_AsSorcery: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AsSorcery"); strings.write_byte(b, '}')
	case CastingRestriction_DuringCombat: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DuringCombat"); strings.write_byte(b, '}')
	case CastingRestriction_DuringOpponentsTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DuringOpponentsTurn"); strings.write_byte(b, '}')
	case CastingRestriction_DuringYourTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DuringYourTurn"); strings.write_byte(b, '}')
	case CastingRestriction_DuringYourUpkeep: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DuringYourUpkeep"); strings.write_byte(b, '}')
	case CastingRestriction_DuringOpponentsUpkeep: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DuringOpponentsUpkeep"); strings.write_byte(b, '}')
	case CastingRestriction_DuringAnyUpkeep: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DuringAnyUpkeep"); strings.write_byte(b, '}')
	case CastingRestriction_DuringYourEndStep: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DuringYourEndStep"); strings.write_byte(b, '}')
	case CastingRestriction_DuringOpponentsEndStep: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DuringOpponentsEndStep"); strings.write_byte(b, '}')
	case CastingRestriction_DeclareAttackersStep: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DeclareAttackersStep"); strings.write_byte(b, '}')
	case CastingRestriction_DeclareBlockersStep: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DeclareBlockersStep"); strings.write_byte(b, '}')
	case CastingRestriction_BeforeAttackersDeclared: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BeforeAttackersDeclared"); strings.write_byte(b, '}')
	case CastingRestriction_BeforeBlockersDeclared: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BeforeBlockersDeclared"); strings.write_byte(b, '}')
	case CastingRestriction_AfterBlockersDeclared: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AfterBlockersDeclared"); strings.write_byte(b, '}')
	case CastingRestriction_BeforeCombatDamage: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BeforeCombatDamage"); strings.write_byte(b, '}')
	case CastingRestriction_AfterCombat: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AfterCombat"); strings.write_byte(b, '}')
	case CastingRestriction_RequiresCondition: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RequiresCondition"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "condition"); enc_opt_ParsedCondition(b, y.condition)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case CastingRestriction_CantSpendMana: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CantSpendMana"); strings.write_byte(b, '}')
	case CastingRestriction_SpendOnlyOnX: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SpendOnlyOnX"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "colors"); enc_dyn_ManaColor(b, y.colors)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case CastingRestriction_OnlyFromZones: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OnlyFromZones"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "zones"); enc_dyn_Zone(b, y.zones)
	member(b, first, "pool"); encode_GraveyardPermissionPool(b, y.pool)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_SpellCastingOption :: proc(v: json.Value, out: ^SpellCastingOption) -> bool {
	when COVERAGE do cov_hit("SpellCastingOption")
	if v.kind != .Object do return fail("SpellCastingOption: not an object")
	if fv, found := get_any(v, "kind"); found { if !decode_SpellCastingOptionKind(fv, &out.kind) do return fail("SpellCastingOption.kind") } else { return fail("SpellCastingOption.kind missing") }
	if fv, found := get_any(v, "cost"); found { if !dec_opt_AbilityCost(fv, &out.cost) do return fail("SpellCastingOption.cost") }
	if fv, found := get_any(v, "condition"); found { if !dec_opt_ParsedCondition(fv, &out.condition) do return fail("SpellCastingOption.condition") }
	return true
}

encode_SpellCastingOption :: proc(b: ^strings.Builder, x: SpellCastingOption) {
	strings.write_byte(b, '{')
	f := true
	encode_SpellCastingOption_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_SpellCastingOption_members :: proc(b: ^strings.Builder, x: SpellCastingOption, first: ^bool) {
	member(b, first, "kind"); encode_SpellCastingOptionKind(b, x.kind)
	if !(x.cost == nil) { member(b, first, "cost"); enc_opt_AbilityCost(b, x.cost) }
	if !(x.condition == nil) { member(b, first, "condition"); enc_opt_ParsedCondition(b, x.condition) }
}

decode_SolveCondition :: proc(v: json.Value, out: ^SolveCondition) -> bool {
	when COVERAGE do cov_hit("SolveCondition")
	if v.kind != .Object do return fail("SolveCondition: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("SolveCondition: no tag")
	switch tv.text {
	case "ObjectCount": when COVERAGE do cov_hit("SolveCondition::ObjectCount");
		tmp: SolveCondition_ObjectCount
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^SolveCondition_ObjectCount) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("SolveCondition::ObjectCount.filter") } else { return fail("SolveCondition::ObjectCount.filter missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("SolveCondition::ObjectCount.comparator") } else { return fail("SolveCondition::ObjectCount.comparator missing") }
	if fv, found := get_any(v, "threshold"); found { if !decode_u32(fv, &out.threshold) do return fail("SolveCondition::ObjectCount.threshold") } else { return fail("SolveCondition::ObjectCount.threshold missing") }
	return true
		}) { return fail("SolveCondition::ObjectCount") }
		out^ = tmp
	case "Condition": when COVERAGE do cov_hit("SolveCondition::Condition");
		tmp: SolveCondition_Condition
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^SolveCondition_Condition) -> bool {
	if fv, found := get_any(v, "condition"); found { if !decode_StaticCondition(fv, &out.condition) do return fail("SolveCondition::Condition.condition") } else { return fail("SolveCondition::Condition.condition missing") }
	return true
		}) { return fail("SolveCondition::Condition") }
		out^ = tmp
	case "Text": when COVERAGE do cov_hit("SolveCondition::Text");
		tmp: SolveCondition_Text
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^SolveCondition_Text) -> bool {
	if fv, found := get_any(v, "description"); found { if !decode_string(fv, &out.description) do return fail("SolveCondition::Text.description") } else { return fail("SolveCondition::Text.description missing") }
	return true
		}) { return fail("SolveCondition::Text") }
		out^ = tmp
	case: return fail("SolveCondition: unknown variant")
	}
	return true
}

encode_SolveCondition :: proc(b: ^strings.Builder, x: SolveCondition) {
	#partial switch y in x {
	case SolveCondition_ObjectCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ObjectCount")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "threshold"); encode_u32(b, y.threshold)
	}; strings.write_byte(b, '}')
	case SolveCondition_Condition: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Condition")
	member(b, first, "condition"); encode_StaticCondition(b, y.condition)
	}; strings.write_byte(b, '}')
	case SolveCondition_Text: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Text")
	member(b, first, "description"); encode_string(b, y.description)
	}; strings.write_byte(b, '}')
	}
}

encode_SolveCondition_members :: proc(b: ^strings.Builder, x: SolveCondition, first: ^bool) {
	#partial switch y in x {
	case SolveCondition_ObjectCount: member(b, first, "type"); json.write_string(b, "ObjectCount")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "threshold"); encode_u32(b, y.threshold)

	case SolveCondition_Condition: member(b, first, "type"); json.write_string(b, "Condition")
	member(b, first, "condition"); encode_StaticCondition(b, y.condition)

	case SolveCondition_Text: member(b, first, "type"); json.write_string(b, "Text")
	member(b, first, "description"); encode_string(b, y.description)

	}
}

decode_DeckCopyLimit :: proc(v: json.Value, out: ^DeckCopyLimit) -> bool {
	when COVERAGE do cov_hit("DeckCopyLimit")
	if v.kind != .Object do return fail("DeckCopyLimit: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("DeckCopyLimit: no tag")
	switch tv.text {
	case "Unlimited": when COVERAGE do cov_hit("DeckCopyLimit::Unlimited"); out^ = DeckCopyLimit_Unlimited{}
	case "UpTo": when COVERAGE do cov_hit("DeckCopyLimit::UpTo"); tmp: DeckCopyLimit_UpTo; if !decode_u32(json.get_or_null(v, "data"), &tmp._0) do return fail("DeckCopyLimit::UpTo"); out^ = tmp
	case: return fail("DeckCopyLimit: unknown variant")
	}
	return true
}

encode_DeckCopyLimit :: proc(b: ^strings.Builder, x: DeckCopyLimit) {
	#partial switch y in x {
	case DeckCopyLimit_Unlimited: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Unlimited"); strings.write_byte(b, '}')
	case DeckCopyLimit_UpTo: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "UpTo"); member(b, &f, "data"); encode_u32(b, y._0); strings.write_byte(b, '}')
	}
}

decode_DeckSizeOverride :: proc(v: json.Value, out: ^DeckSizeOverride) -> bool {
	when COVERAGE do cov_hit("DeckSizeOverride")
	if v.kind != .Object do return fail("DeckSizeOverride: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("DeckSizeOverride: no tag")
	str := tv.text
	switch str {
	case "NoMaximum": when COVERAGE do cov_hit("DeckSizeOverride::NoMaximum"); out^ = .NoMaximum
	case: return fail("DeckSizeOverride: unknown variant")
	}
	return true
}

encode_DeckSizeOverride :: proc(b: ^strings.Builder, x: DeckSizeOverride) {
	strings.write_byte(b, '{')
	f := true
	encode_DeckSizeOverride_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_DeckSizeOverride_members :: proc(b: ^strings.Builder, x: DeckSizeOverride, first: ^bool) {
	_ = x
	@(static, rodata) NAMES := [DeckSizeOverride]string{
		.NoMaximum = "NoMaximum",
	}
	member(b, first, "type"); json.write_string(b, NAMES[x])
}

decode_OracleDiagnostic :: proc(v: json.Value, out: ^OracleDiagnostic) -> bool {
	when COVERAGE do cov_hit("OracleDiagnostic")
	if v.kind != .Object do return fail("OracleDiagnostic: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("OracleDiagnostic: no tag")
	switch tv.text {
	case "TargetFallback": when COVERAGE do cov_hit("OracleDiagnostic::TargetFallback");
		tmp: OracleDiagnostic_TargetFallback
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^OracleDiagnostic_TargetFallback) -> bool {
	if fv, found := get_any(v, "context"); found { if !decode_string(fv, &out.context_) do return fail("OracleDiagnostic::TargetFallback.context") } else { return fail("OracleDiagnostic::TargetFallback.context missing") }
	if fv, found := get_any(v, "text"); found { if !decode_string(fv, &out.text) do return fail("OracleDiagnostic::TargetFallback.text") } else { return fail("OracleDiagnostic::TargetFallback.text missing") }
	if fv, found := get_any(v, "line_index"); found { if !decode_int(fv, &out.line_index) do return fail("OracleDiagnostic::TargetFallback.line_index") } else { return fail("OracleDiagnostic::TargetFallback.line_index missing") }
	return true
		}) { return fail("OracleDiagnostic::TargetFallback") }
		out^ = tmp
	case "IgnoredRemainder": when COVERAGE do cov_hit("OracleDiagnostic::IgnoredRemainder");
		tmp: OracleDiagnostic_IgnoredRemainder
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^OracleDiagnostic_IgnoredRemainder) -> bool {
	if fv, found := get_any(v, "text"); found { if !decode_string(fv, &out.text) do return fail("OracleDiagnostic::IgnoredRemainder.text") } else { return fail("OracleDiagnostic::IgnoredRemainder.text missing") }
	if fv, found := get_any(v, "parser"); found { if !decode_string(fv, &out.parser) do return fail("OracleDiagnostic::IgnoredRemainder.parser") } else { return fail("OracleDiagnostic::IgnoredRemainder.parser missing") }
	if fv, found := get_any(v, "line_index"); found { if !decode_int(fv, &out.line_index) do return fail("OracleDiagnostic::IgnoredRemainder.line_index") } else { return fail("OracleDiagnostic::IgnoredRemainder.line_index missing") }
	return true
		}) { return fail("OracleDiagnostic::IgnoredRemainder") }
		out^ = tmp
	case "SwallowedClause": when COVERAGE do cov_hit("OracleDiagnostic::SwallowedClause");
		tmp: OracleDiagnostic_SwallowedClause
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^OracleDiagnostic_SwallowedClause) -> bool {
	if fv, found := get_any(v, "detector"); found { if !decode_string(fv, &out.detector) do return fail("OracleDiagnostic::SwallowedClause.detector") } else { return fail("OracleDiagnostic::SwallowedClause.detector missing") }
	if fv, found := get_any(v, "description"); found { if !decode_string(fv, &out.description) do return fail("OracleDiagnostic::SwallowedClause.description") } else { return fail("OracleDiagnostic::SwallowedClause.description missing") }
	if fv, found := get_any(v, "line_index"); found { if !decode_int(fv, &out.line_index) do return fail("OracleDiagnostic::SwallowedClause.line_index") } else { return fail("OracleDiagnostic::SwallowedClause.line_index missing") }
	if fv, found := get_any(v, "unit_span"); found { if !dec_opt_OracleSourceSpan(fv, &out.unit_span) do return fail("OracleDiagnostic::SwallowedClause.unit_span") }
	if fv, found := get_any(v, "items"); found { if !dec_dyn_OracleItemId(fv, &out.items) do return fail("OracleDiagnostic::SwallowedClause.items") }
	if fv, found := get_any(v, "gap"); found { if !dec_opt_ClauseGap(fv, &out.gap) do return fail("OracleDiagnostic::SwallowedClause.gap") }
	return true
		}) { return fail("OracleDiagnostic::SwallowedClause") }
		out^ = tmp
	case "CascadeLoss": when COVERAGE do cov_hit("OracleDiagnostic::CascadeLoss");
		tmp: OracleDiagnostic_CascadeLoss
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^OracleDiagnostic_CascadeLoss) -> bool {
	if fv, found := get_any(v, "slot"); found { if !decode_CascadeSlot(fv, &out.slot) do return fail("OracleDiagnostic::CascadeLoss.slot") } else { return fail("OracleDiagnostic::CascadeLoss.slot missing") }
	if fv, found := get_any(v, "effect_name"); found { if !decode_string(fv, &out.effect_name) do return fail("OracleDiagnostic::CascadeLoss.effect_name") } else { return fail("OracleDiagnostic::CascadeLoss.effect_name missing") }
	if fv, found := get_any(v, "line_index"); found { if !decode_int(fv, &out.line_index) do return fail("OracleDiagnostic::CascadeLoss.line_index") } else { return fail("OracleDiagnostic::CascadeLoss.line_index missing") }
	return true
		}) { return fail("OracleDiagnostic::CascadeLoss") }
		out^ = tmp
	case: return fail("OracleDiagnostic: unknown variant")
	}
	return true
}

encode_OracleDiagnostic :: proc(b: ^strings.Builder, x: OracleDiagnostic) {
	#partial switch y in x {
	case OracleDiagnostic_TargetFallback: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TargetFallback")
	member(b, first, "context"); encode_string(b, y.context_)
	member(b, first, "text"); encode_string(b, y.text)
	member(b, first, "line_index"); encode_int(b, y.line_index)
	}; strings.write_byte(b, '}')
	case OracleDiagnostic_IgnoredRemainder: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "IgnoredRemainder")
	member(b, first, "text"); encode_string(b, y.text)
	member(b, first, "parser"); encode_string(b, y.parser)
	member(b, first, "line_index"); encode_int(b, y.line_index)
	}; strings.write_byte(b, '}')
	case OracleDiagnostic_SwallowedClause: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SwallowedClause")
	member(b, first, "detector"); encode_string(b, y.detector)
	member(b, first, "description"); encode_string(b, y.description)
	member(b, first, "line_index"); encode_int(b, y.line_index)
	if !(y.unit_span == nil) { member(b, first, "unit_span"); enc_opt_OracleSourceSpan(b, y.unit_span) }
	if !((len(y.items) == 0)) { member(b, first, "items"); enc_dyn_OracleItemId(b, y.items) }
	if !(y.gap == nil) { member(b, first, "gap"); enc_opt_ClauseGap(b, y.gap) }
	}; strings.write_byte(b, '}')
	case OracleDiagnostic_CascadeLoss: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CascadeLoss")
	member(b, first, "slot"); encode_CascadeSlot(b, y.slot)
	member(b, first, "effect_name"); encode_string(b, y.effect_name)
	member(b, first, "line_index"); encode_int(b, y.line_index)
	}; strings.write_byte(b, '}')
	}
}

encode_OracleDiagnostic_members :: proc(b: ^strings.Builder, x: OracleDiagnostic, first: ^bool) {
	#partial switch y in x {
	case OracleDiagnostic_TargetFallback: member(b, first, "type"); json.write_string(b, "TargetFallback")
	member(b, first, "context"); encode_string(b, y.context_)
	member(b, first, "text"); encode_string(b, y.text)
	member(b, first, "line_index"); encode_int(b, y.line_index)

	case OracleDiagnostic_IgnoredRemainder: member(b, first, "type"); json.write_string(b, "IgnoredRemainder")
	member(b, first, "text"); encode_string(b, y.text)
	member(b, first, "parser"); encode_string(b, y.parser)
	member(b, first, "line_index"); encode_int(b, y.line_index)

	case OracleDiagnostic_SwallowedClause: member(b, first, "type"); json.write_string(b, "SwallowedClause")
	member(b, first, "detector"); encode_string(b, y.detector)
	member(b, first, "description"); encode_string(b, y.description)
	member(b, first, "line_index"); encode_int(b, y.line_index)
	if !(y.unit_span == nil) { member(b, first, "unit_span"); enc_opt_OracleSourceSpan(b, y.unit_span) }
	if !((len(y.items) == 0)) { member(b, first, "items"); enc_dyn_OracleItemId(b, y.items) }
	if !(y.gap == nil) { member(b, first, "gap"); enc_opt_ClauseGap(b, y.gap) }

	case OracleDiagnostic_CascadeLoss: member(b, first, "type"); json.write_string(b, "CascadeLoss")
	member(b, first, "slot"); encode_CascadeSlot(b, y.slot)
	member(b, first, "effect_name"); encode_string(b, y.effect_name)
	member(b, first, "line_index"); encode_int(b, y.line_index)

	}
}

decode_CardMetadata :: proc(v: json.Value, out: ^CardMetadata) -> bool {
	when COVERAGE do cov_hit("CardMetadata")
	if v.kind != .Object do return fail("CardMetadata: not an object")
	if fv, found := get_any(v, "forge_abilities"); found { if !decode_u32(fv, &out.forge_abilities) do return fail("CardMetadata.forge_abilities") }
	if fv, found := get_any(v, "forge_triggers"); found { if !decode_u32(fv, &out.forge_triggers) do return fail("CardMetadata.forge_triggers") }
	if fv, found := get_any(v, "forge_statics"); found { if !decode_u32(fv, &out.forge_statics) do return fail("CardMetadata.forge_statics") }
	if fv, found := get_any(v, "forge_replacements"); found { if !decode_u32(fv, &out.forge_replacements) do return fail("CardMetadata.forge_replacements") }
	if fv, found := get_any(v, "related_token_ids"); found { if !dec_dyn_string(fv, &out.related_token_ids) do return fail("CardMetadata.related_token_ids") }
	if fv, found := get_any(v, "source_printing_ids"); found { if !dec_dyn_string(fv, &out.source_printing_ids) do return fail("CardMetadata.source_printing_ids") }
	if fv, found := get_any(v, "spellbook"); found { if !dec_dyn_string(fv, &out.spellbook) do return fail("CardMetadata.spellbook") }
	if fv, found := get_any(v, "off_stack_mana_value_override"); found { if !dec_opt_u32(fv, &out.off_stack_mana_value_override) do return fail("CardMetadata.off_stack_mana_value_override") }
	if fv, found := get_any(v, "off_stack_mana_costs"); found { if !dec_dyn_ManaCost(fv, &out.off_stack_mana_costs) do return fail("CardMetadata.off_stack_mana_costs") }
	if fv, found := get_any(v, "confirmed_misparse"); found { if !dec_opt_MisparseClass(fv, &out.confirmed_misparse) do return fail("CardMetadata.confirmed_misparse") }
	return true
}

encode_CardMetadata :: proc(b: ^strings.Builder, x: CardMetadata) {
	strings.write_byte(b, '{')
	f := true
	encode_CardMetadata_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CardMetadata_members :: proc(b: ^strings.Builder, x: CardMetadata, first: ^bool) {
	if !(x.forge_abilities == 0) { member(b, first, "forge_abilities"); encode_u32(b, x.forge_abilities) }
	if !(x.forge_triggers == 0) { member(b, first, "forge_triggers"); encode_u32(b, x.forge_triggers) }
	if !(x.forge_statics == 0) { member(b, first, "forge_statics"); encode_u32(b, x.forge_statics) }
	if !(x.forge_replacements == 0) { member(b, first, "forge_replacements"); encode_u32(b, x.forge_replacements) }
	if !((len(x.related_token_ids) == 0)) { member(b, first, "related_token_ids"); enc_dyn_string(b, x.related_token_ids) }
	if !((len(x.source_printing_ids) == 0)) { member(b, first, "source_printing_ids"); enc_dyn_string(b, x.source_printing_ids) }
	if !((len(x.spellbook) == 0)) { member(b, first, "spellbook"); enc_dyn_string(b, x.spellbook) }
	if !(x.off_stack_mana_value_override == nil) { member(b, first, "off_stack_mana_value_override"); enc_opt_u32(b, x.off_stack_mana_value_override) }
	if !((len(x.off_stack_mana_costs) == 0)) { member(b, first, "off_stack_mana_costs"); enc_dyn_ManaCost(b, x.off_stack_mana_costs) }
	if !(x.confirmed_misparse == nil) { member(b, first, "confirmed_misparse"); enc_opt_MisparseClass(b, x.confirmed_misparse) }
}

decode_Rarity :: proc(v: json.Value, out: ^Rarity) -> bool {
	when COVERAGE do cov_hit("Rarity")
	if v.kind != .String do return fail("Rarity: not a string")
	str := v.text
	switch str {
	case "common": when COVERAGE do cov_hit("Rarity::common"); out^ = .Common
	case "uncommon": when COVERAGE do cov_hit("Rarity::uncommon"); out^ = .Uncommon
	case "rare": when COVERAGE do cov_hit("Rarity::rare"); out^ = .Rare
	case "mythic": when COVERAGE do cov_hit("Rarity::mythic"); out^ = .Mythic
	case "special": when COVERAGE do cov_hit("Rarity::special"); out^ = .Special
	case "bonus": when COVERAGE do cov_hit("Rarity::bonus"); out^ = .Bonus
	case: return fail("Rarity: unknown variant")
	}
	return true
}

encode_Rarity :: proc(b: ^strings.Builder, x: Rarity) {
	@(static, rodata) NAMES := [Rarity]string{
		.Common = "common",
		.Uncommon = "uncommon",
		.Rare = "rare",
		.Mythic = "mythic",
		.Special = "special",
		.Bonus = "bonus",
	}
	json.write_string(b, NAMES[x])
}

