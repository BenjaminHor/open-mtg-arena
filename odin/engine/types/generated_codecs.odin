	case ObjectScope_GrantingObject: _ = y; member(b, first, "type"); json.write_string(b, "GrantingObject")
	case ObjectScope_SpecificObject: member(b, first, "type"); json.write_string(b, "SpecificObject")
	member(b, first, "object"); encode_ObjectIncarnationRef(b, y.object)

	}
}

