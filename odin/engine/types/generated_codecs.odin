decode_ObjectSelectionCardinality :: proc(v: json.Value, out: ^ObjectSelectionCardinality) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ObjectSelectionCardinality: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ObjectSelectionCardinality: not a string or object")
	}
	switch variant {
	case "Exactly":
		tmp: ObjectSelectionCardinality_Exactly
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ObjectSelectionCardinality_Exactly) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("ObjectSelectionCardinality::Exactly.count") } else { return fail("ObjectSelectionCardinality::Exactly.count missing") }
	return true
		}) { return fail("ObjectSelectionCardinality::Exactly") }
		out^ = tmp
	case "AnyNumber": out^ = ObjectSelectionCardinality_AnyNumber{}
	case: return fail("ObjectSelectionCardinality: unknown variant")
	}
	return true
}

encode_ObjectSelectionCardinality :: proc(b: ^strings.Builder, x: ObjectSelectionCardinality) {
	#partial switch y in x {
	case ObjectSelectionCardinality_Exactly: strings.write_byte(b, '{'); json.write_string(b, "Exactly"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ObjectSelectionCardinality_AnyNumber: _ = y; json.write_string(b, "AnyNumber")
	}
}

