	case PendingCounterPostAction_ApplyCopyTokenModificationsAndFinalize: strings.write_byte(b, '{'); json.write_string(b, "ApplyCopyTokenModificationsAndFinalize"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "name"); encode_string(b, y.name)
	member(b, first, "enters_attacking"); encode_bool(b, y.enters_attacking)
	if !(skip_PendingCounterPostAction_EntryAttackDestination_is_any_defender_EntryAttackDestination(y.attack_destination)) { member(b, first, "attack_destination"); encode_EntryAttackDestination(b, y.attack_destination) }
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
