decode_ResolutionCastCleanup :: proc(v: json.Value, out: ^ResolutionCastCleanup) -> bool {
	if v.kind != .Object do return fail("ResolutionCastCleanup: not an object")
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("ResolutionCastCleanup.source_id") } else { return fail("ResolutionCastCleanup.source_id missing") }
	if fv, found := get_any(v, "offer_id"); found { if !dec_opt_ResolutionCastOfferId(fv, &out.offer_id) do return fail("ResolutionCastCleanup.offer_id") }
	if fv, found := get_any(v, "face_policy"); found { if !decode_ResolutionCastFacePolicy(fv, &out.face_policy) do return fail("ResolutionCastCleanup.face_policy") } else { return fail("ResolutionCastCleanup.face_policy missing") }
	if fv, found := get_any(v, "exiled_misses"); found { if !dec_dyn_ObjectId(fv, &out.exiled_misses) do return fail("ResolutionCastCleanup.exiled_misses") } else { return fail("ResolutionCastCleanup.exiled_misses missing") }
	if fv, found := get_any(v, "reject_action"); found { if !decode_ResolutionMvRejectAction(fv, &out.reject_action) do return fail("ResolutionCastCleanup.reject_action") } else { return fail("ResolutionCastCleanup.reject_action missing") }
	if fv, found := get_any(v, "success_action"); found { if !decode_ResolutionCastSuccessAction(fv, &out.success_action) do return fail("ResolutionCastCleanup.success_action") } else { out.success_action = ResolutionCastSuccessAction(ResolutionCastSuccessAction_BottomMisses{}) }
	if fv, found := get_any(v, "delayed_trigger_receipts"); found { if !dec_dyn_ResolutionCastDelayedTriggerReceipt(fv, &out.delayed_trigger_receipts) do return fail("ResolutionCastCleanup.delayed_trigger_receipts") }
	if fv, found := get_any(v, "indicated_action"); found { if !dec_ptr_IndicatedActionLimit(fv, &out.indicated_action) do return fail("ResolutionCastCleanup.indicated_action") }
	return true
}

encode_ResolutionCastCleanup :: proc(b: ^strings.Builder, x: ResolutionCastCleanup) {
	strings.write_byte(b, '{')
	f := true
	encode_ResolutionCastCleanup_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ResolutionCastCleanup_members :: proc(b: ^strings.Builder, x: ResolutionCastCleanup, first: ^bool) {
	member(b, first, "source_id"); encode_ObjectId(b, x.source_id)
	if !(x.offer_id == nil) { member(b, first, "offer_id"); enc_opt_ResolutionCastOfferId(b, x.offer_id) }
	member(b, first, "face_policy"); encode_ResolutionCastFacePolicy(b, x.face_policy)
	member(b, first, "exiled_misses"); enc_dyn_ObjectId(b, x.exiled_misses)
	member(b, first, "reject_action"); encode_ResolutionMvRejectAction(b, x.reject_action)
	member(b, first, "success_action"); encode_ResolutionCastSuccessAction(b, x.success_action)
	if !(len(x.delayed_trigger_receipts) == 0) { member(b, first, "delayed_trigger_receipts"); enc_dyn_ResolutionCastDelayedTriggerReceipt(b, x.delayed_trigger_receipts) }
	if !(x.indicated_action == nil) { member(b, first, "indicated_action"); enc_ptr_IndicatedActionLimit(b, x.indicated_action) }
}

