encode_StaticCondition :: proc(b: ^strings.Builder, x: StaticCondition) {
	#partial switch y in x {
	case StaticCondition_DevotionGE: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DevotionGE")
	member(b, first, "colors"); enc_dyn_ManaColor(b, y.colors)
	member(b, first, "threshold"); encode_u32(b, y.threshold)
	}; strings.write_byte(b, '}')
	case StaticCondition_IsPresent: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "IsPresent")
	member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case StaticCondition_ChosenColorIs: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChosenColorIs")
	member(b, first, "color"); encode_ManaColor(b, y.color)
	}; strings.write_byte(b, '}')
	case StaticCondition_ChosenLabelIs: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChosenLabelIs")
	member(b, first, "label"); encode_string(b, y.label)
	}; strings.write_byte(b, '}')
	case StaticCondition_QuantityComparison: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "QuantityComparison")
	member(b, first, "lhs"); encode_QuantityExpr(b, y.lhs)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, y.rhs)
	}; strings.write_byte(b, '}')
	case StaticCondition_QuantityQuality: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "QuantityQuality")
	member(b, first, "quantity"); encode_QuantityExpr(b, y.quantity)
	member(b, first, "quality"); encode_NumberQuality(b, y.quality)
	}; strings.write_byte(b, '}')
	case StaticCondition_HasMaxSpeed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasMaxSpeed"); strings.write_byte(b, '}')
	case StaticCondition_SpeedGE: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SpeedGE")
	member(b, first, "threshold"); encode_u8(b, y.threshold)
	}; strings.write_byte(b, '}')
	case StaticCondition_And: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "And")
	member(b, first, "conditions"); enc_dyn_StaticCondition(b, y.conditions)
	}; strings.write_byte(b, '}')
	case StaticCondition_Or: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Or")
	member(b, first, "conditions"); enc_dyn_StaticCondition(b, y.conditions)
	}; strings.write_byte(b, '}')
