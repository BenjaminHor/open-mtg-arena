		out^ = tmp
	case "ChooseClashOpponent": when COVERAGE do cov_hit("GameAction::ChooseClashOpponent");
		tmp: GameAction_ChooseClashOpponent
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameAction_ChooseClashOpponent) -> bool {
	if fv, found := get_any(v, "opponent"); found { if !decode_PlayerId(fv, &out.opponent) do return fail("GameAction::ChooseClashOpponent.opponent") } else { return fail("GameAction::ChooseClashOpponent.opponent missing") }
	return true
