decode_DeferredLifeCostResume :: proc(v: json.Value, out: ^DeferredLifeCostResume) -> bool {
	when COVERAGE do cov_hit("DeferredLifeCostResume")
	if v.kind != .Object do return fail("DeferredLifeCostResume: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("DeferredLifeCostResume: no tag")
	switch tv.text {
	case "Cast": when COVERAGE do cov_hit("DeferredLifeCostResume::Cast");
		tmp: DeferredLifeCostResume_Cast
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DeferredLifeCostResume_Cast) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("DeferredLifeCostResume::Cast.player") } else { return fail("DeferredLifeCostResume::Cast.player missing") }
	if fv, found := get_any(v, "pending"); found { if !dec_ptr_PendingCast(fv, &out.pending) do return fail("DeferredLifeCostResume::Cast.pending") }
	if fv, found := get_any(v, "remaining_life_payments"); found { if !dec_dyn_u32(fv, &out.remaining_life_payments) do return fail("DeferredLifeCostResume::Cast.remaining_life_payments") }
	if fv, found := get_any(v, "resume_at_resolution_depth"); found { if !decode_int(fv, &out.resume_at_resolution_depth) do return fail("DeferredLifeCostResume::Cast.resume_at_resolution_depth") } else { return fail("DeferredLifeCostResume::Cast.resume_at_resolution_depth missing") }
	return true
		}) { return fail("DeferredLifeCostResume::Cast") }
		out^ = tmp
	case "PayAmount": when COVERAGE do cov_hit("DeferredLifeCostResume::PayAmount");
		tmp: DeferredLifeCostResume_PayAmount
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DeferredLifeCostResume_PayAmount) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("DeferredLifeCostResume::PayAmount.player") } else { return fail("DeferredLifeCostResume::PayAmount.player missing") }
	if fv, found := get_any(v, "total"); found { if !decode_u32(fv, &out.total) do return fail("DeferredLifeCostResume::PayAmount.total") } else { return fail("DeferredLifeCostResume::PayAmount.total missing") }
	if fv, found := get_any(v, "resume_at_resolution_depth"); found { if !decode_int(fv, &out.resume_at_resolution_depth) do return fail("DeferredLifeCostResume::PayAmount.resume_at_resolution_depth") } else { return fail("DeferredLifeCostResume::PayAmount.resume_at_resolution_depth missing") }
	if fv, found := get_any(v, "pending_entry"); found { if !dec_ptr_PendingReplacement(fv, &out.pending_entry) do return fail("DeferredLifeCostResume::PayAmount.pending_entry") }
	return true
		}) { return fail("DeferredLifeCostResume::PayAmount") }
		out^ = tmp
	case "ManaRoot": when COVERAGE do cov_hit("DeferredLifeCostResume::ManaRoot");
		tmp: DeferredLifeCostResume_ManaRoot
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DeferredLifeCostResume_ManaRoot) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("DeferredLifeCostResume::ManaRoot.player") } else { return fail("DeferredLifeCostResume::ManaRoot.player missing") }
	if fv, found := get_any(v, "resume"); found { if !dec_ptr_ManaAbilityResume(fv, &out.resume) do return fail("DeferredLifeCostResume::ManaRoot.resume") } else { return fail("DeferredLifeCostResume::ManaRoot.resume missing") }
	if fv, found := get_any(v, "remaining_life_payments"); found { if !dec_dyn_u32(fv, &out.remaining_life_payments) do return fail("DeferredLifeCostResume::ManaRoot.remaining_life_payments") }
	if fv, found := get_any(v, "resume_at_resolution_depth"); found { if !decode_int(fv, &out.resume_at_resolution_depth) do return fail("DeferredLifeCostResume::ManaRoot.resume_at_resolution_depth") } else { return fail("DeferredLifeCostResume::ManaRoot.resume_at_resolution_depth missing") }
	return true
		}) { return fail("DeferredLifeCostResume::ManaRoot") }
		out^ = tmp
	case "TurnFaceUp": when COVERAGE do cov_hit("DeferredLifeCostResume::TurnFaceUp");
		tmp: DeferredLifeCostResume_TurnFaceUp
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DeferredLifeCostResume_TurnFaceUp) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("DeferredLifeCostResume::TurnFaceUp.player") } else { return fail("DeferredLifeCostResume::TurnFaceUp.player missing") }
	if fv, found := get_any(v, "source", "object_id"); found { if !decode_ObjectIncarnationRef(fv, &out.source) do return fail("DeferredLifeCostResume::TurnFaceUp.source") } else { return fail("DeferredLifeCostResume::TurnFaceUp.source missing") }
	if fv, found := get_any(v, "cost_source"); found { if !decode_TurnUpCostSource(fv, &out.cost_source) do return fail("DeferredLifeCostResume::TurnFaceUp.cost_source") } else { return fail("DeferredLifeCostResume::TurnFaceUp.cost_source missing") }
	if fv, found := get_any(v, "resume_at_resolution_depth"); found { if !decode_int(fv, &out.resume_at_resolution_depth) do return fail("DeferredLifeCostResume::TurnFaceUp.resume_at_resolution_depth") } else { return fail("DeferredLifeCostResume::TurnFaceUp.resume_at_resolution_depth missing") }
	if fv, found := get_any(v, "remaining_cost"); found { if !dec_ptr_AbilityCost(fv, &out.remaining_cost) do return fail("DeferredLifeCostResume::TurnFaceUp.remaining_cost") }
	return true
		}) { return fail("DeferredLifeCostResume::TurnFaceUp") }
		out^ = tmp
	case: return fail("DeferredLifeCostResume: unknown variant")
	}
	return true
}

encode_DeferredLifeCostResume :: proc(b: ^strings.Builder, x: DeferredLifeCostResume) {
	#partial switch y in x {
	case DeferredLifeCostResume_Cast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Cast")
	member(b, first, "player"); encode_PlayerId(b, y.player)
	if !(y.pending == nil) { member(b, first, "pending"); enc_ptr_PendingCast(b, y.pending) }
	if !((len(y.remaining_life_payments) == 0)) { member(b, first, "remaining_life_payments"); enc_dyn_u32(b, y.remaining_life_payments) }
	member(b, first, "resume_at_resolution_depth"); encode_int(b, y.resume_at_resolution_depth)
	}; strings.write_byte(b, '}')
	case DeferredLifeCostResume_PayAmount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PayAmount")
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "total"); encode_u32(b, y.total)
	member(b, first, "resume_at_resolution_depth"); encode_int(b, y.resume_at_resolution_depth)
	if !(y.pending_entry == nil) { member(b, first, "pending_entry"); enc_ptr_PendingReplacement(b, y.pending_entry) }
	}; strings.write_byte(b, '}')
	case DeferredLifeCostResume_ManaRoot: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ManaRoot")
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "resume"); enc_ptr_ManaAbilityResume(b, y.resume)
	if !((len(y.remaining_life_payments) == 0)) { member(b, first, "remaining_life_payments"); enc_dyn_u32(b, y.remaining_life_payments) }
	member(b, first, "resume_at_resolution_depth"); encode_int(b, y.resume_at_resolution_depth)
	}; strings.write_byte(b, '}')
	case DeferredLifeCostResume_TurnFaceUp: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TurnFaceUp")
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "source"); encode_ObjectIncarnationRef(b, y.source)
	member(b, first, "cost_source"); encode_TurnUpCostSource(b, y.cost_source)
	member(b, first, "resume_at_resolution_depth"); encode_int(b, y.resume_at_resolution_depth)
	if !(y.remaining_cost == nil) { member(b, first, "remaining_cost"); enc_ptr_AbilityCost(b, y.remaining_cost) }
	}; strings.write_byte(b, '}')
	}
}

encode_DeferredLifeCostResume_members :: proc(b: ^strings.Builder, x: DeferredLifeCostResume, first: ^bool) {
	#partial switch y in x {
	case DeferredLifeCostResume_Cast: member(b, first, "type"); json.write_string(b, "Cast")
	member(b, first, "player"); encode_PlayerId(b, y.player)
	if !(y.pending == nil) { member(b, first, "pending"); enc_ptr_PendingCast(b, y.pending) }
	if !((len(y.remaining_life_payments) == 0)) { member(b, first, "remaining_life_payments"); enc_dyn_u32(b, y.remaining_life_payments) }
	member(b, first, "resume_at_resolution_depth"); encode_int(b, y.resume_at_resolution_depth)

	case DeferredLifeCostResume_PayAmount: member(b, first, "type"); json.write_string(b, "PayAmount")
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "total"); encode_u32(b, y.total)
	member(b, first, "resume_at_resolution_depth"); encode_int(b, y.resume_at_resolution_depth)
	if !(y.pending_entry == nil) { member(b, first, "pending_entry"); enc_ptr_PendingReplacement(b, y.pending_entry) }

	case DeferredLifeCostResume_ManaRoot: member(b, first, "type"); json.write_string(b, "ManaRoot")
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "resume"); enc_ptr_ManaAbilityResume(b, y.resume)
	if !((len(y.remaining_life_payments) == 0)) { member(b, first, "remaining_life_payments"); enc_dyn_u32(b, y.remaining_life_payments) }
	member(b, first, "resume_at_resolution_depth"); encode_int(b, y.resume_at_resolution_depth)

	case DeferredLifeCostResume_TurnFaceUp: member(b, first, "type"); json.write_string(b, "TurnFaceUp")
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "source"); encode_ObjectIncarnationRef(b, y.source)
	member(b, first, "cost_source"); encode_TurnUpCostSource(b, y.cost_source)
	member(b, first, "resume_at_resolution_depth"); encode_int(b, y.resume_at_resolution_depth)
	if !(y.remaining_cost == nil) { member(b, first, "remaining_cost"); enc_ptr_AbilityCost(b, y.remaining_cost) }

	}
}

decode_TriggeredManaResume :: proc(v: json.Value, out: ^TriggeredManaResume) -> bool {
	when COVERAGE do cov_hit("TriggeredManaResume")
	if v.kind != .Object do return fail("TriggeredManaResume: not an object")
	if fv, found := get_any(v, "current"); found { if !dec_ptr_PendingTriggerContext(fv, &out.current) do return fail("TriggeredManaResume.current") } else { return fail("TriggeredManaResume.current missing") }
	if fv, found := get_any(v, "current_override"); found { if !dec_opt_ProductionOverride(fv, &out.current_override) do return fail("TriggeredManaResume.current_override") }
	if fv, found := get_any(v, "rules_execution_node"); found { if !decode_RulesExecutionNodeRef(fv, &out.rules_execution_node) do return fail("TriggeredManaResume.rules_execution_node") } else { return fail("TriggeredManaResume.rules_execution_node missing") }
	if fv, found := get_any(v, "accepted_tail"); found { if !dec_dyn_PendingTriggerContext(fv, &out.accepted_tail) do return fail("TriggeredManaResume.accepted_tail") }
	if fv, found := get_any(v, "collected_batches"); found { if !dec_dyn_CollectedTriggerContextBatch(fv, &out.collected_batches) do return fail("TriggeredManaResume.collected_batches") }
	if fv, found := get_any(v, "outer_resume"); found { if !decode_ManaTriggerFixedPointResume(fv, &out.outer_resume) do return fail("TriggeredManaResume.outer_resume") } else { return fail("TriggeredManaResume.outer_resume missing") }
	if fv, found := get_any(v, "stage"); found { if !decode_TriggeredManaStage(fv, &out.stage) do return fail("TriggeredManaResume.stage") } else { return fail("TriggeredManaResume.stage missing") }
	return true
}

encode_TriggeredManaResume :: proc(b: ^strings.Builder, x: TriggeredManaResume) {
	strings.write_byte(b, '{')
	f := true
	encode_TriggeredManaResume_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_TriggeredManaResume_members :: proc(b: ^strings.Builder, x: TriggeredManaResume, first: ^bool) {
	member(b, first, "current"); enc_ptr_PendingTriggerContext(b, x.current)
	if !(x.current_override == nil) { member(b, first, "current_override"); enc_opt_ProductionOverride(b, x.current_override) }
	member(b, first, "rules_execution_node"); encode_RulesExecutionNodeRef(b, x.rules_execution_node)
	if !((len(x.accepted_tail) == 0)) { member(b, first, "accepted_tail"); enc_dyn_PendingTriggerContext(b, x.accepted_tail) }
	if !((len(x.collected_batches) == 0)) { member(b, first, "collected_batches"); enc_dyn_CollectedTriggerContextBatch(b, x.collected_batches) }
	member(b, first, "outer_resume"); encode_ManaTriggerFixedPointResume(b, x.outer_resume)
	member(b, first, "stage"); encode_TriggeredManaStage(b, x.stage)
}

decode_PendingCast :: proc(v: json.Value, out: ^PendingCast) -> bool {
	when COVERAGE do cov_hit("PendingCast")
	if v.kind != .Object do return fail("PendingCast: not an object")
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("PendingCast.object_id") } else { return fail("PendingCast.object_id missing") }
	if fv, found := get_any(v, "card_id"); found { if !decode_CardId(fv, &out.card_id) do return fail("PendingCast.card_id") } else { return fail("PendingCast.card_id missing") }
