encode_DecisionGroupKey_members :: proc(b: ^strings.Builder, x: DecisionGroupKey, first: ^bool) {
	member(b, first, "sources"); enc_dyn_t2_YieldTarget_u8(b, x.sources)
	member(b, first, "kind"); encode_DecisionKind(b, x.kind)
}

decode_YieldTarget :: proc(v: json.Value, out: ^YieldTarget) -> bool {
	when COVERAGE do cov_hit("YieldTarget")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("YieldTarget: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("YieldTarget: not a string or object")
	}
	switch variant {
	case "ThisObject": when COVERAGE do cov_hit("YieldTarget::ThisObject");
		tmp: YieldTarget_ThisObject
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^YieldTarget_ThisObject) -> bool {
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("YieldTarget::ThisObject.source_id") } else { return fail("YieldTarget::ThisObject.source_id missing") }
	if fv, found := get_any(v, "incarnation"); found { if !dec_opt_u64(fv, &out.incarnation) do return fail("YieldTarget::ThisObject.incarnation") }
	if fv, found := get_any(v, "trigger_description"); found { if !dec_opt_string(fv, &out.trigger_description) do return fail("YieldTarget::ThisObject.trigger_description") }
	return true
		}) { return fail("YieldTarget::ThisObject") }
		out^ = tmp
	case "AllCopies": when COVERAGE do cov_hit("YieldTarget::AllCopies");
		tmp: YieldTarget_AllCopies
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^YieldTarget_AllCopies) -> bool {
	if fv, found := get_any(v, "card_id"); found { if !decode_CardId(fv, &out.card_id) do return fail("YieldTarget::AllCopies.card_id") } else { return fail("YieldTarget::AllCopies.card_id missing") }
	if fv, found := get_any(v, "trigger_description"); found { if !dec_opt_string(fv, &out.trigger_description) do return fail("YieldTarget::AllCopies.trigger_description") }
	return true
		}) { return fail("YieldTarget::AllCopies") }
		out^ = tmp
	case: return fail("YieldTarget: unknown variant")
	}
	return true
}

encode_YieldTarget :: proc(b: ^strings.Builder, x: YieldTarget) {
	#partial switch y in x {
	case YieldTarget_ThisObject: strings.write_byte(b, '{'); json.write_string(b, "ThisObject"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "incarnation"); enc_opt_u64(b, y.incarnation)
	if !(y.trigger_description == nil) { member(b, first, "trigger_description"); enc_opt_string(b, y.trigger_description) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case YieldTarget_AllCopies: strings.write_byte(b, '{'); json.write_string(b, "AllCopies"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card_id"); encode_CardId(b, y.card_id)
	if !(y.trigger_description == nil) { member(b, first, "trigger_description"); enc_opt_string(b, y.trigger_description) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_BasicLandType :: proc(v: json.Value, out: ^BasicLandType) -> bool {
	when COVERAGE do cov_hit("BasicLandType")
	if v.kind != .String do return fail("BasicLandType: not a string")
	str := v.text
	switch str {
	case "Plains": when COVERAGE do cov_hit("BasicLandType::Plains"); out^ = .Plains
	case "Island": when COVERAGE do cov_hit("BasicLandType::Island"); out^ = .Island
	case "Swamp": when COVERAGE do cov_hit("BasicLandType::Swamp"); out^ = .Swamp
	case "Mountain": when COVERAGE do cov_hit("BasicLandType::Mountain"); out^ = .Mountain
	case "Forest": when COVERAGE do cov_hit("BasicLandType::Forest"); out^ = .Forest
	case: return fail("BasicLandType: unknown variant")
	}
	return true
}

encode_BasicLandType :: proc(b: ^strings.Builder, x: BasicLandType) {
	@(static, rodata) NAMES := [BasicLandType]string{
		.Plains = "Plains",
		.Island = "Island",
		.Swamp = "Swamp",
		.Mountain = "Mountain",
		.Forest = "Forest",
	}
	json.write_string(b, NAMES[x])
}

