decode_AttackTarget :: proc(v: json.Value, out: ^AttackTarget) -> bool {
	if v.kind != .Object do return fail("AttackTarget: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("AttackTarget: no tag")
	switch tv.text {
	case "Player": tmp: AttackTarget_Player; if !decode_PlayerId(json.get_or_null(v, "data"), &tmp._0) do return fail("AttackTarget::Player"); out^ = tmp
	case "Planeswalker": tmp: AttackTarget_Planeswalker; if !decode_ObjectId(json.get_or_null(v, "data"), &tmp._0) do return fail("AttackTarget::Planeswalker"); out^ = tmp
	case "Battle": tmp: AttackTarget_Battle; if !decode_ObjectId(json.get_or_null(v, "data"), &tmp._0) do return fail("AttackTarget::Battle"); out^ = tmp
	case: return fail("AttackTarget: unknown variant")
	}
	return true
}

