decode_SettledDamageGuard :: proc(v: json.Value, out: ^SettledDamageGuard) -> bool {
	when COVERAGE do cov_hit("SettledDamageGuard")
	if v.kind != .Object do return fail("SettledDamageGuard: not an object")
	if fv, found := get_any(v, "source"); found { if !decode_ObjectIncarnationRef(fv, &out.source) do return fail("SettledDamageGuard.source") } else { return fail("SettledDamageGuard.source missing") }
	if fv, found := get_any(v, "condition"); found { if !decode_ReplacementCondition(fv, &out.condition) do return fail("SettledDamageGuard.condition") } else { return fail("SettledDamageGuard.condition missing") }
	if fv, found := get_any(v, "reading"); found { if !decode_DamageGuardReading(fv, &out.reading) do return fail("SettledDamageGuard.reading") } else { return fail("SettledDamageGuard.reading missing") }
	return true
}

