	case DebugAction_ShuffleLibrary: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ShuffleLibrary"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_Proliferate: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Proliferate"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
