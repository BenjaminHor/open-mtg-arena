decode_ResolvedContinuousEffectEdit :: proc(v: json.Value, out: ^ResolvedContinuousEffectEdit) -> bool {
	when COVERAGE do cov_hit("ResolvedContinuousEffectEdit")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ResolvedContinuousEffectEdit: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ResolvedContinuousEffectEdit: not a string or object")
	}
	switch variant {
	case "Install": when COVERAGE do cov_hit("ResolvedContinuousEffectEdit::Install"); tmp: ResolvedContinuousEffectEdit_Install; if !decode_ResolvedContinuousEffectCommand(body, &tmp._0) do return fail("ResolvedContinuousEffectEdit::Install"); out^ = tmp
	case "Retire": when COVERAGE do cov_hit("ResolvedContinuousEffectEdit::Retire"); tmp: ResolvedContinuousEffectEdit_Retire; if !decode_ResolvedContinuousEffectRetirementCommand(body, &tmp._0) do return fail("ResolvedContinuousEffectEdit::Retire"); out^ = tmp
	case: return fail("ResolvedContinuousEffectEdit: unknown variant")
	}
	return true
}

encode_ResolvedContinuousEffectEdit :: proc(b: ^strings.Builder, x: ResolvedContinuousEffectEdit) {
	#partial switch y in x {
	case ResolvedContinuousEffectEdit_Install: strings.write_byte(b, '{'); json.write_string(b, "Install"); strings.write_byte(b, ':'); encode_ResolvedContinuousEffectCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedContinuousEffectEdit_Retire: strings.write_byte(b, '{'); json.write_string(b, "Retire"); strings.write_byte(b, ':'); encode_ResolvedContinuousEffectRetirementCommand(b, y._0); strings.write_byte(b, '}')
	}
}

