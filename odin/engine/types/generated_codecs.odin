	case GameAction_ChooseSpecializeColor: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChooseSpecializeColor"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "color"); encode_ManaColor(b, y.color)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_CastParadigmCopy: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CastParadigmCopy"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source"); encode_ObjectId(b, y.source)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_PassParadigmOffer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PassParadigmOffer"); strings.write_byte(b, '}')
	case GameAction_Debug: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Debug"); member(b, &f, "data"); encode_DebugAction(b, y._0); strings.write_byte(b, '}')
	case GameAction_GrantDebugPermission: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "GrantDebugPermission"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_RevokeDebugPermission: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RevokeDebugPermission"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_Concede: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Concede"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_DeclareShortcut: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DeclareShortcut"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "count"); encode_IterationCount(b, y.count)
	if !(y.template == nil) { member(b, first, "template"); enc_opt_DecisionTemplate(b, y.template) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_RespondToShortcut: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RespondToShortcut"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "response"); encode_ShortcutResponse(b, y.response)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_DeclineShortcut: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DeclineShortcut"); strings.write_byte(b, '}')
	case GameAction_PrecastCopyShortcut: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PrecastCopyShortcut"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "epoch"); encode_u64(b, y.epoch)
	member(b, first, "response"); encode_PrecastCopyShortcutResponse(b, y.response)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_EndContinuousEffect: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EndContinuousEffect"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "group"); encode_EndEffectGroupId(b, y.group)
	member(b, first, "source_name"); encode_string(b, y.source_name)
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_BeginResolveAll: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BeginResolveAll"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "max_resolutions"); encode_u32(b, y.max_resolutions)
	member(b, first, "scope"); encode_ResolveAllScope(b, y.scope)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_RespondResolveAllConsent: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RespondResolveAllConsent"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "epoch"); encode_u64(b, y.epoch)
	member(b, first, "decision"); encode_ResolveAllConsentDecision(b, y.decision)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_RevokeResolveAllConsent: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RevokeResolveAllConsent"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "epoch"); encode_u64(b, y.epoch)
	member(b, first, "representative"); encode_PlayerId(b, y.representative)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_WaitingFor :: proc(v: json.Value, out: ^WaitingFor) -> bool {
	when COVERAGE do cov_hit("WaitingFor")
	if v.kind != .Object do return fail("WaitingFor: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("WaitingFor: no tag")
	switch tv.text {
	case "Priority": when COVERAGE do cov_hit("WaitingFor::Priority");
		tmp: WaitingFor_Priority
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^WaitingFor_Priority) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("WaitingFor::Priority.player") } else { return fail("WaitingFor::Priority.player missing") }
	return true
		}) { return fail("WaitingFor::Priority") }
		out^ = tmp
	case "ResolveAllConsent": when COVERAGE do cov_hit("WaitingFor::ResolveAllConsent");
		tmp: WaitingFor_ResolveAllConsent
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^WaitingFor_ResolveAllConsent) -> bool {
	if fv, found := get_any(v, "epoch"); found { if !decode_u64(fv, &out.epoch) do return fail("WaitingFor::ResolveAllConsent.epoch") } else { return fail("WaitingFor::ResolveAllConsent.epoch missing") }
	if fv, found := get_any(v, "representative"); found { if !decode_PlayerId(fv, &out.representative) do return fail("WaitingFor::ResolveAllConsent.representative") } else { return fail("WaitingFor::ResolveAllConsent.representative missing") }
	return true
		}) { return fail("WaitingFor::ResolveAllConsent") }
		out^ = tmp
	case "ResolveAllReady": when COVERAGE do cov_hit("WaitingFor::ResolveAllReady");
		tmp: WaitingFor_ResolveAllReady
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^WaitingFor_ResolveAllReady) -> bool {
	if fv, found := get_any(v, "epoch"); found { if !decode_u64(fv, &out.epoch) do return fail("WaitingFor::ResolveAllReady.epoch") } else { return fail("WaitingFor::ResolveAllReady.epoch missing") }
	return true
		}) { return fail("WaitingFor::ResolveAllReady") }
		out^ = tmp
	case "MeldPairChoice": when COVERAGE do cov_hit("WaitingFor::MeldPairChoice");
		tmp: WaitingFor_MeldPairChoice
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^WaitingFor_MeldPairChoice) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("WaitingFor::MeldPairChoice.player") } else { return fail("WaitingFor::MeldPairChoice.player missing") }
	if fv, found := get_any(v, "choices"); found { if !dec_dyn_MeldSelection(fv, &out.choices) do return fail("WaitingFor::MeldPairChoice.choices") } else { return fail("WaitingFor::MeldPairChoice.choices missing") }
	return true
		}) { return fail("WaitingFor::MeldPairChoice") }
		out^ = tmp
	case "MeldAttackTargetChoice": when COVERAGE do cov_hit("WaitingFor::MeldAttackTargetChoice");
		tmp: WaitingFor_MeldAttackTargetChoice
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^WaitingFor_MeldAttackTargetChoice) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("WaitingFor::MeldAttackTargetChoice.player") } else { return fail("WaitingFor::MeldAttackTargetChoice.player missing") }
	if fv, found := get_any(v, "context"); found { if !decode_MeldSelection(fv, &out.context_) do return fail("WaitingFor::MeldAttackTargetChoice.context") } else { return fail("WaitingFor::MeldAttackTargetChoice.context missing") }
	if fv, found := get_any(v, "valid_targets"); found { if !dec_dyn_AttackTarget(fv, &out.valid_targets) do return fail("WaitingFor::MeldAttackTargetChoice.valid_targets") } else { return fail("WaitingFor::MeldAttackTargetChoice.valid_targets missing") }
	return true
		}) { return fail("WaitingFor::MeldAttackTargetChoice") }
		out^ = tmp
