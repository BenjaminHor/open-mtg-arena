decode_ChooseFromZoneConstraint :: proc(v: json.Value, out: ^ChooseFromZoneConstraint) -> bool {
	if v.kind != .Object do return fail("ChooseFromZoneConstraint: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ChooseFromZoneConstraint: no tag")
	switch tv.text {
	case "DistinctCardTypes":
		tmp: ChooseFromZoneConstraint_DistinctCardTypes
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ChooseFromZoneConstraint_DistinctCardTypes) -> bool {
	if fv, found := get_any(v, "categories"); found { if !dec_dyn_CoreType(fv, &out.categories) do return fail("ChooseFromZoneConstraint::DistinctCardTypes.categories") } else { return fail("ChooseFromZoneConstraint::DistinctCardTypes.categories missing") }
	return true
		}) { return fail("ChooseFromZoneConstraint::DistinctCardTypes") }
		out^ = tmp
	case "TotalManaValue":
		tmp: ChooseFromZoneConstraint_TotalManaValue
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ChooseFromZoneConstraint_TotalManaValue) -> bool {
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("ChooseFromZoneConstraint::TotalManaValue.comparator") } else { return fail("ChooseFromZoneConstraint::TotalManaValue.comparator missing") }
	if fv, found := get_any(v, "value"); found { if !decode_i32(fv, &out.value) do return fail("ChooseFromZoneConstraint::TotalManaValue.value") } else { return fail("ChooseFromZoneConstraint::TotalManaValue.value missing") }
	return true
		}) { return fail("ChooseFromZoneConstraint::TotalManaValue") }
		out^ = tmp
	case: return fail("ChooseFromZoneConstraint: unknown variant")
	}
	return true
}

encode_ChooseFromZoneConstraint :: proc(b: ^strings.Builder, x: ChooseFromZoneConstraint) {
	#partial switch y in x {
	case ChooseFromZoneConstraint_DistinctCardTypes: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DistinctCardTypes")
	member(b, first, "categories"); enc_dyn_CoreType(b, y.categories)
	}; strings.write_byte(b, '}')
	case ChooseFromZoneConstraint_TotalManaValue: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TotalManaValue")
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_i32(b, y.value)
	}; strings.write_byte(b, '}')
	}
}

encode_ChooseFromZoneConstraint_members :: proc(b: ^strings.Builder, x: ChooseFromZoneConstraint, first: ^bool) {
	#partial switch y in x {
	case ChooseFromZoneConstraint_DistinctCardTypes: member(b, first, "type"); json.write_string(b, "DistinctCardTypes")
	member(b, first, "categories"); enc_dyn_CoreType(b, y.categories)

	case ChooseFromZoneConstraint_TotalManaValue: member(b, first, "type"); json.write_string(b, "TotalManaValue")
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_i32(b, y.value)

	}
}

