	case WaitingFor_EnlistChoice: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EnlistChoice"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "attacker"); encode_ObjectId(b, y.attacker)
	member(b, first, "eligible"); enc_dyn_ObjectId(b, y.eligible)
	if !((len(y.remaining) == 0)) { member(b, first, "remaining"); enc_dyn_ObjectId(b, y.remaining) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaitingFor_GameOver: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "GameOver"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
