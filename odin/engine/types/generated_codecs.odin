decode_ResolvedManaInsertCommand :: proc(v: json.Value, out: ^ResolvedManaInsertCommand) -> bool {
	when COVERAGE do cov_hit("ResolvedManaInsertCommand")
	if v.kind != .Object do return fail("ResolvedManaInsertCommand: not an object")
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("ResolvedManaInsertCommand.player") } else { return fail("ResolvedManaInsertCommand.player missing") }
	if fv, found := get_any(v, "unit"); found { if !decode_ManaUnit(fv, &out.unit) do return fail("ResolvedManaInsertCommand.unit") } else { return fail("ResolvedManaInsertCommand.unit missing") }
	if fv, found := get_any(v, "producer"); found { if !decode_RulesExecutionNodeRef(fv, &out.producer) do return fail("ResolvedManaInsertCommand.producer") } else { return fail("ResolvedManaInsertCommand.producer missing") }
	return true
}

encode_ResolvedManaInsertCommand :: proc(b: ^strings.Builder, x: ResolvedManaInsertCommand) {
	strings.write_byte(b, '{')
	f := true
	encode_ResolvedManaInsertCommand_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ResolvedManaInsertCommand_members :: proc(b: ^strings.Builder, x: ResolvedManaInsertCommand, first: ^bool) {
	member(b, first, "player"); encode_PlayerId(b, x.player)
	member(b, first, "unit"); encode_ManaUnit(b, x.unit)
	member(b, first, "producer"); encode_RulesExecutionNodeRef(b, x.producer)
}

