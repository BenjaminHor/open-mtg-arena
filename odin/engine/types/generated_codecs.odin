	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaitingFor_TargetSelection: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TargetSelection"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
