	case "Destroy": when COVERAGE do cov_hit("LogCategory::Destroy"); out^ = .Destroy
	case "Debug": when COVERAGE do cov_hit("LogCategory::Debug"); out^ = .Debug
	case: return fail("LogCategory: unknown variant")
	}
	return true
}

encode_LogCategory :: proc(b: ^strings.Builder, x: LogCategory) {
