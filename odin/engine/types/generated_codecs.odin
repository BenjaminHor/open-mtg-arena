dec_map_string_string :: proc(v: json.Value, out: ^map[string]string) -> bool {
	if v.kind != .Object do return fail("expected an object (map)")
	out^ = make(map[string]string, len(v.members))
	for m in v.members {
		key: string
		val: string
		key = m.key; ok_k := true
		if !ok_k || !decode_string(m.value, &val) do return false
		out[key] = val
	}
	return true
}

dec_opt_string :: proc(v: json.Value, out: ^Maybe(string)) -> bool {
	if v.kind == .Null { out^ = nil; return true }
	x: string
	if !decode_string(v, &x) do return false
	out^ = x
	return true
}

