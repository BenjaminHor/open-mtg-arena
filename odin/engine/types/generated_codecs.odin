}

dec_ptr_TriggerDefinitionRef :: proc(v: json.Value, out: ^^TriggerDefinitionRef) -> bool {
	if v.kind == .Null { out^ = nil; return true }
	p := new(TriggerDefinitionRef)
	if !decode_TriggerDefinitionRef(v, p) do return false
	out^ = p
	return true
}

enc_ptr_TriggerDefinitionRef :: proc(b: ^strings.Builder, x: ^TriggerDefinitionRef) {
	if x == nil do strings.write_string(b, "null")
	else do encode_TriggerDefinitionRef(b, x^)
}

