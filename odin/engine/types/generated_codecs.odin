	member(b, first, "source"); encode_ObjectId(b, x.source)
	member(b, first, "target"); encode_TargetRef(b, x.target)
	member(b, first, "amount"); encode_u32(b, x.amount)
	member(b, first, "is_combat"); encode_bool(b, x.is_combat)
	if !((len(x.applied) == 0)) { member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, x.applied) }
}

