	case BatchCompletion_DestroyPopulationSettled: strings.write_byte(b, '{'); json.write_string(b, "DestroyPopulationSettled"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "ability"); enc_ptr_ResolvedAbility(b, y.ability)
	if !(y.settled_destroyed == nil) { member(b, first, "settled_destroyed"); enc_opt_dyn_ObjectId(b, y.settled_destroyed) }
