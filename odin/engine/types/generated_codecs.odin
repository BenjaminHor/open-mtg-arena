decode_ResolvedInformationEdit :: proc(v: json.Value, out: ^ResolvedInformationEdit) -> bool {
	when COVERAGE do cov_hit("ResolvedInformationEdit")
	if v.kind != .String do return fail("ResolvedInformationEdit: not a string")
	str := v.text
	switch str {
	case "Reveal": when COVERAGE do cov_hit("ResolvedInformationEdit::Reveal"); out^ = .Reveal
	case "Hide": when COVERAGE do cov_hit("ResolvedInformationEdit::Hide"); out^ = .Hide
	case: return fail("ResolvedInformationEdit: unknown variant")
	}
	return true
}

encode_ResolvedInformationEdit :: proc(b: ^strings.Builder, x: ResolvedInformationEdit) {
	@(static, rodata) NAMES := [ResolvedInformationEdit]string{
		.Reveal = "Reveal",
		.Hide = "Hide",
	}
	json.write_string(b, NAMES[x])
}

