	if fv, found := get_any(v, "replacement_subtree"); found { if !decode_ReplacementSubtreeBoundary(fv, &out.replacement_subtree) do return fail("PausedCounterCostRemoval.replacement_subtree") } else { return fail("PausedCounterCostRemoval.replacement_subtree missing") }
