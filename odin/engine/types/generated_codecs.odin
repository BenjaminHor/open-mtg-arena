	case "MoreThanMeetsTheEye": when COVERAGE do cov_hit("AlternativeCastKeyword::MoreThanMeetsTheEye"); out^ = .MoreThanMeetsTheEye
	case "Impending": when COVERAGE do cov_hit("AlternativeCastKeyword::Impending"); out^ = .Impending
	case "Prototype": when COVERAGE do cov_hit("AlternativeCastKeyword::Prototype"); out^ = .Prototype
	case "Mutate": when COVERAGE do cov_hit("AlternativeCastKeyword::Mutate"); out^ = .Mutate
	case "Spectacle": when COVERAGE do cov_hit("AlternativeCastKeyword::Spectacle"); out^ = .Spectacle
	case "Prowl": when COVERAGE do cov_hit("AlternativeCastKeyword::Prowl"); out^ = .Prowl
	case "FaceDown": when COVERAGE do cov_hit("AlternativeCastKeyword::FaceDown"); out^ = .FaceDown
