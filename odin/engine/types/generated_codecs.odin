	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("AttachmentSnapshot.object_id") } else { return fail("AttachmentSnapshot.object_id missing") }
	if fv, found := get_any(v, "identity"); found { if !dec_opt_ObjectIncarnationRef(fv, &out.identity) do return fail("AttachmentSnapshot.identity") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("AttachmentSnapshot.controller") } else { return fail("AttachmentSnapshot.controller missing") }
	if fv, found := get_any(v, "kind"); found { if !decode_AttachmentKind(fv, &out.kind) do return fail("AttachmentSnapshot.kind") } else { return fail("AttachmentSnapshot.kind missing") }
	return true
}

