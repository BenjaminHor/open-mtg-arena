decode_PlayerActionKind :: proc(v: json.Value, out: ^PlayerActionKind) -> bool {
	when COVERAGE do cov_hit("PlayerActionKind")
	if v.kind != .String do return fail("PlayerActionKind: not a string")
	str := v.text
	switch str {
	case "AcceptedOptionalEffect": when COVERAGE do cov_hit("PlayerActionKind::AcceptedOptionalEffect"); out^ = .AcceptedOptionalEffect
	case "SearchedLibrary": when COVERAGE do cov_hit("PlayerActionKind::SearchedLibrary"); out^ = .SearchedLibrary
	case "Scry": when COVERAGE do cov_hit("PlayerActionKind::Scry"); out^ = .Scry
	case "Surveil": when COVERAGE do cov_hit("PlayerActionKind::Surveil"); out^ = .Surveil
	case "CollectEvidence": when COVERAGE do cov_hit("PlayerActionKind::CollectEvidence"); out^ = .CollectEvidence
	case "ShuffledLibrary": when COVERAGE do cov_hit("PlayerActionKind::ShuffledLibrary"); out^ = .ShuffledLibrary
	case "Proliferate": when COVERAGE do cov_hit("PlayerActionKind::Proliferate"); out^ = .Proliferate
	case "Investigate": when COVERAGE do cov_hit("PlayerActionKind::Investigate"); out^ = .Investigate
	case "Forage": when COVERAGE do cov_hit("PlayerActionKind::Forage"); out^ = .Forage
	case "Draw": when COVERAGE do cov_hit("PlayerActionKind::Draw"); out^ = .Draw
	case: return fail("PlayerActionKind: unknown variant")
	}
	return true
}

encode_PlayerActionKind :: proc(b: ^strings.Builder, x: PlayerActionKind) {
	@(static, rodata) NAMES := [PlayerActionKind]string{
		.AcceptedOptionalEffect = "AcceptedOptionalEffect",
		.SearchedLibrary = "SearchedLibrary",
		.Scry = "Scry",
		.Surveil = "Surveil",
		.CollectEvidence = "CollectEvidence",
		.ShuffledLibrary = "ShuffledLibrary",
		.Proliferate = "Proliferate",
		.Investigate = "Investigate",
		.Forage = "Forage",
		.Draw = "Draw",
	}
	json.write_string(b, NAMES[x])
}

