encode_ManaProduction :: proc(b: ^strings.Builder, x: ManaProduction) {
	#partial switch y in x {
	case ManaProduction_Fixed: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Fixed")
	member(b, first, "colors"); enc_dyn_ManaColor(b, y.colors)
	if !(skip_ManaProduction_is_default_mana_contribution_ManaContribution(y.contribution)) { member(b, first, "contribution"); encode_ManaContribution(b, y.contribution) }
	}; strings.write_byte(b, '}')
	case ManaProduction_Colorless: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Colorless")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	case ManaProduction_Mixed: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Mixed")
	member(b, first, "colorless_count"); encode_u32(b, y.colorless_count)
	member(b, first, "colors"); enc_dyn_ManaColor(b, y.colors)
	}; strings.write_byte(b, '}')
	case ManaProduction_AnyOneColor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AnyOneColor")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "color_options"); enc_dyn_ManaColor(b, y.color_options)
	if !(skip_ManaProduction_is_default_mana_contribution_ManaContribution(y.contribution)) { member(b, first, "contribution"); encode_ManaContribution(b, y.contribution) }
	}; strings.write_byte(b, '}')
	case ManaProduction_AnyCombination: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AnyCombination")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "color_options"); enc_dyn_ManaColor(b, y.color_options)
	}; strings.write_byte(b, '}')
	case ManaProduction_ChosenColor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChosenColor")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	if !(skip_ManaProduction_is_default_mana_contribution_ManaContribution(y.contribution)) { member(b, first, "contribution"); encode_ManaContribution(b, y.contribution) }
	if !(y.fixed_alternative == nil) { member(b, first, "fixed_alternative"); enc_opt_ManaColor(b, y.fixed_alternative) }
	}; strings.write_byte(b, '}')
	case ManaProduction_NotedType: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "NotedType")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	case ManaProduction_OpponentLandColors: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "OpponentLandColors")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	case ManaProduction_AnyCombinationOfObjectColors: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AnyCombinationOfObjectColors")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)
	}; strings.write_byte(b, '}')
	case ManaProduction_AnyTypeProduceableBy: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AnyTypeProduceableBy")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "land_filter"); encode_TargetFilter(b, y.land_filter)
	}; strings.write_byte(b, '}')
	case ManaProduction_ChoiceAmongExiledColors: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChoiceAmongExiledColors")
	member(b, first, "source"); encode_LinkedExileScope(b, y.source)
	}; strings.write_byte(b, '}')
	case ManaProduction_ChoiceAmongCombinations: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChoiceAmongCombinations")
	member(b, first, "options"); enc_dyn_dyn_ManaColor(b, y.options)
	}; strings.write_byte(b, '}')
	case ManaProduction_AnyInCommandersColorIdentity: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AnyInCommandersColorIdentity")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	if !(skip_ManaProduction_is_default_mana_contribution_ManaContribution(y.contribution)) { member(b, first, "contribution"); encode_ManaContribution(b, y.contribution) }
	}; strings.write_byte(b, '}')
	case ManaProduction_DistinctColorsAmongPermanents: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DistinctColorsAmongPermanents")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case ManaProduction_AnyOneColorAmongPermanents: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AnyOneColorAmongPermanents")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	if !(skip_ManaProduction_is_default_mana_contribution_ManaContribution(y.contribution)) { member(b, first, "contribution"); encode_ManaContribution(b, y.contribution) }
	}; strings.write_byte(b, '}')
	case ManaProduction_TriggerEventManaType: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TriggerEventManaType"); strings.write_byte(b, '}')
	}
}

encode_ManaProduction_members :: proc(b: ^strings.Builder, x: ManaProduction, first: ^bool) {
	#partial switch y in x {
	case ManaProduction_Fixed: member(b, first, "type"); json.write_string(b, "Fixed")
	member(b, first, "colors"); enc_dyn_ManaColor(b, y.colors)
	if !(skip_ManaProduction_is_default_mana_contribution_ManaContribution(y.contribution)) { member(b, first, "contribution"); encode_ManaContribution(b, y.contribution) }

	case ManaProduction_Colorless: member(b, first, "type"); json.write_string(b, "Colorless")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)

	case ManaProduction_Mixed: member(b, first, "type"); json.write_string(b, "Mixed")
	member(b, first, "colorless_count"); encode_u32(b, y.colorless_count)
	member(b, first, "colors"); enc_dyn_ManaColor(b, y.colors)

	case ManaProduction_AnyOneColor: member(b, first, "type"); json.write_string(b, "AnyOneColor")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "color_options"); enc_dyn_ManaColor(b, y.color_options)
	if !(skip_ManaProduction_is_default_mana_contribution_ManaContribution(y.contribution)) { member(b, first, "contribution"); encode_ManaContribution(b, y.contribution) }

	case ManaProduction_AnyCombination: member(b, first, "type"); json.write_string(b, "AnyCombination")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "color_options"); enc_dyn_ManaColor(b, y.color_options)

	case ManaProduction_ChosenColor: member(b, first, "type"); json.write_string(b, "ChosenColor")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	if !(skip_ManaProduction_is_default_mana_contribution_ManaContribution(y.contribution)) { member(b, first, "contribution"); encode_ManaContribution(b, y.contribution) }
	if !(y.fixed_alternative == nil) { member(b, first, "fixed_alternative"); enc_opt_ManaColor(b, y.fixed_alternative) }

	case ManaProduction_NotedType: member(b, first, "type"); json.write_string(b, "NotedType")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)

	case ManaProduction_OpponentLandColors: member(b, first, "type"); json.write_string(b, "OpponentLandColors")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)

	case ManaProduction_AnyCombinationOfObjectColors: member(b, first, "type"); json.write_string(b, "AnyCombinationOfObjectColors")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)

	case ManaProduction_AnyTypeProduceableBy: member(b, first, "type"); json.write_string(b, "AnyTypeProduceableBy")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "land_filter"); encode_TargetFilter(b, y.land_filter)

	case ManaProduction_ChoiceAmongExiledColors: member(b, first, "type"); json.write_string(b, "ChoiceAmongExiledColors")
	member(b, first, "source"); encode_LinkedExileScope(b, y.source)

	case ManaProduction_ChoiceAmongCombinations: member(b, first, "type"); json.write_string(b, "ChoiceAmongCombinations")
	member(b, first, "options"); enc_dyn_dyn_ManaColor(b, y.options)

	case ManaProduction_AnyInCommandersColorIdentity: member(b, first, "type"); json.write_string(b, "AnyInCommandersColorIdentity")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	if !(skip_ManaProduction_is_default_mana_contribution_ManaContribution(y.contribution)) { member(b, first, "contribution"); encode_ManaContribution(b, y.contribution) }

	case ManaProduction_DistinctColorsAmongPermanents: member(b, first, "type"); json.write_string(b, "DistinctColorsAmongPermanents")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case ManaProduction_AnyOneColorAmongPermanents: member(b, first, "type"); json.write_string(b, "AnyOneColorAmongPermanents")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	if !(skip_ManaProduction_is_default_mana_contribution_ManaContribution(y.contribution)) { member(b, first, "contribution"); encode_ManaContribution(b, y.contribution) }

	case ManaProduction_TriggerEventManaType: _ = y; member(b, first, "type"); json.write_string(b, "TriggerEventManaType")
	}
}

decode_ManaSpendRestriction :: proc(v: json.Value, out: ^ManaSpendRestriction) -> bool {
	when COVERAGE do cov_hit("ManaSpendRestriction")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ManaSpendRestriction: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ManaSpendRestriction: not a string or object")
	}
	switch variant {
	case "SpellOnly": when COVERAGE do cov_hit("ManaSpendRestriction::SpellOnly"); out^ = ManaSpendRestriction_SpellOnly{}
	case "SpellType": when COVERAGE do cov_hit("ManaSpendRestriction::SpellType"); tmp: ManaSpendRestriction_SpellType; if !decode_string(body, &tmp._0) do return fail("ManaSpendRestriction::SpellType"); out^ = tmp
	case "ChosenCreatureType": when COVERAGE do cov_hit("ManaSpendRestriction::ChosenCreatureType"); out^ = ManaSpendRestriction_ChosenCreatureType{}
	case "SpellTypeOrAbilityActivation": when COVERAGE do cov_hit("ManaSpendRestriction::SpellTypeOrAbilityActivation");
		tmp: ManaSpendRestriction_SpellTypeOrAbilityActivation
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaSpendRestriction_SpellTypeOrAbilityActivation) -> bool {
	if fv, found := get_any(v, "spell_type"); found { if !decode_string(fv, &out.spell_type) do return fail("ManaSpendRestriction::SpellTypeOrAbilityActivation.spell_type") } else { return fail("ManaSpendRestriction::SpellTypeOrAbilityActivation.spell_type missing") }
	if fv, found := get_any(v, "ability"); found { if !decode_AbilityActivationScope(fv, &out.ability) do return fail("ManaSpendRestriction::SpellTypeOrAbilityActivation.ability") } else { return fail("ManaSpendRestriction::SpellTypeOrAbilityActivation.ability missing") }
	return true
		}) { return fail("ManaSpendRestriction::SpellTypeOrAbilityActivation") }
		out^ = tmp
	case "ActivateOnly": when COVERAGE do cov_hit("ManaSpendRestriction::ActivateOnly"); out^ = ManaSpendRestriction_ActivateOnly{}
	case "ActivateTagged": when COVERAGE do cov_hit("ManaSpendRestriction::ActivateTagged"); tmp: ManaSpendRestriction_ActivateTagged; if !decode_AbilityTag(body, &tmp._0) do return fail("ManaSpendRestriction::ActivateTagged"); out^ = tmp
	case "XCostOnly": when COVERAGE do cov_hit("ManaSpendRestriction::XCostOnly"); out^ = ManaSpendRestriction_XCostOnly{}
	case "SpellWithKeywordKind": when COVERAGE do cov_hit("ManaSpendRestriction::SpellWithKeywordKind"); tmp: ManaSpendRestriction_SpellWithKeywordKind; if !decode_KeywordKind(body, &tmp._0) do return fail("ManaSpendRestriction::SpellWithKeywordKind"); out^ = tmp
	case "SpellWithKeywordKindFromZone": when COVERAGE do cov_hit("ManaSpendRestriction::SpellWithKeywordKindFromZone");
		tmp: ManaSpendRestriction_SpellWithKeywordKindFromZone
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaSpendRestriction_SpellWithKeywordKindFromZone) -> bool {
	if fv, found := get_any(v, "kind"); found { if !decode_KeywordKind(fv, &out.kind) do return fail("ManaSpendRestriction::SpellWithKeywordKindFromZone.kind") } else { return fail("ManaSpendRestriction::SpellWithKeywordKindFromZone.kind missing") }
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("ManaSpendRestriction::SpellWithKeywordKindFromZone.zone") } else { return fail("ManaSpendRestriction::SpellWithKeywordKindFromZone.zone missing") }
	return true
		}) { return fail("ManaSpendRestriction::SpellWithKeywordKindFromZone") }
		out^ = tmp
	case "SpellWithManaValue": when COVERAGE do cov_hit("ManaSpendRestriction::SpellWithManaValue");
		tmp: ManaSpendRestriction_SpellWithManaValue
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaSpendRestriction_SpellWithManaValue) -> bool {
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("ManaSpendRestriction::SpellWithManaValue.comparator") } else { return fail("ManaSpendRestriction::SpellWithManaValue.comparator missing") }
	if fv, found := get_any(v, "value"); found { if !decode_u32(fv, &out.value) do return fail("ManaSpendRestriction::SpellWithManaValue.value") } else { return fail("ManaSpendRestriction::SpellWithManaValue.value missing") }
	return true
		}) { return fail("ManaSpendRestriction::SpellWithManaValue") }
		out^ = tmp
	case "SpellMatchingCostCriteria": when COVERAGE do cov_hit("ManaSpendRestriction::SpellMatchingCostCriteria");
		tmp: ManaSpendRestriction_SpellMatchingCostCriteria
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaSpendRestriction_SpellMatchingCostCriteria) -> bool {
	if fv, found := get_any(v, "spell_type"); found { if !dec_opt_string(fv, &out.spell_type) do return fail("ManaSpendRestriction::SpellMatchingCostCriteria.spell_type") }
	if fv, found := get_any(v, "criteria"); found { if !dec_dyn_SpellCostCriterion(fv, &out.criteria) do return fail("ManaSpendRestriction::SpellMatchingCostCriteria.criteria") } else { return fail("ManaSpendRestriction::SpellMatchingCostCriteria.criteria missing") }
	return true
		}) { return fail("ManaSpendRestriction::SpellMatchingCostCriteria") }
		out^ = tmp
	case "SpellWithColorCount": when COVERAGE do cov_hit("ManaSpendRestriction::SpellWithColorCount");
		tmp: ManaSpendRestriction_SpellWithColorCount
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaSpendRestriction_SpellWithColorCount) -> bool {
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("ManaSpendRestriction::SpellWithColorCount.comparator") } else { return fail("ManaSpendRestriction::SpellWithColorCount.comparator missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("ManaSpendRestriction::SpellWithColorCount.count") } else { return fail("ManaSpendRestriction::SpellWithColorCount.count missing") }
	return true
		}) { return fail("ManaSpendRestriction::SpellWithColorCount") }
		out^ = tmp
	case "SpellOfSourceChosenColor": when COVERAGE do cov_hit("ManaSpendRestriction::SpellOfSourceChosenColor"); out^ = ManaSpendRestriction_SpellOfSourceChosenColor{}
	case "SpellFromZone": when COVERAGE do cov_hit("ManaSpendRestriction::SpellFromZone"); tmp: ManaSpendRestriction_SpellFromZone; if !decode_ZoneSpend(body, &tmp._0) do return fail("ManaSpendRestriction::SpellFromZone"); out^ = tmp
	case "CannotCastSpellFromZone": when COVERAGE do cov_hit("ManaSpendRestriction::CannotCastSpellFromZone"); tmp: ManaSpendRestriction_CannotCastSpellFromZone; if !decode_Zone(body, &tmp._0) do return fail("ManaSpendRestriction::CannotCastSpellFromZone"); out^ = tmp
	case "UnlockDoor": when COVERAGE do cov_hit("ManaSpendRestriction::UnlockDoor"); out^ = ManaSpendRestriction_UnlockDoor{}
	case "FaceDownSpell": when COVERAGE do cov_hit("ManaSpendRestriction::FaceDownSpell"); out^ = ManaSpendRestriction_FaceDownSpell{}
	case "TurnPermanentFaceUp": when COVERAGE do cov_hit("ManaSpendRestriction::TurnPermanentFaceUp"); out^ = ManaSpendRestriction_TurnPermanentFaceUp{}
	case "Any": when COVERAGE do cov_hit("ManaSpendRestriction::Any"); tmp: ManaSpendRestriction_Any; if !dec_dyn_ManaSpendRestriction(body, &tmp._0) do return fail("ManaSpendRestriction::Any"); out^ = tmp
	case: return fail("ManaSpendRestriction: unknown variant")
	}
	return true
}

encode_ManaSpendRestriction :: proc(b: ^strings.Builder, x: ManaSpendRestriction) {
	#partial switch y in x {
	case ManaSpendRestriction_SpellOnly: _ = y; json.write_string(b, "SpellOnly")
	case ManaSpendRestriction_SpellType: strings.write_byte(b, '{'); json.write_string(b, "SpellType"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	case ManaSpendRestriction_ChosenCreatureType: _ = y; json.write_string(b, "ChosenCreatureType")
	case ManaSpendRestriction_SpellTypeOrAbilityActivation: strings.write_byte(b, '{'); json.write_string(b, "SpellTypeOrAbilityActivation"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "spell_type"); encode_string(b, y.spell_type)
	member(b, first, "ability"); encode_AbilityActivationScope(b, y.ability)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaSpendRestriction_ActivateOnly: _ = y; json.write_string(b, "ActivateOnly")
	case ManaSpendRestriction_ActivateTagged: strings.write_byte(b, '{'); json.write_string(b, "ActivateTagged"); strings.write_byte(b, ':'); encode_AbilityTag(b, y._0); strings.write_byte(b, '}')
	case ManaSpendRestriction_XCostOnly: _ = y; json.write_string(b, "XCostOnly")
	case ManaSpendRestriction_SpellWithKeywordKind: strings.write_byte(b, '{'); json.write_string(b, "SpellWithKeywordKind"); strings.write_byte(b, ':'); encode_KeywordKind(b, y._0); strings.write_byte(b, '}')
	case ManaSpendRestriction_SpellWithKeywordKindFromZone: strings.write_byte(b, '{'); json.write_string(b, "SpellWithKeywordKindFromZone"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "kind"); encode_KeywordKind(b, y.kind)
	member(b, first, "zone"); encode_Zone(b, y.zone)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaSpendRestriction_SpellWithManaValue: strings.write_byte(b, '{'); json.write_string(b, "SpellWithManaValue"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_u32(b, y.value)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaSpendRestriction_SpellMatchingCostCriteria: strings.write_byte(b, '{'); json.write_string(b, "SpellMatchingCostCriteria"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	if !(y.spell_type == nil) { member(b, first, "spell_type"); enc_opt_string(b, y.spell_type) }
	member(b, first, "criteria"); enc_dyn_SpellCostCriterion(b, y.criteria)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaSpendRestriction_SpellWithColorCount: strings.write_byte(b, '{'); json.write_string(b, "SpellWithColorCount"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaSpendRestriction_SpellOfSourceChosenColor: _ = y; json.write_string(b, "SpellOfSourceChosenColor")
	case ManaSpendRestriction_SpellFromZone: strings.write_byte(b, '{'); json.write_string(b, "SpellFromZone"); strings.write_byte(b, ':'); encode_ZoneSpend(b, y._0); strings.write_byte(b, '}')
	case ManaSpendRestriction_CannotCastSpellFromZone: strings.write_byte(b, '{'); json.write_string(b, "CannotCastSpellFromZone"); strings.write_byte(b, ':'); encode_Zone(b, y._0); strings.write_byte(b, '}')
	case ManaSpendRestriction_UnlockDoor: _ = y; json.write_string(b, "UnlockDoor")
	case ManaSpendRestriction_FaceDownSpell: _ = y; json.write_string(b, "FaceDownSpell")
	case ManaSpendRestriction_TurnPermanentFaceUp: _ = y; json.write_string(b, "TurnPermanentFaceUp")
	case ManaSpendRestriction_Any: strings.write_byte(b, '{'); json.write_string(b, "Any"); strings.write_byte(b, ':'); enc_dyn_ManaSpendRestriction(b, y._0); strings.write_byte(b, '}')
	}
}

decode_ManaSpellGrant :: proc(v: json.Value, out: ^ManaSpellGrant) -> bool {
	when COVERAGE do cov_hit("ManaSpellGrant")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ManaSpellGrant: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ManaSpellGrant: not a string or object")
	}
	switch variant {
	case "CantBeCountered": when COVERAGE do cov_hit("ManaSpellGrant::CantBeCountered");
		tmp: ManaSpellGrant_CantBeCountered
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaSpellGrant_CantBeCountered) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("ManaSpellGrant::CantBeCountered.filter") } else { return fail("ManaSpellGrant::CantBeCountered.filter missing") }
	return true
		}) { return fail("ManaSpellGrant::CantBeCountered") }
		out^ = tmp
	case "EntersWithCounters": when COVERAGE do cov_hit("ManaSpellGrant::EntersWithCounters");
		tmp: ManaSpellGrant_EntersWithCounters
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaSpellGrant_EntersWithCounters) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("ManaSpellGrant::EntersWithCounters.filter") } else { return fail("ManaSpellGrant::EntersWithCounters.filter missing") }
	if fv, found := get_any(v, "counter_type"); found { if !decode_CounterType(fv, &out.counter_type) do return fail("ManaSpellGrant::EntersWithCounters.counter_type") } else { return fail("ManaSpellGrant::EntersWithCounters.counter_type missing") }
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("ManaSpellGrant::EntersWithCounters.count") } else { return fail("ManaSpellGrant::EntersWithCounters.count missing") }
	return true
		}) { return fail("ManaSpellGrant::EntersWithCounters") }
		out^ = tmp
	case "AddKeywordUntilEndOfTurn": when COVERAGE do cov_hit("ManaSpellGrant::AddKeywordUntilEndOfTurn");
		tmp: ManaSpellGrant_AddKeywordUntilEndOfTurn
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaSpellGrant_AddKeywordUntilEndOfTurn) -> bool {
	if fv, found := get_any(v, "keyword"); found { if !decode_Keyword(fv, &out.keyword) do return fail("ManaSpellGrant::AddKeywordUntilEndOfTurn.keyword") } else { return fail("ManaSpellGrant::AddKeywordUntilEndOfTurn.keyword missing") }
	if fv, found := get_any(v, "restriction"); found { if !dec_opt_ManaRestriction(fv, &out.restriction) do return fail("ManaSpellGrant::AddKeywordUntilEndOfTurn.restriction") }
	if fv, found := get_any(v, "duration"); found { if !dec_ptr_Duration(fv, &out.duration) do return fail("ManaSpellGrant::AddKeywordUntilEndOfTurn.duration") } else { out.duration = default_ManaSpellGrant_default_mana_keyword_grant_duration() }
	return true
		}) { return fail("ManaSpellGrant::AddKeywordUntilEndOfTurn") }
		out^ = tmp
	case "TriggerOnSpend": when COVERAGE do cov_hit("ManaSpellGrant::TriggerOnSpend");
		tmp: ManaSpellGrant_TriggerOnSpend
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaSpellGrant_TriggerOnSpend) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("ManaSpellGrant::TriggerOnSpend.filter") } else { return fail("ManaSpellGrant::TriggerOnSpend.filter missing") }
	if fv, found := get_any(v, "ability"); found { if !dec_ptr_AbilityDefinition(fv, &out.ability) do return fail("ManaSpellGrant::TriggerOnSpend.ability") } else { return fail("ManaSpellGrant::TriggerOnSpend.ability missing") }
	return true
		}) { return fail("ManaSpellGrant::TriggerOnSpend") }
		out^ = tmp
	case: return fail("ManaSpellGrant: unknown variant")
	}
	return true
}

encode_ManaSpellGrant :: proc(b: ^strings.Builder, x: ManaSpellGrant) {
	#partial switch y in x {
	case ManaSpellGrant_CantBeCountered: strings.write_byte(b, '{'); json.write_string(b, "CantBeCountered"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaSpellGrant_EntersWithCounters: strings.write_byte(b, '{'); json.write_string(b, "EntersWithCounters"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
