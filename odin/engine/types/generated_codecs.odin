	encode_PendingActivationTriggerCollection_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PendingActivationTriggerCollection_members :: proc(b: ^strings.Builder, x: PendingActivationTriggerCollection, first: ^bool) {
	member(b, first, "overlay"); encode_TriggerCollectionOverlay(b, x.overlay)
	member(b, first, "operation_journal"); enc_dyn_TriggerCollectionOperation(b, x.operation_journal)
	member(b, first, "pending_contexts"); enc_dyn_PendingTriggerContext(b, x.pending_contexts)
}

