decode_SideboardPolicy :: proc(v: json.Value, out: ^SideboardPolicy) -> bool {
	when COVERAGE do cov_hit("SideboardPolicy")
	if v.kind != .Object do return fail("SideboardPolicy: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("SideboardPolicy: no tag")
	switch tv.text {
	case "Forbidden": when COVERAGE do cov_hit("SideboardPolicy::Forbidden"); out^ = SideboardPolicy_Forbidden{}
	case "Limited": when COVERAGE do cov_hit("SideboardPolicy::Limited"); tmp: SideboardPolicy_Limited; if !decode_u32(json.get_or_null(v, "data"), &tmp._0) do return fail("SideboardPolicy::Limited"); out^ = tmp
	case "Unlimited": when COVERAGE do cov_hit("SideboardPolicy::Unlimited"); out^ = SideboardPolicy_Unlimited{}
	case: return fail("SideboardPolicy: unknown variant")
	}
	return true
}

encode_SideboardPolicy :: proc(b: ^strings.Builder, x: SideboardPolicy) {
	#partial switch y in x {
	case SideboardPolicy_Forbidden: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Forbidden"); strings.write_byte(b, '}')
	case SideboardPolicy_Limited: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Limited"); member(b, &f, "data"); encode_u32(b, y._0); strings.write_byte(b, '}')
	case SideboardPolicy_Unlimited: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Unlimited"); strings.write_byte(b, '}')
	}
}

decode_HordeRuleset :: proc(v: json.Value, out: ^HordeRuleset) -> bool {
	when COVERAGE do cov_hit("HordeRuleset")
	if v.kind != .Object do return fail("HordeRuleset: not an object")
	if fv, found := get_any(v, "challenge_deck"); found { if !decode_ChallengeDeck(fv, &out.challenge_deck) do return fail("HordeRuleset.challenge_deck") } else { return fail("HordeRuleset.challenge_deck missing") }
	if fv, found := get_any(v, "wave"); found { if !decode_WaveTermination(fv, &out.wave) do return fail("HordeRuleset.wave") } else { return fail("HordeRuleset.wave missing") }
	if fv, found := get_any(v, "survivor_setup_turns"); found { if !decode_u8(fv, &out.survivor_setup_turns) do return fail("HordeRuleset.survivor_setup_turns") } else { return fail("HordeRuleset.survivor_setup_turns missing") }
	if fv, found := get_any(v, "combined_base_life"); found { if !decode_i32(fv, &out.combined_base_life) do return fail("HordeRuleset.combined_base_life") } else { return fail("HordeRuleset.combined_base_life missing") }
	if fv, found := get_any(v, "per_extra_survivor_life_delta"); found { if !decode_i32(fv, &out.per_extra_survivor_life_delta) do return fail("HordeRuleset.per_extra_survivor_life_delta") } else { return fail("HordeRuleset.per_extra_survivor_life_delta missing") }
	if fv, found := get_any(v, "horde_creatures_forced_attackers"); found { if !decode_bool(fv, &out.horde_creatures_forced_attackers) do return fail("HordeRuleset.horde_creatures_forced_attackers") } else { return fail("HordeRuleset.horde_creatures_forced_attackers missing") }
	if fv, found := get_any(v, "horde_creatures_haste"); found { if !decode_bool(fv, &out.horde_creatures_haste) do return fail("HordeRuleset.horde_creatures_haste") } else { out.horde_creatures_haste = default_HordeRuleset_default_horde_haste_fallback() }
	if fv, found := get_any(v, "legendary_death"); found { if !decode_HordeLegendaryDeath(fv, &out.legendary_death) do return fail("HordeRuleset.legendary_death") }
	if fv, found := get_any(v, "post_combat_activation"); found { if !decode_HordePostCombatActivation(fv, &out.post_combat_activation) do return fail("HordeRuleset.post_combat_activation") }
	if fv, found := get_any(v, "survivor_deck_format"); found { if !decode_SurvivorDeckFormat(fv, &out.survivor_deck_format) do return fail("HordeRuleset.survivor_deck_format") }
	if fv, found := get_any(v, "co_horde_decks"); found { if !dec_dyn_ChallengeDeck(fv, &out.co_horde_decks) do return fail("HordeRuleset.co_horde_decks") }
	if fv, found := get_any(v, "boss_stages"); found { if !dec_opt_BossStages(fv, &out.boss_stages) do return fail("HordeRuleset.boss_stages") }
	return true
}

encode_HordeRuleset :: proc(b: ^strings.Builder, x: HordeRuleset) {
	strings.write_byte(b, '{')
	f := true
	encode_HordeRuleset_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_HordeRuleset_members :: proc(b: ^strings.Builder, x: HordeRuleset, first: ^bool) {
	member(b, first, "challenge_deck"); encode_ChallengeDeck(b, x.challenge_deck)
	member(b, first, "wave"); encode_WaveTermination(b, x.wave)
	member(b, first, "survivor_setup_turns"); encode_u8(b, x.survivor_setup_turns)
	member(b, first, "combined_base_life"); encode_i32(b, x.combined_base_life)
	member(b, first, "per_extra_survivor_life_delta"); encode_i32(b, x.per_extra_survivor_life_delta)
	member(b, first, "horde_creatures_forced_attackers"); encode_bool(b, x.horde_creatures_forced_attackers)
	member(b, first, "horde_creatures_haste"); encode_bool(b, x.horde_creatures_haste)
	member(b, first, "legendary_death"); encode_HordeLegendaryDeath(b, x.legendary_death)
	member(b, first, "post_combat_activation"); encode_HordePostCombatActivation(b, x.post_combat_activation)
	member(b, first, "survivor_deck_format"); encode_SurvivorDeckFormat(b, x.survivor_deck_format)
	if !((len(x.co_horde_decks) == 0)) { member(b, first, "co_horde_decks"); enc_dyn_ChallengeDeck(b, x.co_horde_decks) }
	if !(x.boss_stages == nil) { member(b, first, "boss_stages"); enc_opt_BossStages(b, x.boss_stages) }
}

