		.Turn = "Turn",
		.Stack = "Stack",
		.Combat = "Combat",
		.Zone = "Zone",
		.Life = "Life",
		.Mana = "Mana",
		.State = "State",
		.Token = "Token",
		.Trigger = "Trigger",
		.Special = "Special",
		.Destroy = "Destroy",
		.Debug = "Debug",
	}
	json.write_string(b, NAMES[x])
}

decode_LogSegment :: proc(v: json.Value, out: ^LogSegment) -> bool {
	when COVERAGE do cov_hit("LogSegment")
	if v.kind != .Object do return fail("LogSegment: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("LogSegment: no tag")
	switch tv.text {
	case "Text": when COVERAGE do cov_hit("LogSegment::Text"); tmp: LogSegment_Text; if !decode_string(json.get_or_null(v, "value"), &tmp._0) do return fail("LogSegment::Text"); out^ = tmp
	case "CardName": when COVERAGE do cov_hit("LogSegment::CardName");
		tmp: LogSegment_CardName
		if !decode_variant(json.get_or_null(v, "value"), &tmp, proc(v: json.Value, out: ^LogSegment_CardName) -> bool {
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("LogSegment::CardName.name") } else { return fail("LogSegment::CardName.name missing") }
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("LogSegment::CardName.object_id") } else { return fail("LogSegment::CardName.object_id missing") }
	return true
		}) { return fail("LogSegment::CardName") }
		out^ = tmp
	case "PlayerName": when COVERAGE do cov_hit("LogSegment::PlayerName");
		tmp: LogSegment_PlayerName
		if !decode_variant(json.get_or_null(v, "value"), &tmp, proc(v: json.Value, out: ^LogSegment_PlayerName) -> bool {
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("LogSegment::PlayerName.name") } else { return fail("LogSegment::PlayerName.name missing") }
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("LogSegment::PlayerName.player_id") } else { return fail("LogSegment::PlayerName.player_id missing") }
	return true
		}) { return fail("LogSegment::PlayerName") }
		out^ = tmp
	case "Number": when COVERAGE do cov_hit("LogSegment::Number"); tmp: LogSegment_Number; if !decode_i32(json.get_or_null(v, "value"), &tmp._0) do return fail("LogSegment::Number"); out^ = tmp
	case "Mana": when COVERAGE do cov_hit("LogSegment::Mana"); tmp: LogSegment_Mana; if !decode_string(json.get_or_null(v, "value"), &tmp._0) do return fail("LogSegment::Mana"); out^ = tmp
	case "Zone": when COVERAGE do cov_hit("LogSegment::Zone"); tmp: LogSegment_Zone; if !decode_Zone(json.get_or_null(v, "value"), &tmp._0) do return fail("LogSegment::Zone"); out^ = tmp
	case "Keyword": when COVERAGE do cov_hit("LogSegment::Keyword"); tmp: LogSegment_Keyword; if !decode_string(json.get_or_null(v, "value"), &tmp._0) do return fail("LogSegment::Keyword"); out^ = tmp
	case: return fail("LogSegment: unknown variant")
	}
	return true
}

encode_LogSegment :: proc(b: ^strings.Builder, x: LogSegment) {
	#partial switch y in x {
	case LogSegment_Text: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Text"); member(b, &f, "value"); encode_string(b, y._0); strings.write_byte(b, '}')
	case LogSegment_CardName: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CardName"); member(b, &f, "value"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "name"); encode_string(b, y.name)
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case LogSegment_PlayerName: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PlayerName"); member(b, &f, "value"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "name"); encode_string(b, y.name)
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case LogSegment_Number: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Number"); member(b, &f, "value"); encode_i32(b, y._0); strings.write_byte(b, '}')
	case LogSegment_Mana: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Mana"); member(b, &f, "value"); encode_string(b, y._0); strings.write_byte(b, '}')
	case LogSegment_Zone: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Zone"); member(b, &f, "value"); encode_Zone(b, y._0); strings.write_byte(b, '}')
	case LogSegment_Keyword: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Keyword"); member(b, &f, "value"); encode_string(b, y._0); strings.write_byte(b, '}')
	}
}

