	if fv, found := get_any(v, "events"); found { if !dec_dyn_GameEvent(fv, &out.events) do return fail("TriggerCollectionOperation::PrepareEventBatch.events") } else { return fail("TriggerCollectionOperation::PrepareEventBatch.events missing") }
	return true
