	"ZoneRef::Library",
	"ZoneSpend",
	"ZoneSpendPolarity",
	"ZoneSpendPolarity::From",
	"ZoneSpendPolarity::NotFrom",
}

decode_CardExportEntry :: proc(v: json.Value, out: ^CardExportEntry) -> bool {
	when COVERAGE do cov_hit("CardExportEntry")
	if v.kind != .Object do return fail("CardExportEntry: not an object")
	if !decode_CardFace(v, &out.face) do return fail("CardExportEntry.face (flattened)")
	if fv, found := get_any(v, "legalities"); found { if !dec_map_string_string(fv, &out.legalities) do return fail("CardExportEntry.legalities") }
	if fv, found := get_any(v, "layout"); found { if !dec_opt_string(fv, &out.layout) do return fail("CardExportEntry.layout") }
	if fv, found := get_any(v, "face_index"); found { if !dec_opt_int(fv, &out.face_index) do return fail("CardExportEntry.face_index") }
	if fv, found := get_any(v, "printings"); found { if !dec_dyn_string(fv, &out.printings) do return fail("CardExportEntry.printings") }
	if fv, found := get_any(v, "rulings"); found { if !dec_dyn_Ruling(fv, &out.rulings) do return fail("CardExportEntry.rulings") }
	if fv, found := get_any(v, "bracket_signals"); found { if !decode_BracketSignals(fv, &out.bracket_signals) do return fail("CardExportEntry.bracket_signals") }
	return true
}

encode_CardExportEntry :: proc(b: ^strings.Builder, x: CardExportEntry) {
	strings.write_byte(b, '{')
	f := true
	encode_CardExportEntry_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CardExportEntry_members :: proc(b: ^strings.Builder, x: CardExportEntry, first: ^bool) {
	encode_CardFace_members(b, x.face, first)
	member(b, first, "legalities"); enc_map_string_string(b, x.legalities)
	if !(x.layout == nil) { member(b, first, "layout"); enc_opt_string(b, x.layout) }
	if !(x.face_index == nil) { member(b, first, "face_index"); enc_opt_int(b, x.face_index) }
	if !((len(x.printings) == 0)) { member(b, first, "printings"); enc_dyn_string(b, x.printings) }
	if !((len(x.rulings) == 0)) { member(b, first, "rulings"); enc_dyn_Ruling(b, x.rulings) }
	if !(skip_CardExportEntry_is_clean_signals_BracketSignals(x.bracket_signals)) { member(b, first, "bracket_signals"); encode_BracketSignals(b, x.bracket_signals) }
}

