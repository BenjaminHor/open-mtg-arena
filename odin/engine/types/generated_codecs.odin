	if fv, found := get_any(v, "target_id"); found { if !decode_ObjectId(fv, &out.target_id) do return fail("ProposedEvent::Attach.target_id") } else { return fail("ProposedEvent::Attach.target_id missing") }
	if fv, found := get_any(v, "applied"); found { if !dec_dyn_AppliedReplacementKey(fv, &out.applied) do return fail("ProposedEvent::Attach.applied") } else { return fail("ProposedEvent::Attach.applied missing") }
	return true
		}) { return fail("ProposedEvent::Attach") }
