		tmp: CastManaSpentMetric_FromSource
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CastManaSpentMetric_FromSource) -> bool {
	if fv, found := get_any(v, "source_filter"); found { if !decode_TargetFilter(fv, &out.source_filter) do return fail("CastManaSpentMetric::FromSource.source_filter") } else { return fail("CastManaSpentMetric::FromSource.source_filter missing") }
