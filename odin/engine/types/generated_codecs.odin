	if fv, found := get_any(v, "resolution_depth"); found { if !decode_int(fv, &out.resolution_depth) do return fail("ReplacementSubtreeBoundary.resolution_depth") } else { return fail("ReplacementSubtreeBoundary.resolution_depth missing") }
	if fv, found := get_any(v, "enclosing"); found { if !dec_opt_EnclosingPostReplacementFrame(fv, &out.enclosing) do return fail("ReplacementSubtreeBoundary.enclosing") }
	return true
}

encode_ReplacementSubtreeBoundary :: proc(b: ^strings.Builder, x: ReplacementSubtreeBoundary) {
