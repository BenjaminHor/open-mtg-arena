decode_ObjectProperty :: proc(v: json.Value, out: ^ObjectProperty) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ObjectProperty: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ObjectProperty: not a string or object")
	}
	switch variant {
	case "Power": out^ = ObjectProperty_Power{}
	case "Toughness": out^ = ObjectProperty_Toughness{}
	case "ManaValue": out^ = ObjectProperty_ManaValue{}
	case "ManaSymbolCount": tmp: ObjectProperty_ManaSymbolCount; if !decode_ManaColor(body, &tmp._0) do return fail("ObjectProperty::ManaSymbolCount"); out^ = tmp
	case: return fail("ObjectProperty: unknown variant")
	}
	return true
}

encode_ObjectProperty :: proc(b: ^strings.Builder, x: ObjectProperty) {
	#partial switch y in x {
	case ObjectProperty_Power: _ = y; json.write_string(b, "Power")
	case ObjectProperty_Toughness: _ = y; json.write_string(b, "Toughness")
	case ObjectProperty_ManaValue: _ = y; json.write_string(b, "ManaValue")
	case ObjectProperty_ManaSymbolCount: strings.write_byte(b, '{'); json.write_string(b, "ManaSymbolCount"); strings.write_byte(b, ':'); encode_ManaColor(b, y._0); strings.write_byte(b, '}')
	}
}

decode_TapCreaturesRequirement :: proc(v: json.Value, out: ^TapCreaturesRequirement) -> bool {
	if v.kind != .Object do return fail("TapCreaturesRequirement: not an object")
	tv, found := json.get(v, "requirement")
	if !found || tv.kind != .String do return fail("TapCreaturesRequirement: no tag")
	switch tv.text {
	case "count":
		tmp: TapCreaturesRequirement_Count
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TapCreaturesRequirement_Count) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("TapCreaturesRequirement::Count.count") } else { out.count = default_TapCreaturesRequirement_default_one() }
	return true
		}) { return fail("TapCreaturesRequirement::Count") }
		out^ = tmp
	case "aggregate":
		tmp: TapCreaturesRequirement_Aggregate
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TapCreaturesRequirement_Aggregate) -> bool {
	if fv, found := get_any(v, "stat"); found { if !decode_TapCreaturesAggregateStat(fv, &out.stat) do return fail("TapCreaturesRequirement::Aggregate.stat") } else { return fail("TapCreaturesRequirement::Aggregate.stat missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("TapCreaturesRequirement::Aggregate.comparator") } else { return fail("TapCreaturesRequirement::Aggregate.comparator missing") }
	if fv, found := get_any(v, "value"); found { if !decode_i32(fv, &out.value) do return fail("TapCreaturesRequirement::Aggregate.value") } else { return fail("TapCreaturesRequirement::Aggregate.value missing") }
	if fv, found := get_any(v, "collective"); found { if !decode_bool(fv, &out.collective) do return fail("TapCreaturesRequirement::Aggregate.collective") }
	return true
		}) { return fail("TapCreaturesRequirement::Aggregate") }
		out^ = tmp
	case: return fail("TapCreaturesRequirement: unknown variant")
	}
	return true
}

encode_TapCreaturesRequirement :: proc(b: ^strings.Builder, x: TapCreaturesRequirement) {
	#partial switch y in x {
	case TapCreaturesRequirement_Count: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "requirement"); json.write_string(b, "count")
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}')
	case TapCreaturesRequirement_Aggregate: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "requirement"); json.write_string(b, "aggregate")
	member(b, first, "stat"); encode_TapCreaturesAggregateStat(b, y.stat)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_i32(b, y.value)
	member(b, first, "collective"); encode_bool(b, y.collective)
	}; strings.write_byte(b, '}')
	}
}

encode_TapCreaturesRequirement_members :: proc(b: ^strings.Builder, x: TapCreaturesRequirement, first: ^bool) {
	#partial switch y in x {
	case TapCreaturesRequirement_Count: member(b, first, "requirement"); json.write_string(b, "count")
	member(b, first, "count"); encode_u32(b, y.count)

	case TapCreaturesRequirement_Aggregate: member(b, first, "requirement"); json.write_string(b, "aggregate")
	member(b, first, "stat"); encode_TapCreaturesAggregateStat(b, y.stat)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_i32(b, y.value)
	member(b, first, "collective"); encode_bool(b, y.collective)

	}
}

