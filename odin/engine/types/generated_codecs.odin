decode_HandSizeModification :: proc(v: json.Value, out: ^HandSizeModification) -> bool {
	when COVERAGE do cov_hit("HandSizeModification")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("HandSizeModification: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("HandSizeModification: not a string or object")
	}
	switch variant {
	case "SetTo": when COVERAGE do cov_hit("HandSizeModification::SetTo"); tmp: HandSizeModification_SetTo; if !decode_u32(body, &tmp._0) do return fail("HandSizeModification::SetTo"); out^ = tmp
	case "AdjustedBy": when COVERAGE do cov_hit("HandSizeModification::AdjustedBy"); tmp: HandSizeModification_AdjustedBy; if !decode_i32(body, &tmp._0) do return fail("HandSizeModification::AdjustedBy"); out^ = tmp
	case "EqualTo": when COVERAGE do cov_hit("HandSizeModification::EqualTo"); tmp: HandSizeModification_EqualTo; if !decode_QuantityExpr(body, &tmp._0) do return fail("HandSizeModification::EqualTo"); out^ = tmp
	case: return fail("HandSizeModification: unknown variant")
	}
	return true
}

encode_HandSizeModification :: proc(b: ^strings.Builder, x: HandSizeModification) {
	#partial switch y in x {
	case HandSizeModification_SetTo: strings.write_byte(b, '{'); json.write_string(b, "SetTo"); strings.write_byte(b, ':'); encode_u32(b, y._0); strings.write_byte(b, '}')
	case HandSizeModification_AdjustedBy: strings.write_byte(b, '{'); json.write_string(b, "AdjustedBy"); strings.write_byte(b, ':'); encode_i32(b, y._0); strings.write_byte(b, '}')
	case HandSizeModification_EqualTo: strings.write_byte(b, '{'); json.write_string(b, "EqualTo"); strings.write_byte(b, ':'); encode_QuantityExpr(b, y._0); strings.write_byte(b, '}')
	}
}

