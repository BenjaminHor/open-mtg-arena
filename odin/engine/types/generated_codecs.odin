decode_GameEvent :: proc(v: json.Value, out: ^GameEvent) -> bool {
	when COVERAGE do cov_hit("GameEvent")
	if v.kind != .Object do return fail("GameEvent: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("GameEvent: no tag")
	switch tv.text {
	case "GameStarted": when COVERAGE do cov_hit("GameEvent::GameStarted"); out^ = GameEvent_GameStarted{}
	case "HiddenSearchViewed": when COVERAGE do cov_hit("GameEvent::HiddenSearchViewed");
		tmp: GameEvent_HiddenSearchViewed
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameEvent_HiddenSearchViewed) -> bool {
	if fv, found := get_any(v, "searcher"); found { if !decode_PlayerId(fv, &out.searcher) do return fail("GameEvent::HiddenSearchViewed.searcher") } else { return fail("GameEvent::HiddenSearchViewed.searcher missing") }
	if fv, found := get_any(v, "cards"); found { if !dec_dyn_LibrarySearchCardView(fv, &out.cards) do return fail("GameEvent::HiddenSearchViewed.cards") } else { return fail("GameEvent::HiddenSearchViewed.cards missing") }
	if fv, found := get_any(v, "audience"); found { if !dec_dyn_PlayerId(fv, &out.audience) do return fail("GameEvent::HiddenSearchViewed.audience") } else { return fail("GameEvent::HiddenSearchViewed.audience missing") }
	return true
		}) { return fail("GameEvent::HiddenSearchViewed") }
		out^ = tmp
	case "TurnStarted": when COVERAGE do cov_hit("GameEvent::TurnStarted");
		tmp: GameEvent_TurnStarted
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameEvent_TurnStarted) -> bool {
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("GameEvent::TurnStarted.player_id") } else { return fail("GameEvent::TurnStarted.player_id missing") }
	if fv, found := get_any(v, "turn_number"); found { if !decode_u32(fv, &out.turn_number) do return fail("GameEvent::TurnStarted.turn_number") } else { return fail("GameEvent::TurnStarted.turn_number missing") }
	return true
		}) { return fail("GameEvent::TurnStarted") }
		out^ = tmp
	case "ExtraTurnCreated": when COVERAGE do cov_hit("GameEvent::ExtraTurnCreated");
		tmp: GameEvent_ExtraTurnCreated
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameEvent_ExtraTurnCreated) -> bool {
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("GameEvent::ExtraTurnCreated.player_id") } else { return fail("GameEvent::ExtraTurnCreated.player_id missing") }
	if fv, found := get_any(v, "anchor"); found { if !decode_PlayerId(fv, &out.anchor) do return fail("GameEvent::ExtraTurnCreated.anchor") } else { return fail("GameEvent::ExtraTurnCreated.anchor missing") }
	return true
		}) { return fail("GameEvent::ExtraTurnCreated") }
		out^ = tmp
	case "PhaseChanged": when COVERAGE do cov_hit("GameEvent::PhaseChanged");
		tmp: GameEvent_PhaseChanged
