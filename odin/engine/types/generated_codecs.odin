	if v.kind != .String do return fail("DiscardSelfScope: not a string")
	str := v.text
	switch str {
	case "FromHand": out^ = .FromHand
	case "SourceCard": out^ = .SourceCard
	case: return fail("DiscardSelfScope: unknown variant")
	}
	return true
}

encode_DiscardSelfScope :: proc(b: ^strings.Builder, x: DiscardSelfScope) {
	@(static, rodata) NAMES := [DiscardSelfScope]string{
		.FromHand = "FromHand",
		.SourceCard = "SourceCard",
	}
	json.write_string(b, NAMES[x])
}

