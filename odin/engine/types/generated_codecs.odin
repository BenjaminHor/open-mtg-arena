decode_PendingPlayerAction :: proc(v: json.Value, out: ^PendingPlayerAction) -> bool {
	when COVERAGE do cov_hit("PendingPlayerAction")
	if v.kind != .Object do return fail("PendingPlayerAction: not an object")
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("PendingPlayerAction.player_id") } else { return fail("PendingPlayerAction.player_id missing") }
	if fv, found := get_any(v, "action"); found { if !decode_PlayerActionKind(fv, &out.action) do return fail("PendingPlayerAction.action") } else { return fail("PendingPlayerAction.action missing") }
	return true
}

encode_PendingPlayerAction :: proc(b: ^strings.Builder, x: PendingPlayerAction) {
	strings.write_byte(b, '{')
	f := true
	encode_PendingPlayerAction_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PendingPlayerAction_members :: proc(b: ^strings.Builder, x: PendingPlayerAction, first: ^bool) {
	member(b, first, "player_id"); encode_PlayerId(b, x.player_id)
	member(b, first, "action"); encode_PlayerActionKind(b, x.action)
}

