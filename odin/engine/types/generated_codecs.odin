decode_TriggerCause :: proc(v: json.Value, out: ^TriggerCause) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("TriggerCause: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("TriggerCause: not a string or object")
	}
	switch variant {
	case "Any": out^ = TriggerCause_Any{}
	case "EntersBattlefield":
		tmp: TriggerCause_EntersBattlefield
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^TriggerCause_EntersBattlefield) -> bool {
	if fv, found := get_any(v, "core_types"); found { if !dec_dyn_CoreType(fv, &out.core_types) do return fail("TriggerCause::EntersBattlefield.core_types") }
	if fv, found := get_any(v, "entrant"); found { if !decode_CausingObject(fv, &out.entrant) do return fail("TriggerCause::EntersBattlefield.entrant") }
	return true
		}) { return fail("TriggerCause::EntersBattlefield") }
		out^ = tmp
	case "CreatureAttacking": out^ = TriggerCause_CreatureAttacking{}
	case "CreatureDying": out^ = TriggerCause_CreatureDying{}
	case "ControlledCreature":
		tmp: TriggerCause_ControlledCreature
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^TriggerCause_ControlledCreature) -> bool {
	if fv, found := get_any(v, "event"); found { if !decode_ControlledCreatureEvent(fv, &out.event) do return fail("TriggerCause::ControlledCreature.event") } else { return fail("TriggerCause::ControlledCreature.event missing") }
	return true
		}) { return fail("TriggerCause::ControlledCreature") }
		out^ = tmp
	case "ControllerCastOrCopiedSpell":
		tmp: TriggerCause_ControllerCastOrCopiedSpell
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^TriggerCause_ControllerCastOrCopiedSpell) -> bool {
	if fv, found := get_any(v, "core_types"); found { if !dec_dyn_CoreType(fv, &out.core_types) do return fail("TriggerCause::ControllerCastOrCopiedSpell.core_types") }
	return true
		}) { return fail("TriggerCause::ControllerCastOrCopiedSpell") }
		out^ = tmp
	case "RoomEntered": out^ = TriggerCause_RoomEntered{}
	case "PlayerAction":
		tmp: TriggerCause_PlayerAction
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^TriggerCause_PlayerAction) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerRelation(fv, &out.player) do return fail("TriggerCause::PlayerAction.player") } else { return fail("TriggerCause::PlayerAction.player missing") }
	if fv, found := get_any(v, "action"); found { if !decode_PlayerCauseAction(fv, &out.action) do return fail("TriggerCause::PlayerAction.action") } else { return fail("TriggerCause::PlayerAction.action missing") }
	return true
		}) { return fail("TriggerCause::PlayerAction") }
		out^ = tmp
	case "TurnedFaceUp": out^ = TriggerCause_TurnedFaceUp{}
	case "BattlefieldTransition":
		tmp: TriggerCause_BattlefieldTransition
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^TriggerCause_BattlefieldTransition) -> bool {
	if fv, found := get_any(v, "enter"); found { if !decode_bool(fv, &out.enter) do return fail("TriggerCause::BattlefieldTransition.enter") } else { out.enter = default_TriggerCause_default_true() }
	if fv, found := get_any(v, "leave"); found { if !decode_bool(fv, &out.leave) do return fail("TriggerCause::BattlefieldTransition.leave") }
	if fv, found := get_any(v, "qualifiers"); found { if !dec_dyn_ZoneChangeQualifier(fv, &out.qualifiers) do return fail("TriggerCause::BattlefieldTransition.qualifiers") }
	return true
		}) { return fail("TriggerCause::BattlefieldTransition") }
		out^ = tmp
	case: return fail("TriggerCause: unknown variant")
	}
	return true
}

encode_TriggerCause :: proc(b: ^strings.Builder, x: TriggerCause) {
	#partial switch y in x {
	case TriggerCause_Any: _ = y; json.write_string(b, "Any")
	case TriggerCause_EntersBattlefield: strings.write_byte(b, '{'); json.write_string(b, "EntersBattlefield"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "core_types"); enc_dyn_CoreType(b, y.core_types)
	if !(skip_TriggerCause_CausingObject_is_any(y.entrant)) { member(b, first, "entrant"); encode_CausingObject(b, y.entrant) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerCause_CreatureAttacking: _ = y; json.write_string(b, "CreatureAttacking")
	case TriggerCause_CreatureDying: _ = y; json.write_string(b, "CreatureDying")
	case TriggerCause_ControlledCreature: strings.write_byte(b, '{'); json.write_string(b, "ControlledCreature"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "event"); encode_ControlledCreatureEvent(b, y.event)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerCause_ControllerCastOrCopiedSpell: strings.write_byte(b, '{'); json.write_string(b, "ControllerCastOrCopiedSpell"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "core_types"); enc_dyn_CoreType(b, y.core_types)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerCause_RoomEntered: _ = y; json.write_string(b, "RoomEntered")
	case TriggerCause_PlayerAction: strings.write_byte(b, '{'); json.write_string(b, "PlayerAction"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerRelation(b, y.player)
	member(b, first, "action"); encode_PlayerCauseAction(b, y.action)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerCause_TurnedFaceUp: _ = y; json.write_string(b, "TurnedFaceUp")
	case TriggerCause_BattlefieldTransition: strings.write_byte(b, '{'); json.write_string(b, "BattlefieldTransition"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "enter"); encode_bool(b, y.enter)
	member(b, first, "leave"); encode_bool(b, y.leave)
	member(b, first, "qualifiers"); enc_dyn_ZoneChangeQualifier(b, y.qualifiers)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

