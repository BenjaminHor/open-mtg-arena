decode_SimultaneousUnlessAnswer :: proc(v: json.Value, out: ^SimultaneousUnlessAnswer) -> bool {
	when COVERAGE do cov_hit("SimultaneousUnlessAnswer")
	if v.kind != .Object do return fail("SimultaneousUnlessAnswer: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("SimultaneousUnlessAnswer: no tag")
	switch tv.text {
	case "Declined": when COVERAGE do cov_hit("SimultaneousUnlessAnswer::Declined"); out^ = SimultaneousUnlessAnswer_Declined{}
	case "Sacrifice": when COVERAGE do cov_hit("SimultaneousUnlessAnswer::Sacrifice");
		tmp: SimultaneousUnlessAnswer_Sacrifice
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^SimultaneousUnlessAnswer_Sacrifice) -> bool {
	if fv, found := get_any(v, "permanent"); found { if !decode_ObjectIncarnationRef(fv, &out.permanent) do return fail("SimultaneousUnlessAnswer::Sacrifice.permanent") } else { return fail("SimultaneousUnlessAnswer::Sacrifice.permanent missing") }
	return true
		}) { return fail("SimultaneousUnlessAnswer::Sacrifice") }
		out^ = tmp
	case "Discard": when COVERAGE do cov_hit("SimultaneousUnlessAnswer::Discard"); out^ = SimultaneousUnlessAnswer_Discard{}
	case: return fail("SimultaneousUnlessAnswer: unknown variant")
	}
	return true
}

encode_SimultaneousUnlessAnswer :: proc(b: ^strings.Builder, x: SimultaneousUnlessAnswer) {
	#partial switch y in x {
	case SimultaneousUnlessAnswer_Declined: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Declined"); strings.write_byte(b, '}')
	case SimultaneousUnlessAnswer_Sacrifice: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Sacrifice")
	member(b, first, "permanent"); encode_ObjectIncarnationRef(b, y.permanent)
	}; strings.write_byte(b, '}')
	case SimultaneousUnlessAnswer_Discard: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Discard"); strings.write_byte(b, '}')
	}
}

encode_SimultaneousUnlessAnswer_members :: proc(b: ^strings.Builder, x: SimultaneousUnlessAnswer, first: ^bool) {
	#partial switch y in x {
	case SimultaneousUnlessAnswer_Declined: _ = y; member(b, first, "type"); json.write_string(b, "Declined")
	case SimultaneousUnlessAnswer_Sacrifice: member(b, first, "type"); json.write_string(b, "Sacrifice")
	member(b, first, "permanent"); encode_ObjectIncarnationRef(b, y.permanent)

	case SimultaneousUnlessAnswer_Discard: _ = y; member(b, first, "type"); json.write_string(b, "Discard")
	}
}

decode_ExiledStopInput :: proc(v: json.Value, out: ^ExiledStopInput) -> bool {
	when COVERAGE do cov_hit("ExiledStopInput")
	if v.kind != .Object do return fail("ExiledStopInput: not an object")
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("ExiledStopInput.object_id") } else { return fail("ExiledStopInput.object_id missing") }
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("ExiledStopInput.zone") } else { return fail("ExiledStopInput.zone missing") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("ExiledStopInput.controller") } else { return fail("ExiledStopInput.controller missing") }
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("ExiledStopInput.name") } else { return fail("ExiledStopInput.name missing") }
	return true
}

encode_ExiledStopInput :: proc(b: ^strings.Builder, x: ExiledStopInput) {
	strings.write_byte(b, '{')
	f := true
	encode_ExiledStopInput_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ExiledStopInput_members :: proc(b: ^strings.Builder, x: ExiledStopInput, first: ^bool) {
	member(b, first, "object_id"); encode_ObjectId(b, x.object_id)
	member(b, first, "zone"); encode_Zone(b, x.zone)
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	member(b, first, "name"); encode_string(b, x.name)
}

decode_RepeatIterationChoice :: proc(v: json.Value, out: ^RepeatIterationChoice) -> bool {
	when COVERAGE do cov_hit("RepeatIterationChoice")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("RepeatIterationChoice: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("RepeatIterationChoice: not a string or object")
	}
	switch variant {
	case "MandatoryOnly": when COVERAGE do cov_hit("RepeatIterationChoice::MandatoryOnly"); tmp: RepeatIterationChoice_MandatoryOnly; if !decode_RepeatIterationMovement(body, &tmp._0) do return fail("RepeatIterationChoice::MandatoryOnly"); out^ = tmp
	case "OptionalOffered": when COVERAGE do cov_hit("RepeatIterationChoice::OptionalOffered"); out^ = RepeatIterationChoice_OptionalOffered{}
	case: return fail("RepeatIterationChoice: unknown variant")
	}
	return true
}

encode_RepeatIterationChoice :: proc(b: ^strings.Builder, x: RepeatIterationChoice) {
	#partial switch y in x {
	case RepeatIterationChoice_MandatoryOnly: strings.write_byte(b, '{'); json.write_string(b, "MandatoryOnly"); strings.write_byte(b, ':'); encode_RepeatIterationMovement(b, y._0); strings.write_byte(b, '}')
	case RepeatIterationChoice_OptionalOffered: _ = y; json.write_string(b, "OptionalOffered")
	}
}

