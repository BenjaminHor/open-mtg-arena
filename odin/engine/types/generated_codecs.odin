		.WhiteBlack = "WhiteBlack",
		.BlueBlack = "BlueBlack",
		.BlueRed = "BlueRed",
		.BlackRed = "BlackRed",
		.BlackGreen = "BlackGreen",
		.RedWhite = "RedWhite",
		.RedGreen = "RedGreen",
		.GreenWhite = "GreenWhite",
		.GreenBlue = "GreenBlue",
		.TwoWhite = "TwoWhite",
		.TwoBlue = "TwoBlue",
		.TwoBlack = "TwoBlack",
		.TwoRed = "TwoRed",
		.TwoGreen = "TwoGreen",
		.PhyrexianWhite = "PhyrexianWhite",
		.PhyrexianBlue = "PhyrexianBlue",
		.PhyrexianBlack = "PhyrexianBlack",
		.PhyrexianRed = "PhyrexianRed",
