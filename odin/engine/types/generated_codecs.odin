encode_RetainedStickerTimestamp_members :: proc(b: ^strings.Builder, x: RetainedStickerTimestamp, first: ^bool) {
	member(b, first, "locator"); encode_StickerLocator(b, x.locator)
	member(b, first, "prior_timestamp"); encode_u64(b, x.prior_timestamp)
	member(b, first, "timestamp"); encode_u64(b, x.timestamp)
}

