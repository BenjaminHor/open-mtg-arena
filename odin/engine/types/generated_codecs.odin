	if fv, found := get_any(v, "permanents"); found { if !dec_dyn_ObjectId(fv, &out.permanents) do return fail("WardSacrificePaymentResume::Sequential.permanents") } else { return fail("WardSacrificePaymentResume::Sequential.permanents missing") }
	if fv, found := get_any(v, "sacrificed"); found { if !decode_ObjectId(fv, &out.sacrificed) do return fail("WardSacrificePaymentResume::Sequential.sacrificed") } else { return fail("WardSacrificePaymentResume::Sequential.sacrificed missing") }
	if fv, found := get_any(v, "remaining"); found { if !decode_u32(fv, &out.remaining) do return fail("WardSacrificePaymentResume::Sequential.remaining") } else { return fail("WardSacrificePaymentResume::Sequential.remaining missing") }
	return true
		}) { return fail("WardSacrificePaymentResume::Sequential") }
		out^ = tmp
	case: return fail("WardSacrificePaymentResume: unknown variant")
	}
	return true
}

encode_WardSacrificePaymentResume :: proc(b: ^strings.Builder, x: WardSacrificePaymentResume) {
