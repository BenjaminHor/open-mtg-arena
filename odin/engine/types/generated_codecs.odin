decode_CombatRelation :: proc(v: json.Value, out: ^CombatRelation) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("CombatRelation: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("CombatRelation: not a string or object")
	}
	switch variant {
	case "BlockPairing":
		tmp: CombatRelation_BlockPairing
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^CombatRelation_BlockPairing) -> bool {
	if fv, found := get_any(v, "direction"); found { if !decode_BlockPairDirection(fv, &out.direction) do return fail("CombatRelation::BlockPairing.direction") } else { return fail("CombatRelation::BlockPairing.direction missing") }
	if fv, found := get_any(v, "scope"); found { if !dec_opt_CombatHistoryScope(fv, &out.scope) do return fail("CombatRelation::BlockPairing.scope") }
	return true
		}) { return fail("CombatRelation::BlockPairing") }
		out^ = tmp
	case: return fail("CombatRelation: unknown variant")
	}
	return true
}

encode_CombatRelation :: proc(b: ^strings.Builder, x: CombatRelation) {
	#partial switch y in x {
	case CombatRelation_BlockPairing: strings.write_byte(b, '{'); json.write_string(b, "BlockPairing"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "direction"); encode_BlockPairDirection(b, y.direction)
	if !(y.scope == nil) { member(b, first, "scope"); enc_opt_CombatHistoryScope(b, y.scope) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

