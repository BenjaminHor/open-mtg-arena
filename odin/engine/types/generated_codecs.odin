decode_LKISnapshot :: proc(v: json.Value, out: ^LKISnapshot) -> bool {
	when COVERAGE do cov_hit("LKISnapshot")
	if v.kind != .Object do return fail("LKISnapshot: not an object")
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("LKISnapshot.name") } else { return fail("LKISnapshot.name missing") }
	if fv, found := get_any(v, "token_image_ref"); found { if !dec_opt_TokenImageRef(fv, &out.token_image_ref) do return fail("LKISnapshot.token_image_ref") }
	if fv, found := get_any(v, "power"); found { if !dec_opt_i32(fv, &out.power) do return fail("LKISnapshot.power") }
	if fv, found := get_any(v, "toughness"); found { if !dec_opt_i32(fv, &out.toughness) do return fail("LKISnapshot.toughness") }
	if fv, found := get_any(v, "base_power"); found { if !dec_opt_i32(fv, &out.base_power) do return fail("LKISnapshot.base_power") }
	if fv, found := get_any(v, "base_toughness"); found { if !dec_opt_i32(fv, &out.base_toughness) do return fail("LKISnapshot.base_toughness") }
	if fv, found := get_any(v, "mana_value"); found { if !decode_u32(fv, &out.mana_value) do return fail("LKISnapshot.mana_value") } else { return fail("LKISnapshot.mana_value missing") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("LKISnapshot.controller") } else { return fail("LKISnapshot.controller missing") }
	if fv, found := get_any(v, "owner"); found { if !decode_PlayerId(fv, &out.owner) do return fail("LKISnapshot.owner") } else { return fail("LKISnapshot.owner missing") }
	if fv, found := get_any(v, "card_types"); found { if !dec_dyn_CoreType(fv, &out.card_types) do return fail("LKISnapshot.card_types") }
	if fv, found := get_any(v, "subtypes"); found { if !dec_dyn_string(fv, &out.subtypes) do return fail("LKISnapshot.subtypes") }
	if fv, found := get_any(v, "supertypes"); found { if !dec_dyn_Supertype(fv, &out.supertypes) do return fail("LKISnapshot.supertypes") }
	if fv, found := get_any(v, "keywords"); found { if !dec_dyn_Keyword(fv, &out.keywords) do return fail("LKISnapshot.keywords") }
	if fv, found := get_any(v, "colors"); found { if !dec_dyn_ManaColor(fv, &out.colors) do return fail("LKISnapshot.colors") }
	if fv, found := get_any(v, "chosen_attributes"); found { if !dec_dyn_ChosenAttribute(fv, &out.chosen_attributes) do return fail("LKISnapshot.chosen_attributes") }
	if fv, found := get_any(v, "counters"); found { if !decode_with_counter_map_serde(fv, &out.counters) do return fail("LKISnapshot.counters") }
	if fv, found := get_any(v, "tapped"); found { if !decode_bool(fv, &out.tapped) do return fail("LKISnapshot.tapped") }
	if fv, found := get_any(v, "is_suspected"); found { if !decode_bool(fv, &out.is_suspected) do return fail("LKISnapshot.is_suspected") }
	if fv, found := get_any(v, "was_prepared"); found { if !decode_bool(fv, &out.was_prepared) do return fail("LKISnapshot.was_prepared") }
	if fv, found := get_any(v, "attachments"); found { if !dec_dyn_AttachmentSnapshot(fv, &out.attachments) do return fail("LKISnapshot.attachments") }
	if fv, found := get_any(v, "intensity"); found { if !decode_u32(fv, &out.intensity) do return fail("LKISnapshot.intensity") }
	return true
}

