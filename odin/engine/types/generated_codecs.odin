	case "GainedLife": when COVERAGE do cov_hit("PlayerCauseAction::GainedLife"); out^ = .GainedLife
	case "DrewCard": when COVERAGE do cov_hit("PlayerCauseAction::DrewCard"); out^ = .DrewCard
	case: return fail("PlayerCauseAction: unknown variant")
	}
	return true
}

encode_PlayerCauseAction :: proc(b: ^strings.Builder, x: PlayerCauseAction) {
	@(static, rodata) NAMES := [PlayerCauseAction]string{
		.GainedLife = "GainedLife",
		.DrewCard = "DrewCard",
	}
	json.write_string(b, NAMES[x])
}

decode_ZoneChangeQualifier :: proc(v: json.Value, out: ^ZoneChangeQualifier) -> bool {
	when COVERAGE do cov_hit("ZoneChangeQualifier")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ZoneChangeQualifier: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ZoneChangeQualifier: not a string or object")
	}
	switch variant {
	case "CoreType": when COVERAGE do cov_hit("ZoneChangeQualifier::CoreType"); tmp: ZoneChangeQualifier_CoreType; if !decode_CoreType(body, &tmp._0) do return fail("ZoneChangeQualifier::CoreType"); out^ = tmp
	case "Supertype": when COVERAGE do cov_hit("ZoneChangeQualifier::Supertype"); tmp: ZoneChangeQualifier_Supertype; if !decode_Supertype(body, &tmp._0) do return fail("ZoneChangeQualifier::Supertype"); out^ = tmp
	case: return fail("ZoneChangeQualifier: unknown variant")
	}
	return true
}

encode_ZoneChangeQualifier :: proc(b: ^strings.Builder, x: ZoneChangeQualifier) {
	#partial switch y in x {
	case ZoneChangeQualifier_CoreType: strings.write_byte(b, '{'); json.write_string(b, "CoreType"); strings.write_byte(b, ':'); encode_CoreType(b, y._0); strings.write_byte(b, '}')
	case ZoneChangeQualifier_Supertype: strings.write_byte(b, '{'); json.write_string(b, "Supertype"); strings.write_byte(b, ':'); encode_Supertype(b, y._0); strings.write_byte(b, '}')
	}
}

