decode_DeclaredPlayerTarget :: proc(v: json.Value, out: ^DeclaredPlayerTarget) -> bool {
	when COVERAGE do cov_hit("DeclaredPlayerTarget")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("DeclaredPlayerTarget: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("DeclaredPlayerTarget: not a string or object")
