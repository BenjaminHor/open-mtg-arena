	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("ProposedEvent::Planeswalk.player_id") } else { return fail("ProposedEvent::Planeswalk.player_id missing") }
	if fv, found := get_any(v, "cause"); found { if !decode_PlaneswalkCause(fv, &out.cause) do return fail("ProposedEvent::Planeswalk.cause") } else { out.cause = PlaneswalkCause.RulesProcess }
	if fv, found := get_any(v, "applied"); found { if !dec_dyn_AppliedReplacementKey(fv, &out.applied) do return fail("ProposedEvent::Planeswalk.applied") } else { return fail("ProposedEvent::Planeswalk.applied missing") }
