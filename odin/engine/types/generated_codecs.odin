	case DebugAction_SetPhase: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SetPhase"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "phase"); encode_Phase(b, y.phase)
	member(b, first, "active_player"); encode_PlayerId(b, y.active_player)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_RunStateBasedActions: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RunStateBasedActions"); strings.write_byte(b, '}')
	case DebugAction_CreateToken: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CreateToken"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "request"); encode_DebugTokenRequest(b, y.request)
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "run_etb"); encode_bool(b, y.run_etb)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_CreateTokenCopy: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CreateTokenCopy"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "owner"); encode_PlayerId(b, y.owner)
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "nonlegendary"); encode_bool(b, y.nonlegendary)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_IterationCount :: proc(v: json.Value, out: ^IterationCount) -> bool {
	when COVERAGE do cov_hit("IterationCount")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("IterationCount: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("IterationCount: not a string or object")
	}
	switch variant {
	case "Fixed": when COVERAGE do cov_hit("IterationCount::Fixed"); tmp: IterationCount_Fixed; if !decode_u32(body, &tmp._0) do return fail("IterationCount::Fixed"); out^ = tmp
	case "WithoutEnd": when COVERAGE do cov_hit("IterationCount::WithoutEnd"); out^ = IterationCount_WithoutEnd{}
	case: return fail("IterationCount: unknown variant")
	}
	return true
}

encode_IterationCount :: proc(b: ^strings.Builder, x: IterationCount) {
	#partial switch y in x {
	case IterationCount_Fixed: strings.write_byte(b, '{'); json.write_string(b, "Fixed"); strings.write_byte(b, ':'); encode_u32(b, y._0); strings.write_byte(b, '}')
	case IterationCount_WithoutEnd: _ = y; json.write_string(b, "WithoutEnd")
	}
}

decode_ShortcutResponse :: proc(v: json.Value, out: ^ShortcutResponse) -> bool {
	when COVERAGE do cov_hit("ShortcutResponse")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ShortcutResponse: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ShortcutResponse: not a string or object")
	}
	switch variant {
	case "Accept": when COVERAGE do cov_hit("ShortcutResponse::Accept"); out^ = ShortcutResponse_Accept{}
	case "Shorten": when COVERAGE do cov_hit("ShortcutResponse::Shorten");
		tmp: ShortcutResponse_Shorten
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ShortcutResponse_Shorten) -> bool {
	if fv, found := get_any(v, "at_iteration"); found { if !decode_u32(fv, &out.at_iteration) do return fail("ShortcutResponse::Shorten.at_iteration") } else { return fail("ShortcutResponse::Shorten.at_iteration missing") }
	return true
		}) { return fail("ShortcutResponse::Shorten") }
		out^ = tmp
	case: return fail("ShortcutResponse: unknown variant")
	}
	return true
}

encode_ShortcutResponse :: proc(b: ^strings.Builder, x: ShortcutResponse) {
	#partial switch y in x {
	case ShortcutResponse_Accept: _ = y; json.write_string(b, "Accept")
	case ShortcutResponse_Shorten: strings.write_byte(b, '{'); json.write_string(b, "Shorten"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "at_iteration"); encode_u32(b, y.at_iteration)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_PrecastCopyShortcutResponse :: proc(v: json.Value, out: ^PrecastCopyShortcutResponse) -> bool {
	when COVERAGE do cov_hit("PrecastCopyShortcutResponse")
	if v.kind != .Object do return fail("PrecastCopyShortcutResponse: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("PrecastCopyShortcutResponse: no tag")
	switch tv.text {
	case "Propose": when COVERAGE do cov_hit("PrecastCopyShortcutResponse::Propose");
		tmp: PrecastCopyShortcutResponse_Propose
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^PrecastCopyShortcutResponse_Propose) -> bool {
	if fv, found := get_any(v, "route_id"); found { if !decode_u64(fv, &out.route_id) do return fail("PrecastCopyShortcutResponse::Propose.route_id") } else { return fail("PrecastCopyShortcutResponse::Propose.route_id missing") }
	return true
		}) { return fail("PrecastCopyShortcutResponse::Propose") }
		out^ = tmp
	case "Decline": when COVERAGE do cov_hit("PrecastCopyShortcutResponse::Decline"); out^ = PrecastCopyShortcutResponse_Decline{}
	case "Accept": when COVERAGE do cov_hit("PrecastCopyShortcutResponse::Accept"); out^ = PrecastCopyShortcutResponse_Accept{}
	case "Shorten": when COVERAGE do cov_hit("PrecastCopyShortcutResponse::Shorten");
		tmp: PrecastCopyShortcutResponse_Shorten
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^PrecastCopyShortcutResponse_Shorten) -> bool {
	if fv, found := get_any(v, "breakpoint_id"); found { if !decode_u64(fv, &out.breakpoint_id) do return fail("PrecastCopyShortcutResponse::Shorten.breakpoint_id") } else { return fail("PrecastCopyShortcutResponse::Shorten.breakpoint_id missing") }
	return true
		}) { return fail("PrecastCopyShortcutResponse::Shorten") }
		out^ = tmp
	case: return fail("PrecastCopyShortcutResponse: unknown variant")
	}
	return true
}

encode_PrecastCopyShortcutResponse :: proc(b: ^strings.Builder, x: PrecastCopyShortcutResponse) {
	#partial switch y in x {
	case PrecastCopyShortcutResponse_Propose: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Propose"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "route_id"); encode_u64(b, y.route_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PrecastCopyShortcutResponse_Decline: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Decline"); strings.write_byte(b, '}')
	case PrecastCopyShortcutResponse_Accept: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Accept"); strings.write_byte(b, '}')
	case PrecastCopyShortcutResponse_Shorten: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Shorten"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "breakpoint_id"); encode_u64(b, y.breakpoint_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_ResolveAllConsentDecision :: proc(v: json.Value, out: ^ResolveAllConsentDecision) -> bool {
	when COVERAGE do cov_hit("ResolveAllConsentDecision")
	if v.kind != .Object do return fail("ResolveAllConsentDecision: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ResolveAllConsentDecision: no tag")
	str := tv.text
	switch str {
	case "Grant": when COVERAGE do cov_hit("ResolveAllConsentDecision::Grant"); out^ = .Grant
	case "Decline": when COVERAGE do cov_hit("ResolveAllConsentDecision::Decline"); out^ = .Decline
	case: return fail("ResolveAllConsentDecision: unknown variant")
	}
	return true
}

encode_ResolveAllConsentDecision :: proc(b: ^strings.Builder, x: ResolveAllConsentDecision) {
	strings.write_byte(b, '{')
	f := true
	encode_ResolveAllConsentDecision_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ResolveAllConsentDecision_members :: proc(b: ^strings.Builder, x: ResolveAllConsentDecision, first: ^bool) {
	_ = x
	@(static, rodata) NAMES := [ResolveAllConsentDecision]string{
		.Grant = "Grant",
		.Decline = "Decline",
	}
	member(b, first, "type"); json.write_string(b, NAMES[x])
}

decode_ManaSourceOutput :: proc(v: json.Value, out: ^ManaSourceOutput) -> bool {
	when COVERAGE do cov_hit("ManaSourceOutput")
	if v.kind != .Object do return fail("ManaSourceOutput: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ManaSourceOutput: no tag")
	switch tv.text {
	case "Concrete": when COVERAGE do cov_hit("ManaSourceOutput::Concrete"); tmp: ManaSourceOutput_Concrete; if !decode_ManaType(json.get_or_null(v, "data"), &tmp._0) do return fail("ManaSourceOutput::Concrete"); out^ = tmp
	case "DeferredColorChoice": when COVERAGE do cov_hit("ManaSourceOutput::DeferredColorChoice");
		tmp: ManaSourceOutput_DeferredColorChoice
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^ManaSourceOutput_DeferredColorChoice) -> bool {
	if fv, found := get_any(v, "quantity"); found { if !decode_ManaSourceQuantity(fv, &out.quantity) do return fail("ManaSourceOutput::DeferredColorChoice.quantity") } else { return fail("ManaSourceOutput::DeferredColorChoice.quantity missing") }
	return true
		}) { return fail("ManaSourceOutput::DeferredColorChoice") }
		out^ = tmp
	case: return fail("ManaSourceOutput: unknown variant")
	}
	return true
}

encode_ManaSourceOutput :: proc(b: ^strings.Builder, x: ManaSourceOutput) {
	#partial switch y in x {
	case ManaSourceOutput_Concrete: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Concrete"); member(b, &f, "data"); encode_ManaType(b, y._0); strings.write_byte(b, '}')
	case ManaSourceOutput_DeferredColorChoice: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DeferredColorChoice"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "quantity"); encode_ManaSourceQuantity(b, y.quantity)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_ManaRestriction :: proc(v: json.Value, out: ^ManaRestriction) -> bool {
	when COVERAGE do cov_hit("ManaRestriction")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ManaRestriction: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ManaRestriction: not a string or object")
	}
	switch variant {
	case "OnlyForSpell": when COVERAGE do cov_hit("ManaRestriction::OnlyForSpell"); out^ = ManaRestriction_OnlyForSpell{}
	case "OnlyForSpellType": when COVERAGE do cov_hit("ManaRestriction::OnlyForSpellType"); tmp: ManaRestriction_OnlyForSpellType; if !decode_string(body, &tmp._0) do return fail("ManaRestriction::OnlyForSpellType"); out^ = tmp
	case "OnlyForCreatureType": when COVERAGE do cov_hit("ManaRestriction::OnlyForCreatureType"); tmp: ManaRestriction_OnlyForCreatureType; if !decode_string(body, &tmp._0) do return fail("ManaRestriction::OnlyForCreatureType"); out^ = tmp
	case "OnlyForTypeSpellsOrAbilities": when COVERAGE do cov_hit("ManaRestriction::OnlyForTypeSpellsOrAbilities");
		tmp: ManaRestriction_OnlyForTypeSpellsOrAbilities
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaRestriction_OnlyForTypeSpellsOrAbilities) -> bool {
	if fv, found := get_any(v, "spell_type"); found { if !decode_string(fv, &out.spell_type) do return fail("ManaRestriction::OnlyForTypeSpellsOrAbilities.spell_type") } else { return fail("ManaRestriction::OnlyForTypeSpellsOrAbilities.spell_type missing") }
	if fv, found := get_any(v, "ability"); found { if !decode_AbilityActivationScope(fv, &out.ability) do return fail("ManaRestriction::OnlyForTypeSpellsOrAbilities.ability") } else { return fail("ManaRestriction::OnlyForTypeSpellsOrAbilities.ability missing") }
	return true
		}) { return fail("ManaRestriction::OnlyForTypeSpellsOrAbilities") }
		out^ = tmp
	case "OnlyForActivation": when COVERAGE do cov_hit("ManaRestriction::OnlyForActivation"); out^ = ManaRestriction_OnlyForActivation{}
	case "OnlyForTaggedActivation": when COVERAGE do cov_hit("ManaRestriction::OnlyForTaggedActivation"); tmp: ManaRestriction_OnlyForTaggedActivation; if !decode_AbilityTag(body, &tmp._0) do return fail("ManaRestriction::OnlyForTaggedActivation"); out^ = tmp
	case "OnlyForXCosts": when COVERAGE do cov_hit("ManaRestriction::OnlyForXCosts"); out^ = ManaRestriction_OnlyForXCosts{}
	case "OnlyForSpellWithKeywordKind": when COVERAGE do cov_hit("ManaRestriction::OnlyForSpellWithKeywordKind"); tmp: ManaRestriction_OnlyForSpellWithKeywordKind; if !decode_KeywordKind(body, &tmp._0) do return fail("ManaRestriction::OnlyForSpellWithKeywordKind"); out^ = tmp
	case "OnlyForSpellWithKeywordKindFromZone": when COVERAGE do cov_hit("ManaRestriction::OnlyForSpellWithKeywordKindFromZone");
		data := body
		if data.kind != .Array || len(data.items) != 2 do return fail("ManaRestriction::OnlyForSpellWithKeywordKindFromZone")
		tmp: ManaRestriction_OnlyForSpellWithKeywordKindFromZone
		if !decode_KeywordKind(data.items[0], &tmp._0) do return fail("ManaRestriction::OnlyForSpellWithKeywordKindFromZone._0")
		if !decode_Zone(data.items[1], &tmp._1) do return fail("ManaRestriction::OnlyForSpellWithKeywordKindFromZone._1")
		out^ = tmp
	case "OnlyForSpellWithManaValue": when COVERAGE do cov_hit("ManaRestriction::OnlyForSpellWithManaValue");
		tmp: ManaRestriction_OnlyForSpellWithManaValue
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaRestriction_OnlyForSpellWithManaValue) -> bool {
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("ManaRestriction::OnlyForSpellWithManaValue.comparator") } else { return fail("ManaRestriction::OnlyForSpellWithManaValue.comparator missing") }
	if fv, found := get_any(v, "value"); found { if !decode_u32(fv, &out.value) do return fail("ManaRestriction::OnlyForSpellWithManaValue.value") } else { return fail("ManaRestriction::OnlyForSpellWithManaValue.value missing") }
	return true
		}) { return fail("ManaRestriction::OnlyForSpellWithManaValue") }
		out^ = tmp
	case "OnlyForSpellMatchingCostCriteria": when COVERAGE do cov_hit("ManaRestriction::OnlyForSpellMatchingCostCriteria");
		tmp: ManaRestriction_OnlyForSpellMatchingCostCriteria
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaRestriction_OnlyForSpellMatchingCostCriteria) -> bool {
	if fv, found := get_any(v, "spell_type"); found { if !dec_opt_string(fv, &out.spell_type) do return fail("ManaRestriction::OnlyForSpellMatchingCostCriteria.spell_type") }
	if fv, found := get_any(v, "criteria"); found { if !dec_dyn_SpellCostCriterion(fv, &out.criteria) do return fail("ManaRestriction::OnlyForSpellMatchingCostCriteria.criteria") } else { return fail("ManaRestriction::OnlyForSpellMatchingCostCriteria.criteria missing") }
	return true
		}) { return fail("ManaRestriction::OnlyForSpellMatchingCostCriteria") }
		out^ = tmp
	case "OnlyForSpellWithColorCount": when COVERAGE do cov_hit("ManaRestriction::OnlyForSpellWithColorCount");
		tmp: ManaRestriction_OnlyForSpellWithColorCount
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaRestriction_OnlyForSpellWithColorCount) -> bool {
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("ManaRestriction::OnlyForSpellWithColorCount.comparator") } else { return fail("ManaRestriction::OnlyForSpellWithColorCount.comparator missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("ManaRestriction::OnlyForSpellWithColorCount.count") } else { return fail("ManaRestriction::OnlyForSpellWithColorCount.count missing") }
	return true
		}) { return fail("ManaRestriction::OnlyForSpellWithColorCount") }
		out^ = tmp
	case "OnlyForSpellColor": when COVERAGE do cov_hit("ManaRestriction::OnlyForSpellColor"); tmp: ManaRestriction_OnlyForSpellColor; if !decode_ManaColor(body, &tmp._0) do return fail("ManaRestriction::OnlyForSpellColor"); out^ = tmp
	case "OnlyForSpellFromZone": when COVERAGE do cov_hit("ManaRestriction::OnlyForSpellFromZone"); tmp: ManaRestriction_OnlyForSpellFromZone; if !decode_ZoneSpend(body, &tmp._0) do return fail("ManaRestriction::OnlyForSpellFromZone"); out^ = tmp
	case "CannotCastSpellFromZone": when COVERAGE do cov_hit("ManaRestriction::CannotCastSpellFromZone"); tmp: ManaRestriction_CannotCastSpellFromZone; if !decode_Zone(body, &tmp._0) do return fail("ManaRestriction::CannotCastSpellFromZone"); out^ = tmp
	case "OnlyForFaceDownSpell": when COVERAGE do cov_hit("ManaRestriction::OnlyForFaceDownSpell"); out^ = ManaRestriction_OnlyForFaceDownSpell{}
	case "OnlyForAny": when COVERAGE do cov_hit("ManaRestriction::OnlyForAny"); tmp: ManaRestriction_OnlyForAny; if !dec_dyn_ManaRestriction(body, &tmp._0) do return fail("ManaRestriction::OnlyForAny"); out^ = tmp
	case "OnlyForSpecialAction": when COVERAGE do cov_hit("ManaRestriction::OnlyForSpecialAction"); tmp: ManaRestriction_OnlyForSpecialAction; if !decode_SpecialAction(body, &tmp._0) do return fail("ManaRestriction::OnlyForSpecialAction"); out^ = tmp
	case "Impossible": when COVERAGE do cov_hit("ManaRestriction::Impossible"); out^ = ManaRestriction_Impossible{}
	case "ConvokePayment": when COVERAGE do cov_hit("ManaRestriction::ConvokePayment"); out^ = ManaRestriction_ConvokePayment{}
	case: return fail("ManaRestriction: unknown variant")
	}
	return true
}

encode_ManaRestriction :: proc(b: ^strings.Builder, x: ManaRestriction) {
	#partial switch y in x {
	case ManaRestriction_OnlyForSpell: _ = y; json.write_string(b, "OnlyForSpell")
	case ManaRestriction_OnlyForSpellType: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellType"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForCreatureType: strings.write_byte(b, '{'); json.write_string(b, "OnlyForCreatureType"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForTypeSpellsOrAbilities: strings.write_byte(b, '{'); json.write_string(b, "OnlyForTypeSpellsOrAbilities"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "spell_type"); encode_string(b, y.spell_type)
	member(b, first, "ability"); encode_AbilityActivationScope(b, y.ability)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForActivation: _ = y; json.write_string(b, "OnlyForActivation")
	case ManaRestriction_OnlyForTaggedActivation: strings.write_byte(b, '{'); json.write_string(b, "OnlyForTaggedActivation"); strings.write_byte(b, ':'); encode_AbilityTag(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForXCosts: _ = y; json.write_string(b, "OnlyForXCosts")
	case ManaRestriction_OnlyForSpellWithKeywordKind: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellWithKeywordKind"); strings.write_byte(b, ':'); encode_KeywordKind(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForSpellWithKeywordKindFromZone: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellWithKeywordKindFromZone"); strings.write_byte(b, ':'); strings.write_byte(b, '['); encode_KeywordKind(b, y._0); strings.write_byte(b, ','); encode_Zone(b, y._1); strings.write_byte(b, ']'); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForSpellWithManaValue: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellWithManaValue"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_u32(b, y.value)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForSpellMatchingCostCriteria: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellMatchingCostCriteria"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	if !(y.spell_type == nil) { member(b, first, "spell_type"); enc_opt_string(b, y.spell_type) }
	member(b, first, "criteria"); enc_dyn_SpellCostCriterion(b, y.criteria)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForSpellWithColorCount: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellWithColorCount"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForSpellColor: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellColor"); strings.write_byte(b, ':'); encode_ManaColor(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForSpellFromZone: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellFromZone"); strings.write_byte(b, ':'); encode_ZoneSpend(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_CannotCastSpellFromZone: strings.write_byte(b, '{'); json.write_string(b, "CannotCastSpellFromZone"); strings.write_byte(b, ':'); encode_Zone(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForFaceDownSpell: _ = y; json.write_string(b, "OnlyForFaceDownSpell")
	case ManaRestriction_OnlyForAny: strings.write_byte(b, '{'); json.write_string(b, "OnlyForAny"); strings.write_byte(b, ':'); enc_dyn_ManaRestriction(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForSpecialAction: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpecialAction"); strings.write_byte(b, ':'); encode_SpecialAction(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_Impossible: _ = y; json.write_string(b, "Impossible")
	case ManaRestriction_ConvokePayment: _ = y; json.write_string(b, "ConvokePayment")
	}
}

decode_ManaSourcePenalty :: proc(v: json.Value, out: ^ManaSourcePenalty) -> bool {
	when COVERAGE do cov_hit("ManaSourcePenalty")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ManaSourcePenalty: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ManaSourcePenalty: not a string or object")
	}
	switch variant {
	case "None": when COVERAGE do cov_hit("ManaSourcePenalty::None"); out^ = ManaSourcePenalty_None{}
	case "HasIrreversibleContinuation": when COVERAGE do cov_hit("ManaSourcePenalty::HasIrreversibleContinuation"); out^ = ManaSourcePenalty_HasIrreversibleContinuation{}
	case "DealsDamageOnResolution": when COVERAGE do cov_hit("ManaSourcePenalty::DealsDamageOnResolution");
		tmp: ManaSourcePenalty_DealsDamageOnResolution
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaSourcePenalty_DealsDamageOnResolution) -> bool {
	if fv, found := get_any(v, "fixed_amount"); found { if !dec_opt_u16(fv, &out.fixed_amount) do return fail("ManaSourcePenalty::DealsDamageOnResolution.fixed_amount") }
	return true
		}) { return fail("ManaSourcePenalty::DealsDamageOnResolution") }
		out^ = tmp
	case "PaysLifeOnActivation": when COVERAGE do cov_hit("ManaSourcePenalty::PaysLifeOnActivation");
		tmp: ManaSourcePenalty_PaysLifeOnActivation
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaSourcePenalty_PaysLifeOnActivation) -> bool {
	if fv, found := get_any(v, "fixed_amount"); found { if !dec_opt_u16(fv, &out.fixed_amount) do return fail("ManaSourcePenalty::PaysLifeOnActivation.fixed_amount") }
	return true
		}) { return fail("ManaSourcePenalty::PaysLifeOnActivation") }
		out^ = tmp
	case "Sacrifices": when COVERAGE do cov_hit("ManaSourcePenalty::Sacrifices"); out^ = ManaSourcePenalty_Sacrifices{}
	case: return fail("ManaSourcePenalty: unknown variant")
	}
	return true
}

encode_ManaSourcePenalty :: proc(b: ^strings.Builder, x: ManaSourcePenalty) {
	#partial switch y in x {
	case ManaSourcePenalty_None: _ = y; json.write_string(b, "None")
	case ManaSourcePenalty_HasIrreversibleContinuation: _ = y; json.write_string(b, "HasIrreversibleContinuation")
	case ManaSourcePenalty_DealsDamageOnResolution: strings.write_byte(b, '{'); json.write_string(b, "DealsDamageOnResolution"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "fixed_amount"); enc_opt_u16(b, y.fixed_amount)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaSourcePenalty_PaysLifeOnActivation: strings.write_byte(b, '{'); json.write_string(b, "PaysLifeOnActivation"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "fixed_amount"); enc_opt_u16(b, y.fixed_amount)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaSourcePenalty_Sacrifices: _ = y; json.write_string(b, "Sacrifices")
	}
}

decode_TapsForManaSelection :: proc(v: json.Value, out: ^TapsForManaSelection) -> bool {
	when COVERAGE do cov_hit("TapsForManaSelection")
	if v.kind != .Object do return fail("TapsForManaSelection: not an object")
