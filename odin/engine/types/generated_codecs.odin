	}; strings.write_byte(b, '}')
	case FilterProp_Modified: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Modified"); strings.write_byte(b, '}')
	case FilterProp_Historic: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Historic"); strings.write_byte(b, '}')
	case FilterProp_NotHistoric: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NotHistoric"); strings.write_byte(b, '}')
	case FilterProp_DifferentNameFrom: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DifferentNameFrom")
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case FilterProp_DistinctFrom: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DistinctFrom")
	member(b, first, "reference"); enc_ptr_TargetFilter(b, y.reference)
	}; strings.write_byte(b, '}')
	case FilterProp_InAnyZone: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "InAnyZone")
	member(b, first, "zones"); enc_dyn_Zone(b, y.zones)
	}; strings.write_byte(b, '}')
	case FilterProp_SharesQuality: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SharesQuality")
	member(b, first, "quality"); encode_SharedQuality(b, y.quality)
	if !(y.reference == nil) { member(b, first, "reference"); enc_ptr_TargetFilter(b, y.reference) }
	if !(skip_FilterProp_is_default_shared_quality_relation(y.relation)) { member(b, first, "relation"); encode_SharedQualityRelation(b, y.relation) }
	}; strings.write_byte(b, '}')
	case FilterProp_WasDealtDamageThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "WasDealtDamageThisTurn"); strings.write_byte(b, '}')
	case FilterProp_DealtDamageThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DealtDamageThisTurn")
	member(b, first, "kind"); encode_DamageKindFilter(b, y.kind)
	if !(y.recipient == nil) { member(b, first, "recipient"); enc_opt_PlayerFilter(b, y.recipient) }
	}; strings.write_byte(b, '}')
	case FilterProp_EnteredThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EnteredThisTurn"); strings.write_byte(b, '}')
	case FilterProp_ControlledContinuouslySinceTurnBegan: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ControlledContinuouslySinceTurnBegan"); strings.write_byte(b, '}')
	case FilterProp_ZoneChangedThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ZoneChangedThisTurn")
	if !(y.from == nil) { member(b, first, "from"); enc_opt_Zone(b, y.from) }
	if !(y.to == nil) { member(b, first, "to"); enc_opt_Zone(b, y.to) }
	}; strings.write_byte(b, '}')
	case FilterProp_AttackedThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AttackedThisTurn")
	if !(y.defender == nil) { member(b, first, "defender"); enc_opt_ControllerRef(b, y.defender) }
	}; strings.write_byte(b, '}')
	case FilterProp_BlockedThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BlockedThisTurn"); strings.write_byte(b, '}')
	case FilterProp_FoughtThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "FoughtThisTurn"); strings.write_byte(b, '}')
	case FilterProp_AttackedOrBlockedThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AttackedOrBlockedThisTurn"); strings.write_byte(b, '}')
	case FilterProp_CountersPutOnThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CountersPutOnThisTurn")
	member(b, first, "actor"); encode_CountScope(b, y.actor)
	member(b, first, "counters"); encode_CounterMatch(b, y.counters)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}')
	case FilterProp_FaceDown: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "FaceDown"); strings.write_byte(b, '}')
	case FilterProp_Transformed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Transformed"); strings.write_byte(b, '}')
	case FilterProp_TargetsOnly: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TargetsOnly")
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case FilterProp_Targets: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Targets")
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case FilterProp_CouldBeTargetedByTriggeringSpell: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CouldBeTargetedByTriggeringSpell"); strings.write_byte(b, '}')
	case FilterProp_HasXInManaCost: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasXInManaCost"); strings.write_byte(b, '}')
	case FilterProp_HasXInActivationCost: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasXInActivationCost"); strings.write_byte(b, '}')
	case FilterProp_WasKicked: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "WasKicked"); strings.write_byte(b, '}')
	case FilterProp_HasManaAbility: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasManaAbility"); strings.write_byte(b, '}')
	case FilterProp_HasNoAbilities: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasNoAbilities"); strings.write_byte(b, '}')
	case FilterProp_Named: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Named")
	member(b, first, "name"); encode_string(b, y.name)
	}; strings.write_byte(b, '}')
	case FilterProp_SameName: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SameName"); strings.write_byte(b, '}')
	case FilterProp_SameNameAsParentTarget: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SameNameAsParentTarget"); strings.write_byte(b, '}')
	case FilterProp_SameNameAsExiledBySource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SameNameAsExiledBySource"); strings.write_byte(b, '}')
	case FilterProp_NameMatchesAnyPermanent: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "NameMatchesAnyPermanent")
	member(b, first, "controller"); enc_opt_ControllerRef(b, y.controller)
	}; strings.write_byte(b, '}')
	case FilterProp_IsCommander: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "IsCommander"); strings.write_byte(b, '}')
	case FilterProp_SharesCreatureTypeWithCommander: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SharesCreatureTypeWithCommander"); strings.write_byte(b, '}')
	case FilterProp_Other: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Other")
	member(b, first, "value"); encode_string(b, y.value)
	}; strings.write_byte(b, '}')
	}
}

encode_FilterProp_members :: proc(b: ^strings.Builder, x: FilterProp, first: ^bool) {
	#partial switch y in x {
	case FilterProp_Token: _ = y; member(b, first, "type"); json.write_string(b, "Token")
	case FilterProp_NonToken: _ = y; member(b, first, "type"); json.write_string(b, "NonToken")
	case FilterProp_RepresentedByCard: _ = y; member(b, first, "type"); json.write_string(b, "RepresentedByCard")
	case FilterProp_ControllerChoseLabel: member(b, first, "type"); json.write_string(b, "ControllerChoseLabel")
	member(b, first, "label"); encode_string(b, y.label)

	case FilterProp_ControllerMatches: member(b, first, "type"); json.write_string(b, "ControllerMatches")
	member(b, first, "player"); enc_ptr_PlayerFilter(b, y.player)

	case FilterProp_WasPlayed: _ = y; member(b, first, "type"); json.write_string(b, "WasPlayed")
	case FilterProp_CastThisTurn: member(b, first, "type"); json.write_string(b, "CastThisTurn")
	member(b, first, "caster"); encode_ControllerRef(b, y.caster)

	case FilterProp_Attacking: member(b, first, "type"); json.write_string(b, "Attacking")
	if !(y.defender == nil) { member(b, first, "defender"); enc_opt_ControllerRef(b, y.defender) }

	case FilterProp_Blocking: _ = y; member(b, first, "type"); json.write_string(b, "Blocking")
	case FilterProp_BlockingSource: _ = y; member(b, first, "type"); json.write_string(b, "BlockingSource")
	case FilterProp_CombatRelation: member(b, first, "type"); json.write_string(b, "CombatRelation")
	member(b, first, "relation"); encode_CombatRelation(b, y.relation)
	member(b, first, "subject"); encode_CombatRelationSubject(b, y.subject)

	case FilterProp_BlockStatus: member(b, first, "type"); json.write_string(b, "BlockStatus")
	member(b, first, "status"); encode_AttackerBlockStatus(b, y.status)

	case FilterProp_AttackingAlone: _ = y; member(b, first, "type"); json.write_string(b, "AttackingAlone")
	case FilterProp_BlockingAlone: _ = y; member(b, first, "type"); json.write_string(b, "BlockingAlone")
	case FilterProp_Tapped: _ = y; member(b, first, "type"); json.write_string(b, "Tapped")
	case FilterProp_Untapped: _ = y; member(b, first, "type"); json.write_string(b, "Untapped")
	case FilterProp_IsSaddled: _ = y; member(b, first, "type"); json.write_string(b, "IsSaddled")
	case FilterProp_SaddledSource: _ = y; member(b, first, "type"); json.write_string(b, "SaddledSource")
	case FilterProp_CrewedThisTurn: member(b, first, "type"); json.write_string(b, "CrewedThisTurn")
	member(b, first, "relation"); encode_CrewRelation(b, y.relation)

	case FilterProp_ConvokedSource: _ = y; member(b, first, "type"); json.write_string(b, "ConvokedSource")
	case FilterProp_ProtectorMatches: member(b, first, "type"); json.write_string(b, "ProtectorMatches")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)

	case FilterProp_HasHasteOrControlledSinceTurnBegan: _ = y; member(b, first, "type"); json.write_string(b, "HasHasteOrControlledSinceTurnBegan")
	case FilterProp_WithKeyword: member(b, first, "type"); json.write_string(b, "WithKeyword")
	member(b, first, "value"); encode_Keyword(b, y.value)

	case FilterProp_HasKeywordKind: member(b, first, "type"); json.write_string(b, "HasKeywordKind")
	member(b, first, "value"); encode_KeywordKind(b, y.value)

	case FilterProp_WithoutKeyword: member(b, first, "type"); json.write_string(b, "WithoutKeyword")
	member(b, first, "value"); encode_Keyword(b, y.value)

	case FilterProp_WithoutKeywordKind: member(b, first, "type"); json.write_string(b, "WithoutKeywordKind")
	member(b, first, "value"); encode_KeywordKind(b, y.value)

	case FilterProp_CanEnchant: member(b, first, "type"); json.write_string(b, "CanEnchant")
	member(b, first, "target"); enc_ptr_TargetFilter(b, y.target)

	case FilterProp_Counters: member(b, first, "type"); json.write_string(b, "Counters")
	member(b, first, "counters"); encode_CounterMatch(b, y.counters)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)

	case FilterProp_Cmc: member(b, first, "type"); json.write_string(b, "Cmc")
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_QuantityExpr(b, y.value)

	case FilterProp_ManaValueParity: member(b, first, "type"); json.write_string(b, "ManaValueParity")
	member(b, first, "parity"); encode_ParitySource(b, y.parity)

	case FilterProp_ManaCostIn: member(b, first, "type"); json.write_string(b, "ManaCostIn")
	member(b, first, "costs"); enc_dyn_ManaCost(b, y.costs)

	case FilterProp_InZone: member(b, first, "type"); json.write_string(b, "InZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)

	case FilterProp_Owned: member(b, first, "type"); json.write_string(b, "Owned")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)

	case FilterProp_Foretold: _ = y; member(b, first, "type"); json.write_string(b, "Foretold")
	case FilterProp_HasAdventure: _ = y; member(b, first, "type"); json.write_string(b, "HasAdventure")
	case FilterProp_EnchantedBy: _ = y; member(b, first, "type"); json.write_string(b, "EnchantedBy")
	case FilterProp_EquippedBy: _ = y; member(b, first, "type"); json.write_string(b, "EquippedBy")
	case FilterProp_AttachedTo: member(b, first, "type"); json.write_string(b, "AttachedTo")
	member(b, first, "to"); encode_AttachmentReferent(b, y.to)

	case FilterProp_HasAttachment: member(b, first, "type"); json.write_string(b, "HasAttachment")
	member(b, first, "kind"); encode_AttachmentKind(b, y.kind)
	if !(y.controller == nil) { member(b, first, "controller"); enc_opt_ControllerRef(b, y.controller) }
	if !(skip_FilterProp_SourceExclusion_is_include(y.exclude_source)) { member(b, first, "exclude_source"); encode_with_source_exclusion_bool_compat(b, y.exclude_source) }

	case FilterProp_HasAnyAttachmentOf: member(b, first, "type"); json.write_string(b, "HasAnyAttachmentOf")
	member(b, first, "kinds"); enc_dyn_AttachmentKind(b, y.kinds)
	if !(y.controller == nil) { member(b, first, "controller"); enc_opt_ControllerRef(b, y.controller) }

	case FilterProp_Another: _ = y; member(b, first, "type"); json.write_string(b, "Another")
	case FilterProp_Unpaired: _ = y; member(b, first, "type"); json.write_string(b, "Unpaired")
	case FilterProp_OtherThanTriggerObject: _ = y; member(b, first, "type"); json.write_string(b, "OtherThanTriggerObject")
	case FilterProp_HasColor: member(b, first, "type"); json.write_string(b, "HasColor")
	member(b, first, "color"); encode_ManaColor(b, y.color)

	case FilterProp_PtComparison: member(b, first, "type"); json.write_string(b, "PtComparison")
	member(b, first, "stat"); encode_PtStat(b, y.stat)
	member(b, first, "scope"); encode_PtValueScope(b, y.scope)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_QuantityExpr(b, y.value)

	case FilterProp_PowerGTSource: _ = y; member(b, first, "type"); json.write_string(b, "PowerGTSource")
	case FilterProp_ColorCount: member(b, first, "type"); json.write_string(b, "ColorCount")
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "count"); encode_u8(b, y.count)

	case FilterProp_ManaSymbolCount: member(b, first, "type"); json.write_string(b, "ManaSymbolCount")
	member(b, first, "color"); enc_opt_ManaColor(b, y.color)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_i32(b, y.value)

	case FilterProp_HasSupertype: member(b, first, "type"); json.write_string(b, "HasSupertype")
	member(b, first, "value"); encode_Supertype(b, y.value)

	case FilterProp_IsChosenCreatureType: _ = y; member(b, first, "type"); json.write_string(b, "IsChosenCreatureType")
	case FilterProp_MostPrevalentCreatureTypeIn: member(b, first, "type"); json.write_string(b, "MostPrevalentCreatureTypeIn")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	member(b, first, "scope"); encode_ControllerRef(b, y.scope)

	case FilterProp_IsChosenColor: _ = y; member(b, first, "type"); json.write_string(b, "IsChosenColor")
	case FilterProp_IsChosenCardType: _ = y; member(b, first, "type"); json.write_string(b, "IsChosenCardType")
	case FilterProp_MatchesLastChosenCardPredicate: _ = y; member(b, first, "type"); json.write_string(b, "MatchesLastChosenCardPredicate")
	case FilterProp_HasSingleTarget: _ = y; member(b, first, "type"); json.write_string(b, "HasSingleTarget")
	case FilterProp_Modal: _ = y; member(b, first, "type"); json.write_string(b, "Modal")
	case FilterProp_PrepareSpell: _ = y; member(b, first, "type"); json.write_string(b, "PrepareSpell")
	case FilterProp_NotColor: member(b, first, "type"); json.write_string(b, "NotColor")
	member(b, first, "color"); encode_ManaColor(b, y.color)

	case FilterProp_NotSupertype: member(b, first, "type"); json.write_string(b, "NotSupertype")
	member(b, first, "value"); encode_Supertype(b, y.value)

	case FilterProp_Suspected: _ = y; member(b, first, "type"); json.write_string(b, "Suspected")
	case FilterProp_Renowned: _ = y; member(b, first, "type"); json.write_string(b, "Renowned")
	case FilterProp_Goaded: _ = y; member(b, first, "type"); json.write_string(b, "Goaded")
	case FilterProp_Prepared: _ = y; member(b, first, "type"); json.write_string(b, "Prepared")
	case FilterProp_ToughnessGTPower: _ = y; member(b, first, "type"); json.write_string(b, "ToughnessGTPower")
	case FilterProp_PowerExceedsBase: _ = y; member(b, first, "type"); json.write_string(b, "PowerExceedsBase")
	case FilterProp_AnyOf: member(b, first, "type"); json.write_string(b, "AnyOf")
	member(b, first, "props"); enc_dyn_FilterProp(b, y.props)

	case FilterProp_Not: member(b, first, "type"); json.write_string(b, "Not")
	member(b, first, "prop"); enc_ptr_FilterProp(b, y.prop)

	case FilterProp_InTrackedSet: member(b, first, "type"); json.write_string(b, "InTrackedSet")
	member(b, first, "id"); encode_TrackedSetId(b, y.id)

	case FilterProp_Modified: _ = y; member(b, first, "type"); json.write_string(b, "Modified")
	case FilterProp_Historic: _ = y; member(b, first, "type"); json.write_string(b, "Historic")
	case FilterProp_NotHistoric: _ = y; member(b, first, "type"); json.write_string(b, "NotHistoric")
	case FilterProp_DifferentNameFrom: member(b, first, "type"); json.write_string(b, "DifferentNameFrom")
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)

	case FilterProp_DistinctFrom: member(b, first, "type"); json.write_string(b, "DistinctFrom")
	member(b, first, "reference"); enc_ptr_TargetFilter(b, y.reference)

	case FilterProp_InAnyZone: member(b, first, "type"); json.write_string(b, "InAnyZone")
	member(b, first, "zones"); enc_dyn_Zone(b, y.zones)

	case FilterProp_SharesQuality: member(b, first, "type"); json.write_string(b, "SharesQuality")
	member(b, first, "quality"); encode_SharedQuality(b, y.quality)
	if !(y.reference == nil) { member(b, first, "reference"); enc_ptr_TargetFilter(b, y.reference) }
	if !(skip_FilterProp_is_default_shared_quality_relation(y.relation)) { member(b, first, "relation"); encode_SharedQualityRelation(b, y.relation) }

	case FilterProp_WasDealtDamageThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "WasDealtDamageThisTurn")
	case FilterProp_DealtDamageThisTurn: member(b, first, "type"); json.write_string(b, "DealtDamageThisTurn")
	member(b, first, "kind"); encode_DamageKindFilter(b, y.kind)
	if !(y.recipient == nil) { member(b, first, "recipient"); enc_opt_PlayerFilter(b, y.recipient) }

	case FilterProp_EnteredThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "EnteredThisTurn")
	case FilterProp_ControlledContinuouslySinceTurnBegan: _ = y; member(b, first, "type"); json.write_string(b, "ControlledContinuouslySinceTurnBegan")
	case FilterProp_ZoneChangedThisTurn: member(b, first, "type"); json.write_string(b, "ZoneChangedThisTurn")
	if !(y.from == nil) { member(b, first, "from"); enc_opt_Zone(b, y.from) }
	if !(y.to == nil) { member(b, first, "to"); enc_opt_Zone(b, y.to) }

	case FilterProp_AttackedThisTurn: member(b, first, "type"); json.write_string(b, "AttackedThisTurn")
	if !(y.defender == nil) { member(b, first, "defender"); enc_opt_ControllerRef(b, y.defender) }

	case FilterProp_BlockedThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "BlockedThisTurn")
	case FilterProp_FoughtThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "FoughtThisTurn")
	case FilterProp_AttackedOrBlockedThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "AttackedOrBlockedThisTurn")
	case FilterProp_CountersPutOnThisTurn: member(b, first, "type"); json.write_string(b, "CountersPutOnThisTurn")
	member(b, first, "actor"); encode_CountScope(b, y.actor)
	member(b, first, "counters"); encode_CounterMatch(b, y.counters)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "count"); encode_u32(b, y.count)

	case FilterProp_FaceDown: _ = y; member(b, first, "type"); json.write_string(b, "FaceDown")
	case FilterProp_Transformed: _ = y; member(b, first, "type"); json.write_string(b, "Transformed")
	case FilterProp_TargetsOnly: member(b, first, "type"); json.write_string(b, "TargetsOnly")
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)

	case FilterProp_Targets: member(b, first, "type"); json.write_string(b, "Targets")
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)

	case FilterProp_CouldBeTargetedByTriggeringSpell: _ = y; member(b, first, "type"); json.write_string(b, "CouldBeTargetedByTriggeringSpell")
	case FilterProp_HasXInManaCost: _ = y; member(b, first, "type"); json.write_string(b, "HasXInManaCost")
	case FilterProp_HasXInActivationCost: _ = y; member(b, first, "type"); json.write_string(b, "HasXInActivationCost")
	case FilterProp_WasKicked: _ = y; member(b, first, "type"); json.write_string(b, "WasKicked")
	case FilterProp_HasManaAbility: _ = y; member(b, first, "type"); json.write_string(b, "HasManaAbility")
	case FilterProp_HasNoAbilities: _ = y; member(b, first, "type"); json.write_string(b, "HasNoAbilities")
	case FilterProp_Named: member(b, first, "type"); json.write_string(b, "Named")
	member(b, first, "name"); encode_string(b, y.name)

	case FilterProp_SameName: _ = y; member(b, first, "type"); json.write_string(b, "SameName")
	case FilterProp_SameNameAsParentTarget: _ = y; member(b, first, "type"); json.write_string(b, "SameNameAsParentTarget")
	case FilterProp_SameNameAsExiledBySource: _ = y; member(b, first, "type"); json.write_string(b, "SameNameAsExiledBySource")
	case FilterProp_NameMatchesAnyPermanent: member(b, first, "type"); json.write_string(b, "NameMatchesAnyPermanent")
	member(b, first, "controller"); enc_opt_ControllerRef(b, y.controller)

	case FilterProp_IsCommander: _ = y; member(b, first, "type"); json.write_string(b, "IsCommander")
	case FilterProp_SharesCreatureTypeWithCommander: _ = y; member(b, first, "type"); json.write_string(b, "SharesCreatureTypeWithCommander")
	case FilterProp_Other: member(b, first, "type"); json.write_string(b, "Other")
	member(b, first, "value"); encode_string(b, y.value)

	}
}

