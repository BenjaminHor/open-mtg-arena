	case WaitingFor_ChooseTokenHost: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChooseTokenHost"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
