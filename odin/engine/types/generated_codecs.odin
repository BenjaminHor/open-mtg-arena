decode_PtValue :: proc(v: json.Value, out: ^PtValue) -> bool {
	if v.kind != .Object do return fail("PtValue: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("PtValue: no tag")
	switch tv.text {
	case "Fixed": tmp: PtValue_Fixed; if !decode_i32(json.get_or_null(v, "value"), &tmp._0) do return fail("PtValue::Fixed"); out^ = tmp
	case "Variable": tmp: PtValue_Variable; if !decode_string(json.get_or_null(v, "value"), &tmp._0) do return fail("PtValue::Variable"); out^ = tmp
	case "Quantity": tmp: PtValue_Quantity; if !decode_QuantityExpr(json.get_or_null(v, "value"), &tmp._0) do return fail("PtValue::Quantity"); out^ = tmp
	case: return fail("PtValue: unknown variant")
	}
	return true
}

encode_PtValue :: proc(b: ^strings.Builder, x: PtValue) {
	#partial switch y in x {
	case PtValue_Fixed: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Fixed"); member(b, &f, "value"); encode_i32(b, y._0); strings.write_byte(b, '}')
	case PtValue_Variable: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Variable"); member(b, &f, "value"); encode_string(b, y._0); strings.write_byte(b, '}')
	case PtValue_Quantity: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Quantity"); member(b, &f, "value"); encode_QuantityExpr(b, y._0); strings.write_byte(b, '}')
	}
}

decode_Keyword :: proc(v: json.Value, out: ^Keyword) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("Keyword: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("Keyword: not a string or object")
	}
	switch variant {
	case "Flying": out^ = Keyword_Flying{}
	case "FirstStrike": out^ = Keyword_FirstStrike{}
	case "DoubleStrike": out^ = Keyword_DoubleStrike{}
	case "Trample": out^ = Keyword_Trample{}
	case "TrampleOverPlaneswalkers": out^ = Keyword_TrampleOverPlaneswalkers{}
	case "Deathtouch": out^ = Keyword_Deathtouch{}
	case "Lifelink": out^ = Keyword_Lifelink{}
	case "Vigilance": out^ = Keyword_Vigilance{}
	case "Haste": out^ = Keyword_Haste{}
	case "Reach": out^ = Keyword_Reach{}
	case "Defender": out^ = Keyword_Defender{}
	case "Menace": out^ = Keyword_Menace{}
	case "Indestructible": out^ = Keyword_Indestructible{}
	case "Hexproof": out^ = Keyword_Hexproof{}
	case "HexproofFrom": tmp: Keyword_HexproofFrom; if !decode_HexproofFilter(body, &tmp._0) do return fail("Keyword::HexproofFrom"); out^ = tmp
	case "Shroud": out^ = Keyword_Shroud{}
	case "Flash": out^ = Keyword_Flash{}
	case "Fear": out^ = Keyword_Fear{}
	case "Intimidate": out^ = Keyword_Intimidate{}
	case "Skulk": out^ = Keyword_Skulk{}
	case "Shadow": out^ = Keyword_Shadow{}
	case "Horsemanship": out^ = Keyword_Horsemanship{}
	case "Wither": out^ = Keyword_Wither{}
	case "Infect": out^ = Keyword_Infect{}
	case "Afflict": tmp: Keyword_Afflict; if !decode_u32(body, &tmp._0) do return fail("Keyword::Afflict"); out^ = tmp
	case "StartingIntensity": tmp: Keyword_StartingIntensity; if !decode_u32(body, &tmp._0) do return fail("Keyword::StartingIntensity"); out^ = tmp
	case "Prowess": out^ = Keyword_Prowess{}
	case "Undying": out^ = Keyword_Undying{}
	case "Persist": out^ = Keyword_Persist{}
	case "Cascade": out^ = Keyword_Cascade{}
	case "Exalted": out^ = Keyword_Exalted{}
	case "Flanking": out^ = Keyword_Flanking{}
	case "Evolve": out^ = Keyword_Evolve{}
	case "Extort": out^ = Keyword_Extort{}
	case "Exploit": out^ = Keyword_Exploit{}
