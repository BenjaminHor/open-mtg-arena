decode_MorphCost :: proc(v: json.Value, out: ^MorphCost) -> bool {
	when COVERAGE do cov_hit("MorphCost")
	if v.kind != .Object do return fail("MorphCost: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("MorphCost: no tag")
	switch tv.text {
	case "Mana": when COVERAGE do cov_hit("MorphCost::Mana"); tmp: MorphCost_Mana; if !decode_ManaCost(json.get_or_null(v, "data"), &tmp._0) do return fail("MorphCost::Mana"); out^ = tmp
	case "NonMana": when COVERAGE do cov_hit("MorphCost::NonMana"); tmp: MorphCost_NonMana; if !decode_AbilityCost(json.get_or_null(v, "data"), &tmp._0) do return fail("MorphCost::NonMana"); out^ = tmp
	case: return fail("MorphCost: unknown variant")
	}
	return true
}

