decode_StructuralRules :: proc(v: json.Value, out: ^StructuralRules) -> bool {
	when COVERAGE do cov_hit("StructuralRules")
	if v.kind != .Object do return fail("StructuralRules: not an object")
	if fv, found := get_any(v, "starting_life"); found { if !decode_i32(fv, &out.starting_life) do return fail("StructuralRules.starting_life") } else { return fail("StructuralRules.starting_life missing") }
	if fv, found := get_any(v, "min_players"); found { if !decode_u8(fv, &out.min_players) do return fail("StructuralRules.min_players") } else { return fail("StructuralRules.min_players missing") }
