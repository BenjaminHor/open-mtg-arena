decode_ManaTapState :: proc(v: json.Value, out: ^ManaTapState) -> bool {
	when COVERAGE do cov_hit("ManaTapState")
	if v.kind != .String do return fail("ManaTapState: not a string")
	str := v.text
	switch str {
	case "NotFromTap": when COVERAGE do cov_hit("ManaTapState::NotFromTap"); out^ = .NotFromTap
	case "FromTap": when COVERAGE do cov_hit("ManaTapState::FromTap"); out^ = .FromTap
	case "FromTapTriggersResolved": when COVERAGE do cov_hit("ManaTapState::FromTapTriggersResolved"); out^ = .FromTapTriggersResolved
	case: return fail("ManaTapState: unknown variant")
	}
	return true
}

