	if fv, found := get_any(v, "source"); found { if !decode_LinkedExileScope(fv, &out.source) do return fail("ManaProduction::ChoiceAmongExiledColors.source") }
	return true
		}) { return fail("ManaProduction::ChoiceAmongExiledColors") }
		out^ = tmp
	case "ChoiceAmongCombinations": when COVERAGE do cov_hit("ManaProduction::ChoiceAmongCombinations");
		tmp: ManaProduction_ChoiceAmongCombinations
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ManaProduction_ChoiceAmongCombinations) -> bool {
	if fv, found := get_any(v, "options"); found { if !dec_dyn_dyn_ManaColor(fv, &out.options) do return fail("ManaProduction::ChoiceAmongCombinations.options") }
	return true
		}) { return fail("ManaProduction::ChoiceAmongCombinations") }
		out^ = tmp
	case "AnyInCommandersColorIdentity": when COVERAGE do cov_hit("ManaProduction::AnyInCommandersColorIdentity");
		tmp: ManaProduction_AnyInCommandersColorIdentity
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ManaProduction_AnyInCommandersColorIdentity) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("ManaProduction::AnyInCommandersColorIdentity.count") } else { out.count = default_ManaProduction_default_quantity_one() }
	if fv, found := get_any(v, "contribution"); found { if !decode_ManaContribution(fv, &out.contribution) do return fail("ManaProduction::AnyInCommandersColorIdentity.contribution") } else { out.contribution = default_ManaProduction_default_mana_contribution() }
	return true
		}) { return fail("ManaProduction::AnyInCommandersColorIdentity") }
		out^ = tmp
