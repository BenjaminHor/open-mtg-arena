decode_ProtectionDoesNotRemove :: proc(v: json.Value, out: ^ProtectionDoesNotRemove) -> bool {
	when COVERAGE do cov_hit("ProtectionDoesNotRemove")
	if v.kind != .String do return fail("ProtectionDoesNotRemove: not a string")
	str := v.text
	switch str {
	case "Source": when COVERAGE do cov_hit("ProtectionDoesNotRemove::Source"); out^ = .Source
	case "Auras": when COVERAGE do cov_hit("ProtectionDoesNotRemove::Auras"); out^ = .Auras
	case "ControlledAttachmentsAlreadyAttached": when COVERAGE do cov_hit("ProtectionDoesNotRemove::ControlledAttachmentsAlreadyAttached"); out^ = .ControlledAttachmentsAlreadyAttached
	case: return fail("ProtectionDoesNotRemove: unknown variant")
	}
	return true
}

encode_ProtectionDoesNotRemove :: proc(b: ^strings.Builder, x: ProtectionDoesNotRemove) {
	@(static, rodata) NAMES := [ProtectionDoesNotRemove]string{
		.Source = "Source",
		.Auras = "Auras",
		.ControlledAttachmentsAlreadyAttached = "ControlledAttachmentsAlreadyAttached",
	}
	json.write_string(b, NAMES[x])
}

decode_AttackDefenderScope :: proc(v: json.Value, out: ^AttackDefenderScope) -> bool {
	when COVERAGE do cov_hit("AttackDefenderScope")
	if v.kind != .String do return fail("AttackDefenderScope: not a string")
	str := v.text
	switch str {
	case "Controller": when COVERAGE do cov_hit("AttackDefenderScope::Controller"); out^ = .Controller
	case "ThisPermanent": when COVERAGE do cov_hit("AttackDefenderScope::ThisPermanent"); out^ = .ThisPermanent
	case: return fail("AttackDefenderScope: unknown variant")
	}
	return true
}

encode_AttackDefenderScope :: proc(b: ^strings.Builder, x: AttackDefenderScope) {
	@(static, rodata) NAMES := [AttackDefenderScope]string{
		.Controller = "Controller",
		.ThisPermanent = "ThisPermanent",
	}
	json.write_string(b, NAMES[x])
}

decode_ProhibitionScope :: proc(v: json.Value, out: ^ProhibitionScope) -> bool {
	when COVERAGE do cov_hit("ProhibitionScope")
	if v.kind != .String do return fail("ProhibitionScope: not a string")
	str := v.text
	switch str {
	case "Opponents": when COVERAGE do cov_hit("ProhibitionScope::Opponents"); out^ = .Opponents
	case "AllPlayers": when COVERAGE do cov_hit("ProhibitionScope::AllPlayers"); out^ = .AllPlayers
	case "Controller": when COVERAGE do cov_hit("ProhibitionScope::Controller"); out^ = .Controller
	case "EnchantedCreatureController": when COVERAGE do cov_hit("ProhibitionScope::EnchantedCreatureController"); out^ = .EnchantedCreatureController
	case: return fail("ProhibitionScope: unknown variant")
	}
	return true
}

encode_ProhibitionScope :: proc(b: ^strings.Builder, x: ProhibitionScope) {
	@(static, rodata) NAMES := [ProhibitionScope]string{
		.Opponents = "Opponents",
		.AllPlayers = "AllPlayers",
		.Controller = "Controller",
		.EnchantedCreatureController = "EnchantedCreatureController",
	}
