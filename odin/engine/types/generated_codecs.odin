	member(b, first, "window"); encode_ControlWindow(b, x.window)
}

decode_ExtraPhase :: proc(v: json.Value, out: ^ExtraPhase) -> bool {
	when COVERAGE do cov_hit("ExtraPhase")
	if v.kind != .Object do return fail("ExtraPhase: not an object")
	if fv, found := get_any(v, "anchor"); found { if !decode_Phase(fv, &out.anchor) do return fail("ExtraPhase.anchor") } else { return fail("ExtraPhase.anchor missing") }
	if fv, found := get_any(v, "segment"); found { if !decode_TurnSegment(fv, &out.segment) do return fail("ExtraPhase.segment") } else { return fail("ExtraPhase.segment missing") }
	if fv, found := get_any(v, "attacker_restriction"); found { if !dec_opt_TargetFilter(fv, &out.attacker_restriction) do return fail("ExtraPhase.attacker_restriction") }
	if fv, found := get_any(v, "attacker_restriction_source"); found { if !dec_opt_ObjectId(fv, &out.attacker_restriction_source) do return fail("ExtraPhase.attacker_restriction_source") }
	if fv, found := get_any(v, "id"); found { if !decode_ExtraPhaseId(fv, &out.id) do return fail("ExtraPhase.id") }
	return true
}

encode_ExtraPhase :: proc(b: ^strings.Builder, x: ExtraPhase) {
	strings.write_byte(b, '{')
	f := true
	encode_ExtraPhase_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ExtraPhase_members :: proc(b: ^strings.Builder, x: ExtraPhase, first: ^bool) {
	member(b, first, "anchor"); encode_Phase(b, x.anchor)
	member(b, first, "segment"); encode_TurnSegment(b, x.segment)
	member(b, first, "attacker_restriction"); enc_opt_TargetFilter(b, x.attacker_restriction)
	member(b, first, "attacker_restriction_source"); enc_opt_ObjectId(b, x.attacker_restriction_source)
	member(b, first, "id"); encode_ExtraPhaseId(b, x.id)
}

