decode_ChosenTargetSlots :: proc(v: json.Value, out: ^ChosenTargetSlots) -> bool {
	when COVERAGE do cov_hit("ChosenTargetSlots")
	// untagged: the first variant that decodes wins, as in serde.
	if v.kind == .Null { out^ = ChosenTargetSlots_Unrecorded{}; return true }
	{ tmp: ChosenTargetSlots_Recorded; if decode_quiet_proc(v, &tmp._0, dec_dyn_int) { out^ = tmp; return true } }
	return fail("ChosenTargetSlots: no untagged variant matched")
}

encode_ChosenTargetSlots :: proc(b: ^strings.Builder, x: ChosenTargetSlots) {
	#partial switch y in x {
	case ChosenTargetSlots_Unrecorded: _ = y; strings.write_string(b, "null")
	case ChosenTargetSlots_Recorded: enc_dyn_int(b, y._0)
	}
}

decode_CostReduction :: proc(v: json.Value, out: ^CostReduction) -> bool {
	when COVERAGE do cov_hit("CostReduction")
	if v.kind != .Object do return fail("CostReduction: not an object")
	if fv, found := get_any(v, "mode"); found { if !decode_CostModifyMode(fv, &out.mode) do return fail("CostReduction.mode") }
	if fv, found := get_any(v, "amount_per"); found { if !decode_u32(fv, &out.amount_per) do return fail("CostReduction.amount_per") } else { return fail("CostReduction.amount_per missing") }
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("CostReduction.count") } else { return fail("CostReduction.count missing") }
	if fv, found := get_any(v, "condition"); found { if !dec_opt_ParsedCondition(fv, &out.condition) do return fail("CostReduction.condition") }
	return true
}

encode_CostReduction :: proc(b: ^strings.Builder, x: CostReduction) {
	strings.write_byte(b, '{')
	f := true
	encode_CostReduction_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CostReduction_members :: proc(b: ^strings.Builder, x: CostReduction, first: ^bool) {
	if !(skip_CostReduction_statics_is_cost_modify_mode_reduce_CostModifyMode(x.mode)) { member(b, first, "mode"); encode_CostModifyMode(b, x.mode) }
	member(b, first, "amount_per"); encode_u32(b, x.amount_per)
	member(b, first, "count"); encode_QuantityExpr(b, x.count)
	if !(x.condition == nil) { member(b, first, "condition"); enc_opt_ParsedCondition(b, x.condition) }
}

