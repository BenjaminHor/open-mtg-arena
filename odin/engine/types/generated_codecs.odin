	if fv, found := get_any(v, "source_incarnation"); found { if !dec_opt_u64(fv, &out.source_incarnation) do return fail("DamageRecord.source_incarnation") }
	if fv, found := get_any(v, "amount"); found { if !decode_u32(fv, &out.amount) do return fail("DamageRecord.amount") } else { return fail("DamageRecord.amount missing") }
	if fv, found := get_any(v, "is_combat"); found { if !decode_bool(fv, &out.is_combat) do return fail("DamageRecord.is_combat") }
	if fv, found := get_any(v, "source_name"); found { if !decode_string(fv, &out.source_name) do return fail("DamageRecord.source_name") }
	if fv, found := get_any(v, "source_core_types"); found { if !dec_dyn_CoreType(fv, &out.source_core_types) do return fail("DamageRecord.source_core_types") }
	if fv, found := get_any(v, "source_subtypes"); found { if !dec_dyn_string(fv, &out.source_subtypes) do return fail("DamageRecord.source_subtypes") }
	if fv, found := get_any(v, "source_supertypes"); found { if !dec_dyn_Supertype(fv, &out.source_supertypes) do return fail("DamageRecord.source_supertypes") }
	if fv, found := get_any(v, "source_keywords"); found { if !dec_dyn_Keyword(fv, &out.source_keywords) do return fail("DamageRecord.source_keywords") }
	if fv, found := get_any(v, "source_power"); found { if !dec_opt_i32(fv, &out.source_power) do return fail("DamageRecord.source_power") }
	if fv, found := get_any(v, "source_toughness"); found { if !dec_opt_i32(fv, &out.source_toughness) do return fail("DamageRecord.source_toughness") }
	if fv, found := get_any(v, "source_colors"); found { if !dec_dyn_ManaColor(fv, &out.source_colors) do return fail("DamageRecord.source_colors") }
	if fv, found := get_any(v, "source_mana_value"); found { if !decode_u32(fv, &out.source_mana_value) do return fail("DamageRecord.source_mana_value") }
	if fv, found := get_any(v, "source_controller_snapshot"); found { if !decode_PlayerId(fv, &out.source_controller_snapshot) do return fail("DamageRecord.source_controller_snapshot") }
	if fv, found := get_any(v, "source_owner"); found { if !decode_PlayerId(fv, &out.source_owner) do return fail("DamageRecord.source_owner") }
	if fv, found := get_any(v, "source_zone"); found { if !decode_Zone(fv, &out.source_zone) do return fail("DamageRecord.source_zone") } else { out.source_zone = default_DamageRecord_default_source_zone() }
	if fv, found := get_any(v, "excess"); found { if !decode_u32(fv, &out.excess) do return fail("DamageRecord.excess") }
	return true
}

