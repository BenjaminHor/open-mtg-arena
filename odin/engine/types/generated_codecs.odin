		tmp: ProposedEvent_BeginPhase
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ProposedEvent_BeginPhase) -> bool {
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("ProposedEvent::BeginPhase.player_id") } else { return fail("ProposedEvent::BeginPhase.player_id missing") }
	if fv, found := get_any(v, "phase"); found { if !decode_Phase(fv, &out.phase) do return fail("ProposedEvent::BeginPhase.phase") } else { return fail("ProposedEvent::BeginPhase.phase missing") }
