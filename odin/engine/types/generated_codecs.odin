decode_ExtraPhaseId :: proc(v: json.Value, out: ^ExtraPhaseId) -> bool {
	when COVERAGE do cov_hit("ExtraPhaseId")
	return decode_u64(v, cast(^u64)out)
}

encode_ExtraPhaseId :: proc(b: ^strings.Builder, x: ExtraPhaseId) {
	encode_u64(b, cast(u64)x)
}

decode_ExtraTurnId :: proc(v: json.Value, out: ^ExtraTurnId) -> bool {
	when COVERAGE do cov_hit("ExtraTurnId")
	return decode_u64(v, cast(^u64)out)
}

encode_ExtraTurnId :: proc(b: ^strings.Builder, x: ExtraTurnId) {
	encode_u64(b, cast(u64)x)
}

decode_TurnDirection :: proc(v: json.Value, out: ^TurnDirection) -> bool {
	when COVERAGE do cov_hit("TurnDirection")
	if v.kind != .String do return fail("TurnDirection: not a string")
	str := v.text
	switch str {
	case "Normal": when COVERAGE do cov_hit("TurnDirection::Normal"); out^ = .Normal
	case "Reversed": when COVERAGE do cov_hit("TurnDirection::Reversed"); out^ = .Reversed
	case: return fail("TurnDirection: unknown variant")
	}
	return true
}

encode_TurnDirection :: proc(b: ^strings.Builder, x: TurnDirection) {
	@(static, rodata) NAMES := [TurnDirection]string{
		.Normal = "Normal",
		.Reversed = "Reversed",
	}
	json.write_string(b, NAMES[x])
}

decode_TargetFilter :: proc(v: json.Value, out: ^TargetFilter) -> bool {
	when COVERAGE do cov_hit("TargetFilter")
	if v.kind != .Object do return fail("TargetFilter: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("TargetFilter: no tag")
	switch tv.text {
	case "None": when COVERAGE do cov_hit("TargetFilter::None"); out^ = TargetFilter_None{}
	case "Any": when COVERAGE do cov_hit("TargetFilter::Any"); out^ = TargetFilter_Any{}
	case "Player": when COVERAGE do cov_hit("TargetFilter::Player"); out^ = TargetFilter_Player{}
	case "Controller": when COVERAGE do cov_hit("TargetFilter::Controller"); out^ = TargetFilter_Controller{}
	case "SourceController": when COVERAGE do cov_hit("TargetFilter::SourceController"); out^ = TargetFilter_SourceController{}
	case "ControllerAndControlledPermanents": when COVERAGE do cov_hit("TargetFilter::ControllerAndControlledPermanents");
		tmp: TargetFilter_ControllerAndControlledPermanents
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_ControllerAndControlledPermanents) -> bool {
	if fv, found := get_any(v, "permanent_type"); found { if !dec_opt_CoreType(fv, &out.permanent_type) do return fail("TargetFilter::ControllerAndControlledPermanents.permanent_type") }
	if fv, found := get_any(v, "source_scope"); found { if !decode_SourceExclusion(fv, &out.source_scope) do return fail("TargetFilter::ControllerAndControlledPermanents.source_scope") }
	return true
		}) { return fail("TargetFilter::ControllerAndControlledPermanents") }
		out^ = tmp
	case "Opponent": when COVERAGE do cov_hit("TargetFilter::Opponent"); out^ = TargetFilter_Opponent{}
	case "SelfRef": when COVERAGE do cov_hit("TargetFilter::SelfRef"); out^ = TargetFilter_SelfRef{}
	case "GrantingObject": when COVERAGE do cov_hit("TargetFilter::GrantingObject");
		tmp: TargetFilter_GrantingObject
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_GrantingObject) -> bool {
	if fv, found := get_any(v, "bound"); found { if !dec_opt_ObjectIncarnationRef(fv, &out.bound) do return fail("TargetFilter::GrantingObject.bound") }
	return true
		}) { return fail("TargetFilter::GrantingObject") }
		out^ = tmp
	case "SourceOrPaired": when COVERAGE do cov_hit("TargetFilter::SourceOrPaired"); out^ = TargetFilter_SourceOrPaired{}
	case "Typed": when COVERAGE do cov_hit("TargetFilter::Typed"); tmp: TargetFilter_Typed; if !decode_TypedFilter(v, &tmp._0) do return fail("TargetFilter::Typed"); out^ = tmp
	case "Not": when COVERAGE do cov_hit("TargetFilter::Not");
		tmp: TargetFilter_Not
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_Not) -> bool {
	if fv, found := get_any(v, "filter"); found { if !dec_ptr_TargetFilter(fv, &out.filter) do return fail("TargetFilter::Not.filter") } else { return fail("TargetFilter::Not.filter missing") }
	return true
		}) { return fail("TargetFilter::Not") }
		out^ = tmp
	case "Or": when COVERAGE do cov_hit("TargetFilter::Or");
		tmp: TargetFilter_Or
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_Or) -> bool {
	if fv, found := get_any(v, "filters"); found { if !dec_dyn_TargetFilter(fv, &out.filters) do return fail("TargetFilter::Or.filters") } else { return fail("TargetFilter::Or.filters missing") }
	return true
		}) { return fail("TargetFilter::Or") }
		out^ = tmp
	case "And": when COVERAGE do cov_hit("TargetFilter::And");
		tmp: TargetFilter_And
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_And) -> bool {
	if fv, found := get_any(v, "filters"); found { if !dec_dyn_TargetFilter(fv, &out.filters) do return fail("TargetFilter::And.filters") } else { return fail("TargetFilter::And.filters missing") }
	return true
		}) { return fail("TargetFilter::And") }
		out^ = tmp
	case "StackAbility": when COVERAGE do cov_hit("TargetFilter::StackAbility");
		tmp: TargetFilter_StackAbility
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_StackAbility) -> bool {
	if fv, found := get_any(v, "controller"); found { if !dec_opt_ControllerRef(fv, &out.controller) do return fail("TargetFilter::StackAbility.controller") }
	if fv, found := get_any(v, "tag"); found { if !dec_opt_AbilityTag(fv, &out.tag) do return fail("TargetFilter::StackAbility.tag") }
	if fv, found := get_any(v, "kind"); found { if !dec_opt_StackAbilityKind(fv, &out.kind) do return fail("TargetFilter::StackAbility.kind") }
	return true
		}) { return fail("TargetFilter::StackAbility") }
		out^ = tmp
	case "StackSpell": when COVERAGE do cov_hit("TargetFilter::StackSpell"); out^ = TargetFilter_StackSpell{}
	case "CastingSpell": when COVERAGE do cov_hit("TargetFilter::CastingSpell"); out^ = TargetFilter_CastingSpell{}
	case "SpecificObject": when COVERAGE do cov_hit("TargetFilter::SpecificObject");
		tmp: TargetFilter_SpecificObject
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_SpecificObject) -> bool {
	if fv, found := get_any(v, "id"); found { if !decode_ObjectId(fv, &out.id) do return fail("TargetFilter::SpecificObject.id") } else { return fail("TargetFilter::SpecificObject.id missing") }
	return true
		}) { return fail("TargetFilter::SpecificObject") }
		out^ = tmp
	case "SpecificPlayer": when COVERAGE do cov_hit("TargetFilter::SpecificPlayer");
		tmp: TargetFilter_SpecificPlayer
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_SpecificPlayer) -> bool {
	if fv, found := get_any(v, "id"); found { if !decode_PlayerId(fv, &out.id) do return fail("TargetFilter::SpecificPlayer.id") } else { return fail("TargetFilter::SpecificPlayer.id missing") }
	return true
		}) { return fail("TargetFilter::SpecificPlayer") }
		out^ = tmp
	case "PlayerWhoChoseLabel": when COVERAGE do cov_hit("TargetFilter::PlayerWhoChoseLabel");
		tmp: TargetFilter_PlayerWhoChoseLabel
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_PlayerWhoChoseLabel) -> bool {
	if fv, found := get_any(v, "label"); found { if !decode_string(fv, &out.label) do return fail("TargetFilter::PlayerWhoChoseLabel.label") } else { return fail("TargetFilter::PlayerWhoChoseLabel.label missing") }
	return true
		}) { return fail("TargetFilter::PlayerWhoChoseLabel") }
		out^ = tmp
	case "PlayerMatching": when COVERAGE do cov_hit("TargetFilter::PlayerMatching");
		tmp: TargetFilter_PlayerMatching
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_PlayerMatching) -> bool {
	if fv, found := get_any(v, "player"); found { if !dec_ptr_PlayerFilter(fv, &out.player) do return fail("TargetFilter::PlayerMatching.player") } else { return fail("TargetFilter::PlayerMatching.player missing") }
	return true
		}) { return fail("TargetFilter::PlayerMatching") }
		out^ = tmp
	case "Neighbor": when COVERAGE do cov_hit("TargetFilter::Neighbor");
		tmp: TargetFilter_Neighbor
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_Neighbor) -> bool {
	if fv, found := get_any(v, "direction"); found { if !decode_SeatDirection(fv, &out.direction) do return fail("TargetFilter::Neighbor.direction") } else { return fail("TargetFilter::Neighbor.direction missing") }
	return true
		}) { return fail("TargetFilter::Neighbor") }
		out^ = tmp
	case "ScopedPlayer": when COVERAGE do cov_hit("TargetFilter::ScopedPlayer"); out^ = TargetFilter_ScopedPlayer{}
	case "AttachedTo": when COVERAGE do cov_hit("TargetFilter::AttachedTo"); out^ = TargetFilter_AttachedTo{}
	case "LastCreated": when COVERAGE do cov_hit("TargetFilter::LastCreated"); out^ = TargetFilter_LastCreated{}
	case "LastRevealed": when COVERAGE do cov_hit("TargetFilter::LastRevealed"); out^ = TargetFilter_LastRevealed{}
	case "LastZoneChanged": when COVERAGE do cov_hit("TargetFilter::LastZoneChanged"); out^ = TargetFilter_LastZoneChanged{}
	case "CostPaidObject": when COVERAGE do cov_hit("TargetFilter::CostPaidObject"); out^ = TargetFilter_CostPaidObject{}
	case "AmassedArmy": when COVERAGE do cov_hit("TargetFilter::AmassedArmy"); out^ = TargetFilter_AmassedArmy{}
	case "ChosenCard": when COVERAGE do cov_hit("TargetFilter::ChosenCard"); out^ = TargetFilter_ChosenCard{}
	case "TrackedSet": when COVERAGE do cov_hit("TargetFilter::TrackedSet");
		tmp: TargetFilter_TrackedSet
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_TrackedSet) -> bool {
	if fv, found := get_any(v, "id"); found { if !decode_TrackedSetId(fv, &out.id) do return fail("TargetFilter::TrackedSet.id") } else { return fail("TargetFilter::TrackedSet.id missing") }
	return true
		}) { return fail("TargetFilter::TrackedSet") }
		out^ = tmp
	case "TrackedSetFiltered": when COVERAGE do cov_hit("TargetFilter::TrackedSetFiltered");
		tmp: TargetFilter_TrackedSetFiltered
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_TrackedSetFiltered) -> bool {
	if fv, found := get_any(v, "id"); found { if !decode_TrackedSetId(fv, &out.id) do return fail("TargetFilter::TrackedSetFiltered.id") } else { return fail("TargetFilter::TrackedSetFiltered.id missing") }
	if fv, found := get_any(v, "filter"); found { if !dec_ptr_TargetFilter(fv, &out.filter) do return fail("TargetFilter::TrackedSetFiltered.filter") } else { return fail("TargetFilter::TrackedSetFiltered.filter missing") }
	if fv, found := get_any(v, "caused_by"); found { if !dec_opt_ThisWayCause(fv, &out.caused_by) do return fail("TargetFilter::TrackedSetFiltered.caused_by") }
	return true
		}) { return fail("TargetFilter::TrackedSetFiltered") }
		out^ = tmp
	case "ChoiceAssignment": when COVERAGE do cov_hit("TargetFilter::ChoiceAssignment");
		tmp: TargetFilter_ChoiceAssignment
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_ChoiceAssignment) -> bool {
	if fv, found := get_any(v, "side"); found { if !decode_ChoiceAssignmentSide(fv, &out.side) do return fail("TargetFilter::ChoiceAssignment.side") } else { return fail("TargetFilter::ChoiceAssignment.side missing") }
	return true
		}) { return fail("TargetFilter::ChoiceAssignment") }
		out^ = tmp
	case "ExiledBySource": when COVERAGE do cov_hit("TargetFilter::ExiledBySource"); out^ = TargetFilter_ExiledBySource{}
