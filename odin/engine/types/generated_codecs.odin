	if fv, found := get_any(v, "target"); found { if !decode_TargetFilter(fv, &out.target) do return fail("Effect::SetLifeTotal.target") } else { out.target = default_Effect_default_target_filter_any() }
	if fv, found := get_any(v, "amount"); found { if !decode_QuantityExpr(fv, &out.amount) do return fail("Effect::SetLifeTotal.amount") } else { return fail("Effect::SetLifeTotal.amount missing") }
	return true
		}) { return fail("Effect::SetLifeTotal") }
		out^ = tmp
	case "ExchangeLifeWithStat": when COVERAGE do cov_hit("Effect::ExchangeLifeWithStat");
		tmp: Effect_ExchangeLifeWithStat
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^Effect_ExchangeLifeWithStat) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_TargetFilter(fv, &out.player) do return fail("Effect::ExchangeLifeWithStat.player") } else { out.player = default_Effect_default_target_filter_any() }
	if fv, found := get_any(v, "stat"); found { if !decode_PtStat(fv, &out.stat) do return fail("Effect::ExchangeLifeWithStat.stat") } else { return fail("Effect::ExchangeLifeWithStat.stat missing") }
	return true
		}) { return fail("Effect::ExchangeLifeWithStat") }
		out^ = tmp
	case "ExchangeLifeTotals": when COVERAGE do cov_hit("Effect::ExchangeLifeTotals");
		tmp: Effect_ExchangeLifeTotals
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^Effect_ExchangeLifeTotals) -> bool {
	if fv, found := get_any(v, "player_a"); found { if !decode_TargetFilter(fv, &out.player_a) do return fail("Effect::ExchangeLifeTotals.player_a") } else { out.player_a = default_Effect_default_target_filter_any() }
	if fv, found := get_any(v, "player_b"); found { if !decode_TargetFilter(fv, &out.player_b) do return fail("Effect::ExchangeLifeTotals.player_b") } else { out.player_b = default_Effect_default_target_filter_any() }
	return true
		}) { return fail("Effect::ExchangeLifeTotals") }
		out^ = tmp
	case "SetDayNight": when COVERAGE do cov_hit("Effect::SetDayNight");
		tmp: Effect_SetDayNight
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^Effect_SetDayNight) -> bool {
	if fv, found := get_any(v, "to"); found { if !decode_DayNight(fv, &out.to) do return fail("Effect::SetDayNight.to") } else { return fail("Effect::SetDayNight.to missing") }
	return true
		}) { return fail("Effect::SetDayNight") }
		out^ = tmp
	case "GiveControl": when COVERAGE do cov_hit("Effect::GiveControl");
		tmp: Effect_GiveControl
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^Effect_GiveControl) -> bool {
	if fv, found := get_any(v, "target"); found { if !decode_TargetFilter(fv, &out.target) do return fail("Effect::GiveControl.target") } else { out.target = default_Effect_default_target_filter_any() }
	if fv, found := get_any(v, "recipient"); found { if !decode_TargetFilter(fv, &out.recipient) do return fail("Effect::GiveControl.recipient") } else { out.recipient = default_Effect_default_target_filter_any() }
	return true
		}) { return fail("Effect::GiveControl") }
		out^ = tmp
	case "RemoveFromCombat": when COVERAGE do cov_hit("Effect::RemoveFromCombat");
		tmp: Effect_RemoveFromCombat
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^Effect_RemoveFromCombat) -> bool {
	if fv, found := get_any(v, "target"); found { if !decode_TargetFilter(fv, &out.target) do return fail("Effect::RemoveFromCombat.target") } else { out.target = default_Effect_default_target_filter_any() }
	return true
		}) { return fail("Effect::RemoveFromCombat") }
		out^ = tmp
	case "BecomeBlocked": when COVERAGE do cov_hit("Effect::BecomeBlocked");
		tmp: Effect_BecomeBlocked
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^Effect_BecomeBlocked) -> bool {
	if fv, found := get_any(v, "target"); found { if !decode_TargetFilter(fv, &out.target) do return fail("Effect::BecomeBlocked.target") } else { out.target = default_Effect_default_target_filter_any() }
	return true
		}) { return fail("Effect::BecomeBlocked") }
		out^ = tmp
	case "Conjure": when COVERAGE do cov_hit("Effect::Conjure");
		tmp: Effect_Conjure
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^Effect_Conjure) -> bool {
	if fv, found := get_any(v, "cards"); found { if !dec_dyn_ConjureCard(fv, &out.cards) do return fail("Effect::Conjure.cards") } else { return fail("Effect::Conjure.cards missing") }
	if fv, found := get_any(v, "destination"); found { if !decode_Zone(fv, &out.destination) do return fail("Effect::Conjure.destination") } else { return fail("Effect::Conjure.destination missing") }
	if fv, found := get_any(v, "tapped"); found { if !decode_bool(fv, &out.tapped) do return fail("Effect::Conjure.tapped") }
	if fv, found := get_any(v, "library_position"); found { if !dec_opt_LibraryPosition(fv, &out.library_position) do return fail("Effect::Conjure.library_position") }
	if fv, found := get_any(v, "library_players"); found { if !dec_opt_PlayerFilter(fv, &out.library_players) do return fail("Effect::Conjure.library_players") }
	return true
		}) { return fail("Effect::Conjure") }
		out^ = tmp
	case "CreateCardCopyByName": when COVERAGE do cov_hit("Effect::CreateCardCopyByName");
		tmp: Effect_CreateCardCopyByName
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^Effect_CreateCardCopyByName) -> bool {
	if fv, found := get_any(v, "name"); found { if !dec_opt_string(fv, &out.name) do return fail("Effect::CreateCardCopyByName.name") }
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("Effect::CreateCardCopyByName.count") } else { out.count = default_Effect_default_quantity_one() }
	return true
		}) { return fail("Effect::CreateCardCopyByName") }
		out^ = tmp
	case "ApplyPerpetual": when COVERAGE do cov_hit("Effect::ApplyPerpetual");
		tmp: Effect_ApplyPerpetual
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^Effect_ApplyPerpetual) -> bool {
	if fv, found := get_any(v, "target"); found { if !decode_TargetFilter(fv, &out.target) do return fail("Effect::ApplyPerpetual.target") } else { out.target = default_Effect_default_target_filter_any() }
	if fv, found := get_any(v, "modification"); found { if !decode_PerpetualModification(fv, &out.modification) do return fail("Effect::ApplyPerpetual.modification") } else { return fail("Effect::ApplyPerpetual.modification missing") }
	return true
		}) { return fail("Effect::ApplyPerpetual") }
		out^ = tmp
	case "Intensify": when COVERAGE do cov_hit("Effect::Intensify");
		tmp: Effect_Intensify
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^Effect_Intensify) -> bool {
	if fv, found := get_any(v, "scope"); found { if !decode_IntensityScope(fv, &out.scope) do return fail("Effect::Intensify.scope") } else { out.scope = IntensityScope(IntensityScope_Source{}) }
	if fv, found := get_any(v, "amount"); found { if !decode_QuantityExpr(fv, &out.amount) do return fail("Effect::Intensify.amount") } else { out.amount = default_Effect_default_quantity_one() }
	return true
		}) { return fail("Effect::Intensify") }
		out^ = tmp
	case "DraftFromSpellbook": when COVERAGE do cov_hit("Effect::DraftFromSpellbook");
		tmp: Effect_DraftFromSpellbook
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^Effect_DraftFromSpellbook) -> bool {
	if fv, found := get_any(v, "destination"); found { if !decode_Zone(fv, &out.destination) do return fail("Effect::DraftFromSpellbook.destination") } else { return fail("Effect::DraftFromSpellbook.destination missing") }
	if fv, found := get_any(v, "tapped"); found { if !decode_bool(fv, &out.tapped) do return fail("Effect::DraftFromSpellbook.tapped") }
	if fv, found := get_any(v, "selection", "random"); found { if !decode_SpellbookSelection(fv, &out.selection) do return fail("Effect::DraftFromSpellbook.selection") } else { out.selection = default_Effect_default_spellbook_selection_legacy_whole_book() }
	return true
		}) { return fail("Effect::DraftFromSpellbook") }
		out^ = tmp
	case "ChooseOneOf": when COVERAGE do cov_hit("Effect::ChooseOneOf");
		tmp: Effect_ChooseOneOf
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^Effect_ChooseOneOf) -> bool {
	if fv, found := get_any(v, "chooser"); found { if !decode_PlayerFilter(fv, &out.chooser) do return fail("Effect::ChooseOneOf.chooser") } else { out.chooser = default_Effect_default_player_filter_controller() }
	if fv, found := get_any(v, "branches"); found { if !dec_dyn_AbilityDefinition(fv, &out.branches) do return fail("Effect::ChooseOneOf.branches") } else { return fail("Effect::ChooseOneOf.branches missing") }
	if fv, found := get_any(v, "kind"); found { if !decode_ChooseOneOfKind(fv, &out.kind) do return fail("Effect::ChooseOneOf.kind") }
	return true
		}) { return fail("Effect::ChooseOneOf") }
		out^ = tmp
	case "Unimplemented": when COVERAGE do cov_hit("Effect::Unimplemented");
		tmp: Effect_Unimplemented
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^Effect_Unimplemented) -> bool {
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("Effect::Unimplemented.name") } else { return fail("Effect::Unimplemented.name missing") }
	if fv, found := get_any(v, "description"); found { if !dec_opt_string(fv, &out.description) do return fail("Effect::Unimplemented.description") }
	return true
		}) { return fail("Effect::Unimplemented") }
		out^ = tmp
	case: return fail("Effect: unknown variant")
	}
	return true
}

encode_Effect :: proc(b: ^strings.Builder, x: Effect) {
	#partial switch y in x {
	case Effect_StartYourEngines: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "StartYourEngines")
	member(b, first, "player_scope"); encode_PlayerFilter(b, y.player_scope)
	}; strings.write_byte(b, '}')
	case Effect_ChangeSpeed: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChangeSpeed")
	member(b, first, "player_scope"); encode_PlayerFilter(b, y.player_scope)
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	member(b, first, "direction"); encode_SpeedDelta(b, y.direction)
	if !(y.floor == nil) { member(b, first, "floor"); enc_opt_u8(b, y.floor) }
	}; strings.write_byte(b, '}')
	case Effect_DealDamage: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DealDamage")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	if !(y.damage_source == nil) { member(b, first, "damage_source"); enc_opt_DamageSource(b, y.damage_source) }
	if !(y.excess == nil) { member(b, first, "excess"); enc_opt_ExcessRecipient(b, y.excess) }
	}; strings.write_byte(b, '}')
	case Effect_ApplyPostReplacementDamage: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ApplyPostReplacementDamage")
	member(b, first, "context"); encode_DamageContextSnapshot(b, y.context_)
	member(b, first, "target"); encode_TargetRef(b, y.target)
	member(b, first, "amount"); encode_u32(b, y.amount)
	member(b, first, "is_combat"); encode_bool(b, y.is_combat)
	}; strings.write_byte(b, '}')
	case Effect_ResumeDamageBatch: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ResumeDamageBatch")
	member(b, first, "kind"); encode_EffectKind(b, y.kind)
	member(b, first, "replaced"); enc_dyn_ReplacedDamagePortion(b, y.replaced)
	member(b, first, "remaining"); enc_dyn_RawDamagePortion(b, y.remaining)
	if !(y.awaiting == nil) { member(b, first, "awaiting"); enc_opt_RawDamagePortion(b, y.awaiting) }
	}; strings.write_byte(b, '}')
	case Effect_EachDealsDamageEqualToPower: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "EachDealsDamageEqualToPower")
	member(b, first, "sources"); encode_TargetFilter(b, y.sources)
	member(b, first, "recipient"); encode_TargetFilter(b, y.recipient)
	if !(y.extra_source == nil) { member(b, first, "extra_source"); enc_opt_TargetFilter(b, y.extra_source) }
	}; strings.write_byte(b, '}')
	case Effect_EachSourceDealsDamage: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "EachSourceDealsDamage")
	member(b, first, "sources"); encode_TargetFilter(b, y.sources)
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	member(b, first, "recipient"); encode_EachDamageRecipient(b, y.recipient)
	}; strings.write_byte(b, '}')
	case Effect_Draw: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Draw")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case Effect_Pump: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Pump")
	member(b, first, "power"); encode_PtValue(b, y.power)
	member(b, first, "toughness"); encode_PtValue(b, y.toughness)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case Effect_PairWith: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PairWith")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case Effect_Destroy: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Destroy")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "cant_regenerate"); encode_bool(b, y.cant_regenerate)
	}; strings.write_byte(b, '}')
	case Effect_Regenerate: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Regenerate")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case Effect_RemoveAllDamage: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RemoveAllDamage")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case Effect_Counter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Counter")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	if !(y.source_rider == nil) { member(b, first, "source_rider"); enc_opt_CounterSourceRider(b, y.source_rider) }
	if !(y.countered_spell_zone == nil) { member(b, first, "countered_spell_zone"); enc_opt_SpellStackToGraveyardReplacement(b, y.countered_spell_zone) }
	}; strings.write_byte(b, '}')
	case Effect_CounterAll: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CounterAll")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case Effect_Token: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Token")
	member(b, first, "name"); encode_string(b, y.name)
	member(b, first, "power"); encode_PtValue(b, y.power)
	member(b, first, "toughness"); encode_PtValue(b, y.toughness)
	member(b, first, "types"); enc_dyn_string(b, y.types)
	member(b, first, "colors"); enc_dyn_ManaColor(b, y.colors)
	member(b, first, "keywords"); enc_dyn_Keyword(b, y.keywords)
	member(b, first, "tapped"); encode_bool(b, y.tapped)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "owner"); encode_TargetFilter(b, y.owner)
	if !(y.attach_to == nil) { member(b, first, "attach_to"); enc_opt_TargetFilter(b, y.attach_to) }
	member(b, first, "enters_attacking"); encode_bool(b, y.enters_attacking)
	if !(skip_Effect_TokenAttackDestination_is_controller_chooses_TokenAttackDestination(y.attack_destination)) { member(b, first, "attack_destination"); encode_TokenAttackDestination(b, y.attack_destination) }
	if !((len(y.supertypes) == 0)) { member(b, first, "supertypes"); enc_dyn_Supertype(b, y.supertypes) }
	if !((len(y.static_abilities) == 0)) { member(b, first, "static_abilities"); enc_dyn_StaticDefinition(b, y.static_abilities) }
	if !((len(y.enter_with_counters) == 0)) { member(b, first, "enter_with_counters"); enc_dyn_t2_CounterType_QuantityExpr(b, y.enter_with_counters) }
	}; strings.write_byte(b, '}')
	case Effect_GainLife: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GainLife")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	if !(skip_Effect_is_target_filter_controller_TargetFilter(y.player)) { member(b, first, "player"); encode_TargetFilter(b, y.player) }
	}; strings.write_byte(b, '}')
	case Effect_LoseLife: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "LoseLife")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	if !(y.target == nil) { member(b, first, "target"); enc_opt_TargetFilter(b, y.target) }
	}; strings.write_byte(b, '}')
	case Effect_SetTapState: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetTapState")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "scope"); encode_EffectScope(b, y.scope)
	member(b, first, "state"); encode_TapStateChange(b, y.state)
	}; strings.write_byte(b, '}')
	case Effect_RemoveCounter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RemoveCounter")
	member(b, first, "counter_type"); enc_opt_CounterType(b, y.counter_type)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	if !(skip_Effect_EffectScope_is_single_EffectScope(y.scope)) { member(b, first, "scope"); encode_EffectScope(b, y.scope) }
	}; strings.write_byte(b, '}')
	case Effect_Sacrifice: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Sacrifice")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	if !(y.min_count == 0) { member(b, first, "min_count"); encode_int(b, y.min_count) }
	}; strings.write_byte(b, '}')
	case Effect_DiscardCard: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DiscardCard")
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case Effect_Mill: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Mill")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "destination"); encode_Zone(b, y.destination)
	if !(skip_Effect_LibraryPosition_is_top_LibraryPosition(y.position)) { member(b, first, "position"); encode_LibraryPosition(b, y.position) }
	}; strings.write_byte(b, '}')
	case Effect_Scry: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Scry")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case Effect_PumpAll: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PumpAll")
	member(b, first, "power"); encode_PtValue(b, y.power)
	member(b, first, "toughness"); encode_PtValue(b, y.toughness)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case Effect_DamageAll: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DamageAll")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	if !(y.player_filter == nil) { member(b, first, "player_filter"); enc_opt_PlayerFilter(b, y.player_filter) }
	if !(y.damage_source == nil) { member(b, first, "damage_source"); enc_opt_DamageSource(b, y.damage_source) }
	}; strings.write_byte(b, '}')
	case Effect_DamageEachPlayer: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DamageEachPlayer")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	member(b, first, "player_filter"); encode_PlayerFilter(b, y.player_filter)
	}; strings.write_byte(b, '}')
	case Effect_DestroyAll: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DestroyAll")
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "cant_regenerate"); encode_bool(b, y.cant_regenerate)
	}; strings.write_byte(b, '}')
	case Effect_ChangeZone: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChangeZone")
	if !(skip_Effect_LibraryInstructionActor_is_controller_LibraryInstructionActor(y.actor)) { member(b, first, "actor"); encode_LibraryInstructionActor(b, y.actor) }
	member(b, first, "origin"); enc_opt_Zone(b, y.origin)
	member(b, first, "destination"); encode_Zone(b, y.destination)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "owner_library"); encode_bool(b, y.owner_library)
	if !(skip_Effect_is_default_library_shuffle_mode_LibraryShuffleMode(y.library_shuffle)) { member(b, first, "library_shuffle"); encode_LibraryShuffleMode(b, y.library_shuffle) }
	member(b, first, "enter_transformed"); encode_bool(b, y.enter_transformed)
