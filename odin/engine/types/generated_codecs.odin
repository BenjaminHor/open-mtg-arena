	case "Resolution": when COVERAGE do cov_hit("TargetChoiceTiming::Resolution"); out^ = .Resolution
	case: return fail("TargetChoiceTiming: unknown variant")
	}
	return true
}

encode_TargetChoiceTiming :: proc(b: ^strings.Builder, x: TargetChoiceTiming) {
	@(static, rodata) NAMES := [TargetChoiceTiming]string{
		.Stack = "Stack",
		.Resolution = "Resolution",
	}
	json.write_string(b, NAMES[x])
}

