	case "Terminal": when COVERAGE do cov_hit("StagedBatchMemberState::Terminal"); out^ = .Terminal
	case "Abandoned": when COVERAGE do cov_hit("StagedBatchMemberState::Abandoned"); out^ = .Abandoned
