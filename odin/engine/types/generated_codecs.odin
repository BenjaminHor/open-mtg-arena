decode_SpellCastRecord :: proc(v: json.Value, out: ^SpellCastRecord) -> bool {
	when COVERAGE do cov_hit("SpellCastRecord")
	if v.kind != .Object do return fail("SpellCastRecord: not an object")
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("SpellCastRecord.name") }
	if fv, found := get_any(v, "core_types"); found { if !dec_dyn_CoreType(fv, &out.core_types) do return fail("SpellCastRecord.core_types") } else { return fail("SpellCastRecord.core_types missing") }
	if fv, found := get_any(v, "supertypes"); found { if !dec_dyn_Supertype(fv, &out.supertypes) do return fail("SpellCastRecord.supertypes") } else { return fail("SpellCastRecord.supertypes missing") }
	if fv, found := get_any(v, "subtypes"); found { if !dec_dyn_string(fv, &out.subtypes) do return fail("SpellCastRecord.subtypes") } else { return fail("SpellCastRecord.subtypes missing") }
	if fv, found := get_any(v, "keywords"); found { if !dec_dyn_Keyword(fv, &out.keywords) do return fail("SpellCastRecord.keywords") } else { return fail("SpellCastRecord.keywords missing") }
	if fv, found := get_any(v, "colors"); found { if !dec_dyn_ManaColor(fv, &out.colors) do return fail("SpellCastRecord.colors") } else { return fail("SpellCastRecord.colors missing") }
	if fv, found := get_any(v, "mana_value"); found { if !decode_u32(fv, &out.mana_value) do return fail("SpellCastRecord.mana_value") } else { return fail("SpellCastRecord.mana_value missing") }
	if fv, found := get_any(v, "has_x_in_cost"); found { if !decode_bool(fv, &out.has_x_in_cost) do return fail("SpellCastRecord.has_x_in_cost") }
	if fv, found := get_any(v, "has_adventure"); found { if !decode_bool(fv, &out.has_adventure) do return fail("SpellCastRecord.has_adventure") }
	if fv, found := get_any(v, "from_zone"); found { if !decode_Zone(fv, &out.from_zone) do return fail("SpellCastRecord.from_zone") } else { out.from_zone = default_SpellCastRecord_default_spell_cast_record_from_zone() }
	if fv, found := get_any(v, "from_outside_game"); found { if !decode_bool(fv, &out.from_outside_game) do return fail("SpellCastRecord.from_outside_game") }
	if fv, found := get_any(v, "cast_variant"); found { if !decode_CastingVariant(fv, &out.cast_variant) do return fail("SpellCastRecord.cast_variant") } else { out.cast_variant = CastingVariant(CastingVariant_Normal{}) }
	if fv, found := get_any(v, "was_kicked"); found { if !decode_bool(fv, &out.was_kicked) do return fail("SpellCastRecord.was_kicked") }
	if fv, found := get_any(v, "spell_object_id"); found { if !dec_opt_ObjectId(fv, &out.spell_object_id) do return fail("SpellCastRecord.spell_object_id") }
	if fv, found := get_any(v, "prepared_copy_source"); found { if !dec_opt_ObjectId(fv, &out.prepared_copy_source) do return fail("SpellCastRecord.prepared_copy_source") }
	return true
}

encode_SpellCastRecord :: proc(b: ^strings.Builder, x: SpellCastRecord) {
	strings.write_byte(b, '{')
	f := true
	encode_SpellCastRecord_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_SpellCastRecord_members :: proc(b: ^strings.Builder, x: SpellCastRecord, first: ^bool) {
	if !((len(x.name) == 0)) { member(b, first, "name"); encode_string(b, x.name) }
	member(b, first, "core_types"); enc_dyn_CoreType(b, x.core_types)
	member(b, first, "supertypes"); enc_dyn_Supertype(b, x.supertypes)
	member(b, first, "subtypes"); enc_dyn_string(b, x.subtypes)
	member(b, first, "keywords"); enc_dyn_Keyword(b, x.keywords)
	member(b, first, "colors"); enc_dyn_ManaColor(b, x.colors)
	member(b, first, "mana_value"); encode_u32(b, x.mana_value)
	if !(!x.has_x_in_cost) { member(b, first, "has_x_in_cost"); encode_bool(b, x.has_x_in_cost) }
	if !(!x.has_adventure) { member(b, first, "has_adventure"); encode_bool(b, x.has_adventure) }
	member(b, first, "from_zone"); encode_Zone(b, x.from_zone)
	if !(!x.from_outside_game) { member(b, first, "from_outside_game"); encode_bool(b, x.from_outside_game) }
	member(b, first, "cast_variant"); encode_CastingVariant(b, x.cast_variant)
	if !(!x.was_kicked) { member(b, first, "was_kicked"); encode_bool(b, x.was_kicked) }
	if !(x.spell_object_id == nil) { member(b, first, "spell_object_id"); enc_opt_ObjectId(b, x.spell_object_id) }
	if !(x.prepared_copy_source == nil) { member(b, first, "prepared_copy_source"); enc_opt_ObjectId(b, x.prepared_copy_source) }
}

