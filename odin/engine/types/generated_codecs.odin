encode_PendingCounterPostAction :: proc(b: ^strings.Builder, x: PendingCounterPostAction) {
	#partial switch y in x {
	case PendingCounterPostAction_EmitEffectResolved: strings.write_byte(b, '{'); json.write_string(b, "EmitEffectResolved"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "kind"); encode_EffectKind(b, y.kind)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingCounterPostAction_RecordPlayerAction: strings.write_byte(b, '{'); json.write_string(b, "RecordPlayerAction"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "action"); encode_PlayerActionKind(b, y.action)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingCounterPostAction_AddSubtype: strings.write_byte(b, '{'); json.write_string(b, "AddSubtype"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "subtype"); encode_string(b, y.subtype)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingCounterPostAction_ContinueAmassAfterTokenCreation: strings.write_byte(b, '{'); json.write_string(b, "ContinueAmassAfterTokenCreation"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	member(b, first, "subtype"); encode_string(b, y.subtype)
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "ability"); enc_ptr_ResolvedAbility(b, y.ability)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingCounterPostAction_FinalizeAmass: strings.write_byte(b, '{'); json.write_string(b, "FinalizeAmass"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "subtype"); encode_string(b, y.subtype)
	member(b, first, "ability"); enc_ptr_ResolvedAbility(b, y.ability)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingCounterPostAction_ContinueEmpowerJaceAfterTokenCreation: strings.write_byte(b, '{'); json.write_string(b, "ContinueEmpowerJaceAfterTokenCreation"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingCounterPostAction_InjectPredefinedTokenAbilities: strings.write_byte(b, '{'); json.write_string(b, "InjectPredefinedTokenAbilities"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingCounterPostAction_FinalizeTokenEntry: strings.write_byte(b, '{'); json.write_string(b, "FinalizeTokenEntry"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "name"); encode_string(b, y.name)
	member(b, first, "attach_to"); enc_opt_AttachTarget(b, y.attach_to)
	member(b, first, "sacrifice_at"); enc_opt_Duration(b, y.sacrifice_at)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingCounterPostAction_ContinueTokenCreation: strings.write_byte(b, '{'); json.write_string(b, "ContinueTokenCreation"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "owner"); encode_PlayerId(b, y.owner)
	member(b, first, "spec"); enc_ptr_TokenSpec(b, y.spec)
	member(b, first, "enter_tapped"); encode_EtbTapState(b, y.enter_tapped)
	member(b, first, "remaining_count"); encode_u32(b, y.remaining_count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingCounterPostAction_ContinueTokenEventDelivery: strings.write_byte(b, '{'); json.write_string(b, "ContinueTokenEventDelivery"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "delivery"); enc_ptr_PendingTokenEventDelivery(b, y.delivery)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingCounterPostAction_FinalizeCopyTokenEntry: strings.write_byte(b, '{'); json.write_string(b, "FinalizeCopyTokenEntry"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "name"); encode_string(b, y.name)
	member(b, first, "enters_attacking"); encode_bool(b, y.enters_attacking)
	if !(skip_PendingCounterPostAction_EntryAttackDestination_is_any_defender_EntryAttackDestination(y.attack_destination)) { member(b, first, "attack_destination"); encode_EntryAttackDestination(b, y.attack_destination) }
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingCounterPostAction_ContinueCopyTokenCreation: strings.write_byte(b, '{'); json.write_string(b, "ContinueCopyTokenCreation"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "owner"); encode_PlayerId(b, y.owner)
	member(b, first, "copy"); enc_ptr_CopyTokenSpec(b, y.copy)
	member(b, first, "enter_tapped"); encode_EtbTapState(b, y.enter_tapped)
	member(b, first, "enter_with_counters"); enc_dyn_t2_CounterType_u32(b, y.enter_with_counters)
	member(b, first, "remaining_count"); encode_u32(b, y.remaining_count)
