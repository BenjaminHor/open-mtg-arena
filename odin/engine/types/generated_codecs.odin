	if fv, found := get_any(v, "attacked"); found { if !decode_AttackTargetFilter(fv, &out.attacked) do return fail("AttackersDeclaredCountSubject::AttackTarget.attacked") } else { return fail("AttackersDeclaredCountSubject::AttackTarget.attacked missing") }
	if fv, found := get_any(v, "filter"); found { if !dec_opt_TargetFilter(fv, &out.filter) do return fail("AttackersDeclaredCountSubject::AttackTarget.filter") }
