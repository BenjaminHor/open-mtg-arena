decode_ControlChangeObservation :: proc(v: json.Value, out: ^ControlChangeObservation) -> bool {
	when COVERAGE do cov_hit("ControlChangeObservation")
	if v.kind != .Object do return fail("ControlChangeObservation: not an object")
	if fv, found := get_any(v, "subject"); found { if !decode_EventObjectSnapshot(fv, &out.subject) do return fail("ControlChangeObservation.subject") } else { return fail("ControlChangeObservation.subject missing") }
	if fv, found := get_any(v, "watchers"); found { if !dec_shared_dyn_TriggerSourceContext(fv, &out.watchers) do return fail("ControlChangeObservation.watchers") } else { return fail("ControlChangeObservation.watchers missing") }
	if fv, found := get_any(v, "doublers"); found { if !dec_shared_dyn_LatchedTriggerDoubler(fv, &out.doublers) do return fail("ControlChangeObservation.doublers") }
	if fv, found := get_any(v, "gain_watchers"); found { if !dec_shared_dyn_TriggerSourceContext(fv, &out.gain_watchers) do return fail("ControlChangeObservation.gain_watchers") }
	if fv, found := get_any(v, "gain_doublers"); found { if !dec_shared_dyn_LatchedTriggerDoubler(fv, &out.gain_doublers) do return fail("ControlChangeObservation.gain_doublers") }
	return true
}

encode_ControlChangeObservation :: proc(b: ^strings.Builder, x: ControlChangeObservation) {
	strings.write_byte(b, '{')
	f := true
	encode_ControlChangeObservation_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ControlChangeObservation_members :: proc(b: ^strings.Builder, x: ControlChangeObservation, first: ^bool) {
	member(b, first, "subject"); encode_EventObjectSnapshot(b, x.subject)
	member(b, first, "watchers"); enc_shared_dyn_TriggerSourceContext(b, x.watchers)
	if !(skip_ControlChangeObservation_latched_doublers_are_empty_ptr_dyn_LatchedTriggerDoubler(x.doublers)) { member(b, first, "doublers"); enc_shared_dyn_LatchedTriggerDoubler(b, x.doublers) }
	if !(x.gain_watchers == nil) { member(b, first, "gain_watchers"); enc_shared_dyn_TriggerSourceContext(b, x.gain_watchers) }
	if !(skip_ControlChangeObservation_latched_doublers_are_empty_ptr_dyn_LatchedTriggerDoubler(x.gain_doublers)) { member(b, first, "gain_doublers"); enc_shared_dyn_LatchedTriggerDoubler(b, x.gain_doublers) }
}

decode_LazyBoxedMap_u64_ControlChangeObservation :: proc(v: json.Value, out: ^LazyBoxedMap_u64_ControlChangeObservation) -> bool {
	when COVERAGE do cov_hit("LazyBoxedMap_u64_ControlChangeObservation")
	return dec_ptr_map_u64_ControlChangeObservation(v, cast(^^map[u64]ControlChangeObservation)out)
}

