encode_Keyword :: proc(b: ^strings.Builder, x: Keyword) {
	#partial switch y in x {
	case Keyword_Flying: _ = y; json.write_string(b, "Flying")
	case Keyword_FirstStrike: _ = y; json.write_string(b, "FirstStrike")
	case Keyword_DoubleStrike: _ = y; json.write_string(b, "DoubleStrike")
	case Keyword_Trample: _ = y; json.write_string(b, "Trample")
	case Keyword_TrampleOverPlaneswalkers: _ = y; json.write_string(b, "TrampleOverPlaneswalkers")
	case Keyword_Deathtouch: _ = y; json.write_string(b, "Deathtouch")
	case Keyword_Lifelink: _ = y; json.write_string(b, "Lifelink")
	case Keyword_Vigilance: _ = y; json.write_string(b, "Vigilance")
	case Keyword_Haste: _ = y; json.write_string(b, "Haste")
	case Keyword_Reach: _ = y; json.write_string(b, "Reach")
	case Keyword_Defender: _ = y; json.write_string(b, "Defender")
	case Keyword_Menace: _ = y; json.write_string(b, "Menace")
	case Keyword_Indestructible: _ = y; json.write_string(b, "Indestructible")
	case Keyword_Hexproof: _ = y; json.write_string(b, "Hexproof")
	case Keyword_HexproofFrom: strings.write_byte(b, '{'); json.write_string(b, "HexproofFrom"); strings.write_byte(b, ':'); encode_HexproofFilter(b, y._0); strings.write_byte(b, '}')
	case Keyword_Shroud: _ = y; json.write_string(b, "Shroud")
	case Keyword_Flash: _ = y; json.write_string(b, "Flash")
	case Keyword_Fear: _ = y; json.write_string(b, "Fear")
	case Keyword_Intimidate: _ = y; json.write_string(b, "Intimidate")
	case Keyword_Skulk: _ = y; json.write_string(b, "Skulk")
	case Keyword_Shadow: _ = y; json.write_string(b, "Shadow")
	case Keyword_Horsemanship: _ = y; json.write_string(b, "Horsemanship")
	case Keyword_Wither: _ = y; json.write_string(b, "Wither")
	case Keyword_Infect: _ = y; json.write_string(b, "Infect")
	case Keyword_Afflict: strings.write_byte(b, '{'); json.write_string(b, "Afflict"); strings.write_byte(b, ':'); encode_u32(b, y._0); strings.write_byte(b, '}')
	case Keyword_StartingIntensity: strings.write_byte(b, '{'); json.write_string(b, "StartingIntensity"); strings.write_byte(b, ':'); encode_u32(b, y._0); strings.write_byte(b, '}')
	case Keyword_Prowess: _ = y; json.write_string(b, "Prowess")
	case Keyword_Undying: _ = y; json.write_string(b, "Undying")
	case Keyword_Persist: _ = y; json.write_string(b, "Persist")
	case Keyword_Cascade: _ = y; json.write_string(b, "Cascade")
	case Keyword_Exalted: _ = y; json.write_string(b, "Exalted")
	case Keyword_Flanking: _ = y; json.write_string(b, "Flanking")
	case Keyword_Evolve: _ = y; json.write_string(b, "Evolve")
	case Keyword_Extort: _ = y; json.write_string(b, "Extort")
	case Keyword_Exploit: _ = y; json.write_string(b, "Exploit")
	case Keyword_Explore: _ = y; json.write_string(b, "Explore")
	case Keyword_Ascend: _ = y; json.write_string(b, "Ascend")
	case Keyword_Storied: _ = y; json.write_string(b, "Storied")
	case Keyword_StartYourEngines: _ = y; json.write_string(b, "StartYourEngines")
	case Keyword_Dredge: strings.write_byte(b, '{'); json.write_string(b, "Dredge"); strings.write_byte(b, ':'); encode_u32(b, y._0); strings.write_byte(b, '}')
	case Keyword_Modular: strings.write_byte(b, '{'); json.write_string(b, "Modular"); strings.write_byte(b, ':'); encode_u32(b, y._0); strings.write_byte(b, '}')
	case Keyword_Renown: strings.write_byte(b, '{'); json.write_string(b, "Renown"); strings.write_byte(b, ':'); encode_u32(b, y._0); strings.write_byte(b, '}')
	case Keyword_Fabricate: strings.write_byte(b, '{'); json.write_string(b, "Fabricate"); strings.write_byte(b, ':'); encode_u32(b, y._0); strings.write_byte(b, '}')
	case Keyword_Annihilator: strings.write_byte(b, '{'); json.write_string(b, "Annihilator"); strings.write_byte(b, ':'); encode_u32(b, y._0); strings.write_byte(b, '}')
	case Keyword_Bushido: strings.write_byte(b, '{'); json.write_string(b, "Bushido"); strings.write_byte(b, ':'); encode_u32(b, y._0); strings.write_byte(b, '}')
