		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_AddDynamicKeyword) -> bool {
	if fv, found := get_any(v, "kind"); found { if !decode_DynamicKeywordKind(fv, &out.kind) do return fail("ContinuousModification::AddDynamicKeyword.kind") } else { return fail("ContinuousModification::AddDynamicKeyword.kind missing") }
	if fv, found := get_any(v, "value"); found { if !decode_QuantityExpr(fv, &out.value) do return fail("ContinuousModification::AddDynamicKeyword.value") } else { return fail("ContinuousModification::AddDynamicKeyword.value missing") }
	return true
