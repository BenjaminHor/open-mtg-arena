	member(b, first, "player"); encode_PlayerScope(b, y.player)
	}; strings.write_byte(b, '}')
	case QuantityRef_SpellsCastThisGame: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SpellsCastThisGame")
	member(b, first, "scope"); encode_CountScope(b, y.scope)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }
	}; strings.write_byte(b, '}')
	case QuantityRef_CardsCycled: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CardsCycled")
	member(b, first, "scope"); encode_CountScope(b, y.scope)
	member(b, first, "window"); encode_CyclingHistoryWindow(b, y.window)
	if !(y.name == nil) { member(b, first, "name"); enc_opt_string(b, y.name) }
	}; strings.write_byte(b, '}')
	case QuantityRef_CounterAddedThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CounterAddedThisTurn")
	member(b, first, "actor"); encode_CountScope(b, y.actor)
	member(b, first, "counters"); encode_CounterMatch(b, y.counters)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
