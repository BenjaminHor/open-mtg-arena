decode_EffectRef :: proc(v: json.Value, out: ^EffectRef) -> bool {
	when COVERAGE do cov_hit("EffectRef")
	if v.kind != .Object do return fail("EffectRef: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("EffectRef: no tag")
	switch tv.text {
	case "Transient": when COVERAGE do cov_hit("EffectRef::Transient");
		tmp: EffectRef_Transient
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^EffectRef_Transient) -> bool {
	if fv, found := get_any(v, "id"); found { if !decode_u64(fv, &out.id) do return fail("EffectRef::Transient.id") } else { return fail("EffectRef::Transient.id missing") }
	if fv, found := get_any(v, "mod_index"); found { if !decode_int(fv, &out.mod_index) do return fail("EffectRef::Transient.mod_index") } else { return fail("EffectRef::Transient.mod_index missing") }
	return true
		}) { return fail("EffectRef::Transient") }
		out^ = tmp
	case "Static": when COVERAGE do cov_hit("EffectRef::Static");
		tmp: EffectRef_Static
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^EffectRef_Static) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("EffectRef::Static.source") } else { return fail("EffectRef::Static.source missing") }
	if fv, found := get_any(v, "def_index"); found { if !decode_int(fv, &out.def_index) do return fail("EffectRef::Static.def_index") } else { return fail("EffectRef::Static.def_index missing") }
	if fv, found := get_any(v, "mod_index"); found { if !decode_int(fv, &out.mod_index) do return fail("EffectRef::Static.mod_index") } else { return fail("EffectRef::Static.mod_index missing") }
	return true
		}) { return fail("EffectRef::Static") }
		out^ = tmp
	case: return fail("EffectRef: unknown variant")
	}
	return true
}

encode_EffectRef :: proc(b: ^strings.Builder, x: EffectRef) {
	#partial switch y in x {
	case EffectRef_Transient: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Transient"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "id"); encode_u64(b, y.id)
	member(b, first, "mod_index"); encode_int(b, y.mod_index)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case EffectRef_Static: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Static"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "def_index"); encode_int(b, y.def_index)
	member(b, first, "mod_index"); encode_int(b, y.mod_index)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

