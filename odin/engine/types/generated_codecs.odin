decode_AutoPassMode :: proc(v: json.Value, out: ^AutoPassMode) -> bool {
	when COVERAGE do cov_hit("AutoPassMode")
	if v.kind != .Object do return fail("AutoPassMode: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("AutoPassMode: no tag")
	switch tv.text {
	case "UntilStackEmpty": when COVERAGE do cov_hit("AutoPassMode::UntilStackEmpty");
		tmp: AutoPassMode_UntilStackEmpty
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AutoPassMode_UntilStackEmpty) -> bool {
	if fv, found := get_any(v, "initial_stack_len"); found { if !decode_int(fv, &out.initial_stack_len) do return fail("AutoPassMode::UntilStackEmpty.initial_stack_len") } else { return fail("AutoPassMode::UntilStackEmpty.initial_stack_len missing") }
	if fv, found := get_any(v, "policy"); found { if !decode_StackResolutionPolicy(fv, &out.policy) do return fail("AutoPassMode::UntilStackEmpty.policy") }
	return true
		}) { return fail("AutoPassMode::UntilStackEmpty") }
		out^ = tmp
	case "UntilTurnBoundary", "UntilEndOfTurn": when COVERAGE do cov_hit("AutoPassMode::UntilTurnBoundary");
		tmp: AutoPassMode_UntilTurnBoundary
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AutoPassMode_UntilTurnBoundary) -> bool {
	if fv, found := get_any(v, "until"); found { if !decode_TurnBoundary(fv, &out.until) do return fail("AutoPassMode::UntilTurnBoundary.until") }
	return true
		}) { return fail("AutoPassMode::UntilTurnBoundary") }
		out^ = tmp
	case: return fail("AutoPassMode: unknown variant")
	}
	return true
}

encode_AutoPassMode :: proc(b: ^strings.Builder, x: AutoPassMode) {
	#partial switch y in x {
	case AutoPassMode_UntilStackEmpty: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UntilStackEmpty")
	member(b, first, "initial_stack_len"); encode_int(b, y.initial_stack_len)
	if !(skip_AutoPassMode_StackResolutionPolicy_is_committed_StackResolutionPolicy(y.policy)) { member(b, first, "policy"); encode_StackResolutionPolicy(b, y.policy) }
	}; strings.write_byte(b, '}')
	case AutoPassMode_UntilTurnBoundary: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UntilTurnBoundary")
	member(b, first, "until"); encode_TurnBoundary(b, y.until)
	}; strings.write_byte(b, '}')
	}
}

encode_AutoPassMode_members :: proc(b: ^strings.Builder, x: AutoPassMode, first: ^bool) {
	#partial switch y in x {
	case AutoPassMode_UntilStackEmpty: member(b, first, "type"); json.write_string(b, "UntilStackEmpty")
	member(b, first, "initial_stack_len"); encode_int(b, y.initial_stack_len)
	if !(skip_AutoPassMode_StackResolutionPolicy_is_committed_StackResolutionPolicy(y.policy)) { member(b, first, "policy"); encode_StackResolutionPolicy(b, y.policy) }

	case AutoPassMode_UntilTurnBoundary: member(b, first, "type"); json.write_string(b, "UntilTurnBoundary")
	member(b, first, "until"); encode_TurnBoundary(b, y.until)

	}
}

