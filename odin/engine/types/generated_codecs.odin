	if fv, found := get_any(v, "characteristics"); found { if !decode_TokenCharacteristics(fv, &out.characteristics) do return fail("DebugTokenRequest::Custom.characteristics") } else { return fail("DebugTokenRequest::Custom.characteristics missing") }
