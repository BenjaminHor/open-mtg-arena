	member(b, first, "toughness"); enc_opt_i32(b, x.toughness)
	member(b, first, "colors"); enc_dyn_ManaColor(b, x.colors)
	member(b, first, "subtypes"); enc_dyn_string(b, x.subtypes)
	if !(len(x.keywords) == 0) { member(b, first, "keywords"); enc_dyn_string(b, x.keywords) }
	member(b, first, "has_abilities"); encode_bool(b, x.has_abilities)
}

decode_TextSubstitution :: proc(v: json.Value, out: ^TextSubstitution) -> bool {
	if v.kind != .Object do return fail("TextSubstitution: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("TextSubstitution: no tag")
	switch tv.text {
	case "Color":
		tmp: TextSubstitution_Color
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TextSubstitution_Color) -> bool {
	if fv, found := get_any(v, "from"); found { if !decode_ManaColor(fv, &out.from) do return fail("TextSubstitution::Color.from") } else { return fail("TextSubstitution::Color.from missing") }
	if fv, found := get_any(v, "to"); found { if !decode_ManaColor(fv, &out.to) do return fail("TextSubstitution::Color.to") } else { return fail("TextSubstitution::Color.to missing") }
	return true
		}) { return fail("TextSubstitution::Color") }
		out^ = tmp
	case "BasicLandType":
		tmp: TextSubstitution_BasicLandType
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TextSubstitution_BasicLandType) -> bool {
	if fv, found := get_any(v, "from"); found { if !decode_BasicLandType(fv, &out.from) do return fail("TextSubstitution::BasicLandType.from") } else { return fail("TextSubstitution::BasicLandType.from missing") }
	if fv, found := get_any(v, "to"); found { if !decode_BasicLandType(fv, &out.to) do return fail("TextSubstitution::BasicLandType.to") } else { return fail("TextSubstitution::BasicLandType.to missing") }
	return true
		}) { return fail("TextSubstitution::BasicLandType") }
		out^ = tmp
	case: return fail("TextSubstitution: unknown variant")
	}
	return true
}

encode_TextSubstitution :: proc(b: ^strings.Builder, x: TextSubstitution) {
	#partial switch y in x {
	case TextSubstitution_Color: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Color")
	member(b, first, "from"); encode_ManaColor(b, y.from)
	member(b, first, "to"); encode_ManaColor(b, y.to)
	}; strings.write_byte(b, '}')
	case TextSubstitution_BasicLandType: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "BasicLandType")
	member(b, first, "from"); encode_BasicLandType(b, y.from)
	member(b, first, "to"); encode_BasicLandType(b, y.to)
	}; strings.write_byte(b, '}')
	}
}

encode_TextSubstitution_members :: proc(b: ^strings.Builder, x: TextSubstitution, first: ^bool) {
	#partial switch y in x {
	case TextSubstitution_Color: member(b, first, "type"); json.write_string(b, "Color")
	member(b, first, "from"); encode_ManaColor(b, y.from)
	member(b, first, "to"); encode_ManaColor(b, y.to)

	case TextSubstitution_BasicLandType: member(b, first, "type"); json.write_string(b, "BasicLandType")
	member(b, first, "from"); encode_BasicLandType(b, y.from)
	member(b, first, "to"); encode_BasicLandType(b, y.to)

	}
}

