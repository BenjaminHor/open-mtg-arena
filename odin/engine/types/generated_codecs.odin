decode_ConjureSource :: proc(v: json.Value, out: ^ConjureSource) -> bool {
	// untagged: the first variant that decodes wins, as in serde.
	if v.kind == .Object { tmp: ConjureSource_Named; if decode_quiet_proc(v, &tmp, proc(v: json.Value, out: ^ConjureSource_Named) -> bool {
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("ConjureSource::Named.name") } else { return fail("ConjureSource::Named.name missing") }
	return true
	}) { out^ = tmp; return true } }
	if v.kind == .Object { tmp: ConjureSource_Duplicate; if decode_quiet_proc(v, &tmp, proc(v: json.Value, out: ^ConjureSource_Duplicate) -> bool {
	if fv, found := get_any(v, "duplicate_of"); found { if !decode_TargetFilter(fv, &out.duplicate_of) do return fail("ConjureSource::Duplicate.duplicate_of") } else { return fail("ConjureSource::Duplicate.duplicate_of missing") }
	return true
	}) { out^ = tmp; return true } }
	return fail("ConjureSource: no untagged variant matched")
}

encode_ConjureSource :: proc(b: ^strings.Builder, x: ConjureSource) {
	#partial switch y in x {
	case ConjureSource_Named: strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "name"); encode_string(b, y.name)
	}; strings.write_byte(b, '}')
	case ConjureSource_Duplicate: strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "duplicate_of"); encode_TargetFilter(b, y.duplicate_of)
	}; strings.write_byte(b, '}')
	}
}

encode_ConjureSource_members :: proc(b: ^strings.Builder, x: ConjureSource, first: ^bool) {
	#partial switch y in x {
	case ConjureSource_Named:
	member(b, first, "name"); encode_string(b, y.name)

	case ConjureSource_Duplicate:
	member(b, first, "duplicate_of"); encode_TargetFilter(b, y.duplicate_of)

	}
}

decode_PerpetualGrantModification :: proc(v: json.Value, out: ^PerpetualGrantModification) -> bool {
	if v.kind != .Object do return fail("PerpetualGrantModification: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("PerpetualGrantModification: no tag")
	switch tv.text {
	case "AddKeyword":
		tmp: PerpetualGrantModification_AddKeyword
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PerpetualGrantModification_AddKeyword) -> bool {
	if fv, found := get_any(v, "keyword"); found { if !decode_Keyword(fv, &out.keyword) do return fail("PerpetualGrantModification::AddKeyword.keyword") } else { return fail("PerpetualGrantModification::AddKeyword.keyword missing") }
	return true
		}) { return fail("PerpetualGrantModification::AddKeyword") }
		out^ = tmp
	case "AddStaticMode":
		tmp: PerpetualGrantModification_AddStaticMode
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PerpetualGrantModification_AddStaticMode) -> bool {
	if fv, found := get_any(v, "mode"); found { if !decode_StaticMode(fv, &out.mode) do return fail("PerpetualGrantModification::AddStaticMode.mode") } else { return fail("PerpetualGrantModification::AddStaticMode.mode missing") }
	return true
		}) { return fail("PerpetualGrantModification::AddStaticMode") }
		out^ = tmp
	case "GrantAbility":
		tmp: PerpetualGrantModification_GrantAbility
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PerpetualGrantModification_GrantAbility) -> bool {
	if fv, found := get_any(v, "definition"); found { if !dec_ptr_AbilityDefinition(fv, &out.definition) do return fail("PerpetualGrantModification::GrantAbility.definition") } else { return fail("PerpetualGrantModification::GrantAbility.definition missing") }
	return true
		}) { return fail("PerpetualGrantModification::GrantAbility") }
		out^ = tmp
	case "GrantTrigger":
		tmp: PerpetualGrantModification_GrantTrigger
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PerpetualGrantModification_GrantTrigger) -> bool {
	if fv, found := get_any(v, "trigger"); found { if !dec_ptr_TriggerDefinition(fv, &out.trigger) do return fail("PerpetualGrantModification::GrantTrigger.trigger") } else { return fail("PerpetualGrantModification::GrantTrigger.trigger missing") }
	return true
		}) { return fail("PerpetualGrantModification::GrantTrigger") }
		out^ = tmp
	case: return fail("PerpetualGrantModification: unknown variant")
	}
	return true
}

encode_PerpetualGrantModification :: proc(b: ^strings.Builder, x: PerpetualGrantModification) {
	#partial switch y in x {
	case PerpetualGrantModification_AddKeyword: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)
	}; strings.write_byte(b, '}')
	case PerpetualGrantModification_AddStaticMode: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddStaticMode")
	member(b, first, "mode"); encode_StaticMode(b, y.mode)
	}; strings.write_byte(b, '}')
	case PerpetualGrantModification_GrantAbility: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GrantAbility")
	member(b, first, "definition"); enc_ptr_AbilityDefinition(b, y.definition)
	}; strings.write_byte(b, '}')
	case PerpetualGrantModification_GrantTrigger: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GrantTrigger")
	member(b, first, "trigger"); enc_ptr_TriggerDefinition(b, y.trigger)
	}; strings.write_byte(b, '}')
	}
}

encode_PerpetualGrantModification_members :: proc(b: ^strings.Builder, x: PerpetualGrantModification, first: ^bool) {
	#partial switch y in x {
	case PerpetualGrantModification_AddKeyword: member(b, first, "type"); json.write_string(b, "AddKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)

	case PerpetualGrantModification_AddStaticMode: member(b, first, "type"); json.write_string(b, "AddStaticMode")
	member(b, first, "mode"); encode_StaticMode(b, y.mode)

	case PerpetualGrantModification_GrantAbility: member(b, first, "type"); json.write_string(b, "GrantAbility")
	member(b, first, "definition"); enc_ptr_AbilityDefinition(b, y.definition)

	case PerpetualGrantModification_GrantTrigger: member(b, first, "type"); json.write_string(b, "GrantTrigger")
	member(b, first, "trigger"); enc_ptr_TriggerDefinition(b, y.trigger)

	}
}

