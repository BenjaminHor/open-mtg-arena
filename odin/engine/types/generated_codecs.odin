	first := true
	for k, val in x {
		if !first do strings.write_byte(b, ',')
		first = false
		encode_ManaColor(b, k)
		strings.write_byte(b, ':')
		encode_BackFaceData(b, val)
	}
	strings.write_byte(b, '}')
}

