		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^WaitingFor_EntryAttackTargetChoice) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("WaitingFor::EntryAttackTargetChoice.player") } else { return fail("WaitingFor::EntryAttackTargetChoice.player missing") }
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("WaitingFor::EntryAttackTargetChoice.object_id") } else { return fail("WaitingFor::EntryAttackTargetChoice.object_id missing") }
