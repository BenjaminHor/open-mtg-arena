		tmp: ManaProduction_AnyOneColor
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ManaProduction_AnyOneColor) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("ManaProduction::AnyOneColor.count") } else { out.count = default_ManaProduction_default_quantity_one() }
	if fv, found := get_any(v, "color_options"); found { if !dec_dyn_ManaColor(fv, &out.color_options) do return fail("ManaProduction::AnyOneColor.color_options") } else { out.color_options = default_ManaProduction_default_all_mana_colors() }
