	member(b, first, "current_card"); encode_ObjectId(b, y.current_card)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case BatchCompletion_TopCardContestRoundComplete: strings.write_byte(b, '{'); json.write_string(b, "TopCardContestRoundComplete"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
