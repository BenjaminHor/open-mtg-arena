encode_ProhibitedActivity :: proc(b: ^strings.Builder, x: ProhibitedActivity) {
	#partial switch y in x {
	case ProhibitedActivity_CastOnlyFromZones: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastOnlyFromZones")
	member(b, first, "allowed_zones"); enc_dyn_Zone(b, y.allowed_zones)
	}; strings.write_byte(b, '}')
	case ProhibitedActivity_CastSpells: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastSpells")
	if !(y.spell_filter == nil) { member(b, first, "spell_filter"); enc_opt_TargetFilter(b, y.spell_filter) }
	}; strings.write_byte(b, '}')
	case ProhibitedActivity_ActivateAbilities: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ActivateAbilities")
	member(b, first, "exemption"); encode_ActivationExemption(b, y.exemption)
	if !(y.only_tag == nil) { member(b, first, "only_tag"); enc_opt_AbilityTag(b, y.only_tag) }
	}; strings.write_byte(b, '}')
	case ProhibitedActivity_Attack: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Attack")
	member(b, first, "defended"); encode_AttackTargetFilter(b, y.defended)
	if !(y.protected_player == nil) { member(b, first, "protected_player"); enc_opt_PlayerId(b, y.protected_player) }
	if !(y.protected_scope == nil) { member(b, first, "protected_scope"); enc_opt_RestrictionPlayerScope(b, y.protected_scope) }
	}; strings.write_byte(b, '}')
	case ProhibitedActivity_ProhibitPlayFromZone: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ProhibitPlayFromZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	}; strings.write_byte(b, '}')
	case ProhibitedActivity_PlayLands: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PlayLands")
	if !(y.land_filter == nil) { member(b, first, "land_filter"); enc_opt_TargetFilter(b, y.land_filter) }
	}; strings.write_byte(b, '}')
	}
}

encode_ProhibitedActivity_members :: proc(b: ^strings.Builder, x: ProhibitedActivity, first: ^bool) {
	#partial switch y in x {
	case ProhibitedActivity_CastOnlyFromZones: member(b, first, "type"); json.write_string(b, "CastOnlyFromZones")
	member(b, first, "allowed_zones"); enc_dyn_Zone(b, y.allowed_zones)

	case ProhibitedActivity_CastSpells: member(b, first, "type"); json.write_string(b, "CastSpells")
	if !(y.spell_filter == nil) { member(b, first, "spell_filter"); enc_opt_TargetFilter(b, y.spell_filter) }

	case ProhibitedActivity_ActivateAbilities: member(b, first, "type"); json.write_string(b, "ActivateAbilities")
	member(b, first, "exemption"); encode_ActivationExemption(b, y.exemption)
	if !(y.only_tag == nil) { member(b, first, "only_tag"); enc_opt_AbilityTag(b, y.only_tag) }

	case ProhibitedActivity_Attack: member(b, first, "type"); json.write_string(b, "Attack")
	member(b, first, "defended"); encode_AttackTargetFilter(b, y.defended)
	if !(y.protected_player == nil) { member(b, first, "protected_player"); enc_opt_PlayerId(b, y.protected_player) }
	if !(y.protected_scope == nil) { member(b, first, "protected_scope"); enc_opt_RestrictionPlayerScope(b, y.protected_scope) }

	case ProhibitedActivity_ProhibitPlayFromZone: member(b, first, "type"); json.write_string(b, "ProhibitPlayFromZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)

	case ProhibitedActivity_PlayLands: member(b, first, "type"); json.write_string(b, "PlayLands")
	if !(y.land_filter == nil) { member(b, first, "land_filter"); enc_opt_TargetFilter(b, y.land_filter) }

	}
}

decode_ActivationExemption :: proc(v: json.Value, out: ^ActivationExemption) -> bool {
	when COVERAGE do cov_hit("ActivationExemption")
	if v.kind != .String do return fail("ActivationExemption: not a string")
	str := v.text
	switch str {
	case "None": when COVERAGE do cov_hit("ActivationExemption::None"); out^ = .None
	case "ManaAbilities": when COVERAGE do cov_hit("ActivationExemption::ManaAbilities"); out^ = .ManaAbilities
	case: return fail("ActivationExemption: unknown variant")
	}
	return true
}

encode_ActivationExemption :: proc(b: ^strings.Builder, x: ActivationExemption) {
	@(static, rodata) NAMES := [ActivationExemption]string{
		.None = "None",
		.ManaAbilities = "ManaAbilities",
	}
	json.write_string(b, NAMES[x])
}

decode_AttackTargetFilter :: proc(v: json.Value, out: ^AttackTargetFilter) -> bool {
	when COVERAGE do cov_hit("AttackTargetFilter")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("AttackTargetFilter: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("AttackTargetFilter: not a string or object")
	}
	switch variant {
	case "Player": when COVERAGE do cov_hit("AttackTargetFilter::Player"); out^ = AttackTargetFilter_Player{}
	case "Planeswalker": when COVERAGE do cov_hit("AttackTargetFilter::Planeswalker");
		tmp: AttackTargetFilter_Planeswalker
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^AttackTargetFilter_Planeswalker) -> bool {
	if fv, found := get_any(v, "subtype"); found { if !dec_opt_string(fv, &out.subtype) do return fail("AttackTargetFilter::Planeswalker.subtype") }
	return true
		}) { return fail("AttackTargetFilter::Planeswalker") }
		out^ = tmp
	case "PlayerOrPlaneswalker": when COVERAGE do cov_hit("AttackTargetFilter::PlayerOrPlaneswalker"); out^ = AttackTargetFilter_PlayerOrPlaneswalker{}
	case "Battle": when COVERAGE do cov_hit("AttackTargetFilter::Battle"); out^ = AttackTargetFilter_Battle{}
	case "Owner": when COVERAGE do cov_hit("AttackTargetFilter::Owner"); out^ = AttackTargetFilter_Owner{}
	case "OwnerOrPlaneswalker": when COVERAGE do cov_hit("AttackTargetFilter::OwnerOrPlaneswalker"); out^ = AttackTargetFilter_OwnerOrPlaneswalker{}
	case "PlayerOrPermanents": when COVERAGE do cov_hit("AttackTargetFilter::PlayerOrPermanents"); out^ = AttackTargetFilter_PlayerOrPermanents{}
	case "Monarch": when COVERAGE do cov_hit("AttackTargetFilter::Monarch"); out^ = AttackTargetFilter_Monarch{}
	case "PlayerAttackedBySourceThisTurn": when COVERAGE do cov_hit("AttackTargetFilter::PlayerAttackedBySourceThisTurn"); out^ = AttackTargetFilter_PlayerAttackedBySourceThisTurn{}
	case: return fail("AttackTargetFilter: unknown variant")
	}
	return true
}

encode_AttackTargetFilter :: proc(b: ^strings.Builder, x: AttackTargetFilter) {
	#partial switch y in x {
	case AttackTargetFilter_Player: _ = y; json.write_string(b, "Player")
	case AttackTargetFilter_Planeswalker: strings.write_byte(b, '{'); json.write_string(b, "Planeswalker"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "subtype"); enc_opt_string(b, y.subtype)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case AttackTargetFilter_PlayerOrPlaneswalker: _ = y; json.write_string(b, "PlayerOrPlaneswalker")
	case AttackTargetFilter_Battle: _ = y; json.write_string(b, "Battle")
	case AttackTargetFilter_Owner: _ = y; json.write_string(b, "Owner")
	case AttackTargetFilter_OwnerOrPlaneswalker: _ = y; json.write_string(b, "OwnerOrPlaneswalker")
	case AttackTargetFilter_PlayerOrPermanents: _ = y; json.write_string(b, "PlayerOrPermanents")
	case AttackTargetFilter_Monarch: _ = y; json.write_string(b, "Monarch")
	case AttackTargetFilter_PlayerAttackedBySourceThisTurn: _ = y; json.write_string(b, "PlayerAttackedBySourceThisTurn")
	}
}

decode_ReplacementContinuationId :: proc(v: json.Value, out: ^ReplacementContinuationId) -> bool {
	when COVERAGE do cov_hit("ReplacementContinuationId")
	return decode_u64(v, cast(^u64)out)
}

encode_ReplacementContinuationId :: proc(b: ^strings.Builder, x: ReplacementContinuationId) {
	encode_u64(b, cast(u64)x)
}

decode_ReplacementMode :: proc(v: json.Value, out: ^ReplacementMode) -> bool {
	when COVERAGE do cov_hit("ReplacementMode")
	if v.kind != .Object do return fail("ReplacementMode: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ReplacementMode: no tag")
	switch tv.text {
	case "Mandatory": when COVERAGE do cov_hit("ReplacementMode::Mandatory"); out^ = ReplacementMode_Mandatory{}
	case "Optional": when COVERAGE do cov_hit("ReplacementMode::Optional");
		tmp: ReplacementMode_Optional
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementMode_Optional) -> bool {
	if fv, found := get_any(v, "decline"); found { if !dec_ptr_AbilityDefinition(fv, &out.decline) do return fail("ReplacementMode::Optional.decline") }
	return true
		}) { return fail("ReplacementMode::Optional") }
		out^ = tmp
	case "MayCost": when COVERAGE do cov_hit("ReplacementMode::MayCost");
		tmp: ReplacementMode_MayCost
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ReplacementMode_MayCost) -> bool {
	if fv, found := get_any(v, "cost"); found { if !decode_AbilityCost(fv, &out.cost) do return fail("ReplacementMode::MayCost.cost") } else { return fail("ReplacementMode::MayCost.cost missing") }
	if fv, found := get_any(v, "decline"); found { if !dec_ptr_AbilityDefinition(fv, &out.decline) do return fail("ReplacementMode::MayCost.decline") }
	return true
		}) { return fail("ReplacementMode::MayCost") }
		out^ = tmp
	case: return fail("ReplacementMode: unknown variant")
	}
	return true
}

encode_ReplacementMode :: proc(b: ^strings.Builder, x: ReplacementMode) {
	#partial switch y in x {
	case ReplacementMode_Mandatory: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Mandatory"); strings.write_byte(b, '}')
	case ReplacementMode_Optional: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Optional")
	member(b, first, "decline"); enc_ptr_AbilityDefinition(b, y.decline)
	}; strings.write_byte(b, '}')
	case ReplacementMode_MayCost: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "MayCost")
	member(b, first, "cost"); encode_AbilityCost(b, y.cost)
	member(b, first, "decline"); enc_ptr_AbilityDefinition(b, y.decline)
	}; strings.write_byte(b, '}')
	}
}

encode_ReplacementMode_members :: proc(b: ^strings.Builder, x: ReplacementMode, first: ^bool) {
	#partial switch y in x {
	case ReplacementMode_Mandatory: _ = y; member(b, first, "type"); json.write_string(b, "Mandatory")
	case ReplacementMode_Optional: member(b, first, "type"); json.write_string(b, "Optional")
	member(b, first, "decline"); enc_ptr_AbilityDefinition(b, y.decline)

	case ReplacementMode_MayCost: member(b, first, "type"); json.write_string(b, "MayCost")
	member(b, first, "cost"); encode_AbilityCost(b, y.cost)
	member(b, first, "decline"); enc_ptr_AbilityDefinition(b, y.decline)

	}
}

decode_ReplacementChoiceAuthority :: proc(v: json.Value, out: ^ReplacementChoiceAuthority) -> bool {
	when COVERAGE do cov_hit("ReplacementChoiceAuthority")
