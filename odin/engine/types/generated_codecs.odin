	if fv, found := get_any(v, "enters_with_modifications"); found { if !decode_PendingEntersModifications(fv, &out.enters_with_modifications) do return fail("CastOfferKind::GraveyardPaidCast.enters_with_modifications") }
	if fv, found := get_any(v, "cast_transformed"); found { if !decode_bool(fv, &out.cast_transformed) do return fail("CastOfferKind::GraveyardPaidCast.cast_transformed") }
	if fv, found := get_any(v, "additional_cost"); found { if !dec_opt_ManaCost(fv, &out.additional_cost) do return fail("CastOfferKind::GraveyardPaidCast.additional_cost") }
	if fv, found := get_any(v, "cleanup"); found { if !decode_ResolutionCastCleanup(fv, &out.cleanup) do return fail("CastOfferKind::GraveyardPaidCast.cleanup") } else { return fail("CastOfferKind::GraveyardPaidCast.cleanup missing") }
	return true
		}) { return fail("CastOfferKind::GraveyardPaidCast") }
		out^ = tmp
	case: return fail("CastOfferKind: unknown variant")
	}
	return true
}

encode_CastOfferKind :: proc(b: ^strings.Builder, x: CastOfferKind) {
	#partial switch y in x {
	case CastOfferKind_Adventure: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Adventure")
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "card_id"); encode_CardId(b, y.card_id)
	member(b, first, "payment_mode"); encode_CastPaymentMode(b, y.payment_mode)
	}; strings.write_byte(b, '}')
	case CastOfferKind_Miracle: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Miracle")
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	}; strings.write_byte(b, '}')
	case CastOfferKind_Madness: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Madness")
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	}; strings.write_byte(b, '}')
	case CastOfferKind_Paradigm: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Paradigm")
	member(b, first, "offers"); enc_dyn_ObjectId(b, y.offers)
	}; strings.write_byte(b, '}')
	case CastOfferKind_Cascade: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Cascade")
	member(b, first, "hit_card"); encode_ObjectId(b, y.hit_card)
	member(b, first, "exiled_misses"); enc_dyn_ObjectId(b, y.exiled_misses)
	member(b, first, "source_mv"); encode_u32(b, y.source_mv)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	}; strings.write_byte(b, '}')
	case CastOfferKind_Discover: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Discover")
	member(b, first, "hit_card"); encode_ObjectId(b, y.hit_card)
	member(b, first, "exiled_misses"); enc_dyn_ObjectId(b, y.exiled_misses)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "discover_value"); encode_u32(b, y.discover_value)
	}; strings.write_byte(b, '}')
	case CastOfferKind_Ripple: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Ripple")
	member(b, first, "hit_card"); encode_ObjectId(b, y.hit_card)
	member(b, first, "remaining_hits"); enc_dyn_ObjectId(b, y.remaining_hits)
	member(b, first, "revealed_misses"); enc_dyn_ObjectId(b, y.revealed_misses)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	}; strings.write_byte(b, '}')
	case CastOfferKind_FreeCastWindow: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "FreeCastWindow")
	member(b, first, "candidates"); enc_dyn_ObjectId(b, y.candidates)
	if !(y.remaining_casts == nil) { member(b, first, "remaining_casts"); enc_opt_u8(b, y.remaining_casts) }
	if !(y.remaining_mv_budget == nil) { member(b, first, "remaining_mv_budget"); enc_opt_u32(b, y.remaining_mv_budget) }
	member(b, first, "face_policy"); encode_ResolutionCastFacePolicy(b, y.face_policy)
	member(b, first, "zones"); enc_dyn_Zone(b, y.zones)
	if !(y.graveyard_replacement == nil) { member(b, first, "graveyard_replacement"); enc_opt_SpellStackToGraveyardReplacement(b, y.graveyard_replacement) }
	if !((len(y.member_pool) == 0)) { member(b, first, "member_pool"); enc_dyn_ObjectId(b, y.member_pool) }
	if !(skip_CastOfferKind_PendingEntersModifications_is_empty_PendingEntersModifications(y.enters_with_modifications)) { member(b, first, "enters_with_modifications"); encode_PendingEntersModifications(b, y.enters_with_modifications) }
	}; strings.write_byte(b, '}')
	case CastOfferKind_GraveyardPaidCast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GraveyardPaidCast")
	member(b, first, "hit_card"); encode_ObjectId(b, y.hit_card)
	if !(y.mana_spend_permission == nil) { member(b, first, "mana_spend_permission"); enc_opt_ManaSpendPermission(b, y.mana_spend_permission) }
	if !(y.graveyard_replacement == nil) { member(b, first, "graveyard_replacement"); enc_opt_SpellStackToGraveyardReplacement(b, y.graveyard_replacement) }
	if !(skip_CastOfferKind_PendingEntersModifications_is_empty_PendingEntersModifications(y.enters_with_modifications)) { member(b, first, "enters_with_modifications"); encode_PendingEntersModifications(b, y.enters_with_modifications) }
	if !(!y.cast_transformed) { member(b, first, "cast_transformed"); encode_bool(b, y.cast_transformed) }
	if !(y.additional_cost == nil) { member(b, first, "additional_cost"); enc_opt_ManaCost(b, y.additional_cost) }
	member(b, first, "cleanup"); encode_ResolutionCastCleanup(b, y.cleanup)
	}; strings.write_byte(b, '}')
	}
}

encode_CastOfferKind_members :: proc(b: ^strings.Builder, x: CastOfferKind, first: ^bool) {
	#partial switch y in x {
	case CastOfferKind_Adventure: member(b, first, "type"); json.write_string(b, "Adventure")
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "card_id"); encode_CardId(b, y.card_id)
	member(b, first, "payment_mode"); encode_CastPaymentMode(b, y.payment_mode)

	case CastOfferKind_Miracle: member(b, first, "type"); json.write_string(b, "Miracle")
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "cost"); encode_ManaCost(b, y.cost)

	case CastOfferKind_Madness: member(b, first, "type"); json.write_string(b, "Madness")
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "cost"); encode_ManaCost(b, y.cost)

	case CastOfferKind_Paradigm: member(b, first, "type"); json.write_string(b, "Paradigm")
	member(b, first, "offers"); enc_dyn_ObjectId(b, y.offers)

	case CastOfferKind_Cascade: member(b, first, "type"); json.write_string(b, "Cascade")
	member(b, first, "hit_card"); encode_ObjectId(b, y.hit_card)
	member(b, first, "exiled_misses"); enc_dyn_ObjectId(b, y.exiled_misses)
	member(b, first, "source_mv"); encode_u32(b, y.source_mv)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)

	case CastOfferKind_Discover: member(b, first, "type"); json.write_string(b, "Discover")
	member(b, first, "hit_card"); encode_ObjectId(b, y.hit_card)
	member(b, first, "exiled_misses"); enc_dyn_ObjectId(b, y.exiled_misses)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "discover_value"); encode_u32(b, y.discover_value)

	case CastOfferKind_Ripple: member(b, first, "type"); json.write_string(b, "Ripple")
	member(b, first, "hit_card"); encode_ObjectId(b, y.hit_card)
	member(b, first, "remaining_hits"); enc_dyn_ObjectId(b, y.remaining_hits)
	member(b, first, "revealed_misses"); enc_dyn_ObjectId(b, y.revealed_misses)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)

	case CastOfferKind_FreeCastWindow: member(b, first, "type"); json.write_string(b, "FreeCastWindow")
	member(b, first, "candidates"); enc_dyn_ObjectId(b, y.candidates)
	if !(y.remaining_casts == nil) { member(b, first, "remaining_casts"); enc_opt_u8(b, y.remaining_casts) }
	if !(y.remaining_mv_budget == nil) { member(b, first, "remaining_mv_budget"); enc_opt_u32(b, y.remaining_mv_budget) }
	member(b, first, "face_policy"); encode_ResolutionCastFacePolicy(b, y.face_policy)
	member(b, first, "zones"); enc_dyn_Zone(b, y.zones)
	if !(y.graveyard_replacement == nil) { member(b, first, "graveyard_replacement"); enc_opt_SpellStackToGraveyardReplacement(b, y.graveyard_replacement) }
	if !((len(y.member_pool) == 0)) { member(b, first, "member_pool"); enc_dyn_ObjectId(b, y.member_pool) }
	if !(skip_CastOfferKind_PendingEntersModifications_is_empty_PendingEntersModifications(y.enters_with_modifications)) { member(b, first, "enters_with_modifications"); encode_PendingEntersModifications(b, y.enters_with_modifications) }

	case CastOfferKind_GraveyardPaidCast: member(b, first, "type"); json.write_string(b, "GraveyardPaidCast")
	member(b, first, "hit_card"); encode_ObjectId(b, y.hit_card)
	if !(y.mana_spend_permission == nil) { member(b, first, "mana_spend_permission"); enc_opt_ManaSpendPermission(b, y.mana_spend_permission) }
	if !(y.graveyard_replacement == nil) { member(b, first, "graveyard_replacement"); enc_opt_SpellStackToGraveyardReplacement(b, y.graveyard_replacement) }
	if !(skip_CastOfferKind_PendingEntersModifications_is_empty_PendingEntersModifications(y.enters_with_modifications)) { member(b, first, "enters_with_modifications"); encode_PendingEntersModifications(b, y.enters_with_modifications) }
	if !(!y.cast_transformed) { member(b, first, "cast_transformed"); encode_bool(b, y.cast_transformed) }
	if !(y.additional_cost == nil) { member(b, first, "additional_cost"); enc_opt_ManaCost(b, y.additional_cost) }
	member(b, first, "cleanup"); encode_ResolutionCastCleanup(b, y.cleanup)

	}
}

decode_CastPaymentMode :: proc(v: json.Value, out: ^CastPaymentMode) -> bool {
	when COVERAGE do cov_hit("CastPaymentMode")
	if v.kind != .Object do return fail("CastPaymentMode: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("CastPaymentMode: no tag")
	str := tv.text
	switch str {
	case "Auto": when COVERAGE do cov_hit("CastPaymentMode::Auto"); out^ = .Auto
	case "AutoExceptSacrificialMana": when COVERAGE do cov_hit("CastPaymentMode::AutoExceptSacrificialMana"); out^ = .AutoExceptSacrificialMana
	case "Manual": when COVERAGE do cov_hit("CastPaymentMode::Manual"); out^ = .Manual
	case: return fail("CastPaymentMode: unknown variant")
	}
	return true
}

encode_CastPaymentMode :: proc(b: ^strings.Builder, x: CastPaymentMode) {
	strings.write_byte(b, '{')
	f := true
	encode_CastPaymentMode_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CastPaymentMode_members :: proc(b: ^strings.Builder, x: CastPaymentMode, first: ^bool) {
	_ = x
	@(static, rodata) NAMES := [CastPaymentMode]string{
		.Auto = "Auto",
		.AutoExceptSacrificialMana = "AutoExceptSacrificialMana",
		.Manual = "Manual",
	}
	member(b, first, "type"); json.write_string(b, NAMES[x])
}

