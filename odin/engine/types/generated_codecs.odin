		tmp: WaitingFor_PhyrexianPayment
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^WaitingFor_PhyrexianPayment) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("WaitingFor::PhyrexianPayment.player") } else { return fail("WaitingFor::PhyrexianPayment.player missing") }
	if fv, found := get_any(v, "spell_object"); found { if !decode_ObjectId(fv, &out.spell_object) do return fail("WaitingFor::PhyrexianPayment.spell_object") } else { return fail("WaitingFor::PhyrexianPayment.spell_object missing") }
	if fv, found := get_any(v, "shards"); found { if !dec_dyn_PhyrexianShard(fv, &out.shards) do return fail("WaitingFor::PhyrexianPayment.shards") } else { return fail("WaitingFor::PhyrexianPayment.shards missing") }
	return true
		}) { return fail("WaitingFor::PhyrexianPayment") }
		out^ = tmp
	case: return fail("WaitingFor: unknown variant")
	}
	return true
}

encode_WaitingFor :: proc(b: ^strings.Builder, x: WaitingFor) {
	#partial switch y in x {
	case WaitingFor_Priority: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Priority"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaitingFor_ResolveAllConsent: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ResolveAllConsent"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "epoch"); encode_u64(b, y.epoch)
	member(b, first, "representative"); encode_PlayerId(b, y.representative)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaitingFor_ResolveAllReady: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ResolveAllReady"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "epoch"); encode_u64(b, y.epoch)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaitingFor_MeldPairChoice: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "MeldPairChoice"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "choices"); enc_dyn_MeldSelection(b, y.choices)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaitingFor_MeldAttackTargetChoice: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "MeldAttackTargetChoice"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "context"); encode_MeldSelection(b, y.context_)
	member(b, first, "valid_targets"); enc_dyn_AttackTarget(b, y.valid_targets)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaitingFor_EntryAttackTargetChoice: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EntryAttackTargetChoice"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "valid_targets"); enc_dyn_AttackTarget(b, y.valid_targets)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaitingFor_MulliganDecision: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "MulliganDecision"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "pending"); enc_dyn_MulliganDecisionEntry(b, y.pending)
	member(b, first, "free_first_mulligan"); encode_bool(b, y.free_first_mulligan)
	if !((len(y.declared) == 0)) { member(b, first, "declared"); enc_dyn_MulliganDeclaration(b, y.declared) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaitingFor_OpeningHandBottomCards: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpeningHandBottomCards"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "pending"); enc_dyn_MulliganBottomEntry(b, y.pending)
	member(b, first, "reason"); encode_OpeningHandBottomReason(b, y.reason)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaitingFor_ManaPayment: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ManaPayment"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	if !(y.convoke_mode == nil) { member(b, first, "convoke_mode"); enc_opt_ConvokeMode(b, y.convoke_mode) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaitingFor_ManaSourceSelection: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ManaSourceSelection"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "options"); enc_dyn_ManaSourceSelection(b, y.options)
