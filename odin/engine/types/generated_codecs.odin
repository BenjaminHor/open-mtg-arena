	if fv, found := get_any(v, "cost"); found { if !decode_ManaCost(fv, &out.cost) do return fail("PendingCast.cost") } else { return fail("PendingCast.cost missing") }
	if fv, found := get_any(v, "prepaid_actual_mana_spent"); found { if !dec_opt_u32(fv, &out.prepaid_actual_mana_spent) do return fail("PendingCast.prepaid_actual_mana_spent") }
	if fv, found := get_any(v, "base_cost"); found { if !dec_opt_ManaCost(fv, &out.base_cost) do return fail("PendingCast.base_cost") }
	if fv, found := get_any(v, "declared_mana_additions"); found { if !dec_dyn_ManaCost(fv, &out.declared_mana_additions) do return fail("PendingCast.declared_mana_additions") }
	if fv, found := get_any(v, "accepted_cost_reductions"); found { if !dec_dyn_CostReductionEntry(fv, &out.accepted_cost_reductions) do return fail("PendingCast.accepted_cost_reductions") }
	if fv, found := get_any(v, "cost_reduction_election"); found { if !dec_opt_CostReductionElection(fv, &out.cost_reduction_election) do return fail("PendingCast.cost_reduction_election") }
	if fv, found := get_any(v, "activation_cost_snapshot"); found { if !dec_ptr_ActivationCostSnapshot(fv, &out.activation_cost_snapshot) do return fail("PendingCast.activation_cost_snapshot") }
	if fv, found := get_any(v, "activation_cost"); found { if !dec_opt_AbilityCost(fv, &out.activation_cost) do return fail("PendingCast.activation_cost") }
	if fv, found := get_any(v, "activation_cost_paused_on_draw"); found { if !decode_bool(fv, &out.activation_cost_paused_on_draw) do return fail("PendingCast.activation_cost_paused_on_draw") }
	if fv, found := get_any(v, "deferred_hand_discard_cost"); found { if !dec_opt_DeferredHandDiscardCost(fv, &out.deferred_hand_discard_cost) do return fail("PendingCast.deferred_hand_discard_cost") }
	if fv, found := get_any(v, "prepaid_finalization"); found { if !dec_ptr_PrepaidSpellFinalization(fv, &out.prepaid_finalization) do return fail("PendingCast.prepaid_finalization") }
	if fv, found := get_any(v, "deferred_life_gain_cost"); found { if !dec_opt_DeferredLifeGainCost(fv, &out.deferred_life_gain_cost) do return fail("PendingCast.deferred_life_gain_cost") }
	if fv, found := get_any(v, "activation_ability_index"); found { if !dec_opt_int(fv, &out.activation_ability_index) do return fail("PendingCast.activation_ability_index") }
	if fv, found := get_any(v, "pending_loyalty_activation_player"); found { if !dec_opt_PlayerId(fv, &out.pending_loyalty_activation_player) do return fail("PendingCast.pending_loyalty_activation_player") }
	if fv, found := get_any(v, "target_constraints"); found { if !dec_dyn_TargetSelectionConstraint(fv, &out.target_constraints) do return fail("PendingCast.target_constraints") }
	if fv, found := get_any(v, "crime_candidate"); found { if !decode_bool(fv, &out.crime_candidate) do return fail("PendingCast.crime_candidate") }
	if fv, found := get_any(v, "casting_variant"); found { if !decode_CastingVariant(fv, &out.casting_variant) do return fail("PendingCast.casting_variant") } else { out.casting_variant = CastingVariant(CastingVariant_Normal{}) }
	if fv, found := get_any(v, "alternative_cost_keyword"); found { if !dec_opt_Keyword(fv, &out.alternative_cost_keyword) do return fail("PendingCast.alternative_cost_keyword") }
	if fv, found := get_any(v, "casting_permission_index"); found { if !dec_opt_CastingPermissionIndex(fv, &out.casting_permission_index) do return fail("PendingCast.casting_permission_index") }
	if fv, found := get_any(v, "cast_timing_permission"); found { if !dec_opt_CastTimingRoute(fv, &out.cast_timing_permission) do return fail("PendingCast.cast_timing_permission") }
	if fv, found := get_any(v, "distribute"); found { if !dec_opt_DistributionUnit(fv, &out.distribute) do return fail("PendingCast.distribute") }
	if fv, found := get_any(v, "origin_zone"); found { if !decode_Zone(fv, &out.origin_zone) do return fail("PendingCast.origin_zone") } else { out.origin_zone = default_PendingCast_default_origin_zone() }
	if fv, found := get_any(v, "additional_cost_flow"); found { if !dec_opt_AdditionalCost(fv, &out.additional_cost_flow) do return fail("PendingCast.additional_cost_flow") }
	if fv, found := get_any(v, "deferred_required_additional_cost"); found { if !dec_opt_AbilityCost(fv, &out.deferred_required_additional_cost) do return fail("PendingCast.deferred_required_additional_cost") }
	if fv, found := get_any(v, "additional_cost_queue"); found { if !dec_dyn_AdditionalCostInstance(fv, &out.additional_cost_queue) do return fail("PendingCast.additional_cost_queue") }
	if fv, found := get_any(v, "additional_cost_source"); found { if !decode_SpellCostSource(fv, &out.additional_cost_source) do return fail("PendingCast.additional_cost_source") }
	if fv, found := get_any(v, "additional_cost_payment_mode"); found { if !dec_opt_ConvokeMode(fv, &out.additional_cost_payment_mode) do return fail("PendingCast.additional_cost_payment_mode") }
	if fv, found := get_any(v, "deferred_modal_choice"); found { if !dec_opt_ModalChoice(fv, &out.deferred_modal_choice) do return fail("PendingCast.deferred_modal_choice") }
	if fv, found := get_any(v, "deferred_target_selection"); found { if !decode_bool(fv, &out.deferred_target_selection) do return fail("PendingCast.deferred_target_selection") }
	if fv, found := get_any(v, "chosen_modes"); found { if !dec_dyn_int(fv, &out.chosen_modes) do return fail("PendingCast.chosen_modes") }
	if fv, found := get_any(v, "additional_cost_decided"); found { if !decode_bool(fv, &out.additional_cost_decided) do return fail("PendingCast.additional_cost_decided") }
	if fv, found := get_any(v, "keyword_queue_before_targets"); found { if !decode_bool(fv, &out.keyword_queue_before_targets) do return fail("PendingCast.keyword_queue_before_targets") }
	if fv, found := get_any(v, "alternative_cost_election"); found { if !decode_SpellAlternativeCostElection(fv, &out.alternative_cost_election) do return fail("PendingCast.alternative_cost_election") }
	if fv, found := get_any(v, "declared_kickers_to_pay"); found { if !dec_dyn_KickerVariant(fv, &out.declared_kickers_to_pay) do return fail("PendingCast.declared_kickers_to_pay") }
	if fv, found := get_any(v, "declined_kickers"); found { if !dec_dyn_KickerVariant(fv, &out.declined_kickers) do return fail("PendingCast.declined_kickers") }
	if fv, found := get_any(v, "convoked_creatures"); found { if !dec_dyn_ObjectId(fv, &out.convoked_creatures) do return fail("PendingCast.convoked_creatures") }
	if fv, found := get_any(v, "delved_cards"); found { if !dec_dyn_ObjectId(fv, &out.delved_cards) do return fail("PendingCast.delved_cards") }
	if fv, found := get_any(v, "deferred_sacrificed_permanents"); found { if !dec_dyn_DeferredSpellSacrifice(fv, &out.deferred_sacrificed_permanents) do return fail("PendingCast.deferred_sacrificed_permanents") }
	if fv, found := get_any(v, "deferred_tapped_permanents"); found { if !dec_dyn_DeferredSpellTap(fv, &out.deferred_tapped_permanents) do return fail("PendingCast.deferred_tapped_permanents") }
	if fv, found := get_any(v, "pinned_pool_units"); found { if !dec_dyn_ManaPipId(fv, &out.pinned_pool_units) do return fail("PendingCast.pinned_pool_units") }
	if fv, found := get_any(v, "cancel_restore_prepared_source"); found { if !dec_opt_ObjectId(fv, &out.cancel_restore_prepared_source) do return fail("PendingCast.cancel_restore_prepared_source") }
	if fv, found := get_any(v, "payment_mode"); found { if !decode_CastPaymentMode(fv, &out.payment_mode) do return fail("PendingCast.payment_mode") }
	if fv, found := get_any(v, "assist_state"); found { if !decode_AssistState(fv, &out.assist_state) do return fail("PendingCast.assist_state") } else { out.assist_state = AssistState(AssistState_NotOffered{}) }
	if fv, found := get_any(v, "activation_residual"); found { if !decode_ActivationResidual(fv, &out.activation_residual) do return fail("PendingCast.activation_residual") }
	if fv, found := get_any(v, "activation_target_selection"); found { if !decode_ActivationTargetSelection(fv, &out.activation_target_selection) do return fail("PendingCast.activation_target_selection") }
	if fv, found := get_any(v, "activation_cost_committed"); found { if !decode_bool(fv, &out.activation_cost_committed) do return fail("PendingCast.activation_cost_committed") }
	if fv, found := get_any(v, "alt_cost_grant_source"); found { if !dec_opt_ObjectId(fv, &out.alt_cost_grant_source) do return fail("PendingCast.alt_cost_grant_source") }
	if fv, found := get_any(v, "activation_trigger_collection"); found { if !dec_ptr_PendingActivationTriggerCollection(fv, &out.activation_trigger_collection) do return fail("PendingCast.activation_trigger_collection") }
	if fv, found := get_any(v, "activation_phyrexian_intent"); found { if !dec_opt_ActivationPhyrexianIntent(fv, &out.activation_phyrexian_intent) do return fail("PendingCast.activation_phyrexian_intent") }
	return true
}

encode_PendingCast :: proc(b: ^strings.Builder, x: PendingCast) {
	strings.write_byte(b, '{')
	f := true
	encode_PendingCast_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PendingCast_members :: proc(b: ^strings.Builder, x: PendingCast, first: ^bool) {
	member(b, first, "object_id"); encode_ObjectId(b, x.object_id)
	member(b, first, "card_id"); encode_CardId(b, x.card_id)
	member(b, first, "ability"); enc_ptr_ResolvedAbility(b, x.ability)
	member(b, first, "cost"); encode_ManaCost(b, x.cost)
	if !(x.prepaid_actual_mana_spent == nil) { member(b, first, "prepaid_actual_mana_spent"); enc_opt_u32(b, x.prepaid_actual_mana_spent) }
	if !(x.base_cost == nil) { member(b, first, "base_cost"); enc_opt_ManaCost(b, x.base_cost) }
	if !((len(x.declared_mana_additions) == 0)) { member(b, first, "declared_mana_additions"); enc_dyn_ManaCost(b, x.declared_mana_additions) }
	if !((len(x.accepted_cost_reductions) == 0)) { member(b, first, "accepted_cost_reductions"); enc_dyn_CostReductionEntry(b, x.accepted_cost_reductions) }
	if !(x.cost_reduction_election == nil) { member(b, first, "cost_reduction_election"); enc_opt_CostReductionElection(b, x.cost_reduction_election) }
	if !(x.activation_cost_snapshot == nil) { member(b, first, "activation_cost_snapshot"); enc_ptr_ActivationCostSnapshot(b, x.activation_cost_snapshot) }
	if !(x.activation_cost == nil) { member(b, first, "activation_cost"); enc_opt_AbilityCost(b, x.activation_cost) }
	member(b, first, "activation_cost_paused_on_draw"); encode_bool(b, x.activation_cost_paused_on_draw)
	if !(x.deferred_hand_discard_cost == nil) { member(b, first, "deferred_hand_discard_cost"); enc_opt_DeferredHandDiscardCost(b, x.deferred_hand_discard_cost) }
	if !(x.prepaid_finalization == nil) { member(b, first, "prepaid_finalization"); enc_ptr_PrepaidSpellFinalization(b, x.prepaid_finalization) }
	if !(x.deferred_life_gain_cost == nil) { member(b, first, "deferred_life_gain_cost"); enc_opt_DeferredLifeGainCost(b, x.deferred_life_gain_cost) }
	if !(x.activation_ability_index == nil) { member(b, first, "activation_ability_index"); enc_opt_int(b, x.activation_ability_index) }
	if !(x.pending_loyalty_activation_player == nil) { member(b, first, "pending_loyalty_activation_player"); enc_opt_PlayerId(b, x.pending_loyalty_activation_player) }
	if !((len(x.target_constraints) == 0)) { member(b, first, "target_constraints"); enc_dyn_TargetSelectionConstraint(b, x.target_constraints) }
	member(b, first, "crime_candidate"); encode_bool(b, x.crime_candidate)
	member(b, first, "casting_variant"); encode_CastingVariant(b, x.casting_variant)
	if !(x.alternative_cost_keyword == nil) { member(b, first, "alternative_cost_keyword"); enc_opt_Keyword(b, x.alternative_cost_keyword) }
	if !(x.casting_permission_index == nil) { member(b, first, "casting_permission_index"); enc_opt_CastingPermissionIndex(b, x.casting_permission_index) }
	if !(x.cast_timing_permission == nil) { member(b, first, "cast_timing_permission"); enc_opt_CastTimingRoute(b, x.cast_timing_permission) }
	if !(x.distribute == nil) { member(b, first, "distribute"); enc_opt_DistributionUnit(b, x.distribute) }
	member(b, first, "origin_zone"); encode_Zone(b, x.origin_zone)
	if !(x.additional_cost_flow == nil) { member(b, first, "additional_cost_flow"); enc_opt_AdditionalCost(b, x.additional_cost_flow) }
	if !(x.deferred_required_additional_cost == nil) { member(b, first, "deferred_required_additional_cost"); enc_opt_AbilityCost(b, x.deferred_required_additional_cost) }
	if !((len(x.additional_cost_queue) == 0)) { member(b, first, "additional_cost_queue"); enc_dyn_AdditionalCostInstance(b, x.additional_cost_queue) }
	member(b, first, "additional_cost_source"); encode_SpellCostSource(b, x.additional_cost_source)
	if !(x.additional_cost_payment_mode == nil) { member(b, first, "additional_cost_payment_mode"); enc_opt_ConvokeMode(b, x.additional_cost_payment_mode) }
	if !(x.deferred_modal_choice == nil) { member(b, first, "deferred_modal_choice"); enc_opt_ModalChoice(b, x.deferred_modal_choice) }
	member(b, first, "deferred_target_selection"); encode_bool(b, x.deferred_target_selection)
	if !((len(x.chosen_modes) == 0)) { member(b, first, "chosen_modes"); enc_dyn_int(b, x.chosen_modes) }
	member(b, first, "additional_cost_decided"); encode_bool(b, x.additional_cost_decided)
	if !(!x.keyword_queue_before_targets) { member(b, first, "keyword_queue_before_targets"); encode_bool(b, x.keyword_queue_before_targets) }
	member(b, first, "alternative_cost_election"); encode_SpellAlternativeCostElection(b, x.alternative_cost_election)
	if !((len(x.declared_kickers_to_pay) == 0)) { member(b, first, "declared_kickers_to_pay"); enc_dyn_KickerVariant(b, x.declared_kickers_to_pay) }
	if !((len(x.declined_kickers) == 0)) { member(b, first, "declined_kickers"); enc_dyn_KickerVariant(b, x.declined_kickers) }
	if !((len(x.convoked_creatures) == 0)) { member(b, first, "convoked_creatures"); enc_dyn_ObjectId(b, x.convoked_creatures) }
	if !((len(x.delved_cards) == 0)) { member(b, first, "delved_cards"); enc_dyn_ObjectId(b, x.delved_cards) }
	if !((len(x.deferred_sacrificed_permanents) == 0)) { member(b, first, "deferred_sacrificed_permanents"); enc_dyn_DeferredSpellSacrifice(b, x.deferred_sacrificed_permanents) }
	if !((len(x.deferred_tapped_permanents) == 0)) { member(b, first, "deferred_tapped_permanents"); enc_dyn_DeferredSpellTap(b, x.deferred_tapped_permanents) }
	if !((len(x.pinned_pool_units) == 0)) { member(b, first, "pinned_pool_units"); enc_dyn_ManaPipId(b, x.pinned_pool_units) }
	if !(x.cancel_restore_prepared_source == nil) { member(b, first, "cancel_restore_prepared_source"); enc_opt_ObjectId(b, x.cancel_restore_prepared_source) }
	member(b, first, "payment_mode"); encode_CastPaymentMode(b, x.payment_mode)
	member(b, first, "assist_state"); encode_AssistState(b, x.assist_state)
	if !(skip_PendingCast_ActivationResidual_is_none_ActivationResidual(x.activation_residual)) { member(b, first, "activation_residual"); encode_ActivationResidual(b, x.activation_residual) }
	if !(skip_PendingCast_ActivationTargetSelection_is_pending_ActivationTargetSelection(x.activation_target_selection)) { member(b, first, "activation_target_selection"); encode_ActivationTargetSelection(b, x.activation_target_selection) }
	member(b, first, "activation_cost_committed"); encode_bool(b, x.activation_cost_committed)
	if !(x.alt_cost_grant_source == nil) { member(b, first, "alt_cost_grant_source"); enc_opt_ObjectId(b, x.alt_cost_grant_source) }
	if !(x.activation_trigger_collection == nil) { member(b, first, "activation_trigger_collection"); enc_ptr_PendingActivationTriggerCollection(b, x.activation_trigger_collection) }
	if !(x.activation_phyrexian_intent == nil) { member(b, first, "activation_phyrexian_intent"); enc_opt_ActivationPhyrexianIntent(b, x.activation_phyrexian_intent) }
}

decode_DungeonProgress :: proc(v: json.Value, out: ^DungeonProgress) -> bool {
	when COVERAGE do cov_hit("DungeonProgress")
	if v.kind != .Object do return fail("DungeonProgress: not an object")
	if fv, found := get_any(v, "current_dungeon"); found { if !dec_opt_DungeonId(fv, &out.current_dungeon) do return fail("DungeonProgress.current_dungeon") }
	if fv, found := get_any(v, "current_room"); found { if !decode_u8(fv, &out.current_room) do return fail("DungeonProgress.current_room") } else { return fail("DungeonProgress.current_room missing") }
	if fv, found := get_any(v, "completed"); found { if !dec_dyn_DungeonId(fv, &out.completed) do return fail("DungeonProgress.completed") } else { return fail("DungeonProgress.completed missing") }
	return true
}

encode_DungeonProgress :: proc(b: ^strings.Builder, x: DungeonProgress) {
	strings.write_byte(b, '{')
	f := true
	encode_DungeonProgress_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_DungeonProgress_members :: proc(b: ^strings.Builder, x: DungeonProgress, first: ^bool) {
	member(b, first, "current_dungeon"); enc_opt_DungeonId(b, x.current_dungeon)
	member(b, first, "current_room"); encode_u8(b, x.current_room)
	member(b, first, "completed"); enc_dyn_DungeonId(b, x.completed)
}

decode_TargetRef :: proc(v: json.Value, out: ^TargetRef) -> bool {
	when COVERAGE do cov_hit("TargetRef")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("TargetRef: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("TargetRef: not a string or object")
	}
	switch variant {
	case "Object": when COVERAGE do cov_hit("TargetRef::Object"); tmp: TargetRef_Object; if !decode_ObjectId(body, &tmp._0) do return fail("TargetRef::Object"); out^ = tmp
	case "Player": when COVERAGE do cov_hit("TargetRef::Player"); tmp: TargetRef_Player; if !decode_PlayerId(body, &tmp._0) do return fail("TargetRef::Player"); out^ = tmp
	case: return fail("TargetRef: unknown variant")
	}
	return true
}

encode_TargetRef :: proc(b: ^strings.Builder, x: TargetRef) {
	#partial switch y in x {
	case TargetRef_Object: strings.write_byte(b, '{'); json.write_string(b, "Object"); strings.write_byte(b, ':'); encode_ObjectId(b, y._0); strings.write_byte(b, '}')
	case TargetRef_Player: strings.write_byte(b, '{'); json.write_string(b, "Player"); strings.write_byte(b, ':'); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	}
}

decode_ManaPool :: proc(v: json.Value, out: ^ManaPool) -> bool {
	when COVERAGE do cov_hit("ManaPool")
	if v.kind != .Object do return fail("ManaPool: not an object")
	if fv, found := get_any(v, "mana"); found { if !dec_dyn_ManaUnit(fv, &out.mana) do return fail("ManaPool.mana") } else { return fail("ManaPool.mana missing") }
	return true
}

encode_ManaPool :: proc(b: ^strings.Builder, x: ManaPool) {
	strings.write_byte(b, '{')
	f := true
	encode_ManaPool_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ManaPool_members :: proc(b: ^strings.Builder, x: ManaPool, first: ^bool) {
	member(b, first, "mana"); enc_dyn_ManaUnit(b, x.mana)
}

decode_BendingType :: proc(v: json.Value, out: ^BendingType) -> bool {
	when COVERAGE do cov_hit("BendingType")
	if v.kind != .String do return fail("BendingType: not a string")
	str := v.text
	switch str {
	case "Fire": when COVERAGE do cov_hit("BendingType::Fire"); out^ = .Fire
	case "Air": when COVERAGE do cov_hit("BendingType::Air"); out^ = .Air
	case "Earth": when COVERAGE do cov_hit("BendingType::Earth"); out^ = .Earth
	case "Water": when COVERAGE do cov_hit("BendingType::Water"); out^ = .Water
	case: return fail("BendingType: unknown variant")
	}
	return true
}

encode_BendingType :: proc(b: ^strings.Builder, x: BendingType) {
	@(static, rodata) NAMES := [BendingType]string{
		.Fire = "Fire",
		.Air = "Air",
		.Earth = "Earth",
		.Water = "Water",
	}
	json.write_string(b, NAMES[x])
}

decode_PlayerCounterKind :: proc(v: json.Value, out: ^PlayerCounterKind) -> bool {
	when COVERAGE do cov_hit("PlayerCounterKind")
	if v.kind != .String do return fail("PlayerCounterKind: not a string")
	str := v.text
	switch str {
	case "Poison": when COVERAGE do cov_hit("PlayerCounterKind::Poison"); out^ = .Poison
	case "Experience": when COVERAGE do cov_hit("PlayerCounterKind::Experience"); out^ = .Experience
	case "Rad": when COVERAGE do cov_hit("PlayerCounterKind::Rad"); out^ = .Rad
	case "Ticket": when COVERAGE do cov_hit("PlayerCounterKind::Ticket"); out^ = .Ticket
	case: return fail("PlayerCounterKind: unknown variant")
	}
	return true
}

encode_PlayerCounterKind :: proc(b: ^strings.Builder, x: PlayerCounterKind) {
	@(static, rodata) NAMES := [PlayerCounterKind]string{
		.Poison = "Poison",
		.Experience = "Experience",
		.Rad = "Rad",
		.Ticket = "Ticket",
	}
	json.write_string(b, NAMES[x])
}

decode_PlayerStatus :: proc(v: json.Value, out: ^PlayerStatus) -> bool {
	when COVERAGE do cov_hit("PlayerStatus")
	if v.kind != .Object do return fail("PlayerStatus: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("PlayerStatus: no tag")
	str := tv.text
	switch str {
	case "Active": when COVERAGE do cov_hit("PlayerStatus::Active"); out^ = .Active
	case "PhasedOut": when COVERAGE do cov_hit("PlayerStatus::PhasedOut"); out^ = .PhasedOut
	case: return fail("PlayerStatus: unknown variant")
	}
	return true
}

encode_PlayerStatus :: proc(b: ^strings.Builder, x: PlayerStatus) {
	strings.write_byte(b, '{')
	f := true
	encode_PlayerStatus_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PlayerStatus_members :: proc(b: ^strings.Builder, x: PlayerStatus, first: ^bool) {
	_ = x
	@(static, rodata) NAMES := [PlayerStatus]string{
		.Active = "Active",
		.PhasedOut = "PhasedOut",
	}
	member(b, first, "type"); json.write_string(b, NAMES[x])
}

decode_CompanionInfo :: proc(v: json.Value, out: ^CompanionInfo) -> bool {
	when COVERAGE do cov_hit("CompanionInfo")
	if v.kind != .Object do return fail("CompanionInfo: not an object")
	if fv, found := get_any(v, "card"); found { if !decode_DeckEntry(fv, &out.card) do return fail("CompanionInfo.card") } else { return fail("CompanionInfo.card missing") }
	if fv, found := get_any(v, "used"); found { if !decode_bool(fv, &out.used) do return fail("CompanionInfo.used") } else { return fail("CompanionInfo.used missing") }
	if fv, found := get_any(v, "printing"); found { if !decode_DisplayOnly_ptr_CardPrinting(fv, &out.printing) do return fail("CompanionInfo.printing") }
	return true
}

encode_CompanionInfo :: proc(b: ^strings.Builder, x: CompanionInfo) {
	strings.write_byte(b, '{')
	f := true
	encode_CompanionInfo_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CompanionInfo_members :: proc(b: ^strings.Builder, x: CompanionInfo, first: ^bool) {
	member(b, first, "card"); encode_DeckEntry(b, x.card)
	member(b, first, "used"); encode_bool(b, x.used)
	if !(skip_CompanionInfo_DisplayOnly_is_none_DisplayOnly_ptr_CardPrinting(x.printing)) { member(b, first, "printing"); encode_DisplayOnly_ptr_CardPrinting(b, x.printing) }
}

decode_ChosenAttribute :: proc(v: json.Value, out: ^ChosenAttribute) -> bool {
	when COVERAGE do cov_hit("ChosenAttribute")
	if v.kind != .Object do return fail("ChosenAttribute: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ChosenAttribute: no tag")
	switch tv.text {
	case "Color": when COVERAGE do cov_hit("ChosenAttribute::Color"); tmp: ChosenAttribute_Color; if !decode_ManaColor(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::Color"); out^ = tmp
	case "CreatureType": when COVERAGE do cov_hit("ChosenAttribute::CreatureType"); tmp: ChosenAttribute_CreatureType; if !decode_string(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::CreatureType"); out^ = tmp
	case "BasicLandType": when COVERAGE do cov_hit("ChosenAttribute::BasicLandType"); tmp: ChosenAttribute_BasicLandType; if !decode_BasicLandType(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::BasicLandType"); out^ = tmp
	case "CardType": when COVERAGE do cov_hit("ChosenAttribute::CardType"); tmp: ChosenAttribute_CardType; if !decode_CoreType(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::CardType"); out^ = tmp
	case "OddOrEven": when COVERAGE do cov_hit("ChosenAttribute::OddOrEven"); tmp: ChosenAttribute_OddOrEven; if !decode_Parity(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::OddOrEven"); out^ = tmp
	case "CardName": when COVERAGE do cov_hit("ChosenAttribute::CardName"); tmp: ChosenAttribute_CardName; if !decode_string(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::CardName"); out^ = tmp
	case "Number": when COVERAGE do cov_hit("ChosenAttribute::Number"); tmp: ChosenAttribute_Number; if !decode_u32(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::Number"); out^ = tmp
	case "RevealedNumber": when COVERAGE do cov_hit("ChosenAttribute::RevealedNumber"); tmp: ChosenAttribute_RevealedNumber; if !decode_u32(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::RevealedNumber"); out^ = tmp
	case "Player": when COVERAGE do cov_hit("ChosenAttribute::Player"); tmp: ChosenAttribute_Player; if !decode_PlayerId(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::Player"); out^ = tmp
	case "TwoColors": when COVERAGE do cov_hit("ChosenAttribute::TwoColors"); tmp: ChosenAttribute_TwoColors; if !dec__2_ManaColor(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::TwoColors"); out^ = tmp
	case "TributeOutcome": when COVERAGE do cov_hit("ChosenAttribute::TributeOutcome"); tmp: ChosenAttribute_TributeOutcome; if !decode_TributeOutcome(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::TributeOutcome"); out^ = tmp
	case "Keyword": when COVERAGE do cov_hit("ChosenAttribute::Keyword"); tmp: ChosenAttribute_Keyword; if !decode_Keyword(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::Keyword"); out^ = tmp
	case "Label": when COVERAGE do cov_hit("ChosenAttribute::Label"); tmp: ChosenAttribute_Label; if !decode_string(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::Label"); out^ = tmp
	case "Card": when COVERAGE do cov_hit("ChosenAttribute::Card"); tmp: ChosenAttribute_Card; if !decode_ObjectIncarnationRef(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::Card"); out^ = tmp
	case "Counter": when COVERAGE do cov_hit("ChosenAttribute::Counter"); tmp: ChosenAttribute_Counter; if !decode_CounterType(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::Counter"); out^ = tmp
	case "Direction": when COVERAGE do cov_hit("ChosenAttribute::Direction"); tmp: ChosenAttribute_Direction; if !decode_SeatDirection(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::Direction"); out^ = tmp
	case "CopiableSnapshot": when COVERAGE do cov_hit("ChosenAttribute::CopiableSnapshot"); tmp: ChosenAttribute_CopiableSnapshot; if !dec_ptr_LatchedCopiableSnapshot(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::CopiableSnapshot"); out^ = tmp
	case "NotedManaSpent": when COVERAGE do cov_hit("ChosenAttribute::NotedManaSpent"); tmp: ChosenAttribute_NotedManaSpent; if !dec_dyn_ManaType(json.get_or_null(v, "value"), &tmp._0) do return fail("ChosenAttribute::NotedManaSpent"); out^ = tmp
	case: return fail("ChosenAttribute: unknown variant")
	}
	return true
}

encode_ChosenAttribute :: proc(b: ^strings.Builder, x: ChosenAttribute) {
	#partial switch y in x {
	case ChosenAttribute_Color: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Color"); member(b, &f, "value"); encode_ManaColor(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_CreatureType: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CreatureType"); member(b, &f, "value"); encode_string(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_BasicLandType: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BasicLandType"); member(b, &f, "value"); encode_BasicLandType(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_CardType: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CardType"); member(b, &f, "value"); encode_CoreType(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_OddOrEven: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OddOrEven"); member(b, &f, "value"); encode_Parity(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_CardName: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CardName"); member(b, &f, "value"); encode_string(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_Number: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Number"); member(b, &f, "value"); encode_u32(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_RevealedNumber: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RevealedNumber"); member(b, &f, "value"); encode_u32(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_Player: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Player"); member(b, &f, "value"); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_TwoColors: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TwoColors"); member(b, &f, "value"); enc__2_ManaColor(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_TributeOutcome: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TributeOutcome"); member(b, &f, "value"); encode_TributeOutcome(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_Keyword: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Keyword"); member(b, &f, "value"); encode_Keyword(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_Label: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Label"); member(b, &f, "value"); encode_string(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_Card: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Card"); member(b, &f, "value"); encode_ObjectIncarnationRef(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_Counter: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Counter"); member(b, &f, "value"); encode_CounterType(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_Direction: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Direction"); member(b, &f, "value"); encode_SeatDirection(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_CopiableSnapshot: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CopiableSnapshot"); member(b, &f, "value"); enc_ptr_LatchedCopiableSnapshot(b, y._0); strings.write_byte(b, '}')
	case ChosenAttribute_NotedManaSpent: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NotedManaSpent"); member(b, &f, "value"); enc_dyn_ManaType(b, y._0); strings.write_byte(b, '}')
	}
}

decode_ManaUnit :: proc(v: json.Value, out: ^ManaUnit) -> bool {
	when COVERAGE do cov_hit("ManaUnit")
	if v.kind != .Object do return fail("ManaUnit: not an object")
	if fv, found := get_any(v, "color"); found { if !decode_ManaType(fv, &out.color) do return fail("ManaUnit.color") } else { return fail("ManaUnit.color missing") }
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("ManaUnit.source_id") } else { return fail("ManaUnit.source_id missing") }
	if fv, found := get_any(v, "pip_id"); found { if !decode_ManaPipId(fv, &out.pip_id) do return fail("ManaUnit.pip_id") } else { out.pip_id = default_ManaUnit_unstamped_pip_id() }
	if fv, found := get_any(v, "snow"); found { if !decode_with_snow_compat(fv, &out.supertype) do return fail("ManaUnit.supertype") }
	if fv, found := get_any(v, "source_could_produce_two_or_more_colors"); found { if !decode_bool(fv, &out.source_could_produce_two_or_more_colors) do return fail("ManaUnit.source_could_produce_two_or_more_colors") }
	if fv, found := get_any(v, "restrictions"); found { if !dec_dyn_ManaRestriction(fv, &out.restrictions) do return fail("ManaUnit.restrictions") } else { return fail("ManaUnit.restrictions missing") }
	if fv, found := get_any(v, "grants"); found { if !dec_dyn_ManaSpellGrant(fv, &out.grants) do return fail("ManaUnit.grants") }
	if fv, found := get_any(v, "expiry"); found { if !dec_opt_ManaExpiry(fv, &out.expiry) do return fail("ManaUnit.expiry") }
	return true
}

encode_ManaUnit :: proc(b: ^strings.Builder, x: ManaUnit) {
	strings.write_byte(b, '{')
	f := true
	encode_ManaUnit_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ManaUnit_members :: proc(b: ^strings.Builder, x: ManaUnit, first: ^bool) {
	member(b, first, "color"); encode_ManaType(b, x.color)
	member(b, first, "source_id"); encode_ObjectId(b, x.source_id)
	member(b, first, "pip_id"); encode_ManaPipId(b, x.pip_id)
	member(b, first, "snow"); encode_with_snow_compat(b, x.supertype)
	if !(!x.source_could_produce_two_or_more_colors) { member(b, first, "source_could_produce_two_or_more_colors"); encode_bool(b, x.source_could_produce_two_or_more_colors) }
	member(b, first, "restrictions"); enc_dyn_ManaRestriction(b, x.restrictions)
	if !((len(x.grants) == 0)) { member(b, first, "grants"); enc_dyn_ManaSpellGrant(b, x.grants) }
	if !(x.expiry == nil) { member(b, first, "expiry"); enc_opt_ManaExpiry(b, x.expiry) }
}

decode_ActiveLibrarySearch :: proc(v: json.Value, out: ^ActiveLibrarySearch) -> bool {
	when COVERAGE do cov_hit("ActiveLibrarySearch")
	if v.kind != .Object do return fail("ActiveLibrarySearch: not an object")
	if fv, found := get_any(v, "searcher"); found { if !decode_PlayerId(fv, &out.searcher) do return fail("ActiveLibrarySearch.searcher") } else { return fail("ActiveLibrarySearch.searcher missing") }
	if fv, found := get_any(v, "searched_zone_owner"); found { if !decode_PlayerId(fv, &out.searched_zone_owner) do return fail("ActiveLibrarySearch.searched_zone_owner") } else { return fail("ActiveLibrarySearch.searched_zone_owner missing") }
	if fv, found := get_any(v, "effective_library_owner"); found { if !dec_opt_PlayerId(fv, &out.effective_library_owner) do return fail("ActiveLibrarySearch.effective_library_owner") }
	if fv, found := get_any(v, "learned_audience"); found { if !dec_dyn_PlayerId(fv, &out.learned_audience) do return fail("ActiveLibrarySearch.learned_audience") } else { return fail("ActiveLibrarySearch.learned_audience missing") }
	if fv, found := get_any(v, "looked_at"); found { if !dec_dyn_t3_PlayerId_Zone_ObjectIncarnationRef(fv, &out.looked_at) do return fail("ActiveLibrarySearch.looked_at") } else { return fail("ActiveLibrarySearch.looked_at missing") }
	return true
}

encode_ActiveLibrarySearch :: proc(b: ^strings.Builder, x: ActiveLibrarySearch) {
	strings.write_byte(b, '{')
	f := true
	encode_ActiveLibrarySearch_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ActiveLibrarySearch_members :: proc(b: ^strings.Builder, x: ActiveLibrarySearch, first: ^bool) {
	member(b, first, "searcher"); encode_PlayerId(b, x.searcher)
	member(b, first, "searched_zone_owner"); encode_PlayerId(b, x.searched_zone_owner)
	if !(x.effective_library_owner == nil) { member(b, first, "effective_library_owner"); enc_opt_PlayerId(b, x.effective_library_owner) }
	member(b, first, "learned_audience"); enc_dyn_PlayerId(b, x.learned_audience)
	member(b, first, "looked_at"); enc_dyn_t3_PlayerId_Zone_ObjectIncarnationRef(b, x.looked_at)
}

decode_ActiveSearchDecisionControl :: proc(v: json.Value, out: ^ActiveSearchDecisionControl) -> bool {
	when COVERAGE do cov_hit("ActiveSearchDecisionControl")
	if v.kind != .Object do return fail("ActiveSearchDecisionControl: not an object")
	if fv, found := get_any(v, "searcher"); found { if !decode_PlayerId(fv, &out.searcher) do return fail("ActiveSearchDecisionControl.searcher") } else { return fail("ActiveSearchDecisionControl.searcher missing") }
	if fv, found := get_any(v, "searched_zone_owner"); found { if !decode_PlayerId(fv, &out.searched_zone_owner) do return fail("ActiveSearchDecisionControl.searched_zone_owner") } else { return fail("ActiveSearchDecisionControl.searched_zone_owner missing") }
	if fv, found := get_any(v, "authority"); found { if !decode_ActiveSearchDecisionAuthority(fv, &out.authority) do return fail("ActiveSearchDecisionControl.authority") } else { return fail("ActiveSearchDecisionControl.authority missing") }
	return true
}

encode_ActiveSearchDecisionControl :: proc(b: ^strings.Builder, x: ActiveSearchDecisionControl) {
	strings.write_byte(b, '{')
	f := true
	encode_ActiveSearchDecisionControl_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ActiveSearchDecisionControl_members :: proc(b: ^strings.Builder, x: ActiveSearchDecisionControl, first: ^bool) {
	member(b, first, "searcher"); encode_PlayerId(b, x.searcher)
	member(b, first, "searched_zone_owner"); encode_PlayerId(b, x.searched_zone_owner)
	member(b, first, "authority"); encode_ActiveSearchDecisionAuthority(b, x.authority)
}

decode_GameObject :: proc(v: json.Value, out: ^GameObject) -> bool {
	when COVERAGE do cov_hit("GameObject")
	if v.kind != .Object do return fail("GameObject: not an object")
	if fv, found := get_any(v, "id"); found { if !decode_ObjectId(fv, &out.id) do return fail("GameObject.id") } else { return fail("GameObject.id missing") }
	if fv, found := get_any(v, "card_id"); found { if !decode_CardId(fv, &out.card_id) do return fail("GameObject.card_id") } else { return fail("GameObject.card_id missing") }
	if fv, found := get_any(v, "owner"); found { if !decode_PlayerId(fv, &out.owner) do return fail("GameObject.owner") } else { return fail("GameObject.owner missing") }
	if fv, found := get_any(v, "base_controller"); found { if !dec_opt_PlayerId(fv, &out.base_controller) do return fail("GameObject.base_controller") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("GameObject.controller") } else { return fail("GameObject.controller missing") }
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("GameObject.zone") } else { return fail("GameObject.zone missing") }
	if fv, found := get_any(v, "display_visible_to_viewer"); found { if !decode_bool(fv, &out.display_visible_to_viewer) do return fail("GameObject.display_visible_to_viewer") }
	if fv, found := get_any(v, "tapped"); found { if !decode_bool(fv, &out.tapped) do return fail("GameObject.tapped") } else { return fail("GameObject.tapped missing") }
	if fv, found := get_any(v, "face_down"); found { if !decode_bool(fv, &out.face_down) do return fail("GameObject.face_down") } else { return fail("GameObject.face_down missing") }
	if fv, found := get_any(v, "face_down_cause"); found { if !dec_opt_FaceDownCause(fv, &out.face_down_cause) do return fail("GameObject.face_down_cause") }
	if fv, found := get_any(v, "flipped"); found { if !decode_bool(fv, &out.flipped) do return fail("GameObject.flipped") } else { return fail("GameObject.flipped missing") }
	if fv, found := get_any(v, "transformed"); found { if !decode_bool(fv, &out.transformed) do return fail("GameObject.transformed") } else { return fail("GameObject.transformed missing") }
	if fv, found := get_any(v, "transformation_count"); found { if !decode_u32(fv, &out.transformation_count) do return fail("GameObject.transformation_count") }
	if fv, found := get_any(v, "modal_back_face"); found { if !decode_bool(fv, &out.modal_back_face) do return fail("GameObject.modal_back_face") }
	if fv, found := get_any(v, "cast_face_committed"); found { if !decode_bool(fv, &out.cast_face_committed) do return fail("GameObject.cast_face_committed") }
	if fv, found := get_any(v, "damage_marked"); found { if !decode_u32(fv, &out.damage_marked) do return fail("GameObject.damage_marked") } else { return fail("GameObject.damage_marked missing") }
	if fv, found := get_any(v, "dealt_deathtouch_damage"); found { if !decode_bool(fv, &out.dealt_deathtouch_damage) do return fail("GameObject.dealt_deathtouch_damage") } else { return fail("GameObject.dealt_deathtouch_damage missing") }
	if fv, found := get_any(v, "dealt_damage_kinds"); found { if !decode_DealtDamageKinds(fv, &out.dealt_damage_kinds) do return fail("GameObject.dealt_damage_kinds") }
	if fv, found := get_any(v, "attached_to"); found { if !dec_opt_AttachTarget(fv, &out.attached_to) do return fail("GameObject.attached_to") }
	if fv, found := get_any(v, "attachments"); found { if !dec_dyn_ObjectId(fv, &out.attachments) do return fail("GameObject.attachments") } else { return fail("GameObject.attachments missing") }
	if fv, found := get_any(v, "protection_start_snapshots"); found { if !dec_dyn_t2_ProtectionStartKey_ProtectionStartSnapshot(fv, &out.protection_start_snapshots) do return fail("GameObject.protection_start_snapshots") }
	if fv, found := get_any(v, "protection_start_exempt_attachments"); found { if !dec_dyn_t2_t3_int_int_ObjectId_ProtectionStartSnapshot(fv, &out.legacy_protection_start_exempt_attachments) do return fail("GameObject.legacy_protection_start_exempt_attachments") }
	if fv, found := get_any(v, "paired_with"); found { if !dec_opt_ObjectId(fv, &out.paired_with) do return fail("GameObject.paired_with") }
	if fv, found := get_any(v, "pair_controller"); found { if !dec_opt_PlayerId(fv, &out.pair_controller) do return fail("GameObject.pair_controller") }
	if fv, found := get_any(v, "counters"); found { if !decode_with_counter_map_serde(fv, &out.counters) do return fail("GameObject.counters") } else { return fail("GameObject.counters missing") }
	if fv, found := get_any(v, "intensity"); found { if !decode_u32(fv, &out.intensity) do return fail("GameObject.intensity") }
