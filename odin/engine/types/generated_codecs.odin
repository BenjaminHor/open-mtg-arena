	}; strings.write_byte(b, '}')
	case QuantityRef_DistinctCounterKindsAmong: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DistinctCounterKindsAmong")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case QuantityRef_VoteCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "VoteCount")
	member(b, first, "choice_index"); encode_u32(b, y.choice_index)
	}; strings.write_byte(b, '}')
	}
}

encode_QuantityRef_members :: proc(b: ^strings.Builder, x: QuantityRef, first: ^bool) {
	#partial switch y in x {
	case QuantityRef_HandSize: member(b, first, "type"); json.write_string(b, "HandSize")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case QuantityRef_LifeTotal: member(b, first, "type"); json.write_string(b, "LifeTotal")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case QuantityRef_GraveyardSize: member(b, first, "type"); json.write_string(b, "GraveyardSize")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case QuantityRef_LifeAboveStarting: _ = y; member(b, first, "type"); json.write_string(b, "LifeAboveStarting")
	case QuantityRef_StartingLifeTotal: member(b, first, "type"); json.write_string(b, "StartingLifeTotal")
	if !(skip_QuantityRef_is_player_scope_controller(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }

	case QuantityRef_StartingDeckSize: member(b, first, "type"); json.write_string(b, "StartingDeckSize")
	if !(skip_QuantityRef_is_player_scope_controller(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }

	case QuantityRef_TriggeringDiscoverValue: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringDiscoverValue")
	case QuantityRef_TriggeringScryLookCount: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringScryLookCount")
	case QuantityRef_TriggeringScryBottomCount: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringScryBottomCount")
	case QuantityRef_ObjectCount: member(b, first, "type"); json.write_string(b, "ObjectCount")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case QuantityRef_ObjectCountDistinct: member(b, first, "type"); json.write_string(b, "ObjectCountDistinct")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "qualities"); enc_dyn_SharedQuality(b, y.qualities)

	case QuantityRef_ObjectCountBySharedQuality: member(b, first, "type"); json.write_string(b, "ObjectCountBySharedQuality")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "quality"); encode_SharedQuality(b, y.quality)
	member(b, first, "aggregate"); encode_AggregateFunction(b, y.aggregate)

	case QuantityRef_PlayerCount: member(b, first, "type"); json.write_string(b, "PlayerCount")
	member(b, first, "filter"); encode_PlayerFilter(b, y.filter)

	case QuantityRef_CountersOn: member(b, first, "type"); json.write_string(b, "CountersOn")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)
	if !(y.counter_type == nil) { member(b, first, "counter_type"); enc_opt_CounterType(b, y.counter_type) }

	case QuantityRef_CountersOnObjects: member(b, first, "type"); json.write_string(b, "CountersOnObjects")
	if !(y.counter_type == nil) { member(b, first, "counter_type"); enc_opt_CounterType(b, y.counter_type) }
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case QuantityRef_PlayerCounter: member(b, first, "type"); json.write_string(b, "PlayerCounter")
	member(b, first, "kind"); encode_PlayerCounterKind(b, y.kind)
	member(b, first, "scope"); encode_CountScope(b, y.scope)

	case QuantityRef_TargetControllerCounter: member(b, first, "type"); json.write_string(b, "TargetControllerCounter")
	member(b, first, "kind"); encode_PlayerCounterKind(b, y.kind)

	case QuantityRef_Variable: member(b, first, "type"); json.write_string(b, "Variable")
	member(b, first, "name"); encode_string(b, y.name)

	case QuantityRef_Power: member(b, first, "type"); json.write_string(b, "Power")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)

	case QuantityRef_BasePower: member(b, first, "type"); json.write_string(b, "BasePower")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)

	case QuantityRef_Intensity: member(b, first, "type"); json.write_string(b, "Intensity")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)

	case QuantityRef_Toughness: member(b, first, "type"); json.write_string(b, "Toughness")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)

	case QuantityRef_ObjectManaValue: member(b, first, "type"); json.write_string(b, "ObjectManaValue")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)

	case QuantityRef_TargetObjectManaValue: member(b, first, "type"); json.write_string(b, "TargetObjectManaValue")
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)

	case QuantityRef_ObjectColorCount: member(b, first, "type"); json.write_string(b, "ObjectColorCount")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)

	case QuantityRef_ObjectNameWordCount: member(b, first, "type"); json.write_string(b, "ObjectNameWordCount")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)

	case QuantityRef_NameStickerLetterCount: member(b, first, "type"); json.write_string(b, "NameStickerLetterCount")
	member(b, first, "stickers"); encode_NameStickerSet(b, y.stickers)
	member(b, first, "letters"); encode_LetterQuery(b, y.letters)

	case QuantityRef_ObjectTypelineComponentCount: member(b, first, "type"); json.write_string(b, "ObjectTypelineComponentCount")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)

	case QuantityRef_ManaSymbolsInManaCost: member(b, first, "type"); json.write_string(b, "ManaSymbolsInManaCost")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)
	member(b, first, "color"); enc_opt_ManaColor(b, y.color)

	case QuantityRef_SelfManaValue: _ = y; member(b, first, "type"); json.write_string(b, "SelfManaValue")
	case QuantityRef_PropertyAggregate: member(b, first, "type"); json.write_string(b, "PropertyAggregate"); encode_PropertyAggregate_members(b, y._0, first)
	case QuantityRef_ControlledByEachPlayer: member(b, first, "type"); json.write_string(b, "ControlledByEachPlayer")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "aggregate"); encode_AggregateFunction(b, y.aggregate)
	if !(skip_QuantityRef_is_player_relation_all(y.relation)) { member(b, first, "relation"); encode_PlayerRelation(b, y.relation) }

	case QuantityRef_TargetZoneCardCount: member(b, first, "type"); json.write_string(b, "TargetZoneCardCount")
	member(b, first, "zone"); encode_ZoneRef(b, y.zone)
	if !(skip_QuantityRef_is_target_zone_count_scope_default(y.scope)) { member(b, first, "scope"); encode_ControllerRef(b, y.scope) }
	if !(skip_QuantityRef_is_count_binding_default(y.binding)) { member(b, first, "binding"); encode_CountBinding(b, y.binding) }

	case QuantityRef_Devotion: member(b, first, "type"); json.write_string(b, "Devotion")
	member(b, first, "colors"); encode_DevotionColors(b, y.colors)

	case QuantityRef_DistinctCardTypes: member(b, first, "type"); json.write_string(b, "DistinctCardTypes")
	member(b, first, "source"); encode_CardTypeSetSource(b, y.source)

	case QuantityRef_SharedCardTypes: member(b, first, "type"); json.write_string(b, "SharedCardTypes")
	member(b, first, "source"); encode_CardTypeSetSource(b, y.source)

	case QuantityRef_DistinctSubtypes: member(b, first, "type"); json.write_string(b, "DistinctSubtypes")
	member(b, first, "source"); encode_CardTypeSetSource(b, y.source)
	member(b, first, "exclude"); encode_SubtypeExclusion(b, y.exclude)
	if !(y.restrict == nil) { member(b, first, "restrict"); enc_opt_SubtypeSet(b, y.restrict) }

	case QuantityRef_CardsExiledBySource: _ = y; member(b, first, "type"); json.write_string(b, "CardsExiledBySource")
	case QuantityRef_DeployedBossCount: _ = y; member(b, first, "type"); json.write_string(b, "DeployedBossCount")
	case QuantityRef_ExiledCardPower: member(b, first, "type"); json.write_string(b, "ExiledCardPower")
	member(b, first, "index"); encode_u32(b, y.index)

	case QuantityRef_ZoneCardCount: member(b, first, "type"); json.write_string(b, "ZoneCardCount")
	member(b, first, "zone"); encode_ZoneRef(b, y.zone)
	member(b, first, "card_types"); enc_dyn_TypeFilter(b, y.card_types)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }
	member(b, first, "scope"); encode_CountScope(b, y.scope)

	case QuantityRef_BasicLandTypeCount: member(b, first, "type"); json.write_string(b, "BasicLandTypeCount")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)

	case QuantityRef_TrackedSetSize: _ = y; member(b, first, "type"); json.write_string(b, "TrackedSetSize")
	case QuantityRef_FilteredTrackedSetSize: member(b, first, "type"); json.write_string(b, "FilteredTrackedSetSize")
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)
	if !(y.caused_by == nil) { member(b, first, "caused_by"); enc_opt_ThisWayCause(b, y.caused_by) }
	if !(y.destination == nil) { member(b, first, "destination"); enc_opt_Zone(b, y.destination) }

	case QuantityRef_ExiledFromHandThisResolution: _ = y; member(b, first, "type"); json.write_string(b, "ExiledFromHandThisResolution")
	case QuantityRef_PreviousEffectAmount: member(b, first, "type"); json.write_string(b, "PreviousEffectAmount")
	if !(skip_QuantityRef_is_total_damage_channel(y.channel)) { member(b, first, "channel"); encode_DamageChannel(b, y.channel) }
	if !(skip_QuantityRef_is_sum_aggregate(y.aggregate)) { member(b, first, "aggregate"); encode_AggregateFunction(b, y.aggregate) }

	case QuantityRef_PreviousEffectCount: _ = y; member(b, first, "type"); json.write_string(b, "PreviousEffectCount")
	case QuantityRef_LifeLost: member(b, first, "type"); json.write_string(b, "LifeLost")
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	if !(skip_QuantityRef_TurnWindow_is_this_turn(y.window)) { member(b, first, "window"); encode_TurnWindow(b, y.window) }

	case QuantityRef_PartySize: member(b, first, "type"); json.write_string(b, "PartySize")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case QuantityRef_UnspentMana: member(b, first, "type"); json.write_string(b, "UnspentMana")
	member(b, first, "color"); enc_opt_ManaColor(b, y.color)

	case QuantityRef_Speed: member(b, first, "type"); json.write_string(b, "Speed")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case QuantityRef_EventContextAmount: _ = y; member(b, first, "type"); json.write_string(b, "EventContextAmount")
	case QuantityRef_EventContextPlayerCount: member(b, first, "type"); json.write_string(b, "EventContextPlayerCount")
	member(b, first, "filter"); encode_PlayerFilter(b, y.filter)

	case QuantityRef_AttachmentsOnLeavingObject: member(b, first, "type"); json.write_string(b, "AttachmentsOnLeavingObject")
	member(b, first, "kind"); encode_AttachmentKind(b, y.kind)
	if !(y.controller == nil) { member(b, first, "controller"); enc_opt_ControllerRef(b, y.controller) }

	case QuantityRef_EventContextSourceCostX: _ = y; member(b, first, "type"); json.write_string(b, "EventContextSourceCostX")
	case QuantityRef_EventContextSourceModesChosen: _ = y; member(b, first, "type"); json.write_string(b, "EventContextSourceModesChosen")
	case QuantityRef_SpellsCast: member(b, first, "type"); json.write_string(b, "SpellsCast")
	member(b, first, "scope"); encode_CountScope(b, y.scope)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }
	if !(skip_QuantityRef_TurnWindow_is_this_turn(y.window)) { member(b, first, "window"); encode_TurnWindow(b, y.window) }

	case QuantityRef_SpellsCastBeforeTriggeringSpell: member(b, first, "type"); json.write_string(b, "SpellsCastBeforeTriggeringSpell")
	member(b, first, "scope"); encode_CountScope(b, y.scope)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }

	case QuantityRef_EnteredThisTurn: member(b, first, "type"); json.write_string(b, "EnteredThisTurn")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case QuantityRef_SacrificedThisTurn: member(b, first, "type"); json.write_string(b, "SacrificedThisTurn")
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case QuantityRef_CrimesCommittedThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "CrimesCommittedThisTurn")
	case QuantityRef_EnergyPaidOrLostThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "EnergyPaidOrLostThisTurn")
	case QuantityRef_BendTypesThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "BendTypesThisTurn")
	case QuantityRef_LifeGainedThisTurn: member(b, first, "type"); json.write_string(b, "LifeGainedThisTurn")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case QuantityRef_CardsDrawnThisTurn: member(b, first, "type"); json.write_string(b, "CardsDrawnThisTurn")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case QuantityRef_CardsDrawnLastTurn: member(b, first, "type"); json.write_string(b, "CardsDrawnLastTurn")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case QuantityRef_OpponentSpellsCastSinceLastTurn: member(b, first, "type"); json.write_string(b, "OpponentSpellsCastSinceLastTurn")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case QuantityRef_BattlefieldEntriesThisTurn: member(b, first, "type"); json.write_string(b, "BattlefieldEntriesThisTurn")
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case QuantityRef_LandsPlayedThisTurn: member(b, first, "type"); json.write_string(b, "LandsPlayedThisTurn")
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	if !(y.from_zones == nil) { member(b, first, "from_zones"); enc_opt_dyn_Zone(b, y.from_zones) }

	case QuantityRef_TurnsTaken: _ = y; member(b, first, "type"); json.write_string(b, "TurnsTaken")
	case QuantityRef_ZoneChangeCountThisTurn: member(b, first, "type"); json.write_string(b, "ZoneChangeCountThisTurn")
	if !(y.from == nil) { member(b, first, "from"); enc_opt_Zone(b, y.from) }
	if !(y.to == nil) { member(b, first, "to"); enc_opt_Zone(b, y.to) }
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case QuantityRef_ZoneChangeAggregateThisTurn: member(b, first, "type"); json.write_string(b, "ZoneChangeAggregateThisTurn")
	if !(y.from == nil) { member(b, first, "from"); enc_opt_Zone(b, y.from) }
	if !(y.to == nil) { member(b, first, "to"); enc_opt_Zone(b, y.to) }
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "function"); encode_AggregateFunction(b, y.function)
	member(b, first, "property"); encode_ObjectProperty(b, y.property)

	case QuantityRef_DamageDealtThisTurn: member(b, first, "type"); json.write_string(b, "DamageDealtThisTurn")
	member(b, first, "source"); enc_ptr_TargetFilter(b, y.source)
	member(b, first, "target"); enc_ptr_TargetFilter(b, y.target)
	if !(skip_QuantityRef_is_sum_aggregate(y.aggregate)) { member(b, first, "aggregate"); encode_AggregateFunction(b, y.aggregate) }
	if !(y.group_by == nil) { member(b, first, "group_by"); enc_opt_DamageGroupKey(b, y.group_by) }
	if !(skip_QuantityRef_is_default_damage_kind(y.damage_kind)) { member(b, first, "damage_kind"); encode_DamageKindFilter(b, y.damage_kind) }
	if !(skip_QuantityRef_is_total_damage_channel(y.channel)) { member(b, first, "channel"); encode_DamageChannel(b, y.channel) }

	case QuantityRef_NotedNumber: _ = y; member(b, first, "type"); json.write_string(b, "NotedNumber")
	case QuantityRef_ChosenNumber: _ = y; member(b, first, "type"); json.write_string(b, "ChosenNumber")
	case QuantityRef_PlayerChosenNumber: member(b, first, "type"); json.write_string(b, "PlayerChosenNumber")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case QuantityRef_AttackedThisTurn: member(b, first, "type"); json.write_string(b, "AttackedThisTurn")
	member(b, first, "scope"); encode_CountScope(b, y.scope)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }

	case QuantityRef_DescendedThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "DescendedThisTurn")
	case QuantityRef_LoyaltyAbilitiesActivatedThisTurn: member(b, first, "type"); json.write_string(b, "LoyaltyAbilitiesActivatedThisTurn")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case QuantityRef_SpellsCastThisGame: member(b, first, "type"); json.write_string(b, "SpellsCastThisGame")
	member(b, first, "scope"); encode_CountScope(b, y.scope)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }

	case QuantityRef_CardsCycled: member(b, first, "type"); json.write_string(b, "CardsCycled")
	member(b, first, "scope"); encode_CountScope(b, y.scope)
	member(b, first, "window"); encode_CyclingHistoryWindow(b, y.window)
	if !(y.name == nil) { member(b, first, "name"); enc_opt_string(b, y.name) }

	case QuantityRef_CounterAddedThisTurn: member(b, first, "type"); json.write_string(b, "CounterAddedThisTurn")
	member(b, first, "actor"); encode_CountScope(b, y.actor)
	member(b, first, "counters"); encode_CounterMatch(b, y.counters)
	member(b, first, "target"); encode_TargetFilter(b, y.target)

	case QuantityRef_CardsDiscardedThisTurn: member(b, first, "type"); json.write_string(b, "CardsDiscardedThisTurn")
	member(b, first, "player"); encode_PlayerScope(b, y.player)

	case QuantityRef_TokensCreatedThisTurn: member(b, first, "type"); json.write_string(b, "TokensCreatedThisTurn")
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case QuantityRef_PlayerActionsThisTurn: member(b, first, "type"); json.write_string(b, "PlayerActionsThisTurn")
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	member(b, first, "action"); encode_PlayerActionKind(b, y.action)

	case QuantityRef_DungeonsCompleted: _ = y; member(b, first, "type"); json.write_string(b, "DungeonsCompleted")
	case QuantityRef_CostXPaid: _ = y; member(b, first, "type"); json.write_string(b, "CostXPaid")
	case QuantityRef_KickerCount: _ = y; member(b, first, "type"); json.write_string(b, "KickerCount")
	case QuantityRef_AdditionalCostPaymentCount: _ = y; member(b, first, "type"); json.write_string(b, "AdditionalCostPaymentCount")
	case QuantityRef_AdditionalCostPaymentCountFor: member(b, first, "type"); json.write_string(b, "AdditionalCostPaymentCountFor")
	member(b, first, "origin"); encode_AdditionalCostOrigin(b, y.origin)
	if !(y.origin_ordinal == nil) { member(b, first, "origin_ordinal"); enc_opt_u32(b, y.origin_ordinal) }

	case QuantityRef_ConvokedCreatureCount: _ = y; member(b, first, "type"); json.write_string(b, "ConvokedCreatureCount")
	case QuantityRef_TimesCostPaidThisResolution: _ = y; member(b, first, "type"); json.write_string(b, "TimesCostPaidThisResolution")
	case QuantityRef_ManaSpentToCast: member(b, first, "type"); json.write_string(b, "ManaSpentToCast")
	member(b, first, "scope"); encode_CastManaObjectScope(b, y.scope)
	member(b, first, "metric"); encode_CastManaSpentMetric(b, y.metric)

	case QuantityRef_ColorsInCommandersColorIdentity: _ = y; member(b, first, "type"); json.write_string(b, "ColorsInCommandersColorIdentity")
	case QuantityRef_CommanderCastFromCommandZoneCount: _ = y; member(b, first, "type"); json.write_string(b, "CommanderCastFromCommandZoneCount")
	case QuantityRef_CommanderManaValue: member(b, first, "type"); json.write_string(b, "CommanderManaValue")
	member(b, first, "owner"); encode_ControllerRef(b, y.owner)

	case QuantityRef_DistinctColorsAmong: member(b, first, "type"); json.write_string(b, "DistinctColorsAmong")
	member(b, first, "source"); encode_CardTypeSetSource(b, y.source)

	case QuantityRef_DistinctCounterKindsAmong: member(b, first, "type"); json.write_string(b, "DistinctCounterKindsAmong")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case QuantityRef_VoteCount: member(b, first, "type"); json.write_string(b, "VoteCount")
	member(b, first, "choice_index"); encode_u32(b, y.choice_index)

	}
}

decode_RoundingMode :: proc(v: json.Value, out: ^RoundingMode) -> bool {
	if v.kind != .String do return fail("RoundingMode: not a string")
	str := v.text
	switch str {
	case "Up": out^ = .Up
	case "Down": out^ = .Down
	case: return fail("RoundingMode: unknown variant")
	}
	return true
}

encode_RoundingMode :: proc(b: ^strings.Builder, x: RoundingMode) {
	@(static, rodata) NAMES := [RoundingMode]string{
		.Up = "Up",
		.Down = "Down",
	}
	json.write_string(b, NAMES[x])
}

decode_SourceExclusion :: proc(v: json.Value, out: ^SourceExclusion) -> bool {
	if v.kind != .String do return fail("SourceExclusion: not a string")
	str := v.text
	switch str {
	case "Include": out^ = .Include
	case "Exclude": out^ = .Exclude
	case: return fail("SourceExclusion: unknown variant")
	}
	return true
}

encode_SourceExclusion :: proc(b: ^strings.Builder, x: SourceExclusion) {
	@(static, rodata) NAMES := [SourceExclusion]string{
		.Include = "Include",
		.Exclude = "Exclude",
	}
	json.write_string(b, NAMES[x])
}

decode_StackAbilityKind :: proc(v: json.Value, out: ^StackAbilityKind) -> bool {
	if v.kind != .String do return fail("StackAbilityKind: not a string")
	str := v.text
	switch str {
	case "Activated": out^ = .Activated
	case "Triggered": out^ = .Triggered
	case: return fail("StackAbilityKind: unknown variant")
	}
	return true
}

encode_StackAbilityKind :: proc(b: ^strings.Builder, x: StackAbilityKind) {
	@(static, rodata) NAMES := [StackAbilityKind]string{
		.Activated = "Activated",
		.Triggered = "Triggered",
	}
	json.write_string(b, NAMES[x])
}

decode_SeatDirection :: proc(v: json.Value, out: ^SeatDirection) -> bool {
	if v.kind != .Object do return fail("SeatDirection: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("SeatDirection: no tag")
	str := tv.text
	switch str {
	case "Left": out^ = .Left
	case "Right": out^ = .Right
	case: return fail("SeatDirection: unknown variant")
	}
	return true
}

encode_SeatDirection :: proc(b: ^strings.Builder, x: SeatDirection) {
	strings.write_byte(b, '{')
	f := true
	encode_SeatDirection_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_SeatDirection_members :: proc(b: ^strings.Builder, x: SeatDirection, first: ^bool) {
	_ = x
	@(static, rodata) NAMES := [SeatDirection]string{
		.Left = "Left",
		.Right = "Right",
	}
	member(b, first, "type"); json.write_string(b, NAMES[x])
}

decode_TrackedSetId :: proc(v: json.Value, out: ^TrackedSetId) -> bool {
	return decode_u64(v, cast(^u64)out)
}

encode_TrackedSetId :: proc(b: ^strings.Builder, x: TrackedSetId) {
	encode_u64(b, cast(u64)x)
}

decode_ThisWayCause :: proc(v: json.Value, out: ^ThisWayCause) -> bool {
	if v.kind != .String do return fail("ThisWayCause: not a string")
	str := v.text
	switch str {
	case "OwnerLibraryShuffleSubject": out^ = .OwnerLibraryShuffleSubject
	case "Exiled": out^ = .Exiled
	case "Sacrificed": out^ = .Sacrificed
	case "Destroyed": out^ = .Destroyed
	case "Milled": out^ = .Milled
	case "Discarded": out^ = .Discarded
	case "Tapped": out^ = .Tapped
	case "Returned": out^ = .Returned
	case "Bounced": out^ = .Bounced
	case "PutIntoGraveyard": out^ = .PutIntoGraveyard
	case "ControlGained": out^ = .ControlGained
	case: return fail("ThisWayCause: unknown variant")
	}
	return true
}

encode_ThisWayCause :: proc(b: ^strings.Builder, x: ThisWayCause) {
	@(static, rodata) NAMES := [ThisWayCause]string{
		.OwnerLibraryShuffleSubject = "OwnerLibraryShuffleSubject",
		.Exiled = "Exiled",
		.Sacrificed = "Sacrificed",
		.Destroyed = "Destroyed",
		.Milled = "Milled",
		.Discarded = "Discarded",
		.Tapped = "Tapped",
		.Returned = "Returned",
		.Bounced = "Bounced",
		.PutIntoGraveyard = "PutIntoGraveyard",
		.ControlGained = "ControlGained",
	}
	json.write_string(b, NAMES[x])
}

