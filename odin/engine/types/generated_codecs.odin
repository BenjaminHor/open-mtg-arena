decode_RecordedAction :: proc(v: json.Value, out: ^RecordedAction) -> bool {
	when COVERAGE do cov_hit("RecordedAction")
	if v.kind != .Object do return fail("RecordedAction: not an object")
	if fv, found := get_any(v, "seq"); found { if !decode_u32(fv, &out.seq) do return fail("RecordedAction.seq") } else { return fail("RecordedAction.seq missing") }
	if fv, found := get_any(v, "actor"); found { if !decode_PlayerId(fv, &out.actor) do return fail("RecordedAction.actor") } else { return fail("RecordedAction.actor missing") }
	if fv, found := get_any(v, "action"); found { if !decode_GameAction(fv, &out.action) do return fail("RecordedAction.action") } else { return fail("RecordedAction.action missing") }
	if fv, found := get_any(v, "kind"); found { if !decode_RecordedActionKind(fv, &out.kind) do return fail("RecordedAction.kind") } else { out.kind = RecordedActionKind(RecordedActionKind_Submitted{}) }
	return true
}

encode_RecordedAction :: proc(b: ^strings.Builder, x: RecordedAction) {
	strings.write_byte(b, '{')
	f := true
	encode_RecordedAction_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_RecordedAction_members :: proc(b: ^strings.Builder, x: RecordedAction, first: ^bool) {
