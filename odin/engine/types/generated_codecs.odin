	case DebugAction_LoseLife: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "LoseLife"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "amount"); encode_u32(b, y.amount)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_ModifyPlayerCounters: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ModifyPlayerCounters"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "counter_kind"); encode_PlayerCounterKind(b, y.counter_kind)
	member(b, first, "delta"); encode_i32(b, y.delta)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_ModifyEnergy: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ModifyEnergy"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "delta"); encode_i32(b, y.delta)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_GivePlayerCounters: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "GivePlayerCounters"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "counter_kind"); encode_PlayerCounterKind(b, y.counter_kind)
