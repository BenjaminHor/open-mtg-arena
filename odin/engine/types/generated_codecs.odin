encode_PendingCombatDamageReplacement_members :: proc(b: ^strings.Builder, x: PendingCombatDamageReplacement, first: ^bool) {
	member(b, first, "entries"); enc_dyn_PendingCombatDamageEntry(b, x.entries)
	member(b, first, "resolved"); enc_dyn_PendingCombatLegProgress(b, x.resolved)
	if !((len(x.one_shot_applications) == 0)) { member(b, first, "one_shot_applications"); enc_dyn_t2_AppliedReplacementKey_ObjectId(b, x.one_shot_applications) }
	if !((len(x.settled_guards) == 0)) { member(b, first, "settled_guards"); enc_dyn_SettledDamageGuard(b, x.settled_guards) }
}

