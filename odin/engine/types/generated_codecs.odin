	if fv, found := get_any(v, "expiry"); found { if !decode_WheneverEventExpiry(fv, &out.expiry) do return fail("DelayedTriggerCondition::WheneverEvent.expiry") } else { out.expiry = WheneverEventExpiry(WheneverEventExpiry_EndOfTurn{}) }
	return true
		}) { return fail("DelayedTriggerCondition::WheneverEvent") }
		out^ = tmp
	case "WhenNextEvent": when COVERAGE do cov_hit("DelayedTriggerCondition::WhenNextEvent");
		tmp: DelayedTriggerCondition_WhenNextEvent
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DelayedTriggerCondition_WhenNextEvent) -> bool {
	if fv, found := get_any(v, "trigger"); found { if !dec_ptr_TriggerDefinition(fv, &out.trigger) do return fail("DelayedTriggerCondition::WhenNextEvent.trigger") } else { return fail("DelayedTriggerCondition::WhenNextEvent.trigger missing") }
	if fv, found := get_any(v, "or_trigger"); found { if !dec_ptr_TriggerDefinition(fv, &out.or_trigger) do return fail("DelayedTriggerCondition::WhenNextEvent.or_trigger") }
	if fv, found := get_any(v, "lifetime"); found { if !decode_DelayedTriggerLifetime(fv, &out.lifetime) do return fail("DelayedTriggerCondition::WhenNextEvent.lifetime") }
	return true
		}) { return fail("DelayedTriggerCondition::WhenNextEvent") }
		out^ = tmp
	case: return fail("DelayedTriggerCondition: unknown variant")
