decode_ActivationCostLock :: proc(v: json.Value, out: ^ActivationCostLock) -> bool {
	when COVERAGE do cov_hit("ActivationCostLock")
	if v.kind != .Object do return fail("ActivationCostLock: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ActivationCostLock: no tag")
	switch tv.text {
	case "Open": when COVERAGE do cov_hit("ActivationCostLock::Open");
		tmp: ActivationCostLock_Open
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^ActivationCostLock_Open) -> bool {
	if fv, found := get_any(v, "point"); found { if !decode_ActivationCostLockPoint(fv, &out.point) do return fail("ActivationCostLock::Open.point") }
	return true
		}) { return fail("ActivationCostLock::Open") }
		out^ = tmp
	case "Locked": when COVERAGE do cov_hit("ActivationCostLock::Locked");
		tmp: ActivationCostLock_Locked
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^ActivationCostLock_Locked) -> bool {
	if fv, found := get_any(v, "point"); found { if !decode_ActivationCostLockPoint(fv, &out.point) do return fail("ActivationCostLock::Locked.point") }
	if fv, found := get_any(v, "order"); found { if !dec_opt_dyn_ReductionProvenance(fv, &out.order) do return fail("ActivationCostLock::Locked.order") }
	return true
		}) { return fail("ActivationCostLock::Locked") }
		out^ = tmp
	case: return fail("ActivationCostLock: unknown variant")
	}
	return true
}

encode_ActivationCostLock :: proc(b: ^strings.Builder, x: ActivationCostLock) {
	#partial switch y in x {
	case ActivationCostLock_Open: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Open"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "point"); encode_ActivationCostLockPoint(b, y.point)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ActivationCostLock_Locked: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Locked"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "point"); encode_ActivationCostLockPoint(b, y.point)
	if !(y.order == nil) { member(b, first, "order"); enc_opt_dyn_ReductionProvenance(b, y.order) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

