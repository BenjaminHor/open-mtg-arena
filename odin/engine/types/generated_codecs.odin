decode_LogicalZoneChangeTerminalOutcome :: proc(v: json.Value, out: ^LogicalZoneChangeTerminalOutcome) -> bool {
	when COVERAGE do cov_hit("LogicalZoneChangeTerminalOutcome")
	if v.kind != .Object do return fail("LogicalZoneChangeTerminalOutcome: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("LogicalZoneChangeTerminalOutcome: no tag")
	switch tv.text {
	case "pending": when COVERAGE do cov_hit("LogicalZoneChangeTerminalOutcome::pending"); out^ = LogicalZoneChangeTerminalOutcome_Pending{}
	case "prevented": when COVERAGE do cov_hit("LogicalZoneChangeTerminalOutcome::prevented"); out^ = LogicalZoneChangeTerminalOutcome_Prevented{}
	case "remained": when COVERAGE do cov_hit("LogicalZoneChangeTerminalOutcome::remained"); out^ = LogicalZoneChangeTerminalOutcome_Remained{}
	case "moved": when COVERAGE do cov_hit("LogicalZoneChangeTerminalOutcome::moved");
		tmp: LogicalZoneChangeTerminalOutcome_Moved
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^LogicalZoneChangeTerminalOutcome_Moved) -> bool {
	if fv, found := get_any(v, "occurrence_ordinal"); found { if !decode_int(fv, &out.occurrence_ordinal) do return fail("LogicalZoneChangeTerminalOutcome::Moved.occurrence_ordinal") } else { return fail("LogicalZoneChangeTerminalOutcome::Moved.occurrence_ordinal missing") }
	return true
		}) { return fail("LogicalZoneChangeTerminalOutcome::Moved") }
		out^ = tmp
	case "abandoned_by_player_left": when COVERAGE do cov_hit("LogicalZoneChangeTerminalOutcome::abandoned_by_player_left"); out^ = LogicalZoneChangeTerminalOutcome_AbandonedByPlayerLeft{}
	case "preempted": when COVERAGE do cov_hit("LogicalZoneChangeTerminalOutcome::preempted"); out^ = LogicalZoneChangeTerminalOutcome_Preempted{}
	case: return fail("LogicalZoneChangeTerminalOutcome: unknown variant")
	}
	return true
}

encode_LogicalZoneChangeTerminalOutcome :: proc(b: ^strings.Builder, x: LogicalZoneChangeTerminalOutcome) {
	#partial switch y in x {
	case LogicalZoneChangeTerminalOutcome_Pending: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "pending"); strings.write_byte(b, '}')
	case LogicalZoneChangeTerminalOutcome_Prevented: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "prevented"); strings.write_byte(b, '}')
	case LogicalZoneChangeTerminalOutcome_Remained: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "remained"); strings.write_byte(b, '}')
	case LogicalZoneChangeTerminalOutcome_Moved: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "moved"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "occurrence_ordinal"); encode_int(b, y.occurrence_ordinal)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case LogicalZoneChangeTerminalOutcome_AbandonedByPlayerLeft: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "abandoned_by_player_left"); strings.write_byte(b, '}')
	case LogicalZoneChangeTerminalOutcome_Preempted: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "preempted"); strings.write_byte(b, '}')
	}
}

