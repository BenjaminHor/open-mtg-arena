decode_ZoneChangeClause :: proc(v: json.Value, out: ^ZoneChangeClause) -> bool {
	when COVERAGE do cov_hit("ZoneChangeClause")
	if v.kind != .Object do return fail("ZoneChangeClause: not an object")
	if fv, found := get_any(v, "origin"); found { if !decode_OriginConstraint(fv, &out.origin) do return fail("ZoneChangeClause.origin") } else { return fail("ZoneChangeClause.origin missing") }
	if fv, found := get_any(v, "destination"); found { if !dec_opt_Zone(fv, &out.destination) do return fail("ZoneChangeClause.destination") }
	if fv, found := get_any(v, "destination_constraint"); found { if !decode_OriginConstraint(fv, &out.destination_constraint) do return fail("ZoneChangeClause.destination_constraint") } else { out.destination_constraint = default_ZoneChangeClause_OriginConstraint_any_default() }
	if fv, found := get_any(v, "valid_card"); found { if !dec_opt_TargetFilter(fv, &out.valid_card) do return fail("ZoneChangeClause.valid_card") }
	return true
}

encode_ZoneChangeClause :: proc(b: ^strings.Builder, x: ZoneChangeClause) {
	strings.write_byte(b, '{')
	f := true
	encode_ZoneChangeClause_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ZoneChangeClause_members :: proc(b: ^strings.Builder, x: ZoneChangeClause, first: ^bool) {
	member(b, first, "origin"); encode_OriginConstraint(b, x.origin)
	if !(x.destination == nil) { member(b, first, "destination"); enc_opt_Zone(b, x.destination) }
	if !(skip_ZoneChangeClause_OriginConstraint_is_any_OriginConstraint(x.destination_constraint)) { member(b, first, "destination_constraint"); encode_OriginConstraint(b, x.destination_constraint) }
	if !(x.valid_card == nil) { member(b, first, "valid_card"); enc_opt_TargetFilter(b, x.valid_card) }
}

decode_OriginConstraint :: proc(v: json.Value, out: ^OriginConstraint) -> bool {
	when COVERAGE do cov_hit("OriginConstraint")
	if v.kind != .Object do return fail("OriginConstraint: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("OriginConstraint: no tag")
	switch tv.text {
	case "Any": when COVERAGE do cov_hit("OriginConstraint::Any"); out^ = OriginConstraint_Any{}
	case "Equals": when COVERAGE do cov_hit("OriginConstraint::Equals"); tmp: OriginConstraint_Equals; if !decode_Zone(json.get_or_null(v, "data"), &tmp._0) do return fail("OriginConstraint::Equals"); out^ = tmp
	case "NotEquals": when COVERAGE do cov_hit("OriginConstraint::NotEquals"); tmp: OriginConstraint_NotEquals; if !decode_Zone(json.get_or_null(v, "data"), &tmp._0) do return fail("OriginConstraint::NotEquals"); out^ = tmp
	case "OneOf": when COVERAGE do cov_hit("OriginConstraint::OneOf"); tmp: OriginConstraint_OneOf; if !dec_dyn_Zone(json.get_or_null(v, "data"), &tmp._0) do return fail("OriginConstraint::OneOf"); out^ = tmp
	case: return fail("OriginConstraint: unknown variant")
	}
	return true
}

encode_OriginConstraint :: proc(b: ^strings.Builder, x: OriginConstraint) {
	#partial switch y in x {
	case OriginConstraint_Any: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Any"); strings.write_byte(b, '}')
	case OriginConstraint_Equals: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Equals"); member(b, &f, "data"); encode_Zone(b, y._0); strings.write_byte(b, '}')
	case OriginConstraint_NotEquals: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NotEquals"); member(b, &f, "data"); encode_Zone(b, y._0); strings.write_byte(b, '}')
	case OriginConstraint_OneOf: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OneOf"); member(b, &f, "data"); enc_dyn_Zone(b, y._0); strings.write_byte(b, '}')
	}
}

decode_TriggerConstraint :: proc(v: json.Value, out: ^TriggerConstraint) -> bool {
	when COVERAGE do cov_hit("TriggerConstraint")
	if v.kind != .Object do return fail("TriggerConstraint: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("TriggerConstraint: no tag")
	switch tv.text {
	case "OncePerTurn": when COVERAGE do cov_hit("TriggerConstraint::OncePerTurn");
		tmp: TriggerConstraint_OncePerTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerConstraint_OncePerTurn) -> bool {
	if fv, found := get_any(v, "spent_by"); found { if !decode_TriggerLimitSpend(fv, &out.spent_by) do return fail("TriggerConstraint::OncePerTurn.spent_by") }
	return true
		}) { return fail("TriggerConstraint::OncePerTurn") }
		out^ = tmp
	case "OncePerGame": when COVERAGE do cov_hit("TriggerConstraint::OncePerGame"); out^ = TriggerConstraint_OncePerGame{}
	case "OnlyDuringYourTurn": when COVERAGE do cov_hit("TriggerConstraint::OnlyDuringYourTurn"); out^ = TriggerConstraint_OnlyDuringYourTurn{}
	case "NthSpellThisTurn": when COVERAGE do cov_hit("TriggerConstraint::NthSpellThisTurn");
		tmp: TriggerConstraint_NthSpellThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerConstraint_NthSpellThisTurn) -> bool {
	if fv, found := get_any(v, "n"); found { if !decode_u32(fv, &out.n) do return fail("TriggerConstraint::NthSpellThisTurn.n") } else { return fail("TriggerConstraint::NthSpellThisTurn.n missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("TriggerConstraint::NthSpellThisTurn.comparator") } else { out.comparator = default_TriggerConstraint_default_exact_ordinal_comparator() }
	if fv, found := get_any(v, "filter"); found { if !dec_opt_TargetFilter(fv, &out.filter) do return fail("TriggerConstraint::NthSpellThisTurn.filter") }
	return true
		}) { return fail("TriggerConstraint::NthSpellThisTurn") }
		out^ = tmp
	case "NthDrawThisTurn": when COVERAGE do cov_hit("TriggerConstraint::NthDrawThisTurn");
		tmp: TriggerConstraint_NthDrawThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerConstraint_NthDrawThisTurn) -> bool {
	if fv, found := get_any(v, "n"); found { if !decode_u32(fv, &out.n) do return fail("TriggerConstraint::NthDrawThisTurn.n") } else { return fail("TriggerConstraint::NthDrawThisTurn.n missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("TriggerConstraint::NthDrawThisTurn.comparator") } else { out.comparator = default_TriggerConstraint_default_exact_ordinal_comparator() }
	return true
		}) { return fail("TriggerConstraint::NthDrawThisTurn") }
		out^ = tmp
	case "OnlyDuringOpponentsTurn": when COVERAGE do cov_hit("TriggerConstraint::OnlyDuringOpponentsTurn"); out^ = TriggerConstraint_OnlyDuringOpponentsTurn{}
	case "OnlyDuringYourMainPhase": when COVERAGE do cov_hit("TriggerConstraint::OnlyDuringYourMainPhase"); out^ = TriggerConstraint_OnlyDuringYourMainPhase{}
	case "AtClassLevel": when COVERAGE do cov_hit("TriggerConstraint::AtClassLevel");
		tmp: TriggerConstraint_AtClassLevel
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerConstraint_AtClassLevel) -> bool {
	if fv, found := get_any(v, "level"); found { if !decode_u8(fv, &out.level) do return fail("TriggerConstraint::AtClassLevel.level") } else { return fail("TriggerConstraint::AtClassLevel.level missing") }
	return true
		}) { return fail("TriggerConstraint::AtClassLevel") }
		out^ = tmp
	case "MaxTimesPerTurn": when COVERAGE do cov_hit("TriggerConstraint::MaxTimesPerTurn");
		tmp: TriggerConstraint_MaxTimesPerTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerConstraint_MaxTimesPerTurn) -> bool {
	if fv, found := get_any(v, "max"); found { if !decode_u32(fv, &out.max) do return fail("TriggerConstraint::MaxTimesPerTurn.max") } else { return fail("TriggerConstraint::MaxTimesPerTurn.max missing") }
	return true
		}) { return fail("TriggerConstraint::MaxTimesPerTurn") }
		out^ = tmp
	case "OncePerOpponentPerTurn": when COVERAGE do cov_hit("TriggerConstraint::OncePerOpponentPerTurn"); out^ = TriggerConstraint_OncePerOpponentPerTurn{}
	case "EventSourceControlledBy": when COVERAGE do cov_hit("TriggerConstraint::EventSourceControlledBy");
		tmp: TriggerConstraint_EventSourceControlledBy
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerConstraint_EventSourceControlledBy) -> bool {
	if fv, found := get_any(v, "controller"); found { if !decode_ControllerRef(fv, &out.controller) do return fail("TriggerConstraint::EventSourceControlledBy.controller") } else { return fail("TriggerConstraint::EventSourceControlledBy.controller missing") }
	return true
		}) { return fail("TriggerConstraint::EventSourceControlledBy") }
		out^ = tmp
	case: return fail("TriggerConstraint: unknown variant")
	}
	return true
}

encode_TriggerConstraint :: proc(b: ^strings.Builder, x: TriggerConstraint) {
	#partial switch y in x {
	case TriggerConstraint_OncePerTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "OncePerTurn")
	if !(skip_TriggerConstraint_TriggerLimitSpend_is_triggering_TriggerLimitSpend(y.spent_by)) { member(b, first, "spent_by"); encode_TriggerLimitSpend(b, y.spent_by) }
	}; strings.write_byte(b, '}')
	case TriggerConstraint_OncePerGame: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OncePerGame"); strings.write_byte(b, '}')
	case TriggerConstraint_OnlyDuringYourTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OnlyDuringYourTurn"); strings.write_byte(b, '}')
	case TriggerConstraint_NthSpellThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "NthSpellThisTurn")
	member(b, first, "n"); encode_u32(b, y.n)
	if !(skip_TriggerConstraint_is_default_exact_ordinal_comparator_Comparator(y.comparator)) { member(b, first, "comparator"); encode_Comparator(b, y.comparator) }
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }
	}; strings.write_byte(b, '}')
	case TriggerConstraint_NthDrawThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "NthDrawThisTurn")
	member(b, first, "n"); encode_u32(b, y.n)
	if !(skip_TriggerConstraint_is_default_exact_ordinal_comparator_Comparator(y.comparator)) { member(b, first, "comparator"); encode_Comparator(b, y.comparator) }
	}; strings.write_byte(b, '}')
	case TriggerConstraint_OnlyDuringOpponentsTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OnlyDuringOpponentsTurn"); strings.write_byte(b, '}')
	case TriggerConstraint_OnlyDuringYourMainPhase: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OnlyDuringYourMainPhase"); strings.write_byte(b, '}')
	case TriggerConstraint_AtClassLevel: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AtClassLevel")
	member(b, first, "level"); encode_u8(b, y.level)
	}; strings.write_byte(b, '}')
	case TriggerConstraint_MaxTimesPerTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "MaxTimesPerTurn")
	member(b, first, "max"); encode_u32(b, y.max)
	}; strings.write_byte(b, '}')
	case TriggerConstraint_OncePerOpponentPerTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OncePerOpponentPerTurn"); strings.write_byte(b, '}')
