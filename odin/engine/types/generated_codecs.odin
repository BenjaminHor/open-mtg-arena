	return true
}

encode_GameObject :: proc(b: ^strings.Builder, x: GameObject) {
	strings.write_byte(b, '{')
	f := true
	encode_GameObject_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_GameObject_members :: proc(b: ^strings.Builder, x: GameObject, first: ^bool) {
	member(b, first, "id"); encode_ObjectId(b, x.id)
	member(b, first, "card_id"); encode_CardId(b, x.card_id)
	member(b, first, "owner"); encode_PlayerId(b, x.owner)
	if !(x.base_controller == nil) { member(b, first, "base_controller"); enc_opt_PlayerId(b, x.base_controller) }
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	member(b, first, "zone"); encode_Zone(b, x.zone)
	if !(!x.display_visible_to_viewer) { member(b, first, "display_visible_to_viewer"); encode_bool(b, x.display_visible_to_viewer) }
