}

encode_ReplacementSubtreeBoundary_members :: proc(b: ^strings.Builder, x: ReplacementSubtreeBoundary, first: ^bool) {
	member(b, first, "resolution_depth"); encode_int(b, x.resolution_depth)
	member(b, first, "enclosing"); enc_opt_EnclosingPostReplacementFrame(b, x.enclosing)
}

