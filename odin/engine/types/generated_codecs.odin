decode_AttachSelection :: proc(v: json.Value, out: ^AttachSelection) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("AttachSelection: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("AttachSelection: not a string or object")
	}
	switch variant {
	case "targeted": out^ = AttachSelection_Targeted{}
	case "at_resolution":
		tmp: AttachSelection_AtResolution
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^AttachSelection_AtResolution) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_AttachCardinality(fv, &out.count) do return fail("AttachSelection::AtResolution.count") } else { out.count = AttachCardinality(AttachCardinality_One{}) }
	return true
		}) { return fail("AttachSelection::AtResolution") }
		out^ = tmp
	case: return fail("AttachSelection: unknown variant")
	}
	return true
}

encode_AttachSelection :: proc(b: ^strings.Builder, x: AttachSelection) {
	#partial switch y in x {
	case AttachSelection_Targeted: _ = y; json.write_string(b, "targeted")
	case AttachSelection_AtResolution: strings.write_byte(b, '{'); json.write_string(b, "at_resolution"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	if !(skip_AttachSelection_AttachCardinality_is_one(y.count)) { member(b, first, "count"); encode_AttachCardinality(b, y.count) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

