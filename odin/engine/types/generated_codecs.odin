	switch str {
	case "Game": when COVERAGE do cov_hit("LogCategory::Game"); out^ = .Game
	case "Turn": when COVERAGE do cov_hit("LogCategory::Turn"); out^ = .Turn
	case "Stack": when COVERAGE do cov_hit("LogCategory::Stack"); out^ = .Stack
	case "Combat": when COVERAGE do cov_hit("LogCategory::Combat"); out^ = .Combat
	case "Zone": when COVERAGE do cov_hit("LogCategory::Zone"); out^ = .Zone
	case "Life": when COVERAGE do cov_hit("LogCategory::Life"); out^ = .Life
