	case ContinuousModification_AddType: member(b, first, "type"); json.write_string(b, "AddType")
	member(b, first, "core_type"); encode_CoreType(b, y.core_type)

	case ContinuousModification_RemoveType: member(b, first, "type"); json.write_string(b, "RemoveType")
	member(b, first, "core_type"); encode_CoreType(b, y.core_type)

	case ContinuousModification_AddSubtype: member(b, first, "type"); json.write_string(b, "AddSubtype")
	member(b, first, "subtype"); encode_string(b, y.subtype)

	case ContinuousModification_RemoveSubtype: member(b, first, "type"); json.write_string(b, "RemoveSubtype")
	member(b, first, "subtype"); encode_string(b, y.subtype)

	case ContinuousModification_SetCardTypes: member(b, first, "type"); json.write_string(b, "SetCardTypes")
	member(b, first, "core_types"); enc_dyn_CoreType(b, y.core_types)

	case ContinuousModification_RemoveAllSubtypes: member(b, first, "type"); json.write_string(b, "RemoveAllSubtypes")
	member(b, first, "set"); encode_SubtypeSet(b, y.set)

	case ContinuousModification_SetDynamicPower: member(b, first, "type"); json.write_string(b, "SetDynamicPower")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)

	case ContinuousModification_SetDynamicToughness: member(b, first, "type"); json.write_string(b, "SetDynamicToughness")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)

	case ContinuousModification_SetPowerDynamic: member(b, first, "type"); json.write_string(b, "SetPowerDynamic")
