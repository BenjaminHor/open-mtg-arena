decode_LibraryInstructionActor :: proc(v: json.Value, out: ^LibraryInstructionActor) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("LibraryInstructionActor: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("LibraryInstructionActor: not a string or object")
	}
	switch variant {
	case "Controller": out^ = LibraryInstructionActor_Controller{}
	case "LibraryPlayer": out^ = LibraryInstructionActor_LibraryPlayer{}
	case "Player":
		tmp: LibraryInstructionActor_Player
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^LibraryInstructionActor_Player) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_TargetFilter(fv, &out.player) do return fail("LibraryInstructionActor::Player.player") } else { return fail("LibraryInstructionActor::Player.player missing") }
	return true
		}) { return fail("LibraryInstructionActor::Player") }
		out^ = tmp
	case: return fail("LibraryInstructionActor: unknown variant")
	}
	return true
}

encode_LibraryInstructionActor :: proc(b: ^strings.Builder, x: LibraryInstructionActor) {
	#partial switch y in x {
	case LibraryInstructionActor_Controller: _ = y; json.write_string(b, "Controller")
	case LibraryInstructionActor_LibraryPlayer: _ = y; json.write_string(b, "LibraryPlayer")
	case LibraryInstructionActor_Player: strings.write_byte(b, '{'); json.write_string(b, "Player"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_TargetFilter(b, y.player)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

