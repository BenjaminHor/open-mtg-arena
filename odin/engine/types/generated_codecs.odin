encode_Keyword :: proc(b: ^strings.Builder, x: Keyword) {
	#partial switch y in x {
	case Keyword_Flying: _ = y; json.write_string(b, "Flying")
	case Keyword_FirstStrike: _ = y; json.write_string(b, "FirstStrike")
	case Keyword_DoubleStrike: _ = y; json.write_string(b, "DoubleStrike")
	case Keyword_Trample: _ = y; json.write_string(b, "Trample")
	case Keyword_TrampleOverPlaneswalkers: _ = y; json.write_string(b, "TrampleOverPlaneswalkers")
	case Keyword_Deathtouch: _ = y; json.write_string(b, "Deathtouch")
	case Keyword_Lifelink: _ = y; json.write_string(b, "Lifelink")
	case Keyword_Vigilance: _ = y; json.write_string(b, "Vigilance")
