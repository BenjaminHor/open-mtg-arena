	member(b, first, "destination"); encode_Zone(b, y.destination)
	member(b, first, "enter_tapped"); encode_with_etb_tap_bool_compat(b, y.enter_tapped)
	}; strings.write_byte(b, '}')
	case Effect_SetLifeTotal: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetLifeTotal")
