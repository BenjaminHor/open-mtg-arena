decode_TriggerSourceContext :: proc(v: json.Value, out: ^TriggerSourceContext) -> bool {
	when COVERAGE do cov_hit("TriggerSourceContext")
	if v.kind != .Object do return fail("TriggerSourceContext: not an object")
	if fv, found := get_any(v, "identity"); found { if !decode_ObjectIdentityBinding(fv, &out.identity) do return fail("TriggerSourceContext.identity") } else { return fail("TriggerSourceContext.identity missing") }
	if fv, found := get_any(v, "lki"); found { if !decode_LKISnapshot(fv, &out.lki) do return fail("TriggerSourceContext.lki") } else { return fail("TriggerSourceContext.lki missing") }
	if fv, found := get_any(v, "card_id"); found { if !decode_CardId(fv, &out.card_id) do return fail("TriggerSourceContext.card_id") } else { return fail("TriggerSourceContext.card_id missing") }
	if fv, found := get_any(v, "printed_ref"); found { if !dec_opt_PrintedCardRef(fv, &out.printed_ref) do return fail("TriggerSourceContext.printed_ref") }
	if fv, found := get_any(v, "printing"); found { if !decode_DisplayOnly_ptr_CardPrinting(fv, &out.printing) do return fail("TriggerSourceContext.printing") }
	if fv, found := get_any(v, "is_token"); found { if !decode_bool(fv, &out.is_token) do return fail("TriggerSourceContext.is_token") }
	if fv, found := get_any(v, "face_down"); found { if !decode_bool(fv, &out.face_down) do return fail("TriggerSourceContext.face_down") }
	if fv, found := get_any(v, "mana_cost"); found { if !decode_ManaCost(fv, &out.mana_cost) do return fail("TriggerSourceContext.mana_cost") } else { out.mana_cost = default_ManaCost() }
	if fv, found := get_any(v, "transformed"); found { if !decode_bool(fv, &out.transformed) do return fail("TriggerSourceContext.transformed") }
	if fv, found := get_any(v, "transformed_permanent"); found { if !decode_bool(fv, &out.transformed_permanent) do return fail("TriggerSourceContext.transformed_permanent") }
	if fv, found := get_any(v, "is_renowned"); found { if !decode_bool(fv, &out.is_renowned) do return fail("TriggerSourceContext.is_renowned") }
	if fv, found := get_any(v, "is_saddled"); found { if !decode_bool(fv, &out.is_saddled) do return fail("TriggerSourceContext.is_saddled") }
	if fv, found := get_any(v, "echo_due"); found { if !decode_bool(fv, &out.echo_due) do return fail("TriggerSourceContext.echo_due") }
	if fv, found := get_any(v, "harnessed"); found { if !decode_bool(fv, &out.harnessed) do return fail("TriggerSourceContext.harnessed") }
	if fv, found := get_any(v, "saddled_by"); found { if !dec_dyn_ObjectId(fv, &out.saddled_by) do return fail("TriggerSourceContext.saddled_by") }
	if fv, found := get_any(v, "convoked_creatures"); found { if !dec_dyn_ObjectId(fv, &out.convoked_creatures) do return fail("TriggerSourceContext.convoked_creatures") }
	if fv, found := get_any(v, "case_state"); found { if !dec_opt_CaseState(fv, &out.case_state) do return fail("TriggerSourceContext.case_state") }
	if fv, found := get_any(v, "class_level"); found { if !dec_opt_u8(fv, &out.class_level) do return fail("TriggerSourceContext.class_level") }
	if fv, found := get_any(v, "trigger_entries"); found { if !dec_dyn_TriggerEntry(fv, &out.trigger_entries) do return fail("TriggerSourceContext.trigger_entries") }
	if fv, found := get_any(v, "timestamp"); found { if !decode_u64(fv, &out.timestamp) do return fail("TriggerSourceContext.timestamp") } else { return fail("TriggerSourceContext.timestamp missing") }
	if fv, found := get_any(v, "entered_battlefield_turn"); found { if !dec_opt_u32(fv, &out.entered_battlefield_turn) do return fail("TriggerSourceContext.entered_battlefield_turn") }
	if fv, found := get_any(v, "paired_with"); found { if !dec_opt_ObjectId(fv, &out.paired_with) do return fail("TriggerSourceContext.paired_with") }
	if fv, found := get_any(v, "pair_controller"); found { if !dec_opt_PlayerId(fv, &out.pair_controller) do return fail("TriggerSourceContext.pair_controller") }
	if fv, found := get_any(v, "attached_to"); found { if !dec_opt_AttachTarget(fv, &out.attached_to) do return fail("TriggerSourceContext.attached_to") }
	if fv, found := get_any(v, "attachments"); found { if !dec_dyn_AttachmentSnapshot(fv, &out.attachments) do return fail("TriggerSourceContext.attachments") }
	if fv, found := get_any(v, "linked_exile_snapshot"); found { if !dec_dyn_LinkedExileSnapshot(fv, &out.linked_exile_snapshot) do return fail("TriggerSourceContext.linked_exile_snapshot") }
	if fv, found := get_any(v, "cards_exiled_this_turn"); found { if !dec_dyn_ObjectId(fv, &out.cards_exiled_this_turn) do return fail("TriggerSourceContext.cards_exiled_this_turn") }
	if fv, found := get_any(v, "combat_status"); found { if !decode_ZoneChangeCombatStatus(fv, &out.combat_status) do return fail("TriggerSourceContext.combat_status") }
	if fv, found := get_any(v, "cast_from_zone"); found { if !dec_opt_Zone(fv, &out.cast_from_zone) do return fail("TriggerSourceContext.cast_from_zone") }
	if fv, found := get_any(v, "played_from_zone"); found { if !dec_opt_Zone(fv, &out.played_from_zone) do return fail("TriggerSourceContext.played_from_zone") }
	if fv, found := get_any(v, "entered_via_ability_source"); found { if !dec_opt_ObjectId(fv, &out.entered_via_ability_source) do return fail("TriggerSourceContext.entered_via_ability_source") }
	if fv, found := get_any(v, "cast_controller"); found { if !dec_opt_PlayerId(fv, &out.cast_controller) do return fail("TriggerSourceContext.cast_controller") }
	if fv, found := get_any(v, "phase_status"); found { if !decode_PhaseStatus(fv, &out.phase_status) do return fail("TriggerSourceContext.phase_status") } else { out.phase_status = PhaseStatus(PhaseStatus_PhasedIn{}) }
	if fv, found := get_any(v, "cast_variant_paid"); found { if !dec_opt_t2_CastVariantPaid_u32(fv, &out.cast_variant_paid) do return fail("TriggerSourceContext.cast_variant_paid") }
	if fv, found := get_any(v, "cast_timing_permission"); found { if !dec_opt_t2_CastTimingPermission_u32(fv, &out.cast_timing_permission) do return fail("TriggerSourceContext.cast_timing_permission") }
	if fv, found := get_any(v, "cost_x_paid"); found { if !dec_opt_u32(fv, &out.cost_x_paid) do return fail("TriggerSourceContext.cost_x_paid") }
	if fv, found := get_any(v, "cast_spell_keywords"); found { if !dec_dyn_Keyword(fv, &out.cast_spell_keywords) do return fail("TriggerSourceContext.cast_spell_keywords") }
	if fv, found := get_any(v, "mana_spent_to_cast"); found { if !decode_bool(fv, &out.mana_spent_to_cast) do return fail("TriggerSourceContext.mana_spent_to_cast") }
	if fv, found := get_any(v, "colors_spent_to_cast"); found { if !decode_ColoredManaCount(fv, &out.colors_spent_to_cast) do return fail("TriggerSourceContext.colors_spent_to_cast") }
	if fv, found := get_any(v, "mana_spent_to_cast_amount"); found { if !decode_u32(fv, &out.mana_spent_to_cast_amount) do return fail("TriggerSourceContext.mana_spent_to_cast_amount") }
	if fv, found := get_any(v, "mana_spent_source_snapshots"); found { if !dec_dyn_ManaSpentSourceSnapshot(fv, &out.mana_spent_source_snapshots) do return fail("TriggerSourceContext.mana_spent_source_snapshots") }
	if fv, found := get_any(v, "kickers_paid"); found { if !dec_dyn_KickerVariant(fv, &out.kickers_paid) do return fail("TriggerSourceContext.kickers_paid") }
	if fv, found := get_any(v, "additional_cost_payment_count"); found { if !decode_u32(fv, &out.additional_cost_payment_count) do return fail("TriggerSourceContext.additional_cost_payment_count") }
	if fv, found := get_any(v, "additional_cost_payments"); found { if !dec_dyn_AdditionalCostInstancePayment(fv, &out.additional_cost_payments) do return fail("TriggerSourceContext.additional_cost_payments") }
	if fv, found := get_any(v, "cast_cost_paid_object"); found { if !dec_opt_CostPaidObjectSnapshot(fv, &out.cast_cost_paid_object) do return fail("TriggerSourceContext.cast_cost_paid_object") }
	if fv, found := get_any(v, "granting_object"); found { if !dec_opt_ObjectIncarnationRef(fv, &out.granting_object) do return fail("TriggerSourceContext.granting_object") }
	return true
}

encode_TriggerSourceContext :: proc(b: ^strings.Builder, x: TriggerSourceContext) {
	strings.write_byte(b, '{')
	f := true
	encode_TriggerSourceContext_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_TriggerSourceContext_members :: proc(b: ^strings.Builder, x: TriggerSourceContext, first: ^bool) {
	member(b, first, "identity"); encode_ObjectIdentityBinding(b, x.identity)
	member(b, first, "lki"); encode_LKISnapshot(b, x.lki)
	member(b, first, "card_id"); encode_CardId(b, x.card_id)
	if !(x.printed_ref == nil) { member(b, first, "printed_ref"); enc_opt_PrintedCardRef(b, x.printed_ref) }
	if !(skip_TriggerSourceContext_DisplayOnly_is_none_DisplayOnly_ptr_CardPrinting(x.printing)) { member(b, first, "printing"); encode_DisplayOnly_ptr_CardPrinting(b, x.printing) }
	member(b, first, "is_token"); encode_bool(b, x.is_token)
	member(b, first, "face_down"); encode_bool(b, x.face_down)
	member(b, first, "mana_cost"); encode_ManaCost(b, x.mana_cost)
	member(b, first, "transformed"); encode_bool(b, x.transformed)
	if !(!x.transformed_permanent) { member(b, first, "transformed_permanent"); encode_bool(b, x.transformed_permanent) }
	member(b, first, "is_renowned"); encode_bool(b, x.is_renowned)
	member(b, first, "is_saddled"); encode_bool(b, x.is_saddled)
	if !(!x.echo_due) { member(b, first, "echo_due"); encode_bool(b, x.echo_due) }
	if !(!x.harnessed) { member(b, first, "harnessed"); encode_bool(b, x.harnessed) }
	if !((len(x.saddled_by) == 0)) { member(b, first, "saddled_by"); enc_dyn_ObjectId(b, x.saddled_by) }
	if !((len(x.convoked_creatures) == 0)) { member(b, first, "convoked_creatures"); enc_dyn_ObjectId(b, x.convoked_creatures) }
	if !(x.case_state == nil) { member(b, first, "case_state"); enc_opt_CaseState(b, x.case_state) }
	if !(x.class_level == nil) { member(b, first, "class_level"); enc_opt_u8(b, x.class_level) }
	if !((len(x.trigger_entries) == 0)) { member(b, first, "trigger_entries"); enc_dyn_TriggerEntry(b, x.trigger_entries) }
	member(b, first, "timestamp"); encode_u64(b, x.timestamp)
	if !(x.entered_battlefield_turn == nil) { member(b, first, "entered_battlefield_turn"); enc_opt_u32(b, x.entered_battlefield_turn) }
	if !(x.paired_with == nil) { member(b, first, "paired_with"); enc_opt_ObjectId(b, x.paired_with) }
	if !(x.pair_controller == nil) { member(b, first, "pair_controller"); enc_opt_PlayerId(b, x.pair_controller) }
	if !(x.attached_to == nil) { member(b, first, "attached_to"); enc_opt_AttachTarget(b, x.attached_to) }
	if !((len(x.attachments) == 0)) { member(b, first, "attachments"); enc_dyn_AttachmentSnapshot(b, x.attachments) }
	if !((len(x.linked_exile_snapshot) == 0)) { member(b, first, "linked_exile_snapshot"); enc_dyn_LinkedExileSnapshot(b, x.linked_exile_snapshot) }
	if !((len(x.cards_exiled_this_turn) == 0)) { member(b, first, "cards_exiled_this_turn"); enc_dyn_ObjectId(b, x.cards_exiled_this_turn) }
	member(b, first, "combat_status"); encode_ZoneChangeCombatStatus(b, x.combat_status)
	if !(x.cast_from_zone == nil) { member(b, first, "cast_from_zone"); enc_opt_Zone(b, x.cast_from_zone) }
	if !(x.played_from_zone == nil) { member(b, first, "played_from_zone"); enc_opt_Zone(b, x.played_from_zone) }
	if !(x.entered_via_ability_source == nil) { member(b, first, "entered_via_ability_source"); enc_opt_ObjectId(b, x.entered_via_ability_source) }
	if !(x.cast_controller == nil) { member(b, first, "cast_controller"); enc_opt_PlayerId(b, x.cast_controller) }
	member(b, first, "phase_status"); encode_PhaseStatus(b, x.phase_status)
	if !(x.cast_variant_paid == nil) { member(b, first, "cast_variant_paid"); enc_opt_t2_CastVariantPaid_u32(b, x.cast_variant_paid) }
	if !(x.cast_timing_permission == nil) { member(b, first, "cast_timing_permission"); enc_opt_t2_CastTimingPermission_u32(b, x.cast_timing_permission) }
	if !(x.cost_x_paid == nil) { member(b, first, "cost_x_paid"); enc_opt_u32(b, x.cost_x_paid) }
	if !((len(x.cast_spell_keywords) == 0)) { member(b, first, "cast_spell_keywords"); enc_dyn_Keyword(b, x.cast_spell_keywords) }
	member(b, first, "mana_spent_to_cast"); encode_bool(b, x.mana_spent_to_cast)
	if !(skip_TriggerSourceContext_ColoredManaCount_is_empty_ColoredManaCount(x.colors_spent_to_cast)) { member(b, first, "colors_spent_to_cast"); encode_ColoredManaCount(b, x.colors_spent_to_cast) }
	if !(x.mana_spent_to_cast_amount == 0) { member(b, first, "mana_spent_to_cast_amount"); encode_u32(b, x.mana_spent_to_cast_amount) }
	if !((len(x.mana_spent_source_snapshots) == 0)) { member(b, first, "mana_spent_source_snapshots"); enc_dyn_ManaSpentSourceSnapshot(b, x.mana_spent_source_snapshots) }
	if !((len(x.kickers_paid) == 0)) { member(b, first, "kickers_paid"); enc_dyn_KickerVariant(b, x.kickers_paid) }
	if !(x.additional_cost_payment_count == 0) { member(b, first, "additional_cost_payment_count"); encode_u32(b, x.additional_cost_payment_count) }
	if !((len(x.additional_cost_payments) == 0)) { member(b, first, "additional_cost_payments"); enc_dyn_AdditionalCostInstancePayment(b, x.additional_cost_payments) }
	if !(x.cast_cost_paid_object == nil) { member(b, first, "cast_cost_paid_object"); enc_opt_CostPaidObjectSnapshot(b, x.cast_cost_paid_object) }
	if !(x.granting_object == nil) { member(b, first, "granting_object"); enc_opt_ObjectIncarnationRef(b, x.granting_object) }
}

decode_UnTell :: proc(v: json.Value, out: ^UnTell) -> bool {
	when COVERAGE do cov_hit("UnTell")
	if v.kind != .Object do return fail("UnTell: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("UnTell: no tag")
	switch tv.text {
	case "Physical": when COVERAGE do cov_hit("UnTell::Physical"); tmp: UnTell_Physical; if !decode_PhysicalTell(json.get_or_null(v, "data"), &tmp._0) do return fail("UnTell::Physical"); out^ = tmp
	case "Said": when COVERAGE do cov_hit("UnTell::Said");
		tmp: UnTell_Said
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^UnTell_Said) -> bool {
	if fv, found := get_any(v, "text"); found { if !decode_string(fv, &out.text) do return fail("UnTell::Said.text") } else { return fail("UnTell::Said.text missing") }
	return true
		}) { return fail("UnTell::Said") }
		out^ = tmp
	case: return fail("UnTell: unknown variant")
	}
	return true
}

encode_UnTell :: proc(b: ^strings.Builder, x: UnTell) {
	#partial switch y in x {
	case UnTell_Physical: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Physical"); member(b, &f, "data"); encode_PhysicalTell(b, y._0); strings.write_byte(b, '}')
	case UnTell_Said: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Said"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "text"); encode_string(b, y.text)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_ObjectIdentityBinding :: proc(v: json.Value, out: ^ObjectIdentityBinding) -> bool {
	when COVERAGE do cov_hit("ObjectIdentityBinding")
	if v.kind != .Object do return fail("ObjectIdentityBinding: not an object")
	if fv, found := get_any(v, "reference"); found { if !decode_ObjectIncarnationRef(fv, &out.reference) do return fail("ObjectIdentityBinding.reference") } else { return fail("ObjectIdentityBinding.reference missing") }
	if fv, found := get_any(v, "expected_zone"); found { if !decode_Zone(fv, &out.expected_zone) do return fail("ObjectIdentityBinding.expected_zone") } else { return fail("ObjectIdentityBinding.expected_zone missing") }
	return true
}

encode_ObjectIdentityBinding :: proc(b: ^strings.Builder, x: ObjectIdentityBinding) {
	strings.write_byte(b, '{')
	f := true
	encode_ObjectIdentityBinding_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ObjectIdentityBinding_members :: proc(b: ^strings.Builder, x: ObjectIdentityBinding, first: ^bool) {
	member(b, first, "reference"); encode_ObjectIncarnationRef(b, x.reference)
	member(b, first, "expected_zone"); encode_Zone(b, x.expected_zone)
}

decode_InstructionLead :: proc(v: json.Value, out: ^InstructionLead) -> bool {
	when COVERAGE do cov_hit("InstructionLead")
	return decode_int(v, cast(^int)out)
}

encode_InstructionLead :: proc(b: ^strings.Builder, x: InstructionLead) {
