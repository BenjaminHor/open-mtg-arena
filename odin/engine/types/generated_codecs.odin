encode_ContinuousModification_members :: proc(b: ^strings.Builder, x: ContinuousModification, first: ^bool) {
	#partial switch y in x {
	case ContinuousModification_CopyValues: member(b, first, "type"); json.write_string(b, "CopyValues")
	member(b, first, "values"); enc_ptr_CopiableValues(b, y.values)
	encode_DisplayIdentity_members(b, y.display, first)

	case ContinuousModification_CopyChosen: _ = y; member(b, first, "type"); json.write_string(b, "CopyChosen")
	case ContinuousModification_SetName: member(b, first, "type"); json.write_string(b, "SetName")
	member(b, first, "name"); encode_string(b, y.name)

	case ContinuousModification_SetTextName: member(b, first, "type"); json.write_string(b, "SetTextName")
	member(b, first, "name"); encode_string(b, y.name)

	case ContinuousModification_SubstituteTextWord: member(b, first, "type"); json.write_string(b, "SubstituteTextWord")
	member(b, first, "substitution"); encode_TextSubstitutionSpec(b, y.substitution)

	case ContinuousModification_AddPower: member(b, first, "type"); json.write_string(b, "AddPower")
	member(b, first, "value"); encode_i32(b, y.value)

	case ContinuousModification_AddToughness: member(b, first, "type"); json.write_string(b, "AddToughness")
	member(b, first, "value"); encode_i32(b, y.value)

	case ContinuousModification_SetPower: member(b, first, "type"); json.write_string(b, "SetPower")
	member(b, first, "value"); encode_i32(b, y.value)

	case ContinuousModification_SetToughness: member(b, first, "type"); json.write_string(b, "SetToughness")
	member(b, first, "value"); encode_i32(b, y.value)

	case ContinuousModification_AddKeyword: member(b, first, "type"); json.write_string(b, "AddKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)

	case ContinuousModification_RemoveKeyword: member(b, first, "type"); json.write_string(b, "RemoveKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)

	case ContinuousModification_GrantAbility: member(b, first, "type"); json.write_string(b, "GrantAbility")
	member(b, first, "definition"); enc_ptr_AbilityDefinition(b, y.definition)

	case ContinuousModification_GrantAllActivatedAbilitiesOf: member(b, first, "type"); json.write_string(b, "GrantAllActivatedAbilitiesOf")
	member(b, first, "source"); encode_TargetFilter(b, y.source)
	if !(y.cap == nil) { member(b, first, "cap"); enc_opt_ActivationRestriction(b, y.cap) }
	if !(y.kind == nil) { member(b, first, "kind"); enc_opt_ActivatedAbilityKind(b, y.kind) }

	case ContinuousModification_GrantAllTriggeredAbilitiesOf: member(b, first, "type"); json.write_string(b, "GrantAllTriggeredAbilitiesOf")
	member(b, first, "source"); encode_TargetFilter(b, y.source)

	case ContinuousModification_GrantTrigger: member(b, first, "type"); json.write_string(b, "GrantTrigger")
	member(b, first, "trigger"); enc_ptr_TriggerDefinition(b, y.trigger)

	case ContinuousModification_GrantReplacement: member(b, first, "type"); json.write_string(b, "GrantReplacement")
	member(b, first, "replacement"); enc_ptr_ReplacementDefinition(b, y.replacement)

	case ContinuousModification_RemoveAllAbilities: _ = y; member(b, first, "type"); json.write_string(b, "RemoveAllAbilities")
	case ContinuousModification_AddType: member(b, first, "type"); json.write_string(b, "AddType")
	member(b, first, "core_type"); encode_CoreType(b, y.core_type)

	case ContinuousModification_RemoveType: member(b, first, "type"); json.write_string(b, "RemoveType")
	member(b, first, "core_type"); encode_CoreType(b, y.core_type)

	case ContinuousModification_AddSubtype: member(b, first, "type"); json.write_string(b, "AddSubtype")
	member(b, first, "subtype"); encode_string(b, y.subtype)

	case ContinuousModification_RemoveSubtype: member(b, first, "type"); json.write_string(b, "RemoveSubtype")
	member(b, first, "subtype"); encode_string(b, y.subtype)

	case ContinuousModification_SetCardTypes: member(b, first, "type"); json.write_string(b, "SetCardTypes")
	member(b, first, "core_types"); enc_dyn_CoreType(b, y.core_types)

	case ContinuousModification_RemoveAllSubtypes: member(b, first, "type"); json.write_string(b, "RemoveAllSubtypes")
	member(b, first, "set"); encode_SubtypeSet(b, y.set)

	case ContinuousModification_SetDynamicPower: member(b, first, "type"); json.write_string(b, "SetDynamicPower")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)

	case ContinuousModification_SetDynamicToughness: member(b, first, "type"); json.write_string(b, "SetDynamicToughness")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)

	case ContinuousModification_SetPowerDynamic: member(b, first, "type"); json.write_string(b, "SetPowerDynamic")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)

	case ContinuousModification_SetToughnessDynamic: member(b, first, "type"); json.write_string(b, "SetToughnessDynamic")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)

	case ContinuousModification_AddDynamicPower: member(b, first, "type"); json.write_string(b, "AddDynamicPower")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)

	case ContinuousModification_AddDynamicToughness: member(b, first, "type"); json.write_string(b, "AddDynamicToughness")
	member(b, first, "value"); encode_QuantityExpr(b, y.value)

	case ContinuousModification_AddDynamicKeyword: member(b, first, "type"); json.write_string(b, "AddDynamicKeyword")
	member(b, first, "kind"); encode_DynamicKeywordKind(b, y.kind)
	member(b, first, "value"); encode_QuantityExpr(b, y.value)

	case ContinuousModification_AddKeywordWithDerivedCost: member(b, first, "type"); json.write_string(b, "AddKeywordWithDerivedCost")
	member(b, first, "kind"); encode_CostBearingKeywordKind(b, y.kind)
	member(b, first, "derivation"); encode_CostDerivation(b, y.derivation)

	case ContinuousModification_AddAllCreatureTypes: _ = y; member(b, first, "type"); json.write_string(b, "AddAllCreatureTypes")
	case ContinuousModification_AddAllBasicLandTypes: _ = y; member(b, first, "type"); json.write_string(b, "AddAllBasicLandTypes")
	case ContinuousModification_AddAllLandTypes: _ = y; member(b, first, "type"); json.write_string(b, "AddAllLandTypes")
	case ContinuousModification_AddChosenSubtype: member(b, first, "type"); json.write_string(b, "AddChosenSubtype")
	member(b, first, "kind"); encode_ChosenSubtypeKind(b, y.kind)

	case ContinuousModification_AddChosenColor: member(b, first, "type"); json.write_string(b, "AddChosenColor")
	member(b, first, "mode"); encode_ColorChangeMode(b, y.mode)

	case ContinuousModification_RemoveChosenKeyword: _ = y; member(b, first, "type"); json.write_string(b, "RemoveChosenKeyword")
	case ContinuousModification_AddChosenKeyword: _ = y; member(b, first, "type"); json.write_string(b, "AddChosenKeyword")
	case ContinuousModification_SetColor: member(b, first, "type"); json.write_string(b, "SetColor")
	member(b, first, "colors"); enc_dyn_ManaColor(b, y.colors)

	case ContinuousModification_AddColor: member(b, first, "type"); json.write_string(b, "AddColor")
	member(b, first, "color"); encode_ManaColor(b, y.color)

	case ContinuousModification_AddStaticMode: member(b, first, "type"); json.write_string(b, "AddStaticMode")
	member(b, first, "mode"); encode_StaticMode(b, y.mode)

	case ContinuousModification_GrantStaticAbility: member(b, first, "type"); json.write_string(b, "GrantStaticAbility")
	member(b, first, "definition"); enc_ptr_StaticDefinition(b, y.definition)

	case ContinuousModification_SwitchPowerToughness: _ = y; member(b, first, "type"); json.write_string(b, "SwitchPowerToughness")
	case ContinuousModification_AssignDamageFromToughness: _ = y; member(b, first, "type"); json.write_string(b, "AssignDamageFromToughness")
	case ContinuousModification_AssignDamageAsThoughUnblocked: _ = y; member(b, first, "type"); json.write_string(b, "AssignDamageAsThoughUnblocked")
	case ContinuousModification_AssignNoCombatDamage: _ = y; member(b, first, "type"); json.write_string(b, "AssignNoCombatDamage")
	case ContinuousModification_ChangeController: _ = y; member(b, first, "type"); json.write_string(b, "ChangeController")
	case ContinuousModification_ChangeControllerToDesignation: member(b, first, "type"); json.write_string(b, "ChangeControllerToDesignation")
	member(b, first, "designation"); encode_Designation(b, y.designation)

	case ContinuousModification_SetBasicLandType: member(b, first, "type"); json.write_string(b, "SetBasicLandType")
	member(b, first, "land_type"); encode_BasicLandType(b, y.land_type)

	case ContinuousModification_SetChosenBasicLandType: _ = y; member(b, first, "type"); json.write_string(b, "SetChosenBasicLandType")
	case ContinuousModification_SetChosenName: _ = y; member(b, first, "type"); json.write_string(b, "SetChosenName")
	case ContinuousModification_RetainPrintedTriggerFromSource: member(b, first, "type"); json.write_string(b, "RetainPrintedTriggerFromSource")
	member(b, first, "source_trigger_index"); encode_int(b, y.source_trigger_index)

	case ContinuousModification_RetainPrintedAbilityFromSource: member(b, first, "type"); json.write_string(b, "RetainPrintedAbilityFromSource")
	member(b, first, "source_ability_index"); encode_int(b, y.source_ability_index)

	case ContinuousModification_RetainAllOtherAbilitiesFromSource: _ = y; member(b, first, "type"); json.write_string(b, "RetainAllOtherAbilitiesFromSource")
	case ContinuousModification_AddSupertype: member(b, first, "type"); json.write_string(b, "AddSupertype")
	member(b, first, "supertype"); encode_Supertype(b, y.supertype)

	case ContinuousModification_RemoveSupertype: member(b, first, "type"); json.write_string(b, "RemoveSupertype")
	member(b, first, "supertype"); encode_Supertype(b, y.supertype)

	case ContinuousModification_AddCounterOnEnter: member(b, first, "type"); json.write_string(b, "AddCounterOnEnter")
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "if_type"); enc_opt_CoreType(b, y.if_type)

	case ContinuousModification_SetStartingLoyalty: member(b, first, "type"); json.write_string(b, "SetStartingLoyalty")
	member(b, first, "value"); encode_u32(b, y.value)

	case ContinuousModification_RemoveManaCost: _ = y; member(b, first, "type"); json.write_string(b, "RemoveManaCost")
	}
}

decode_ParsedCondition :: proc(v: json.Value, out: ^ParsedCondition) -> bool {
	if v.kind != .Object do return fail("ParsedCondition: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ParsedCondition: no tag")
	switch tv.text {
	case "SourceInZone":
		tmp: ParsedCondition_SourceInZone
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ParsedCondition_SourceInZone) -> bool {
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("ParsedCondition::SourceInZone.zone") } else { return fail("ParsedCondition::SourceInZone.zone missing") }
	return true
		}) { return fail("ParsedCondition::SourceInZone") }
		out^ = tmp
	case "SourceIsAttacking": out^ = ParsedCondition_SourceIsAttacking{}
	case "SourceIsAttackingOrBlocking": out^ = ParsedCondition_SourceIsAttackingOrBlocking{}
	case "SourceIsBlocked": out^ = ParsedCondition_SourceIsBlocked{}
	case "SourcePowerAtLeast":
		tmp: ParsedCondition_SourcePowerAtLeast
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ParsedCondition_SourcePowerAtLeast) -> bool {
	if fv, found := get_any(v, "minimum"); found { if !decode_i32(fv, &out.minimum) do return fail("ParsedCondition::SourcePowerAtLeast.minimum") } else { return fail("ParsedCondition::SourcePowerAtLeast.minimum missing") }
	return true
		}) { return fail("ParsedCondition::SourcePowerAtLeast") }
		out^ = tmp
	case "SourceHasCounterAtLeast":
		tmp: ParsedCondition_SourceHasCounterAtLeast
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ParsedCondition_SourceHasCounterAtLeast) -> bool {
	if fv, found := get_any(v, "counter_type"); found { if !decode_CounterType(fv, &out.counter_type) do return fail("ParsedCondition::SourceHasCounterAtLeast.counter_type") } else { return fail("ParsedCondition::SourceHasCounterAtLeast.counter_type missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("ParsedCondition::SourceHasCounterAtLeast.count") } else { return fail("ParsedCondition::SourceHasCounterAtLeast.count missing") }
	return true
		}) { return fail("ParsedCondition::SourceHasCounterAtLeast") }
		out^ = tmp
	case "SourceHasNoCounter":
		tmp: ParsedCondition_SourceHasNoCounter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ParsedCondition_SourceHasNoCounter) -> bool {
	if fv, found := get_any(v, "counter_type"); found { if !decode_CounterType(fv, &out.counter_type) do return fail("ParsedCondition::SourceHasNoCounter.counter_type") } else { return fail("ParsedCondition::SourceHasNoCounter.counter_type missing") }
	return true
		}) { return fail("ParsedCondition::SourceHasNoCounter") }
