	if fv, found := get_any(v, "constraint"); found { if !dec_opt_TriggerConstraint(fv, &out.constraint) do return fail("TriggerCollectionOperation::RecordTriggerFired.constraint") }
	if fv, found := get_any(v, "source_context"); found { if !dec_ptr_opt_TriggerSourceContext(fv, &out.source_context) do return fail("TriggerCollectionOperation::RecordTriggerFired.source_context") } else { return fail("TriggerCollectionOperation::RecordTriggerFired.source_context missing") }
	if fv, found := get_any(v, "definition_ref"); found { if !dec_opt_TriggerDefinitionRef(fv, &out.definition_ref) do return fail("TriggerCollectionOperation::RecordTriggerFired.definition_ref") }
	if fv, found := get_any(v, "event"); found { if !decode_GameEvent(fv, &out.event) do return fail("TriggerCollectionOperation::RecordTriggerFired.event") } else { return fail("TriggerCollectionOperation::RecordTriggerFired.event missing") }
	return true
		}) { return fail("TriggerCollectionOperation::RecordTriggerFired") }
		out^ = tmp
	case "RecordBatchedZoneChanges": when COVERAGE do cov_hit("TriggerCollectionOperation::RecordBatchedZoneChanges");
		tmp: TriggerCollectionOperation_RecordBatchedZoneChanges
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^TriggerCollectionOperation_RecordBatchedZoneChanges) -> bool {
	if fv, found := get_any(v, "definition_ref"); found { if !decode_TriggerDefinitionRef(fv, &out.definition_ref) do return fail("TriggerCollectionOperation::RecordBatchedZoneChanges.definition_ref") } else { return fail("TriggerCollectionOperation::RecordBatchedZoneChanges.definition_ref missing") }
	if fv, found := get_any(v, "turn_zone_change_keys"); found { if !dec_dyn_t2_u32_int(fv, &out.turn_zone_change_keys) do return fail("TriggerCollectionOperation::RecordBatchedZoneChanges.turn_zone_change_keys") } else { return fail("TriggerCollectionOperation::RecordBatchedZoneChanges.turn_zone_change_keys missing") }
