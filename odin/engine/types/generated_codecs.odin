decode_LibraryPosition :: proc(v: json.Value, out: ^LibraryPosition) -> bool {
	when COVERAGE do cov_hit("LibraryPosition")
	if v.kind != .Object do return fail("LibraryPosition: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("LibraryPosition: no tag")
	switch tv.text {
	case "Top": when COVERAGE do cov_hit("LibraryPosition::Top"); out^ = LibraryPosition_Top{}
	case "Bottom": when COVERAGE do cov_hit("LibraryPosition::Bottom"); out^ = LibraryPosition_Bottom{}
	case "NthFromTop": when COVERAGE do cov_hit("LibraryPosition::NthFromTop");
		tmp: LibraryPosition_NthFromTop
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^LibraryPosition_NthFromTop) -> bool {
	if fv, found := get_any(v, "n"); found { if !decode_u32(fv, &out.n) do return fail("LibraryPosition::NthFromTop.n") } else { return fail("LibraryPosition::NthFromTop.n missing") }
	return true
		}) { return fail("LibraryPosition::NthFromTop") }
		out^ = tmp
	case "BeneathTop": when COVERAGE do cov_hit("LibraryPosition::BeneathTop");
		tmp: LibraryPosition_BeneathTop
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^LibraryPosition_BeneathTop) -> bool {
	if fv, found := get_any(v, "depth"); found { if !decode_QuantityExpr(fv, &out.depth) do return fail("LibraryPosition::BeneathTop.depth") } else { return fail("LibraryPosition::BeneathTop.depth missing") }
	return true
		}) { return fail("LibraryPosition::BeneathTop") }
		out^ = tmp
	case "RandomWithinTop": when COVERAGE do cov_hit("LibraryPosition::RandomWithinTop");
		tmp: LibraryPosition_RandomWithinTop
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^LibraryPosition_RandomWithinTop) -> bool {
	if fv, found := get_any(v, "n"); found { if !decode_QuantityExpr(fv, &out.n) do return fail("LibraryPosition::RandomWithinTop.n") } else { return fail("LibraryPosition::RandomWithinTop.n missing") }
	return true
		}) { return fail("LibraryPosition::RandomWithinTop") }
		out^ = tmp
	case: return fail("LibraryPosition: unknown variant")
	}
	return true
}

encode_LibraryPosition :: proc(b: ^strings.Builder, x: LibraryPosition) {
	#partial switch y in x {
	case LibraryPosition_Top: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Top"); strings.write_byte(b, '}')
	case LibraryPosition_Bottom: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Bottom"); strings.write_byte(b, '}')
	case LibraryPosition_NthFromTop: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "NthFromTop")
	member(b, first, "n"); encode_u32(b, y.n)
	}; strings.write_byte(b, '}')
	case LibraryPosition_BeneathTop: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "BeneathTop")
	member(b, first, "depth"); encode_QuantityExpr(b, y.depth)
	}; strings.write_byte(b, '}')
	case LibraryPosition_RandomWithinTop: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RandomWithinTop")
	member(b, first, "n"); encode_QuantityExpr(b, y.n)
	}; strings.write_byte(b, '}')
	}
}

encode_LibraryPosition_members :: proc(b: ^strings.Builder, x: LibraryPosition, first: ^bool) {
	#partial switch y in x {
	case LibraryPosition_Top: _ = y; member(b, first, "type"); json.write_string(b, "Top")
	case LibraryPosition_Bottom: _ = y; member(b, first, "type"); json.write_string(b, "Bottom")
	case LibraryPosition_NthFromTop: member(b, first, "type"); json.write_string(b, "NthFromTop")
	member(b, first, "n"); encode_u32(b, y.n)

	case LibraryPosition_BeneathTop: member(b, first, "type"); json.write_string(b, "BeneathTop")
	member(b, first, "depth"); encode_QuantityExpr(b, y.depth)

	case LibraryPosition_RandomWithinTop: member(b, first, "type"); json.write_string(b, "RandomWithinTop")
	member(b, first, "n"); encode_QuantityExpr(b, y.n)

	}
}

decode_LibraryShuffleMode :: proc(v: json.Value, out: ^LibraryShuffleMode) -> bool {
	when COVERAGE do cov_hit("LibraryShuffleMode")
	if v.kind != .Object do return fail("LibraryShuffleMode: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("LibraryShuffleMode: no tag")
	str := tv.text
	switch str {
	case "PerObject": when COVERAGE do cov_hit("LibraryShuffleMode::PerObject"); out^ = .PerObject
	case "TerminalShuffle": when COVERAGE do cov_hit("LibraryShuffleMode::TerminalShuffle"); out^ = .TerminalShuffle
	case: return fail("LibraryShuffleMode: unknown variant")
	}
	return true
}

encode_LibraryShuffleMode :: proc(b: ^strings.Builder, x: LibraryShuffleMode) {
