		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_PtComparison) -> bool {
	if fv, found := get_any(v, "stat"); found { if !decode_PtStat(fv, &out.stat) do return fail("FilterProp::PtComparison.stat") } else { return fail("FilterProp::PtComparison.stat missing") }
	if fv, found := get_any(v, "scope"); found { if !decode_PtValueScope(fv, &out.scope) do return fail("FilterProp::PtComparison.scope") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("FilterProp::PtComparison.comparator") } else { return fail("FilterProp::PtComparison.comparator missing") }
