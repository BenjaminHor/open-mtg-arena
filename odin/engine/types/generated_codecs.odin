	if v.kind != .Object do return fail("LibrarySearchCardFaceView: not an object")
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("LibrarySearchCardFaceView.name") } else { return fail("LibrarySearchCardFaceView.name missing") }
	if fv, found := get_any(v, "mana_cost"); found { if !decode_ManaCost(fv, &out.mana_cost) do return fail("LibrarySearchCardFaceView.mana_cost") } else { return fail("LibrarySearchCardFaceView.mana_cost missing") }
	if fv, found := get_any(v, "mana_value"); found { if !decode_u32(fv, &out.mana_value) do return fail("LibrarySearchCardFaceView.mana_value") } else { return fail("LibrarySearchCardFaceView.mana_value missing") }
	if fv, found := get_any(v, "colors"); found { if !dec_dyn_ManaColor(fv, &out.colors) do return fail("LibrarySearchCardFaceView.colors") } else { return fail("LibrarySearchCardFaceView.colors missing") }
	if fv, found := get_any(v, "card_type"); found { if !decode_CardType(fv, &out.card_type) do return fail("LibrarySearchCardFaceView.card_type") } else { return fail("LibrarySearchCardFaceView.card_type missing") }
	if fv, found := get_any(v, "keywords"); found { if !dec_dyn_Keyword(fv, &out.keywords) do return fail("LibrarySearchCardFaceView.keywords") } else { return fail("LibrarySearchCardFaceView.keywords missing") }
	if fv, found := get_any(v, "power"); found { if !dec_opt_i32(fv, &out.power) do return fail("LibrarySearchCardFaceView.power") }
	if fv, found := get_any(v, "toughness"); found { if !dec_opt_i32(fv, &out.toughness) do return fail("LibrarySearchCardFaceView.toughness") }
	if fv, found := get_any(v, "loyalty"); found { if !dec_opt_u32(fv, &out.loyalty) do return fail("LibrarySearchCardFaceView.loyalty") }
	if fv, found := get_any(v, "printed_ref"); found { if !dec_opt_PrintedCardRef(fv, &out.printed_ref) do return fail("LibrarySearchCardFaceView.printed_ref") }
	return true
}

encode_LibrarySearchCardFaceView :: proc(b: ^strings.Builder, x: LibrarySearchCardFaceView) {
