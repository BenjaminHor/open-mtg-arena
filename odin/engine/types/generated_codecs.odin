	case CastManaSpentMetric_FromSource: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "FromSource")
	member(b, first, "source_filter"); encode_TargetFilter(b, y.source_filter)
