	if !((len(x.selected_slots) == 0)) { member(b, first, "selected_slots"); enc_dyn_opt_TargetRef(b, x.selected_slots) }
	if !((len(x.current_legal_targets) == 0)) { member(b, first, "current_legal_targets"); enc_dyn_TargetRef(b, x.current_legal_targets) }
