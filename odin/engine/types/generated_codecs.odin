	if fv, found := get_any(v, "colors"); found { if !dec_dyn_ManaColor(fv, &out.colors) do return fail("ManaProduction::Fixed.colors") }
	if fv, found := get_any(v, "contribution"); found { if !decode_ManaContribution(fv, &out.contribution) do return fail("ManaProduction::Fixed.contribution") } else { out.contribution = default_ManaProduction_default_mana_contribution() }
