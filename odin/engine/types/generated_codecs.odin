	if fv, found := get_any(v, "payment"); found { if !decode_RulesExecutionNodeRef(fv, &out.payment) do return fail("ResolvedManaSpendCommand.payment") } else { return fail("ResolvedManaSpendCommand.payment missing") }
	if fv, found := get_any(v, "units"); found { if !dec_dyn_ResolvedManaSpentUnit(fv, &out.units) do return fail("ResolvedManaSpendCommand.units") } else { return fail("ResolvedManaSpendCommand.units missing") }
