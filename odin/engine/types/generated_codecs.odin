decode_ChoiceValue :: proc(v: json.Value, out: ^ChoiceValue) -> bool {
	when COVERAGE do cov_hit("ChoiceValue")
	if v.kind != .Object do return fail("ChoiceValue: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ChoiceValue: no tag")
	switch tv.text {
	case "Color": when COVERAGE do cov_hit("ChoiceValue::Color"); tmp: ChoiceValue_Color; if !decode_ManaColor(json.get_or_null(v, "value"), &tmp._0) do return fail("ChoiceValue::Color"); out^ = tmp
	case "CreatureType": when COVERAGE do cov_hit("ChoiceValue::CreatureType"); tmp: ChoiceValue_CreatureType; if !decode_string(json.get_or_null(v, "value"), &tmp._0) do return fail("ChoiceValue::CreatureType"); out^ = tmp
	case "BasicLandType": when COVERAGE do cov_hit("ChoiceValue::BasicLandType"); tmp: ChoiceValue_BasicLandType; if !decode_BasicLandType(json.get_or_null(v, "value"), &tmp._0) do return fail("ChoiceValue::BasicLandType"); out^ = tmp
	case "CardType": when COVERAGE do cov_hit("ChoiceValue::CardType"); tmp: ChoiceValue_CardType; if !decode_CoreType(json.get_or_null(v, "value"), &tmp._0) do return fail("ChoiceValue::CardType"); out^ = tmp
	case "OddOrEven": when COVERAGE do cov_hit("ChoiceValue::OddOrEven"); tmp: ChoiceValue_OddOrEven; if !decode_Parity(json.get_or_null(v, "value"), &tmp._0) do return fail("ChoiceValue::OddOrEven"); out^ = tmp
	case "CardName": when COVERAGE do cov_hit("ChoiceValue::CardName"); tmp: ChoiceValue_CardName; if !decode_string(json.get_or_null(v, "value"), &tmp._0) do return fail("ChoiceValue::CardName"); out^ = tmp
	case "Number": when COVERAGE do cov_hit("ChoiceValue::Number"); tmp: ChoiceValue_Number; if !decode_u32(json.get_or_null(v, "value"), &tmp._0) do return fail("ChoiceValue::Number"); out^ = tmp
	case "Label": when COVERAGE do cov_hit("ChoiceValue::Label"); tmp: ChoiceValue_Label; if !decode_string(json.get_or_null(v, "value"), &tmp._0) do return fail("ChoiceValue::Label"); out^ = tmp
	case "CardPredicate": when COVERAGE do cov_hit("ChoiceValue::CardPredicate"); tmp: ChoiceValue_CardPredicate; if !decode_CardPredicateChoice(json.get_or_null(v, "value"), &tmp._0) do return fail("ChoiceValue::CardPredicate"); out^ = tmp
	case "LandType": when COVERAGE do cov_hit("ChoiceValue::LandType"); tmp: ChoiceValue_LandType; if !decode_string(json.get_or_null(v, "value"), &tmp._0) do return fail("ChoiceValue::LandType"); out^ = tmp
	case "Player": when COVERAGE do cov_hit("ChoiceValue::Player"); tmp: ChoiceValue_Player; if !decode_PlayerId(json.get_or_null(v, "value"), &tmp._0) do return fail("ChoiceValue::Player"); out^ = tmp
	case "TwoColors": when COVERAGE do cov_hit("ChoiceValue::TwoColors"); tmp: ChoiceValue_TwoColors; if !dec__2_ManaColor(json.get_or_null(v, "value"), &tmp._0) do return fail("ChoiceValue::TwoColors"); out^ = tmp
	case "Keyword": when COVERAGE do cov_hit("ChoiceValue::Keyword"); tmp: ChoiceValue_Keyword; if !decode_Keyword(json.get_or_null(v, "value"), &tmp._0) do return fail("ChoiceValue::Keyword"); out^ = tmp
	case "Counter": when COVERAGE do cov_hit("ChoiceValue::Counter"); tmp: ChoiceValue_Counter; if !decode_CounterType(json.get_or_null(v, "value"), &tmp._0) do return fail("ChoiceValue::Counter"); out^ = tmp
	case: return fail("ChoiceValue: unknown variant")
	}
	return true
}

encode_ChoiceValue :: proc(b: ^strings.Builder, x: ChoiceValue) {
	#partial switch y in x {
	case ChoiceValue_Color: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Color"); member(b, &f, "value"); encode_ManaColor(b, y._0); strings.write_byte(b, '}')
	case ChoiceValue_CreatureType: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CreatureType"); member(b, &f, "value"); encode_string(b, y._0); strings.write_byte(b, '}')
	case ChoiceValue_BasicLandType: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BasicLandType"); member(b, &f, "value"); encode_BasicLandType(b, y._0); strings.write_byte(b, '}')
	case ChoiceValue_CardType: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CardType"); member(b, &f, "value"); encode_CoreType(b, y._0); strings.write_byte(b, '}')
	case ChoiceValue_OddOrEven: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OddOrEven"); member(b, &f, "value"); encode_Parity(b, y._0); strings.write_byte(b, '}')
	case ChoiceValue_CardName: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CardName"); member(b, &f, "value"); encode_string(b, y._0); strings.write_byte(b, '}')
	case ChoiceValue_Number: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Number"); member(b, &f, "value"); encode_u32(b, y._0); strings.write_byte(b, '}')
	case ChoiceValue_Label: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Label"); member(b, &f, "value"); encode_string(b, y._0); strings.write_byte(b, '}')
	case ChoiceValue_CardPredicate: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CardPredicate"); member(b, &f, "value"); encode_CardPredicateChoice(b, y._0); strings.write_byte(b, '}')
	case ChoiceValue_LandType: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "LandType"); member(b, &f, "value"); encode_string(b, y._0); strings.write_byte(b, '}')
	case ChoiceValue_Player: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Player"); member(b, &f, "value"); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	case ChoiceValue_TwoColors: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TwoColors"); member(b, &f, "value"); enc__2_ManaColor(b, y._0); strings.write_byte(b, '}')
	case ChoiceValue_Keyword: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Keyword"); member(b, &f, "value"); encode_Keyword(b, y._0); strings.write_byte(b, '}')
	case ChoiceValue_Counter: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Counter"); member(b, &f, "value"); encode_CounterType(b, y._0); strings.write_byte(b, '}')
	}
}

decode_AppliedSticker :: proc(v: json.Value, out: ^AppliedSticker) -> bool {
	when COVERAGE do cov_hit("AppliedSticker")
	if v.kind != .Object do return fail("AppliedSticker: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("AppliedSticker: no tag")
	switch tv.text {
	case "Name": when COVERAGE do cov_hit("AppliedSticker::Name");
		tmp: AppliedSticker_Name
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AppliedSticker_Name) -> bool {
	if fv, found := get_any(v, "locator"); found { if !decode_StickerLocator(fv, &out.locator) do return fail("AppliedSticker::Name.locator") } else { return fail("AppliedSticker::Name.locator missing") }
	if fv, found := get_any(v, "text"); found { if !decode_string(fv, &out.text) do return fail("AppliedSticker::Name.text") } else { return fail("AppliedSticker::Name.text missing") }
	if fv, found := get_any(v, "position"); found { if !decode_u8(fv, &out.position) do return fail("AppliedSticker::Name.position") } else { return fail("AppliedSticker::Name.position missing") }
	if fv, found := get_any(v, "timestamp"); found { if !decode_u64(fv, &out.timestamp) do return fail("AppliedSticker::Name.timestamp") } else { return fail("AppliedSticker::Name.timestamp missing") }
	return true
		}) { return fail("AppliedSticker::Name") }
		out^ = tmp
	case "Ability": when COVERAGE do cov_hit("AppliedSticker::Ability");
		tmp: AppliedSticker_Ability
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AppliedSticker_Ability) -> bool {
	if fv, found := get_any(v, "locator"); found { if !decode_StickerLocator(fv, &out.locator) do return fail("AppliedSticker::Ability.locator") } else { return fail("AppliedSticker::Ability.locator missing") }
	if fv, found := get_any(v, "ticket_cost"); found { if !decode_u8(fv, &out.ticket_cost) do return fail("AppliedSticker::Ability.ticket_cost") } else { return fail("AppliedSticker::Ability.ticket_cost missing") }
	if fv, found := get_any(v, "text"); found { if !decode_string(fv, &out.text) do return fail("AppliedSticker::Ability.text") } else { return fail("AppliedSticker::Ability.text missing") }
	if fv, found := get_any(v, "timestamp"); found { if !decode_u64(fv, &out.timestamp) do return fail("AppliedSticker::Ability.timestamp") } else { return fail("AppliedSticker::Ability.timestamp missing") }
	return true
		}) { return fail("AppliedSticker::Ability") }
		out^ = tmp
	case "PowerToughness": when COVERAGE do cov_hit("AppliedSticker::PowerToughness");
		tmp: AppliedSticker_PowerToughness
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AppliedSticker_PowerToughness) -> bool {
	if fv, found := get_any(v, "locator"); found { if !decode_StickerLocator(fv, &out.locator) do return fail("AppliedSticker::PowerToughness.locator") } else { return fail("AppliedSticker::PowerToughness.locator missing") }
	if fv, found := get_any(v, "ticket_cost"); found { if !decode_u8(fv, &out.ticket_cost) do return fail("AppliedSticker::PowerToughness.ticket_cost") } else { return fail("AppliedSticker::PowerToughness.ticket_cost missing") }
	if fv, found := get_any(v, "power"); found { if !decode_i32(fv, &out.power) do return fail("AppliedSticker::PowerToughness.power") } else { return fail("AppliedSticker::PowerToughness.power missing") }
	if fv, found := get_any(v, "toughness"); found { if !decode_i32(fv, &out.toughness) do return fail("AppliedSticker::PowerToughness.toughness") } else { return fail("AppliedSticker::PowerToughness.toughness missing") }
	if fv, found := get_any(v, "timestamp"); found { if !decode_u64(fv, &out.timestamp) do return fail("AppliedSticker::PowerToughness.timestamp") } else { return fail("AppliedSticker::PowerToughness.timestamp missing") }
	return true
		}) { return fail("AppliedSticker::PowerToughness") }
		out^ = tmp
	case "Art": when COVERAGE do cov_hit("AppliedSticker::Art");
		tmp: AppliedSticker_Art
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AppliedSticker_Art) -> bool {
	if fv, found := get_any(v, "locator"); found { if !decode_StickerLocator(fv, &out.locator) do return fail("AppliedSticker::Art.locator") } else { return fail("AppliedSticker::Art.locator missing") }
	if fv, found := get_any(v, "label"); found { if !decode_string(fv, &out.label) do return fail("AppliedSticker::Art.label") } else { return fail("AppliedSticker::Art.label missing") }
	if fv, found := get_any(v, "timestamp"); found { if !decode_u64(fv, &out.timestamp) do return fail("AppliedSticker::Art.timestamp") } else { return fail("AppliedSticker::Art.timestamp missing") }
	return true
		}) { return fail("AppliedSticker::Art") }
		out^ = tmp
	case: return fail("AppliedSticker: unknown variant")
	}
	return true
}

encode_AppliedSticker :: proc(b: ^strings.Builder, x: AppliedSticker) {
	#partial switch y in x {
	case AppliedSticker_Name: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Name")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "text"); encode_string(b, y.text)
	member(b, first, "position"); encode_u8(b, y.position)
	member(b, first, "timestamp"); encode_u64(b, y.timestamp)
	}; strings.write_byte(b, '}')
	case AppliedSticker_Ability: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Ability")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "ticket_cost"); encode_u8(b, y.ticket_cost)
	member(b, first, "text"); encode_string(b, y.text)
	member(b, first, "timestamp"); encode_u64(b, y.timestamp)
	}; strings.write_byte(b, '}')
	case AppliedSticker_PowerToughness: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PowerToughness")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "ticket_cost"); encode_u8(b, y.ticket_cost)
	member(b, first, "power"); encode_i32(b, y.power)
	member(b, first, "toughness"); encode_i32(b, y.toughness)
	member(b, first, "timestamp"); encode_u64(b, y.timestamp)
	}; strings.write_byte(b, '}')
	case AppliedSticker_Art: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Art")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "label"); encode_string(b, y.label)
	member(b, first, "timestamp"); encode_u64(b, y.timestamp)
	}; strings.write_byte(b, '}')
	}
}

encode_AppliedSticker_members :: proc(b: ^strings.Builder, x: AppliedSticker, first: ^bool) {
	#partial switch y in x {
	case AppliedSticker_Name: member(b, first, "type"); json.write_string(b, "Name")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "text"); encode_string(b, y.text)
	member(b, first, "position"); encode_u8(b, y.position)
	member(b, first, "timestamp"); encode_u64(b, y.timestamp)

	case AppliedSticker_Ability: member(b, first, "type"); json.write_string(b, "Ability")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "ticket_cost"); encode_u8(b, y.ticket_cost)
	member(b, first, "text"); encode_string(b, y.text)
	member(b, first, "timestamp"); encode_u64(b, y.timestamp)

	case AppliedSticker_PowerToughness: member(b, first, "type"); json.write_string(b, "PowerToughness")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "ticket_cost"); encode_u8(b, y.ticket_cost)
	member(b, first, "power"); encode_i32(b, y.power)
	member(b, first, "toughness"); encode_i32(b, y.toughness)
	member(b, first, "timestamp"); encode_u64(b, y.timestamp)

	case AppliedSticker_Art: member(b, first, "type"); json.write_string(b, "Art")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "label"); encode_string(b, y.label)
