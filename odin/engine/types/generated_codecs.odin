decode_QuantityExpr :: proc(v: json.Value, out: ^QuantityExpr) -> bool {
	if v.kind != .Object do return fail("QuantityExpr: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("QuantityExpr: no tag")
	switch tv.text {
	case "Ref":
		tmp: QuantityExpr_Ref
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Ref) -> bool {
	if fv, found := get_any(v, "qty"); found { if !decode_QuantityRef(fv, &out.qty) do return fail("QuantityExpr::Ref.qty") } else { return fail("QuantityExpr::Ref.qty missing") }
	return true
		}) { return fail("QuantityExpr::Ref") }
		out^ = tmp
	case "Fixed":
		tmp: QuantityExpr_Fixed
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Fixed) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_i32(fv, &out.value) do return fail("QuantityExpr::Fixed.value") } else { return fail("QuantityExpr::Fixed.value missing") }
	return true
		}) { return fail("QuantityExpr::Fixed") }
		out^ = tmp
	case "DivideRounded":
		tmp: QuantityExpr_DivideRounded
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_DivideRounded) -> bool {
	if fv, found := get_any(v, "inner"); found { if !dec_ptr_QuantityExpr(fv, &out.inner) do return fail("QuantityExpr::DivideRounded.inner") } else { return fail("QuantityExpr::DivideRounded.inner missing") }
	if fv, found := get_any(v, "divisor"); found { if !decode_u32(fv, &out.divisor) do return fail("QuantityExpr::DivideRounded.divisor") } else { return fail("QuantityExpr::DivideRounded.divisor missing") }
	if fv, found := get_any(v, "rounding"); found { if !decode_RoundingMode(fv, &out.rounding) do return fail("QuantityExpr::DivideRounded.rounding") } else { return fail("QuantityExpr::DivideRounded.rounding missing") }
	return true
		}) { return fail("QuantityExpr::DivideRounded") }
		out^ = tmp
	case "Offset":
		tmp: QuantityExpr_Offset
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Offset) -> bool {
	if fv, found := get_any(v, "inner"); found { if !dec_ptr_QuantityExpr(fv, &out.inner) do return fail("QuantityExpr::Offset.inner") } else { return fail("QuantityExpr::Offset.inner missing") }
	if fv, found := get_any(v, "offset"); found { if !decode_i32(fv, &out.offset) do return fail("QuantityExpr::Offset.offset") } else { return fail("QuantityExpr::Offset.offset missing") }
	return true
		}) { return fail("QuantityExpr::Offset") }
		out^ = tmp
	case "ClampMin":
		tmp: QuantityExpr_ClampMin
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_ClampMin) -> bool {
	if fv, found := get_any(v, "inner"); found { if !dec_ptr_QuantityExpr(fv, &out.inner) do return fail("QuantityExpr::ClampMin.inner") } else { return fail("QuantityExpr::ClampMin.inner missing") }
	if fv, found := get_any(v, "minimum"); found { if !decode_i32(fv, &out.minimum) do return fail("QuantityExpr::ClampMin.minimum") } else { return fail("QuantityExpr::ClampMin.minimum missing") }
	return true
		}) { return fail("QuantityExpr::ClampMin") }
		out^ = tmp
	case "Multiply":
		tmp: QuantityExpr_Multiply
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Multiply) -> bool {
	if fv, found := get_any(v, "factor"); found { if !decode_i32(fv, &out.factor) do return fail("QuantityExpr::Multiply.factor") } else { return fail("QuantityExpr::Multiply.factor missing") }
	if fv, found := get_any(v, "inner"); found { if !dec_ptr_QuantityExpr(fv, &out.inner) do return fail("QuantityExpr::Multiply.inner") } else { return fail("QuantityExpr::Multiply.inner missing") }
	return true
		}) { return fail("QuantityExpr::Multiply") }
		out^ = tmp
	case "Sum":
		tmp: QuantityExpr_Sum
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Sum) -> bool {
	if fv, found := get_any(v, "exprs"); found { if !dec_dyn_QuantityExpr(fv, &out.exprs) do return fail("QuantityExpr::Sum.exprs") } else { return fail("QuantityExpr::Sum.exprs missing") }
	return true
		}) { return fail("QuantityExpr::Sum") }
		out^ = tmp
	case "UpTo":
		tmp: QuantityExpr_UpTo
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_UpTo) -> bool {
	if fv, found := get_any(v, "max"); found { if !dec_ptr_QuantityExpr(fv, &out.max) do return fail("QuantityExpr::UpTo.max") } else { return fail("QuantityExpr::UpTo.max missing") }
	return true
		}) { return fail("QuantityExpr::UpTo") }
		out^ = tmp
	case "Power":
		tmp: QuantityExpr_Power
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Power) -> bool {
	if fv, found := get_any(v, "base"); found { if !decode_i32(fv, &out.base) do return fail("QuantityExpr::Power.base") } else { return fail("QuantityExpr::Power.base missing") }
	if fv, found := get_any(v, "exponent"); found { if !dec_ptr_QuantityExpr(fv, &out.exponent) do return fail("QuantityExpr::Power.exponent") } else { return fail("QuantityExpr::Power.exponent missing") }
	return true
		}) { return fail("QuantityExpr::Power") }
		out^ = tmp
	case "Difference":
		tmp: QuantityExpr_Difference
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Difference) -> bool {
	if fv, found := get_any(v, "left"); found { if !dec_ptr_QuantityExpr(fv, &out.left) do return fail("QuantityExpr::Difference.left") } else { return fail("QuantityExpr::Difference.left missing") }
	if fv, found := get_any(v, "right"); found { if !dec_ptr_QuantityExpr(fv, &out.right) do return fail("QuantityExpr::Difference.right") } else { return fail("QuantityExpr::Difference.right missing") }
	return true
		}) { return fail("QuantityExpr::Difference") }
		out^ = tmp
	case "Max":
		tmp: QuantityExpr_Max
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Max) -> bool {
	if fv, found := get_any(v, "exprs"); found { if !dec_dyn_QuantityExpr(fv, &out.exprs) do return fail("QuantityExpr::Max.exprs") } else { return fail("QuantityExpr::Max.exprs missing") }
	return true
		}) { return fail("QuantityExpr::Max") }
		out^ = tmp
	case: return fail("QuantityExpr: unknown variant")
	}
	return true
}

encode_QuantityExpr :: proc(b: ^strings.Builder, x: QuantityExpr) {
	#partial switch y in x {
	case QuantityExpr_Ref: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Ref")
	member(b, first, "qty"); encode_QuantityRef(b, y.qty)
	}; strings.write_byte(b, '}')
	case QuantityExpr_Fixed: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Fixed")
	member(b, first, "value"); encode_i32(b, y.value)
	}; strings.write_byte(b, '}')
	case QuantityExpr_DivideRounded: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DivideRounded")
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)
	member(b, first, "divisor"); encode_u32(b, y.divisor)
	member(b, first, "rounding"); encode_RoundingMode(b, y.rounding)
	}; strings.write_byte(b, '}')
	case QuantityExpr_Offset: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Offset")
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)
	member(b, first, "offset"); encode_i32(b, y.offset)
	}; strings.write_byte(b, '}')
	case QuantityExpr_ClampMin: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ClampMin")
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)
	member(b, first, "minimum"); encode_i32(b, y.minimum)
	}; strings.write_byte(b, '}')
	case QuantityExpr_Multiply: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Multiply")
	member(b, first, "factor"); encode_i32(b, y.factor)
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)
	}; strings.write_byte(b, '}')
	case QuantityExpr_Sum: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Sum")
	member(b, first, "exprs"); enc_dyn_QuantityExpr(b, y.exprs)
	}; strings.write_byte(b, '}')
	case QuantityExpr_UpTo: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UpTo")
	member(b, first, "max"); enc_ptr_QuantityExpr(b, y.max)
	}; strings.write_byte(b, '}')
	case QuantityExpr_Power: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Power")
	member(b, first, "base"); encode_i32(b, y.base)
	member(b, first, "exponent"); enc_ptr_QuantityExpr(b, y.exponent)
	}; strings.write_byte(b, '}')
	case QuantityExpr_Difference: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Difference")
	member(b, first, "left"); enc_ptr_QuantityExpr(b, y.left)
	member(b, first, "right"); enc_ptr_QuantityExpr(b, y.right)
	}; strings.write_byte(b, '}')
	case QuantityExpr_Max: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Max")
	member(b, first, "exprs"); enc_dyn_QuantityExpr(b, y.exprs)
	}; strings.write_byte(b, '}')
	}
}

encode_QuantityExpr_members :: proc(b: ^strings.Builder, x: QuantityExpr, first: ^bool) {
	#partial switch y in x {
	case QuantityExpr_Ref: member(b, first, "type"); json.write_string(b, "Ref")
	member(b, first, "qty"); encode_QuantityRef(b, y.qty)

	case QuantityExpr_Fixed: member(b, first, "type"); json.write_string(b, "Fixed")
	member(b, first, "value"); encode_i32(b, y.value)

	case QuantityExpr_DivideRounded: member(b, first, "type"); json.write_string(b, "DivideRounded")
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)
	member(b, first, "divisor"); encode_u32(b, y.divisor)
	member(b, first, "rounding"); encode_RoundingMode(b, y.rounding)

	case QuantityExpr_Offset: member(b, first, "type"); json.write_string(b, "Offset")
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)
	member(b, first, "offset"); encode_i32(b, y.offset)

	case QuantityExpr_ClampMin: member(b, first, "type"); json.write_string(b, "ClampMin")
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)
	member(b, first, "minimum"); encode_i32(b, y.minimum)

	case QuantityExpr_Multiply: member(b, first, "type"); json.write_string(b, "Multiply")
	member(b, first, "factor"); encode_i32(b, y.factor)
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)

	case QuantityExpr_Sum: member(b, first, "type"); json.write_string(b, "Sum")
	member(b, first, "exprs"); enc_dyn_QuantityExpr(b, y.exprs)

	case QuantityExpr_UpTo: member(b, first, "type"); json.write_string(b, "UpTo")
	member(b, first, "max"); enc_ptr_QuantityExpr(b, y.max)

	case QuantityExpr_Power: member(b, first, "type"); json.write_string(b, "Power")
	member(b, first, "base"); encode_i32(b, y.base)
	member(b, first, "exponent"); enc_ptr_QuantityExpr(b, y.exponent)

	case QuantityExpr_Difference: member(b, first, "type"); json.write_string(b, "Difference")
	member(b, first, "left"); enc_ptr_QuantityExpr(b, y.left)
	member(b, first, "right"); enc_ptr_QuantityExpr(b, y.right)

	case QuantityExpr_Max: member(b, first, "type"); json.write_string(b, "Max")
	member(b, first, "exprs"); enc_dyn_QuantityExpr(b, y.exprs)

	}
}

decode_HexproofFilter :: proc(v: json.Value, out: ^HexproofFilter) -> bool {
	if v.kind != .Object do return fail("HexproofFilter: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("HexproofFilter: no tag")
	switch tv.text {
	case "Color": tmp: HexproofFilter_Color; if !decode_ManaColor(json.get_or_null(v, "data"), &tmp._0) do return fail("HexproofFilter::Color"); out^ = tmp
	case "CardType": tmp: HexproofFilter_CardType; if !decode_string(json.get_or_null(v, "data"), &tmp._0) do return fail("HexproofFilter::CardType"); out^ = tmp
	case "Quality": tmp: HexproofFilter_Quality; if !decode_string(json.get_or_null(v, "data"), &tmp._0) do return fail("HexproofFilter::Quality"); out^ = tmp
	case "ChosenColor": out^ = HexproofFilter_ChosenColor{}
	case: return fail("HexproofFilter: unknown variant")
	}
	return true
}

encode_HexproofFilter :: proc(b: ^strings.Builder, x: HexproofFilter) {
	#partial switch y in x {
	case HexproofFilter_Color: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Color"); member(b, &f, "data"); encode_ManaColor(b, y._0); strings.write_byte(b, '}')
	case HexproofFilter_CardType: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CardType"); member(b, &f, "data"); encode_string(b, y._0); strings.write_byte(b, '}')
	case HexproofFilter_Quality: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Quality"); member(b, &f, "data"); encode_string(b, y._0); strings.write_byte(b, '}')
	case HexproofFilter_ChosenColor: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChosenColor"); strings.write_byte(b, '}')
	}
}

decode_TargetFilter :: proc(v: json.Value, out: ^TargetFilter) -> bool {
	if v.kind != .Object do return fail("TargetFilter: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("TargetFilter: no tag")
	switch tv.text {
	case "None": out^ = TargetFilter_None{}
	case "Any": out^ = TargetFilter_Any{}
	case "Player": out^ = TargetFilter_Player{}
	case "Controller": out^ = TargetFilter_Controller{}
	case "SourceController": out^ = TargetFilter_SourceController{}
	case "ControllerAndControlledPermanents":
		tmp: TargetFilter_ControllerAndControlledPermanents
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_ControllerAndControlledPermanents) -> bool {
	if fv, found := get_any(v, "permanent_type"); found { if !dec_opt_CoreType(fv, &out.permanent_type) do return fail("TargetFilter::ControllerAndControlledPermanents.permanent_type") }
	if fv, found := get_any(v, "source_scope"); found { if !decode_SourceExclusion(fv, &out.source_scope) do return fail("TargetFilter::ControllerAndControlledPermanents.source_scope") }
	return true
		}) { return fail("TargetFilter::ControllerAndControlledPermanents") }
		out^ = tmp
	case "Opponent": out^ = TargetFilter_Opponent{}
	case "SelfRef": out^ = TargetFilter_SelfRef{}
	case "GrantingObject":
		tmp: TargetFilter_GrantingObject
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_GrantingObject) -> bool {
	if fv, found := get_any(v, "bound"); found { if !dec_opt_ObjectIncarnationRef(fv, &out.bound) do return fail("TargetFilter::GrantingObject.bound") }
	return true
		}) { return fail("TargetFilter::GrantingObject") }
		out^ = tmp
	case "SourceOrPaired": out^ = TargetFilter_SourceOrPaired{}
	case "Typed": tmp: TargetFilter_Typed; if !decode_TypedFilter(v, &tmp._0) do return fail("TargetFilter::Typed"); out^ = tmp
	case "Not":
		tmp: TargetFilter_Not
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_Not) -> bool {
	if fv, found := get_any(v, "filter"); found { if !dec_ptr_TargetFilter(fv, &out.filter) do return fail("TargetFilter::Not.filter") } else { return fail("TargetFilter::Not.filter missing") }
	return true
		}) { return fail("TargetFilter::Not") }
		out^ = tmp
	case "Or":
		tmp: TargetFilter_Or
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_Or) -> bool {
	if fv, found := get_any(v, "filters"); found { if !dec_dyn_TargetFilter(fv, &out.filters) do return fail("TargetFilter::Or.filters") } else { return fail("TargetFilter::Or.filters missing") }
	return true
		}) { return fail("TargetFilter::Or") }
		out^ = tmp
	case "And":
		tmp: TargetFilter_And
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_And) -> bool {
	if fv, found := get_any(v, "filters"); found { if !dec_dyn_TargetFilter(fv, &out.filters) do return fail("TargetFilter::And.filters") } else { return fail("TargetFilter::And.filters missing") }
	return true
		}) { return fail("TargetFilter::And") }
		out^ = tmp
	case "StackAbility":
		tmp: TargetFilter_StackAbility
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_StackAbility) -> bool {
	if fv, found := get_any(v, "controller"); found { if !dec_opt_ControllerRef(fv, &out.controller) do return fail("TargetFilter::StackAbility.controller") }
	if fv, found := get_any(v, "tag"); found { if !dec_opt_AbilityTag(fv, &out.tag) do return fail("TargetFilter::StackAbility.tag") }
	if fv, found := get_any(v, "kind"); found { if !dec_opt_StackAbilityKind(fv, &out.kind) do return fail("TargetFilter::StackAbility.kind") }
	return true
		}) { return fail("TargetFilter::StackAbility") }
		out^ = tmp
	case "StackSpell": out^ = TargetFilter_StackSpell{}
	case "CastingSpell": out^ = TargetFilter_CastingSpell{}
	case "SpecificObject":
		tmp: TargetFilter_SpecificObject
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_SpecificObject) -> bool {
	if fv, found := get_any(v, "id"); found { if !decode_ObjectId(fv, &out.id) do return fail("TargetFilter::SpecificObject.id") } else { return fail("TargetFilter::SpecificObject.id missing") }
	return true
		}) { return fail("TargetFilter::SpecificObject") }
		out^ = tmp
	case "SpecificPlayer":
		tmp: TargetFilter_SpecificPlayer
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_SpecificPlayer) -> bool {
	if fv, found := get_any(v, "id"); found { if !decode_PlayerId(fv, &out.id) do return fail("TargetFilter::SpecificPlayer.id") } else { return fail("TargetFilter::SpecificPlayer.id missing") }
	return true
		}) { return fail("TargetFilter::SpecificPlayer") }
		out^ = tmp
	case "PlayerWhoChoseLabel":
		tmp: TargetFilter_PlayerWhoChoseLabel
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_PlayerWhoChoseLabel) -> bool {
	if fv, found := get_any(v, "label"); found { if !decode_string(fv, &out.label) do return fail("TargetFilter::PlayerWhoChoseLabel.label") } else { return fail("TargetFilter::PlayerWhoChoseLabel.label missing") }
	return true
		}) { return fail("TargetFilter::PlayerWhoChoseLabel") }
		out^ = tmp
	case "PlayerMatching":
		tmp: TargetFilter_PlayerMatching
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_PlayerMatching) -> bool {
	if fv, found := get_any(v, "player"); found { if !dec_ptr_PlayerFilter(fv, &out.player) do return fail("TargetFilter::PlayerMatching.player") } else { return fail("TargetFilter::PlayerMatching.player missing") }
	return true
		}) { return fail("TargetFilter::PlayerMatching") }
		out^ = tmp
	case "Neighbor":
		tmp: TargetFilter_Neighbor
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_Neighbor) -> bool {
	if fv, found := get_any(v, "direction"); found { if !decode_SeatDirection(fv, &out.direction) do return fail("TargetFilter::Neighbor.direction") } else { return fail("TargetFilter::Neighbor.direction missing") }
	return true
		}) { return fail("TargetFilter::Neighbor") }
		out^ = tmp
	case "ScopedPlayer": out^ = TargetFilter_ScopedPlayer{}
	case "AttachedTo": out^ = TargetFilter_AttachedTo{}
	case "LastCreated": out^ = TargetFilter_LastCreated{}
	case "LastRevealed": out^ = TargetFilter_LastRevealed{}
	case "LastZoneChanged": out^ = TargetFilter_LastZoneChanged{}
	case "CostPaidObject": out^ = TargetFilter_CostPaidObject{}
	case "AmassedArmy": out^ = TargetFilter_AmassedArmy{}
	case "ChosenCard": out^ = TargetFilter_ChosenCard{}
	case "TrackedSet":
		tmp: TargetFilter_TrackedSet
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_TrackedSet) -> bool {
	if fv, found := get_any(v, "id"); found { if !decode_TrackedSetId(fv, &out.id) do return fail("TargetFilter::TrackedSet.id") } else { return fail("TargetFilter::TrackedSet.id missing") }
	return true
		}) { return fail("TargetFilter::TrackedSet") }
		out^ = tmp
	case "TrackedSetFiltered":
		tmp: TargetFilter_TrackedSetFiltered
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_TrackedSetFiltered) -> bool {
	if fv, found := get_any(v, "id"); found { if !decode_TrackedSetId(fv, &out.id) do return fail("TargetFilter::TrackedSetFiltered.id") } else { return fail("TargetFilter::TrackedSetFiltered.id missing") }
	if fv, found := get_any(v, "filter"); found { if !dec_ptr_TargetFilter(fv, &out.filter) do return fail("TargetFilter::TrackedSetFiltered.filter") } else { return fail("TargetFilter::TrackedSetFiltered.filter missing") }
	if fv, found := get_any(v, "caused_by"); found { if !dec_opt_ThisWayCause(fv, &out.caused_by) do return fail("TargetFilter::TrackedSetFiltered.caused_by") }
	return true
		}) { return fail("TargetFilter::TrackedSetFiltered") }
		out^ = tmp
	case "ChoiceAssignment":
		tmp: TargetFilter_ChoiceAssignment
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_ChoiceAssignment) -> bool {
	if fv, found := get_any(v, "side"); found { if !decode_ChoiceAssignmentSide(fv, &out.side) do return fail("TargetFilter::ChoiceAssignment.side") } else { return fail("TargetFilter::ChoiceAssignment.side missing") }
	return true
		}) { return fail("TargetFilter::ChoiceAssignment") }
		out^ = tmp
	case "ExiledBySource": out^ = TargetFilter_ExiledBySource{}
	case "ExiledCardByIndex":
		tmp: TargetFilter_ExiledCardByIndex
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_ExiledCardByIndex) -> bool {
	if fv, found := get_any(v, "index"); found { if !decode_u32(fv, &out.index) do return fail("TargetFilter::ExiledCardByIndex.index") } else { return fail("TargetFilter::ExiledCardByIndex.index missing") }
	return true
		}) { return fail("TargetFilter::ExiledCardByIndex") }
		out^ = tmp
	case "TriggeringSpellController": out^ = TargetFilter_TriggeringSpellController{}
	case "TriggeringSpellOwner": out^ = TargetFilter_TriggeringSpellOwner{}
	case "TriggeringPlayer": out^ = TargetFilter_TriggeringPlayer{}
	case "TriggeringSource": out^ = TargetFilter_TriggeringSource{}
	case "AttackedPlayerOrPlaneswalker": out^ = TargetFilter_AttackedPlayerOrPlaneswalker{}
	case "EventTarget": out^ = TargetFilter_EventTarget{}
	case "TriggeringSourceController": out^ = TargetFilter_TriggeringSourceController{}
	case "EventTargetController": out^ = TargetFilter_EventTargetController{}
	case "ParentTarget": out^ = TargetFilter_ParentTarget{}
	case "ParentTargetSlot":
		tmp: TargetFilter_ParentTargetSlot
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_ParentTargetSlot) -> bool {
	if fv, found := get_any(v, "index"); found { if !decode_int(fv, &out.index) do return fail("TargetFilter::ParentTargetSlot.index") } else { return fail("TargetFilter::ParentTargetSlot.index missing") }
	return true
		}) { return fail("TargetFilter::ParentTargetSlot") }
		out^ = tmp
	case "DeclaredPlayer":
		tmp: TargetFilter_DeclaredPlayer
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_DeclaredPlayer) -> bool {
	if fv, found := get_any(v, "group"); found { if !decode_ChosenGroupId(fv, &out.group) do return fail("TargetFilter::DeclaredPlayer.group") } else { return fail("TargetFilter::DeclaredPlayer.group missing") }
	return true
		}) { return fail("TargetFilter::DeclaredPlayer") }
		out^ = tmp
	case "ParentTargetController": out^ = TargetFilter_ParentTargetController{}
	case "ParentTargetOwner": out^ = TargetFilter_ParentTargetOwner{}
	case "AffectedObjectOwner": out^ = TargetFilter_AffectedObjectOwner{}
	case "SourceChosenPlayer": out^ = TargetFilter_SourceChosenPlayer{}
	case "OriginalController": out^ = TargetFilter_OriginalController{}
	case "OriginalSource": out^ = TargetFilter_OriginalSource{}
	case "PostReplacementSourceController": out^ = TargetFilter_PostReplacementSourceController{}
	case "PostReplacementDamageSource": out^ = TargetFilter_PostReplacementDamageSource{}
	case "PostReplacementDamageTarget": out^ = TargetFilter_PostReplacementDamageTarget{}
	case "PostReplacementDamageTargetOwner": out^ = TargetFilter_PostReplacementDamageTargetOwner{}
	case "DefendingPlayer": out^ = TargetFilter_DefendingPlayer{}
	case "HasChosenName": out^ = TargetFilter_HasChosenName{}
	case "ChosenDamageSource":
		tmp: TargetFilter_ChosenDamageSource
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_ChosenDamageSource) -> bool {
	if fv, found := get_any(v, "filter"); found { if !dec_ptr_TargetFilter(fv, &out.filter) do return fail("TargetFilter::ChosenDamageSource.filter") }
	return true
		}) { return fail("TargetFilter::ChosenDamageSource") }
		out^ = tmp
	case "Named":
		tmp: TargetFilter_Named
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TargetFilter_Named) -> bool {
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("TargetFilter::Named.name") } else { return fail("TargetFilter::Named.name missing") }
	return true
		}) { return fail("TargetFilter::Named") }
		out^ = tmp
	case "Owner": out^ = TargetFilter_Owner{}
	case "AllPlayers": out^ = TargetFilter_AllPlayers{}
	case: return fail("TargetFilter: unknown variant")
	}
	return true
}

encode_TargetFilter :: proc(b: ^strings.Builder, x: TargetFilter) {
	#partial switch y in x {
	case TargetFilter_None: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "None"); strings.write_byte(b, '}')
	case TargetFilter_Any: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Any"); strings.write_byte(b, '}')
	case TargetFilter_Player: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Player"); strings.write_byte(b, '}')
	case TargetFilter_Controller: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Controller"); strings.write_byte(b, '}')
	case TargetFilter_SourceController: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceController"); strings.write_byte(b, '}')
	case TargetFilter_ControllerAndControlledPermanents: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControllerAndControlledPermanents")
	member(b, first, "permanent_type"); enc_opt_CoreType(b, y.permanent_type)
	if !(skip_TargetFilter_SourceExclusion_is_include(y.source_scope)) { member(b, first, "source_scope"); encode_SourceExclusion(b, y.source_scope) }
	}; strings.write_byte(b, '}')
	case TargetFilter_Opponent: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Opponent"); strings.write_byte(b, '}')
	case TargetFilter_SelfRef: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SelfRef"); strings.write_byte(b, '}')
	case TargetFilter_GrantingObject: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GrantingObject")
	if !(y.bound == nil) { member(b, first, "bound"); enc_opt_ObjectIncarnationRef(b, y.bound) }
	}; strings.write_byte(b, '}')
	case TargetFilter_SourceOrPaired: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceOrPaired"); strings.write_byte(b, '}')
	case TargetFilter_Typed: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Typed"); encode_TypedFilter_members(b, y._0, &f); strings.write_byte(b, '}')
	case TargetFilter_Not: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Not")
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case TargetFilter_Or: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Or")
	member(b, first, "filters"); enc_dyn_TargetFilter(b, y.filters)
	}; strings.write_byte(b, '}')
	case TargetFilter_And: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "And")
	member(b, first, "filters"); enc_dyn_TargetFilter(b, y.filters)
	}; strings.write_byte(b, '}')
	case TargetFilter_StackAbility: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "StackAbility")
	if !(y.controller == nil) { member(b, first, "controller"); enc_opt_ControllerRef(b, y.controller) }
	if !(y.tag == nil) { member(b, first, "tag"); enc_opt_AbilityTag(b, y.tag) }
	if !(y.kind == nil) { member(b, first, "kind"); enc_opt_StackAbilityKind(b, y.kind) }
	}; strings.write_byte(b, '}')
	case TargetFilter_StackSpell: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "StackSpell"); strings.write_byte(b, '}')
	case TargetFilter_CastingSpell: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CastingSpell"); strings.write_byte(b, '}')
	case TargetFilter_SpecificObject: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SpecificObject")
	member(b, first, "id"); encode_ObjectId(b, y.id)
	}; strings.write_byte(b, '}')
	case TargetFilter_SpecificPlayer: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SpecificPlayer")
	member(b, first, "id"); encode_PlayerId(b, y.id)
	}; strings.write_byte(b, '}')
	case TargetFilter_PlayerWhoChoseLabel: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PlayerWhoChoseLabel")
	member(b, first, "label"); encode_string(b, y.label)
	}; strings.write_byte(b, '}')
	case TargetFilter_PlayerMatching: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PlayerMatching")
	member(b, first, "player"); enc_ptr_PlayerFilter(b, y.player)
	}; strings.write_byte(b, '}')
	case TargetFilter_Neighbor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Neighbor")
	member(b, first, "direction"); encode_SeatDirection(b, y.direction)
	}; strings.write_byte(b, '}')
	case TargetFilter_ScopedPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ScopedPlayer"); strings.write_byte(b, '}')
	case TargetFilter_AttachedTo: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AttachedTo"); strings.write_byte(b, '}')
	case TargetFilter_LastCreated: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "LastCreated"); strings.write_byte(b, '}')
	case TargetFilter_LastRevealed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "LastRevealed"); strings.write_byte(b, '}')
	case TargetFilter_LastZoneChanged: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "LastZoneChanged"); strings.write_byte(b, '}')
	case TargetFilter_CostPaidObject: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CostPaidObject"); strings.write_byte(b, '}')
	case TargetFilter_AmassedArmy: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AmassedArmy"); strings.write_byte(b, '}')
	case TargetFilter_ChosenCard: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChosenCard"); strings.write_byte(b, '}')
	case TargetFilter_TrackedSet: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TrackedSet")
	member(b, first, "id"); encode_TrackedSetId(b, y.id)
	}; strings.write_byte(b, '}')
	case TargetFilter_TrackedSetFiltered: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TrackedSetFiltered")
	member(b, first, "id"); encode_TrackedSetId(b, y.id)
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)
	if !(y.caused_by == nil) { member(b, first, "caused_by"); enc_opt_ThisWayCause(b, y.caused_by) }
	}; strings.write_byte(b, '}')
	case TargetFilter_ChoiceAssignment: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChoiceAssignment")
	member(b, first, "side"); encode_ChoiceAssignmentSide(b, y.side)
	}; strings.write_byte(b, '}')
	case TargetFilter_ExiledBySource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ExiledBySource"); strings.write_byte(b, '}')
	case TargetFilter_ExiledCardByIndex: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ExiledCardByIndex")
	member(b, first, "index"); encode_u32(b, y.index)
	}; strings.write_byte(b, '}')
	case TargetFilter_TriggeringSpellController: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TriggeringSpellController"); strings.write_byte(b, '}')
	case TargetFilter_TriggeringSpellOwner: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TriggeringSpellOwner"); strings.write_byte(b, '}')
	case TargetFilter_TriggeringPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TriggeringPlayer"); strings.write_byte(b, '}')
	case TargetFilter_TriggeringSource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TriggeringSource"); strings.write_byte(b, '}')
	case TargetFilter_AttackedPlayerOrPlaneswalker: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AttackedPlayerOrPlaneswalker"); strings.write_byte(b, '}')
	case TargetFilter_EventTarget: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EventTarget"); strings.write_byte(b, '}')
	case TargetFilter_TriggeringSourceController: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TriggeringSourceController"); strings.write_byte(b, '}')
	case TargetFilter_EventTargetController: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EventTargetController"); strings.write_byte(b, '}')
	case TargetFilter_ParentTarget: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ParentTarget"); strings.write_byte(b, '}')
	case TargetFilter_ParentTargetSlot: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ParentTargetSlot")
	member(b, first, "index"); encode_int(b, y.index)
	}; strings.write_byte(b, '}')
	case TargetFilter_DeclaredPlayer: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DeclaredPlayer")
	member(b, first, "group"); encode_ChosenGroupId(b, y.group)
	}; strings.write_byte(b, '}')
	case TargetFilter_ParentTargetController: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ParentTargetController"); strings.write_byte(b, '}')
	case TargetFilter_ParentTargetOwner: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ParentTargetOwner"); strings.write_byte(b, '}')
	case TargetFilter_AffectedObjectOwner: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AffectedObjectOwner"); strings.write_byte(b, '}')
	case TargetFilter_SourceChosenPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceChosenPlayer"); strings.write_byte(b, '}')
	case TargetFilter_OriginalController: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OriginalController"); strings.write_byte(b, '}')
	case TargetFilter_OriginalSource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OriginalSource"); strings.write_byte(b, '}')
	case TargetFilter_PostReplacementSourceController: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PostReplacementSourceController"); strings.write_byte(b, '}')
	case TargetFilter_PostReplacementDamageSource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PostReplacementDamageSource"); strings.write_byte(b, '}')
	case TargetFilter_PostReplacementDamageTarget: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PostReplacementDamageTarget"); strings.write_byte(b, '}')
	case TargetFilter_PostReplacementDamageTargetOwner: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PostReplacementDamageTargetOwner"); strings.write_byte(b, '}')
	case TargetFilter_DefendingPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DefendingPlayer"); strings.write_byte(b, '}')
	case TargetFilter_HasChosenName: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasChosenName"); strings.write_byte(b, '}')
	case TargetFilter_ChosenDamageSource: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChosenDamageSource")
	if !(y.filter == nil) { member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter) }
	}; strings.write_byte(b, '}')
	case TargetFilter_Named: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Named")
	member(b, first, "name"); encode_string(b, y.name)
	}; strings.write_byte(b, '}')
	case TargetFilter_Owner: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Owner"); strings.write_byte(b, '}')
	case TargetFilter_AllPlayers: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AllPlayers"); strings.write_byte(b, '}')
	}
}

encode_TargetFilter_members :: proc(b: ^strings.Builder, x: TargetFilter, first: ^bool) {
	#partial switch y in x {
	case TargetFilter_None: _ = y; member(b, first, "type"); json.write_string(b, "None")
	case TargetFilter_Any: _ = y; member(b, first, "type"); json.write_string(b, "Any")
	case TargetFilter_Player: _ = y; member(b, first, "type"); json.write_string(b, "Player")
	case TargetFilter_Controller: _ = y; member(b, first, "type"); json.write_string(b, "Controller")
	case TargetFilter_SourceController: _ = y; member(b, first, "type"); json.write_string(b, "SourceController")
	case TargetFilter_ControllerAndControlledPermanents: member(b, first, "type"); json.write_string(b, "ControllerAndControlledPermanents")
	member(b, first, "permanent_type"); enc_opt_CoreType(b, y.permanent_type)
	if !(skip_TargetFilter_SourceExclusion_is_include(y.source_scope)) { member(b, first, "source_scope"); encode_SourceExclusion(b, y.source_scope) }

	case TargetFilter_Opponent: _ = y; member(b, first, "type"); json.write_string(b, "Opponent")
	case TargetFilter_SelfRef: _ = y; member(b, first, "type"); json.write_string(b, "SelfRef")
	case TargetFilter_GrantingObject: member(b, first, "type"); json.write_string(b, "GrantingObject")
	if !(y.bound == nil) { member(b, first, "bound"); enc_opt_ObjectIncarnationRef(b, y.bound) }

	case TargetFilter_SourceOrPaired: _ = y; member(b, first, "type"); json.write_string(b, "SourceOrPaired")
	case TargetFilter_Typed: member(b, first, "type"); json.write_string(b, "Typed"); encode_TypedFilter_members(b, y._0, first)
	case TargetFilter_Not: member(b, first, "type"); json.write_string(b, "Not")
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)

	case TargetFilter_Or: member(b, first, "type"); json.write_string(b, "Or")
	member(b, first, "filters"); enc_dyn_TargetFilter(b, y.filters)

	case TargetFilter_And: member(b, first, "type"); json.write_string(b, "And")
	member(b, first, "filters"); enc_dyn_TargetFilter(b, y.filters)

	case TargetFilter_StackAbility: member(b, first, "type"); json.write_string(b, "StackAbility")
	if !(y.controller == nil) { member(b, first, "controller"); enc_opt_ControllerRef(b, y.controller) }
	if !(y.tag == nil) { member(b, first, "tag"); enc_opt_AbilityTag(b, y.tag) }
	if !(y.kind == nil) { member(b, first, "kind"); enc_opt_StackAbilityKind(b, y.kind) }

	case TargetFilter_StackSpell: _ = y; member(b, first, "type"); json.write_string(b, "StackSpell")
	case TargetFilter_CastingSpell: _ = y; member(b, first, "type"); json.write_string(b, "CastingSpell")
	case TargetFilter_SpecificObject: member(b, first, "type"); json.write_string(b, "SpecificObject")
	member(b, first, "id"); encode_ObjectId(b, y.id)

	case TargetFilter_SpecificPlayer: member(b, first, "type"); json.write_string(b, "SpecificPlayer")
	member(b, first, "id"); encode_PlayerId(b, y.id)

	case TargetFilter_PlayerWhoChoseLabel: member(b, first, "type"); json.write_string(b, "PlayerWhoChoseLabel")
	member(b, first, "label"); encode_string(b, y.label)

	case TargetFilter_PlayerMatching: member(b, first, "type"); json.write_string(b, "PlayerMatching")
	member(b, first, "player"); enc_ptr_PlayerFilter(b, y.player)

	case TargetFilter_Neighbor: member(b, first, "type"); json.write_string(b, "Neighbor")
	member(b, first, "direction"); encode_SeatDirection(b, y.direction)

	case TargetFilter_ScopedPlayer: _ = y; member(b, first, "type"); json.write_string(b, "ScopedPlayer")
	case TargetFilter_AttachedTo: _ = y; member(b, first, "type"); json.write_string(b, "AttachedTo")
	case TargetFilter_LastCreated: _ = y; member(b, first, "type"); json.write_string(b, "LastCreated")
	case TargetFilter_LastRevealed: _ = y; member(b, first, "type"); json.write_string(b, "LastRevealed")
	case TargetFilter_LastZoneChanged: _ = y; member(b, first, "type"); json.write_string(b, "LastZoneChanged")
	case TargetFilter_CostPaidObject: _ = y; member(b, first, "type"); json.write_string(b, "CostPaidObject")
	case TargetFilter_AmassedArmy: _ = y; member(b, first, "type"); json.write_string(b, "AmassedArmy")
	case TargetFilter_ChosenCard: _ = y; member(b, first, "type"); json.write_string(b, "ChosenCard")
	case TargetFilter_TrackedSet: member(b, first, "type"); json.write_string(b, "TrackedSet")
	member(b, first, "id"); encode_TrackedSetId(b, y.id)

	case TargetFilter_TrackedSetFiltered: member(b, first, "type"); json.write_string(b, "TrackedSetFiltered")
	member(b, first, "id"); encode_TrackedSetId(b, y.id)
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)
	if !(y.caused_by == nil) { member(b, first, "caused_by"); enc_opt_ThisWayCause(b, y.caused_by) }

	case TargetFilter_ChoiceAssignment: member(b, first, "type"); json.write_string(b, "ChoiceAssignment")
	member(b, first, "side"); encode_ChoiceAssignmentSide(b, y.side)

	case TargetFilter_ExiledBySource: _ = y; member(b, first, "type"); json.write_string(b, "ExiledBySource")
	case TargetFilter_ExiledCardByIndex: member(b, first, "type"); json.write_string(b, "ExiledCardByIndex")
	member(b, first, "index"); encode_u32(b, y.index)

	case TargetFilter_TriggeringSpellController: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringSpellController")
	case TargetFilter_TriggeringSpellOwner: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringSpellOwner")
	case TargetFilter_TriggeringPlayer: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringPlayer")
	case TargetFilter_TriggeringSource: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringSource")
	case TargetFilter_AttackedPlayerOrPlaneswalker: _ = y; member(b, first, "type"); json.write_string(b, "AttackedPlayerOrPlaneswalker")
	case TargetFilter_EventTarget: _ = y; member(b, first, "type"); json.write_string(b, "EventTarget")
	case TargetFilter_TriggeringSourceController: _ = y; member(b, first, "type"); json.write_string(b, "TriggeringSourceController")
	case TargetFilter_EventTargetController: _ = y; member(b, first, "type"); json.write_string(b, "EventTargetController")
	case TargetFilter_ParentTarget: _ = y; member(b, first, "type"); json.write_string(b, "ParentTarget")
	case TargetFilter_ParentTargetSlot: member(b, first, "type"); json.write_string(b, "ParentTargetSlot")
	member(b, first, "index"); encode_int(b, y.index)

	case TargetFilter_DeclaredPlayer: member(b, first, "type"); json.write_string(b, "DeclaredPlayer")
	member(b, first, "group"); encode_ChosenGroupId(b, y.group)

	case TargetFilter_ParentTargetController: _ = y; member(b, first, "type"); json.write_string(b, "ParentTargetController")
	case TargetFilter_ParentTargetOwner: _ = y; member(b, first, "type"); json.write_string(b, "ParentTargetOwner")
	case TargetFilter_AffectedObjectOwner: _ = y; member(b, first, "type"); json.write_string(b, "AffectedObjectOwner")
	case TargetFilter_SourceChosenPlayer: _ = y; member(b, first, "type"); json.write_string(b, "SourceChosenPlayer")
	case TargetFilter_OriginalController: _ = y; member(b, first, "type"); json.write_string(b, "OriginalController")
	case TargetFilter_OriginalSource: _ = y; member(b, first, "type"); json.write_string(b, "OriginalSource")
	case TargetFilter_PostReplacementSourceController: _ = y; member(b, first, "type"); json.write_string(b, "PostReplacementSourceController")
	case TargetFilter_PostReplacementDamageSource: _ = y; member(b, first, "type"); json.write_string(b, "PostReplacementDamageSource")
	case TargetFilter_PostReplacementDamageTarget: _ = y; member(b, first, "type"); json.write_string(b, "PostReplacementDamageTarget")
	case TargetFilter_PostReplacementDamageTargetOwner: _ = y; member(b, first, "type"); json.write_string(b, "PostReplacementDamageTargetOwner")
	case TargetFilter_DefendingPlayer: _ = y; member(b, first, "type"); json.write_string(b, "DefendingPlayer")
	case TargetFilter_HasChosenName: _ = y; member(b, first, "type"); json.write_string(b, "HasChosenName")
	case TargetFilter_ChosenDamageSource: member(b, first, "type"); json.write_string(b, "ChosenDamageSource")
	if !(y.filter == nil) { member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter) }

	case TargetFilter_Named: member(b, first, "type"); json.write_string(b, "Named")
	member(b, first, "name"); encode_string(b, y.name)

	case TargetFilter_Owner: _ = y; member(b, first, "type"); json.write_string(b, "Owner")
	case TargetFilter_AllPlayers: _ = y; member(b, first, "type"); json.write_string(b, "AllPlayers")
	}
}

decode_BestowCost :: proc(v: json.Value, out: ^BestowCost) -> bool {
	if v.kind != .Object do return fail("BestowCost: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("BestowCost: no tag")
	switch tv.text {
	case "Mana": tmp: BestowCost_Mana; if !decode_ManaCost(json.get_or_null(v, "data"), &tmp._0) do return fail("BestowCost::Mana"); out^ = tmp
	case "NonMana": tmp: BestowCost_NonMana; if !decode_AbilityCost(json.get_or_null(v, "data"), &tmp._0) do return fail("BestowCost::NonMana"); out^ = tmp
	case: return fail("BestowCost: unknown variant")
	}
	return true
}

encode_BestowCost :: proc(b: ^strings.Builder, x: BestowCost) {
	#partial switch y in x {
	case BestowCost_Mana: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Mana"); member(b, &f, "data"); encode_ManaCost(b, y._0); strings.write_byte(b, '}')
	case BestowCost_NonMana: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NonMana"); member(b, &f, "data"); encode_AbilityCost(b, y._0); strings.write_byte(b, '}')
	}
}

