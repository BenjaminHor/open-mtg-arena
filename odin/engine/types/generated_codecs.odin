	if fv, found := get_any(v, "grants_freerunning"); found { if !decode_bool(fv, &out.grants_freerunning) do return fail("TriggerCollectionOperation::RecordCombatDamageCastingPermission.grants_freerunning") } else { return fail("TriggerCollectionOperation::RecordCombatDamageCastingPermission.grants_freerunning missing") }
