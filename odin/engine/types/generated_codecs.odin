	case UntilCondition_CumulativeThreshold: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CumulativeThreshold")
	member(b, first, "property"); encode_ObjectProperty(b, y.property)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
