	if fv, found := get_any(v, "mana_type"); found { if !decode_ManaType(fv, &out.mana_type) do return fail("ManaSourceSelection.mana_type") } else { return fail("ManaSourceSelection.mana_type missing") }
	if fv, found := get_any(v, "output"); found { if !decode_ManaSourceOutput(fv, &out.output) do return fail("ManaSourceSelection.output") } else { return fail("ManaSourceSelection.output missing") }
	if fv, found := get_any(v, "atomic_combination"); found { if !dec_opt_dyn_ManaType(fv, &out.atomic_combination) do return fail("ManaSourceSelection.atomic_combination") }
	if fv, found := get_any(v, "restrictions"); found { if !dec_dyn_ManaRestriction(fv, &out.restrictions) do return fail("ManaSourceSelection.restrictions") } else { return fail("ManaSourceSelection.restrictions missing") }
	if fv, found := get_any(v, "penalty"); found { if !decode_ManaSourcePenalty(fv, &out.penalty) do return fail("ManaSourceSelection.penalty") } else { return fail("ManaSourceSelection.penalty missing") }
	if fv, found := get_any(v, "taps_for_mana"); found { if !dec_dyn_TapsForManaSelection(fv, &out.taps_for_mana) do return fail("ManaSourceSelection.taps_for_mana") } else { return fail("ManaSourceSelection.taps_for_mana missing") }
	return true
}

