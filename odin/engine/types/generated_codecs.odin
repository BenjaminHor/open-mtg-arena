decode_StackEntryKind :: proc(v: json.Value, out: ^StackEntryKind) -> bool {
	when COVERAGE do cov_hit("StackEntryKind")
	if v.kind != .Object do return fail("StackEntryKind: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("StackEntryKind: no tag")
	switch tv.text {
	case "Spell": when COVERAGE do cov_hit("StackEntryKind::Spell");
		tmp: StackEntryKind_Spell
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^StackEntryKind_Spell) -> bool {
	if fv, found := get_any(v, "card_id"); found { if !decode_CardId(fv, &out.card_id) do return fail("StackEntryKind::Spell.card_id") } else { return fail("StackEntryKind::Spell.card_id missing") }
	if fv, found := get_any(v, "ability"); found { if !dec_ptr_ResolvedAbility(fv, &out.ability) do return fail("StackEntryKind::Spell.ability") }
	if fv, found := get_any(v, "casting_variant"); found { if !decode_CastingVariant(fv, &out.casting_variant) do return fail("StackEntryKind::Spell.casting_variant") } else { out.casting_variant = CastingVariant(CastingVariant_Normal{}) }
	if fv, found := get_any(v, "actual_mana_spent"); found { if !decode_u32(fv, &out.actual_mana_spent) do return fail("StackEntryKind::Spell.actual_mana_spent") }
	return true
		}) { return fail("StackEntryKind::Spell") }
		out^ = tmp
	case "ActivatedAbility": when COVERAGE do cov_hit("StackEntryKind::ActivatedAbility");
		tmp: StackEntryKind_ActivatedAbility
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^StackEntryKind_ActivatedAbility) -> bool {
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("StackEntryKind::ActivatedAbility.source_id") } else { return fail("StackEntryKind::ActivatedAbility.source_id missing") }
	if fv, found := get_any(v, "ability"); found { if !dec_ptr_ResolvedAbility(fv, &out.ability) do return fail("StackEntryKind::ActivatedAbility.ability") } else { return fail("StackEntryKind::ActivatedAbility.ability missing") }
	return true
		}) { return fail("StackEntryKind::ActivatedAbility") }
		out^ = tmp
	case "TriggeredAbility": when COVERAGE do cov_hit("StackEntryKind::TriggeredAbility");
		tmp: StackEntryKind_TriggeredAbility
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^StackEntryKind_TriggeredAbility) -> bool {
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("StackEntryKind::TriggeredAbility.source_id") } else { return fail("StackEntryKind::TriggeredAbility.source_id missing") }
	if fv, found := get_any(v, "ability"); found { if !dec_ptr_ResolvedAbility(fv, &out.ability) do return fail("StackEntryKind::TriggeredAbility.ability") } else { return fail("StackEntryKind::TriggeredAbility.ability missing") }
	if fv, found := get_any(v, "condition"); found { if !dec_opt_TriggerCondition(fv, &out.condition) do return fail("StackEntryKind::TriggeredAbility.condition") }
	if fv, found := get_any(v, "trigger_event"); found { if !dec_opt_GameEvent(fv, &out.trigger_event) do return fail("StackEntryKind::TriggeredAbility.trigger_event") }
	if fv, found := get_any(v, "description"); found { if !dec_opt_string(fv, &out.description) do return fail("StackEntryKind::TriggeredAbility.description") }
	if fv, found := get_any(v, "source_name"); found { if !decode_string(fv, &out.source_name) do return fail("StackEntryKind::TriggeredAbility.source_name") }
	if fv, found := get_any(v, "subject_match_count"); found { if !dec_opt_u32(fv, &out.subject_match_count) do return fail("StackEntryKind::TriggeredAbility.subject_match_count") }
	if fv, found := get_any(v, "die_result"); found { if !dec_opt_i32(fv, &out.die_result) do return fail("StackEntryKind::TriggeredAbility.die_result") }
	if fv, found := get_any(v, "provenance"); found { if !dec_opt_SyntheticTriggerProvenance(fv, &out.provenance) do return fail("StackEntryKind::TriggeredAbility.provenance") }
	return true
		}) { return fail("StackEntryKind::TriggeredAbility") }
		out^ = tmp
	case "KeywordAction": when COVERAGE do cov_hit("StackEntryKind::KeywordAction");
		tmp: StackEntryKind_KeywordAction
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^StackEntryKind_KeywordAction) -> bool {
	if fv, found := get_any(v, "action"); found { if !decode_KeywordAction(fv, &out.action) do return fail("StackEntryKind::KeywordAction.action") } else { return fail("StackEntryKind::KeywordAction.action missing") }
	return true
		}) { return fail("StackEntryKind::KeywordAction") }
		out^ = tmp
	case "CombatDamage": when COVERAGE do cov_hit("StackEntryKind::CombatDamage");
		tmp: StackEntryKind_CombatDamage
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^StackEntryKind_CombatDamage) -> bool {
	if fv, found := get_any(v, "sub_step"); found { if !decode_CombatDamageSubStep(fv, &out.sub_step) do return fail("StackEntryKind::CombatDamage.sub_step") } else { return fail("StackEntryKind::CombatDamage.sub_step missing") }
	if fv, found := get_any(v, "assignments"); found { if !dec_dyn_AssignedCombatDamage(fv, &out.assignments) do return fail("StackEntryKind::CombatDamage.assignments") } else { return fail("StackEntryKind::CombatDamage.assignments missing") }
	return true
		}) { return fail("StackEntryKind::CombatDamage") }
		out^ = tmp
	case: return fail("StackEntryKind: unknown variant")
	}
	return true
}

encode_StackEntryKind :: proc(b: ^strings.Builder, x: StackEntryKind) {
	#partial switch y in x {
	case StackEntryKind_Spell: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Spell"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card_id"); encode_CardId(b, y.card_id)
	if !(y.ability == nil) { member(b, first, "ability"); enc_ptr_ResolvedAbility(b, y.ability) }
	member(b, first, "casting_variant"); encode_CastingVariant(b, y.casting_variant)
	member(b, first, "actual_mana_spent"); encode_u32(b, y.actual_mana_spent)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StackEntryKind_ActivatedAbility: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ActivatedAbility"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "ability"); enc_ptr_ResolvedAbility(b, y.ability)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StackEntryKind_TriggeredAbility: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TriggeredAbility"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "ability"); enc_ptr_ResolvedAbility(b, y.ability)
	member(b, first, "condition"); enc_opt_TriggerCondition(b, y.condition)
	if !(y.trigger_event == nil) { member(b, first, "trigger_event"); enc_opt_GameEvent(b, y.trigger_event) }
	if !(y.description == nil) { member(b, first, "description"); enc_opt_string(b, y.description) }
	if !((len(y.source_name) == 0)) { member(b, first, "source_name"); encode_string(b, y.source_name) }
	if !(y.subject_match_count == nil) { member(b, first, "subject_match_count"); enc_opt_u32(b, y.subject_match_count) }
	if !(y.die_result == nil) { member(b, first, "die_result"); enc_opt_i32(b, y.die_result) }
	if !(y.provenance == nil) { member(b, first, "provenance"); enc_opt_SyntheticTriggerProvenance(b, y.provenance) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StackEntryKind_KeywordAction: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "KeywordAction"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "action"); encode_KeywordAction(b, y.action)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StackEntryKind_CombatDamage: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CombatDamage"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "sub_step"); encode_CombatDamageSubStep(b, y.sub_step)
	member(b, first, "assignments"); enc_dyn_AssignedCombatDamage(b, y.assignments)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_CardId :: proc(v: json.Value, out: ^CardId) -> bool {
	when COVERAGE do cov_hit("CardId")
	return decode_u64(v, cast(^u64)out)
}

encode_CardId :: proc(b: ^strings.Builder, x: CardId) {
	encode_u64(b, cast(u64)x)
}

decode_CastingVariant :: proc(v: json.Value, out: ^CastingVariant) -> bool {
	when COVERAGE do cov_hit("CastingVariant")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("CastingVariant: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("CastingVariant: not a string or object")
	}
	switch variant {
	case "Normal": when COVERAGE do cov_hit("CastingVariant::Normal"); out^ = CastingVariant_Normal{}
	case "Adventure": when COVERAGE do cov_hit("CastingVariant::Adventure"); out^ = CastingVariant_Adventure{}
	case "Omen": when COVERAGE do cov_hit("CastingVariant::Omen"); out^ = CastingVariant_Omen{}
	case "Warp": when COVERAGE do cov_hit("CastingVariant::Warp"); out^ = CastingVariant_Warp{}
	case "Escape": when COVERAGE do cov_hit("CastingVariant::Escape"); out^ = CastingVariant_Escape{}
	case "Retrace": when COVERAGE do cov_hit("CastingVariant::Retrace"); out^ = CastingVariant_Retrace{}
	case "Harmonize": when COVERAGE do cov_hit("CastingVariant::Harmonize"); out^ = CastingVariant_Harmonize{}
	case "Mayhem": when COVERAGE do cov_hit("CastingVariant::Mayhem"); out^ = CastingVariant_Mayhem{}
	case "Flashback": when COVERAGE do cov_hit("CastingVariant::Flashback"); out^ = CastingVariant_Flashback{}
	case "Aftermath": when COVERAGE do cov_hit("CastingVariant::Aftermath"); out^ = CastingVariant_Aftermath{}
	case "Disturb": when COVERAGE do cov_hit("CastingVariant::Disturb"); out^ = CastingVariant_Disturb{}
	case "GraveyardPermission": when COVERAGE do cov_hit("CastingVariant::GraveyardPermission");
		tmp: CastingVariant_GraveyardPermission
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^CastingVariant_GraveyardPermission) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("CastingVariant::GraveyardPermission.source") } else { return fail("CastingVariant::GraveyardPermission.source missing") }
	if fv, found := get_any(v, "frequency"); found { if !decode_CastFrequency(fv, &out.frequency) do return fail("CastingVariant::GraveyardPermission.frequency") } else { return fail("CastingVariant::GraveyardPermission.frequency missing") }
	if fv, found := get_any(v, "slot_type"); found { if !dec_opt_CoreType(fv, &out.slot_type) do return fail("CastingVariant::GraveyardPermission.slot_type") }
	if fv, found := get_any(v, "graveyard_destination_replacement"); found { if !dec_opt_Zone(fv, &out.graveyard_destination_replacement) do return fail("CastingVariant::GraveyardPermission.graveyard_destination_replacement") }
	return true
		}) { return fail("CastingVariant::GraveyardPermission") }
		out^ = tmp
	case "HandPermission": when COVERAGE do cov_hit("CastingVariant::HandPermission");
		tmp: CastingVariant_HandPermission
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^CastingVariant_HandPermission) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("CastingVariant::HandPermission.source") } else { return fail("CastingVariant::HandPermission.source missing") }
	if fv, found := get_any(v, "frequency"); found { if !decode_CastFrequency(fv, &out.frequency) do return fail("CastingVariant::HandPermission.frequency") } else { return fail("CastingVariant::HandPermission.frequency missing") }
	return true
		}) { return fail("CastingVariant::HandPermission") }
		out^ = tmp
	case "ExilePermission": when COVERAGE do cov_hit("CastingVariant::ExilePermission");
		tmp: CastingVariant_ExilePermission
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^CastingVariant_ExilePermission) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("CastingVariant::ExilePermission.source") } else { return fail("CastingVariant::ExilePermission.source missing") }
	if fv, found := get_any(v, "frequency"); found { if !decode_CastFrequency(fv, &out.frequency) do return fail("CastingVariant::ExilePermission.frequency") } else { return fail("CastingVariant::ExilePermission.frequency missing") }
	return true
		}) { return fail("CastingVariant::ExilePermission") }
		out^ = tmp
	case "Sneak": when COVERAGE do cov_hit("CastingVariant::Sneak");
		tmp: CastingVariant_Sneak
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^CastingVariant_Sneak) -> bool {
	if fv, found := get_any(v, "returned_creature"); found { if !decode_ObjectId(fv, &out.returned_creature) do return fail("CastingVariant::Sneak.returned_creature") } else { return fail("CastingVariant::Sneak.returned_creature missing") }
	if fv, found := get_any(v, "placement"); found { if !dec_opt_SneakPlacement(fv, &out.placement) do return fail("CastingVariant::Sneak.placement") }
	return true
		}) { return fail("CastingVariant::Sneak") }
		out^ = tmp
	case "WebSlinging": when COVERAGE do cov_hit("CastingVariant::WebSlinging");
		tmp: CastingVariant_WebSlinging
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^CastingVariant_WebSlinging) -> bool {
	if fv, found := get_any(v, "returned_creature"); found { if !decode_ObjectId(fv, &out.returned_creature) do return fail("CastingVariant::WebSlinging.returned_creature") } else { return fail("CastingVariant::WebSlinging.returned_creature missing") }
	return true
		}) { return fail("CastingVariant::WebSlinging") }
		out^ = tmp
	case "Miracle": when COVERAGE do cov_hit("CastingVariant::Miracle"); out^ = CastingVariant_Miracle{}
	case "Madness": when COVERAGE do cov_hit("CastingVariant::Madness"); out^ = CastingVariant_Madness{}
	case "Evoke": when COVERAGE do cov_hit("CastingVariant::Evoke"); out^ = CastingVariant_Evoke{}
	case "Emerge": when COVERAGE do cov_hit("CastingVariant::Emerge"); out^ = CastingVariant_Emerge{}
	case "Dash": when COVERAGE do cov_hit("CastingVariant::Dash"); out^ = CastingVariant_Dash{}
	case "Blitz": when COVERAGE do cov_hit("CastingVariant::Blitz"); out^ = CastingVariant_Blitz{}
	case "Spectacle": when COVERAGE do cov_hit("CastingVariant::Spectacle"); out^ = CastingVariant_Spectacle{}
	case "Suspend": when COVERAGE do cov_hit("CastingVariant::Suspend"); out^ = CastingVariant_Suspend{}
	case "Plot": when COVERAGE do cov_hit("CastingVariant::Plot"); out^ = CastingVariant_Plot{}
	case "Foretell": when COVERAGE do cov_hit("CastingVariant::Foretell"); out^ = CastingVariant_Foretell{}
	case "Overload": when COVERAGE do cov_hit("CastingVariant::Overload"); out^ = CastingVariant_Overload{}
	case "Bestow": when COVERAGE do cov_hit("CastingVariant::Bestow"); out^ = CastingVariant_Bestow{}
	case "Awaken": when COVERAGE do cov_hit("CastingVariant::Awaken"); out^ = CastingVariant_Awaken{}
	case "Cleave": when COVERAGE do cov_hit("CastingVariant::Cleave"); out^ = CastingVariant_Cleave{}
	case "MoreThanMeetsTheEye": when COVERAGE do cov_hit("CastingVariant::MoreThanMeetsTheEye"); out^ = CastingVariant_MoreThanMeetsTheEye{}
	case "Impending": when COVERAGE do cov_hit("CastingVariant::Impending"); out^ = CastingVariant_Impending{}
	case "Prototype": when COVERAGE do cov_hit("CastingVariant::Prototype"); out^ = CastingVariant_Prototype{}
	case "Mutate": when COVERAGE do cov_hit("CastingVariant::Mutate"); out^ = CastingVariant_Mutate{}
	case "Freerunning": when COVERAGE do cov_hit("CastingVariant::Freerunning"); out^ = CastingVariant_Freerunning{}
	case "Prowl": when COVERAGE do cov_hit("CastingVariant::Prowl"); out^ = CastingVariant_Prowl{}
	case "JumpStart": when COVERAGE do cov_hit("CastingVariant::JumpStart"); out^ = CastingVariant_JumpStart{}
	case "Fuse": when COVERAGE do cov_hit("CastingVariant::Fuse"); out^ = CastingVariant_Fuse{}
	case "Surge": when COVERAGE do cov_hit("CastingVariant::Surge"); out^ = CastingVariant_Surge{}
	case "FaceDown": when COVERAGE do cov_hit("CastingVariant::FaceDown"); out^ = CastingVariant_FaceDown{}
	case: return fail("CastingVariant: unknown variant")
	}
	return true
}

encode_CastingVariant :: proc(b: ^strings.Builder, x: CastingVariant) {
	#partial switch y in x {
	case CastingVariant_Normal: _ = y; json.write_string(b, "Normal")
	case CastingVariant_Adventure: _ = y; json.write_string(b, "Adventure")
	case CastingVariant_Omen: _ = y; json.write_string(b, "Omen")
	case CastingVariant_Warp: _ = y; json.write_string(b, "Warp")
	case CastingVariant_Escape: _ = y; json.write_string(b, "Escape")
	case CastingVariant_Retrace: _ = y; json.write_string(b, "Retrace")
	case CastingVariant_Harmonize: _ = y; json.write_string(b, "Harmonize")
	case CastingVariant_Mayhem: _ = y; json.write_string(b, "Mayhem")
	case CastingVariant_Flashback: _ = y; json.write_string(b, "Flashback")
	case CastingVariant_Aftermath: _ = y; json.write_string(b, "Aftermath")
	case CastingVariant_Disturb: _ = y; json.write_string(b, "Disturb")
	case CastingVariant_GraveyardPermission: strings.write_byte(b, '{'); json.write_string(b, "GraveyardPermission"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "frequency"); encode_CastFrequency(b, y.frequency)
	member(b, first, "slot_type"); enc_opt_CoreType(b, y.slot_type)
	if !(y.graveyard_destination_replacement == nil) { member(b, first, "graveyard_destination_replacement"); enc_opt_Zone(b, y.graveyard_destination_replacement) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case CastingVariant_HandPermission: strings.write_byte(b, '{'); json.write_string(b, "HandPermission"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "frequency"); encode_CastFrequency(b, y.frequency)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case CastingVariant_ExilePermission: strings.write_byte(b, '{'); json.write_string(b, "ExilePermission"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "frequency"); encode_CastFrequency(b, y.frequency)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case CastingVariant_Sneak: strings.write_byte(b, '{'); json.write_string(b, "Sneak"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "returned_creature"); encode_ObjectId(b, y.returned_creature)
	member(b, first, "placement"); enc_opt_SneakPlacement(b, y.placement)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case CastingVariant_WebSlinging: strings.write_byte(b, '{'); json.write_string(b, "WebSlinging"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "returned_creature"); encode_ObjectId(b, y.returned_creature)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case CastingVariant_Miracle: _ = y; json.write_string(b, "Miracle")
	case CastingVariant_Madness: _ = y; json.write_string(b, "Madness")
	case CastingVariant_Evoke: _ = y; json.write_string(b, "Evoke")
	case CastingVariant_Emerge: _ = y; json.write_string(b, "Emerge")
	case CastingVariant_Dash: _ = y; json.write_string(b, "Dash")
	case CastingVariant_Blitz: _ = y; json.write_string(b, "Blitz")
	case CastingVariant_Spectacle: _ = y; json.write_string(b, "Spectacle")
	case CastingVariant_Suspend: _ = y; json.write_string(b, "Suspend")
	case CastingVariant_Plot: _ = y; json.write_string(b, "Plot")
	case CastingVariant_Foretell: _ = y; json.write_string(b, "Foretell")
	case CastingVariant_Overload: _ = y; json.write_string(b, "Overload")
	case CastingVariant_Bestow: _ = y; json.write_string(b, "Bestow")
	case CastingVariant_Awaken: _ = y; json.write_string(b, "Awaken")
	case CastingVariant_Cleave: _ = y; json.write_string(b, "Cleave")
	case CastingVariant_MoreThanMeetsTheEye: _ = y; json.write_string(b, "MoreThanMeetsTheEye")
	case CastingVariant_Impending: _ = y; json.write_string(b, "Impending")
	case CastingVariant_Prototype: _ = y; json.write_string(b, "Prototype")
	case CastingVariant_Mutate: _ = y; json.write_string(b, "Mutate")
	case CastingVariant_Freerunning: _ = y; json.write_string(b, "Freerunning")
	case CastingVariant_Prowl: _ = y; json.write_string(b, "Prowl")
	case CastingVariant_JumpStart: _ = y; json.write_string(b, "JumpStart")
	case CastingVariant_Fuse: _ = y; json.write_string(b, "Fuse")
	case CastingVariant_Surge: _ = y; json.write_string(b, "Surge")
	case CastingVariant_FaceDown: _ = y; json.write_string(b, "FaceDown")
	}
}

decode_TriggerCondition :: proc(v: json.Value, out: ^TriggerCondition) -> bool {
	when COVERAGE do cov_hit("TriggerCondition")
	if v.kind != .Object do return fail("TriggerCondition: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("TriggerCondition: no tag")
	switch tv.text {
	case "GainedLife": when COVERAGE do cov_hit("TriggerCondition::GainedLife");
		tmp: TriggerCondition_GainedLife
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerCondition_GainedLife) -> bool {
	if fv, found := get_any(v, "minimum"); found { if !decode_u32(fv, &out.minimum) do return fail("TriggerCondition::GainedLife.minimum") } else { return fail("TriggerCondition::GainedLife.minimum missing") }
	return true
		}) { return fail("TriggerCondition::GainedLife") }
		out^ = tmp
	case "LostLife": when COVERAGE do cov_hit("TriggerCondition::LostLife"); out^ = TriggerCondition_LostLife{}
	case "Descended": when COVERAGE do cov_hit("TriggerCondition::Descended"); out^ = TriggerCondition_Descended{}
	case "ControlsType": when COVERAGE do cov_hit("TriggerCondition::ControlsType");
		tmp: TriggerCondition_ControlsType
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerCondition_ControlsType) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("TriggerCondition::ControlsType.filter") } else { return fail("TriggerCondition::ControlsType.filter missing") }
	return true
		}) { return fail("TriggerCondition::ControlsType") }
		out^ = tmp
	case "NoSpellsCastLastTurn": when COVERAGE do cov_hit("TriggerCondition::NoSpellsCastLastTurn"); out^ = TriggerCondition_NoSpellsCastLastTurn{}
	case "TwoOrMoreSpellsCastLastTurn": when COVERAGE do cov_hit("TriggerCondition::TwoOrMoreSpellsCastLastTurn"); out^ = TriggerCondition_TwoOrMoreSpellsCastLastTurn{}
	case "DuringPlayersTurn": when COVERAGE do cov_hit("TriggerCondition::DuringPlayersTurn");
		tmp: TriggerCondition_DuringPlayersTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerCondition_DuringPlayersTurn) -> bool {
