decode_AlternativeAdditionalCostDescription :: proc(v: json.Value, out: ^AlternativeAdditionalCostDescription) -> bool {
	when COVERAGE do cov_hit("AlternativeAdditionalCostDescription")
	if v.kind != .Object do return fail("AlternativeAdditionalCostDescription: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("AlternativeAdditionalCostDescription: no tag")
	switch tv.text {
	case "EmergeSacrifice": when COVERAGE do cov_hit("AlternativeAdditionalCostDescription::EmergeSacrifice");
		tmp: AlternativeAdditionalCostDescription_EmergeSacrifice
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AlternativeAdditionalCostDescription_EmergeSacrifice) -> bool {
	if fv, found := get_any(v, "quality"); found { if !decode_EmergeSacrificeQuality(fv, &out.quality) do return fail("AlternativeAdditionalCostDescription::EmergeSacrifice.quality") } else { return fail("AlternativeAdditionalCostDescription::EmergeSacrifice.quality missing") }
	return true
		}) { return fail("AlternativeAdditionalCostDescription::EmergeSacrifice") }
		out^ = tmp
	case: return fail("AlternativeAdditionalCostDescription: unknown variant")
	}
	return true
}

encode_AlternativeAdditionalCostDescription :: proc(b: ^strings.Builder, x: AlternativeAdditionalCostDescription) {
	#partial switch y in x {
	case AlternativeAdditionalCostDescription_EmergeSacrifice: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "EmergeSacrifice")
	member(b, first, "quality"); encode_EmergeSacrificeQuality(b, y.quality)
	}; strings.write_byte(b, '}')
	}
}

encode_AlternativeAdditionalCostDescription_members :: proc(b: ^strings.Builder, x: AlternativeAdditionalCostDescription, first: ^bool) {
	#partial switch y in x {
	case AlternativeAdditionalCostDescription_EmergeSacrifice: member(b, first, "type"); json.write_string(b, "EmergeSacrifice")
	member(b, first, "quality"); encode_EmergeSacrificeQuality(b, y.quality)

	}
}

decode_CastingVariantChoiceOption :: proc(v: json.Value, out: ^CastingVariantChoiceOption) -> bool {
	when COVERAGE do cov_hit("CastingVariantChoiceOption")
	if v.kind != .Object do return fail("CastingVariantChoiceOption: not an object")
	if fv, found := get_any(v, "variant"); found { if !decode_CastingVariant(fv, &out.variant) do return fail("CastingVariantChoiceOption.variant") } else { return fail("CastingVariantChoiceOption.variant missing") }
	if fv, found := get_any(v, "face"); found { if !decode_CastingVariantFace(fv, &out.face) do return fail("CastingVariantChoiceOption.face") } else { return fail("CastingVariantChoiceOption.face missing") }
	if fv, found := get_any(v, "mana_cost"); found { if !decode_ManaCost(fv, &out.mana_cost) do return fail("CastingVariantChoiceOption.mana_cost") } else { return fail("CastingVariantChoiceOption.mana_cost missing") }
	if fv, found := get_any(v, "additional_cost"); found { if !dec_opt_AbilityCost(fv, &out.additional_cost) do return fail("CastingVariantChoiceOption.additional_cost") }
	if fv, found := get_any(v, "authority"); found { if !dec_opt_CastAuthorityChoice(fv, &out.authority) do return fail("CastingVariantChoiceOption.authority") }
	if fv, found := get_any(v, "alternative_cost_keyword"); found { if !dec_opt_Keyword(fv, &out.alternative_cost_keyword) do return fail("CastingVariantChoiceOption.alternative_cost_keyword") }
	return true
}

encode_CastingVariantChoiceOption :: proc(b: ^strings.Builder, x: CastingVariantChoiceOption) {
	strings.write_byte(b, '{')
	f := true
	encode_CastingVariantChoiceOption_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CastingVariantChoiceOption_members :: proc(b: ^strings.Builder, x: CastingVariantChoiceOption, first: ^bool) {
	member(b, first, "variant"); encode_CastingVariant(b, x.variant)
	member(b, first, "face"); encode_CastingVariantFace(b, x.face)
	member(b, first, "mana_cost"); encode_ManaCost(b, x.mana_cost)
	if !(x.additional_cost == nil) { member(b, first, "additional_cost"); enc_opt_AbilityCost(b, x.additional_cost) }
	if !(x.authority == nil) { member(b, first, "authority"); enc_opt_CastAuthorityChoice(b, x.authority) }
	if !(x.alternative_cost_keyword == nil) { member(b, first, "alternative_cost_keyword"); enc_opt_Keyword(b, x.alternative_cost_keyword) }
}

decode_AnnouncedGraveyardPermission :: proc(v: json.Value, out: ^AnnouncedGraveyardPermission) -> bool {
	when COVERAGE do cov_hit("AnnouncedGraveyardPermission")
	if v.kind != .Object do return fail("AnnouncedGraveyardPermission: not an object")
	if fv, found := get_any(v, "permission"); found { if !decode_GraveyardPermissionId(fv, &out.permission) do return fail("AnnouncedGraveyardPermission.permission") } else { return fail("AnnouncedGraveyardPermission.permission missing") }
	if fv, found := get_any(v, "grant_digest"); found { if !decode_GrantDigest(fv, &out.grant_digest) do return fail("AnnouncedGraveyardPermission.grant_digest") } else { return fail("AnnouncedGraveyardPermission.grant_digest missing") }
	if fv, found := get_any(v, "slot_type"); found { if !dec_opt_CoreType(fv, &out.slot_type) do return fail("AnnouncedGraveyardPermission.slot_type") }
	return true
}

encode_AnnouncedGraveyardPermission :: proc(b: ^strings.Builder, x: AnnouncedGraveyardPermission) {
	strings.write_byte(b, '{')
	f := true
	encode_AnnouncedGraveyardPermission_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_AnnouncedGraveyardPermission_members :: proc(b: ^strings.Builder, x: AnnouncedGraveyardPermission, first: ^bool) {
	member(b, first, "permission"); encode_GraveyardPermissionId(b, x.permission)
	member(b, first, "grant_digest"); encode_GrantDigest(b, x.grant_digest)
	if !(x.slot_type == nil) { member(b, first, "slot_type"); enc_opt_CoreType(b, x.slot_type) }
}

decode_ActivationCostSnapshot :: proc(v: json.Value, out: ^ActivationCostSnapshot) -> bool {
	when COVERAGE do cov_hit("ActivationCostSnapshot")
	if v.kind != .Object do return fail("ActivationCostSnapshot: not an object")
	if fv, found := get_any(v, "base_cost"); found { if !decode_AbilityCost(fv, &out.base_cost) do return fail("ActivationCostSnapshot.base_cost") } else { return fail("ActivationCostSnapshot.base_cost missing") }
	if fv, found := get_any(v, "raise_total"); found { if !decode_u32(fv, &out.raise_total) do return fail("ActivationCostSnapshot.raise_total") }
	if fv, found := get_any(v, "reductions"); found { if !dec_dyn_CostReductionEntry(fv, &out.reductions) do return fail("ActivationCostSnapshot.reductions") }
	if fv, found := get_any(v, "mana_carrier"); found { if !decode_ManaCarrier(fv, &out.mana_carrier) do return fail("ActivationCostSnapshot.mana_carrier") }
	if fv, found := get_any(v, "settlement_tail"); found { if !dec_opt_SettledTail(fv, &out.settlement_tail) do return fail("ActivationCostSnapshot.settlement_tail") }
	if fv, found := get_any(v, "lock"); found { if !decode_ActivationCostLock(fv, &out.lock) do return fail("ActivationCostSnapshot.lock") } else { return fail("ActivationCostSnapshot.lock missing") }
	return true
}

encode_ActivationCostSnapshot :: proc(b: ^strings.Builder, x: ActivationCostSnapshot) {
	strings.write_byte(b, '{')
	f := true
	encode_ActivationCostSnapshot_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ActivationCostSnapshot_members :: proc(b: ^strings.Builder, x: ActivationCostSnapshot, first: ^bool) {
	member(b, first, "base_cost"); encode_AbilityCost(b, x.base_cost)
	if !(x.raise_total == 0) { member(b, first, "raise_total"); encode_u32(b, x.raise_total) }
	if !((len(x.reductions) == 0)) { member(b, first, "reductions"); enc_dyn_CostReductionEntry(b, x.reductions) }
	if !(skip_ActivationCostSnapshot_ManaCarrier_is_whole_ManaCarrier(x.mana_carrier)) { member(b, first, "mana_carrier"); encode_ManaCarrier(b, x.mana_carrier) }
	if !(x.settlement_tail == nil) { member(b, first, "settlement_tail"); enc_opt_SettledTail(b, x.settlement_tail) }
	member(b, first, "lock"); encode_ActivationCostLock(b, x.lock)
}

