	if fv, found := get_any(v, "attachment_ids"); found { if !dec_dyn_ObjectId(fv, &out.attachment_ids) do return fail("ProtectionStartSnapshot.attachment_ids") } else { return fail("ProtectionStartSnapshot.attachment_ids missing") }
