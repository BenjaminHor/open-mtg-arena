	if fv, found := get_any(v, "sources"); found { if !dec_dyn_t2_YieldTarget_u8(fv, &out.sources) do return fail("DecisionGroupKey.sources") } else { return fail("DecisionGroupKey.sources missing") }
	if fv, found := get_any(v, "kind"); found { if !decode_DecisionKind(fv, &out.kind) do return fail("DecisionGroupKey.kind") } else { return fail("DecisionGroupKey.kind missing") }
