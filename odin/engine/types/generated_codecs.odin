enc_map_string_string :: proc(b: ^strings.Builder, x: map[string]string) {
	strings.write_byte(b, '{')
	first := true
	for k, val in x {
		if !first do strings.write_byte(b, ',')
		first = false
		json.write_string(b, k)
		strings.write_byte(b, ':')
		encode_string(b, val)
	}
	strings.write_byte(b, '}')
}

enc_opt_string :: proc(b: ^strings.Builder, x: Maybe(string)) {
	if y, ok := x.?; ok do encode_string(b, y)
	else do strings.write_string(b, "null")
}

enc_opt_int :: proc(b: ^strings.Builder, x: Maybe(int)) {
	if y, ok := x.?; ok do encode_int(b, y)
	else do strings.write_string(b, "null")
}

enc_dyn_string :: proc(b: ^strings.Builder, x: [dynamic]string) {
	strings.write_byte(b, '[')
	for item, i in x {
		if i > 0 do strings.write_byte(b, ',')
		encode_string(b, item)
	}
	strings.write_byte(b, ']')
}

enc_dyn_Ruling :: proc(b: ^strings.Builder, x: [dynamic]Ruling) {
	strings.write_byte(b, '[')
	for item, i in x {
		if i > 0 do strings.write_byte(b, ',')
		encode_Ruling(b, item)
	}
	strings.write_byte(b, ']')
}

