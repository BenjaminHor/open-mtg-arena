	return true
		}) { return fail("TriggerDefinitionOccurrenceRef::ExpandedGrant") }
		out^ = tmp
	case: return fail("TriggerDefinitionOccurrenceRef: unknown variant")
	}
	return true
}

encode_TriggerDefinitionOccurrenceRef :: proc(b: ^strings.Builder, x: TriggerDefinitionOccurrenceRef) {
	#partial switch y in x {
	case TriggerDefinitionOccurrenceRef_Printed: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Printed"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "base_set"); encode_TriggerBaseSetInstanceRef(b, y.base_set)
	member(b, first, "printed_index"); encode_int(b, y.printed_index)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerDefinitionOccurrenceRef_CopiedValue: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CopiedValue"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "copy_effect"); encode_CopyEffectInstanceRef(b, y.copy_effect)
	member(b, first, "copied_slot"); encode_int(b, y.copied_slot)
	if !(y.printed_origin == nil) { member(b, first, "printed_origin"); enc_opt_TriggerPrintedOrigin(b, y.printed_origin) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerDefinitionOccurrenceRef_KeywordCompanion: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "KeywordCompanion"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "grant_instance"); encode_TriggerGrantInstanceRef(b, y.grant_instance)
	member(b, first, "companion_index"); encode_int(b, y.companion_index)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerDefinitionOccurrenceRef_CopyRetained: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CopyRetained"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "grant_instance"); encode_TriggerGrantInstanceRef(b, y.grant_instance)
	member(b, first, "source_base_set"); encode_TriggerBaseSetInstanceRef(b, y.source_base_set)
	member(b, first, "source_printed_index"); encode_int(b, y.source_printed_index)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerDefinitionOccurrenceRef_Granted: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Granted"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "grant_instance"); encode_TriggerGrantInstanceRef(b, y.grant_instance)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerDefinitionOccurrenceRef_ExpandedGrant: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ExpandedGrant"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "grant_instance"); encode_TriggerGrantInstanceRef(b, y.grant_instance)
	member(b, first, "provider"); enc_ptr_TriggerDefinitionRef(b, y.provider)
	member(b, first, "provider_output_index"); encode_int(b, y.provider_output_index)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_TriggerBaseSetInstanceRef :: proc(v: json.Value, out: ^TriggerBaseSetInstanceRef) -> bool {
	return decode_u64(v, cast(^u64)out)
}

encode_TriggerBaseSetInstanceRef :: proc(b: ^strings.Builder, x: TriggerBaseSetInstanceRef) {
	encode_u64(b, cast(u64)x)
}

decode_CopyEffectInstanceRef :: proc(v: json.Value, out: ^CopyEffectInstanceRef) -> bool {
	if v.kind != .Object do return fail("CopyEffectInstanceRef: not an object")
	if fv, found := get_any(v, "continuous_effect_id"); found { if !decode_u64(fv, &out.continuous_effect_id) do return fail("CopyEffectInstanceRef.continuous_effect_id") } else { return fail("CopyEffectInstanceRef.continuous_effect_id missing") }
	if fv, found := get_any(v, "modification_index"); found { if !decode_int(fv, &out.modification_index) do return fail("CopyEffectInstanceRef.modification_index") } else { return fail("CopyEffectInstanceRef.modification_index missing") }
	return true
}

encode_CopyEffectInstanceRef :: proc(b: ^strings.Builder, x: CopyEffectInstanceRef) {
	strings.write_byte(b, '{')
	f := true
	encode_CopyEffectInstanceRef_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CopyEffectInstanceRef_members :: proc(b: ^strings.Builder, x: CopyEffectInstanceRef, first: ^bool) {
	member(b, first, "continuous_effect_id"); encode_u64(b, x.continuous_effect_id)
	member(b, first, "modification_index"); encode_int(b, x.modification_index)
}

decode_TriggerGrantInstanceRef :: proc(v: json.Value, out: ^TriggerGrantInstanceRef) -> bool {
	return decode_u64(v, cast(^u64)out)
}

encode_TriggerGrantInstanceRef :: proc(b: ^strings.Builder, x: TriggerGrantInstanceRef) {
	encode_u64(b, cast(u64)x)
}


dec_map_string_string :: proc(v: json.Value, out: ^map[string]string) -> bool {
	if v.kind != .Object do return fail("expected an object (map)")
	out^ = make(map[string]string, len(v.members))
	for m in v.members {
		key: string
		val: string
		key = m.key; ok_k := true
		if !ok_k || !decode_string(m.value, &val) do return false
		out[key] = val
	}
	return true
}

dec_opt_string :: proc(v: json.Value, out: ^Maybe(string)) -> bool {
	if v.kind == .Null { out^ = nil; return true }
	x: string
	if !decode_string(v, &x) do return false
	out^ = x
	return true
}

dec_opt_int :: proc(v: json.Value, out: ^Maybe(int)) -> bool {
	if v.kind == .Null { out^ = nil; return true }
	x: int
	if !decode_int(v, &x) do return false
	out^ = x
	return true
}

dec_dyn_string :: proc(v: json.Value, out: ^[dynamic]string) -> bool {
	if v.kind != .Array do return fail("expected an array")
	out^ = make([dynamic]string, len(v.items))
	for item, i in v.items do if !decode_string(item, &out[i]) do return false
	return true
}

dec_dyn_Ruling :: proc(v: json.Value, out: ^[dynamic]Ruling) -> bool {
	if v.kind != .Array do return fail("expected an array")
	out^ = make([dynamic]Ruling, len(v.items))
	for item, i in v.items do if !decode_Ruling(item, &out[i]) do return false
	return true
}

enc_map_string_string :: proc(b: ^strings.Builder, x: map[string]string) {
	strings.write_byte(b, '{')
	first := true
	for k, val in x {
		if !first do strings.write_byte(b, ',')
		first = false
		json.write_string(b, k)
		strings.write_byte(b, ':')
		encode_string(b, val)
	}
	strings.write_byte(b, '}')
}

enc_opt_string :: proc(b: ^strings.Builder, x: Maybe(string)) {
	if y, ok := x.?; ok do encode_string(b, y)
	else do strings.write_string(b, "null")
}

enc_opt_int :: proc(b: ^strings.Builder, x: Maybe(int)) {
	if y, ok := x.?; ok do encode_int(b, y)
	else do strings.write_string(b, "null")
}

enc_dyn_string :: proc(b: ^strings.Builder, x: [dynamic]string) {
	strings.write_byte(b, '[')
	for item, i in x {
		if i > 0 do strings.write_byte(b, ',')
		encode_string(b, item)
	}
	strings.write_byte(b, ']')
}

enc_dyn_Ruling :: proc(b: ^strings.Builder, x: [dynamic]Ruling) {
