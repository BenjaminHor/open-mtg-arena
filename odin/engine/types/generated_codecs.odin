	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("UntilCondition::NextMatches.filter") } else { return fail("UntilCondition::NextMatches.filter missing") }
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("UntilCondition::NextMatches.count") } else { out.count = default_UntilCondition_default_quantity_one() }
