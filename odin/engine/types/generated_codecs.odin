encode_GameAction :: proc(b: ^strings.Builder, x: GameAction) {
	#partial switch y in x {
	case GameAction_PassPriority: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PassPriority"); strings.write_byte(b, '}')
	case GameAction_ChooseMeldPair: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChooseMeldPair"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "partner_id"); encode_ObjectId(b, y.partner_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_ChooseEntryAttackTarget: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChooseEntryAttackTarget"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "target"); encode_AttackTarget(b, y.target)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_PlayLand: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PlayLand"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "card_id"); encode_CardId(b, y.card_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_CastSpell: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CastSpell"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "card_id"); encode_CardId(b, y.card_id)
	member(b, first, "targets"); enc_dyn_ObjectId(b, y.targets)
	member(b, first, "payment_mode"); encode_CastPaymentMode(b, y.payment_mode)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_Foretell: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Foretell"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "card_id"); encode_CardId(b, y.card_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_ActivateAbility: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ActivateAbility"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "ability_index"); encode_int(b, y.ability_index)
	if !(skip_GameAction_CastPaymentMode_is_auto_CastPaymentMode(y.payment_mode)) { member(b, first, "payment_mode"); encode_CastPaymentMode(b, y.payment_mode) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_DeclareAttackers: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DeclareAttackers"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "attacks"); enc_dyn_t2_ObjectId_AttackTarget(b, y.attacks)
	member(b, first, "bands"); enc_dyn_dyn_ObjectId(b, y.bands)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameAction_DeclareBlockers: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DeclareBlockers"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "assignments"); enc_dyn_t2_ObjectId_ObjectId(b, y.assignments)
