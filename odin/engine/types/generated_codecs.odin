	case TriggerMode_CrankContraption: _ = y; json.write_string(b, "CrankContraption")
	case TriggerMode_Devoured: _ = y; json.write_string(b, "Devoured")
	case TriggerMode_Discover: _ = y; json.write_string(b, "Discover")
	case TriggerMode_Forage: _ = y; json.write_string(b, "Forage")
	case TriggerMode_FullyUnlock: _ = y; json.write_string(b, "FullyUnlock")
	case TriggerMode_GiveGift: _ = y; json.write_string(b, "GiveGift")
	case TriggerMode_ManifestDread: _ = y; json.write_string(b, "ManifestDread")
	case TriggerMode_Mentored: _ = y; json.write_string(b, "Mentored")
	case TriggerMode_Mutates: _ = y; json.write_string(b, "Mutates")
	case TriggerMode_SearchedLibrary: _ = y; json.write_string(b, "SearchedLibrary")
	case TriggerMode_SeekAll: _ = y; json.write_string(b, "SeekAll")
	case TriggerMode_SetInMotion: _ = y; json.write_string(b, "SetInMotion")
	case TriggerMode_AsSetInMotion: _ = y; json.write_string(b, "AsSetInMotion")
	case TriggerMode_Specializes: _ = y; json.write_string(b, "Specializes")
	case TriggerMode_Stationed: _ = y; json.write_string(b, "Stationed")
	case TriggerMode_Trains: _ = y; json.write_string(b, "Trains")
	case TriggerMode_UnlockDoor: _ = y; json.write_string(b, "UnlockDoor")
