		tmp: WaitingFor_AssistChoosePlayer
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^WaitingFor_AssistChoosePlayer) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("WaitingFor::AssistChoosePlayer.player") } else { return fail("WaitingFor::AssistChoosePlayer.player missing") }
