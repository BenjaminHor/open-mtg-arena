	case PendingHordeReveal_TokenCreation: strings.write_byte(b, '{'); json.write_string(b, "TokenCreation"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card"); encode_ObjectId(b, y.card)
	member(b, first, "before"); enc_dyn_ObjectId(b, y.before)
	member(b, first, "pinned"); enc_opt_TokenImageRef(b, y.pinned)
	member(b, first, "revealed_name"); encode_string(b, y.revealed_name)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingHordeReveal_AmassArmy: strings.write_byte(b, '{'); json.write_string(b, "AmassArmy"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card"); encode_ObjectId(b, y.card)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

