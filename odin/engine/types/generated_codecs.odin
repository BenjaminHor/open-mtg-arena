		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_ControlPlayersDuringOwnLibrarySearch) -> bool {
	if fv, found := get_any(v, "who"); found { if !decode_ProhibitionScope(fv, &out.who) do return fail("StaticMode::ControlPlayersDuringOwnLibrarySearch.who") } else { return fail("StaticMode::ControlPlayersDuringOwnLibrarySearch.who missing") }
