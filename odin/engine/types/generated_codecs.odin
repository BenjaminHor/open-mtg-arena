		out^ = tmp
	case "Both":
		tmp: ManaTargetRole_Both
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ManaTargetRole_Both) -> bool {
	if fv, found := get_any(v, "recipient"); found { if !decode_TargetFilter(fv, &out.recipient) do return fail("ManaTargetRole::Both.recipient") } else { return fail("ManaTargetRole::Both.recipient missing") }
	if fv, found := get_any(v, "count_source"); found { if !decode_TargetFilter(fv, &out.count_source) do return fail("ManaTargetRole::Both.count_source") } else { return fail("ManaTargetRole::Both.count_source missing") }
	return true
		}) { return fail("ManaTargetRole::Both") }
		out^ = tmp
	case: return fail("ManaTargetRole: unknown variant")
	}
	return true
}

encode_ManaTargetRole :: proc(b: ^strings.Builder, x: ManaTargetRole) {
	#partial switch y in x {
	case ManaTargetRole_Recipient: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "role"); json.write_string(b, "Recipient")
	member(b, first, "recipient"); encode_TargetFilter(b, y.recipient)
	}; strings.write_byte(b, '}')
	case ManaTargetRole_CountSource: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "role"); json.write_string(b, "CountSource")
	member(b, first, "count_source"); encode_TargetFilter(b, y.count_source)
	}; strings.write_byte(b, '}')
