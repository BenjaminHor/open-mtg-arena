decode_WaveTermination :: proc(v: json.Value, out: ^WaveTermination) -> bool {
	when COVERAGE do cov_hit("WaveTermination")
	if v.kind != .Object do return fail("WaveTermination: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("WaveTermination: no tag")
	switch tv.text {
	case "FixedCount": when COVERAGE do cov_hit("WaveTermination::FixedCount"); tmp: WaveTermination_FixedCount; if !decode_u32(json.get_or_null(v, "data"), &tmp._0) do return fail("WaveTermination::FixedCount"); out^ = tmp
	case "UntilNonToken": when COVERAGE do cov_hit("WaveTermination::UntilNonToken");
		tmp: WaveTermination_UntilNonToken
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^WaveTermination_UntilNonToken) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_WaveCount(fv, &out.count) do return fail("WaveTermination::UntilNonToken.count") } else { return fail("WaveTermination::UntilNonToken.count missing") }
	return true
		}) { return fail("WaveTermination::UntilNonToken") }
		out^ = tmp
	case "UntilRarityAtLeast": when COVERAGE do cov_hit("WaveTermination::UntilRarityAtLeast"); tmp: WaveTermination_UntilRarityAtLeast; if !decode_Rarity(json.get_or_null(v, "data"), &tmp._0) do return fail("WaveTermination::UntilRarityAtLeast"); out^ = tmp
	case: return fail("WaveTermination: unknown variant")
	}
	return true
}

encode_WaveTermination :: proc(b: ^strings.Builder, x: WaveTermination) {
	#partial switch y in x {
	case WaveTermination_FixedCount: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "FixedCount"); member(b, &f, "data"); encode_u32(b, y._0); strings.write_byte(b, '}')
	case WaveTermination_UntilNonToken: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "UntilNonToken"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "count"); encode_WaveCount(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaveTermination_UntilRarityAtLeast: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "UntilRarityAtLeast"); member(b, &f, "data"); encode_Rarity(b, y._0); strings.write_byte(b, '}')
	}
}

