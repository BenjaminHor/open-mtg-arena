decode_DrawSequenceFrame :: proc(v: json.Value, out: ^DrawSequenceFrame) -> bool {
	when COVERAGE do cov_hit("DrawSequenceFrame")
	if v.kind != .Object do return fail("DrawSequenceFrame: not an object")
	if fv, found := get_any(v, "frame_id"); found { if !decode_DrawSequenceFrameId(fv, &out.frame_id) do return fail("DrawSequenceFrame.frame_id") } else { return fail("DrawSequenceFrame.frame_id missing") }
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("DrawSequenceFrame.player") } else { return fail("DrawSequenceFrame.player missing") }
	if fv, found := get_any(v, "applied"); found { if !dec_dyn_AppliedReplacementKey(fv, &out.applied) do return fail("DrawSequenceFrame.applied") }
	if fv, found := get_any(v, "origin"); found { if !decode_DrawSequenceOrigin(fv, &out.origin) do return fail("DrawSequenceFrame.origin") } else { out.origin = DrawSequenceOrigin(DrawSequenceOrigin_Plain{}) }
	if fv, found := get_any(v, "remaining"); found { if !decode_u32(fv, &out.remaining) do return fail("DrawSequenceFrame.remaining") } else { return fail("DrawSequenceFrame.remaining missing") }
	if fv, found := get_any(v, "pending_delivery"); found { if !dec_opt_PendingDrawDelivery(fv, &out.pending_delivery) do return fail("DrawSequenceFrame.pending_delivery") }
	if fv, found := get_any(v, "delivery_owner"); found { if !dec_opt_DrawSequenceFrameId(fv, &out.delivery_owner) do return fail("DrawSequenceFrame.delivery_owner") }
	if fv, found := get_any(v, "capture_next_child_delivery"); found { if !decode_bool(fv, &out.capture_next_child_delivery) do return fail("DrawSequenceFrame.capture_next_child_delivery") }
	if fv, found := get_any(v, "accumulated"); found { if !decode_u32(fv, &out.accumulated) do return fail("DrawSequenceFrame.accumulated") } else { return fail("DrawSequenceFrame.accumulated missing") }
	if fv, found := get_any(v, "dealer"); found { if !dec_opt_DrawDealer(fv, &out.dealer) do return fail("DrawSequenceFrame.dealer") }
	return true
}

encode_DrawSequenceFrame :: proc(b: ^strings.Builder, x: DrawSequenceFrame) {
	strings.write_byte(b, '{')
	f := true
	encode_DrawSequenceFrame_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_DrawSequenceFrame_members :: proc(b: ^strings.Builder, x: DrawSequenceFrame, first: ^bool) {
	member(b, first, "frame_id"); encode_DrawSequenceFrameId(b, x.frame_id)
	member(b, first, "player"); encode_PlayerId(b, x.player)
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, x.applied)
	member(b, first, "origin"); encode_DrawSequenceOrigin(b, x.origin)
	member(b, first, "remaining"); encode_u32(b, x.remaining)
	if !(x.pending_delivery == nil) { member(b, first, "pending_delivery"); enc_opt_PendingDrawDelivery(b, x.pending_delivery) }
	member(b, first, "delivery_owner"); enc_opt_DrawSequenceFrameId(b, x.delivery_owner)
	if !(!x.capture_next_child_delivery) { member(b, first, "capture_next_child_delivery"); encode_bool(b, x.capture_next_child_delivery) }
	member(b, first, "accumulated"); encode_u32(b, x.accumulated)
	if !(x.dealer == nil) { member(b, first, "dealer"); enc_opt_DrawDealer(b, x.dealer) }
}

decode_CipherEncodeStage :: proc(v: json.Value, out: ^CipherEncodeStage) -> bool {
	when COVERAGE do cov_hit("CipherEncodeStage")
	if v.kind != .String do return fail("CipherEncodeStage: not a string")
	str := v.text
	switch str {
	case "Parked": when COVERAGE do cov_hit("CipherEncodeStage::Parked"); out^ = .Parked
	case "Armed": when COVERAGE do cov_hit("CipherEncodeStage::Armed"); out^ = .Armed
	case: return fail("CipherEncodeStage: unknown variant")
	}
	return true
}

encode_CipherEncodeStage :: proc(b: ^strings.Builder, x: CipherEncodeStage) {
	@(static, rodata) NAMES := [CipherEncodeStage]string{
		.Parked = "Parked",
		.Armed = "Armed",
	}
	json.write_string(b, NAMES[x])
}

decode_LogCategory :: proc(v: json.Value, out: ^LogCategory) -> bool {
	when COVERAGE do cov_hit("LogCategory")
