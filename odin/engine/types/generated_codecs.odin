	if fv, found := get_any(v, "colors"); found { if !dec_dyn_ManaColor(fv, &out.colors) do return fail("TokenArtDescriptor.colors") } else { return fail("TokenArtDescriptor.colors missing") }
	if fv, found := get_any(v, "subtypes"); found { if !dec_dyn_string(fv, &out.subtypes) do return fail("TokenArtDescriptor.subtypes") } else { return fail("TokenArtDescriptor.subtypes missing") }
	if fv, found := get_any(v, "keywords"); found { if !dec_dyn_string(fv, &out.keywords) do return fail("TokenArtDescriptor.keywords") }
	if fv, found := get_any(v, "has_abilities"); found { if !decode_bool(fv, &out.has_abilities) do return fail("TokenArtDescriptor.has_abilities") } else { return fail("TokenArtDescriptor.has_abilities missing") }
	return true
