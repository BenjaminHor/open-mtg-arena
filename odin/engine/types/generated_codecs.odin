decode_EventCounterReproductionCount :: proc(v: json.Value, out: ^EventCounterReproductionCount) -> bool {
	when COVERAGE do cov_hit("EventCounterReproductionCount")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("EventCounterReproductionCount: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("EventCounterReproductionCount: not a string or object")
	}
	switch variant {
	case "SameNumber": when COVERAGE do cov_hit("EventCounterReproductionCount::SameNumber"); out^ = EventCounterReproductionCount_SameNumber{}
	case "PerKind": when COVERAGE do cov_hit("EventCounterReproductionCount::PerKind"); tmp: EventCounterReproductionCount_PerKind; if !decode_u32(body, &tmp._0) do return fail("EventCounterReproductionCount::PerKind"); out^ = tmp
	case: return fail("EventCounterReproductionCount: unknown variant")
	}
	return true
}

encode_EventCounterReproductionCount :: proc(b: ^strings.Builder, x: EventCounterReproductionCount) {
	#partial switch y in x {
	case EventCounterReproductionCount_SameNumber: _ = y; json.write_string(b, "SameNumber")
	case EventCounterReproductionCount_PerKind: strings.write_byte(b, '{'); json.write_string(b, "PerKind"); strings.write_byte(b, ':'); encode_u32(b, y._0); strings.write_byte(b, '}')
	}
}

