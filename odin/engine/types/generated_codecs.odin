	member(b, first, "optional"); encode_bool(b, x.optional)
	if !(x.chooser == nil) { member(b, first, "chooser"); enc_opt_PlayerId(b, x.chooser) }
	member(b, first, "effect_kind"); encode_EffectKind(b, x.effect_kind)
	member(b, first, "effect_detail"); encode_TargetEffectDetail(b, x.effect_detail)
}

