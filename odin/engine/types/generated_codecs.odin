decode_ThisWayCause :: proc(v: json.Value, out: ^ThisWayCause) -> bool {
	when COVERAGE do cov_hit("ThisWayCause")
	if v.kind != .String do return fail("ThisWayCause: not a string")
	str := v.text
	switch str {
	case "OwnerLibraryShuffleSubject": when COVERAGE do cov_hit("ThisWayCause::OwnerLibraryShuffleSubject"); out^ = .OwnerLibraryShuffleSubject
	case "Exiled": when COVERAGE do cov_hit("ThisWayCause::Exiled"); out^ = .Exiled
	case "Sacrificed": when COVERAGE do cov_hit("ThisWayCause::Sacrificed"); out^ = .Sacrificed
	case "Destroyed": when COVERAGE do cov_hit("ThisWayCause::Destroyed"); out^ = .Destroyed
	case "Milled": when COVERAGE do cov_hit("ThisWayCause::Milled"); out^ = .Milled
	case "Discarded": when COVERAGE do cov_hit("ThisWayCause::Discarded"); out^ = .Discarded
	case "Tapped": when COVERAGE do cov_hit("ThisWayCause::Tapped"); out^ = .Tapped
	case "Returned": when COVERAGE do cov_hit("ThisWayCause::Returned"); out^ = .Returned
	case "Bounced": when COVERAGE do cov_hit("ThisWayCause::Bounced"); out^ = .Bounced
	case "PutIntoGraveyard": when COVERAGE do cov_hit("ThisWayCause::PutIntoGraveyard"); out^ = .PutIntoGraveyard
	case "ControlGained": when COVERAGE do cov_hit("ThisWayCause::ControlGained"); out^ = .ControlGained
	case: return fail("ThisWayCause: unknown variant")
	}
	return true
}

encode_ThisWayCause :: proc(b: ^strings.Builder, x: ThisWayCause) {
	@(static, rodata) NAMES := [ThisWayCause]string{
		.OwnerLibraryShuffleSubject = "OwnerLibraryShuffleSubject",
		.Exiled = "Exiled",
		.Sacrificed = "Sacrificed",
		.Destroyed = "Destroyed",
		.Milled = "Milled",
		.Discarded = "Discarded",
		.Tapped = "Tapped",
		.Returned = "Returned",
		.Bounced = "Bounced",
		.PutIntoGraveyard = "PutIntoGraveyard",
		.ControlGained = "ControlGained",
	}
	json.write_string(b, NAMES[x])
}

