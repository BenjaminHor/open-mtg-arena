decode_PendingActivationTriggerCollection :: proc(v: json.Value, out: ^PendingActivationTriggerCollection) -> bool {
	when COVERAGE do cov_hit("PendingActivationTriggerCollection")
	if v.kind != .Object do return fail("PendingActivationTriggerCollection: not an object")
	if fv, found := get_any(v, "overlay"); found { if !decode_TriggerCollectionOverlay(fv, &out.overlay) do return fail("PendingActivationTriggerCollection.overlay") } else { return fail("PendingActivationTriggerCollection.overlay missing") }
	if fv, found := get_any(v, "operation_journal"); found { if !dec_dyn_TriggerCollectionOperation(fv, &out.operation_journal) do return fail("PendingActivationTriggerCollection.operation_journal") } else { return fail("PendingActivationTriggerCollection.operation_journal missing") }
	if fv, found := get_any(v, "pending_contexts"); found { if !dec_dyn_PendingTriggerContext(fv, &out.pending_contexts) do return fail("PendingActivationTriggerCollection.pending_contexts") } else { return fail("PendingActivationTriggerCollection.pending_contexts missing") }
	return true
}

encode_PendingActivationTriggerCollection :: proc(b: ^strings.Builder, x: PendingActivationTriggerCollection) {
	strings.write_byte(b, '{')
