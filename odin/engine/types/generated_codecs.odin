decode_BoundSearchFoundGrant :: proc(v: json.Value, out: ^BoundSearchFoundGrant) -> bool {
	when COVERAGE do cov_hit("BoundSearchFoundGrant")
	if v.kind != .Object do return fail("BoundSearchFoundGrant: not an object")
