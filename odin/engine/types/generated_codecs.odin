encode_PlaneswalkReplacementScope :: proc(b: ^strings.Builder, x: PlaneswalkReplacementScope) {
	@(static, rodata) NAMES := [PlaneswalkReplacementScope]string{
		.Any = "Any",
		.PlanarDieOnly = "PlanarDieOnly",
	}
	json.write_string(b, NAMES[x])
}

decode_ShieldKind :: proc(v: json.Value, out: ^ShieldKind) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ShieldKind: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ShieldKind: not a string or object")
	}
	switch variant {
	case "None": out^ = ShieldKind_None{}
	case "Regeneration": out^ = ShieldKind_Regeneration{}
	case "Prevention":
		tmp: ShieldKind_Prevention
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ShieldKind_Prevention) -> bool {
	if fv, found := get_any(v, "amount"); found { if !decode_PreventionAmount(fv, &out.amount) do return fail("ShieldKind::Prevention.amount") } else { return fail("ShieldKind::Prevention.amount missing") }
	return true
		}) { return fail("ShieldKind::Prevention") }
		out^ = tmp
	case "DamageReplacementOneShot": out^ = ShieldKind_DamageReplacementOneShot{}
	case "Redirection":
		tmp: ShieldKind_Redirection
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ShieldKind_Redirection) -> bool {
	if fv, found := get_any(v, "recipient"); found { if !decode_DamageRedirectTarget(fv, &out.recipient) do return fail("ShieldKind::Redirection.recipient") } else { return fail("ShieldKind::Redirection.recipient missing") }
	if fv, found := get_any(v, "amount"); found { if !decode_PreventionAmount(fv, &out.amount) do return fail("ShieldKind::Redirection.amount") } else { return fail("ShieldKind::Redirection.amount missing") }
	if fv, found := get_any(v, "lifetime"); found { if !decode_RedirectionLifetime(fv, &out.lifetime) do return fail("ShieldKind::Redirection.lifetime") }
	return true
		}) { return fail("ShieldKind::Redirection") }
		out^ = tmp
	case "PreventionOneShot": out^ = ShieldKind_PreventionOneShot{}
	case: return fail("ShieldKind: unknown variant")
	}
	return true
}

encode_ShieldKind :: proc(b: ^strings.Builder, x: ShieldKind) {
	#partial switch y in x {
	case ShieldKind_None: _ = y; json.write_string(b, "None")
	case ShieldKind_Regeneration: _ = y; json.write_string(b, "Regeneration")
	case ShieldKind_Prevention: strings.write_byte(b, '{'); json.write_string(b, "Prevention"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "amount"); encode_PreventionAmount(b, y.amount)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ShieldKind_DamageReplacementOneShot: _ = y; json.write_string(b, "DamageReplacementOneShot")
	case ShieldKind_Redirection: strings.write_byte(b, '{'); json.write_string(b, "Redirection"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "recipient"); encode_DamageRedirectTarget(b, y.recipient)
	member(b, first, "amount"); encode_PreventionAmount(b, y.amount)
	member(b, first, "lifetime"); encode_RedirectionLifetime(b, y.lifetime)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ShieldKind_PreventionOneShot: _ = y; json.write_string(b, "PreventionOneShot")
	}
}

decode_QuantityModification :: proc(v: json.Value, out: ^QuantityModification) -> bool {
	if v.kind != .Object do return fail("QuantityModification: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("QuantityModification: no tag")
	switch tv.text {
	case "Times":
		tmp: QuantityModification_Times
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityModification_Times) -> bool {
	if fv, found := get_any(v, "factor"); found { if !decode_u32(fv, &out.factor) do return fail("QuantityModification::Times.factor") } else { return fail("QuantityModification::Times.factor missing") }
	return true
		}) { return fail("QuantityModification::Times") }
		out^ = tmp
	case "Half": out^ = QuantityModification_Half{}
	case "Plus":
		tmp: QuantityModification_Plus
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityModification_Plus) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_u32(fv, &out.value) do return fail("QuantityModification::Plus.value") } else { return fail("QuantityModification::Plus.value missing") }
	return true
		}) { return fail("QuantityModification::Plus") }
		out^ = tmp
	case "Minus":
		tmp: QuantityModification_Minus
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityModification_Minus) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_u32(fv, &out.value) do return fail("QuantityModification::Minus.value") } else { return fail("QuantityModification::Minus.value missing") }
	return true
		}) { return fail("QuantityModification::Minus") }
		out^ = tmp
	case "Prevent": out^ = QuantityModification_Prevent{}
	case: return fail("QuantityModification: unknown variant")
	}
	return true
}

encode_QuantityModification :: proc(b: ^strings.Builder, x: QuantityModification) {
	#partial switch y in x {
	case QuantityModification_Times: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Times")
	member(b, first, "factor"); encode_u32(b, y.factor)
	}; strings.write_byte(b, '}')
	case QuantityModification_Half: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Half"); strings.write_byte(b, '}')
	case QuantityModification_Plus: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Plus")
	member(b, first, "value"); encode_u32(b, y.value)
	}; strings.write_byte(b, '}')
	case QuantityModification_Minus: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Minus")
	member(b, first, "value"); encode_u32(b, y.value)
	}; strings.write_byte(b, '}')
	case QuantityModification_Prevent: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Prevent"); strings.write_byte(b, '}')
	}
}

encode_QuantityModification_members :: proc(b: ^strings.Builder, x: QuantityModification, first: ^bool) {
	#partial switch y in x {
	case QuantityModification_Times: member(b, first, "type"); json.write_string(b, "Times")
	member(b, first, "factor"); encode_u32(b, y.factor)

	case QuantityModification_Half: _ = y; member(b, first, "type"); json.write_string(b, "Half")
	case QuantityModification_Plus: member(b, first, "type"); json.write_string(b, "Plus")
	member(b, first, "value"); encode_u32(b, y.value)

	case QuantityModification_Minus: member(b, first, "type"); json.write_string(b, "Minus")
	member(b, first, "value"); encode_u32(b, y.value)

	case QuantityModification_Prevent: _ = y; member(b, first, "type"); json.write_string(b, "Prevent")
	}
}

