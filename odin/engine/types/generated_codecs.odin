	case GameEvent_KeywordAbilityActivated: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "KeywordAbilityActivated"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "ability_tag"); encode_AbilityTag(b, y.ability_tag)
