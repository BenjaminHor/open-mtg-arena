decode_DieResultFilter :: proc(v: json.Value, out: ^DieResultFilter) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("DieResultFilter: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("DieResultFilter: not a string or object")
	}
	switch variant {
	case "Exact": tmp: DieResultFilter_Exact; if !dec_dyn_u8(body, &tmp._0) do return fail("DieResultFilter::Exact"); out^ = tmp
	case "AtLeast": tmp: DieResultFilter_AtLeast; if !decode_u8(body, &tmp._0) do return fail("DieResultFilter::AtLeast"); out^ = tmp
	case: return fail("DieResultFilter: unknown variant")
	}
	return true
}

encode_DieResultFilter :: proc(b: ^strings.Builder, x: DieResultFilter) {
	#partial switch y in x {
	case DieResultFilter_Exact: strings.write_byte(b, '{'); json.write_string(b, "Exact"); strings.write_byte(b, ':'); enc_dyn_u8(b, y._0); strings.write_byte(b, '}')
	case DieResultFilter_AtLeast: strings.write_byte(b, '{'); json.write_string(b, "AtLeast"); strings.write_byte(b, ':'); encode_u8(b, y._0); strings.write_byte(b, '}')
	}
}

