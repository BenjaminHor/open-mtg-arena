	case Effect_SetDayNight: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetDayNight")
	member(b, first, "to"); encode_DayNight(b, y.to)
	}; strings.write_byte(b, '}')
