encode_CompanionRevealChoice_members :: proc(b: ^strings.Builder, x: CompanionRevealChoice, first: ^bool) {
	member(b, first, "name"); encode_string(b, x.name)
	member(b, first, "source"); encode_CompanionChoiceSource(b, x.source)
}

decode_TimeTravelPhase :: proc(v: json.Value, out: ^TimeTravelPhase) -> bool {
	when COVERAGE do cov_hit("TimeTravelPhase")
	if v.kind != .String do return fail("TimeTravelPhase: not a string")
	str := v.text
	switch str {
	case "Remove": when COVERAGE do cov_hit("TimeTravelPhase::Remove"); out^ = .Remove
	case "Add": when COVERAGE do cov_hit("TimeTravelPhase::Add"); out^ = .Add
	case: return fail("TimeTravelPhase: unknown variant")
	}
	return true
}

encode_TimeTravelPhase :: proc(b: ^strings.Builder, x: TimeTravelPhase) {
	@(static, rodata) NAMES := [TimeTravelPhase]string{
		.Remove = "Remove",
		.Add = "Add",
	}
	json.write_string(b, NAMES[x])
}

decode_CategoryChooserScope :: proc(v: json.Value, out: ^CategoryChooserScope) -> bool {
	when COVERAGE do cov_hit("CategoryChooserScope")
	if v.kind != .String do return fail("CategoryChooserScope: not a string")
	str := v.text
	switch str {
	case "EachPlayerSelf": when COVERAGE do cov_hit("CategoryChooserScope::EachPlayerSelf"); out^ = .EachPlayerSelf
	case "ControllerForAll": when COVERAGE do cov_hit("CategoryChooserScope::ControllerForAll"); out^ = .ControllerForAll
	case: return fail("CategoryChooserScope: unknown variant")
	}
	return true
}

encode_CategoryChooserScope :: proc(b: ^strings.Builder, x: CategoryChooserScope) {
	@(static, rodata) NAMES := [CategoryChooserScope]string{
		.EachPlayerSelf = "EachPlayerSelf",
		.ControllerForAll = "ControllerForAll",
	}
	json.write_string(b, NAMES[x])
}

