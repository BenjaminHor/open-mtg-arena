	case FlashbackCost_NonMana: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NonMana"); member(b, &f, "data"); encode_AbilityCost(b, y._0); strings.write_byte(b, '}')
	}
