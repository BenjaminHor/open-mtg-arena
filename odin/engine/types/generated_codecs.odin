decode_AttachCardinality :: proc(v: json.Value, out: ^AttachCardinality) -> bool {
	when COVERAGE do cov_hit("AttachCardinality")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("AttachCardinality: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("AttachCardinality: not a string or object")
	}
	switch variant {
	case "one": when COVERAGE do cov_hit("AttachCardinality::one"); out^ = AttachCardinality_One{}
	case "up_to": when COVERAGE do cov_hit("AttachCardinality::up_to"); tmp: AttachCardinality_UpTo; if !decode_QuantityExpr(body, &tmp._0) do return fail("AttachCardinality::UpTo"); out^ = tmp
	case "any_number": when COVERAGE do cov_hit("AttachCardinality::any_number"); out^ = AttachCardinality_AnyNumber{}
	case "all": when COVERAGE do cov_hit("AttachCardinality::all"); out^ = AttachCardinality_All{}
	case: return fail("AttachCardinality: unknown variant")
	}
	return true
}

encode_AttachCardinality :: proc(b: ^strings.Builder, x: AttachCardinality) {
	#partial switch y in x {
	case AttachCardinality_One: _ = y; json.write_string(b, "one")
	case AttachCardinality_UpTo: strings.write_byte(b, '{'); json.write_string(b, "up_to"); strings.write_byte(b, ':'); encode_QuantityExpr(b, y._0); strings.write_byte(b, '}')
	case AttachCardinality_AnyNumber: _ = y; json.write_string(b, "any_number")
	case AttachCardinality_All: _ = y; json.write_string(b, "all")
	}
}

