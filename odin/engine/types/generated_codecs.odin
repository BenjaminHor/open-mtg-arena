	return dec_map_PlayerId_ActiveSearchDecisionControl(v, cast(^map[PlayerId]ActiveSearchDecisionControl)out)
}

encode_ActiveSearchDecisionControls :: proc(b: ^strings.Builder, x: ActiveSearchDecisionControls) {
	enc_map_PlayerId_ActiveSearchDecisionControl(b, cast(map[PlayerId]ActiveSearchDecisionControl)x)
}

decode_ObjectMap :: proc(v: json.Value, out: ^ObjectMap) -> bool {
	when COVERAGE do cov_hit("ObjectMap")
	return dec_shared_map_ObjectId_ptr_GameObject(v, &out.inner)
}

encode_ObjectMap :: proc(b: ^strings.Builder, x: ObjectMap) {
	enc_shared_map_ObjectId_ptr_GameObject(b, x.inner)
}

decode_ResolvedRulesJournal :: proc(v: json.Value, out: ^ResolvedRulesJournal) -> bool {
	when COVERAGE do cov_hit("ResolvedRulesJournal")
	if v.kind != .Object do return fail("ResolvedRulesJournal: not an object")
	if fv, found := get_any(v, "next_command_ordinal"); found { if !decode_u64(fv, &out.next_command_ordinal) do return fail("ResolvedRulesJournal.next_command_ordinal") } else { return fail("ResolvedRulesJournal.next_command_ordinal missing") }
	if fv, found := get_any(v, "next_settlement_node_ordinal"); found { if !decode_u64(fv, &out.next_settlement_node_ordinal) do return fail("ResolvedRulesJournal.next_settlement_node_ordinal") } else { return fail("ResolvedRulesJournal.next_settlement_node_ordinal missing") }
	if fv, found := get_any(v, "entries"); found { if !dec_PVec_ResolvedCommandJournalEntry(fv, &out.entries) do return fail("ResolvedRulesJournal.entries") }
	if fv, found := get_any(v, "nodes"); found { if !dec_PVec_SettlementNode(fv, &out.nodes) do return fail("ResolvedRulesJournal.nodes") }
	if fv, found := get_any(v, "produced_mana"); found { if !dec_PVec_ProducedManaUnit(fv, &out.produced_mana) do return fail("ResolvedRulesJournal.produced_mana") }
	if fv, found := get_any(v, "spent_mana"); found { if !dec_PVec_SpentManaUnit(fv, &out.spent_mana) do return fail("ResolvedRulesJournal.spent_mana") }
	return true
}

encode_ResolvedRulesJournal :: proc(b: ^strings.Builder, x: ResolvedRulesJournal) {
	strings.write_byte(b, '{')
	f := true
	encode_ResolvedRulesJournal_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ResolvedRulesJournal_members :: proc(b: ^strings.Builder, x: ResolvedRulesJournal, first: ^bool) {
	member(b, first, "next_command_ordinal"); encode_u64(b, x.next_command_ordinal)
	member(b, first, "next_settlement_node_ordinal"); encode_u64(b, x.next_settlement_node_ordinal)
	member(b, first, "entries"); enc_PVec_ResolvedCommandJournalEntry(b, x.entries)
	member(b, first, "nodes"); enc_PVec_SettlementNode(b, x.nodes)
	member(b, first, "produced_mana"); enc_PVec_ProducedManaUnit(b, x.produced_mana)
	member(b, first, "spent_mana"); enc_PVec_SpentManaUnit(b, x.spent_mana)
}

decode_AbilityOnsetRecord :: proc(v: json.Value, out: ^AbilityOnsetRecord) -> bool {
	when COVERAGE do cov_hit("AbilityOnsetRecord")
	if v.kind != .String do return fail("AbilityOnsetRecord: not a string")
	str := v.text
	switch str {
	case "Unrecorded": when COVERAGE do cov_hit("AbilityOnsetRecord::Unrecorded"); out^ = .Unrecorded
	case "Recorded": when COVERAGE do cov_hit("AbilityOnsetRecord::Recorded"); out^ = .Recorded
	case: return fail("AbilityOnsetRecord: unknown variant")
	}
	return true
}

encode_AbilityOnsetRecord :: proc(b: ^strings.Builder, x: AbilityOnsetRecord) {
	@(static, rodata) NAMES := [AbilityOnsetRecord]string{
		.Unrecorded = "Unrecorded",
		.Recorded = "Recorded",
	}
	json.write_string(b, NAMES[x])
}

decode_ManaPipId :: proc(v: json.Value, out: ^ManaPipId) -> bool {
	when COVERAGE do cov_hit("ManaPipId")
	return decode_u64(v, cast(^u64)out)
}

encode_ManaPipId :: proc(b: ^strings.Builder, x: ManaPipId) {
	encode_u64(b, cast(u64)x)
}

decode_RulesExecutionNodeRef :: proc(v: json.Value, out: ^RulesExecutionNodeRef) -> bool {
	when COVERAGE do cov_hit("RulesExecutionNodeRef")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("RulesExecutionNodeRef: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("RulesExecutionNodeRef: not a string or object")
	}
	switch variant {
	case "Proposal": when COVERAGE do cov_hit("RulesExecutionNodeRef::Proposal"); tmp: RulesExecutionNodeRef_Proposal; if !decode_ResolvedCommandOrdinal(body, &tmp._0) do return fail("RulesExecutionNodeRef::Proposal"); out^ = tmp
	case "ActivatedMana": when COVERAGE do cov_hit("RulesExecutionNodeRef::ActivatedMana"); tmp: RulesExecutionNodeRef_ActivatedMana; if !decode_SettlementNodeOrdinal(body, &tmp._0) do return fail("RulesExecutionNodeRef::ActivatedMana"); out^ = tmp
	case "TriggeredMana": when COVERAGE do cov_hit("RulesExecutionNodeRef::TriggeredMana"); tmp: RulesExecutionNodeRef_TriggeredMana; if !decode_SettlementNodeOrdinal(body, &tmp._0) do return fail("RulesExecutionNodeRef::TriggeredMana"); out^ = tmp
	case "Payment": when COVERAGE do cov_hit("RulesExecutionNodeRef::Payment"); tmp: RulesExecutionNodeRef_Payment; if !decode_SettlementNodeOrdinal(body, &tmp._0) do return fail("RulesExecutionNodeRef::Payment"); out^ = tmp
	case "PlayerLeave": when COVERAGE do cov_hit("RulesExecutionNodeRef::PlayerLeave"); tmp: RulesExecutionNodeRef_PlayerLeave; if !decode_ResolvedCommandOrdinal(body, &tmp._0) do return fail("RulesExecutionNodeRef::PlayerLeave"); out^ = tmp
	case: return fail("RulesExecutionNodeRef: unknown variant")
	}
	return true
}

encode_RulesExecutionNodeRef :: proc(b: ^strings.Builder, x: RulesExecutionNodeRef) {
	#partial switch y in x {
	case RulesExecutionNodeRef_Proposal: strings.write_byte(b, '{'); json.write_string(b, "Proposal"); strings.write_byte(b, ':'); encode_ResolvedCommandOrdinal(b, y._0); strings.write_byte(b, '}')
	case RulesExecutionNodeRef_ActivatedMana: strings.write_byte(b, '{'); json.write_string(b, "ActivatedMana"); strings.write_byte(b, ':'); encode_SettlementNodeOrdinal(b, y._0); strings.write_byte(b, '}')
	case RulesExecutionNodeRef_TriggeredMana: strings.write_byte(b, '{'); json.write_string(b, "TriggeredMana"); strings.write_byte(b, ':'); encode_SettlementNodeOrdinal(b, y._0); strings.write_byte(b, '}')
	case RulesExecutionNodeRef_Payment: strings.write_byte(b, '{'); json.write_string(b, "Payment"); strings.write_byte(b, ':'); encode_SettlementNodeOrdinal(b, y._0); strings.write_byte(b, '}')
	case RulesExecutionNodeRef_PlayerLeave: strings.write_byte(b, '{'); json.write_string(b, "PlayerLeave"); strings.write_byte(b, ':'); encode_ResolvedCommandOrdinal(b, y._0); strings.write_byte(b, '}')
	}
}

