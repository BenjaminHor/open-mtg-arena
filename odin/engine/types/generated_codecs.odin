		.PartitionOnly = "partition_only",
		.OrderOnly = "order_only",
	}
	json.write_string(b, NAMES[x])
}

decode_LibraryPlacementContinuation :: proc(v: json.Value, out: ^LibraryPlacementContinuation) -> bool {
	when COVERAGE do cov_hit("LibraryPlacementContinuation")
	// untagged: the first variant that decodes wins, as in serde.
	{ tmp: LibraryPlacementContinuation_Requests; if decode_quiet_proc(v, &tmp._0, dec_ptr_BatchCompletion) { out^ = tmp; return true } }
	if v.kind == .Object { tmp: LibraryPlacementContinuation_ApprovedBatch; if decode_quiet_proc(v, &tmp, proc(v: json.Value, out: ^LibraryPlacementContinuation_ApprovedBatch) -> bool {
	if fv, found := get_any(v, "logical_group_id"); found { if !decode_LogicalZoneChangeGroupId(fv, &out.logical_group_id) do return fail("LibraryPlacementContinuation::ApprovedBatch.logical_group_id") } else { return fail("LibraryPlacementContinuation::ApprovedBatch.logical_group_id missing") }
	return true
	}) { out^ = tmp; return true } }
	return fail("LibraryPlacementContinuation: no untagged variant matched")
}

encode_LibraryPlacementContinuation :: proc(b: ^strings.Builder, x: LibraryPlacementContinuation) {
	#partial switch y in x {
	case LibraryPlacementContinuation_Requests: enc_ptr_BatchCompletion(b, y._0)
	case LibraryPlacementContinuation_ApprovedBatch: strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "logical_group_id"); encode_LogicalZoneChangeGroupId(b, y.logical_group_id)
	}; strings.write_byte(b, '}')
	}
}

decode_ObjectSelectionCardinality :: proc(v: json.Value, out: ^ObjectSelectionCardinality) -> bool {
	when COVERAGE do cov_hit("ObjectSelectionCardinality")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ObjectSelectionCardinality: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ObjectSelectionCardinality: not a string or object")
	}
	switch variant {
	case "Exactly": when COVERAGE do cov_hit("ObjectSelectionCardinality::Exactly");
		tmp: ObjectSelectionCardinality_Exactly
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ObjectSelectionCardinality_Exactly) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("ObjectSelectionCardinality::Exactly.count") } else { return fail("ObjectSelectionCardinality::Exactly.count missing") }
	return true
		}) { return fail("ObjectSelectionCardinality::Exactly") }
		out^ = tmp
	case "AnyNumber": when COVERAGE do cov_hit("ObjectSelectionCardinality::AnyNumber"); out^ = ObjectSelectionCardinality_AnyNumber{}
	case: return fail("ObjectSelectionCardinality: unknown variant")
	}
	return true
}

encode_ObjectSelectionCardinality :: proc(b: ^strings.Builder, x: ObjectSelectionCardinality) {
	#partial switch y in x {
	case ObjectSelectionCardinality_Exactly: strings.write_byte(b, '{'); json.write_string(b, "Exactly"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ObjectSelectionCardinality_AnyNumber: _ = y; json.write_string(b, "AnyNumber")
	}
}

decode_PendingManaAbility :: proc(v: json.Value, out: ^PendingManaAbility) -> bool {
	when COVERAGE do cov_hit("PendingManaAbility")
	if v.kind != .Object do return fail("PendingManaAbility: not an object")
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("PendingManaAbility.player") } else { return fail("PendingManaAbility.player missing") }
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("PendingManaAbility.source_id") } else { return fail("PendingManaAbility.source_id missing") }
	if fv, found := get_any(v, "ability_index"); found { if !dec_opt_int(fv, &out.ability_index) do return fail("PendingManaAbility.ability_index") }
	if fv, found := get_any(v, "rules_execution_node"); found { if !dec_opt_RulesExecutionNodeRef(fv, &out.rules_execution_node) do return fail("PendingManaAbility.rules_execution_node") }
	if fv, found := get_any(v, "ability_snapshot"); found { if !dec_opt_AbilityDefinition(fv, &out.ability_snapshot) do return fail("PendingManaAbility.ability_snapshot") }
	if fv, found := get_any(v, "announced_source_incarnation"); found { if !dec_opt_u64(fv, &out.announced_source_incarnation) do return fail("PendingManaAbility.announced_source_incarnation") }
	if fv, found := get_any(v, "announced_usage_key"); found { if !dec_opt_AbilityUsageKey(fv, &out.announced_usage_key) do return fail("PendingManaAbility.announced_usage_key") }
	if fv, found := get_any(v, "color_override"); found { if !dec_opt_ProductionOverride(fv, &out.color_override) do return fail("PendingManaAbility.color_override") }
	if fv, found := get_any(v, "selected_taps_for_mana"); found { if !dec_dyn_TapsForManaSelection(fv, &out.selected_taps_for_mana) do return fail("PendingManaAbility.selected_taps_for_mana") }
	if fv, found := get_any(v, "resume"); found { if !decode_ManaAbilityResume(fv, &out.resume) do return fail("PendingManaAbility.resume") } else { return fail("PendingManaAbility.resume missing") }
	if fv, found := get_any(v, "cost_move_resume"); found { if !dec_opt_ManaAbilityResume(fv, &out.cost_move_resume) do return fail("PendingManaAbility.cost_move_resume") }
	if fv, found := get_any(v, "chosen_tappers"); found { if !dec_opt_dyn_ObjectId(fv, &out.chosen_tappers) do return fail("PendingManaAbility.chosen_tappers") }
	if fv, found := get_any(v, "chosen_discards"); found { if !dec_dyn_ObjectId(fv, &out.chosen_discards) do return fail("PendingManaAbility.chosen_discards") }
	if fv, found := get_any(v, "chosen_mana_payment"); found { if !dec_opt_dyn_ManaType(fv, &out.chosen_mana_payment) do return fail("PendingManaAbility.chosen_mana_payment") }
	if fv, found := get_any(v, "payment_mode"); found { if !decode_CastPaymentMode(fv, &out.payment_mode) do return fail("PendingManaAbility.payment_mode") }
	if fv, found := get_any(v, "pinned_pool_units"); found { if !dec_dyn_ManaPipId(fv, &out.pinned_pool_units) do return fail("PendingManaAbility.pinned_pool_units") }
	if fv, found := get_any(v, "chosen_counter_counts"); found { if !dec_dyn_u32(fv, &out.chosen_counter_counts) do return fail("PendingManaAbility.chosen_counter_counts") } else { return fail("PendingManaAbility.chosen_counter_counts missing") }
	if fv, found := get_any(v, "chosen_x"); found { if !dec_opt_u32(fv, &out.chosen_x) do return fail("PendingManaAbility.chosen_x") }
	if fv, found := get_any(v, "collected_evidence"); found { if !dec_dyn_ObjectId(fv, &out.collected_evidence) do return fail("PendingManaAbility.collected_evidence") }
	if fv, found := get_any(v, "chosen_exiled"); found { if !dec_dyn_ObjectId(fv, &out.chosen_exiled) do return fail("PendingManaAbility.chosen_exiled") }
	if fv, found := get_any(v, "chosen_sacrificed_battlefield"); found { if !dec_dyn_ObjectId(fv, &out.chosen_sacrificed_battlefield) do return fail("PendingManaAbility.chosen_sacrificed_battlefield") }
	if fv, found := get_any(v, "cost_paid_object"); found { if !dec_opt_CostPaidObjectSnapshot(fv, &out.cost_paid_object) do return fail("PendingManaAbility.cost_paid_object") }
	if fv, found := get_any(v, "cost_removed_counters"); found { if !dec_opt_u32(fv, &out.cost_removed_counters) do return fail("PendingManaAbility.cost_removed_counters") }
	if fv, found := get_any(v, "batch_siblings"); found { if !dec_dyn_ObjectId(fv, &out.batch_siblings) do return fail("PendingManaAbility.batch_siblings") }
	return true
}

encode_PendingManaAbility :: proc(b: ^strings.Builder, x: PendingManaAbility) {
	strings.write_byte(b, '{')
	f := true
	encode_PendingManaAbility_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PendingManaAbility_members :: proc(b: ^strings.Builder, x: PendingManaAbility, first: ^bool) {
	member(b, first, "player"); encode_PlayerId(b, x.player)
	member(b, first, "source_id"); encode_ObjectId(b, x.source_id)
	member(b, first, "ability_index"); enc_opt_int(b, x.ability_index)
	if !(x.rules_execution_node == nil) { member(b, first, "rules_execution_node"); enc_opt_RulesExecutionNodeRef(b, x.rules_execution_node) }
	if !(x.ability_snapshot == nil) { member(b, first, "ability_snapshot"); enc_opt_AbilityDefinition(b, x.ability_snapshot) }
	if !(x.announced_source_incarnation == nil) { member(b, first, "announced_source_incarnation"); enc_opt_u64(b, x.announced_source_incarnation) }
	if !(x.announced_usage_key == nil) { member(b, first, "announced_usage_key"); enc_opt_AbilityUsageKey(b, x.announced_usage_key) }
	if !(x.color_override == nil) { member(b, first, "color_override"); enc_opt_ProductionOverride(b, x.color_override) }
	if !((len(x.selected_taps_for_mana) == 0)) { member(b, first, "selected_taps_for_mana"); enc_dyn_TapsForManaSelection(b, x.selected_taps_for_mana) }
	member(b, first, "resume"); encode_ManaAbilityResume(b, x.resume)
	if !(x.cost_move_resume == nil) { member(b, first, "cost_move_resume"); enc_opt_ManaAbilityResume(b, x.cost_move_resume) }
	member(b, first, "chosen_tappers"); enc_opt_dyn_ObjectId(b, x.chosen_tappers)
	if !((len(x.chosen_discards) == 0)) { member(b, first, "chosen_discards"); enc_dyn_ObjectId(b, x.chosen_discards) }
	if !(x.chosen_mana_payment == nil) { member(b, first, "chosen_mana_payment"); enc_opt_dyn_ManaType(b, x.chosen_mana_payment) }
	if !(skip_PendingManaAbility_CastPaymentMode_is_auto_CastPaymentMode(x.payment_mode)) { member(b, first, "payment_mode"); encode_CastPaymentMode(b, x.payment_mode) }
	if !((len(x.pinned_pool_units) == 0)) { member(b, first, "pinned_pool_units"); enc_dyn_ManaPipId(b, x.pinned_pool_units) }
	member(b, first, "chosen_counter_counts"); enc_dyn_u32(b, x.chosen_counter_counts)
	if !(x.chosen_x == nil) { member(b, first, "chosen_x"); enc_opt_u32(b, x.chosen_x) }
	if !((len(x.collected_evidence) == 0)) { member(b, first, "collected_evidence"); enc_dyn_ObjectId(b, x.collected_evidence) }
	if !((len(x.chosen_exiled) == 0)) { member(b, first, "chosen_exiled"); enc_dyn_ObjectId(b, x.chosen_exiled) }
	if !((len(x.chosen_sacrificed_battlefield) == 0)) { member(b, first, "chosen_sacrificed_battlefield"); enc_dyn_ObjectId(b, x.chosen_sacrificed_battlefield) }
	if !(x.cost_paid_object == nil) { member(b, first, "cost_paid_object"); enc_opt_CostPaidObjectSnapshot(b, x.cost_paid_object) }
	if !(x.cost_removed_counters == nil) { member(b, first, "cost_removed_counters"); enc_opt_u32(b, x.cost_removed_counters) }
	if !((len(x.batch_siblings) == 0)) { member(b, first, "batch_siblings"); enc_dyn_ObjectId(b, x.batch_siblings) }
}

decode_SearchSelectionConstraint :: proc(v: json.Value, out: ^SearchSelectionConstraint) -> bool {
	when COVERAGE do cov_hit("SearchSelectionConstraint")
	if v.kind != .Object do return fail("SearchSelectionConstraint: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("SearchSelectionConstraint: no tag")
	switch tv.text {
	case "None": when COVERAGE do cov_hit("SearchSelectionConstraint::None"); out^ = SearchSelectionConstraint_None{}
	case "SharesQualities", "DistinctQualities": when COVERAGE do cov_hit("SearchSelectionConstraint::SharesQualities");
		tmp: SearchSelectionConstraint_SharesQualities
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^SearchSelectionConstraint_SharesQualities) -> bool {
	if fv, found := get_any(v, "qualities"); found { if !dec_dyn_SharedQuality(fv, &out.qualities) do return fail("SearchSelectionConstraint::SharesQualities.qualities") } else { return fail("SearchSelectionConstraint::SharesQualities.qualities missing") }
	if fv, found := get_any(v, "relation"); found { if !decode_SharedQualityRelation(fv, &out.relation) do return fail("SearchSelectionConstraint::SharesQualities.relation") } else { out.relation = default_SearchSelectionConstraint_default_legacy_distinct_qualities_relation() }
	return true
		}) { return fail("SearchSelectionConstraint::SharesQualities") }
		out^ = tmp
	case "TotalManaValue": when COVERAGE do cov_hit("SearchSelectionConstraint::TotalManaValue");
		tmp: SearchSelectionConstraint_TotalManaValue
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^SearchSelectionConstraint_TotalManaValue) -> bool {
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("SearchSelectionConstraint::TotalManaValue.comparator") } else { return fail("SearchSelectionConstraint::TotalManaValue.comparator missing") }
	if fv, found := get_any(v, "value"); found { if !decode_i32(fv, &out.value) do return fail("SearchSelectionConstraint::TotalManaValue.value") } else { return fail("SearchSelectionConstraint::TotalManaValue.value missing") }
	return true
		}) { return fail("SearchSelectionConstraint::TotalManaValue") }
		out^ = tmp
	case "MatchEachFilter": when COVERAGE do cov_hit("SearchSelectionConstraint::MatchEachFilter");
		tmp: SearchSelectionConstraint_MatchEachFilter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^SearchSelectionConstraint_MatchEachFilter) -> bool {
