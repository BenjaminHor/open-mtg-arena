	json.write_string(b, NAMES[x])
}

decode_Supertype :: proc(v: json.Value, out: ^Supertype) -> bool {
	if v.kind != .String do return fail("Supertype: not a string")
	str := v.text
	switch str {
	case "Legendary": out^ = .Legendary
	case "Basic": out^ = .Basic
	case "Snow": out^ = .Snow
	case "World": out^ = .World
	case "Ongoing": out^ = .Ongoing
	case "Host": out^ = .Host
	case: return fail("Supertype: unknown variant")
	}
	return true
}

encode_Supertype :: proc(b: ^strings.Builder, x: Supertype) {
	@(static, rodata) NAMES := [Supertype]string{
		.Legendary = "Legendary",
		.Basic = "Basic",
		.Snow = "Snow",
		.World = "World",
		.Ongoing = "Ongoing",
		.Host = "Host",
	}
	json.write_string(b, NAMES[x])
}

