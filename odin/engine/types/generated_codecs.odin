	if !(x.identity == nil) { member(b, first, "identity"); enc_opt_ObjectIncarnationRef(b, x.identity) }
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	member(b, first, "kind"); encode_AttachmentKind(b, x.kind)
}

