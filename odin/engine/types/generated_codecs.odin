decode_UntilCondition :: proc(v: json.Value, out: ^UntilCondition) -> bool {
	if v.kind != .Object do return fail("UntilCondition: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("UntilCondition: no tag")
	switch tv.text {
	case "NextMatches":
		tmp: UntilCondition_NextMatches
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^UntilCondition_NextMatches) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("UntilCondition::NextMatches.filter") } else { return fail("UntilCondition::NextMatches.filter missing") }
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("UntilCondition::NextMatches.count") } else { out.count = default_UntilCondition_default_quantity_one() }
	return true
		}) { return fail("UntilCondition::NextMatches") }
		out^ = tmp
	case "CumulativeThreshold":
		tmp: UntilCondition_CumulativeThreshold
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^UntilCondition_CumulativeThreshold) -> bool {
	if fv, found := get_any(v, "property"); found { if !decode_ObjectProperty(fv, &out.property) do return fail("UntilCondition::CumulativeThreshold.property") } else { return fail("UntilCondition::CumulativeThreshold.property missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("UntilCondition::CumulativeThreshold.comparator") } else { return fail("UntilCondition::CumulativeThreshold.comparator missing") }
	if fv, found := get_any(v, "threshold"); found { if !decode_QuantityExpr(fv, &out.threshold) do return fail("UntilCondition::CumulativeThreshold.threshold") } else { return fail("UntilCondition::CumulativeThreshold.threshold missing") }
	return true
		}) { return fail("UntilCondition::CumulativeThreshold") }
		out^ = tmp
	case: return fail("UntilCondition: unknown variant")
	}
	return true
}

encode_UntilCondition :: proc(b: ^strings.Builder, x: UntilCondition) {
	#partial switch y in x {
	case UntilCondition_NextMatches: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "NextMatches")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	if !(skip_UntilCondition_is_default_quantity_one(y.count)) { member(b, first, "count"); encode_QuantityExpr(b, y.count) }
	}; strings.write_byte(b, '}')
	case UntilCondition_CumulativeThreshold: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CumulativeThreshold")
	member(b, first, "property"); encode_ObjectProperty(b, y.property)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "threshold"); encode_QuantityExpr(b, y.threshold)
	}; strings.write_byte(b, '}')
	}
}

encode_UntilCondition_members :: proc(b: ^strings.Builder, x: UntilCondition, first: ^bool) {
	#partial switch y in x {
	case UntilCondition_NextMatches: member(b, first, "type"); json.write_string(b, "NextMatches")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	if !(skip_UntilCondition_is_default_quantity_one(y.count)) { member(b, first, "count"); encode_QuantityExpr(b, y.count) }

	case UntilCondition_CumulativeThreshold: member(b, first, "type"); json.write_string(b, "CumulativeThreshold")
	member(b, first, "property"); encode_ObjectProperty(b, y.property)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "threshold"); encode_QuantityExpr(b, y.threshold)

	}
}

