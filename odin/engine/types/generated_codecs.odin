encode_PendingCostMoveResume :: proc(b: ^strings.Builder, x: PendingCostMoveResume) {
	#partial switch y in x {
	case PendingCostMoveResume_Cast: strings.write_byte(b, '{'); json.write_string(b, "Cast"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "pending"); enc_ptr_PendingCast(b, y.pending)
	member(b, first, "chosen"); enc_dyn_ObjectId(b, y.chosen)
	member(b, first, "paused_at_index"); encode_int(b, y.paused_at_index)
	member(b, first, "destination"); encode_Zone(b, y.destination)
	member(b, first, "completion"); encode_PendingCostMoveCompletion(b, y.completion)
	if !(y.requested_cost_count == nil) { member(b, first, "requested_cost_count"); enc_opt_u32(b, y.requested_cost_count) }
	if !((len(y.deferred_cost_events) == 0)) { member(b, first, "deferred_cost_events"); enc_dyn_GameEvent(b, y.deferred_cost_events) }
	if !((len(y.departure_record_indices) == 0)) { member(b, first, "departure_record_indices"); enc_dyn_int(b, y.departure_record_indices) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
