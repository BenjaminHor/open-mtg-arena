	case ContinuousModification_AddAllCreatureTypes: _ = y; member(b, first, "type"); json.write_string(b, "AddAllCreatureTypes")
	case ContinuousModification_AddAllBasicLandTypes: _ = y; member(b, first, "type"); json.write_string(b, "AddAllBasicLandTypes")
	case ContinuousModification_AddAllLandTypes: _ = y; member(b, first, "type"); json.write_string(b, "AddAllLandTypes")
