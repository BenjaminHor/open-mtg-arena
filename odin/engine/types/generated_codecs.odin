decode_FilterProp :: proc(v: json.Value, out: ^FilterProp) -> bool {
	if v.kind != .Object do return fail("FilterProp: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("FilterProp: no tag")
	switch tv.text {
	case "Token": out^ = FilterProp_Token{}
	case "NonToken": out^ = FilterProp_NonToken{}
	case "RepresentedByCard": out^ = FilterProp_RepresentedByCard{}
	case "ControllerChoseLabel":
		tmp: FilterProp_ControllerChoseLabel
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_ControllerChoseLabel) -> bool {
	if fv, found := get_any(v, "label"); found { if !decode_string(fv, &out.label) do return fail("FilterProp::ControllerChoseLabel.label") } else { return fail("FilterProp::ControllerChoseLabel.label missing") }
	return true
		}) { return fail("FilterProp::ControllerChoseLabel") }
		out^ = tmp
	case "ControllerMatches":
		tmp: FilterProp_ControllerMatches
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_ControllerMatches) -> bool {
	if fv, found := get_any(v, "player"); found { if !dec_ptr_PlayerFilter(fv, &out.player) do return fail("FilterProp::ControllerMatches.player") } else { return fail("FilterProp::ControllerMatches.player missing") }
	return true
		}) { return fail("FilterProp::ControllerMatches") }
		out^ = tmp
	case "WasPlayed": out^ = FilterProp_WasPlayed{}
	case "CastThisTurn":
		tmp: FilterProp_CastThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_CastThisTurn) -> bool {
	if fv, found := get_any(v, "caster"); found { if !decode_ControllerRef(fv, &out.caster) do return fail("FilterProp::CastThisTurn.caster") } else { return fail("FilterProp::CastThisTurn.caster missing") }
	return true
		}) { return fail("FilterProp::CastThisTurn") }
		out^ = tmp
	case "Attacking":
		tmp: FilterProp_Attacking
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_Attacking) -> bool {
	if fv, found := get_any(v, "defender"); found { if !dec_opt_ControllerRef(fv, &out.defender) do return fail("FilterProp::Attacking.defender") }
	return true
		}) { return fail("FilterProp::Attacking") }
		out^ = tmp
	case "Blocking": out^ = FilterProp_Blocking{}
	case "BlockingSource": out^ = FilterProp_BlockingSource{}
	case "CombatRelation":
		tmp: FilterProp_CombatRelation
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_CombatRelation) -> bool {
	if fv, found := get_any(v, "relation"); found { if !decode_CombatRelation(fv, &out.relation) do return fail("FilterProp::CombatRelation.relation") } else { return fail("FilterProp::CombatRelation.relation missing") }
	if fv, found := get_any(v, "subject"); found { if !decode_CombatRelationSubject(fv, &out.subject) do return fail("FilterProp::CombatRelation.subject") } else { return fail("FilterProp::CombatRelation.subject missing") }
	return true
		}) { return fail("FilterProp::CombatRelation") }
		out^ = tmp
	case "BlockStatus", "Unblocked":
		tmp: FilterProp_BlockStatus
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_BlockStatus) -> bool {
	if fv, found := get_any(v, "status"); found { if !decode_AttackerBlockStatus(fv, &out.status) do return fail("FilterProp::BlockStatus.status") } else { out.status = default_FilterProp_default_unblocked_status() }
	return true
		}) { return fail("FilterProp::BlockStatus") }
		out^ = tmp
	case "AttackingAlone": out^ = FilterProp_AttackingAlone{}
	case "BlockingAlone": out^ = FilterProp_BlockingAlone{}
	case "Tapped": out^ = FilterProp_Tapped{}
	case "Untapped": out^ = FilterProp_Untapped{}
	case "IsSaddled": out^ = FilterProp_IsSaddled{}
	case "SaddledSource": out^ = FilterProp_SaddledSource{}
	case "CrewedThisTurn":
		tmp: FilterProp_CrewedThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_CrewedThisTurn) -> bool {
	if fv, found := get_any(v, "relation"); found { if !decode_CrewRelation(fv, &out.relation) do return fail("FilterProp::CrewedThisTurn.relation") } else { return fail("FilterProp::CrewedThisTurn.relation missing") }
	return true
		}) { return fail("FilterProp::CrewedThisTurn") }
		out^ = tmp
	case "ConvokedSource": out^ = FilterProp_ConvokedSource{}
	case "ProtectorMatches":
		tmp: FilterProp_ProtectorMatches
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_ProtectorMatches) -> bool {
	if fv, found := get_any(v, "controller"); found { if !decode_ControllerRef(fv, &out.controller) do return fail("FilterProp::ProtectorMatches.controller") } else { return fail("FilterProp::ProtectorMatches.controller missing") }
	return true
		}) { return fail("FilterProp::ProtectorMatches") }
		out^ = tmp
	case "HasHasteOrControlledSinceTurnBegan": out^ = FilterProp_HasHasteOrControlledSinceTurnBegan{}
	case "WithKeyword":
		tmp: FilterProp_WithKeyword
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_WithKeyword) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_Keyword(fv, &out.value) do return fail("FilterProp::WithKeyword.value") } else { return fail("FilterProp::WithKeyword.value missing") }
	return true
		}) { return fail("FilterProp::WithKeyword") }
		out^ = tmp
	case "HasKeywordKind":
		tmp: FilterProp_HasKeywordKind
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_HasKeywordKind) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_KeywordKind(fv, &out.value) do return fail("FilterProp::HasKeywordKind.value") } else { return fail("FilterProp::HasKeywordKind.value missing") }
	return true
		}) { return fail("FilterProp::HasKeywordKind") }
		out^ = tmp
	case "WithoutKeyword":
		tmp: FilterProp_WithoutKeyword
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_WithoutKeyword) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_Keyword(fv, &out.value) do return fail("FilterProp::WithoutKeyword.value") } else { return fail("FilterProp::WithoutKeyword.value missing") }
	return true
		}) { return fail("FilterProp::WithoutKeyword") }
		out^ = tmp
	case "WithoutKeywordKind":
		tmp: FilterProp_WithoutKeywordKind
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_WithoutKeywordKind) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_KeywordKind(fv, &out.value) do return fail("FilterProp::WithoutKeywordKind.value") } else { return fail("FilterProp::WithoutKeywordKind.value missing") }
	return true
		}) { return fail("FilterProp::WithoutKeywordKind") }
		out^ = tmp
	case "CanEnchant":
		tmp: FilterProp_CanEnchant
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_CanEnchant) -> bool {
	if fv, found := get_any(v, "target"); found { if !dec_ptr_TargetFilter(fv, &out.target) do return fail("FilterProp::CanEnchant.target") } else { return fail("FilterProp::CanEnchant.target missing") }
	return true
		}) { return fail("FilterProp::CanEnchant") }
		out^ = tmp
	case "Counters":
		tmp: FilterProp_Counters
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_Counters) -> bool {
	if fv, found := get_any(v, "counters"); found { if !decode_CounterMatch(fv, &out.counters) do return fail("FilterProp::Counters.counters") } else { return fail("FilterProp::Counters.counters missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("FilterProp::Counters.comparator") } else { return fail("FilterProp::Counters.comparator missing") }
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("FilterProp::Counters.count") } else { return fail("FilterProp::Counters.count missing") }
	return true
		}) { return fail("FilterProp::Counters") }
		out^ = tmp
	case "Cmc":
		tmp: FilterProp_Cmc
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_Cmc) -> bool {
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("FilterProp::Cmc.comparator") } else { return fail("FilterProp::Cmc.comparator missing") }
	if fv, found := get_any(v, "value"); found { if !decode_QuantityExpr(fv, &out.value) do return fail("FilterProp::Cmc.value") } else { return fail("FilterProp::Cmc.value missing") }
	return true
		}) { return fail("FilterProp::Cmc") }
		out^ = tmp
	case "ManaValueParity":
		tmp: FilterProp_ManaValueParity
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_ManaValueParity) -> bool {
	if fv, found := get_any(v, "parity"); found { if !decode_ParitySource(fv, &out.parity) do return fail("FilterProp::ManaValueParity.parity") } else { return fail("FilterProp::ManaValueParity.parity missing") }
	return true
		}) { return fail("FilterProp::ManaValueParity") }
		out^ = tmp
	case "ManaCostIn":
		tmp: FilterProp_ManaCostIn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_ManaCostIn) -> bool {
	if fv, found := get_any(v, "costs"); found { if !dec_dyn_ManaCost(fv, &out.costs) do return fail("FilterProp::ManaCostIn.costs") } else { return fail("FilterProp::ManaCostIn.costs missing") }
	return true
		}) { return fail("FilterProp::ManaCostIn") }
		out^ = tmp
	case "InZone":
		tmp: FilterProp_InZone
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_InZone) -> bool {
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("FilterProp::InZone.zone") } else { return fail("FilterProp::InZone.zone missing") }
	return true
		}) { return fail("FilterProp::InZone") }
		out^ = tmp
	case "Owned":
		tmp: FilterProp_Owned
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_Owned) -> bool {
	if fv, found := get_any(v, "controller"); found { if !decode_ControllerRef(fv, &out.controller) do return fail("FilterProp::Owned.controller") } else { return fail("FilterProp::Owned.controller missing") }
	return true
		}) { return fail("FilterProp::Owned") }
		out^ = tmp
	case "Foretold": out^ = FilterProp_Foretold{}
	case "HasAdventure": out^ = FilterProp_HasAdventure{}
	case "EnchantedBy": out^ = FilterProp_EnchantedBy{}
	case "EquippedBy": out^ = FilterProp_EquippedBy{}
	case "AttachedTo":
		tmp: FilterProp_AttachedTo
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_AttachedTo) -> bool {
	if fv, found := get_any(v, "to"); found { if !decode_AttachmentReferent(fv, &out.to) do return fail("FilterProp::AttachedTo.to") } else { return fail("FilterProp::AttachedTo.to missing") }
	return true
		}) { return fail("FilterProp::AttachedTo") }
		out^ = tmp
	case "HasAttachment":
		tmp: FilterProp_HasAttachment
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_HasAttachment) -> bool {
	if fv, found := get_any(v, "kind"); found { if !decode_AttachmentKind(fv, &out.kind) do return fail("FilterProp::HasAttachment.kind") } else { return fail("FilterProp::HasAttachment.kind missing") }
	if fv, found := get_any(v, "controller"); found { if !dec_opt_ControllerRef(fv, &out.controller) do return fail("FilterProp::HasAttachment.controller") }
	if fv, found := get_any(v, "exclude_source"); found { if !decode_with_source_exclusion_bool_compat(fv, &out.exclude_source) do return fail("FilterProp::HasAttachment.exclude_source") }
	return true
		}) { return fail("FilterProp::HasAttachment") }
		out^ = tmp
