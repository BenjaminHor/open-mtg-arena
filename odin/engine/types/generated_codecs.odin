decode_GraveyardPermissionLatch :: proc(v: json.Value, out: ^GraveyardPermissionLatch) -> bool {
	when COVERAGE do cov_hit("GraveyardPermissionLatch")
	if v.kind != .Object do return fail("GraveyardPermissionLatch: not an object")
	if fv, found := get_any(v, "permission"); found { if !decode_GraveyardPermissionId(fv, &out.permission) do return fail("GraveyardPermissionLatch.permission") } else { return fail("GraveyardPermissionLatch.permission missing") }
	if fv, found := get_any(v, "extra_cost"); found { if !dec_opt_CastExtraCost(fv, &out.extra_cost) do return fail("GraveyardPermissionLatch.extra_cost") }
	if fv, found := get_any(v, "enters_with_counter"); found { if !dec_opt_CounterType(fv, &out.enters_with_counter) do return fail("GraveyardPermissionLatch.enters_with_counter") }
	if fv, found := get_any(v, "enter_tapped"); found { if !decode_EtbTapState(fv, &out.enter_tapped) do return fail("GraveyardPermissionLatch.enter_tapped") }
	if fv, found := get_any(v, "cast_limit"); found { if !decode_PermissionCastLimit(fv, &out.cast_limit) do return fail("GraveyardPermissionLatch.cast_limit") }
	if fv, found := get_any(v, "mana_spend_permission"); found { if !dec_opt_ManaSpendPermission(fv, &out.mana_spend_permission) do return fail("GraveyardPermissionLatch.mana_spend_permission") }
	if fv, found := get_any(v, "enters_modifications"); found { if !decode_PendingEntersModifications(fv, &out.enters_modifications) do return fail("GraveyardPermissionLatch.enters_modifications") }
	return true
}

encode_GraveyardPermissionLatch :: proc(b: ^strings.Builder, x: GraveyardPermissionLatch) {
	strings.write_byte(b, '{')
	f := true
	encode_GraveyardPermissionLatch_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_GraveyardPermissionLatch_members :: proc(b: ^strings.Builder, x: GraveyardPermissionLatch, first: ^bool) {
	member(b, first, "permission"); encode_GraveyardPermissionId(b, x.permission)
	if !(x.extra_cost == nil) { member(b, first, "extra_cost"); enc_opt_CastExtraCost(b, x.extra_cost) }
	if !(x.enters_with_counter == nil) { member(b, first, "enters_with_counter"); enc_opt_CounterType(b, x.enters_with_counter) }
	if !(skip_GraveyardPermissionLatch_EtbTapState_is_unspecified_EtbTapState(x.enter_tapped)) { member(b, first, "enter_tapped"); encode_EtbTapState(b, x.enter_tapped) }
	if !(skip_GraveyardPermissionLatch_PermissionCastLimit_is_unlimited_PermissionCastLimit(x.cast_limit)) { member(b, first, "cast_limit"); encode_PermissionCastLimit(b, x.cast_limit) }
	if !(x.mana_spend_permission == nil) { member(b, first, "mana_spend_permission"); enc_opt_ManaSpendPermission(b, x.mana_spend_permission) }
	if !(skip_GraveyardPermissionLatch_PendingEntersModifications_is_empty_PendingEntersModifications(x.enters_modifications)) { member(b, first, "enters_modifications"); encode_PendingEntersModifications(b, x.enters_modifications) }
}

