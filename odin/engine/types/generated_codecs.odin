}

decode_DigRestRemainder :: proc(v: json.Value, out: ^DigRestRemainder) -> bool {
	when COVERAGE do cov_hit("DigRestRemainder")
	if v.kind != .String do return fail("DigRestRemainder: not a string")
	str := v.text
	switch str {
	case "route": when COVERAGE do cov_hit("DigRestRemainder::route"); out^ = .Route
	case "stay_in_library": when COVERAGE do cov_hit("DigRestRemainder::stay_in_library"); out^ = .StayInLibrary
	case: return fail("DigRestRemainder: unknown variant")
	}
	return true
}

encode_DigRestRemainder :: proc(b: ^strings.Builder, x: DigRestRemainder) {
	@(static, rodata) NAMES := [DigRestRemainder]string{
		.Route = "route",
		.StayInLibrary = "stay_in_library",
	}
	json.write_string(b, NAMES[x])
}

decode_DigRestOrder :: proc(v: json.Value, out: ^DigRestOrder) -> bool {
	when COVERAGE do cov_hit("DigRestOrder")
	if v.kind != .String do return fail("DigRestOrder: not a string")
	str := v.text
	switch str {
	case "preserve": when COVERAGE do cov_hit("DigRestOrder::preserve"); out^ = .Preserve
	case "random": when COVERAGE do cov_hit("DigRestOrder::random"); out^ = .Random
	case "player_choice": when COVERAGE do cov_hit("DigRestOrder::player_choice"); out^ = .PlayerChoice
	case: return fail("DigRestOrder: unknown variant")
	}
	return true
}

encode_DigRestOrder :: proc(b: ^strings.Builder, x: DigRestOrder) {
	@(static, rodata) NAMES := [DigRestOrder]string{
		.Preserve = "preserve",
		.Random = "random",
		.PlayerChoice = "player_choice",
	}
	json.write_string(b, NAMES[x])
}

decode_DigRestSplitScope :: proc(v: json.Value, out: ^DigRestSplitScope) -> bool {
	when COVERAGE do cov_hit("DigRestSplitScope")
	if v.kind != .String do return fail("DigRestSplitScope: not a string")
	str := v.text
	switch str {
	case "partition_and_order": when COVERAGE do cov_hit("DigRestSplitScope::partition_and_order"); out^ = .PartitionAndOrder
	case "partition_only": when COVERAGE do cov_hit("DigRestSplitScope::partition_only"); out^ = .PartitionOnly
	case "order_only": when COVERAGE do cov_hit("DigRestSplitScope::order_only"); out^ = .OrderOnly
	case: return fail("DigRestSplitScope: unknown variant")
	}
	return true
}

encode_DigRestSplitScope :: proc(b: ^strings.Builder, x: DigRestSplitScope) {
	@(static, rodata) NAMES := [DigRestSplitScope]string{
