decode_RiderTiming :: proc(v: json.Value, out: ^RiderTiming) -> bool {
	when COVERAGE do cov_hit("RiderTiming")
	if v.kind != .String do return fail("RiderTiming: not a string")
	str := v.text
	switch str {
	case "WithEvent": when COVERAGE do cov_hit("RiderTiming::WithEvent"); out^ = .WithEvent
	case "AfterEvent": when COVERAGE do cov_hit("RiderTiming::AfterEvent"); out^ = .AfterEvent
	case: return fail("RiderTiming: unknown variant")
	}
	return true
}

encode_RiderTiming :: proc(b: ^strings.Builder, x: RiderTiming) {
	@(static, rodata) NAMES := [RiderTiming]string{
		.WithEvent = "WithEvent",
		.AfterEvent = "AfterEvent",
	}
	json.write_string(b, NAMES[x])
}

decode_PostReplacementDrain :: proc(v: json.Value, out: ^PostReplacementDrain) -> bool {
	when COVERAGE do cov_hit("PostReplacementDrain")
	if v.kind != .Object do return fail("PostReplacementDrain: not an object")
	if fv, found := get_any(v, "status"); found { if !decode_DrainStatus(fv, &out.status) do return fail("PostReplacementDrain.status") } else { return fail("PostReplacementDrain.status missing") }
	if fv, found := get_any(v, "source"); found { if !dec_opt_ObjectId(fv, &out.source) do return fail("PostReplacementDrain.source") }
	if fv, found := get_any(v, "applied"); found { if !dec_dyn_AppliedReplacementKey(fv, &out.applied) do return fail("PostReplacementDrain.applied") } else { return fail("PostReplacementDrain.applied missing") }
	if fv, found := get_any(v, "event_source"); found { if !dec_opt_ObjectId(fv, &out.event_source) do return fail("PostReplacementDrain.event_source") }
	if fv, found := get_any(v, "event_target"); found { if !dec_opt_TargetRef(fv, &out.event_target) do return fail("PostReplacementDrain.event_target") }
	if fv, found := get_any(v, "event_amount"); found { if !dec_opt_u32(fv, &out.event_amount) do return fail("PostReplacementDrain.event_amount") }
	if fv, found := get_any(v, "controller"); found { if !dec_opt_PlayerId(fv, &out.controller) do return fail("PostReplacementDrain.controller") }
	if fv, found := get_any(v, "parked_entrants"); found { if !dec_dyn_ObjectIncarnationRef(fv, &out.parked_entrants) do return fail("PostReplacementDrain.parked_entrants") }
	return true
}

encode_PostReplacementDrain :: proc(b: ^strings.Builder, x: PostReplacementDrain) {
	strings.write_byte(b, '{')
	f := true
	encode_PostReplacementDrain_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PostReplacementDrain_members :: proc(b: ^strings.Builder, x: PostReplacementDrain, first: ^bool) {
	member(b, first, "status"); encode_DrainStatus(b, x.status)
	member(b, first, "source"); enc_opt_ObjectId(b, x.source)
	member(b, first, "applied"); enc_dyn_AppliedReplacementKey(b, x.applied)
	member(b, first, "event_source"); enc_opt_ObjectId(b, x.event_source)
	member(b, first, "event_target"); enc_opt_TargetRef(b, x.event_target)
	member(b, first, "event_amount"); enc_opt_u32(b, x.event_amount)
	member(b, first, "controller"); enc_opt_PlayerId(b, x.controller)
	if !((len(x.parked_entrants) == 0)) { member(b, first, "parked_entrants"); enc_dyn_ObjectIncarnationRef(b, x.parked_entrants) }
}

decode_DrainStatus :: proc(v: json.Value, out: ^DrainStatus) -> bool {
	when COVERAGE do cov_hit("DrainStatus")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("DrainStatus: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("DrainStatus: not a string or object")
	}
	switch variant {
	case "Ready": when COVERAGE do cov_hit("DrainStatus::Ready"); tmp: DrainStatus_Ready; if !decode_PostReplacementContinuation(body, &tmp._0) do return fail("DrainStatus::Ready"); out^ = tmp
	case "Dispatching": when COVERAGE do cov_hit("DrainStatus::Dispatching"); out^ = DrainStatus_Dispatching{}
	case "Paused": when COVERAGE do cov_hit("DrainStatus::Paused"); out^ = DrainStatus_Paused{}
	case: return fail("DrainStatus: unknown variant")
	}
	return true
}

encode_DrainStatus :: proc(b: ^strings.Builder, x: DrainStatus) {
	#partial switch y in x {
	case DrainStatus_Ready: strings.write_byte(b, '{'); json.write_string(b, "Ready"); strings.write_byte(b, ':'); encode_PostReplacementContinuation(b, y._0); strings.write_byte(b, '}')
	case DrainStatus_Dispatching: _ = y; json.write_string(b, "Dispatching")
	case DrainStatus_Paused: _ = y; json.write_string(b, "Paused")
	}
}

decode_PostReplacementContinuation :: proc(v: json.Value, out: ^PostReplacementContinuation) -> bool {
	when COVERAGE do cov_hit("PostReplacementContinuation")
	if v.kind != .Object do return fail("PostReplacementContinuation: not an object")
	tv, found := json.get(v, "kind")
	if !found || tv.kind != .String do return fail("PostReplacementContinuation: no tag")
	switch tv.text {
	case "Template": when COVERAGE do cov_hit("PostReplacementContinuation::Template"); tmp: PostReplacementContinuation_Template; if !dec_ptr_AbilityDefinition(json.get_or_null(v, "ability"), &tmp._0) do return fail("PostReplacementContinuation::Template"); out^ = tmp
	case "Resolved": when COVERAGE do cov_hit("PostReplacementContinuation::Resolved"); tmp: PostReplacementContinuation_Resolved; if !dec_ptr_ResolvedAbility(json.get_or_null(v, "ability"), &tmp._0) do return fail("PostReplacementContinuation::Resolved"); out^ = tmp
	case: return fail("PostReplacementContinuation: unknown variant")
	}
	return true
}

encode_PostReplacementContinuation :: proc(b: ^strings.Builder, x: PostReplacementContinuation) {
	#partial switch y in x {
	case PostReplacementContinuation_Template: strings.write_byte(b, '{'); f := true; member(b, &f, "kind"); json.write_string(b, "Template"); member(b, &f, "ability"); enc_ptr_AbilityDefinition(b, y._0); strings.write_byte(b, '}')
	case PostReplacementContinuation_Resolved: strings.write_byte(b, '{'); f := true; member(b, &f, "kind"); json.write_string(b, "Resolved"); member(b, &f, "ability"); enc_ptr_ResolvedAbility(b, y._0); strings.write_byte(b, '}')
	}
