}

decode_ClauseGap :: proc(v: json.Value, out: ^ClauseGap) -> bool {
	if v.kind != .Object do return fail("ClauseGap: not an object")
	tv, found := json.get(v, "kind")
	if !found || tv.kind != .String do return fail("ClauseGap: no tag")
	switch tv.text {
	case "unparsed_replacement":
		tmp: ClauseGap_Replacement
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ClauseGap_Replacement) -> bool {
	if fv, found := get_any(v, "antecedent"); found { if !decode_string(fv, &out.antecedent) do return fail("ClauseGap::Replacement.antecedent") } else { return fail("ClauseGap::Replacement.antecedent missing") }
	return true
		}) { return fail("ClauseGap::Replacement") }
		out^ = tmp
	case "unparsed_condition":
		tmp: ClauseGap_Condition
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ClauseGap_Condition) -> bool {
	if fv, found := get_any(v, "guard"); found { if !decode_string(fv, &out.guard) do return fail("ClauseGap::Condition.guard") } else { return fail("ClauseGap::Condition.guard missing") }
	return true
		}) { return fail("ClauseGap::Condition") }
		out^ = tmp
	case "unparsed_quantity":
		tmp: ClauseGap_Quantity
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ClauseGap_Quantity) -> bool {
	if fv, found := get_any(v, "operand"); found { if !decode_string(fv, &out.operand) do return fail("ClauseGap::Quantity.operand") } else { return fail("ClauseGap::Quantity.operand missing") }
	return true
		}) { return fail("ClauseGap::Quantity") }
		out^ = tmp
	case "unparsed_verb_arguments":
		tmp: ClauseGap_VerbArguments
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ClauseGap_VerbArguments) -> bool {
	if fv, found := get_any(v, "verb"); found { if !decode_string(fv, &out.verb) do return fail("ClauseGap::VerbArguments.verb") } else { return fail("ClauseGap::VerbArguments.verb missing") }
	if fv, found := get_any(v, "arguments"); found { if !decode_string(fv, &out.arguments) do return fail("ClauseGap::VerbArguments.arguments") } else { return fail("ClauseGap::VerbArguments.arguments missing") }
	return true
		}) { return fail("ClauseGap::VerbArguments") }
		out^ = tmp
	case "unrecognized_clause_head":
		tmp: ClauseGap_UnrecognizedHead
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ClauseGap_UnrecognizedHead) -> bool {
	if fv, found := get_any(v, "head"); found { if !decode_string(fv, &out.head) do return fail("ClauseGap::UnrecognizedHead.head") } else { return fail("ClauseGap::UnrecognizedHead.head missing") }
	return true
		}) { return fail("ClauseGap::UnrecognizedHead") }
		out^ = tmp
	case: return fail("ClauseGap: unknown variant")
	}
	return true
}

encode_ClauseGap :: proc(b: ^strings.Builder, x: ClauseGap) {
	#partial switch y in x {
	case ClauseGap_Replacement: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "unparsed_replacement")
	member(b, first, "antecedent"); encode_string(b, y.antecedent)
	}; strings.write_byte(b, '}')
	case ClauseGap_Condition: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "unparsed_condition")
	member(b, first, "guard"); encode_string(b, y.guard)
	}; strings.write_byte(b, '}')
	case ClauseGap_Quantity: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "unparsed_quantity")
	member(b, first, "operand"); encode_string(b, y.operand)
	}; strings.write_byte(b, '}')
	case ClauseGap_VerbArguments: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "unparsed_verb_arguments")
	member(b, first, "verb"); encode_string(b, y.verb)
	member(b, first, "arguments"); encode_string(b, y.arguments)
	}; strings.write_byte(b, '}')
	case ClauseGap_UnrecognizedHead: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "unrecognized_clause_head")
	member(b, first, "head"); encode_string(b, y.head)
	}; strings.write_byte(b, '}')
	}
}

encode_ClauseGap_members :: proc(b: ^strings.Builder, x: ClauseGap, first: ^bool) {
	#partial switch y in x {
	case ClauseGap_Replacement: member(b, first, "kind"); json.write_string(b, "unparsed_replacement")
	member(b, first, "antecedent"); encode_string(b, y.antecedent)

	case ClauseGap_Condition: member(b, first, "kind"); json.write_string(b, "unparsed_condition")
	member(b, first, "guard"); encode_string(b, y.guard)

	case ClauseGap_Quantity: member(b, first, "kind"); json.write_string(b, "unparsed_quantity")
	member(b, first, "operand"); encode_string(b, y.operand)

	case ClauseGap_VerbArguments: member(b, first, "kind"); json.write_string(b, "unparsed_verb_arguments")
	member(b, first, "verb"); encode_string(b, y.verb)
	member(b, first, "arguments"); encode_string(b, y.arguments)

	case ClauseGap_UnrecognizedHead: member(b, first, "kind"); json.write_string(b, "unrecognized_clause_head")
	member(b, first, "head"); encode_string(b, y.head)

	}
}

decode_CascadeSlot :: proc(v: json.Value, out: ^CascadeSlot) -> bool {
