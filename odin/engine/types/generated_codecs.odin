	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("ManaProduction::DistinctColorsAmongPermanents.filter") } else { return fail("ManaProduction::DistinctColorsAmongPermanents.filter missing") }
	return true
		}) { return fail("ManaProduction::DistinctColorsAmongPermanents") }
		out^ = tmp
	case "AnyOneColorAmongPermanents": when COVERAGE do cov_hit("ManaProduction::AnyOneColorAmongPermanents");
		tmp: ManaProduction_AnyOneColorAmongPermanents
