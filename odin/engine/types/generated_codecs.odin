		tmp: AttachmentReferent_Host
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AttachmentReferent_Host) -> bool {
	if fv, found := get_any(v, "filter"); found { if !dec_ptr_TargetFilter(fv, &out.filter) do return fail("AttachmentReferent::Host.filter") } else { return fail("AttachmentReferent::Host.filter missing") }
