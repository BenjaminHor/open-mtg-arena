	if fv, found := get_any(v, "completion"); found { if !decode_PendingDiscardBatchCompletion(fv, &out.completion) do return fail("PendingDiscardBatch.completion") } else { out.completion = PendingDiscardBatchCompletion(PendingDiscardBatchCompletion_Standard{}) }
