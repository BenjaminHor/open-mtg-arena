decode_TypeFilter :: proc(v: json.Value, out: ^TypeFilter) -> bool {
	when COVERAGE do cov_hit("TypeFilter")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("TypeFilter: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("TypeFilter: not a string or object")
	}
	switch variant {
	case "Creature": when COVERAGE do cov_hit("TypeFilter::Creature"); out^ = TypeFilter_Creature{}
	case "Land": when COVERAGE do cov_hit("TypeFilter::Land"); out^ = TypeFilter_Land{}
	case "Artifact": when COVERAGE do cov_hit("TypeFilter::Artifact"); out^ = TypeFilter_Artifact{}
	case "Enchantment": when COVERAGE do cov_hit("TypeFilter::Enchantment"); out^ = TypeFilter_Enchantment{}
	case "Instant": when COVERAGE do cov_hit("TypeFilter::Instant"); out^ = TypeFilter_Instant{}
	case "Sorcery": when COVERAGE do cov_hit("TypeFilter::Sorcery"); out^ = TypeFilter_Sorcery{}
	case "Planeswalker": when COVERAGE do cov_hit("TypeFilter::Planeswalker"); out^ = TypeFilter_Planeswalker{}
	case "Battle": when COVERAGE do cov_hit("TypeFilter::Battle"); out^ = TypeFilter_Battle{}
	case "Kindred": when COVERAGE do cov_hit("TypeFilter::Kindred"); out^ = TypeFilter_Kindred{}
	case "Permanent": when COVERAGE do cov_hit("TypeFilter::Permanent"); out^ = TypeFilter_Permanent{}
	case "Card": when COVERAGE do cov_hit("TypeFilter::Card"); out^ = TypeFilter_Card{}
	case "Any": when COVERAGE do cov_hit("TypeFilter::Any"); out^ = TypeFilter_Any{}
	case "Non": when COVERAGE do cov_hit("TypeFilter::Non"); tmp: TypeFilter_Non; if !dec_ptr_TypeFilter(body, &tmp._0) do return fail("TypeFilter::Non"); out^ = tmp
	case "Subtype": when COVERAGE do cov_hit("TypeFilter::Subtype"); tmp: TypeFilter_Subtype; if !decode_string(body, &tmp._0) do return fail("TypeFilter::Subtype"); out^ = tmp
	case "AnyOf": when COVERAGE do cov_hit("TypeFilter::AnyOf"); tmp: TypeFilter_AnyOf; if !dec_dyn_TypeFilter(body, &tmp._0) do return fail("TypeFilter::AnyOf"); out^ = tmp
	case: return fail("TypeFilter: unknown variant")
	}
	return true
}

encode_TypeFilter :: proc(b: ^strings.Builder, x: TypeFilter) {
	#partial switch y in x {
	case TypeFilter_Creature: _ = y; json.write_string(b, "Creature")
	case TypeFilter_Land: _ = y; json.write_string(b, "Land")
	case TypeFilter_Artifact: _ = y; json.write_string(b, "Artifact")
	case TypeFilter_Enchantment: _ = y; json.write_string(b, "Enchantment")
	case TypeFilter_Instant: _ = y; json.write_string(b, "Instant")
	case TypeFilter_Sorcery: _ = y; json.write_string(b, "Sorcery")
	case TypeFilter_Planeswalker: _ = y; json.write_string(b, "Planeswalker")
	case TypeFilter_Battle: _ = y; json.write_string(b, "Battle")
	case TypeFilter_Kindred: _ = y; json.write_string(b, "Kindred")
	case TypeFilter_Permanent: _ = y; json.write_string(b, "Permanent")
	case TypeFilter_Card: _ = y; json.write_string(b, "Card")
	case TypeFilter_Any: _ = y; json.write_string(b, "Any")
	case TypeFilter_Non: strings.write_byte(b, '{'); json.write_string(b, "Non"); strings.write_byte(b, ':'); enc_ptr_TypeFilter(b, y._0); strings.write_byte(b, '}')
	case TypeFilter_Subtype: strings.write_byte(b, '{'); json.write_string(b, "Subtype"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	case TypeFilter_AnyOf: strings.write_byte(b, '{'); json.write_string(b, "AnyOf"); strings.write_byte(b, ':'); enc_dyn_TypeFilter(b, y._0); strings.write_byte(b, '}')
	}
}

