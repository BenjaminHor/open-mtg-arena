	strings.write_byte(b, '{')
	first := true
	for k, val in x {
		if !first do strings.write_byte(b, ',')
		first = false
		strings.write_byte(b, '"'); encode_int(b, k); strings.write_byte(b, '"')
		strings.write_byte(b, ':')
		enc_shared_TriggerSourceContext(b, val)
	}
	strings.write_byte(b, '}')
}

