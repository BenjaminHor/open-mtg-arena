decode_EffectOutcomeSignal :: proc(v: json.Value, out: ^EffectOutcomeSignal) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("EffectOutcomeSignal: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("EffectOutcomeSignal: not a string or object")
	}
	switch variant {
	case "OptionalEffectPerformed": out^ = EffectOutcomeSignal_OptionalEffectPerformed{}
	case "CurrentScopeSucceeded": out^ = EffectOutcomeSignal_CurrentScopeSucceeded{}
	case "Guessed":
		tmp: EffectOutcomeSignal_Guessed
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^EffectOutcomeSignal_Guessed) -> bool {
	if fv, found := get_any(v, "outcome"); found { if !decode_GuessOutcome(fv, &out.outcome) do return fail("EffectOutcomeSignal::Guessed.outcome") } else { return fail("EffectOutcomeSignal::Guessed.outcome missing") }
	return true
		}) { return fail("EffectOutcomeSignal::Guessed") }
		out^ = tmp
	case "RevealUntilMatched": out^ = EffectOutcomeSignal_RevealUntilMatched{}
	case "RepeatDirectiveReached": out^ = EffectOutcomeSignal_RepeatDirectiveReached{}
	case: return fail("EffectOutcomeSignal: unknown variant")
	}
	return true
}

encode_EffectOutcomeSignal :: proc(b: ^strings.Builder, x: EffectOutcomeSignal) {
	#partial switch y in x {
	case EffectOutcomeSignal_OptionalEffectPerformed: _ = y; json.write_string(b, "OptionalEffectPerformed")
	case EffectOutcomeSignal_CurrentScopeSucceeded: _ = y; json.write_string(b, "CurrentScopeSucceeded")
	case EffectOutcomeSignal_Guessed: strings.write_byte(b, '{'); json.write_string(b, "Guessed"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "outcome"); encode_GuessOutcome(b, y.outcome)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case EffectOutcomeSignal_RevealUntilMatched: _ = y; json.write_string(b, "RevealUntilMatched")
	case EffectOutcomeSignal_RepeatDirectiveReached: _ = y; json.write_string(b, "RepeatDirectiveReached")
	}
}

