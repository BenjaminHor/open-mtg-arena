decode_CastingVariant :: proc(v: json.Value, out: ^CastingVariant) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("CastingVariant: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("CastingVariant: not a string or object")
	}
	switch variant {
	case "Normal": out^ = CastingVariant_Normal{}
	case "Adventure": out^ = CastingVariant_Adventure{}
	case "Omen": out^ = CastingVariant_Omen{}
	case "Warp": out^ = CastingVariant_Warp{}
	case "Escape": out^ = CastingVariant_Escape{}
	case "Retrace": out^ = CastingVariant_Retrace{}
	case "Harmonize": out^ = CastingVariant_Harmonize{}
	case "Mayhem": out^ = CastingVariant_Mayhem{}
	case "Flashback": out^ = CastingVariant_Flashback{}
	case "Aftermath": out^ = CastingVariant_Aftermath{}
	case "Disturb": out^ = CastingVariant_Disturb{}
	case "GraveyardPermission":
		tmp: CastingVariant_GraveyardPermission
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^CastingVariant_GraveyardPermission) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("CastingVariant::GraveyardPermission.source") } else { return fail("CastingVariant::GraveyardPermission.source missing") }
	if fv, found := get_any(v, "frequency"); found { if !decode_CastFrequency(fv, &out.frequency) do return fail("CastingVariant::GraveyardPermission.frequency") } else { return fail("CastingVariant::GraveyardPermission.frequency missing") }
	if fv, found := get_any(v, "slot_type"); found { if !dec_opt_CoreType(fv, &out.slot_type) do return fail("CastingVariant::GraveyardPermission.slot_type") }
	if fv, found := get_any(v, "graveyard_destination_replacement"); found { if !dec_opt_Zone(fv, &out.graveyard_destination_replacement) do return fail("CastingVariant::GraveyardPermission.graveyard_destination_replacement") }
	return true
		}) { return fail("CastingVariant::GraveyardPermission") }
		out^ = tmp
	case "HandPermission":
		tmp: CastingVariant_HandPermission
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^CastingVariant_HandPermission) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("CastingVariant::HandPermission.source") } else { return fail("CastingVariant::HandPermission.source missing") }
	if fv, found := get_any(v, "frequency"); found { if !decode_CastFrequency(fv, &out.frequency) do return fail("CastingVariant::HandPermission.frequency") } else { return fail("CastingVariant::HandPermission.frequency missing") }
	return true
		}) { return fail("CastingVariant::HandPermission") }
		out^ = tmp
	case "ExilePermission":
		tmp: CastingVariant_ExilePermission
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^CastingVariant_ExilePermission) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("CastingVariant::ExilePermission.source") } else { return fail("CastingVariant::ExilePermission.source missing") }
	if fv, found := get_any(v, "frequency"); found { if !decode_CastFrequency(fv, &out.frequency) do return fail("CastingVariant::ExilePermission.frequency") } else { return fail("CastingVariant::ExilePermission.frequency missing") }
	return true
		}) { return fail("CastingVariant::ExilePermission") }
		out^ = tmp
	case "Sneak":
		tmp: CastingVariant_Sneak
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^CastingVariant_Sneak) -> bool {
	if fv, found := get_any(v, "returned_creature"); found { if !decode_ObjectId(fv, &out.returned_creature) do return fail("CastingVariant::Sneak.returned_creature") } else { return fail("CastingVariant::Sneak.returned_creature missing") }
	if fv, found := get_any(v, "placement"); found { if !dec_opt_SneakPlacement(fv, &out.placement) do return fail("CastingVariant::Sneak.placement") }
	return true
		}) { return fail("CastingVariant::Sneak") }
		out^ = tmp
	case "WebSlinging":
		tmp: CastingVariant_WebSlinging
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^CastingVariant_WebSlinging) -> bool {
	if fv, found := get_any(v, "returned_creature"); found { if !decode_ObjectId(fv, &out.returned_creature) do return fail("CastingVariant::WebSlinging.returned_creature") } else { return fail("CastingVariant::WebSlinging.returned_creature missing") }
	return true
		}) { return fail("CastingVariant::WebSlinging") }
		out^ = tmp
	case "Miracle": out^ = CastingVariant_Miracle{}
	case "Madness": out^ = CastingVariant_Madness{}
	case "Evoke": out^ = CastingVariant_Evoke{}
	case "Emerge": out^ = CastingVariant_Emerge{}
	case "Dash": out^ = CastingVariant_Dash{}
	case "Blitz": out^ = CastingVariant_Blitz{}
	case "Spectacle": out^ = CastingVariant_Spectacle{}
	case "Suspend": out^ = CastingVariant_Suspend{}
	case "Plot": out^ = CastingVariant_Plot{}
	case "Foretell": out^ = CastingVariant_Foretell{}
	case "Overload": out^ = CastingVariant_Overload{}
	case "Bestow": out^ = CastingVariant_Bestow{}
	case "Awaken": out^ = CastingVariant_Awaken{}
	case "Cleave": out^ = CastingVariant_Cleave{}
	case "MoreThanMeetsTheEye": out^ = CastingVariant_MoreThanMeetsTheEye{}
	case "Impending": out^ = CastingVariant_Impending{}
	case "Prototype": out^ = CastingVariant_Prototype{}
	case "Mutate": out^ = CastingVariant_Mutate{}
	case "Freerunning": out^ = CastingVariant_Freerunning{}
	case "Prowl": out^ = CastingVariant_Prowl{}
	case "JumpStart": out^ = CastingVariant_JumpStart{}
	case "Fuse": out^ = CastingVariant_Fuse{}
	case "Surge": out^ = CastingVariant_Surge{}
	case "FaceDown": out^ = CastingVariant_FaceDown{}
	case: return fail("CastingVariant: unknown variant")
	}
	return true
}

encode_CastingVariant :: proc(b: ^strings.Builder, x: CastingVariant) {
	#partial switch y in x {
	case CastingVariant_Normal: _ = y; json.write_string(b, "Normal")
	case CastingVariant_Adventure: _ = y; json.write_string(b, "Adventure")
	case CastingVariant_Omen: _ = y; json.write_string(b, "Omen")
	case CastingVariant_Warp: _ = y; json.write_string(b, "Warp")
	case CastingVariant_Escape: _ = y; json.write_string(b, "Escape")
	case CastingVariant_Retrace: _ = y; json.write_string(b, "Retrace")
	case CastingVariant_Harmonize: _ = y; json.write_string(b, "Harmonize")
	case CastingVariant_Mayhem: _ = y; json.write_string(b, "Mayhem")
	case CastingVariant_Flashback: _ = y; json.write_string(b, "Flashback")
	case CastingVariant_Aftermath: _ = y; json.write_string(b, "Aftermath")
	case CastingVariant_Disturb: _ = y; json.write_string(b, "Disturb")
	case CastingVariant_GraveyardPermission: strings.write_byte(b, '{'); json.write_string(b, "GraveyardPermission"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "frequency"); encode_CastFrequency(b, y.frequency)
	member(b, first, "slot_type"); enc_opt_CoreType(b, y.slot_type)
	if !(y.graveyard_destination_replacement == nil) { member(b, first, "graveyard_destination_replacement"); enc_opt_Zone(b, y.graveyard_destination_replacement) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case CastingVariant_HandPermission: strings.write_byte(b, '{'); json.write_string(b, "HandPermission"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "frequency"); encode_CastFrequency(b, y.frequency)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case CastingVariant_ExilePermission: strings.write_byte(b, '{'); json.write_string(b, "ExilePermission"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "frequency"); encode_CastFrequency(b, y.frequency)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case CastingVariant_Sneak: strings.write_byte(b, '{'); json.write_string(b, "Sneak"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "returned_creature"); encode_ObjectId(b, y.returned_creature)
	member(b, first, "placement"); enc_opt_SneakPlacement(b, y.placement)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case CastingVariant_WebSlinging: strings.write_byte(b, '{'); json.write_string(b, "WebSlinging"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "returned_creature"); encode_ObjectId(b, y.returned_creature)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case CastingVariant_Miracle: _ = y; json.write_string(b, "Miracle")
	case CastingVariant_Madness: _ = y; json.write_string(b, "Madness")
	case CastingVariant_Evoke: _ = y; json.write_string(b, "Evoke")
	case CastingVariant_Emerge: _ = y; json.write_string(b, "Emerge")
	case CastingVariant_Dash: _ = y; json.write_string(b, "Dash")
	case CastingVariant_Blitz: _ = y; json.write_string(b, "Blitz")
	case CastingVariant_Spectacle: _ = y; json.write_string(b, "Spectacle")
	case CastingVariant_Suspend: _ = y; json.write_string(b, "Suspend")
	case CastingVariant_Plot: _ = y; json.write_string(b, "Plot")
	case CastingVariant_Foretell: _ = y; json.write_string(b, "Foretell")
	case CastingVariant_Overload: _ = y; json.write_string(b, "Overload")
	case CastingVariant_Bestow: _ = y; json.write_string(b, "Bestow")
	case CastingVariant_Awaken: _ = y; json.write_string(b, "Awaken")
	case CastingVariant_Cleave: _ = y; json.write_string(b, "Cleave")
	case CastingVariant_MoreThanMeetsTheEye: _ = y; json.write_string(b, "MoreThanMeetsTheEye")
	case CastingVariant_Impending: _ = y; json.write_string(b, "Impending")
	case CastingVariant_Prototype: _ = y; json.write_string(b, "Prototype")
	case CastingVariant_Mutate: _ = y; json.write_string(b, "Mutate")
	case CastingVariant_Freerunning: _ = y; json.write_string(b, "Freerunning")
	case CastingVariant_Prowl: _ = y; json.write_string(b, "Prowl")
	case CastingVariant_JumpStart: _ = y; json.write_string(b, "JumpStart")
	case CastingVariant_Fuse: _ = y; json.write_string(b, "Fuse")
	case CastingVariant_Surge: _ = y; json.write_string(b, "Surge")
	case CastingVariant_FaceDown: _ = y; json.write_string(b, "FaceDown")
	}
}

