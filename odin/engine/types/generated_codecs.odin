	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "sprocket"); encode_u8(b, y.sprocket)
	member(b, first, "remaining_after"); encode_u32(b, y.remaining_after)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case BatchCompletion_LibrarySearchDeliverySettled: strings.write_byte(b, '{'); json.write_string(b, "LibrarySearchDeliverySettled"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "resume"); encode_LibrarySearchDeliveryResume(b, y.resume)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case BatchCompletion_SearchPartitionPrimaryDelivered: strings.write_byte(b, '{'); json.write_string(b, "SearchPartitionPrimaryDelivered"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "rest_ids"); enc_dyn_ObjectId(b, y.rest_ids)
	member(b, first, "rest_destination"); encode_Zone(b, y.rest_destination)
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "resume"); encode_LibrarySearchDeliveryResume(b, y.resume)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case BatchCompletion_SearchFoundZoneDelivery: strings.write_byte(b, '{'); json.write_string(b, "SearchFoundZoneDelivery"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
