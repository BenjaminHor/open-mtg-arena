		.InstructionCount = "InstructionCount",
		.IndividualDraw = "IndividualDraw",
	}
	json.write_string(b, NAMES[x])
}

decode_DieRollIgnoreRule :: proc(v: json.Value, out: ^DieRollIgnoreRule) -> bool {
	if v.kind != .Object do return fail("DieRollIgnoreRule: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("DieRollIgnoreRule: no tag")
	str := tv.text
	switch str {
	case "Lowest": out^ = .Lowest
	case: return fail("DieRollIgnoreRule: unknown variant")
	}
	return true
}

encode_DieRollIgnoreRule :: proc(b: ^strings.Builder, x: DieRollIgnoreRule) {
	strings.write_byte(b, '{')
	f := true
	encode_DieRollIgnoreRule_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_DieRollIgnoreRule_members :: proc(b: ^strings.Builder, x: DieRollIgnoreRule, first: ^bool) {
	_ = x
	@(static, rodata) NAMES := [DieRollIgnoreRule]string{
		.Lowest = "Lowest",
	}
	member(b, first, "type"); json.write_string(b, NAMES[x])
}

decode_PlaneswalkReplacementScope :: proc(v: json.Value, out: ^PlaneswalkReplacementScope) -> bool {
	if v.kind != .String do return fail("PlaneswalkReplacementScope: not a string")
	str := v.text
	switch str {
