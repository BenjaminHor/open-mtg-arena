	case TriggerMode_BecomesPlotted: _ = y; json.write_string(b, "BecomesPlotted")
	case TriggerMode_BecomesSaddled: _ = y; json.write_string(b, "BecomesSaddled")
	case TriggerMode_Immediate: _ = y; json.write_string(b, "Immediate")
	case TriggerMode_Always: _ = y; json.write_string(b, "Always")
	case TriggerMode_EntersOrAttacks: _ = y; json.write_string(b, "EntersOrAttacks")
	case TriggerMode_AttacksOrBlocks: _ = y; json.write_string(b, "AttacksOrBlocks")
	case TriggerMode_BlocksOrBecomesBlocked: _ = y; json.write_string(b, "BlocksOrBecomesBlocked")
	case TriggerMode_EntersOrHauntedCreatureDies: _ = y; json.write_string(b, "EntersOrHauntedCreatureDies")
	case TriggerMode_StateCondition: _ = y; json.write_string(b, "StateCondition")
	case TriggerMode_Airbend: _ = y; json.write_string(b, "Airbend")
	case TriggerMode_Earthbend: _ = y; json.write_string(b, "Earthbend")
	case TriggerMode_Firebend: _ = y; json.write_string(b, "Firebend")
	case TriggerMode_Waterbend: _ = y; json.write_string(b, "Waterbend")
	case TriggerMode_ElementalBend: _ = y; json.write_string(b, "ElementalBend")
	case TriggerMode_HauntedCreatureDies: _ = y; json.write_string(b, "HauntedCreatureDies")
	case TriggerMode_FinalSagaChapterAbility: strings.write_byte(b, '{'); json.write_string(b, "FinalSagaChapterAbility"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "lifecycle"); encode_AbilityLifecyclePoint(b, y.lifecycle)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerMode_Unknown: strings.write_byte(b, '{'); json.write_string(b, "Unknown"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	}
}

decode_ZoneChangeClause :: proc(v: json.Value, out: ^ZoneChangeClause) -> bool {
	if v.kind != .Object do return fail("ZoneChangeClause: not an object")
	if fv, found := get_any(v, "origin"); found { if !decode_OriginConstraint(fv, &out.origin) do return fail("ZoneChangeClause.origin") } else { return fail("ZoneChangeClause.origin missing") }
	if fv, found := get_any(v, "destination"); found { if !dec_opt_Zone(fv, &out.destination) do return fail("ZoneChangeClause.destination") }
	if fv, found := get_any(v, "destination_constraint"); found { if !decode_OriginConstraint(fv, &out.destination_constraint) do return fail("ZoneChangeClause.destination_constraint") } else { out.destination_constraint = default_ZoneChangeClause_OriginConstraint_any_default() }
	if fv, found := get_any(v, "valid_card"); found { if !dec_opt_TargetFilter(fv, &out.valid_card) do return fail("ZoneChangeClause.valid_card") }
	return true
}

encode_ZoneChangeClause :: proc(b: ^strings.Builder, x: ZoneChangeClause) {
	strings.write_byte(b, '{')
	f := true
	encode_ZoneChangeClause_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ZoneChangeClause_members :: proc(b: ^strings.Builder, x: ZoneChangeClause, first: ^bool) {
	member(b, first, "origin"); encode_OriginConstraint(b, x.origin)
	if !(x.destination == nil) { member(b, first, "destination"); enc_opt_Zone(b, x.destination) }
	if !(skip_ZoneChangeClause_OriginConstraint_is_any(x.destination_constraint)) { member(b, first, "destination_constraint"); encode_OriginConstraint(b, x.destination_constraint) }
	if !(x.valid_card == nil) { member(b, first, "valid_card"); enc_opt_TargetFilter(b, x.valid_card) }
}

decode_OriginConstraint :: proc(v: json.Value, out: ^OriginConstraint) -> bool {
	if v.kind != .Object do return fail("OriginConstraint: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("OriginConstraint: no tag")
	switch tv.text {
	case "Any": out^ = OriginConstraint_Any{}
	case "Equals": tmp: OriginConstraint_Equals; if !decode_Zone(json.get_or_null(v, "data"), &tmp._0) do return fail("OriginConstraint::Equals"); out^ = tmp
	case "NotEquals": tmp: OriginConstraint_NotEquals; if !decode_Zone(json.get_or_null(v, "data"), &tmp._0) do return fail("OriginConstraint::NotEquals"); out^ = tmp
	case "OneOf": tmp: OriginConstraint_OneOf; if !dec_dyn_Zone(json.get_or_null(v, "data"), &tmp._0) do return fail("OriginConstraint::OneOf"); out^ = tmp
	case: return fail("OriginConstraint: unknown variant")
	}
	return true
}

encode_OriginConstraint :: proc(b: ^strings.Builder, x: OriginConstraint) {
	#partial switch y in x {
	case OriginConstraint_Any: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Any"); strings.write_byte(b, '}')
	case OriginConstraint_Equals: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Equals"); member(b, &f, "data"); encode_Zone(b, y._0); strings.write_byte(b, '}')
	case OriginConstraint_NotEquals: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NotEquals"); member(b, &f, "data"); encode_Zone(b, y._0); strings.write_byte(b, '}')
	case OriginConstraint_OneOf: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OneOf"); member(b, &f, "data"); enc_dyn_Zone(b, y._0); strings.write_byte(b, '}')
	}
}

decode_Phase :: proc(v: json.Value, out: ^Phase) -> bool {
	if v.kind != .String do return fail("Phase: not a string")
	str := v.text
	switch str {
	case "Untap": out^ = .Untap
	case "Upkeep": out^ = .Upkeep
	case "Draw": out^ = .Draw
	case "PreCombatMain": out^ = .PreCombatMain
	case "BeginCombat": out^ = .BeginCombat
	case "DeclareAttackers": out^ = .DeclareAttackers
	case "DeclareBlockers": out^ = .DeclareBlockers
	case "CombatDamage": out^ = .CombatDamage
	case "EndCombat": out^ = .EndCombat
	case "PostCombatMain": out^ = .PostCombatMain
	case "End": out^ = .End
	case "Cleanup": out^ = .Cleanup
	case: return fail("Phase: unknown variant")
	}
	return true
}

encode_Phase :: proc(b: ^strings.Builder, x: Phase) {
	@(static, rodata) NAMES := [Phase]string{
		.Untap = "Untap",
		.Upkeep = "Upkeep",
		.Draw = "Draw",
		.PreCombatMain = "PreCombatMain",
		.BeginCombat = "BeginCombat",
		.DeclareAttackers = "DeclareAttackers",
		.DeclareBlockers = "DeclareBlockers",
		.CombatDamage = "CombatDamage",
		.EndCombat = "EndCombat",
		.PostCombatMain = "PostCombatMain",
		.End = "End",
		.Cleanup = "Cleanup",
	}
	json.write_string(b, NAMES[x])
}

decode_DamageKindFilter :: proc(v: json.Value, out: ^DamageKindFilter) -> bool {
	if v.kind != .String do return fail("DamageKindFilter: not a string")
	str := v.text
	switch str {
	case "Any": out^ = .Any
	case "CombatOnly": out^ = .CombatOnly
	case "NoncombatOnly": out^ = .NoncombatOnly
	case: return fail("DamageKindFilter: unknown variant")
	}
	return true
}

encode_DamageKindFilter :: proc(b: ^strings.Builder, x: DamageKindFilter) {
	@(static, rodata) NAMES := [DamageKindFilter]string{
		.Any = "Any",
		.CombatOnly = "CombatOnly",
		.NoncombatOnly = "NoncombatOnly",
	}
	json.write_string(b, NAMES[x])
}

decode_TriggerConstraint :: proc(v: json.Value, out: ^TriggerConstraint) -> bool {
	if v.kind != .Object do return fail("TriggerConstraint: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("TriggerConstraint: no tag")
	switch tv.text {
	case "OncePerTurn":
		tmp: TriggerConstraint_OncePerTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerConstraint_OncePerTurn) -> bool {
	if fv, found := get_any(v, "spent_by"); found { if !decode_TriggerLimitSpend(fv, &out.spent_by) do return fail("TriggerConstraint::OncePerTurn.spent_by") }
	return true
		}) { return fail("TriggerConstraint::OncePerTurn") }
		out^ = tmp
	case "OncePerGame": out^ = TriggerConstraint_OncePerGame{}
	case "OnlyDuringYourTurn": out^ = TriggerConstraint_OnlyDuringYourTurn{}
	case "NthSpellThisTurn":
		tmp: TriggerConstraint_NthSpellThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerConstraint_NthSpellThisTurn) -> bool {
	if fv, found := get_any(v, "n"); found { if !decode_u32(fv, &out.n) do return fail("TriggerConstraint::NthSpellThisTurn.n") } else { return fail("TriggerConstraint::NthSpellThisTurn.n missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("TriggerConstraint::NthSpellThisTurn.comparator") } else { out.comparator = default_TriggerConstraint_default_exact_ordinal_comparator() }
	if fv, found := get_any(v, "filter"); found { if !dec_opt_TargetFilter(fv, &out.filter) do return fail("TriggerConstraint::NthSpellThisTurn.filter") }
	return true
		}) { return fail("TriggerConstraint::NthSpellThisTurn") }
		out^ = tmp
	case "NthDrawThisTurn":
		tmp: TriggerConstraint_NthDrawThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerConstraint_NthDrawThisTurn) -> bool {
	if fv, found := get_any(v, "n"); found { if !decode_u32(fv, &out.n) do return fail("TriggerConstraint::NthDrawThisTurn.n") } else { return fail("TriggerConstraint::NthDrawThisTurn.n missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("TriggerConstraint::NthDrawThisTurn.comparator") } else { out.comparator = default_TriggerConstraint_default_exact_ordinal_comparator() }
	return true
		}) { return fail("TriggerConstraint::NthDrawThisTurn") }
		out^ = tmp
	case "OnlyDuringOpponentsTurn": out^ = TriggerConstraint_OnlyDuringOpponentsTurn{}
	case "OnlyDuringYourMainPhase": out^ = TriggerConstraint_OnlyDuringYourMainPhase{}
	case "AtClassLevel":
		tmp: TriggerConstraint_AtClassLevel
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerConstraint_AtClassLevel) -> bool {
	if fv, found := get_any(v, "level"); found { if !decode_u8(fv, &out.level) do return fail("TriggerConstraint::AtClassLevel.level") } else { return fail("TriggerConstraint::AtClassLevel.level missing") }
	return true
		}) { return fail("TriggerConstraint::AtClassLevel") }
		out^ = tmp
	case "MaxTimesPerTurn":
		tmp: TriggerConstraint_MaxTimesPerTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerConstraint_MaxTimesPerTurn) -> bool {
	if fv, found := get_any(v, "max"); found { if !decode_u32(fv, &out.max) do return fail("TriggerConstraint::MaxTimesPerTurn.max") } else { return fail("TriggerConstraint::MaxTimesPerTurn.max missing") }
	return true
		}) { return fail("TriggerConstraint::MaxTimesPerTurn") }
		out^ = tmp
	case "OncePerOpponentPerTurn": out^ = TriggerConstraint_OncePerOpponentPerTurn{}
	case "EventSourceControlledBy":
		tmp: TriggerConstraint_EventSourceControlledBy
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerConstraint_EventSourceControlledBy) -> bool {
	if fv, found := get_any(v, "controller"); found { if !decode_ControllerRef(fv, &out.controller) do return fail("TriggerConstraint::EventSourceControlledBy.controller") } else { return fail("TriggerConstraint::EventSourceControlledBy.controller missing") }
	return true
		}) { return fail("TriggerConstraint::EventSourceControlledBy") }
		out^ = tmp
	case: return fail("TriggerConstraint: unknown variant")
	}
	return true
}

encode_TriggerConstraint :: proc(b: ^strings.Builder, x: TriggerConstraint) {
	#partial switch y in x {
	case TriggerConstraint_OncePerTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "OncePerTurn")
	if !(skip_TriggerConstraint_TriggerLimitSpend_is_triggering(y.spent_by)) { member(b, first, "spent_by"); encode_TriggerLimitSpend(b, y.spent_by) }
	}; strings.write_byte(b, '}')
	case TriggerConstraint_OncePerGame: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OncePerGame"); strings.write_byte(b, '}')
	case TriggerConstraint_OnlyDuringYourTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OnlyDuringYourTurn"); strings.write_byte(b, '}')
	case TriggerConstraint_NthSpellThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "NthSpellThisTurn")
	member(b, first, "n"); encode_u32(b, y.n)
	if !(skip_TriggerConstraint_is_default_exact_ordinal_comparator(y.comparator)) { member(b, first, "comparator"); encode_Comparator(b, y.comparator) }
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }
	}; strings.write_byte(b, '}')
	case TriggerConstraint_NthDrawThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "NthDrawThisTurn")
	member(b, first, "n"); encode_u32(b, y.n)
	if !(skip_TriggerConstraint_is_default_exact_ordinal_comparator(y.comparator)) { member(b, first, "comparator"); encode_Comparator(b, y.comparator) }
	}; strings.write_byte(b, '}')
	case TriggerConstraint_OnlyDuringOpponentsTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OnlyDuringOpponentsTurn"); strings.write_byte(b, '}')
	case TriggerConstraint_OnlyDuringYourMainPhase: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OnlyDuringYourMainPhase"); strings.write_byte(b, '}')
	case TriggerConstraint_AtClassLevel: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AtClassLevel")
	member(b, first, "level"); encode_u8(b, y.level)
	}; strings.write_byte(b, '}')
	case TriggerConstraint_MaxTimesPerTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "MaxTimesPerTurn")
	member(b, first, "max"); encode_u32(b, y.max)
	}; strings.write_byte(b, '}')
	case TriggerConstraint_OncePerOpponentPerTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OncePerOpponentPerTurn"); strings.write_byte(b, '}')
	case TriggerConstraint_EventSourceControlledBy: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "EventSourceControlledBy")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)
	}; strings.write_byte(b, '}')
	}
}

encode_TriggerConstraint_members :: proc(b: ^strings.Builder, x: TriggerConstraint, first: ^bool) {
	#partial switch y in x {
	case TriggerConstraint_OncePerTurn: member(b, first, "type"); json.write_string(b, "OncePerTurn")
	if !(skip_TriggerConstraint_TriggerLimitSpend_is_triggering(y.spent_by)) { member(b, first, "spent_by"); encode_TriggerLimitSpend(b, y.spent_by) }

	case TriggerConstraint_OncePerGame: _ = y; member(b, first, "type"); json.write_string(b, "OncePerGame")
	case TriggerConstraint_OnlyDuringYourTurn: _ = y; member(b, first, "type"); json.write_string(b, "OnlyDuringYourTurn")
	case TriggerConstraint_NthSpellThisTurn: member(b, first, "type"); json.write_string(b, "NthSpellThisTurn")
	member(b, first, "n"); encode_u32(b, y.n)
	if !(skip_TriggerConstraint_is_default_exact_ordinal_comparator(y.comparator)) { member(b, first, "comparator"); encode_Comparator(b, y.comparator) }
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }

	case TriggerConstraint_NthDrawThisTurn: member(b, first, "type"); json.write_string(b, "NthDrawThisTurn")
	member(b, first, "n"); encode_u32(b, y.n)
	if !(skip_TriggerConstraint_is_default_exact_ordinal_comparator(y.comparator)) { member(b, first, "comparator"); encode_Comparator(b, y.comparator) }

	case TriggerConstraint_OnlyDuringOpponentsTurn: _ = y; member(b, first, "type"); json.write_string(b, "OnlyDuringOpponentsTurn")
	case TriggerConstraint_OnlyDuringYourMainPhase: _ = y; member(b, first, "type"); json.write_string(b, "OnlyDuringYourMainPhase")
	case TriggerConstraint_AtClassLevel: member(b, first, "type"); json.write_string(b, "AtClassLevel")
	member(b, first, "level"); encode_u8(b, y.level)

	case TriggerConstraint_MaxTimesPerTurn: member(b, first, "type"); json.write_string(b, "MaxTimesPerTurn")
	member(b, first, "max"); encode_u32(b, y.max)

	case TriggerConstraint_OncePerOpponentPerTurn: _ = y; member(b, first, "type"); json.write_string(b, "OncePerOpponentPerTurn")
	case TriggerConstraint_EventSourceControlledBy: member(b, first, "type"); json.write_string(b, "EventSourceControlledBy")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)

	}
}

decode_TriggerCondition :: proc(v: json.Value, out: ^TriggerCondition) -> bool {
	if v.kind != .Object do return fail("TriggerCondition: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("TriggerCondition: no tag")
	switch tv.text {
	case "GainedLife":
		tmp: TriggerCondition_GainedLife
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerCondition_GainedLife) -> bool {
	if fv, found := get_any(v, "minimum"); found { if !decode_u32(fv, &out.minimum) do return fail("TriggerCondition::GainedLife.minimum") } else { return fail("TriggerCondition::GainedLife.minimum missing") }
	return true
		}) { return fail("TriggerCondition::GainedLife") }
		out^ = tmp
	case "LostLife": out^ = TriggerCondition_LostLife{}
	case "Descended": out^ = TriggerCondition_Descended{}
	case "ControlsType":
		tmp: TriggerCondition_ControlsType
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerCondition_ControlsType) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("TriggerCondition::ControlsType.filter") } else { return fail("TriggerCondition::ControlsType.filter missing") }
	return true
		}) { return fail("TriggerCondition::ControlsType") }
		out^ = tmp
	case "NoSpellsCastLastTurn": out^ = TriggerCondition_NoSpellsCastLastTurn{}
	case "TwoOrMoreSpellsCastLastTurn": out^ = TriggerCondition_TwoOrMoreSpellsCastLastTurn{}
	case "DuringPlayersTurn":
		tmp: TriggerCondition_DuringPlayersTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerCondition_DuringPlayersTurn) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerFilter(fv, &out.player) do return fail("TriggerCondition::DuringPlayersTurn.player") } else { return fail("TriggerCondition::DuringPlayersTurn.player missing") }
	return true
		}) { return fail("TriggerCondition::DuringPlayersTurn") }
		out^ = tmp
	case "SourceEnteredThisTurn": out^ = TriggerCondition_SourceEnteredThisTurn{}
	case "SourceAttackedThisCombat": out^ = TriggerCondition_SourceAttackedThisCombat{}
	case "ChoseOtherRingBearer": out^ = TriggerCondition_ChoseOtherRingBearer{}
	case "ChoseRingBearer": out^ = TriggerCondition_ChoseRingBearer{}
	case "EchoDue": out^ = TriggerCondition_EchoDue{}
	case "MinCoAttackers":
		tmp: TriggerCondition_MinCoAttackers
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerCondition_MinCoAttackers) -> bool {
	if fv, found := get_any(v, "minimum"); found { if !decode_u32(fv, &out.minimum) do return fail("TriggerCondition::MinCoAttackers.minimum") } else { return fail("TriggerCondition::MinCoAttackers.minimum missing") }
	if fv, found := get_any(v, "filter"); found { if !dec_opt_TargetFilter(fv, &out.filter) do return fail("TriggerCondition::MinCoAttackers.filter") }
	return true
		}) { return fail("TriggerCondition::MinCoAttackers") }
		out^ = tmp
	case "SolveConditionMet": out^ = TriggerCondition_SolveConditionMet{}
	case "ClassLevelGE":
		tmp: TriggerCondition_ClassLevelGE
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerCondition_ClassLevelGE) -> bool {
	if fv, found := get_any(v, "level"); found { if !decode_u8(fv, &out.level) do return fail("TriggerCondition::ClassLevelGE.level") } else { return fail("TriggerCondition::ClassLevelGE.level missing") }
	return true
		}) { return fail("TriggerCondition::ClassLevelGE") }
		out^ = tmp
	case "SourceIsHarnessed": out^ = TriggerCondition_SourceIsHarnessed{}
	case "AttractionVisitRoll":
		tmp: TriggerCondition_AttractionVisitRoll
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^TriggerCondition_AttractionVisitRoll) -> bool {
	if fv, found := get_any(v, "min"); found { if !decode_u8(fv, &out.min) do return fail("TriggerCondition::AttractionVisitRoll.min") } else { return fail("TriggerCondition::AttractionVisitRoll.min missing") }
	if fv, found := get_any(v, "max"); found { if !decode_u8(fv, &out.max) do return fail("TriggerCondition::AttractionVisitRoll.max") } else { return fail("TriggerCondition::AttractionVisitRoll.max missing") }
