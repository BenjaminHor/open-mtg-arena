	if fv, found := get_any(v, "toughness_override"); found { if !dec_opt_i32(fv, &out.toughness_override) do return fail("DebugTokenRequest::Preset.toughness_override") }
	if fv, found := get_any(v, "enter_with_counters"); found { if !dec_dyn_t2_CounterType_u32(fv, &out.enter_with_counters) do return fail("DebugTokenRequest::Preset.enter_with_counters") }
