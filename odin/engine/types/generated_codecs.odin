	case FilterProp_HasSingleTarget: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasSingleTarget"); strings.write_byte(b, '}')
	case FilterProp_Modal: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Modal"); strings.write_byte(b, '}')
	case FilterProp_PrepareSpell: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PrepareSpell"); strings.write_byte(b, '}')
	case FilterProp_NotColor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "NotColor")
