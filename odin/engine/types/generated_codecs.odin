	if fv, found := get_any(v, "chooser"); found { if !decode_PlayerId(fv, &out.chooser) do return fail("DeferredDamageChoice.chooser") } else { return fail("DeferredDamageChoice.chooser missing") }
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("DeferredDamageChoice.source") } else { return fail("DeferredDamageChoice.source missing") }
	if fv, found := get_any(v, "target"); found { if !decode_TargetRef(fv, &out.target) do return fail("DeferredDamageChoice.target") } else { return fail("DeferredDamageChoice.target missing") }
