	case "Modal": when COVERAGE do cov_hit("LayoutKind::Modal"); out^ = .Modal
	case "Omen": when COVERAGE do cov_hit("LayoutKind::Omen"); out^ = .Omen
	case "Prepare": when COVERAGE do cov_hit("LayoutKind::Prepare"); out^ = .Prepare
	case: return fail("LayoutKind: unknown variant")
	}
	return true
}

