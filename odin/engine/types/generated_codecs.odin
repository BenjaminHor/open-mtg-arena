	case BatchCompletion_CascadeExileLoopComplete: strings.write_byte(b, '{'); json.write_string(b, "CascadeExileLoopComplete"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
