decode_ManaAbilityCostCursor :: proc(v: json.Value, out: ^ManaAbilityCostCursor) -> bool {
	when COVERAGE do cov_hit("ManaAbilityCostCursor")
	if v.kind != .Object do return fail("ManaAbilityCostCursor: not an object")
	if fv, found := get_any(v, "remaining"); found { if !dec_dyn_AbilityCost(fv, &out.remaining) do return fail("ManaAbilityCostCursor.remaining") } else { return fail("ManaAbilityCostCursor.remaining missing") }
	if fv, found := get_any(v, "activation"); found { if !decode_ManaAbilityActivationStage(fv, &out.activation) do return fail("ManaAbilityCostCursor.activation") }
	if fv, found := get_any(v, "remaining_life_payments"); found { if !dec_dyn_u32(fv, &out.remaining_life_payments) do return fail("ManaAbilityCostCursor.remaining_life_payments") }
	if fv, found := get_any(v, "resolution_mode"); found { if !decode_ManaAbilityCostResolutionMode(fv, &out.resolution_mode) do return fail("ManaAbilityCostCursor.resolution_mode") }
	if fv, found := get_any(v, "excluded_sources"); found { if !dec_dyn_ObjectId(fv, &out.excluded_sources) do return fail("ManaAbilityCostCursor.excluded_sources") }
	if fv, found := get_any(v, "sub_cost_demand"); found { if !dec_opt_5_u32(fv, &out.sub_cost_demand) do return fail("ManaAbilityCostCursor.sub_cost_demand") }
	if fv, found := get_any(v, "next_tapper"); found { if !decode_int(fv, &out.next_tapper) do return fail("ManaAbilityCostCursor.next_tapper") }
	if fv, found := get_any(v, "next_discard"); found { if !decode_int(fv, &out.next_discard) do return fail("ManaAbilityCostCursor.next_discard") }
	if fv, found := get_any(v, "next_exiled"); found { if !decode_int(fv, &out.next_exiled) do return fail("ManaAbilityCostCursor.next_exiled") }
	if fv, found := get_any(v, "next_sacrificed"); found { if !decode_int(fv, &out.next_sacrificed) do return fail("ManaAbilityCostCursor.next_sacrificed") }
	if fv, found := get_any(v, "next_counter_choice"); found { if !decode_int(fv, &out.next_counter_choice) do return fail("ManaAbilityCostCursor.next_counter_choice") }
	if fv, found := get_any(v, "cost_removed_counters"); found { if !dec_opt_u32(fv, &out.cost_removed_counters) do return fail("ManaAbilityCostCursor.cost_removed_counters") }
	if fv, found := get_any(v, "counter_removal"); found { if !dec_ptr_PausedCounterCostRemoval(fv, &out.counter_removal) do return fail("ManaAbilityCostCursor.counter_removal") }
	if fv, found := get_any(v, "selected_exile_remaining"); found { if !dec_opt_dyn_ObjectId(fv, &out.selected_exile_remaining) do return fail("ManaAbilityCostCursor.selected_exile_remaining") }
	if fv, found := get_any(v, "selected_sacrifice_remaining"); found { if !dec_opt_dyn_ObjectId(fv, &out.selected_sacrifice_remaining) do return fail("ManaAbilityCostCursor.selected_sacrifice_remaining") }
	if fv, found := get_any(v, "deferred_cost_events"); found { if !dec_dyn_GameEvent(fv, &out.deferred_cost_events) do return fail("ManaAbilityCostCursor.deferred_cost_events") }
	if fv, found := get_any(v, "parent"); found { if !dec_ptr_ManaAbilityCostParent(fv, &out.parent) do return fail("ManaAbilityCostCursor.parent") }
	return true
}

encode_ManaAbilityCostCursor :: proc(b: ^strings.Builder, x: ManaAbilityCostCursor) {
	strings.write_byte(b, '{')
	f := true
	encode_ManaAbilityCostCursor_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ManaAbilityCostCursor_members :: proc(b: ^strings.Builder, x: ManaAbilityCostCursor, first: ^bool) {
	member(b, first, "remaining"); enc_dyn_AbilityCost(b, x.remaining)
	if !(skip_ManaAbilityCostCursor_ManaAbilityActivationStage_is_unpublished_ManaAbilityActivationStage(x.activation)) { member(b, first, "activation"); encode_ManaAbilityActivationStage(b, x.activation) }
	if !((len(x.remaining_life_payments) == 0)) { member(b, first, "remaining_life_payments"); enc_dyn_u32(b, x.remaining_life_payments) }
	member(b, first, "resolution_mode"); encode_ManaAbilityCostResolutionMode(b, x.resolution_mode)
	if !((len(x.excluded_sources) == 0)) { member(b, first, "excluded_sources"); enc_dyn_ObjectId(b, x.excluded_sources) }
	if !(x.sub_cost_demand == nil) { member(b, first, "sub_cost_demand"); enc_opt_5_u32(b, x.sub_cost_demand) }
	member(b, first, "next_tapper"); encode_int(b, x.next_tapper)
	member(b, first, "next_discard"); encode_int(b, x.next_discard)
	member(b, first, "next_exiled"); encode_int(b, x.next_exiled)
	member(b, first, "next_sacrificed"); encode_int(b, x.next_sacrificed)
	member(b, first, "next_counter_choice"); encode_int(b, x.next_counter_choice)
	if !(x.cost_removed_counters == nil) { member(b, first, "cost_removed_counters"); enc_opt_u32(b, x.cost_removed_counters) }
	if !(x.counter_removal == nil) { member(b, first, "counter_removal"); enc_ptr_PausedCounterCostRemoval(b, x.counter_removal) }
	if !(x.selected_exile_remaining == nil) { member(b, first, "selected_exile_remaining"); enc_opt_dyn_ObjectId(b, x.selected_exile_remaining) }
	if !(x.selected_sacrifice_remaining == nil) { member(b, first, "selected_sacrifice_remaining"); enc_opt_dyn_ObjectId(b, x.selected_sacrifice_remaining) }
	if !((len(x.deferred_cost_events) == 0)) { member(b, first, "deferred_cost_events"); enc_dyn_GameEvent(b, x.deferred_cost_events) }
	if !(x.parent == nil) { member(b, first, "parent"); enc_ptr_ManaAbilityCostParent(b, x.parent) }
}

