	if fv, found := get_any(v, "power"); found { if !dec_opt_i32(fv, &out.power) do return fail("EventObjectSnapshot.power") }
	if fv, found := get_any(v, "toughness"); found { if !dec_opt_i32(fv, &out.toughness) do return fail("EventObjectSnapshot.toughness") }
	if fv, found := get_any(v, "base_power"); found { if !dec_opt_i32(fv, &out.base_power) do return fail("EventObjectSnapshot.base_power") }
	if fv, found := get_any(v, "base_toughness"); found { if !dec_opt_i32(fv, &out.base_toughness) do return fail("EventObjectSnapshot.base_toughness") }
	if fv, found := get_any(v, "mana_value"); found { if !decode_u32(fv, &out.mana_value) do return fail("EventObjectSnapshot.mana_value") } else { return fail("EventObjectSnapshot.mana_value missing") }
	if fv, found := get_any(v, "counters"); found { if !decode_with_counter_map_serde(fv, &out.counters) do return fail("EventObjectSnapshot.counters") } else { return fail("EventObjectSnapshot.counters missing") }
	if fv, found := get_any(v, "is_token"); found { if !decode_bool(fv, &out.is_token) do return fail("EventObjectSnapshot.is_token") } else { return fail("EventObjectSnapshot.is_token missing") }
	if fv, found := get_any(v, "is_commander"); found { if !decode_bool(fv, &out.is_commander) do return fail("EventObjectSnapshot.is_commander") } else { return fail("EventObjectSnapshot.is_commander missing") }
	if fv, found := get_any(v, "tapped"); found { if !decode_bool(fv, &out.tapped) do return fail("EventObjectSnapshot.tapped") } else { return fail("EventObjectSnapshot.tapped missing") }
	if fv, found := get_any(v, "face_down"); found { if !decode_bool(fv, &out.face_down) do return fail("EventObjectSnapshot.face_down") } else { return fail("EventObjectSnapshot.face_down missing") }
	if fv, found := get_any(v, "transformed"); found { if !decode_bool(fv, &out.transformed) do return fail("EventObjectSnapshot.transformed") } else { return fail("EventObjectSnapshot.transformed missing") }
	if fv, found := get_any(v, "is_suspected"); found { if !decode_bool(fv, &out.is_suspected) do return fail("EventObjectSnapshot.is_suspected") } else { return fail("EventObjectSnapshot.is_suspected missing") }
	if fv, found := get_any(v, "is_renowned"); found { if !decode_bool(fv, &out.is_renowned) do return fail("EventObjectSnapshot.is_renowned") } else { return fail("EventObjectSnapshot.is_renowned missing") }
	if fv, found := get_any(v, "is_saddled"); found { if !decode_bool(fv, &out.is_saddled) do return fail("EventObjectSnapshot.is_saddled") } else { return fail("EventObjectSnapshot.is_saddled missing") }
	if fv, found := get_any(v, "has_no_abilities"); found { if !decode_bool(fv, &out.has_no_abilities) do return fail("EventObjectSnapshot.has_no_abilities") } else { return fail("EventObjectSnapshot.has_no_abilities missing") }
	if fv, found := get_any(v, "attachments"); found { if !dec_dyn_EventAttachmentSnapshot(fv, &out.attachments) do return fail("EventObjectSnapshot.attachments") } else { return fail("EventObjectSnapshot.attachments missing") }
	if fv, found := get_any(v, "protector"); found { if !dec_opt_PlayerId(fv, &out.protector) do return fail("EventObjectSnapshot.protector") }
	if fv, found := get_any(v, "combat"); found { if !decode_EventCombatSnapshot(fv, &out.combat) do return fail("EventObjectSnapshot.combat") } else { return fail("EventObjectSnapshot.combat missing") }
	if fv, found := get_any(v, "history"); found { if !decode_EventObjectHistorySnapshot(fv, &out.history) do return fail("EventObjectSnapshot.history") } else { return fail("EventObjectSnapshot.history missing") }
	if fv, found := get_any(v, "relations"); found { if !decode_EventObjectRelationSnapshot(fv, &out.relations) do return fail("EventObjectSnapshot.relations") } else { return fail("EventObjectSnapshot.relations missing") }
	return true
}

encode_EventObjectSnapshot :: proc(b: ^strings.Builder, x: EventObjectSnapshot) {
	strings.write_byte(b, '{')
	f := true
	encode_EventObjectSnapshot_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_EventObjectSnapshot_members :: proc(b: ^strings.Builder, x: EventObjectSnapshot, first: ^bool) {
	member(b, first, "identity"); encode_ObjectIncarnationRef(b, x.identity)
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	member(b, first, "owner"); encode_PlayerId(b, x.owner)
	member(b, first, "zone"); encode_Zone(b, x.zone)
	member(b, first, "name"); encode_string(b, x.name)
	member(b, first, "core_types"); enc_dyn_CoreType(b, x.core_types)
	member(b, first, "subtypes"); enc_dyn_string(b, x.subtypes)
	member(b, first, "supertypes"); enc_dyn_Supertype(b, x.supertypes)
	member(b, first, "colors"); enc_dyn_ManaColor(b, x.colors)
	member(b, first, "keywords"); enc_dyn_Keyword(b, x.keywords)
	member(b, first, "power"); enc_opt_i32(b, x.power)
	member(b, first, "toughness"); enc_opt_i32(b, x.toughness)
	member(b, first, "base_power"); enc_opt_i32(b, x.base_power)
	member(b, first, "base_toughness"); enc_opt_i32(b, x.base_toughness)
	member(b, first, "mana_value"); encode_u32(b, x.mana_value)
	member(b, first, "counters"); encode_with_counter_map_serde(b, x.counters)
	member(b, first, "is_token"); encode_bool(b, x.is_token)
	member(b, first, "is_commander"); encode_bool(b, x.is_commander)
	member(b, first, "tapped"); encode_bool(b, x.tapped)
	member(b, first, "face_down"); encode_bool(b, x.face_down)
	member(b, first, "transformed"); encode_bool(b, x.transformed)
	member(b, first, "is_suspected"); encode_bool(b, x.is_suspected)
	member(b, first, "is_renowned"); encode_bool(b, x.is_renowned)
	member(b, first, "is_saddled"); encode_bool(b, x.is_saddled)
	member(b, first, "has_no_abilities"); encode_bool(b, x.has_no_abilities)
	member(b, first, "attachments"); enc_dyn_EventAttachmentSnapshot(b, x.attachments)
	member(b, first, "protector"); enc_opt_PlayerId(b, x.protector)
	member(b, first, "combat"); encode_EventCombatSnapshot(b, x.combat)
	member(b, first, "history"); encode_EventObjectHistorySnapshot(b, x.history)
	member(b, first, "relations"); encode_EventObjectRelationSnapshot(b, x.relations)
}

