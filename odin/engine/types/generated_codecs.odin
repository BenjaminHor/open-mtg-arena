decode_CopyTokenSpec :: proc(v: json.Value, out: ^CopyTokenSpec) -> bool {
	when COVERAGE do cov_hit("CopyTokenSpec")
	if v.kind != .Object do return fail("CopyTokenSpec: not an object")
	if fv, found := get_any(v, "values"); found { if !dec_ptr_CopiableValues(fv, &out.values) do return fail("CopyTokenSpec.values") } else { return fail("CopyTokenSpec.values missing") }
	if !decode_DisplayIdentity(v, &out.display) do return fail("CopyTokenSpec.display (flattened)")
	if fv, found := get_any(v, "extra_keywords"); found { if !dec_dyn_Keyword(fv, &out.extra_keywords) do return fail("CopyTokenSpec.extra_keywords") }
	if fv, found := get_any(v, "additional_modifications"); found { if !dec_dyn_ContinuousModification(fv, &out.additional_modifications) do return fail("CopyTokenSpec.additional_modifications") }
	if fv, found := get_any(v, "tapped"); found { if !decode_bool(fv, &out.tapped) do return fail("CopyTokenSpec.tapped") } else { return fail("CopyTokenSpec.tapped missing") }
	if fv, found := get_any(v, "enters_attacking"); found { if !decode_bool(fv, &out.enters_attacking) do return fail("CopyTokenSpec.enters_attacking") } else { return fail("CopyTokenSpec.enters_attacking missing") }
	if fv, found := get_any(v, "attack_request"); found { if !decode_TokenAttackRequest(fv, &out.attack_request) do return fail("CopyTokenSpec.attack_request") } else { out.attack_request = TokenAttackRequest(TokenAttackRequest_Unspecified{}) }
	if fv, found := get_any(v, "sacrifice_at"); found { if !dec_opt_Duration(fv, &out.sacrifice_at) do return fail("CopyTokenSpec.sacrifice_at") }
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("CopyTokenSpec.source_id") } else { return fail("CopyTokenSpec.source_id missing") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("CopyTokenSpec.controller") } else { return fail("CopyTokenSpec.controller missing") }
	if fv, found := get_any(v, "donor"); found { if !dec_opt_ObjectIncarnationRef(fv, &out.donor) do return fail("CopyTokenSpec.donor") }
	if fv, found := get_any(v, "double_faced"); found { if !dec_opt_CopiedDoubleFaces(fv, &out.double_faced) do return fail("CopyTokenSpec.double_faced") }
	return true
}

encode_CopyTokenSpec :: proc(b: ^strings.Builder, x: CopyTokenSpec) {
	strings.write_byte(b, '{')
	f := true
	encode_CopyTokenSpec_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CopyTokenSpec_members :: proc(b: ^strings.Builder, x: CopyTokenSpec, first: ^bool) {
	member(b, first, "values"); enc_ptr_CopiableValues(b, x.values)
	encode_DisplayIdentity_members(b, x.display, first)
	if !((len(x.extra_keywords) == 0)) { member(b, first, "extra_keywords"); enc_dyn_Keyword(b, x.extra_keywords) }
	if !((len(x.additional_modifications) == 0)) { member(b, first, "additional_modifications"); enc_dyn_ContinuousModification(b, x.additional_modifications) }
	member(b, first, "tapped"); encode_bool(b, x.tapped)
	member(b, first, "enters_attacking"); encode_bool(b, x.enters_attacking)
	if !(skip_CopyTokenSpec_TokenAttackRequest_is_unspecified_TokenAttackRequest(x.attack_request)) { member(b, first, "attack_request"); encode_TokenAttackRequest(b, x.attack_request) }
	if !(x.sacrifice_at == nil) { member(b, first, "sacrifice_at"); enc_opt_Duration(b, x.sacrifice_at) }
	member(b, first, "source_id"); encode_ObjectId(b, x.source_id)
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	if !(x.donor == nil) { member(b, first, "donor"); enc_opt_ObjectIncarnationRef(b, x.donor) }
	if !(x.double_faced == nil) { member(b, first, "double_faced"); enc_opt_CopiedDoubleFaces(b, x.double_faced) }
}

