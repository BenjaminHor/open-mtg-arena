	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("PendingCounterPostAction::RecordPlayerAction.player_id") } else { return fail("PendingCounterPostAction::RecordPlayerAction.player_id missing") }
	if fv, found := get_any(v, "action"); found { if !decode_PlayerActionKind(fv, &out.action) do return fail("PendingCounterPostAction::RecordPlayerAction.action") } else { return fail("PendingCounterPostAction::RecordPlayerAction.action missing") }
