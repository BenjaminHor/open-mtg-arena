	if fv, found := get_any(v, "group_id"); found { if !decode_LogicalZoneChangeGroupId(fv, &out.group_id) do return fail("ChangeZoneBatchTail.group_id") } else { return fail("ChangeZoneBatchTail.group_id missing") }
	if fv, found := get_any(v, "effect_kind"); found { if !decode_EffectKind(fv, &out.effect_kind) do return fail("ChangeZoneBatchTail.effect_kind") } else { return fail("ChangeZoneBatchTail.effect_kind missing") }
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("ChangeZoneBatchTail.source_id") } else { return fail("ChangeZoneBatchTail.source_id missing") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("ChangeZoneBatchTail.controller") } else { return fail("ChangeZoneBatchTail.controller missing") }
	if fv, found := get_any(v, "destination"); found { if !decode_Zone(fv, &out.destination) do return fail("ChangeZoneBatchTail.destination") } else { return fail("ChangeZoneBatchTail.destination missing") }
	if fv, found := get_any(v, "arrangement"); found { if !decode_ChangeZoneArrangementPlan(fv, &out.arrangement) do return fail("ChangeZoneBatchTail.arrangement") }
	if fv, found := get_any(v, "count"); found { if !decode_ChangeZoneCountPolicy(fv, &out.count) do return fail("ChangeZoneBatchTail.count") } else { return fail("ChangeZoneBatchTail.count missing") }
	if fv, found := get_any(v, "pending_return_result_producer"); found { if !dec_opt_t2_ReturnResultOccurrenceId_ReturnResultId(fv, &out.pending_return_result_producer) do return fail("ChangeZoneBatchTail.pending_return_result_producer") }
	if fv, found := get_any(v, "own_exile_links"); found { if !decode_OwnExileLinkSettlement(fv, &out.own_exile_links) do return fail("ChangeZoneBatchTail.own_exile_links") }
	if fv, found := get_any(v, "entry_collector"); found { if !decode_EntryOccurrenceCollector(fv, &out.entry_collector) do return fail("ChangeZoneBatchTail.entry_collector") }
	return true
}

