decode_ProtectionTarget :: proc(v: json.Value, out: ^ProtectionTarget) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ProtectionTarget: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ProtectionTarget: not a string or object")
	}
	switch variant {
	case "Color": tmp: ProtectionTarget_Color; if !decode_ManaColor(body, &tmp._0) do return fail("ProtectionTarget::Color"); out^ = tmp
	case "CardType": tmp: ProtectionTarget_CardType; if !decode_string(body, &tmp._0) do return fail("ProtectionTarget::CardType"); out^ = tmp
	case "Quality": tmp: ProtectionTarget_Quality; if !decode_string(body, &tmp._0) do return fail("ProtectionTarget::Quality"); out^ = tmp
	case "Multicolored": out^ = ProtectionTarget_Multicolored{}
	case "ChosenColor": out^ = ProtectionTarget_ChosenColor{}
	case "ChosenCardType": out^ = ProtectionTarget_ChosenCardType{}
	case "ChosenCardName": out^ = ProtectionTarget_ChosenCardName{}
	case "ChosenPlayer": out^ = ProtectionTarget_ChosenPlayer{}
	case "Everything": out^ = ProtectionTarget_Everything{}
	case "Filter": tmp: ProtectionTarget_Filter; if !decode_TargetFilter(body, &tmp._0) do return fail("ProtectionTarget::Filter"); out^ = tmp
	case "FromPlayer": tmp: ProtectionTarget_FromPlayer; if !decode_ControllerRef(body, &tmp._0) do return fail("ProtectionTarget::FromPlayer"); out^ = tmp
	case "EachColor": tmp: ProtectionTarget_EachColor; if !decode_ProtectionColorSet(body, &tmp._0) do return fail("ProtectionTarget::EachColor"); out^ = tmp
	case: return fail("ProtectionTarget: unknown variant")
	}
	return true
}

encode_ProtectionTarget :: proc(b: ^strings.Builder, x: ProtectionTarget) {
	#partial switch y in x {
	case ProtectionTarget_Color: strings.write_byte(b, '{'); json.write_string(b, "Color"); strings.write_byte(b, ':'); encode_ManaColor(b, y._0); strings.write_byte(b, '}')
	case ProtectionTarget_CardType: strings.write_byte(b, '{'); json.write_string(b, "CardType"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	case ProtectionTarget_Quality: strings.write_byte(b, '{'); json.write_string(b, "Quality"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	case ProtectionTarget_Multicolored: _ = y; json.write_string(b, "Multicolored")
	case ProtectionTarget_ChosenColor: _ = y; json.write_string(b, "ChosenColor")
	case ProtectionTarget_ChosenCardType: _ = y; json.write_string(b, "ChosenCardType")
	case ProtectionTarget_ChosenCardName: _ = y; json.write_string(b, "ChosenCardName")
	case ProtectionTarget_ChosenPlayer: _ = y; json.write_string(b, "ChosenPlayer")
	case ProtectionTarget_Everything: _ = y; json.write_string(b, "Everything")
	case ProtectionTarget_Filter: strings.write_byte(b, '{'); json.write_string(b, "Filter"); strings.write_byte(b, ':'); encode_TargetFilter(b, y._0); strings.write_byte(b, '}')
	case ProtectionTarget_FromPlayer: strings.write_byte(b, '{'); json.write_string(b, "FromPlayer"); strings.write_byte(b, ':'); encode_ControllerRef(b, y._0); strings.write_byte(b, '}')
	case ProtectionTarget_EachColor: strings.write_byte(b, '{'); json.write_string(b, "EachColor"); strings.write_byte(b, ':'); encode_ProtectionColorSet(b, y._0); strings.write_byte(b, '}')
	}
}

