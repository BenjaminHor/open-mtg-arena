decode_StagedMemberOutcome :: proc(v: json.Value, out: ^StagedMemberOutcome) -> bool {
	when COVERAGE do cov_hit("StagedMemberOutcome")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("StagedMemberOutcome: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("StagedMemberOutcome: not a string or object")
	}
	switch variant {
	case "Approved": when COVERAGE do cov_hit("StagedMemberOutcome::Approved"); tmp: StagedMemberOutcome_Approved; if !decode_ProposedEvent(body, &tmp._0) do return fail("StagedMemberOutcome::Approved"); out^ = tmp
	case "Prevented": when COVERAGE do cov_hit("StagedMemberOutcome::Prevented"); out^ = StagedMemberOutcome_Prevented{}
	case: return fail("StagedMemberOutcome: unknown variant")
	}
	return true
}

encode_StagedMemberOutcome :: proc(b: ^strings.Builder, x: StagedMemberOutcome) {
	#partial switch y in x {
	case StagedMemberOutcome_Approved: strings.write_byte(b, '{'); json.write_string(b, "Approved"); strings.write_byte(b, ':'); encode_ProposedEvent(b, y._0); strings.write_byte(b, '}')
	case StagedMemberOutcome_Prevented: _ = y; json.write_string(b, "Prevented")
	}
}

decode_StagedMemberOperation :: proc(v: json.Value, out: ^StagedMemberOperation) -> bool {
	when COVERAGE do cov_hit("StagedMemberOperation")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("StagedMemberOperation: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("StagedMemberOperation: not a string or object")
	}
	switch variant {
	case "ZoneMove": when COVERAGE do cov_hit("StagedMemberOperation::ZoneMove"); out^ = StagedMemberOperation_ZoneMove{}
	case "Destroy": when COVERAGE do cov_hit("StagedMemberOperation::Destroy"); tmp: StagedMemberOperation_Destroy; if !decode_StagedDestroyOperation(body, &tmp._0) do return fail("StagedMemberOperation::Destroy"); out^ = tmp
	case: return fail("StagedMemberOperation: unknown variant")
	}
	return true
}

encode_StagedMemberOperation :: proc(b: ^strings.Builder, x: StagedMemberOperation) {
	#partial switch y in x {
	case StagedMemberOperation_ZoneMove: _ = y; json.write_string(b, "ZoneMove")
	case StagedMemberOperation_Destroy: strings.write_byte(b, '{'); json.write_string(b, "Destroy"); strings.write_byte(b, ':'); encode_StagedDestroyOperation(b, y._0); strings.write_byte(b, '}')
	}
}

decode_HeldReplacementDecision :: proc(v: json.Value, out: ^HeldReplacementDecision) -> bool {
	when COVERAGE do cov_hit("HeldReplacementDecision")
	if v.kind != .Object do return fail("HeldReplacementDecision: not an object")
	if fv, found := get_any(v, "pending"); found { if !decode_PendingReplacement(fv, &out.pending) do return fail("HeldReplacementDecision.pending") } else { return fail("HeldReplacementDecision.pending missing") }
	if fv, found := get_any(v, "chooser"); found { if !decode_PlayerId(fv, &out.chooser) do return fail("HeldReplacementDecision.chooser") } else { return fail("HeldReplacementDecision.chooser missing") }
	if fv, found := get_any(v, "prompt"); found { if !decode_HeldDecisionPrompt(fv, &out.prompt) do return fail("HeldReplacementDecision.prompt") } else { return fail("HeldReplacementDecision.prompt missing") }
	if fv, found := get_any(v, "boundary"); found { if !dec_opt_PendingZoneChangeDelivery(fv, &out.boundary) do return fail("HeldReplacementDecision.boundary") }
	if fv, found := get_any(v, "drain"); found { if !dec_opt_PostReplacementDrainStack(fv, &out.drain) do return fail("HeldReplacementDecision.drain") }
	return true
}

encode_HeldReplacementDecision :: proc(b: ^strings.Builder, x: HeldReplacementDecision) {
	strings.write_byte(b, '{')
	f := true
	encode_HeldReplacementDecision_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_HeldReplacementDecision_members :: proc(b: ^strings.Builder, x: HeldReplacementDecision, first: ^bool) {
	member(b, first, "pending"); encode_PendingReplacement(b, x.pending)
	member(b, first, "chooser"); encode_PlayerId(b, x.chooser)
	member(b, first, "prompt"); encode_HeldDecisionPrompt(b, x.prompt)
	if !(x.boundary == nil) { member(b, first, "boundary"); enc_opt_PendingZoneChangeDelivery(b, x.boundary) }
	if !(x.drain == nil) { member(b, first, "drain"); enc_opt_PostReplacementDrainStack(b, x.drain) }
}

