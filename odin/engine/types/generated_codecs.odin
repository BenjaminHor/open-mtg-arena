	case "CantWinTheGame": out^ = StaticMode_CantWinTheGame{}
	case "CantLoseTheGame": out^ = StaticMode_CantLoseTheGame{}
	case "LegendRuleDoesntApply": out^ = StaticMode_LegendRuleDoesntApply{}
	case "SpeedCanIncreaseBeyondFour": out^ = StaticMode_SpeedCanIncreaseBeyondFour{}
	case "DefilerCostReduction":
		tmp: StaticMode_DefilerCostReduction
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_DefilerCostReduction) -> bool {
	if fv, found := get_any(v, "color"); found { if !decode_ManaColor(fv, &out.color) do return fail("StaticMode::DefilerCostReduction.color") } else { return fail("StaticMode::DefilerCostReduction.color missing") }
	if fv, found := get_any(v, "life_cost"); found { if !decode_u32(fv, &out.life_cost) do return fail("StaticMode::DefilerCostReduction.life_cost") } else { return fail("StaticMode::DefilerCostReduction.life_cost missing") }
	if fv, found := get_any(v, "mana_reduction"); found { if !decode_ManaCost(fv, &out.mana_reduction) do return fail("StaticMode::DefilerCostReduction.mana_reduction") } else { return fail("StaticMode::DefilerCostReduction.mana_reduction missing") }
	if fv, found := get_any(v, "reach"); found { if !decode_CostReductionReach(fv, &out.reach) do return fail("StaticMode::DefilerCostReduction.reach") }
	return true
		}) { return fail("StaticMode::DefilerCostReduction") }
		out^ = tmp
	case "SkipStep":
		tmp: StaticMode_SkipStep
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_SkipStep) -> bool {
	if fv, found := get_any(v, "step"); found { if !decode_Phase(fv, &out.step) do return fail("StaticMode::SkipStep.step") } else { return fail("StaticMode::SkipStep.step missing") }
	return true
		}) { return fail("StaticMode::SkipStep") }
		out^ = tmp
	case "SpendManaAsAnyColor":
		tmp: StaticMode_SpendManaAsAnyColor
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_SpendManaAsAnyColor) -> bool {
	if fv, found := get_any(v, "spell_filter"); found { if !dec_opt_TargetFilter(fv, &out.spell_filter) do return fail("StaticMode::SpendManaAsAnyColor.spell_filter") }
	if fv, found := get_any(v, "activation_source_filter"); found { if !dec_opt_TargetFilter(fv, &out.activation_source_filter) do return fail("StaticMode::SpendManaAsAnyColor.activation_source_filter") }
	if fv, found := get_any(v, "concession"); found { if !decode_ManaSpendPermission(fv, &out.concession) do return fail("StaticMode::SpendManaAsAnyColor.concession") }
	return true
		}) { return fail("StaticMode::SpendManaAsAnyColor") }
		out^ = tmp
	case "PayLifeAsColoredMana":
		tmp: StaticMode_PayLifeAsColoredMana
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_PayLifeAsColoredMana) -> bool {
	if fv, found := get_any(v, "color"); found { if !decode_ManaColor(fv, &out.color) do return fail("StaticMode::PayLifeAsColoredMana.color") } else { return fail("StaticMode::PayLifeAsColoredMana.color missing") }
	return true
		}) { return fail("StaticMode::PayLifeAsColoredMana") }
		out^ = tmp
	case "StepEndUnspentMana":
		tmp: StaticMode_StepEndUnspentMana
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_StepEndUnspentMana) -> bool {
	if fv, found := get_any(v, "filter"); found { if !dec_opt_ManaColor(fv, &out.filter) do return fail("StaticMode::StepEndUnspentMana.filter") }
	if fv, found := get_any(v, "action"); found { if !decode_StepEndManaAction(fv, &out.action) do return fail("StaticMode::StepEndUnspentMana.action") } else { return fail("StaticMode::StepEndUnspentMana.action missing") }
	return true
		}) { return fail("StaticMode::StepEndUnspentMana") }
		out^ = tmp
	case "UnspentManaLossCausesLifeLoss": out^ = StaticMode_UnspentManaLossCausesLifeLoss{}
	case "WinFirstCoinFlipSetEachTurn": out^ = StaticMode_WinFirstCoinFlipSetEachTurn{}
	case "CanAttackWithDefender": out^ = StaticMode_CanAttackWithDefender{}
	case "IgnoreLandwalkForBlocking":
		tmp: StaticMode_IgnoreLandwalkForBlocking
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_IgnoreLandwalkForBlocking) -> bool {
	if fv, found := get_any(v, "qualifier"); found { if !dec_opt_string(fv, &out.qualifier) do return fail("StaticMode::IgnoreLandwalkForBlocking.qualifier") }
	return true
		}) { return fail("StaticMode::IgnoreLandwalkForBlocking") }
		out^ = tmp
	case "CanActivateAbilitiesAsThoughHaste": out^ = StaticMode_CanActivateAbilitiesAsThoughHaste{}
	case "CanBlockShadow": out^ = StaticMode_CanBlockShadow{}
	case "AssignNoCombatDamage": out^ = StaticMode_AssignNoCombatDamage{}
	case "UntapsDuringEachOtherPlayersUntapStep": out^ = StaticMode_UntapsDuringEachOtherPlayersUntapStep{}
	case "MaxUntapPerType":
		tmp: StaticMode_MaxUntapPerType
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_MaxUntapPerType) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("StaticMode::MaxUntapPerType.filter") } else { return fail("StaticMode::MaxUntapPerType.filter missing") }
	if fv, found := get_any(v, "max"); found { if !decode_u32(fv, &out.max) do return fail("StaticMode::MaxUntapPerType.max") } else { return fail("StaticMode::MaxUntapPerType.max missing") }
	return true
		}) { return fail("StaticMode::MaxUntapPerType") }
		out^ = tmp
	case "EntersWithAdditionalCounters":
		tmp: StaticMode_EntersWithAdditionalCounters
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_EntersWithAdditionalCounters) -> bool {
	if fv, found := get_any(v, "counter_type"); found { if !decode_CounterType(fv, &out.counter_type) do return fail("StaticMode::EntersWithAdditionalCounters.counter_type") } else { return fail("StaticMode::EntersWithAdditionalCounters.counter_type missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("StaticMode::EntersWithAdditionalCounters.count") } else { return fail("StaticMode::EntersWithAdditionalCounters.count missing") }
	return true
		}) { return fail("StaticMode::EntersWithAdditionalCounters") }
		out^ = tmp
	case "CountersCantBeRemoved":
		tmp: StaticMode_CountersCantBeRemoved
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_CountersCantBeRemoved) -> bool {
	if fv, found := get_any(v, "counter_type"); found { if !decode_CounterType(fv, &out.counter_type) do return fail("StaticMode::CountersCantBeRemoved.counter_type") } else { return fail("StaticMode::CountersCantBeRemoved.counter_type missing") }
	return true
		}) { return fail("StaticMode::CountersCantBeRemoved") }
		out^ = tmp
	case "CountsAsNamed":
		tmp: StaticMode_CountsAsNamed
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^StaticMode_CountsAsNamed) -> bool {
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("StaticMode::CountsAsNamed.name") } else { return fail("StaticMode::CountsAsNamed.name missing") }
	return true
		}) { return fail("StaticMode::CountsAsNamed") }
		out^ = tmp
	case "Other": tmp: StaticMode_Other; if !decode_string(body, &tmp._0) do return fail("StaticMode::Other"); out^ = tmp
	case: return fail("StaticMode: unknown variant")
	}
	return true
}

encode_StaticMode :: proc(b: ^strings.Builder, x: StaticMode) {
	#partial switch y in x {
	case StaticMode_Continuous: _ = y; json.write_string(b, "Continuous")
	case StaticMode_DamageNotRemovedDuringCleanup: _ = y; json.write_string(b, "DamageNotRemovedDuringCleanup")
	case StaticMode_LethalDamageDeterminedByPower: _ = y; json.write_string(b, "LethalDamageDeterminedByPower")
	case StaticMode_CantAttack: _ = y; json.write_string(b, "CantAttack")
	case StaticMode_CantBlock: _ = y; json.write_string(b, "CantBlock")
	case StaticMode_CantAttackOrBlock: _ = y; json.write_string(b, "CantAttackOrBlock")
	case StaticMode_AttackOnlyNeighbor: _ = y; json.write_string(b, "AttackOnlyNeighbor")
	case StaticMode_CantBecomeSuspected: _ = y; json.write_string(b, "CantBecomeSuspected")
	case StaticMode_MaxAttackersEachCombat: strings.write_byte(b, '{'); json.write_string(b, "MaxAttackersEachCombat"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "max"); encode_u32(b, y.max)
	member(b, first, "defender"); enc_opt_AttackDefenderScope(b, y.defender)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_MaxBlockersEachCombat: strings.write_byte(b, '{'); json.write_string(b, "MaxBlockersEachCombat"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "max"); encode_u32(b, y.max)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantBeTargeted: strings.write_byte(b, '{'); json.write_string(b, "CantBeTargeted"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "who"); encode_ProhibitionScope(b, y.who)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantBeCast: strings.write_byte(b, '{'); json.write_string(b, "CantBeCast"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "who"); encode_ProhibitionScope(b, y.who)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantBeActivated: strings.write_byte(b, '{'); json.write_string(b, "CantBeActivated"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "who"); encode_ProhibitionScope(b, y.who)
	member(b, first, "source_filter"); encode_TargetFilter(b, y.source_filter)
	member(b, first, "exemption"); encode_ActivationExemption(b, y.exemption)
	member(b, first, "kind"); enc_opt_ActivatedAbilityKind(b, y.kind)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantSearchLibrary: strings.write_byte(b, '{'); json.write_string(b, "CantSearchLibrary"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "cause"); encode_ProhibitionScope(b, y.cause)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_RestrictLibrarySearchToTop: strings.write_byte(b, '{'); json.write_string(b, "RestrictLibrarySearchToTop"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "who"); encode_ProhibitionScope(b, y.who)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_ControlPlayersDuringOwnLibrarySearch: strings.write_byte(b, '{'); json.write_string(b, "ControlPlayersDuringOwnLibrarySearch"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "who"); encode_ProhibitionScope(b, y.who)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantCauseSacrificeOrExile: strings.write_byte(b, '{'); json.write_string(b, "CantCauseSacrificeOrExile"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "cause"); encode_ProhibitionScope(b, y.cause)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantCauseForcedAction: strings.write_byte(b, '{'); json.write_string(b, "CantCauseForcedAction"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "cause"); encode_ProhibitionScope(b, y.cause)
	member(b, first, "actions"); enc_dyn_CostCategory(b, y.actions)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CastWithFlash: _ = y; json.write_string(b, "CastWithFlash")
	case StaticMode_GrantsExtraVote: _ = y; json.write_string(b, "GrantsExtraVote")
	case StaticMode_GrantsExtraVillainousChoice: _ = y; json.write_string(b, "GrantsExtraVillainousChoice")
	case StaticMode_CastWithKeyword: strings.write_byte(b, '{'); json.write_string(b, "CastWithKeyword"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CastWithAlternativeCost: strings.write_byte(b, '{'); json.write_string(b, "CastWithAlternativeCost"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "cost"); encode_AbilityCost(b, y.cost)
	if !(y.timing_permission == nil) { member(b, first, "timing_permission"); enc_opt_CastTimingPermission(b, y.timing_permission) }
	if !(skip_StaticMode_CastFrequency_is_unlimited(y.frequency)) { member(b, first, "frequency"); encode_CastFrequency(b, y.frequency) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_AlternativeKeywordCost: strings.write_byte(b, '{'); json.write_string(b, "AlternativeKeywordCost"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "keyword"); encode_KeywordKind(b, y.keyword)
	member(b, first, "cost"); encode_AbilityCost(b, y.cost)
	if !(y.frequency == nil) { member(b, first, "frequency"); enc_opt_CastFrequency(b, y.frequency) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_ModifyCost: strings.write_byte(b, '{'); json.write_string(b, "ModifyCost"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "mode"); encode_CostModifyMode(b, y.mode)
	member(b, first, "amount"); encode_ManaCost(b, y.amount)
	member(b, first, "spell_filter"); enc_opt_TargetFilter(b, y.spell_filter)
	if !(y.dynamic_count == nil) { member(b, first, "dynamic_count"); enc_opt_QuantityRef(b, y.dynamic_count) }
	if !(skip_StaticMode_CostReductionReach_is_spills_to_generic(y.reach)) { member(b, first, "reach"); encode_CostReductionReach(b, y.reach) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_ImposeAdditionalCost: strings.write_byte(b, '{'); json.write_string(b, "ImposeAdditionalCost"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "cost"); encode_AbilityCost(b, y.cost)
	member(b, first, "spell_filter"); enc_opt_TargetFilter(b, y.spell_filter)
	member(b, first, "action"); encode_AdditionalCostTaxAction(b, y.action)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_ReduceAbilityCost: strings.write_byte(b, '{'); json.write_string(b, "ReduceAbilityCost"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "mode"); encode_CostModifyMode(b, y.mode)
	member(b, first, "keyword"); encode_string(b, y.keyword)
	member(b, first, "amount"); encode_u32(b, y.amount)
	if !(y.minimum_mana == nil) { member(b, first, "minimum_mana"); enc_opt_u32(b, y.minimum_mana) }
	if !(y.dynamic_count == nil) { member(b, first, "dynamic_count"); enc_opt_QuantityRef(b, y.dynamic_count) }
	member(b, first, "exemption"); encode_ActivationExemption(b, y.exemption)
	if !(y.activator == nil) { member(b, first, "activator"); enc_opt_PlayerFilter(b, y.activator) }
	if !(y.targets == nil) { member(b, first, "targets"); enc_opt_TargetFilter(b, y.targets) }
	if !(y.frequency == nil) { member(b, first, "frequency"); enc_opt_CastFrequency(b, y.frequency) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_ReduceActionCost: strings.write_byte(b, '{'); json.write_string(b, "ReduceActionCost"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "action"); encode_SpecialAction(b, y.action)
	member(b, first, "mode"); encode_CostModifyMode(b, y.mode)
	member(b, first, "amount"); encode_u32(b, y.amount)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_ModifyActivationLimit: strings.write_byte(b, '{'); json.write_string(b, "ModifyActivationLimit"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "keyword"); encode_string(b, y.keyword)
	member(b, first, "new_limit"); encode_u8(b, y.new_limit)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_ActivateAsInstant: strings.write_byte(b, '{'); json.write_string(b, "ActivateAsInstant"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "cost_category"); encode_CostCategory(b, y.cost_category)
	if !(y.keyword == nil) { member(b, first, "keyword"); enc_opt_AbilityTag(b, y.keyword) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantPayCost: strings.write_byte(b, '{'); json.write_string(b, "CantPayCost"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "who"); encode_ProhibitionScope(b, y.who)
	member(b, first, "cost"); encode_CostPaymentProhibition(b, y.cost)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantGainLife: _ = y; json.write_string(b, "CantGainLife")
	case StaticMode_CantLoseLife: _ = y; json.write_string(b, "CantLoseLife")
	case StaticMode_PlayerProtection: strings.write_byte(b, '{'); json.write_string(b, "PlayerProtection"); strings.write_byte(b, ':'); encode_ProtectionTarget(b, y._0); strings.write_byte(b, '}')
	case StaticMode_MustAttack: _ = y; json.write_string(b, "MustAttack")
	case StaticMode_MustAttackDefender: strings.write_byte(b, '{'); json.write_string(b, "MustAttackDefender"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "defender"); encode_RequiredDefender(b, y.defender)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_MustBlock: _ = y; json.write_string(b, "MustBlock")
	case StaticMode_MustBlockAttacker: strings.write_byte(b, '{'); json.write_string(b, "MustBlockAttacker"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "attacker"); encode_ObjectIncarnationRef(b, y.attacker)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantDraw: strings.write_byte(b, '{'); json.write_string(b, "CantDraw"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "who"); encode_ProhibitionScope(b, y.who)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_DrawFromBottom: strings.write_byte(b, '{'); json.write_string(b, "DrawFromBottom"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "who"); encode_ProhibitionScope(b, y.who)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_DoubleTriggers: strings.write_byte(b, '{'); json.write_string(b, "DoubleTriggers"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "cause"); encode_TriggerCause(b, y.cause)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_IgnoreHexproof: _ = y; json.write_string(b, "IgnoreHexproof")
	case StaticMode_ExtraBlockers: strings.write_byte(b, '{'); json.write_string(b, "ExtraBlockers"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "count"); enc_opt_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_RevealTopOfLibrary: strings.write_byte(b, '{'); json.write_string(b, "RevealTopOfLibrary"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "all_players"); encode_bool(b, y.all_players)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_RevealHand: strings.write_byte(b, '{'); json.write_string(b, "RevealHand"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "who"); encode_ProhibitionScope(b, y.who)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_GraveyardCastPermission: strings.write_byte(b, '{'); json.write_string(b, "GraveyardCastPermission"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "frequency"); encode_CastFrequency(b, y.frequency)
	member(b, first, "play_mode"); encode_CardPlayMode(b, y.play_mode)
	if !(y.graveyard_destination_replacement == nil) { member(b, first, "graveyard_destination_replacement"); enc_opt_Zone(b, y.graveyard_destination_replacement) }
	if !(y.extra_cost == nil) { member(b, first, "extra_cost"); enc_opt_CastExtraCost(b, y.extra_cost) }
	if !(y.enters_with_counter == nil) { member(b, first, "enters_with_counter"); enc_opt_CounterType(b, y.enters_with_counter) }
	if !(skip_StaticMode_EtbTapState_is_unspecified(y.enter_tapped)) { member(b, first, "enter_tapped"); encode_EtbTapState(b, y.enter_tapped) }
	if !(y.required_cast_keyword == nil) { member(b, first, "required_cast_keyword"); enc_opt_KeywordKind(b, y.required_cast_keyword) }
	if !(skip_StaticMode_GraveyardPermissionPool_is_own_graveyard(y.pool)) { member(b, first, "pool"); encode_GraveyardPermissionPool(b, y.pool) }
	if !(skip_StaticMode_PermissionCastLimit_is_unlimited(y.cast_limit)) { member(b, first, "cast_limit"); encode_PermissionCastLimit(b, y.cast_limit) }
	if !(y.mana_spend_permission == nil) { member(b, first, "mana_spend_permission"); enc_opt_ManaSpendPermission(b, y.mana_spend_permission) }
	if !(skip_StaticMode_PendingEntersModifications_is_empty(y.enters_modifications)) { member(b, first, "enters_modifications"); encode_PendingEntersModifications(b, y.enters_modifications) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_TopOfLibraryCastPermission: strings.write_byte(b, '{'); json.write_string(b, "TopOfLibraryCastPermission"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "play_mode"); encode_CardPlayMode(b, y.play_mode)
	member(b, first, "frequency"); encode_CastFrequency(b, y.frequency)
	member(b, first, "alt_cost"); enc_opt_AbilityCost(b, y.alt_cost)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_TopOfLibraryHasPlot: _ = y; json.write_string(b, "TopOfLibraryHasPlot")
	case StaticMode_TopOfLibraryPlotPermission: _ = y; json.write_string(b, "TopOfLibraryPlotPermission")
	case StaticMode_CastFromHandFree: strings.write_byte(b, '{'); json.write_string(b, "CastFromHandFree"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "frequency"); encode_CastFrequency(b, y.frequency)
	member(b, first, "origin"); encode_CastFreeOrigin(b, y.origin)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_ExileCastPermission: strings.write_byte(b, '{'); json.write_string(b, "ExileCastPermission"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "frequency"); encode_CastFrequency(b, y.frequency)
	member(b, first, "play_mode"); encode_CardPlayMode(b, y.play_mode)
	member(b, first, "cost"); encode_ExileCastCost(b, y.cost)
	member(b, first, "pool"); encode_ExileCardPool(b, y.pool)
	member(b, first, "timing"); encode_ExileCastTiming(b, y.timing)
	if !(y.mana_spend_permission == nil) { member(b, first, "mana_spend_permission"); enc_opt_ManaSpendPermission(b, y.mana_spend_permission) }
	if !(!y.grants_flash) { member(b, first, "grants_flash"); encode_bool(b, y.grants_flash) }
	if !(y.extra_cost == nil) { member(b, first, "extra_cost"); enc_opt_CastExtraCost(b, y.extra_cost) }
	if !(y.enters_with_counter == nil) { member(b, first, "enters_with_counter"); enc_opt_CounterType(b, y.enters_with_counter) }
	if !(skip_StaticMode_is_default_exile_cast_grantee(y.grantee)) { member(b, first, "grantee"); encode_ExileCastGrantee(b, y.grantee) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_LinkedCollectionCounterPlayPermission: _ = y; json.write_string(b, "LinkedCollectionCounterPlayPermission")
	case StaticMode_CountersPersistAcrossZones: strings.write_byte(b, '{'); json.write_string(b, "CountersPersistAcrossZones"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "excluded_zones"); enc_dyn_Zone(b, y.excluded_zones)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantBeCountered: _ = y; json.write_string(b, "CantBeCountered")
	case StaticMode_CantBeCopied: _ = y; json.write_string(b, "CantBeCopied")
	case StaticMode_CantEnterBattlefieldFrom: _ = y; json.write_string(b, "CantEnterBattlefieldFrom")
	case StaticMode_CantCastFrom: strings.write_byte(b, '{'); json.write_string(b, "CantCastFrom"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "who"); encode_ProhibitionScope(b, y.who)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CantCastDuring: strings.write_byte(b, '{'); json.write_string(b, "CantCastDuring"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "who"); encode_ProhibitionScope(b, y.who)
	member(b, first, "when"); encode_CastingProhibitionCondition(b, y.when_)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
