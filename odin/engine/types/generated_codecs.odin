	if !(x.resolution_source_relatch == nil) { member(b, first, "resolution_source_relatch"); enc_opt_ResolutionSourceRelatch(b, x.resolution_source_relatch) }
	if !((len(x.current_trigger_events) == 0)) { member(b, first, "current_trigger_events"); enc_dyn_GameEvent(b, x.current_trigger_events) }
	if !(x.last_discover_value == nil) { member(b, first, "last_discover_value"); enc_opt_i32(b, x.last_discover_value) }
	if !((len(x.stack_trigger_event_batches) == 0)) { member(b, first, "stack_trigger_event_batches"); enc_map_ObjectId_dyn_GameEvent(b, x.stack_trigger_event_batches) }
	if !((len(x.stack_trigger_firings) == 0)) { member(b, first, "stack_trigger_firings"); enc_map_ObjectId_TriggerFiring(b, x.stack_trigger_firings) }
	if !((x.lki_cache == nil || len(x.lki_cache^) == 0)) { member(b, first, "lki_cache"); enc_shared_map_ObjectId_LKISnapshot(b, x.lki_cache) }
	if !((x.lki_copiable_values == nil || len(x.lki_copiable_values^) == 0)) { member(b, first, "lki_copiable_values"); enc_shared_map_ObjectId_CopiableValues(b, x.lki_copiable_values) }
	if !((x.lki_by_incarnation == nil || len(x.lki_by_incarnation^) == 0)) { member(b, first, "lki_by_incarnation"); enc_shared_map_ObjectId_ptr_map_u64_LKISnapshot(b, x.lki_by_incarnation) }
	if !((x.lki_copiable_values_by_incarnation == nil || len(x.lki_copiable_values_by_incarnation^) == 0)) { member(b, first, "lki_copiable_values_by_incarnation"); enc_shared_map_ObjectId_ptr_map_u64_CopiableValues(b, x.lki_copiable_values_by_incarnation) }
	if !((x.departed_stack_spells == nil || len(x.departed_stack_spells^) == 0)) { member(b, first, "departed_stack_spells"); enc_shared_map_ObjectId_ptr_map_u64_DepartedStackSpell(b, x.departed_stack_spells) }
	if !((x.departed_activated_abilities == nil || len(x.departed_activated_abilities^) == 0)) { member(b, first, "departed_activated_abilities"); enc_shared_map_ObjectId_StackEntry(b, x.departed_activated_abilities) }
	if !((len(x.linked_exile_lki) == 0)) { member(b, first, "linked_exile_lki"); enc_map_ObjectId_dyn_LinkedExileLki(b, x.linked_exile_lki) }
	if !(x.pending_cost_move_resume == nil) { member(b, first, "pending_cost_move_resume"); enc_opt_PendingCostMoveResume(b, x.pending_cost_move_resume) }
	if !(x.pending_deferred_life_cost_resume == nil) { member(b, first, "pending_deferred_life_cost_resume"); enc_opt_DeferredLifeCostResume(b, x.pending_deferred_life_cost_resume) }
	if !(x.pending_triggered_mana_resume == nil) { member(b, first, "pending_triggered_mana_resume"); enc_ptr_TriggeredManaResume(b, x.pending_triggered_mana_resume) }
	if !(x.pending_trigger_construction_priority_recipient == nil) { member(b, first, "pending_trigger_construction_priority_recipient"); enc_opt_PlayerId(b, x.pending_trigger_construction_priority_recipient) }
	if !(x.pending_cast == nil) { member(b, first, "pending_cast"); enc_ptr_PendingCast(b, x.pending_cast) }
	member(b, first, "ring_level"); enc_map_PlayerId_u8(b, x.ring_level)
	member(b, first, "ring_bearer"); enc_map_PlayerId_opt_ObjectId(b, x.ring_bearer)
	if !((len(x.dungeon_progress) == 0)) { member(b, first, "dungeon_progress"); enc_map_PlayerId_DungeonProgress(b, x.dungeon_progress) }
	if !((x.planar_deck.len == 0)) { member(b, first, "planar_deck"); enc_PVec_ObjectId(b, x.planar_deck) }
	if !(x.planar_controller == nil) { member(b, first, "planar_controller"); enc_opt_PlayerId(b, x.planar_controller) }
	if !((len(x.planar_die_actions_this_turn) == 0)) { member(b, first, "planar_die_actions_this_turn"); enc_map_PlayerId_u32(b, x.planar_die_actions_this_turn) }
	if !((x.scheme_deck.len == 0)) { member(b, first, "scheme_deck"); enc_PVec_ObjectId(b, x.scheme_deck) }
	if !(x.archenemy == nil) { member(b, first, "archenemy"); enc_opt_PlayerId(b, x.archenemy) }
	if !(x.horde_wave_remaining == 0) { member(b, first, "horde_wave_remaining"); encode_u32(b, x.horde_wave_remaining) }
	if !(x.horde_wave_nontokens_remaining == 0) { member(b, first, "horde_wave_nontokens_remaining"); encode_u32(b, x.horde_wave_nontokens_remaining) }
	if !(x.horde_turn_index == 0) { member(b, first, "horde_turn_index"); encode_u32(b, x.horde_turn_index) }
	if !((len(x.horde_postcombat_activation_queue) == 0)) { member(b, first, "horde_postcombat_activation_queue"); enc_dyn_ObjectId(b, x.horde_postcombat_activation_queue) }
	if !((len(x.horde_seats) == 0)) { member(b, first, "horde_seats"); enc_dyn_PlayerId(b, x.horde_seats) }
	if !(x.active_horde_index == 0) { member(b, first, "active_horde_index"); encode_int(b, x.active_horde_index) }
	if !((x.boss_deck.len == 0)) { member(b, first, "boss_deck"); enc_PVec_ObjectId(b, x.boss_deck) }
	if !(x.boss_stage == 0) { member(b, first, "boss_stage"); encode_u8(b, x.boss_stage) }
	if !((len(x.baxter_set_aside) == 0)) { member(b, first, "baxter_set_aside"); enc_dyn_ObjectId(b, x.baxter_set_aside) }
	if !(x.initiative == nil) { member(b, first, "initiative"); enc_opt_PlayerId(b, x.initiative) }
}

decode_GameAction :: proc(v: json.Value, out: ^GameAction) -> bool {
	when COVERAGE do cov_hit("GameAction")
	if v.kind != .Object do return fail("GameAction: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("GameAction: no tag")
	switch tv.text {
	case "PassPriority": when COVERAGE do cov_hit("GameAction::PassPriority"); out^ = GameAction_PassPriority{}
	case "ChooseMeldPair": when COVERAGE do cov_hit("GameAction::ChooseMeldPair");
		tmp: GameAction_ChooseMeldPair
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameAction_ChooseMeldPair) -> bool {
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("GameAction::ChooseMeldPair.source_id") } else { return fail("GameAction::ChooseMeldPair.source_id missing") }
	if fv, found := get_any(v, "partner_id"); found { if !decode_ObjectId(fv, &out.partner_id) do return fail("GameAction::ChooseMeldPair.partner_id") } else { return fail("GameAction::ChooseMeldPair.partner_id missing") }
	return true
		}) { return fail("GameAction::ChooseMeldPair") }
		out^ = tmp
	case "ChooseEntryAttackTarget": when COVERAGE do cov_hit("GameAction::ChooseEntryAttackTarget");
		tmp: GameAction_ChooseEntryAttackTarget
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameAction_ChooseEntryAttackTarget) -> bool {
	if fv, found := get_any(v, "target"); found { if !decode_AttackTarget(fv, &out.target) do return fail("GameAction::ChooseEntryAttackTarget.target") } else { return fail("GameAction::ChooseEntryAttackTarget.target missing") }
	return true
		}) { return fail("GameAction::ChooseEntryAttackTarget") }
		out^ = tmp
	case "PlayLand": when COVERAGE do cov_hit("GameAction::PlayLand");
		tmp: GameAction_PlayLand
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameAction_PlayLand) -> bool {
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("GameAction::PlayLand.object_id") } else { return fail("GameAction::PlayLand.object_id missing") }
	if fv, found := get_any(v, "card_id"); found { if !decode_CardId(fv, &out.card_id) do return fail("GameAction::PlayLand.card_id") } else { return fail("GameAction::PlayLand.card_id missing") }
	return true
		}) { return fail("GameAction::PlayLand") }
		out^ = tmp
	case "CastSpell": when COVERAGE do cov_hit("GameAction::CastSpell");
		tmp: GameAction_CastSpell
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameAction_CastSpell) -> bool {
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("GameAction::CastSpell.object_id") } else { return fail("GameAction::CastSpell.object_id missing") }
	if fv, found := get_any(v, "card_id"); found { if !decode_CardId(fv, &out.card_id) do return fail("GameAction::CastSpell.card_id") } else { return fail("GameAction::CastSpell.card_id missing") }
	if fv, found := get_any(v, "targets"); found { if !dec_dyn_ObjectId(fv, &out.targets) do return fail("GameAction::CastSpell.targets") } else { return fail("GameAction::CastSpell.targets missing") }
	if fv, found := get_any(v, "payment_mode"); found { if !decode_CastPaymentMode(fv, &out.payment_mode) do return fail("GameAction::CastSpell.payment_mode") }
	return true
		}) { return fail("GameAction::CastSpell") }
		out^ = tmp
	case "Foretell": when COVERAGE do cov_hit("GameAction::Foretell");
		tmp: GameAction_Foretell
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameAction_Foretell) -> bool {
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("GameAction::Foretell.object_id") } else { return fail("GameAction::Foretell.object_id missing") }
	if fv, found := get_any(v, "card_id"); found { if !decode_CardId(fv, &out.card_id) do return fail("GameAction::Foretell.card_id") } else { return fail("GameAction::Foretell.card_id missing") }
	return true
		}) { return fail("GameAction::Foretell") }
		out^ = tmp
	case "ActivateAbility": when COVERAGE do cov_hit("GameAction::ActivateAbility");
		tmp: GameAction_ActivateAbility
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameAction_ActivateAbility) -> bool {
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("GameAction::ActivateAbility.source_id") } else { return fail("GameAction::ActivateAbility.source_id missing") }
	if fv, found := get_any(v, "ability_index"); found { if !decode_int(fv, &out.ability_index) do return fail("GameAction::ActivateAbility.ability_index") } else { return fail("GameAction::ActivateAbility.ability_index missing") }
	if fv, found := get_any(v, "payment_mode"); found { if !decode_CastPaymentMode(fv, &out.payment_mode) do return fail("GameAction::ActivateAbility.payment_mode") }
	return true
		}) { return fail("GameAction::ActivateAbility") }
		out^ = tmp
	case "DeclareAttackers": when COVERAGE do cov_hit("GameAction::DeclareAttackers");
		tmp: GameAction_DeclareAttackers
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameAction_DeclareAttackers) -> bool {
	if fv, found := get_any(v, "attacks"); found { if !dec_dyn_t2_ObjectId_AttackTarget(fv, &out.attacks) do return fail("GameAction::DeclareAttackers.attacks") } else { return fail("GameAction::DeclareAttackers.attacks missing") }
	if fv, found := get_any(v, "bands"); found { if !dec_dyn_dyn_ObjectId(fv, &out.bands) do return fail("GameAction::DeclareAttackers.bands") }
	return true
		}) { return fail("GameAction::DeclareAttackers") }
		out^ = tmp
	case "DeclareBlockers": when COVERAGE do cov_hit("GameAction::DeclareBlockers");
		tmp: GameAction_DeclareBlockers
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameAction_DeclareBlockers) -> bool {
	if fv, found := get_any(v, "assignments"); found { if !dec_dyn_t2_ObjectId_ObjectId(fv, &out.assignments) do return fail("GameAction::DeclareBlockers.assignments") } else { return fail("GameAction::DeclareBlockers.assignments missing") }
	return true
		}) { return fail("GameAction::DeclareBlockers") }
		out^ = tmp
	case "ChooseUntap": when COVERAGE do cov_hit("GameAction::ChooseUntap");
		tmp: GameAction_ChooseUntap
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^GameAction_ChooseUntap) -> bool {
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("GameAction::ChooseUntap.object_id") } else { return fail("GameAction::ChooseUntap.object_id missing") }
