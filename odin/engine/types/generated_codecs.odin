	case BatchCompletion_ContraptionAssembleRemainder: strings.write_byte(b, '{'); json.write_string(b, "ContraptionAssembleRemainder"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
