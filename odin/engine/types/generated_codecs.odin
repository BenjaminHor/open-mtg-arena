decode_CostPaymentProhibition :: proc(v: json.Value, out: ^CostPaymentProhibition) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("CostPaymentProhibition: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("CostPaymentProhibition: not a string or object")
	}
	switch variant {
	case "PayLife": out^ = CostPaymentProhibition_PayLife{}
	case "Sacrifice":
		tmp: CostPaymentProhibition_Sacrifice
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^CostPaymentProhibition_Sacrifice) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("CostPaymentProhibition::Sacrifice.filter") } else { return fail("CostPaymentProhibition::Sacrifice.filter missing") }
	return true
		}) { return fail("CostPaymentProhibition::Sacrifice") }
		out^ = tmp
	case: return fail("CostPaymentProhibition: unknown variant")
	}
	return true
}

encode_CostPaymentProhibition :: proc(b: ^strings.Builder, x: CostPaymentProhibition) {
	#partial switch y in x {
	case CostPaymentProhibition_PayLife: _ = y; json.write_string(b, "PayLife")
	case CostPaymentProhibition_Sacrifice: strings.write_byte(b, '{'); json.write_string(b, "Sacrifice"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_RequiredDefender :: proc(v: json.Value, out: ^RequiredDefender) -> bool {
	if v.kind != .Object do return fail("RequiredDefender: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("RequiredDefender: no tag")
	switch tv.text {
	case "Fixed":
		tmp: RequiredDefender_Fixed
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^RequiredDefender_Fixed) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("RequiredDefender::Fixed.player") } else { return fail("RequiredDefender::Fixed.player missing") }
	return true
		}) { return fail("RequiredDefender::Fixed") }
		out^ = tmp
	case "Matching":
		tmp: RequiredDefender_Matching
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^RequiredDefender_Matching) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_PlayerFilter(fv, &out.filter) do return fail("RequiredDefender::Matching.filter") } else { return fail("RequiredDefender::Matching.filter missing") }
	return true
		}) { return fail("RequiredDefender::Matching") }
		out^ = tmp
	case "Permanent":
		tmp: RequiredDefender_Permanent
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^RequiredDefender_Permanent) -> bool {
	if fv, found := get_any(v, "permanent"); found { if !decode_ObjectIncarnationRef(fv, &out.permanent) do return fail("RequiredDefender::Permanent.permanent") } else { return fail("RequiredDefender::Permanent.permanent missing") }
	return true
		}) { return fail("RequiredDefender::Permanent") }
		out^ = tmp
	case: return fail("RequiredDefender: unknown variant")
	}
	return true
}

encode_RequiredDefender :: proc(b: ^strings.Builder, x: RequiredDefender) {
	#partial switch y in x {
	case RequiredDefender_Fixed: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Fixed")
	member(b, first, "player"); encode_PlayerId(b, y.player)
	}; strings.write_byte(b, '}')
	case RequiredDefender_Matching: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Matching")
	member(b, first, "filter"); encode_PlayerFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case RequiredDefender_Permanent: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Permanent")
	member(b, first, "permanent"); encode_ObjectIncarnationRef(b, y.permanent)
	}; strings.write_byte(b, '}')
	}
}

encode_RequiredDefender_members :: proc(b: ^strings.Builder, x: RequiredDefender, first: ^bool) {
	#partial switch y in x {
	case RequiredDefender_Fixed: member(b, first, "type"); json.write_string(b, "Fixed")
	member(b, first, "player"); encode_PlayerId(b, y.player)

	case RequiredDefender_Matching: member(b, first, "type"); json.write_string(b, "Matching")
	member(b, first, "filter"); encode_PlayerFilter(b, y.filter)

	case RequiredDefender_Permanent: member(b, first, "type"); json.write_string(b, "Permanent")
	member(b, first, "permanent"); encode_ObjectIncarnationRef(b, y.permanent)

	}
}

decode_CastExtraCost :: proc(v: json.Value, out: ^CastExtraCost) -> bool {
	if v.kind != .Object do return fail("CastExtraCost: not an object")
	if fv, found := get_any(v, "cost"); found { if !decode_AbilityCost(fv, &out.cost) do return fail("CastExtraCost.cost") } else { return fail("CastExtraCost.cost missing") }
	if fv, found := get_any(v, "mode"); found { if !decode_CastCostMode(fv, &out.mode) do return fail("CastExtraCost.mode") } else { return fail("CastExtraCost.mode missing") }
	return true
}

encode_CastExtraCost :: proc(b: ^strings.Builder, x: CastExtraCost) {
	strings.write_byte(b, '{')
	f := true
	encode_CastExtraCost_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CastExtraCost_members :: proc(b: ^strings.Builder, x: CastExtraCost, first: ^bool) {
	member(b, first, "cost"); encode_AbilityCost(b, x.cost)
	member(b, first, "mode"); encode_CastCostMode(b, x.mode)
}

