encode_TriggerMode :: proc(b: ^strings.Builder, x: TriggerMode) {
	#partial switch y in x {
	case TriggerMode_ChangesZone: _ = y; json.write_string(b, "ChangesZone")
	case TriggerMode_ChangesZoneAll: _ = y; json.write_string(b, "ChangesZoneAll")
	case TriggerMode_ChangesController: strings.write_byte(b, '{'); json.write_string(b, "ChangesController"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "side"); encode_ControlChangeSide(b, y.side)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerMode_LeavesBattlefield: _ = y; json.write_string(b, "LeavesBattlefield")
	case TriggerMode_DamageDone: _ = y; json.write_string(b, "DamageDone")
	case TriggerMode_DamageDoneOnce: _ = y; json.write_string(b, "DamageDoneOnce")
	case TriggerMode_DamageAll: _ = y; json.write_string(b, "DamageAll")
	case TriggerMode_DamageDealtOnce: _ = y; json.write_string(b, "DamageDealtOnce")
	case TriggerMode_DamageDoneOnceByController: _ = y; json.write_string(b, "DamageDoneOnceByController")
	case TriggerMode_DamageReceived: _ = y; json.write_string(b, "DamageReceived")
	case TriggerMode_DamagePreventedOnce: _ = y; json.write_string(b, "DamagePreventedOnce")
	case TriggerMode_ExcessDamage: _ = y; json.write_string(b, "ExcessDamage")
	case TriggerMode_ExcessDamageAll: _ = y; json.write_string(b, "ExcessDamageAll")
	case TriggerMode_SpellCast: _ = y; json.write_string(b, "SpellCast")
	case TriggerMode_SpellCopy: _ = y; json.write_string(b, "SpellCopy")
	case TriggerMode_SpellCastOrCopy: _ = y; json.write_string(b, "SpellCastOrCopy")
	case TriggerMode_AbilityCast: _ = y; json.write_string(b, "AbilityCast")
	case TriggerMode_AbilityResolves: _ = y; json.write_string(b, "AbilityResolves")
	case TriggerMode_AbilityTriggered: strings.write_byte(b, '{'); json.write_string(b, "AbilityTriggered"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "cause"); encode_TriggerCause(b, y.cause)
	member(b, first, "source"); encode_CausedAbilitySource(b, y.source)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerMode_SpellAbilityCast: _ = y; json.write_string(b, "SpellAbilityCast")
	case TriggerMode_SpellAbilityCopy: _ = y; json.write_string(b, "SpellAbilityCopy")
	case TriggerMode_Countered: _ = y; json.write_string(b, "Countered")
	case TriggerMode_Attacks: _ = y; json.write_string(b, "Attacks")
	case TriggerMode_AttackersDeclared: _ = y; json.write_string(b, "AttackersDeclared")
	case TriggerMode_YouAttack: _ = y; json.write_string(b, "YouAttack")
	case TriggerMode_YouAttackUnblocked: _ = y; json.write_string(b, "YouAttackUnblocked")
	case TriggerMode_AttackersDeclaredOneTarget: _ = y; json.write_string(b, "AttackersDeclaredOneTarget")
	case TriggerMode_AttackerBlocked: _ = y; json.write_string(b, "AttackerBlocked")
	case TriggerMode_AttackerBlockedOnce: _ = y; json.write_string(b, "AttackerBlockedOnce")
	case TriggerMode_AttackerBlockedByCreature: _ = y; json.write_string(b, "AttackerBlockedByCreature")
	case TriggerMode_AttackerUnblocked: _ = y; json.write_string(b, "AttackerUnblocked")
	case TriggerMode_AttackerUnblockedOnce: _ = y; json.write_string(b, "AttackerUnblockedOnce")
	case TriggerMode_Blocks: _ = y; json.write_string(b, "Blocks")
	case TriggerMode_BlockersDeclared: _ = y; json.write_string(b, "BlockersDeclared")
	case TriggerMode_BecomesBlocked: _ = y; json.write_string(b, "BecomesBlocked")
	case TriggerMode_CounterAdded: _ = y; json.write_string(b, "CounterAdded")
	case TriggerMode_CounterAddedOnce: _ = y; json.write_string(b, "CounterAddedOnce")
	case TriggerMode_CounterAddedAll: _ = y; json.write_string(b, "CounterAddedAll")
	case TriggerMode_CounterPlayerAddedAll: _ = y; json.write_string(b, "CounterPlayerAddedAll")
	case TriggerMode_CounterTypeAddedAll: _ = y; json.write_string(b, "CounterTypeAddedAll")
	case TriggerMode_CounterRemoved: _ = y; json.write_string(b, "CounterRemoved")
	case TriggerMode_CounterRemovedOnce: _ = y; json.write_string(b, "CounterRemovedOnce")
	case TriggerMode_Sacrificed: _ = y; json.write_string(b, "Sacrificed")
