decode_ResolutionPaymentTransaction :: proc(v: json.Value, out: ^ResolutionPaymentTransaction) -> bool {
	when COVERAGE do cov_hit("ResolutionPaymentTransaction")
	if v.kind != .Object do return fail("ResolutionPaymentTransaction: not an object")
	if fv, found := get_any(v, "wire_version"); found { if !decode_u32(fv, &out.wire_version) do return fail("ResolutionPaymentTransaction.wire_version") } else { out.wire_version = default_ResolutionPaymentTransaction_resolution_payment_transaction_wire_version() }
	if fv, found := get_any(v, "owner"); found { if !decode_PlayerId(fv, &out.owner) do return fail("ResolutionPaymentTransaction.owner") } else { return fail("ResolutionPaymentTransaction.owner missing") }
	if fv, found := get_any(v, "root"); found { if !dec_ptr_ResolvedAbility(fv, &out.root) do return fail("ResolutionPaymentTransaction.root") } else { return fail("ResolutionPaymentTransaction.root missing") }
	if fv, found := get_any(v, "transcript"); found { if !dec_dyn_ResolutionPaymentTranscriptEntry(fv, &out.transcript) do return fail("ResolutionPaymentTransaction.transcript") }
	if fv, found := get_any(v, "base_waiting_for"); found { if !decode_WaitingFor(fv, &out.base_waiting_for) do return fail("ResolutionPaymentTransaction.base_waiting_for") } else { return fail("ResolutionPaymentTransaction.base_waiting_for missing") }
	if fv, found := get_any(v, "resolving_trigger_context"); found { if !dec_opt_ResolvingTriggerContext(fv, &out.resolving_trigger_context) do return fail("ResolutionPaymentTransaction.resolving_trigger_context") }
	if fv, found := get_any(v, "recovered"); found { if !dec_ptr_PaymentRecoveryCheckpoint(fv, &out.recovered) do return fail("ResolutionPaymentTransaction.recovered") }
	return true
}

encode_ResolutionPaymentTransaction :: proc(b: ^strings.Builder, x: ResolutionPaymentTransaction) {
