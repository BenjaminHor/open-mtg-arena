decode_SacrificeRequirement :: proc(v: json.Value, out: ^SacrificeRequirement) -> bool {
	if v.kind != .Object do return fail("SacrificeRequirement: not an object")
	tv, found := json.get(v, "requirement")
	if !found || tv.kind != .String do return fail("SacrificeRequirement: no tag")
	switch tv.text {
	case "count":
		tmp: SacrificeRequirement_Count
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^SacrificeRequirement_Count) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("SacrificeRequirement::Count.count") } else { out.count = default_SacrificeRequirement_default_one() }
	return true
		}) { return fail("SacrificeRequirement::Count") }
		out^ = tmp
	case "aggregate":
		tmp: SacrificeRequirement_Aggregate
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^SacrificeRequirement_Aggregate) -> bool {
	if fv, found := get_any(v, "stat"); found { if !decode_SacrificeAggregateStat(fv, &out.stat) do return fail("SacrificeRequirement::Aggregate.stat") } else { return fail("SacrificeRequirement::Aggregate.stat missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("SacrificeRequirement::Aggregate.comparator") } else { return fail("SacrificeRequirement::Aggregate.comparator missing") }
	if fv, found := get_any(v, "value"); found { if !decode_i32(fv, &out.value) do return fail("SacrificeRequirement::Aggregate.value") } else { return fail("SacrificeRequirement::Aggregate.value missing") }
	return true
		}) { return fail("SacrificeRequirement::Aggregate") }
		out^ = tmp
	case "all": out^ = SacrificeRequirement_All{}
	case: return fail("SacrificeRequirement: unknown variant")
	}
	return true
}

encode_SacrificeRequirement :: proc(b: ^strings.Builder, x: SacrificeRequirement) {
	#partial switch y in x {
	case SacrificeRequirement_Count: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "requirement"); json.write_string(b, "count")
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}')
	case SacrificeRequirement_Aggregate: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "requirement"); json.write_string(b, "aggregate")
	member(b, first, "stat"); encode_SacrificeAggregateStat(b, y.stat)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_i32(b, y.value)
	}; strings.write_byte(b, '}')
	case SacrificeRequirement_All: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "requirement"); json.write_string(b, "all"); strings.write_byte(b, '}')
	}
}

encode_SacrificeRequirement_members :: proc(b: ^strings.Builder, x: SacrificeRequirement, first: ^bool) {
	#partial switch y in x {
	case SacrificeRequirement_Count: member(b, first, "requirement"); json.write_string(b, "count")
	member(b, first, "count"); encode_u32(b, y.count)

	case SacrificeRequirement_Aggregate: member(b, first, "requirement"); json.write_string(b, "aggregate")
	member(b, first, "stat"); encode_SacrificeAggregateStat(b, y.stat)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_i32(b, y.value)

	case SacrificeRequirement_All: _ = y; member(b, first, "requirement"); json.write_string(b, "all")
	}
}

