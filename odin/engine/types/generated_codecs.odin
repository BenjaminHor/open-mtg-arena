decode_ResolutionCastFacePolicy :: proc(v: json.Value, out: ^ResolutionCastFacePolicy) -> bool {
	if v.kind != .Object do return fail("ResolutionCastFacePolicy: not an object")
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("ResolutionCastFacePolicy.filter") } else { return fail("ResolutionCastFacePolicy.filter missing") }
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("ResolutionCastFacePolicy.source_id") } else { return fail("ResolutionCastFacePolicy.source_id missing") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("ResolutionCastFacePolicy.controller") } else { return fail("ResolutionCastFacePolicy.controller missing") }
	if fv, found := get_any(v, "constraint"); found { if !dec_opt_CastPermissionConstraint(fv, &out.constraint) do return fail("ResolutionCastFacePolicy.constraint") }
	if fv, found := get_any(v, "play_mode"); found { if !decode_CardPlayMode(fv, &out.play_mode) do return fail("ResolutionCastFacePolicy.play_mode") }
	return true
}

encode_ResolutionCastFacePolicy :: proc(b: ^strings.Builder, x: ResolutionCastFacePolicy) {
	strings.write_byte(b, '{')
	f := true
	encode_ResolutionCastFacePolicy_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ResolutionCastFacePolicy_members :: proc(b: ^strings.Builder, x: ResolutionCastFacePolicy, first: ^bool) {
	member(b, first, "filter"); encode_TargetFilter(b, x.filter)
	member(b, first, "source_id"); encode_ObjectId(b, x.source_id)
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	member(b, first, "constraint"); enc_opt_CastPermissionConstraint(b, x.constraint)
	if !(skip_ResolutionCastFacePolicy_CardPlayMode_is_cast(x.play_mode)) { member(b, first, "play_mode"); encode_CardPlayMode(b, x.play_mode) }
}

