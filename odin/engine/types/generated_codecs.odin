decode_ModalSelectionConstraint :: proc(v: json.Value, out: ^ModalSelectionConstraint) -> bool {
	if v.kind != .Object do return fail("ModalSelectionConstraint: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ModalSelectionConstraint: no tag")
	switch tv.text {
	case "DifferentTargetPlayers": out^ = ModalSelectionConstraint_DifferentTargetPlayers{}
	case "ConditionalMaxChoices":
		tmp: ModalSelectionConstraint_ConditionalMaxChoices
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ModalSelectionConstraint_ConditionalMaxChoices) -> bool {
	if fv, found := get_any(v, "condition"); found { if !decode_ModalSelectionCondition(fv, &out.condition) do return fail("ModalSelectionConstraint::ConditionalMaxChoices.condition") } else { return fail("ModalSelectionConstraint::ConditionalMaxChoices.condition missing") }
	if fv, found := get_any(v, "max_choices"); found { if !decode_int(fv, &out.max_choices) do return fail("ModalSelectionConstraint::ConditionalMaxChoices.max_choices") } else { return fail("ModalSelectionConstraint::ConditionalMaxChoices.max_choices missing") }
	if fv, found := get_any(v, "otherwise_max_choices"); found { if !decode_int(fv, &out.otherwise_max_choices) do return fail("ModalSelectionConstraint::ConditionalMaxChoices.otherwise_max_choices") } else { return fail("ModalSelectionConstraint::ConditionalMaxChoices.otherwise_max_choices missing") }
	return true
		}) { return fail("ModalSelectionConstraint::ConditionalMaxChoices") }
		out^ = tmp
	case "NoRepeatThisTurn": out^ = ModalSelectionConstraint_NoRepeatThisTurn{}
	case "NoRepeatThisGame": out^ = ModalSelectionConstraint_NoRepeatThisGame{}
	case: return fail("ModalSelectionConstraint: unknown variant")
	}
	return true
}

encode_ModalSelectionConstraint :: proc(b: ^strings.Builder, x: ModalSelectionConstraint) {
	#partial switch y in x {
	case ModalSelectionConstraint_DifferentTargetPlayers: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DifferentTargetPlayers"); strings.write_byte(b, '}')
	case ModalSelectionConstraint_ConditionalMaxChoices: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ConditionalMaxChoices")
	member(b, first, "condition"); encode_ModalSelectionCondition(b, y.condition)
	member(b, first, "max_choices"); encode_int(b, y.max_choices)
	member(b, first, "otherwise_max_choices"); encode_int(b, y.otherwise_max_choices)
	}; strings.write_byte(b, '}')
	case ModalSelectionConstraint_NoRepeatThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NoRepeatThisTurn"); strings.write_byte(b, '}')
	case ModalSelectionConstraint_NoRepeatThisGame: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NoRepeatThisGame"); strings.write_byte(b, '}')
	}
}

encode_ModalSelectionConstraint_members :: proc(b: ^strings.Builder, x: ModalSelectionConstraint, first: ^bool) {
	#partial switch y in x {
	case ModalSelectionConstraint_DifferentTargetPlayers: _ = y; member(b, first, "type"); json.write_string(b, "DifferentTargetPlayers")
	case ModalSelectionConstraint_ConditionalMaxChoices: member(b, first, "type"); json.write_string(b, "ConditionalMaxChoices")
	member(b, first, "condition"); encode_ModalSelectionCondition(b, y.condition)
	member(b, first, "max_choices"); encode_int(b, y.max_choices)
	member(b, first, "otherwise_max_choices"); encode_int(b, y.otherwise_max_choices)

	case ModalSelectionConstraint_NoRepeatThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "NoRepeatThisTurn")
	case ModalSelectionConstraint_NoRepeatThisGame: _ = y; member(b, first, "type"); json.write_string(b, "NoRepeatThisGame")
	}
}

