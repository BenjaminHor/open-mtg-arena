encode_ActiveInteractionSlot :: proc(b: ^strings.Builder, x: ActiveInteractionSlot) {
	strings.write_byte(b, '{')
	f := true
	encode_ActiveInteractionSlot_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ActiveInteractionSlot_members :: proc(b: ^strings.Builder, x: ActiveInteractionSlot, first: ^bool) {
	member(b, first, "semanticOwner"); encode_u8(b, x.semantic_owner)
	member(b, first, "slotKind"); encode_InteractionSlotKind(b, x.slot_kind)
	member(b, first, "interactionId"); encode_InteractionId(b, x.interaction_id)
}

decode_PendingReplacement :: proc(v: json.Value, out: ^PendingReplacement) -> bool {
	when COVERAGE do cov_hit("PendingReplacement")
	if v.kind != .Object do return fail("PendingReplacement: not an object")
	if fv, found := get_any(v, "proposed"); found { if !decode_ProposedEvent(fv, &out.proposed) do return fail("PendingReplacement.proposed") } else { return fail("PendingReplacement.proposed missing") }
	if fv, found := get_any(v, "settled_damage_guards"); found { if !dec_dyn_SettledDamageGuard(fv, &out.settled_damage_guards) do return fail("PendingReplacement.settled_damage_guards") }
	if fv, found := get_any(v, "sacrifice_provenance"); found { if !dec_opt_PendingSacrificeProvenance(fv, &out.sacrifice_provenance) do return fail("PendingReplacement.sacrifice_provenance") }
	if fv, found := get_any(v, "candidates"); found { if !dec_dyn_ReplacementId(fv, &out.candidates) do return fail("PendingReplacement.candidates") } else { return fail("PendingReplacement.candidates missing") }
	if fv, found := get_any(v, "ordering_peers"); found { if !dec_dyn_ReplacementId(fv, &out.ordering_peers) do return fail("PendingReplacement.ordering_peers") }
	if fv, found := get_any(v, "search_found_candidates"); found { if !dec_dyn_BoundSearchFoundCandidate(fv, &out.search_found_candidates) do return fail("PendingReplacement.search_found_candidates") }
	if fv, found := get_any(v, "depth"); found { if !decode_u16(fv, &out.depth) do return fail("PendingReplacement.depth") } else { return fail("PendingReplacement.depth missing") }
	if fv, found := get_any(v, "is_optional"); found { if !decode_bool(fv, &out.is_optional) do return fail("PendingReplacement.is_optional") }
	if fv, found := get_any(v, "choice_player"); found { if !dec_opt_PlayerId(fv, &out.choice_player) do return fail("PendingReplacement.choice_player") }
	if fv, found := get_any(v, "exile_controller"); found { if !dec_opt_PlayerId(fv, &out.exile_controller) do return fail("PendingReplacement.exile_controller") }
	if fv, found := get_any(v, "exile_duration"); found { if !dec_opt_Duration(fv, &out.exile_duration) do return fail("PendingReplacement.exile_duration") }
	if fv, found := get_any(v, "exile_tracking"); found { if !decode_ZoneDeliveryExileTracking(fv, &out.exile_tracking) do return fail("PendingReplacement.exile_tracking") }
	if fv, found := get_any(v, "excess_recipient"); found { if !dec_opt_ExcessRecipient(fv, &out.excess_recipient) do return fail("PendingReplacement.excess_recipient") }
	if fv, found := get_any(v, "lifelink_bonus"); found { if !decode_u32(fv, &out.lifelink_bonus) do return fail("PendingReplacement.lifelink_bonus") }
	if fv, found := get_any(v, "source_incarnation"); found { if !dec_opt_u64(fv, &out.source_incarnation) do return fail("PendingReplacement.source_incarnation") }
	if fv, found := get_any(v, "may_cost_paid"); found { if !decode_bool(fv, &out.may_cost_paid) do return fail("PendingReplacement.may_cost_paid") }
	if fv, found := get_any(v, "may_cost_remaining"); found { if !dec_opt_AbilityCost(fv, &out.may_cost_remaining) do return fail("PendingReplacement.may_cost_remaining") }
	if fv, found := get_any(v, "delivery_boundary"); found { if !dec_ptr_ProposedEvent(fv, &out.delivery_boundary) do return fail("PendingReplacement.delivery_boundary") }
	if fv, found := get_any(v, "unrepresentable_life_change"); found { if !decode_UnrepresentablePolicy(fv, &out.unrepresentable_life_change) do return fail("PendingReplacement.unrepresentable_life_change") } else { out.unrepresentable_life_change = UnrepresentablePolicy.IgnoreImpossible }
	return true
}

encode_PendingReplacement :: proc(b: ^strings.Builder, x: PendingReplacement) {
	strings.write_byte(b, '{')
	f := true
	encode_PendingReplacement_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PendingReplacement_members :: proc(b: ^strings.Builder, x: PendingReplacement, first: ^bool) {
	member(b, first, "proposed"); encode_ProposedEvent(b, x.proposed)
	if !((len(x.settled_damage_guards) == 0)) { member(b, first, "settled_damage_guards"); enc_dyn_SettledDamageGuard(b, x.settled_damage_guards) }
	if !(x.sacrifice_provenance == nil) { member(b, first, "sacrifice_provenance"); enc_opt_PendingSacrificeProvenance(b, x.sacrifice_provenance) }
	member(b, first, "candidates"); enc_dyn_ReplacementId(b, x.candidates)
	if !((len(x.ordering_peers) == 0)) { member(b, first, "ordering_peers"); enc_dyn_ReplacementId(b, x.ordering_peers) }
	if !((len(x.search_found_candidates) == 0)) { member(b, first, "search_found_candidates"); enc_dyn_BoundSearchFoundCandidate(b, x.search_found_candidates) }
	member(b, first, "depth"); encode_u16(b, x.depth)
	member(b, first, "is_optional"); encode_bool(b, x.is_optional)
	if !(x.choice_player == nil) { member(b, first, "choice_player"); enc_opt_PlayerId(b, x.choice_player) }
	member(b, first, "exile_controller"); enc_opt_PlayerId(b, x.exile_controller)
	member(b, first, "exile_duration"); enc_opt_Duration(b, x.exile_duration)
	member(b, first, "exile_tracking"); encode_ZoneDeliveryExileTracking(b, x.exile_tracking)
	member(b, first, "excess_recipient"); enc_opt_ExcessRecipient(b, x.excess_recipient)
	member(b, first, "lifelink_bonus"); encode_u32(b, x.lifelink_bonus)
	if !(x.source_incarnation == nil) { member(b, first, "source_incarnation"); enc_opt_u64(b, x.source_incarnation) }
	if !(!x.may_cost_paid) { member(b, first, "may_cost_paid"); encode_bool(b, x.may_cost_paid) }
	if !(x.may_cost_remaining == nil) { member(b, first, "may_cost_remaining"); enc_opt_AbilityCost(b, x.may_cost_remaining) }
	if !(x.delivery_boundary == nil) { member(b, first, "delivery_boundary"); enc_ptr_ProposedEvent(b, x.delivery_boundary) }
	if !(skip_PendingReplacement_UnrepresentablePolicy_is_ignore_impossible_UnrepresentablePolicy(x.unrepresentable_life_change)) { member(b, first, "unrepresentable_life_change"); encode_UnrepresentablePolicy(b, x.unrepresentable_life_change) }
}

decode_PendingCombatLifelink :: proc(v: json.Value, out: ^PendingCombatLifelink) -> bool {
	when COVERAGE do cov_hit("PendingCombatLifelink")
	if v.kind != .Object do return fail("PendingCombatLifelink: not an object")
	if fv, found := get_any(v, "remaining"); found { if !dec_dyn_PendingLifelinkGain(fv, &out.remaining) do return fail("PendingCombatLifelink.remaining") } else { return fail("PendingCombatLifelink.remaining missing") }
	if fv, found := get_any(v, "staged_gains"); found { if !dec_dyn_PendingLifelinkGain(fv, &out.staged_gains) do return fail("PendingCombatLifelink.staged_gains") }
	if fv, found := get_any(v, "awaiting_staged_gain"); found { if !decode_bool(fv, &out.awaiting_staged_gain) do return fail("PendingCombatLifelink.awaiting_staged_gain") }
	if fv, found := get_any(v, "batch_events"); found { if !dec_dyn_GameEvent(fv, &out.batch_events) do return fail("PendingCombatLifelink.batch_events") } else { return fail("PendingCombatLifelink.batch_events missing") }
	if fv, found := get_any(v, "damage_to_players"); found { if !dec_dyn_GameEvent(fv, &out.damage_to_players) do return fail("PendingCombatLifelink.damage_to_players") } else { return fail("PendingCombatLifelink.damage_to_players missing") }
	if fv, found := get_any(v, "prevention_tally"); found { if !dec_dyn_PreventedDamageEntry(fv, &out.prevention_tally) do return fail("PendingCombatLifelink.prevention_tally") } else { return fail("PendingCombatLifelink.prevention_tally missing") }
	if fv, found := get_any(v, "sub_step"); found { if !decode_CombatDamageSubStep(fv, &out.sub_step) do return fail("PendingCombatLifelink.sub_step") } else { return fail("PendingCombatLifelink.sub_step missing") }
	if fv, found := get_any(v, "replacement"); found { if !dec_opt_PendingCombatDamageReplacement(fv, &out.replacement) do return fail("PendingCombatLifelink.replacement") }
	if fv, found := get_any(v, "phase_c_remnant"); found { if !dec_opt_PendingCombatPhaseCRemnant(fv, &out.phase_c_remnant) do return fail("PendingCombatLifelink.phase_c_remnant") }
	return true
}

encode_PendingCombatLifelink :: proc(b: ^strings.Builder, x: PendingCombatLifelink) {
	strings.write_byte(b, '{')
	f := true
	encode_PendingCombatLifelink_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PendingCombatLifelink_members :: proc(b: ^strings.Builder, x: PendingCombatLifelink, first: ^bool) {
	member(b, first, "remaining"); enc_dyn_PendingLifelinkGain(b, x.remaining)
	if !((len(x.staged_gains) == 0)) { member(b, first, "staged_gains"); enc_dyn_PendingLifelinkGain(b, x.staged_gains) }
	if !(!x.awaiting_staged_gain) { member(b, first, "awaiting_staged_gain"); encode_bool(b, x.awaiting_staged_gain) }
	member(b, first, "batch_events"); enc_dyn_GameEvent(b, x.batch_events)
	member(b, first, "damage_to_players"); enc_dyn_GameEvent(b, x.damage_to_players)
	member(b, first, "prevention_tally"); enc_dyn_PreventedDamageEntry(b, x.prevention_tally)
	member(b, first, "sub_step"); encode_CombatDamageSubStep(b, x.sub_step)
	if !(x.replacement == nil) { member(b, first, "replacement"); enc_opt_PendingCombatDamageReplacement(b, x.replacement) }
	if !(x.phase_c_remnant == nil) { member(b, first, "phase_c_remnant"); enc_opt_PendingCombatPhaseCRemnant(b, x.phase_c_remnant) }
}

decode_LiminalEntry :: proc(v: json.Value, out: ^LiminalEntry) -> bool {
	when COVERAGE do cov_hit("LiminalEntry")
	if v.kind != .Object do return fail("LiminalEntry: not an object")
	if fv, found := get_any(v, "object"); found { if !decode_LiminalEntrant(fv, &out.object) do return fail("LiminalEntry.object") } else { return fail("LiminalEntry.object missing") }
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("LiminalEntry.name") } else { return fail("LiminalEntry.name missing") }
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("LiminalEntry.source_id") } else { return fail("LiminalEntry.source_id missing") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("LiminalEntry.controller") } else { return fail("LiminalEntry.controller missing") }
	if fv, found := get_any(v, "enters_attacking"); found { if !decode_bool(fv, &out.enters_attacking) do return fail("LiminalEntry.enters_attacking") } else { return fail("LiminalEntry.enters_attacking missing") }
	if fv, found := get_any(v, "attack_destination"); found { if !decode_EntryAttackDestination(fv, &out.attack_destination) do return fail("LiminalEntry.attack_destination") } else { out.attack_destination = EntryAttackDestination(EntryAttackDestination_AnyDefender{}) }
	if fv, found := get_any(v, "attach_to"); found { if !dec_opt_AttachTarget(fv, &out.attach_to) do return fail("LiminalEntry.attach_to") }
	if fv, found := get_any(v, "sacrifice_at"); found { if !dec_opt_Duration(fv, &out.sacrifice_at) do return fail("LiminalEntry.sacrifice_at") }
	if fv, found := get_any(v, "remaining_count"); found { if !decode_u32(fv, &out.remaining_count) do return fail("LiminalEntry.remaining_count") } else { return fail("LiminalEntry.remaining_count missing") }
	if fv, found := get_any(v, "created_ids"); found { if !dec_dyn_ObjectId(fv, &out.created_ids) do return fail("LiminalEntry.created_ids") } else { return fail("LiminalEntry.created_ids missing") }
	if fv, found := get_any(v, "copy_resume"); found { if !dec_ptr_CopyTokenSpec(fv, &out.copy_resume) do return fail("LiminalEntry.copy_resume") }
	if fv, found := get_any(v, "spec_resume"); found { if !dec_ptr_TokenSpec(fv, &out.spec_resume) do return fail("LiminalEntry.spec_resume") }
	if fv, found := get_any(v, "enter_tapped"); found { if !decode_EtbTapState(fv, &out.enter_tapped) do return fail("LiminalEntry.enter_tapped") } else { return fail("LiminalEntry.enter_tapped missing") }
	if fv, found := get_any(v, "enter_with_counters"); found { if !dec_dyn_t2_CounterType_u32(fv, &out.enter_with_counters) do return fail("LiminalEntry.enter_with_counters") } else { return fail("LiminalEntry.enter_with_counters missing") }
	if fv, found := get_any(v, "kind"); found { if !decode_LiminalEntryKind(fv, &out.kind) do return fail("LiminalEntry.kind") } else { out.kind = LiminalEntryKind(LiminalEntryKind_Token{}) }
	if fv, found := get_any(v, "replacement_applied"); found { if !dec_dyn_AppliedReplacementKey(fv, &out.replacement_applied) do return fail("LiminalEntry.replacement_applied") }
	if fv, found := get_any(v, "copy_settlement"); found { if !dec_ptr_TokenCopySettlement(fv, &out.copy_settlement) do return fail("LiminalEntry.copy_settlement") }
	return true
}

encode_LiminalEntry :: proc(b: ^strings.Builder, x: LiminalEntry) {
	strings.write_byte(b, '{')
	f := true
	encode_LiminalEntry_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_LiminalEntry_members :: proc(b: ^strings.Builder, x: LiminalEntry, first: ^bool) {
	member(b, first, "object"); encode_LiminalEntrant(b, x.object)
	member(b, first, "name"); encode_string(b, x.name)
	member(b, first, "source_id"); encode_ObjectId(b, x.source_id)
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	member(b, first, "enters_attacking"); encode_bool(b, x.enters_attacking)
	if !(skip_LiminalEntry_EntryAttackDestination_is_any_defender_EntryAttackDestination(x.attack_destination)) { member(b, first, "attack_destination"); encode_EntryAttackDestination(b, x.attack_destination) }
	member(b, first, "attach_to"); enc_opt_AttachTarget(b, x.attach_to)
	member(b, first, "sacrifice_at"); enc_opt_Duration(b, x.sacrifice_at)
	member(b, first, "remaining_count"); encode_u32(b, x.remaining_count)
	member(b, first, "created_ids"); enc_dyn_ObjectId(b, x.created_ids)
	member(b, first, "copy_resume"); enc_ptr_CopyTokenSpec(b, x.copy_resume)
	member(b, first, "spec_resume"); enc_ptr_TokenSpec(b, x.spec_resume)
	member(b, first, "enter_tapped"); encode_EtbTapState(b, x.enter_tapped)
	member(b, first, "enter_with_counters"); enc_dyn_t2_CounterType_u32(b, x.enter_with_counters)
	member(b, first, "kind"); encode_LiminalEntryKind(b, x.kind)
	if !((len(x.replacement_applied) == 0)) { member(b, first, "replacement_applied"); enc_dyn_AppliedReplacementKey(b, x.replacement_applied) }
	if !(x.copy_settlement == nil) { member(b, first, "copy_settlement"); enc_ptr_TokenCopySettlement(b, x.copy_settlement) }
}

decode_PendingLiminalEntryResume :: proc(v: json.Value, out: ^PendingLiminalEntryResume) -> bool {
	when COVERAGE do cov_hit("PendingLiminalEntryResume")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("PendingLiminalEntryResume: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("PendingLiminalEntryResume: not a string or object")
	}
	switch variant {
	case "Token": when COVERAGE do cov_hit("PendingLiminalEntryResume::Token");
		tmp: PendingLiminalEntryResume_Token
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^PendingLiminalEntryResume_Token) -> bool {
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("PendingLiminalEntryResume::Token.source_id") } else { return fail("PendingLiminalEntryResume::Token.source_id missing") }
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("PendingLiminalEntryResume::Token.player") } else { return fail("PendingLiminalEntryResume::Token.player missing") }
	if fv, found := get_any(v, "event"); found { if !decode_ProposedEvent(fv, &out.event) do return fail("PendingLiminalEntryResume::Token.event") } else { return fail("PendingLiminalEntryResume::Token.event missing") }
	return true
		}) { return fail("PendingLiminalEntryResume::Token") }
		out^ = tmp
	case "Meld": when COVERAGE do cov_hit("PendingLiminalEntryResume::Meld");
		tmp: PendingLiminalEntryResume_Meld
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^PendingLiminalEntryResume_Meld) -> bool {
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("PendingLiminalEntryResume::Meld.source_id") } else { return fail("PendingLiminalEntryResume::Meld.source_id missing") }
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("PendingLiminalEntryResume::Meld.player") } else { return fail("PendingLiminalEntryResume::Meld.player missing") }
	if fv, found := get_any(v, "context"); found { if !decode_MeldSelection(fv, &out.context_) do return fail("PendingLiminalEntryResume::Meld.context") } else { return fail("PendingLiminalEntryResume::Meld.context missing") }
	if fv, found := get_any(v, "attack_target"); found { if !dec_opt_AttackTarget(fv, &out.attack_target) do return fail("PendingLiminalEntryResume::Meld.attack_target") }
	return true
		}) { return fail("PendingLiminalEntryResume::Meld") }
		out^ = tmp
	case: return fail("PendingLiminalEntryResume: unknown variant")
	}
	return true
}

encode_PendingLiminalEntryResume :: proc(b: ^strings.Builder, x: PendingLiminalEntryResume) {
	#partial switch y in x {
	case PendingLiminalEntryResume_Token: strings.write_byte(b, '{'); json.write_string(b, "Token"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "event"); encode_ProposedEvent(b, y.event)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PendingLiminalEntryResume_Meld: strings.write_byte(b, '{'); json.write_string(b, "Meld"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source_id"); encode_ObjectId(b, y.source_id)
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "context"); encode_MeldSelection(b, y.context_)
	if !(y.attack_target == nil) { member(b, first, "attack_target"); enc_opt_AttackTarget(b, y.attack_target) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

