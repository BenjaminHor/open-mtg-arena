	if fv, found := get_any(v, "ticket_cost"); found { if !decode_u8(fv, &out.ticket_cost) do return fail("AppliedSticker::PowerToughness.ticket_cost") } else { return fail("AppliedSticker::PowerToughness.ticket_cost missing") }
	if fv, found := get_any(v, "power"); found { if !decode_i32(fv, &out.power) do return fail("AppliedSticker::PowerToughness.power") } else { return fail("AppliedSticker::PowerToughness.power missing") }
	if fv, found := get_any(v, "toughness"); found { if !decode_i32(fv, &out.toughness) do return fail("AppliedSticker::PowerToughness.toughness") } else { return fail("AppliedSticker::PowerToughness.toughness missing") }
	if fv, found := get_any(v, "timestamp"); found { if !decode_u64(fv, &out.timestamp) do return fail("AppliedSticker::PowerToughness.timestamp") } else { return fail("AppliedSticker::PowerToughness.timestamp missing") }
	return true
		}) { return fail("AppliedSticker::PowerToughness") }
		out^ = tmp
	case "Art":
		tmp: AppliedSticker_Art
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AppliedSticker_Art) -> bool {
	if fv, found := get_any(v, "locator"); found { if !decode_StickerLocator(fv, &out.locator) do return fail("AppliedSticker::Art.locator") } else { return fail("AppliedSticker::Art.locator missing") }
	if fv, found := get_any(v, "label"); found { if !decode_string(fv, &out.label) do return fail("AppliedSticker::Art.label") } else { return fail("AppliedSticker::Art.label missing") }
	if fv, found := get_any(v, "timestamp"); found { if !decode_u64(fv, &out.timestamp) do return fail("AppliedSticker::Art.timestamp") } else { return fail("AppliedSticker::Art.timestamp missing") }
	return true
		}) { return fail("AppliedSticker::Art") }
		out^ = tmp
	case: return fail("AppliedSticker: unknown variant")
	}
	return true
}

encode_AppliedSticker :: proc(b: ^strings.Builder, x: AppliedSticker) {
	#partial switch y in x {
	case AppliedSticker_Name: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Name")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "text"); encode_string(b, y.text)
	member(b, first, "position"); encode_u8(b, y.position)
	member(b, first, "timestamp"); encode_u64(b, y.timestamp)
	}; strings.write_byte(b, '}')
	case AppliedSticker_Ability: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Ability")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "ticket_cost"); encode_u8(b, y.ticket_cost)
	member(b, first, "text"); encode_string(b, y.text)
	member(b, first, "timestamp"); encode_u64(b, y.timestamp)
	}; strings.write_byte(b, '}')
	case AppliedSticker_PowerToughness: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PowerToughness")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "ticket_cost"); encode_u8(b, y.ticket_cost)
	member(b, first, "power"); encode_i32(b, y.power)
	member(b, first, "toughness"); encode_i32(b, y.toughness)
	member(b, first, "timestamp"); encode_u64(b, y.timestamp)
	}; strings.write_byte(b, '}')
	case AppliedSticker_Art: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Art")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "label"); encode_string(b, y.label)
	member(b, first, "timestamp"); encode_u64(b, y.timestamp)
	}; strings.write_byte(b, '}')
	}
}

encode_AppliedSticker_members :: proc(b: ^strings.Builder, x: AppliedSticker, first: ^bool) {
	#partial switch y in x {
	case AppliedSticker_Name: member(b, first, "type"); json.write_string(b, "Name")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "text"); encode_string(b, y.text)
	member(b, first, "position"); encode_u8(b, y.position)
	member(b, first, "timestamp"); encode_u64(b, y.timestamp)

	case AppliedSticker_Ability: member(b, first, "type"); json.write_string(b, "Ability")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "ticket_cost"); encode_u8(b, y.ticket_cost)
	member(b, first, "text"); encode_string(b, y.text)
	member(b, first, "timestamp"); encode_u64(b, y.timestamp)

	case AppliedSticker_PowerToughness: member(b, first, "type"); json.write_string(b, "PowerToughness")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "ticket_cost"); encode_u8(b, y.ticket_cost)
	member(b, first, "power"); encode_i32(b, y.power)
	member(b, first, "toughness"); encode_i32(b, y.toughness)
	member(b, first, "timestamp"); encode_u64(b, y.timestamp)

	case AppliedSticker_Art: member(b, first, "type"); json.write_string(b, "Art")
	member(b, first, "locator"); encode_StickerLocator(b, y.locator)
	member(b, first, "label"); encode_string(b, y.label)
	member(b, first, "timestamp"); encode_u64(b, y.timestamp)

	}
}

decode_CastingPermission :: proc(v: json.Value, out: ^CastingPermission) -> bool {
	if v.kind != .Object do return fail("CastingPermission: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("CastingPermission: no tag")
	switch tv.text {
	case "AdventureCreature": out^ = CastingPermission_AdventureCreature{}
	case "ExileWithAltCost":
		tmp: CastingPermission_ExileWithAltCost
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CastingPermission_ExileWithAltCost) -> bool {
	if fv, found := get_any(v, "cost"); found { if !decode_ManaCost(fv, &out.cost) do return fail("CastingPermission::ExileWithAltCost.cost") } else { return fail("CastingPermission::ExileWithAltCost.cost missing") }
	if fv, found := get_any(v, "cost_provenance"); found { if !decode_ExileGrantCostProvenance(fv, &out.cost_provenance) do return fail("CastingPermission::ExileWithAltCost.cost_provenance") }
	if fv, found := get_any(v, "cast_transformed"); found { if !decode_bool(fv, &out.cast_transformed) do return fail("CastingPermission::ExileWithAltCost.cast_transformed") }
	if fv, found := get_any(v, "constraint"); found { if !dec_opt_CastPermissionConstraint(fv, &out.constraint) do return fail("CastingPermission::ExileWithAltCost.constraint") }
	if fv, found := get_any(v, "granted_to"); found { if !dec_opt_PlayerId(fv, &out.granted_to) do return fail("CastingPermission::ExileWithAltCost.granted_to") }
	if fv, found := get_any(v, "resolution_cleanup"); found { if !dec_opt_ResolutionCastCleanup(fv, &out.resolution_cleanup) do return fail("CastingPermission::ExileWithAltCost.resolution_cleanup") }
	if fv, found := get_any(v, "duration"); found { if !dec_opt_Duration(fv, &out.duration) do return fail("CastingPermission::ExileWithAltCost.duration") }
	if fv, found := get_any(v, "source_id"); found { if !dec_opt_ObjectId(fv, &out.source_id) do return fail("CastingPermission::ExileWithAltCost.source_id") }
	if fv, found := get_any(v, "graveyard_replacement", "exile_instead_of_graveyard_on_resolve"); found { if !dec_opt_SpellStackToGraveyardReplacement(fv, &out.graveyard_replacement) do return fail("CastingPermission::ExileWithAltCost.graveyard_replacement") }
	if fv, found := get_any(v, "enters_with_counter"); found { if !dec_opt_CounterType(fv, &out.enters_with_counter) do return fail("CastingPermission::ExileWithAltCost.enters_with_counter") }
	if fv, found := get_any(v, "enters_with_modifications"); found { if !decode_PendingEntersModifications(fv, &out.enters_with_modifications) do return fail("CastingPermission::ExileWithAltCost.enters_with_modifications") }
	if fv, found := get_any(v, "mana_spend_permission"); found { if !dec_opt_ManaSpendPermission(fv, &out.mana_spend_permission) do return fail("CastingPermission::ExileWithAltCost.mana_spend_permission") }
	if fv, found := get_any(v, "cast_cost_modifier"); found { if !dec_opt_CastCostModifier(fv, &out.cast_cost_modifier) do return fail("CastingPermission::ExileWithAltCost.cast_cost_modifier") }
	return true
		}) { return fail("CastingPermission::ExileWithAltCost") }
		out^ = tmp
	case "PlayFromExile":
		tmp: CastingPermission_PlayFromExile
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CastingPermission_PlayFromExile) -> bool {
	if fv, found := get_any(v, "duration"); found { if !decode_Duration(fv, &out.duration) do return fail("CastingPermission::PlayFromExile.duration") } else { return fail("CastingPermission::PlayFromExile.duration missing") }
	if fv, found := get_any(v, "granted_to"); found { if !decode_PlayerId(fv, &out.granted_to) do return fail("CastingPermission::PlayFromExile.granted_to") } else { return fail("CastingPermission::PlayFromExile.granted_to missing") }
	if fv, found := get_any(v, "mode"); found { if !decode_CardPlayMode(fv, &out.mode) do return fail("CastingPermission::PlayFromExile.mode") } else { out.mode = default_CastingPermission_play_from_exile_mode_default() }
	if fv, found := get_any(v, "frequency"); found { if !decode_CastFrequency(fv, &out.frequency) do return fail("CastingPermission::PlayFromExile.frequency") }
	if fv, found := get_any(v, "source_id"); found { if !dec_opt_ObjectId(fv, &out.source_id) do return fail("CastingPermission::PlayFromExile.source_id") }
	if fv, found := get_any(v, "exiled_by_ability_controller"); found { if !dec_opt_PlayerId(fv, &out.exiled_by_ability_controller) do return fail("CastingPermission::PlayFromExile.exiled_by_ability_controller") }
	if fv, found := get_any(v, "mana_spend_permission"); found { if !dec_opt_ManaSpendPermission(fv, &out.mana_spend_permission) do return fail("CastingPermission::PlayFromExile.mana_spend_permission") }
	if fv, found := get_any(v, "card_filter"); found { if !dec_opt_TargetFilter(fv, &out.card_filter) do return fail("CastingPermission::PlayFromExile.card_filter") }
	if fv, found := get_any(v, "single_use_group"); found { if !dec_opt_TrackedSetId(fv, &out.single_use_group) do return fail("CastingPermission::PlayFromExile.single_use_group") }
	if fv, found := get_any(v, "single_use"); found { if !decode_bool(fv, &out.single_use) do return fail("CastingPermission::PlayFromExile.single_use") }
	if fv, found := get_any(v, "cast_cost_modifier", "cast_cost_raise"); found { if !dec_opt_CastCostModifier(fv, &out.cast_cost_modifier) do return fail("CastingPermission::PlayFromExile.cast_cost_modifier") }
	if fv, found := get_any(v, "alt_ability_cost"); found { if !dec_opt_AbilityCost(fv, &out.alt_ability_cost) do return fail("CastingPermission::PlayFromExile.alt_ability_cost") }
	if fv, found := get_any(v, "without_paying_mana_cost"); found { if !decode_bool(fv, &out.without_paying_mana_cost) do return fail("CastingPermission::PlayFromExile.without_paying_mana_cost") }
	if fv, found := get_any(v, "land_enter_tapped"); found { if !decode_EtbTapState(fv, &out.land_enter_tapped) do return fail("CastingPermission::PlayFromExile.land_enter_tapped") }
	if fv, found := get_any(v, "invalidation"); found { if !dec_opt_PlayPermissionInvalidation(fv, &out.invalidation) do return fail("CastingPermission::PlayFromExile.invalidation") }
	if fv, found := get_any(v, "provenance"); found { if !decode_PlayFromExileProvenance(fv, &out.provenance) do return fail("CastingPermission::PlayFromExile.provenance") }
	return true
		}) { return fail("CastingPermission::PlayFromExile") }
		out^ = tmp
	case "ExileWithEnergyCost": out^ = CastingPermission_ExileWithEnergyCost{}
	case "ExileWithAltAbilityCost":
		tmp: CastingPermission_ExileWithAltAbilityCost
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CastingPermission_ExileWithAltAbilityCost) -> bool {
	if fv, found := get_any(v, "cost"); found { if !decode_AbilityCost(fv, &out.cost) do return fail("CastingPermission::ExileWithAltAbilityCost.cost") } else { return fail("CastingPermission::ExileWithAltAbilityCost.cost missing") }
	if fv, found := get_any(v, "constraint"); found { if !dec_opt_CastPermissionConstraint(fv, &out.constraint) do return fail("CastingPermission::ExileWithAltAbilityCost.constraint") }
	if fv, found := get_any(v, "granted_to"); found { if !dec_opt_PlayerId(fv, &out.granted_to) do return fail("CastingPermission::ExileWithAltAbilityCost.granted_to") }
	if fv, found := get_any(v, "duration"); found { if !dec_opt_Duration(fv, &out.duration) do return fail("CastingPermission::ExileWithAltAbilityCost.duration") }
	if fv, found := get_any(v, "source_id"); found { if !dec_opt_ObjectId(fv, &out.source_id) do return fail("CastingPermission::ExileWithAltAbilityCost.source_id") }
	if fv, found := get_any(v, "cast_cost_modifier"); found { if !dec_opt_CastCostModifier(fv, &out.cast_cost_modifier) do return fail("CastingPermission::ExileWithAltAbilityCost.cast_cost_modifier") }
	return true
		}) { return fail("CastingPermission::ExileWithAltAbilityCost") }
		out^ = tmp
	case "WarpExile":
		tmp: CastingPermission_WarpExile
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CastingPermission_WarpExile) -> bool {
	if fv, found := get_any(v, "castable_after_turn"); found { if !decode_u32(fv, &out.castable_after_turn) do return fail("CastingPermission::WarpExile.castable_after_turn") } else { return fail("CastingPermission::WarpExile.castable_after_turn missing") }
	return true
		}) { return fail("CastingPermission::WarpExile") }
		out^ = tmp
	case "Plotted":
		tmp: CastingPermission_Plotted
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CastingPermission_Plotted) -> bool {
	if fv, found := get_any(v, "turn_plotted"); found { if !decode_u32(fv, &out.turn_plotted) do return fail("CastingPermission::Plotted.turn_plotted") } else { return fail("CastingPermission::Plotted.turn_plotted missing") }
	return true
		}) { return fail("CastingPermission::Plotted") }
		out^ = tmp
	case "Foretold":
		tmp: CastingPermission_Foretold
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CastingPermission_Foretold) -> bool {
	if fv, found := get_any(v, "cost"); found { if !decode_ManaCost(fv, &out.cost) do return fail("CastingPermission::Foretold.cost") } else { return fail("CastingPermission::Foretold.cost missing") }
	if fv, found := get_any(v, "turn_foretold"); found { if !decode_u32(fv, &out.turn_foretold) do return fail("CastingPermission::Foretold.turn_foretold") } else { return fail("CastingPermission::Foretold.turn_foretold missing") }
	return true
		}) { return fail("CastingPermission::Foretold") }
		out^ = tmp
	case: return fail("CastingPermission: unknown variant")
	}
	return true
}

encode_CastingPermission :: proc(b: ^strings.Builder, x: CastingPermission) {
	#partial switch y in x {
	case CastingPermission_AdventureCreature: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AdventureCreature"); strings.write_byte(b, '}')
	case CastingPermission_ExileWithAltCost: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ExileWithAltCost")
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	if !(skip_CastingPermission_ExileGrantCostProvenance_is_alternative(y.cost_provenance)) { member(b, first, "cost_provenance"); encode_ExileGrantCostProvenance(b, y.cost_provenance) }
	if !(!y.cast_transformed) { member(b, first, "cast_transformed"); encode_bool(b, y.cast_transformed) }
	if !(y.constraint == nil) { member(b, first, "constraint"); enc_opt_CastPermissionConstraint(b, y.constraint) }
	if !(y.granted_to == nil) { member(b, first, "granted_to"); enc_opt_PlayerId(b, y.granted_to) }
	if !(y.resolution_cleanup == nil) { member(b, first, "resolution_cleanup"); enc_opt_ResolutionCastCleanup(b, y.resolution_cleanup) }
	if !(y.duration == nil) { member(b, first, "duration"); enc_opt_Duration(b, y.duration) }
	if !(y.source_id == nil) { member(b, first, "source_id"); enc_opt_ObjectId(b, y.source_id) }
	if !(y.graveyard_replacement == nil) { member(b, first, "graveyard_replacement"); enc_opt_SpellStackToGraveyardReplacement(b, y.graveyard_replacement) }
	if !(y.enters_with_counter == nil) { member(b, first, "enters_with_counter"); enc_opt_CounterType(b, y.enters_with_counter) }
	if !(skip_CastingPermission_PendingEntersModifications_is_empty(y.enters_with_modifications)) { member(b, first, "enters_with_modifications"); encode_PendingEntersModifications(b, y.enters_with_modifications) }
	if !(y.mana_spend_permission == nil) { member(b, first, "mana_spend_permission"); enc_opt_ManaSpendPermission(b, y.mana_spend_permission) }
	if !(y.cast_cost_modifier == nil) { member(b, first, "cast_cost_modifier"); enc_opt_CastCostModifier(b, y.cast_cost_modifier) }
	}; strings.write_byte(b, '}')
	case CastingPermission_PlayFromExile: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PlayFromExile")
	member(b, first, "duration"); encode_Duration(b, y.duration)
	member(b, first, "granted_to"); encode_PlayerId(b, y.granted_to)
	if !(skip_CastingPermission_CardPlayMode_is_play(y.mode)) { member(b, first, "mode"); encode_CardPlayMode(b, y.mode) }
	if !(skip_CastingPermission_CastFrequency_is_unlimited(y.frequency)) { member(b, first, "frequency"); encode_CastFrequency(b, y.frequency) }
	if !(y.source_id == nil) { member(b, first, "source_id"); enc_opt_ObjectId(b, y.source_id) }
	if !(y.exiled_by_ability_controller == nil) { member(b, first, "exiled_by_ability_controller"); enc_opt_PlayerId(b, y.exiled_by_ability_controller) }
	if !(y.mana_spend_permission == nil) { member(b, first, "mana_spend_permission"); enc_opt_ManaSpendPermission(b, y.mana_spend_permission) }
	if !(y.card_filter == nil) { member(b, first, "card_filter"); enc_opt_TargetFilter(b, y.card_filter) }
	if !(y.single_use_group == nil) { member(b, first, "single_use_group"); enc_opt_TrackedSetId(b, y.single_use_group) }
	if !(!y.single_use) { member(b, first, "single_use"); encode_bool(b, y.single_use) }
	if !(y.cast_cost_modifier == nil) { member(b, first, "cast_cost_modifier"); enc_opt_CastCostModifier(b, y.cast_cost_modifier) }
	if !(y.alt_ability_cost == nil) { member(b, first, "alt_ability_cost"); enc_opt_AbilityCost(b, y.alt_ability_cost) }
	if !(!y.without_paying_mana_cost) { member(b, first, "without_paying_mana_cost"); encode_bool(b, y.without_paying_mana_cost) }
	if !(skip_CastingPermission_EtbTapState_is_unspecified(y.land_enter_tapped)) { member(b, first, "land_enter_tapped"); encode_EtbTapState(b, y.land_enter_tapped) }
	if !(y.invalidation == nil) { member(b, first, "invalidation"); enc_opt_PlayPermissionInvalidation(b, y.invalidation) }
	if !(skip_CastingPermission_PlayFromExileProvenance_is_impulse(y.provenance)) { member(b, first, "provenance"); encode_PlayFromExileProvenance(b, y.provenance) }
	}; strings.write_byte(b, '}')
	case CastingPermission_ExileWithEnergyCost: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ExileWithEnergyCost"); strings.write_byte(b, '}')
	case CastingPermission_ExileWithAltAbilityCost: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ExileWithAltAbilityCost")
	member(b, first, "cost"); encode_AbilityCost(b, y.cost)
	if !(y.constraint == nil) { member(b, first, "constraint"); enc_opt_CastPermissionConstraint(b, y.constraint) }
	if !(y.granted_to == nil) { member(b, first, "granted_to"); enc_opt_PlayerId(b, y.granted_to) }
	if !(y.duration == nil) { member(b, first, "duration"); enc_opt_Duration(b, y.duration) }
	if !(y.source_id == nil) { member(b, first, "source_id"); enc_opt_ObjectId(b, y.source_id) }
	if !(y.cast_cost_modifier == nil) { member(b, first, "cast_cost_modifier"); enc_opt_CastCostModifier(b, y.cast_cost_modifier) }
	}; strings.write_byte(b, '}')
	case CastingPermission_WarpExile: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WarpExile")
	member(b, first, "castable_after_turn"); encode_u32(b, y.castable_after_turn)
	}; strings.write_byte(b, '}')
	case CastingPermission_Plotted: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Plotted")
	member(b, first, "turn_plotted"); encode_u32(b, y.turn_plotted)
	}; strings.write_byte(b, '}')
	case CastingPermission_Foretold: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Foretold")
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	member(b, first, "turn_foretold"); encode_u32(b, y.turn_foretold)
	}; strings.write_byte(b, '}')
	}
}

encode_CastingPermission_members :: proc(b: ^strings.Builder, x: CastingPermission, first: ^bool) {
	#partial switch y in x {
	case CastingPermission_AdventureCreature: _ = y; member(b, first, "type"); json.write_string(b, "AdventureCreature")
	case CastingPermission_ExileWithAltCost: member(b, first, "type"); json.write_string(b, "ExileWithAltCost")
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	if !(skip_CastingPermission_ExileGrantCostProvenance_is_alternative(y.cost_provenance)) { member(b, first, "cost_provenance"); encode_ExileGrantCostProvenance(b, y.cost_provenance) }
	if !(!y.cast_transformed) { member(b, first, "cast_transformed"); encode_bool(b, y.cast_transformed) }
	if !(y.constraint == nil) { member(b, first, "constraint"); enc_opt_CastPermissionConstraint(b, y.constraint) }
	if !(y.granted_to == nil) { member(b, first, "granted_to"); enc_opt_PlayerId(b, y.granted_to) }
	if !(y.resolution_cleanup == nil) { member(b, first, "resolution_cleanup"); enc_opt_ResolutionCastCleanup(b, y.resolution_cleanup) }
	if !(y.duration == nil) { member(b, first, "duration"); enc_opt_Duration(b, y.duration) }
	if !(y.source_id == nil) { member(b, first, "source_id"); enc_opt_ObjectId(b, y.source_id) }
	if !(y.graveyard_replacement == nil) { member(b, first, "graveyard_replacement"); enc_opt_SpellStackToGraveyardReplacement(b, y.graveyard_replacement) }
	if !(y.enters_with_counter == nil) { member(b, first, "enters_with_counter"); enc_opt_CounterType(b, y.enters_with_counter) }
	if !(skip_CastingPermission_PendingEntersModifications_is_empty(y.enters_with_modifications)) { member(b, first, "enters_with_modifications"); encode_PendingEntersModifications(b, y.enters_with_modifications) }
	if !(y.mana_spend_permission == nil) { member(b, first, "mana_spend_permission"); enc_opt_ManaSpendPermission(b, y.mana_spend_permission) }
	if !(y.cast_cost_modifier == nil) { member(b, first, "cast_cost_modifier"); enc_opt_CastCostModifier(b, y.cast_cost_modifier) }

	case CastingPermission_PlayFromExile: member(b, first, "type"); json.write_string(b, "PlayFromExile")
	member(b, first, "duration"); encode_Duration(b, y.duration)
	member(b, first, "granted_to"); encode_PlayerId(b, y.granted_to)
	if !(skip_CastingPermission_CardPlayMode_is_play(y.mode)) { member(b, first, "mode"); encode_CardPlayMode(b, y.mode) }
	if !(skip_CastingPermission_CastFrequency_is_unlimited(y.frequency)) { member(b, first, "frequency"); encode_CastFrequency(b, y.frequency) }
	if !(y.source_id == nil) { member(b, first, "source_id"); enc_opt_ObjectId(b, y.source_id) }
	if !(y.exiled_by_ability_controller == nil) { member(b, first, "exiled_by_ability_controller"); enc_opt_PlayerId(b, y.exiled_by_ability_controller) }
	if !(y.mana_spend_permission == nil) { member(b, first, "mana_spend_permission"); enc_opt_ManaSpendPermission(b, y.mana_spend_permission) }
	if !(y.card_filter == nil) { member(b, first, "card_filter"); enc_opt_TargetFilter(b, y.card_filter) }
	if !(y.single_use_group == nil) { member(b, first, "single_use_group"); enc_opt_TrackedSetId(b, y.single_use_group) }
	if !(!y.single_use) { member(b, first, "single_use"); encode_bool(b, y.single_use) }
	if !(y.cast_cost_modifier == nil) { member(b, first, "cast_cost_modifier"); enc_opt_CastCostModifier(b, y.cast_cost_modifier) }
	if !(y.alt_ability_cost == nil) { member(b, first, "alt_ability_cost"); enc_opt_AbilityCost(b, y.alt_ability_cost) }
	if !(!y.without_paying_mana_cost) { member(b, first, "without_paying_mana_cost"); encode_bool(b, y.without_paying_mana_cost) }
	if !(skip_CastingPermission_EtbTapState_is_unspecified(y.land_enter_tapped)) { member(b, first, "land_enter_tapped"); encode_EtbTapState(b, y.land_enter_tapped) }
	if !(y.invalidation == nil) { member(b, first, "invalidation"); enc_opt_PlayPermissionInvalidation(b, y.invalidation) }
	if !(skip_CastingPermission_PlayFromExileProvenance_is_impulse(y.provenance)) { member(b, first, "provenance"); encode_PlayFromExileProvenance(b, y.provenance) }

	case CastingPermission_ExileWithEnergyCost: _ = y; member(b, first, "type"); json.write_string(b, "ExileWithEnergyCost")
	case CastingPermission_ExileWithAltAbilityCost: member(b, first, "type"); json.write_string(b, "ExileWithAltAbilityCost")
	member(b, first, "cost"); encode_AbilityCost(b, y.cost)
	if !(y.constraint == nil) { member(b, first, "constraint"); enc_opt_CastPermissionConstraint(b, y.constraint) }
	if !(y.granted_to == nil) { member(b, first, "granted_to"); enc_opt_PlayerId(b, y.granted_to) }
	if !(y.duration == nil) { member(b, first, "duration"); enc_opt_Duration(b, y.duration) }
	if !(y.source_id == nil) { member(b, first, "source_id"); enc_opt_ObjectId(b, y.source_id) }
	if !(y.cast_cost_modifier == nil) { member(b, first, "cast_cost_modifier"); enc_opt_CastCostModifier(b, y.cast_cost_modifier) }

	case CastingPermission_WarpExile: member(b, first, "type"); json.write_string(b, "WarpExile")
	member(b, first, "castable_after_turn"); encode_u32(b, y.castable_after_turn)

	case CastingPermission_Plotted: member(b, first, "type"); json.write_string(b, "Plotted")
	member(b, first, "turn_plotted"); encode_u32(b, y.turn_plotted)

	case CastingPermission_Foretold: member(b, first, "type"); json.write_string(b, "Foretold")
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	member(b, first, "turn_foretold"); encode_u32(b, y.turn_foretold)

	}
}

decode_ZoneOwner :: proc(v: json.Value, out: ^ZoneOwner) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ZoneOwner: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ZoneOwner: not a string or object")
	}
	switch variant {
	case "Controller": out^ = ZoneOwner_Controller{}
	case "TargetedPlayer": out^ = ZoneOwner_TargetedPlayer{}
	case "Opponent": out^ = ZoneOwner_Opponent{}
	case "ScopedPlayer": out^ = ZoneOwner_ScopedPlayer{}
	case "Each": tmp: ZoneOwner_Each; if !decode_PerPlayerScope(body, &tmp._0) do return fail("ZoneOwner::Each"); out^ = tmp
	case "AllOwners": out^ = ZoneOwner_AllOwners{}
	case: return fail("ZoneOwner: unknown variant")
	}
	return true
}

encode_ZoneOwner :: proc(b: ^strings.Builder, x: ZoneOwner) {
	#partial switch y in x {
	case ZoneOwner_Controller: _ = y; json.write_string(b, "Controller")
	case ZoneOwner_TargetedPlayer: _ = y; json.write_string(b, "TargetedPlayer")
	case ZoneOwner_Opponent: _ = y; json.write_string(b, "Opponent")
	case ZoneOwner_ScopedPlayer: _ = y; json.write_string(b, "ScopedPlayer")
	case ZoneOwner_Each: strings.write_byte(b, '{'); json.write_string(b, "Each"); strings.write_byte(b, ':'); encode_PerPlayerScope(b, y._0); strings.write_byte(b, '}')
	case ZoneOwner_AllOwners: _ = y; json.write_string(b, "AllOwners")
	}
}

decode_ZoneChoiceChooser :: proc(v: json.Value, out: ^ZoneChoiceChooser) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ZoneChoiceChooser: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ZoneChoiceChooser: not a string or object")
	}
	switch variant {
	case "Controller": out^ = ZoneChoiceChooser_Controller{}
	case "Opponent": out^ = ZoneChoiceChooser_Opponent{}
	case "OwningPlayer": out^ = ZoneChoiceChooser_OwningPlayer{}
	case "ImmediatePriorSelectedCardOwner":
		tmp: ZoneChoiceChooser_ImmediatePriorSelectedCardOwner
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ZoneChoiceChooser_ImmediatePriorSelectedCardOwner) -> bool {
	if fv, found := get_any(v, "player"); found { if !dec_opt_PlayerId(fv, &out.player) do return fail("ZoneChoiceChooser::ImmediatePriorSelectedCardOwner.player") }
	return true
		}) { return fail("ZoneChoiceChooser::ImmediatePriorSelectedCardOwner") }
		out^ = tmp
	case "DeclaredPlayer":
		tmp: ZoneChoiceChooser_DeclaredPlayer
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ZoneChoiceChooser_DeclaredPlayer) -> bool {
	if fv, found := get_any(v, "group"); found { if !decode_ChosenGroupId(fv, &out.group) do return fail("ZoneChoiceChooser::DeclaredPlayer.group") } else { return fail("ZoneChoiceChooser::DeclaredPlayer.group missing") }
	return true
		}) { return fail("ZoneChoiceChooser::DeclaredPlayer") }
		out^ = tmp
	case: return fail("ZoneChoiceChooser: unknown variant")
	}
	return true
}

encode_ZoneChoiceChooser :: proc(b: ^strings.Builder, x: ZoneChoiceChooser) {
	#partial switch y in x {
	case ZoneChoiceChooser_Controller: _ = y; json.write_string(b, "Controller")
	case ZoneChoiceChooser_Opponent: _ = y; json.write_string(b, "Opponent")
	case ZoneChoiceChooser_OwningPlayer: _ = y; json.write_string(b, "OwningPlayer")
	case ZoneChoiceChooser_ImmediatePriorSelectedCardOwner: strings.write_byte(b, '{'); json.write_string(b, "ImmediatePriorSelectedCardOwner"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	if !(y.player == nil) { member(b, first, "player"); enc_opt_PlayerId(b, y.player) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ZoneChoiceChooser_DeclaredPlayer: strings.write_byte(b, '{'); json.write_string(b, "DeclaredPlayer"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "group"); encode_ChosenGroupId(b, y.group)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

