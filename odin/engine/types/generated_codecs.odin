encode_ManaAbilityResume :: proc(b: ^strings.Builder, x: ManaAbilityResume) {
	#partial switch y in x {
	case ManaAbilityResume_Priority: _ = y; json.write_string(b, "Priority")
	case ManaAbilityResume_CompanionToHand: strings.write_byte(b, '{'); json.write_string(b, "CompanionToHand"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaAbilityResume_PlanarDieRoll: strings.write_byte(b, '{'); json.write_string(b, "PlanarDieRoll"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaAbilityResume_TurnFaceUp: strings.write_byte(b, '{'); json.write_string(b, "TurnFaceUp"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "source"); encode_ObjectIncarnationRef(b, y.source)
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	member(b, first, "announced_x"); enc_opt_u32(b, y.announced_x)
	member(b, first, "cost_source"); encode_TurnUpCostSource(b, y.cost_source)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaAbilityResume_EndContinuousEffect: strings.write_byte(b, '{'); json.write_string(b, "EndContinuousEffect"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "group"); encode_EndEffectGroupId(b, y.group)
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaAbilityResume_RoomUnlock: strings.write_byte(b, '{'); json.write_string(b, "RoomUnlock"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "door"); encode_RoomDoor(b, y.door)
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaAbilityResume_Foretell: strings.write_byte(b, '{'); json.write_string(b, "Foretell"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	member(b, first, "payment_cost"); encode_ManaCost(b, y.payment_cost)
	member(b, first, "turn_foretold"); encode_u32(b, y.turn_foretold)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaAbilityResume_ManaPayment: strings.write_byte(b, '{'); json.write_string(b, "ManaPayment"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	if !(y.outer_player == nil) { member(b, first, "outer_player"); enc_opt_PlayerId(b, y.outer_player) }
	if !(y.convoke_mode == nil) { member(b, first, "convoke_mode"); enc_opt_ConvokeMode(b, y.convoke_mode) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaAbilityResume_ManaSourceSelection: strings.write_byte(b, '{'); json.write_string(b, "ManaSourceSelection"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "options"); enc_dyn_ManaSourceSelection(b, y.options)
	if !(y.convoke_mode == nil) { member(b, first, "convoke_mode"); enc_opt_ConvokeMode(b, y.convoke_mode) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaAbilityResume_UnlessPayment: strings.write_byte(b, '{'); json.write_string(b, "UnlessPayment"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	if !(y.outer_player == nil) { member(b, first, "outer_player"); enc_opt_PlayerId(b, y.outer_player) }
	member(b, first, "cost"); enc_ptr_AbilityCost(b, y.cost)
	member(b, first, "pending_effect"); enc_ptr_ResolvedAbility(b, y.pending_effect)
	if !(y.trigger_event == nil) { member(b, first, "trigger_event"); enc_opt_GameEvent(b, y.trigger_event) }
	if !(y.effect_description == nil) { member(b, first, "effect_description"); enc_opt_string(b, y.effect_description) }
	if !((len(y.remaining) == 0)) { member(b, first, "remaining"); enc_dyn_PlayerId(b, y.remaining) }
	if !(y.affected_object == nil) { member(b, first, "affected_object"); enc_opt_ObjectId(b, y.affected_object) }
	if !(y.repeat == nil) { member(b, first, "repeat"); enc_opt_u32(b, y.repeat) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaAbilityResume_CombatTaxPayment: strings.write_byte(b, '{'); json.write_string(b, "CombatTaxPayment"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "context"); encode_CombatTaxContext(b, y.context_)
	member(b, first, "total_cost"); encode_ManaCost(b, y.total_cost)
	member(b, first, "per_creature"); enc_dyn_t2_ObjectId_ManaCost(b, y.per_creature)
	member(b, first, "pending"); encode_CombatTaxPending(b, y.pending)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaAbilityResume_EffectPayCost: strings.write_byte(b, '{'); json.write_string(b, "EffectPayCost"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "payer"); encode_PlayerId(b, y.payer)
	member(b, first, "return_to"); encode_PlayerId(b, y.return_to)
	member(b, first, "ability"); enc_ptr_ResolvedAbility(b, y.ability)
	member(b, first, "cost"); enc_ptr_AbilityCost(b, y.cost)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaAbilityResume_PhyrexianCastPayment: strings.write_byte(b, '{'); json.write_string(b, "PhyrexianCastPayment"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "caster"); encode_PlayerId(b, y.caster)
	member(b, first, "choices"); enc_dyn_ShardChoice(b, y.choices)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaAbilityResume_FinalizePendingManaPayment: strings.write_byte(b, '{'); json.write_string(b, "FinalizePendingManaPayment"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaAbilityResume_ManaAbilityManaPayment: strings.write_byte(b, '{'); json.write_string(b, "ManaAbilityManaPayment"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "pending_mana_ability"); enc_ptr_PendingManaAbility(b, y.pending_mana_ability)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_CollectedTriggerContextBatch :: proc(v: json.Value, out: ^CollectedTriggerContextBatch) -> bool {
	when COVERAGE do cov_hit("CollectedTriggerContextBatch")
	if v.kind != .Object do return fail("CollectedTriggerContextBatch: not an object")
	if fv, found := get_any(v, "contexts"); found { if !dec_dyn_PendingTriggerContext(fv, &out.contexts) do return fail("CollectedTriggerContextBatch.contexts") }
	if fv, found := get_any(v, "delayed_events"); found { if !dec_dyn_GameEvent(fv, &out.delayed_events) do return fail("CollectedTriggerContextBatch.delayed_events") }
