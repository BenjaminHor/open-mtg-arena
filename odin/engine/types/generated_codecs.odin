	strings.write_byte(b, '{')
	f := true
	encode_SettledDamageGuard_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_SettledDamageGuard_members :: proc(b: ^strings.Builder, x: SettledDamageGuard, first: ^bool) {
	member(b, first, "source"); encode_ObjectIncarnationRef(b, x.source)
	member(b, first, "condition"); encode_ReplacementCondition(b, x.condition)
	member(b, first, "reading"); encode_DamageGuardReading(b, x.reading)
}

