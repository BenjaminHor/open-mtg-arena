	member(b, first, "text"); encode_string(b, x.text)
}

decode_PayCostKind :: proc(v: json.Value, out: ^PayCostKind) -> bool {
	when COVERAGE do cov_hit("PayCostKind")
	if v.kind != .Object do return fail("PayCostKind: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("PayCostKind: no tag")
	switch tv.text {
	case "Discard": when COVERAGE do cov_hit("PayCostKind::Discard"); out^ = PayCostKind_Discard{}
	case "Reveal": when COVERAGE do cov_hit("PayCostKind::Reveal");
		tmp: PayCostKind_Reveal
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PayCostKind_Reveal) -> bool {
	if fv, found := get_any(v, "shared_quality"); found { if !dec_opt_SharedQuality(fv, &out.shared_quality) do return fail("PayCostKind::Reveal.shared_quality") }
	return true
		}) { return fail("PayCostKind::Reveal") }
		out^ = tmp
	case "Sacrifice": when COVERAGE do cov_hit("PayCostKind::Sacrifice"); out^ = PayCostKind_Sacrifice{}
	case "ReturnToHand": when COVERAGE do cov_hit("PayCostKind::ReturnToHand"); out^ = PayCostKind_ReturnToHand{}
	case "ExileFromZone": when COVERAGE do cov_hit("PayCostKind::ExileFromZone");
		tmp: PayCostKind_ExileFromZone
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PayCostKind_ExileFromZone) -> bool {
	if fv, found := get_any(v, "zone"); found { if !decode_ExileCostSourceZone(fv, &out.zone) do return fail("PayCostKind::ExileFromZone.zone") } else { return fail("PayCostKind::ExileFromZone.zone missing") }
	return true
		}) { return fail("PayCostKind::ExileFromZone") }
		out^ = tmp
	case "ExileMaterials": when COVERAGE do cov_hit("PayCostKind::ExileMaterials");
		tmp: PayCostKind_ExileMaterials
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PayCostKind_ExileMaterials) -> bool {
	if fv, found := get_any(v, "materials"); found { if !decode_TargetFilter(fv, &out.materials) do return fail("PayCostKind::ExileMaterials.materials") } else { return fail("PayCostKind::ExileMaterials.materials missing") }
	return true
		}) { return fail("PayCostKind::ExileMaterials") }
		out^ = tmp
	case "ExilePermanent": when COVERAGE do cov_hit("PayCostKind::ExilePermanent");
		tmp: PayCostKind_ExilePermanent
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PayCostKind_ExilePermanent) -> bool {
	if fv, found := get_any(v, "filter"); found { if !dec_opt_TargetFilter(fv, &out.filter) do return fail("PayCostKind::ExilePermanent.filter") }
	return true
		}) { return fail("PayCostKind::ExilePermanent") }
		out^ = tmp
	case "ExileFromManaZone": when COVERAGE do cov_hit("PayCostKind::ExileFromManaZone");
		tmp: PayCostKind_ExileFromManaZone
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PayCostKind_ExileFromManaZone) -> bool {
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("PayCostKind::ExileFromManaZone.zone") } else { return fail("PayCostKind::ExileFromManaZone.zone missing") }
	return true
		}) { return fail("PayCostKind::ExileFromManaZone") }
		out^ = tmp
	case "UnattachFrom": when COVERAGE do cov_hit("PayCostKind::UnattachFrom");
		tmp: PayCostKind_UnattachFrom
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PayCostKind_UnattachFrom) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("PayCostKind::UnattachFrom.filter") } else { return fail("PayCostKind::UnattachFrom.filter missing") }
	return true
		}) { return fail("PayCostKind::UnattachFrom") }
		out^ = tmp
	case "RemoveCounter": when COVERAGE do cov_hit("PayCostKind::RemoveCounter");
		tmp: PayCostKind_RemoveCounter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PayCostKind_RemoveCounter) -> bool {
	if fv, found := get_any(v, "counter_type"); found { if !decode_CounterMatch(fv, &out.counter_type) do return fail("PayCostKind::RemoveCounter.counter_type") } else { return fail("PayCostKind::RemoveCounter.counter_type missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("PayCostKind::RemoveCounter.count") } else { return fail("PayCostKind::RemoveCounter.count missing") }
	if fv, found := get_any(v, "selection"); found { if !decode_CounterCostSelection(fv, &out.selection) do return fail("PayCostKind::RemoveCounter.selection") }
	return true
		}) { return fail("PayCostKind::RemoveCounter") }
		out^ = tmp
	case "TapCreatures": when COVERAGE do cov_hit("PayCostKind::TapCreatures");
		tmp: PayCostKind_TapCreatures
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PayCostKind_TapCreatures) -> bool {
	if fv, found := get_any(v, "mode"); found { if !decode_TapCreaturesSelectionMode(fv, &out.mode) do return fail("PayCostKind::TapCreatures.mode") } else { return fail("PayCostKind::TapCreatures.mode missing") }
	return true
		}) { return fail("PayCostKind::TapCreatures") }
		out^ = tmp
	case "Behold": when COVERAGE do cov_hit("PayCostKind::Behold");
		tmp: PayCostKind_Behold
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PayCostKind_Behold) -> bool {
	if fv, found := get_any(v, "action"); found { if !decode_BeholdCostAction(fv, &out.action) do return fail("PayCostKind::Behold.action") } else { return fail("PayCostKind::Behold.action missing") }
	return true
		}) { return fail("PayCostKind::Behold") }
		out^ = tmp
	case "ExileAggregate": when COVERAGE do cov_hit("PayCostKind::ExileAggregate");
		tmp: PayCostKind_ExileAggregate
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PayCostKind_ExileAggregate) -> bool {
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("PayCostKind::ExileAggregate.zone") } else { return fail("PayCostKind::ExileAggregate.zone missing") }
	if fv, found := get_any(v, "function"); found { if !decode_AggregateFunction(fv, &out.function) do return fail("PayCostKind::ExileAggregate.function") } else { return fail("PayCostKind::ExileAggregate.function missing") }
	if fv, found := get_any(v, "property"); found { if !decode_ObjectProperty(fv, &out.property) do return fail("PayCostKind::ExileAggregate.property") } else { return fail("PayCostKind::ExileAggregate.property missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("PayCostKind::ExileAggregate.comparator") } else { return fail("PayCostKind::ExileAggregate.comparator missing") }
	if fv, found := get_any(v, "value"); found { if !decode_i32(fv, &out.value) do return fail("PayCostKind::ExileAggregate.value") } else { return fail("PayCostKind::ExileAggregate.value missing") }
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("PayCostKind::ExileAggregate.filter") } else { return fail("PayCostKind::ExileAggregate.filter missing") }
	return true
		}) { return fail("PayCostKind::ExileAggregate") }
		out^ = tmp
	case: return fail("PayCostKind: unknown variant")
	}
	return true
}

encode_PayCostKind :: proc(b: ^strings.Builder, x: PayCostKind) {
	#partial switch y in x {
	case PayCostKind_Discard: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Discard"); strings.write_byte(b, '}')
	case PayCostKind_Reveal: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Reveal")
	if !(y.shared_quality == nil) { member(b, first, "shared_quality"); enc_opt_SharedQuality(b, y.shared_quality) }
	}; strings.write_byte(b, '}')
	case PayCostKind_Sacrifice: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Sacrifice"); strings.write_byte(b, '}')
	case PayCostKind_ReturnToHand: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ReturnToHand"); strings.write_byte(b, '}')
	case PayCostKind_ExileFromZone: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ExileFromZone")
	member(b, first, "zone"); encode_ExileCostSourceZone(b, y.zone)
	}; strings.write_byte(b, '}')
	case PayCostKind_ExileMaterials: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ExileMaterials")
	member(b, first, "materials"); encode_TargetFilter(b, y.materials)
	}; strings.write_byte(b, '}')
	case PayCostKind_ExilePermanent: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ExilePermanent")
	member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case PayCostKind_ExileFromManaZone: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ExileFromManaZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	}; strings.write_byte(b, '}')
	case PayCostKind_UnattachFrom: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UnattachFrom")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case PayCostKind_RemoveCounter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RemoveCounter")
	member(b, first, "counter_type"); encode_CounterMatch(b, y.counter_type)
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "selection"); encode_CounterCostSelection(b, y.selection)
	}; strings.write_byte(b, '}')
	case PayCostKind_TapCreatures: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TapCreatures")
	member(b, first, "mode"); encode_TapCreaturesSelectionMode(b, y.mode)
	}; strings.write_byte(b, '}')
	case PayCostKind_Behold: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Behold")
	member(b, first, "action"); encode_BeholdCostAction(b, y.action)
	}; strings.write_byte(b, '}')
	case PayCostKind_ExileAggregate: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ExileAggregate")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	member(b, first, "function"); encode_AggregateFunction(b, y.function)
	member(b, first, "property"); encode_ObjectProperty(b, y.property)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_i32(b, y.value)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	}
}

encode_PayCostKind_members :: proc(b: ^strings.Builder, x: PayCostKind, first: ^bool) {
	#partial switch y in x {
	case PayCostKind_Discard: _ = y; member(b, first, "type"); json.write_string(b, "Discard")
	case PayCostKind_Reveal: member(b, first, "type"); json.write_string(b, "Reveal")
	if !(y.shared_quality == nil) { member(b, first, "shared_quality"); enc_opt_SharedQuality(b, y.shared_quality) }

	case PayCostKind_Sacrifice: _ = y; member(b, first, "type"); json.write_string(b, "Sacrifice")
	case PayCostKind_ReturnToHand: _ = y; member(b, first, "type"); json.write_string(b, "ReturnToHand")
	case PayCostKind_ExileFromZone: member(b, first, "type"); json.write_string(b, "ExileFromZone")
	member(b, first, "zone"); encode_ExileCostSourceZone(b, y.zone)

	case PayCostKind_ExileMaterials: member(b, first, "type"); json.write_string(b, "ExileMaterials")
	member(b, first, "materials"); encode_TargetFilter(b, y.materials)

	case PayCostKind_ExilePermanent: member(b, first, "type"); json.write_string(b, "ExilePermanent")
	member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter)

	case PayCostKind_ExileFromManaZone: member(b, first, "type"); json.write_string(b, "ExileFromManaZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)

	case PayCostKind_UnattachFrom: member(b, first, "type"); json.write_string(b, "UnattachFrom")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case PayCostKind_RemoveCounter: member(b, first, "type"); json.write_string(b, "RemoveCounter")
	member(b, first, "counter_type"); encode_CounterMatch(b, y.counter_type)
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "selection"); encode_CounterCostSelection(b, y.selection)

	case PayCostKind_TapCreatures: member(b, first, "type"); json.write_string(b, "TapCreatures")
	member(b, first, "mode"); encode_TapCreaturesSelectionMode(b, y.mode)

	case PayCostKind_Behold: member(b, first, "type"); json.write_string(b, "Behold")
	member(b, first, "action"); encode_BeholdCostAction(b, y.action)

	case PayCostKind_ExileAggregate: member(b, first, "type"); json.write_string(b, "ExileAggregate")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	member(b, first, "function"); encode_AggregateFunction(b, y.function)
	member(b, first, "property"); encode_ObjectProperty(b, y.property)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_i32(b, y.value)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	}
}

decode_CostResume :: proc(v: json.Value, out: ^CostResume) -> bool {
	when COVERAGE do cov_hit("CostResume")
	if v.kind != .Object do return fail("CostResume: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("CostResume: no tag")
	switch tv.text {
	case "Spell": when COVERAGE do cov_hit("CostResume::Spell");
		tmp: CostResume_Spell
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CostResume_Spell) -> bool {
	if fv, found := get_any(v, "Spell"); found { if !dec_ptr_PendingCast(fv, &out.spell) do return fail("CostResume::Spell.spell") } else { return fail("CostResume::Spell.spell missing") }
	return true
		}) { return fail("CostResume::Spell") }
		out^ = tmp
	case "SpellCost": when COVERAGE do cov_hit("CostResume::SpellCost");
		tmp: CostResume_SpellCost
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CostResume_SpellCost) -> bool {
	if fv, found := get_any(v, "Spell"); found { if !dec_ptr_PendingCast(fv, &out.spell) do return fail("CostResume::SpellCost.spell") } else { return fail("CostResume::SpellCost.spell missing") }
	if fv, found := get_any(v, "cost"); found { if !dec_ptr_AbilityCost(fv, &out.cost) do return fail("CostResume::SpellCost.cost") } else { return fail("CostResume::SpellCost.cost missing") }
	if fv, found := get_any(v, "source"); found { if !decode_SpellCostSource(fv, &out.source) do return fail("CostResume::SpellCost.source") } else { return fail("CostResume::SpellCost.source missing") }
	return true
		}) { return fail("CostResume::SpellCost") }
		out^ = tmp
	case "ManaAbility": when COVERAGE do cov_hit("CostResume::ManaAbility");
		tmp: CostResume_ManaAbility
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CostResume_ManaAbility) -> bool {
	if fv, found := get_any(v, "ManaAbility"); found { if !dec_ptr_PendingManaAbility(fv, &out.mana_ability) do return fail("CostResume::ManaAbility.mana_ability") } else { return fail("CostResume::ManaAbility.mana_ability missing") }
	return true
		}) { return fail("CostResume::ManaAbility") }
		out^ = tmp
	case "Resolution": when COVERAGE do cov_hit("CostResume::Resolution"); out^ = CostResume_Resolution{}
	case "TeamTapPayment": when COVERAGE do cov_hit("CostResume::TeamTapPayment");
		tmp: CostResume_TeamTapPayment
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CostResume_TeamTapPayment) -> bool {
	if fv, found := get_any(v, "aggregate"); found { if !decode_TapCreaturesAggregate(fv, &out.aggregate) do return fail("CostResume::TeamTapPayment.aggregate") } else { return fail("CostResume::TeamTapPayment.aggregate missing") }
	if fv, found := get_any(v, "eligible"); found { if !dec_dyn_ObjectId(fv, &out.eligible) do return fail("CostResume::TeamTapPayment.eligible") } else { return fail("CostResume::TeamTapPayment.eligible missing") }
	if fv, found := get_any(v, "selected"); found { if !dec_dyn_ObjectId(fv, &out.selected) do return fail("CostResume::TeamTapPayment.selected") } else { return fail("CostResume::TeamTapPayment.selected missing") }
	if fv, found := get_any(v, "remaining"); found { if !dec_dyn_PlayerId(fv, &out.remaining) do return fail("CostResume::TeamTapPayment.remaining") } else { return fail("CostResume::TeamTapPayment.remaining missing") }
	if fv, found := get_any(v, "filter"); found { if !dec_ptr_TargetFilter(fv, &out.filter) do return fail("CostResume::TeamTapPayment.filter") } else { return fail("CostResume::TeamTapPayment.filter missing") }
	if fv, found := get_any(v, "ability"); found { if !dec_ptr_ResolvedAbility(fv, &out.ability) do return fail("CostResume::TeamTapPayment.ability") } else { return fail("CostResume::TeamTapPayment.ability missing") }
	return true
		}) { return fail("CostResume::TeamTapPayment") }
		out^ = tmp
	case "TurnFaceUp": when COVERAGE do cov_hit("CostResume::TurnFaceUp");
		tmp: CostResume_TurnFaceUp
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CostResume_TurnFaceUp) -> bool {
	if fv, found := get_any(v, "source", "object_id"); found { if !decode_ObjectIncarnationRef(fv, &out.source) do return fail("CostResume::TurnFaceUp.source") } else { return fail("CostResume::TurnFaceUp.source missing") }
	if fv, found := get_any(v, "cost_source"); found { if !decode_TurnUpCostSource(fv, &out.cost_source) do return fail("CostResume::TurnFaceUp.cost_source") } else { return fail("CostResume::TurnFaceUp.cost_source missing") }
	if fv, found := get_any(v, "remaining_cost"); found { if !dec_ptr_AbilityCost(fv, &out.remaining_cost) do return fail("CostResume::TurnFaceUp.remaining_cost") }
	return true
		}) { return fail("CostResume::TurnFaceUp") }
		out^ = tmp
	case: return fail("CostResume: unknown variant")
	}
	return true
}

encode_CostResume :: proc(b: ^strings.Builder, x: CostResume) {
	#partial switch y in x {
	case CostResume_Spell: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Spell")
	member(b, first, "Spell"); enc_ptr_PendingCast(b, y.spell)
	}; strings.write_byte(b, '}')
	case CostResume_SpellCost: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SpellCost")
	member(b, first, "Spell"); enc_ptr_PendingCast(b, y.spell)
	member(b, first, "cost"); enc_ptr_AbilityCost(b, y.cost)
	member(b, first, "source"); encode_SpellCostSource(b, y.source)
	}; strings.write_byte(b, '}')
	case CostResume_ManaAbility: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ManaAbility")
	member(b, first, "ManaAbility"); enc_ptr_PendingManaAbility(b, y.mana_ability)
	}; strings.write_byte(b, '}')
	case CostResume_Resolution: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Resolution"); strings.write_byte(b, '}')
	case CostResume_TeamTapPayment: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TeamTapPayment")
	member(b, first, "aggregate"); encode_TapCreaturesAggregate(b, y.aggregate)
	member(b, first, "eligible"); enc_dyn_ObjectId(b, y.eligible)
	member(b, first, "selected"); enc_dyn_ObjectId(b, y.selected)
	member(b, first, "remaining"); enc_dyn_PlayerId(b, y.remaining)
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)
	member(b, first, "ability"); enc_ptr_ResolvedAbility(b, y.ability)
	}; strings.write_byte(b, '}')
	case CostResume_TurnFaceUp: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TurnFaceUp")
	member(b, first, "source"); encode_ObjectIncarnationRef(b, y.source)
	member(b, first, "cost_source"); encode_TurnUpCostSource(b, y.cost_source)
	if !(y.remaining_cost == nil) { member(b, first, "remaining_cost"); enc_ptr_AbilityCost(b, y.remaining_cost) }
	}; strings.write_byte(b, '}')
	}
}

encode_CostResume_members :: proc(b: ^strings.Builder, x: CostResume, first: ^bool) {
	#partial switch y in x {
	case CostResume_Spell: member(b, first, "type"); json.write_string(b, "Spell")
	member(b, first, "Spell"); enc_ptr_PendingCast(b, y.spell)

	case CostResume_SpellCost: member(b, first, "type"); json.write_string(b, "SpellCost")
	member(b, first, "Spell"); enc_ptr_PendingCast(b, y.spell)
	member(b, first, "cost"); enc_ptr_AbilityCost(b, y.cost)
	member(b, first, "source"); encode_SpellCostSource(b, y.source)

	case CostResume_ManaAbility: member(b, first, "type"); json.write_string(b, "ManaAbility")
	member(b, first, "ManaAbility"); enc_ptr_PendingManaAbility(b, y.mana_ability)

	case CostResume_Resolution: _ = y; member(b, first, "type"); json.write_string(b, "Resolution")
	case CostResume_TeamTapPayment: member(b, first, "type"); json.write_string(b, "TeamTapPayment")
	member(b, first, "aggregate"); encode_TapCreaturesAggregate(b, y.aggregate)
	member(b, first, "eligible"); enc_dyn_ObjectId(b, y.eligible)
	member(b, first, "selected"); enc_dyn_ObjectId(b, y.selected)
	member(b, first, "remaining"); enc_dyn_PlayerId(b, y.remaining)
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)
	member(b, first, "ability"); enc_ptr_ResolvedAbility(b, y.ability)

	case CostResume_TurnFaceUp: member(b, first, "type"); json.write_string(b, "TurnFaceUp")
	member(b, first, "source"); encode_ObjectIncarnationRef(b, y.source)
	member(b, first, "cost_source"); encode_TurnUpCostSource(b, y.cost_source)
	if !(y.remaining_cost == nil) { member(b, first, "remaining_cost"); enc_ptr_AbilityCost(b, y.remaining_cost) }

	}
}

decode_ManaType :: proc(v: json.Value, out: ^ManaType) -> bool {
	when COVERAGE do cov_hit("ManaType")
	if v.kind != .String do return fail("ManaType: not a string")
	str := v.text
	switch str {
	case "White": when COVERAGE do cov_hit("ManaType::White"); out^ = .White
	case "Blue": when COVERAGE do cov_hit("ManaType::Blue"); out^ = .Blue
	case "Black": when COVERAGE do cov_hit("ManaType::Black"); out^ = .Black
	case "Red": when COVERAGE do cov_hit("ManaType::Red"); out^ = .Red
	case "Green": when COVERAGE do cov_hit("ManaType::Green"); out^ = .Green
	case "Colorless": when COVERAGE do cov_hit("ManaType::Colorless"); out^ = .Colorless
	case: return fail("ManaType: unknown variant")
	}
	return true
}

encode_ManaType :: proc(b: ^strings.Builder, x: ManaType) {
	@(static, rodata) NAMES := [ManaType]string{
		.White = "White",
		.Blue = "Blue",
		.Black = "Black",
		.Red = "Red",
		.Green = "Green",
		.Colorless = "Colorless",
	}
	json.write_string(b, NAMES[x])
}

