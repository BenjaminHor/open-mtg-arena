	if fv, found := get_any(v, "fingerprint"); found { if !decode_string(fv, &out.fingerprint) do return fail("AbilityUsageKey.fingerprint") } else { return fail("AbilityUsageKey.fingerprint missing") }
	if fv, found := get_any(v, "grant_chain"); found { if !dec_dyn_ObjectIncarnationRef(fv, &out.grant_chain) do return fail("AbilityUsageKey.grant_chain") }
	return true
}

