		tmp: ExcessRecipient_TargetController
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ExcessRecipient_TargetController) -> bool {
	if fv, found := get_any(v, "source_keyword"); found { if !dec_opt_KeywordKind(fv, &out.source_keyword) do return fail("ExcessRecipient::TargetController.source_keyword") }
	return true
		}) { return fail("ExcessRecipient::TargetController") }
		out^ = tmp
	case: return fail("ExcessRecipient: unknown variant")
	}
	return true
}

