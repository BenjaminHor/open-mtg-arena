	}
	return true
}

encode_ContinuousModification :: proc(b: ^strings.Builder, x: ContinuousModification) {
	#partial switch y in x {
	case ContinuousModification_CopyValues: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CopyValues")
	member(b, first, "values"); enc_ptr_CopiableValues(b, y.values)
	encode_DisplayIdentity_members(b, y.display, first)
	}; strings.write_byte(b, '}')
	case ContinuousModification_CopyChosen: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CopyChosen"); strings.write_byte(b, '}')
	case ContinuousModification_SetName: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetName")
	member(b, first, "name"); encode_string(b, y.name)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SetTextName: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetTextName")
	member(b, first, "name"); encode_string(b, y.name)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SubstituteTextWord: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SubstituteTextWord")
	member(b, first, "substitution"); encode_TextSubstitutionSpec(b, y.substitution)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddPower: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddPower")
	member(b, first, "value"); encode_i32(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddToughness: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddToughness")
	member(b, first, "value"); encode_i32(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SetPower: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetPower")
	member(b, first, "value"); encode_i32(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_SetToughness: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetToughness")
	member(b, first, "value"); encode_i32(b, y.value)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddKeyword: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)
	}; strings.write_byte(b, '}')
	case ContinuousModification_RemoveKeyword: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RemoveKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)
	}; strings.write_byte(b, '}')
	case ContinuousModification_GrantAbility: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GrantAbility")
	member(b, first, "definition"); enc_ptr_AbilityDefinition(b, y.definition)
	}; strings.write_byte(b, '}')
	case ContinuousModification_GrantAllActivatedAbilitiesOf: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GrantAllActivatedAbilitiesOf")
	member(b, first, "source"); encode_TargetFilter(b, y.source)
	if !(y.cap == nil) { member(b, first, "cap"); enc_opt_ActivationRestriction(b, y.cap) }
	if !(y.kind == nil) { member(b, first, "kind"); enc_opt_ActivatedAbilityKind(b, y.kind) }
	}; strings.write_byte(b, '}')
	case ContinuousModification_GrantAllTriggeredAbilitiesOf: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GrantAllTriggeredAbilitiesOf")
	member(b, first, "source"); encode_TargetFilter(b, y.source)
	}; strings.write_byte(b, '}')
	case ContinuousModification_GrantTrigger: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GrantTrigger")
	member(b, first, "trigger"); enc_ptr_TriggerDefinition(b, y.trigger)
	}; strings.write_byte(b, '}')
	case ContinuousModification_GrantReplacement: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GrantReplacement")
	member(b, first, "replacement"); enc_ptr_ReplacementDefinition(b, y.replacement)
	}; strings.write_byte(b, '}')
	case ContinuousModification_RemoveAllAbilities: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RemoveAllAbilities"); strings.write_byte(b, '}')
	case ContinuousModification_AddType: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddType")
	member(b, first, "core_type"); encode_CoreType(b, y.core_type)
	}; strings.write_byte(b, '}')
	case ContinuousModification_RemoveType: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RemoveType")
	member(b, first, "core_type"); encode_CoreType(b, y.core_type)
	}; strings.write_byte(b, '}')
	case ContinuousModification_AddSubtype: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddSubtype")
