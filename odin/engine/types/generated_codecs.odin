encode_DeckList_members :: proc(b: ^strings.Builder, x: DeckList, first: ^bool) {
	if !(x.booster_pack_pool == nil) { member(b, first, "booster_pack_pool"); enc_opt_dyn_string(b, x.booster_pack_pool) }
	member(b, first, "player"); encode_PlayerDeckList(b, x.player)
	member(b, first, "opponent"); encode_PlayerDeckList(b, x.opponent)
	member(b, first, "ai_decks"); enc_dyn_PlayerDeckList(b, x.ai_decks)
	member(b, first, "ai_difficulties"); enc_dyn_string(b, x.ai_difficulties)
	member(b, first, "draft_set_codes"); enc_dyn_string(b, x.draft_set_codes)
}

decode_RecordedActionKind :: proc(v: json.Value, out: ^RecordedActionKind) -> bool {
	when COVERAGE do cov_hit("RecordedActionKind")
	if v.kind != .Object do return fail("RecordedActionKind: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("RecordedActionKind: no tag")
	switch tv.text {
	case "Submitted": when COVERAGE do cov_hit("RecordedActionKind::Submitted"); out^ = RecordedActionKind_Submitted{}
	case "VerifiedAiPriorityPass": when COVERAGE do cov_hit("RecordedActionKind::VerifiedAiPriorityPass");
		tmp: RecordedActionKind_VerifiedAiPriorityPass
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^RecordedActionKind_VerifiedAiPriorityPass) -> bool {
	if fv, found := get_any(v, "semantic_owner"); found { if !decode_PlayerId(fv, &out.semantic_owner) do return fail("RecordedActionKind::VerifiedAiPriorityPass.semantic_owner") } else { return fail("RecordedActionKind::VerifiedAiPriorityPass.semantic_owner missing") }
	return true
		}) { return fail("RecordedActionKind::VerifiedAiPriorityPass") }
		out^ = tmp
	case: return fail("RecordedActionKind: unknown variant")
	}
	return true
}

encode_RecordedActionKind :: proc(b: ^strings.Builder, x: RecordedActionKind) {
	#partial switch y in x {
	case RecordedActionKind_Submitted: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Submitted"); strings.write_byte(b, '}')
	case RecordedActionKind_VerifiedAiPriorityPass: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "VerifiedAiPriorityPass")
	member(b, first, "semantic_owner"); encode_PlayerId(b, y.semantic_owner)
	}; strings.write_byte(b, '}')
	}
}

encode_RecordedActionKind_members :: proc(b: ^strings.Builder, x: RecordedActionKind, first: ^bool) {
	#partial switch y in x {
	case RecordedActionKind_Submitted: _ = y; member(b, first, "type"); json.write_string(b, "Submitted")
	case RecordedActionKind_VerifiedAiPriorityPass: member(b, first, "type"); json.write_string(b, "VerifiedAiPriorityPass")
	member(b, first, "semantic_owner"); encode_PlayerId(b, y.semantic_owner)

	}
}

decode_TriggerMode :: proc(v: json.Value, out: ^TriggerMode) -> bool {
	when COVERAGE do cov_hit("TriggerMode")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("TriggerMode: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("TriggerMode: not a string or object")
	}
	switch variant {
	case "ChangesZone": when COVERAGE do cov_hit("TriggerMode::ChangesZone"); out^ = TriggerMode_ChangesZone{}
	case "ChangesZoneAll": when COVERAGE do cov_hit("TriggerMode::ChangesZoneAll"); out^ = TriggerMode_ChangesZoneAll{}
	case "ChangesController": when COVERAGE do cov_hit("TriggerMode::ChangesController");
		tmp: TriggerMode_ChangesController
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^TriggerMode_ChangesController) -> bool {
	if fv, found := get_any(v, "side"); found { if !decode_ControlChangeSide(fv, &out.side) do return fail("TriggerMode::ChangesController.side") } else { return fail("TriggerMode::ChangesController.side missing") }
	return true
		}) { return fail("TriggerMode::ChangesController") }
		out^ = tmp
	case "LeavesBattlefield": when COVERAGE do cov_hit("TriggerMode::LeavesBattlefield"); out^ = TriggerMode_LeavesBattlefield{}
	case "DamageDone": when COVERAGE do cov_hit("TriggerMode::DamageDone"); out^ = TriggerMode_DamageDone{}
	case "DamageDoneOnce": when COVERAGE do cov_hit("TriggerMode::DamageDoneOnce"); out^ = TriggerMode_DamageDoneOnce{}
	case "DamageAll": when COVERAGE do cov_hit("TriggerMode::DamageAll"); out^ = TriggerMode_DamageAll{}
	case "DamageDealtOnce": when COVERAGE do cov_hit("TriggerMode::DamageDealtOnce"); out^ = TriggerMode_DamageDealtOnce{}
	case "DamageDoneOnceByController": when COVERAGE do cov_hit("TriggerMode::DamageDoneOnceByController"); out^ = TriggerMode_DamageDoneOnceByController{}
	case "DamageReceived": when COVERAGE do cov_hit("TriggerMode::DamageReceived"); out^ = TriggerMode_DamageReceived{}
	case "DamagePreventedOnce": when COVERAGE do cov_hit("TriggerMode::DamagePreventedOnce"); out^ = TriggerMode_DamagePreventedOnce{}
	case "ExcessDamage": when COVERAGE do cov_hit("TriggerMode::ExcessDamage"); out^ = TriggerMode_ExcessDamage{}
	case "ExcessDamageAll": when COVERAGE do cov_hit("TriggerMode::ExcessDamageAll"); out^ = TriggerMode_ExcessDamageAll{}
	case "SpellCast": when COVERAGE do cov_hit("TriggerMode::SpellCast"); out^ = TriggerMode_SpellCast{}
	case "SpellCopy": when COVERAGE do cov_hit("TriggerMode::SpellCopy"); out^ = TriggerMode_SpellCopy{}
