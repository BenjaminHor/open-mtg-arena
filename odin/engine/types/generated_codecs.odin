	if fv, found := get_any(v, "cause"); found { if !decode_DiscardCause(fv, &out.cause) do return fail("PendingDiscardBatch.cause") }
	if fv, found := get_any(v, "fan_out"); found { if !dec_ptr_PendingDiscardFanOut(fv, &out.fan_out) do return fail("PendingDiscardBatch.fan_out") }
	if fv, found := get_any(v, "preceding_events"); found { if !dec_dyn_GameEvent(fv, &out.preceding_events) do return fail("PendingDiscardBatch.preceding_events") }
	return true
}

