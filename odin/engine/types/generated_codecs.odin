	case "SetTo": tmp: HandSizeModification_SetTo; if !decode_u32(body, &tmp._0) do return fail("HandSizeModification::SetTo"); out^ = tmp
	case "AdjustedBy": tmp: HandSizeModification_AdjustedBy; if !decode_i32(body, &tmp._0) do return fail("HandSizeModification::AdjustedBy"); out^ = tmp
	case "EqualTo": tmp: HandSizeModification_EqualTo; if !decode_QuantityExpr(body, &tmp._0) do return fail("HandSizeModification::EqualTo"); out^ = tmp
	case: return fail("HandSizeModification: unknown variant")
	}
	return true
}

encode_HandSizeModification :: proc(b: ^strings.Builder, x: HandSizeModification) {
	#partial switch y in x {
	case HandSizeModification_SetTo: strings.write_byte(b, '{'); json.write_string(b, "SetTo"); strings.write_byte(b, ':'); encode_u32(b, y._0); strings.write_byte(b, '}')
	case HandSizeModification_AdjustedBy: strings.write_byte(b, '{'); json.write_string(b, "AdjustedBy"); strings.write_byte(b, ':'); encode_i32(b, y._0); strings.write_byte(b, '}')
	case HandSizeModification_EqualTo: strings.write_byte(b, '{'); json.write_string(b, "EqualTo"); strings.write_byte(b, ':'); encode_QuantityExpr(b, y._0); strings.write_byte(b, '}')
	}
}

decode_StepEndManaAction :: proc(v: json.Value, out: ^StepEndManaAction) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("StepEndManaAction: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("StepEndManaAction: not a string or object")
	}
	switch variant {
	case "Retain": out^ = StepEndManaAction_Retain{}
	case "Transform": tmp: StepEndManaAction_Transform; if !decode_ManaType(body, &tmp._0) do return fail("StepEndManaAction::Transform"); out^ = tmp
	case: return fail("StepEndManaAction: unknown variant")
	}
	return true
}

encode_StepEndManaAction :: proc(b: ^strings.Builder, x: StepEndManaAction) {
	#partial switch y in x {
	case StepEndManaAction_Retain: _ = y; json.write_string(b, "Retain")
	case StepEndManaAction_Transform: strings.write_byte(b, '{'); json.write_string(b, "Transform"); strings.write_byte(b, ':'); encode_ManaType(b, y._0); strings.write_byte(b, '}')
	}
}

decode_CopiableValues :: proc(v: json.Value, out: ^CopiableValues) -> bool {
	if v.kind != .Object do return fail("CopiableValues: not an object")
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("CopiableValues.name") } else { return fail("CopiableValues.name missing") }
	if fv, found := get_any(v, "mana_cost"); found { if !decode_ManaCost(fv, &out.mana_cost) do return fail("CopiableValues.mana_cost") } else { return fail("CopiableValues.mana_cost missing") }
	if fv, found := get_any(v, "color"); found { if !dec_dyn_ManaColor(fv, &out.color) do return fail("CopiableValues.color") } else { return fail("CopiableValues.color missing") }
	if fv, found := get_any(v, "card_types"); found { if !decode_CardType(fv, &out.card_types) do return fail("CopiableValues.card_types") } else { return fail("CopiableValues.card_types missing") }
	if fv, found := get_any(v, "power"); found { if !dec_opt_i32(fv, &out.power) do return fail("CopiableValues.power") }
	if fv, found := get_any(v, "toughness"); found { if !dec_opt_i32(fv, &out.toughness) do return fail("CopiableValues.toughness") }
	if fv, found := get_any(v, "loyalty"); found { if !dec_opt_u32(fv, &out.loyalty) do return fail("CopiableValues.loyalty") }
	if fv, found := get_any(v, "printed_loyalty"); found { if !dec_opt_PrintedLoyalty(fv, &out.printed_loyalty) do return fail("CopiableValues.printed_loyalty") }
	if fv, found := get_any(v, "keywords"); found { if !dec_dyn_Keyword(fv, &out.keywords) do return fail("CopiableValues.keywords") } else { return fail("CopiableValues.keywords missing") }
	if fv, found := get_any(v, "abilities"); found { if !dec_ptr_dyn_AbilityDefinition(fv, &out.abilities) do return fail("CopiableValues.abilities") } else { return fail("CopiableValues.abilities missing") }
	if fv, found := get_any(v, "trigger_definitions"); found { if !dec_ptr_dyn_TriggerDefinition(fv, &out.trigger_definitions) do return fail("CopiableValues.trigger_definitions") } else { return fail("CopiableValues.trigger_definitions missing") }
	if fv, found := get_any(v, "trigger_printed_origins"); found { if !dec_ptr_dyn_opt_TriggerPrintedOrigin(fv, &out.trigger_printed_origins) do return fail("CopiableValues.trigger_printed_origins") }
	if fv, found := get_any(v, "replacement_definitions"); found { if !dec_ptr_dyn_ReplacementDefinition(fv, &out.replacement_definitions) do return fail("CopiableValues.replacement_definitions") } else { return fail("CopiableValues.replacement_definitions missing") }
	if fv, found := get_any(v, "static_definitions"); found { if !dec_ptr_dyn_StaticDefinition(fv, &out.static_definitions) do return fail("CopiableValues.static_definitions") } else { return fail("CopiableValues.static_definitions missing") }
	if fv, found := get_any(v, "room_halves"); found { if !dec_opt_RoomCopiableHalves(fv, &out.room_halves) do return fail("CopiableValues.room_halves") }
	if fv, found := get_any(v, "prepare_face"); found { if !dec_ptr_BackFaceData(fv, &out.prepare_face) do return fail("CopiableValues.prepare_face") }
	if fv, found := get_any(v, "name_origin"); found { if !decode_CopiedNameOrigin(fv, &out.name_origin) do return fail("CopiableValues.name_origin") }
	return true
}

encode_CopiableValues :: proc(b: ^strings.Builder, x: CopiableValues) {
	strings.write_byte(b, '{')
	f := true
	encode_CopiableValues_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_CopiableValues_members :: proc(b: ^strings.Builder, x: CopiableValues, first: ^bool) {
	member(b, first, "name"); encode_string(b, x.name)
	member(b, first, "mana_cost"); encode_ManaCost(b, x.mana_cost)
	member(b, first, "color"); enc_dyn_ManaColor(b, x.color)
	member(b, first, "card_types"); encode_CardType(b, x.card_types)
	member(b, first, "power"); enc_opt_i32(b, x.power)
	member(b, first, "toughness"); enc_opt_i32(b, x.toughness)
	member(b, first, "loyalty"); enc_opt_u32(b, x.loyalty)
	if !(x.printed_loyalty == nil) { member(b, first, "printed_loyalty"); enc_opt_PrintedLoyalty(b, x.printed_loyalty) }
	member(b, first, "keywords"); enc_dyn_Keyword(b, x.keywords)
	member(b, first, "abilities"); enc_ptr_dyn_AbilityDefinition(b, x.abilities)
	member(b, first, "trigger_definitions"); enc_ptr_dyn_TriggerDefinition(b, x.trigger_definitions)
	member(b, first, "trigger_printed_origins"); enc_ptr_dyn_opt_TriggerPrintedOrigin(b, x.trigger_printed_origins)
	member(b, first, "replacement_definitions"); enc_ptr_dyn_ReplacementDefinition(b, x.replacement_definitions)
	member(b, first, "static_definitions"); enc_ptr_dyn_StaticDefinition(b, x.static_definitions)
	if !(x.room_halves == nil) { member(b, first, "room_halves"); enc_opt_RoomCopiableHalves(b, x.room_halves) }
	if !(x.prepare_face == nil) { member(b, first, "prepare_face"); enc_ptr_BackFaceData(b, x.prepare_face) }
	member(b, first, "name_origin"); encode_CopiedNameOrigin(b, x.name_origin)
}

decode_DisplayIdentity :: proc(v: json.Value, out: ^DisplayIdentity) -> bool {
	if v.kind != .Object do return fail("DisplayIdentity: not an object")
	if fv, found := get_any(v, "display_source"); found { if !decode_DisplaySource(fv, &out.display_source) do return fail("DisplayIdentity.display_source") }
	if fv, found := get_any(v, "printed_ref"); found { if !dec_opt_PrintedCardRef(fv, &out.printed_ref) do return fail("DisplayIdentity.printed_ref") }
	if fv, found := get_any(v, "token_image_ref"); found { if !dec_opt_TokenImageRef(fv, &out.token_image_ref) do return fail("DisplayIdentity.token_image_ref") }
	if fv, found := get_any(v, "token_art"); found { if !dec_opt_TokenArtDescriptor(fv, &out.token_art) do return fail("DisplayIdentity.token_art") }
	return true
}

encode_DisplayIdentity :: proc(b: ^strings.Builder, x: DisplayIdentity) {
	strings.write_byte(b, '{')
	f := true
	encode_DisplayIdentity_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_DisplayIdentity_members :: proc(b: ^strings.Builder, x: DisplayIdentity, first: ^bool) {
	member(b, first, "display_source"); encode_DisplaySource(b, x.display_source)
	member(b, first, "printed_ref"); enc_opt_PrintedCardRef(b, x.printed_ref)
	member(b, first, "token_image_ref"); enc_opt_TokenImageRef(b, x.token_image_ref)
	member(b, first, "token_art"); enc_opt_TokenArtDescriptor(b, x.token_art)
}

decode_TextSubstitutionSpec :: proc(v: json.Value, out: ^TextSubstitutionSpec) -> bool {
	if v.kind != .Object do return fail("TextSubstitutionSpec: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("TextSubstitutionSpec: no tag")
	switch tv.text {
	case "Fixed": tmp: TextSubstitutionSpec_Fixed; if !decode_TextSubstitution(json.get_or_null(v, "data"), &tmp._0) do return fail("TextSubstitutionSpec::Fixed"); out^ = tmp
	case "Chosen":
		tmp: TextSubstitutionSpec_Chosen
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^TextSubstitutionSpec_Chosen) -> bool {
	if fv, found := get_any(v, "domains"); found { if !dec_dyn_TextWordDomain(fv, &out.domains) do return fail("TextSubstitutionSpec::Chosen.domains") } else { return fail("TextSubstitutionSpec::Chosen.domains missing") }
	return true
		}) { return fail("TextSubstitutionSpec::Chosen") }
		out^ = tmp
	case: return fail("TextSubstitutionSpec: unknown variant")
	}
	return true
}

encode_TextSubstitutionSpec :: proc(b: ^strings.Builder, x: TextSubstitutionSpec) {
	#partial switch y in x {
	case TextSubstitutionSpec_Fixed: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Fixed"); member(b, &f, "data"); encode_TextSubstitution(b, y._0); strings.write_byte(b, '}')
	case TextSubstitutionSpec_Chosen: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Chosen"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "domains"); enc_dyn_TextWordDomain(b, y.domains)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

