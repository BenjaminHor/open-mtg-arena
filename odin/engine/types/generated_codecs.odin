decode_PriorityPassingMode :: proc(v: json.Value, out: ^PriorityPassingMode) -> bool {
	when COVERAGE do cov_hit("PriorityPassingMode")
	if v.kind != .String do return fail("PriorityPassingMode: not a string")
	str := v.text
	switch str {
	case "Standard": when COVERAGE do cov_hit("PriorityPassingMode::Standard"); out^ = .Standard
	case "SkipLowUseWindows": when COVERAGE do cov_hit("PriorityPassingMode::SkipLowUseWindows"); out^ = .SkipLowUseWindows
	case "FullControl": when COVERAGE do cov_hit("PriorityPassingMode::FullControl"); out^ = .FullControl
	case: return fail("PriorityPassingMode: unknown variant")
