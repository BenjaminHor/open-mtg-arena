	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("ParsedCondition::SpellTargetsFilter.filter") } else { return fail("ParsedCondition::SpellTargetsFilter.filter missing") }
	return true
		}) { return fail("ParsedCondition::SpellTargetsFilter") }
		out^ = tmp
	case "ControlsCommander":
		tmp: ParsedCondition_ControlsCommander
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ParsedCondition_ControlsCommander) -> bool {
	if fv, found := get_any(v, "ownership"); found { if !decode_CommanderOwnership(fv, &out.ownership) do return fail("ParsedCondition::ControlsCommander.ownership") } else { return fail("ParsedCondition::ControlsCommander.ownership missing") }
	return true
		}) { return fail("ParsedCondition::ControlsCommander") }
		out^ = tmp
	case "And":
		tmp: ParsedCondition_And
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ParsedCondition_And) -> bool {
	if fv, found := get_any(v, "conditions"); found { if !dec_dyn_ParsedCondition(fv, &out.conditions) do return fail("ParsedCondition::And.conditions") } else { return fail("ParsedCondition::And.conditions missing") }
	return true
		}) { return fail("ParsedCondition::And") }
		out^ = tmp
	case "Or":
		tmp: ParsedCondition_Or
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ParsedCondition_Or) -> bool {
	if fv, found := get_any(v, "conditions"); found { if !dec_dyn_ParsedCondition(fv, &out.conditions) do return fail("ParsedCondition::Or.conditions") } else { return fail("ParsedCondition::Or.conditions missing") }
	return true
		}) { return fail("ParsedCondition::Or") }
		out^ = tmp
	case "Not":
		tmp: ParsedCondition_Not
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ParsedCondition_Not) -> bool {
	if fv, found := get_any(v, "condition"); found { if !dec_ptr_ParsedCondition(fv, &out.condition) do return fail("ParsedCondition::Not.condition") } else { return fail("ParsedCondition::Not.condition missing") }
	return true
		}) { return fail("ParsedCondition::Not") }
		out^ = tmp
	case: return fail("ParsedCondition: unknown variant")
	}
	return true
}

encode_ParsedCondition :: proc(b: ^strings.Builder, x: ParsedCondition) {
	#partial switch y in x {
	case ParsedCondition_SourceInZone: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceInZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	}; strings.write_byte(b, '}')
	case ParsedCondition_SourceIsAttacking: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsAttacking"); strings.write_byte(b, '}')
	case ParsedCondition_SourceIsAttackingOrBlocking: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsAttackingOrBlocking"); strings.write_byte(b, '}')
	case ParsedCondition_SourceIsBlocked: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsBlocked"); strings.write_byte(b, '}')
	case ParsedCondition_SourcePowerAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourcePowerAtLeast")
	member(b, first, "minimum"); encode_i32(b, y.minimum)
	}; strings.write_byte(b, '}')
	case ParsedCondition_SourceHasCounterAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceHasCounterAtLeast")
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_SourceHasNoCounter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceHasNoCounter")
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	}; strings.write_byte(b, '}')
	case ParsedCondition_SourceEnteredThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceEnteredThisTurn"); strings.write_byte(b, '}')
	case ParsedCondition_SourceAttackedThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceAttackedThisTurn"); strings.write_byte(b, '}')
	case ParsedCondition_SourceIsCreature: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsCreature"); strings.write_byte(b, '}')
	case ParsedCondition_SourceAttachedTo: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceAttachedTo")
	member(b, first, "required_type"); encode_CoreType(b, y.required_type)
	}; strings.write_byte(b, '}')
	case ParsedCondition_SourceUntappedAttachedTo: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceUntappedAttachedTo")
	member(b, first, "required_type"); encode_CoreType(b, y.required_type)
	}; strings.write_byte(b, '}')
	case ParsedCondition_SourceLacksKeyword: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceLacksKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)
	}; strings.write_byte(b, '}')
	case ParsedCondition_SourceIsColor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SourceIsColor")
	member(b, first, "color"); encode_ManaColor(b, y.color)
	}; strings.write_byte(b, '}')
	case ParsedCondition_FirstSpellThisGame: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "FirstSpellThisGame"); strings.write_byte(b, '}')
	case ParsedCondition_OpponentSearchedLibraryThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpponentSearchedLibraryThisTurn"); strings.write_byte(b, '}')
	case ParsedCondition_BeenAttackedThisStep: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BeenAttackedThisStep"); strings.write_byte(b, '}')
	case ParsedCondition_ZoneCardCountAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ZoneCardCountAtLeast")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	member(b, first, "count"); encode_int(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_ZoneCardTypeCountAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ZoneCardTypeCountAtLeast")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	member(b, first, "count"); encode_int(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_ZoneCoreTypeCardCountAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ZoneCoreTypeCardCountAtLeast")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	member(b, first, "core_type"); encode_CoreType(b, y.core_type)
	member(b, first, "count"); encode_int(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_ZoneSubtypeCardCountAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ZoneSubtypeCardCountAtLeast")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	member(b, first, "subtype"); encode_string(b, y.subtype)
	member(b, first, "count"); encode_int(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_OpponentPoisonAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "OpponentPoisonAtLeast")
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_HandSizeExact: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HandSizeExact")
	member(b, first, "count"); encode_int(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_HandSizeOneOf: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HandSizeOneOf")
	member(b, first, "counts"); enc_dyn_int(b, y.counts)
	}; strings.write_byte(b, '}')
	case ParsedCondition_QuantityVsEachOpponent: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "QuantityVsEachOpponent")
	member(b, first, "lhs"); encode_QuantityRef(b, y.lhs)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityRef(b, y.rhs)
	}; strings.write_byte(b, '}')
	case ParsedCondition_QuantityComparison: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "QuantityComparison")
	member(b, first, "lhs"); encode_QuantityExpr(b, y.lhs)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, y.rhs)
	}; strings.write_byte(b, '}')
	case ParsedCondition_CreaturesYouControlTotalPowerAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CreaturesYouControlTotalPowerAtLeast")
	member(b, first, "minimum"); encode_i32(b, y.minimum)
	}; strings.write_byte(b, '}')
	case ParsedCondition_YouControlLandSubtypeAny: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "YouControlLandSubtypeAny")
	member(b, first, "subtypes"); enc_dyn_string(b, y.subtypes)
	}; strings.write_byte(b, '}')
	case ParsedCondition_YouControlSubtypeCountAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "YouControlSubtypeCountAtLeast")
	member(b, first, "subtype"); encode_string(b, y.subtype)
	member(b, first, "count"); encode_int(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_YouControlCoreTypeCountAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "YouControlCoreTypeCountAtLeast")
	member(b, first, "core_type"); encode_CoreType(b, y.core_type)
	member(b, first, "count"); encode_int(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_YouControlColorPermanentCountAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "YouControlColorPermanentCountAtLeast")
	member(b, first, "color"); encode_ManaColor(b, y.color)
	member(b, first, "count"); encode_int(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_YouControlSubtypeOrGraveyardCardSubtype: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "YouControlSubtypeOrGraveyardCardSubtype")
	member(b, first, "subtype"); encode_string(b, y.subtype)
	}; strings.write_byte(b, '}')
	case ParsedCondition_YouControlLegendaryCreature: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "YouControlLegendaryCreature"); strings.write_byte(b, '}')
	case ParsedCondition_YouControlNamedPlaneswalker: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "YouControlNamedPlaneswalker")
	member(b, first, "name"); encode_string(b, y.name)
	}; strings.write_byte(b, '}')
	case ParsedCondition_ControlsCreatureWithKeyword: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControlsCreatureWithKeyword")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)
	}; strings.write_byte(b, '}')
	case ParsedCondition_YouControlCreatureWithPowerAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "YouControlCreatureWithPowerAtLeast")
	member(b, first, "minimum"); encode_i32(b, y.minimum)
	}; strings.write_byte(b, '}')
	case ParsedCondition_YouControlCreatureWithPt: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "YouControlCreatureWithPt")
	member(b, first, "power"); encode_i32(b, y.power)
	member(b, first, "toughness"); encode_i32(b, y.toughness)
	}; strings.write_byte(b, '}')
	case ParsedCondition_YouControlAnotherColorlessCreature: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "YouControlAnotherColorlessCreature"); strings.write_byte(b, '}')
	case ParsedCondition_YouControlSnowPermanentCountAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "YouControlSnowPermanentCountAtLeast")
	member(b, first, "count"); encode_int(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_YouControlDifferentPowerCreatureCountAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "YouControlDifferentPowerCreatureCountAtLeast")
	member(b, first, "count"); encode_int(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_YouControlLandsWithSameNameAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "YouControlLandsWithSameNameAtLeast")
	member(b, first, "count"); encode_int(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_YouControlNoCreatures: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "YouControlNoCreatures"); strings.write_byte(b, '}')
	case ParsedCondition_YouAttackedThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "YouAttackedThisTurn"); strings.write_byte(b, '}')
	case ParsedCondition_YouAttackedSourceControllerThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "YouAttackedSourceControllerThisTurn"); strings.write_byte(b, '}')
	case ParsedCondition_YouAttackedWithAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "YouAttackedWithAtLeast")
	member(b, first, "count"); encode_u32(b, y.count)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }
	}; strings.write_byte(b, '}')
	case ParsedCondition_YouPlayedLandThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "YouPlayedLandThisTurn"); strings.write_byte(b, '}')
	case ParsedCondition_YouCastSpellThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "YouCastSpellThisTurn")
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }
	}; strings.write_byte(b, '}')
	case ParsedCondition_YouCastNoncreatureSpellThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "YouCastNoncreatureSpellThisTurn"); strings.write_byte(b, '}')
	case ParsedCondition_YouCastSpellCountAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "YouCastSpellCountAtLeast")
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_YouGainedLifeThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "YouGainedLifeThisTurn"); strings.write_byte(b, '}')
	case ParsedCondition_YouCreatedTokenThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "YouCreatedTokenThisTurn"); strings.write_byte(b, '}')
	case ParsedCondition_YouDiscardedCardThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "YouDiscardedCardThisTurn"); strings.write_byte(b, '}')
	case ParsedCondition_YouSacrificedArtifactThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "YouSacrificedArtifactThisTurn"); strings.write_byte(b, '}')
	case ParsedCondition_CreatureDiedThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CreatureDiedThisTurn"); strings.write_byte(b, '}')
	case ParsedCondition_YouHadCreatureEnterThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "YouHadCreatureEnterThisTurn"); strings.write_byte(b, '}')
	case ParsedCondition_YouHadAngelOrBerserkerEnterThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "YouHadAngelOrBerserkerEnterThisTurn"); strings.write_byte(b, '}')
	case ParsedCondition_YouHadArtifactEnterThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "YouHadArtifactEnterThisTurn"); strings.write_byte(b, '}')
	case ParsedCondition_BattlefieldEntriesThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "BattlefieldEntriesThisTurn")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_CardsLeftYourGraveyardThisTurnAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CardsLeftYourGraveyardThisTurnAtLeast")
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}')
	case ParsedCondition_PlayerCountAtLeast: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PlayerCountAtLeast")
	member(b, first, "filter"); encode_PlayerFilter(b, y.filter)
	member(b, first, "minimum"); encode_int(b, y.minimum)
	}; strings.write_byte(b, '}')
	case ParsedCondition_HasCityBlessing: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasCityBlessing"); strings.write_byte(b, '}')
	case ParsedCondition_HasEnduringStory: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasEnduringStory"); strings.write_byte(b, '}')
	case ParsedCondition_CompletedDungeon: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CompletedDungeon")
	if !(y.specific == nil) { member(b, first, "specific"); enc_opt_DungeonId(b, y.specific) }
	}; strings.write_byte(b, '}')
	case ParsedCondition_HasMaxSpeed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasMaxSpeed"); strings.write_byte(b, '}')
	case ParsedCondition_IsYourTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "IsYourTurn"); strings.write_byte(b, '}')
	case ParsedCondition_IsOpponentsTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "IsOpponentsTurn"); strings.write_byte(b, '}')
	case ParsedCondition_CurrentPhaseIs: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CurrentPhaseIs")
	member(b, first, "phases"); enc_dyn_Phase(b, y.phases)
	}; strings.write_byte(b, '}')
	case ParsedCondition_SpellTargetsFilter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SpellTargetsFilter")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case ParsedCondition_ControlsCommander: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControlsCommander")
	member(b, first, "ownership"); encode_CommanderOwnership(b, y.ownership)
	}; strings.write_byte(b, '}')
	case ParsedCondition_And: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "And")
	member(b, first, "conditions"); enc_dyn_ParsedCondition(b, y.conditions)
	}; strings.write_byte(b, '}')
	case ParsedCondition_Or: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Or")
	member(b, first, "conditions"); enc_dyn_ParsedCondition(b, y.conditions)
	}; strings.write_byte(b, '}')
	case ParsedCondition_Not: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Not")
	member(b, first, "condition"); enc_ptr_ParsedCondition(b, y.condition)
	}; strings.write_byte(b, '}')
	}
}

encode_ParsedCondition_members :: proc(b: ^strings.Builder, x: ParsedCondition, first: ^bool) {
	#partial switch y in x {
	case ParsedCondition_SourceInZone: member(b, first, "type"); json.write_string(b, "SourceInZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)

	case ParsedCondition_SourceIsAttacking: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsAttacking")
	case ParsedCondition_SourceIsAttackingOrBlocking: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsAttackingOrBlocking")
	case ParsedCondition_SourceIsBlocked: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsBlocked")
	case ParsedCondition_SourcePowerAtLeast: member(b, first, "type"); json.write_string(b, "SourcePowerAtLeast")
	member(b, first, "minimum"); encode_i32(b, y.minimum)

	case ParsedCondition_SourceHasCounterAtLeast: member(b, first, "type"); json.write_string(b, "SourceHasCounterAtLeast")
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	member(b, first, "count"); encode_u32(b, y.count)

	case ParsedCondition_SourceHasNoCounter: member(b, first, "type"); json.write_string(b, "SourceHasNoCounter")
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)

	case ParsedCondition_SourceEnteredThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "SourceEnteredThisTurn")
	case ParsedCondition_SourceAttackedThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "SourceAttackedThisTurn")
	case ParsedCondition_SourceIsCreature: _ = y; member(b, first, "type"); json.write_string(b, "SourceIsCreature")
	case ParsedCondition_SourceAttachedTo: member(b, first, "type"); json.write_string(b, "SourceAttachedTo")
	member(b, first, "required_type"); encode_CoreType(b, y.required_type)

	case ParsedCondition_SourceUntappedAttachedTo: member(b, first, "type"); json.write_string(b, "SourceUntappedAttachedTo")
	member(b, first, "required_type"); encode_CoreType(b, y.required_type)

	case ParsedCondition_SourceLacksKeyword: member(b, first, "type"); json.write_string(b, "SourceLacksKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)

	case ParsedCondition_SourceIsColor: member(b, first, "type"); json.write_string(b, "SourceIsColor")
	member(b, first, "color"); encode_ManaColor(b, y.color)

	case ParsedCondition_FirstSpellThisGame: _ = y; member(b, first, "type"); json.write_string(b, "FirstSpellThisGame")
	case ParsedCondition_OpponentSearchedLibraryThisTurn: _ = y; member(b, first, "type"); json.write_string(b, "OpponentSearchedLibraryThisTurn")
	case ParsedCondition_BeenAttackedThisStep: _ = y; member(b, first, "type"); json.write_string(b, "BeenAttackedThisStep")
	case ParsedCondition_ZoneCardCountAtLeast: member(b, first, "type"); json.write_string(b, "ZoneCardCountAtLeast")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	member(b, first, "count"); encode_int(b, y.count)

	case ParsedCondition_ZoneCardTypeCountAtLeast: member(b, first, "type"); json.write_string(b, "ZoneCardTypeCountAtLeast")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	member(b, first, "count"); encode_int(b, y.count)

	case ParsedCondition_ZoneCoreTypeCardCountAtLeast: member(b, first, "type"); json.write_string(b, "ZoneCoreTypeCardCountAtLeast")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	member(b, first, "core_type"); encode_CoreType(b, y.core_type)
	member(b, first, "count"); encode_int(b, y.count)

	case ParsedCondition_ZoneSubtypeCardCountAtLeast: member(b, first, "type"); json.write_string(b, "ZoneSubtypeCardCountAtLeast")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	member(b, first, "subtype"); encode_string(b, y.subtype)
	member(b, first, "count"); encode_int(b, y.count)

	case ParsedCondition_OpponentPoisonAtLeast: member(b, first, "type"); json.write_string(b, "OpponentPoisonAtLeast")
	member(b, first, "count"); encode_u32(b, y.count)

	case ParsedCondition_HandSizeExact: member(b, first, "type"); json.write_string(b, "HandSizeExact")
	member(b, first, "count"); encode_int(b, y.count)

	case ParsedCondition_HandSizeOneOf: member(b, first, "type"); json.write_string(b, "HandSizeOneOf")
	member(b, first, "counts"); enc_dyn_int(b, y.counts)

	case ParsedCondition_QuantityVsEachOpponent: member(b, first, "type"); json.write_string(b, "QuantityVsEachOpponent")
	member(b, first, "lhs"); encode_QuantityRef(b, y.lhs)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityRef(b, y.rhs)

	case ParsedCondition_QuantityComparison: member(b, first, "type"); json.write_string(b, "QuantityComparison")
	member(b, first, "lhs"); encode_QuantityExpr(b, y.lhs)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "rhs"); encode_QuantityExpr(b, y.rhs)

	case ParsedCondition_CreaturesYouControlTotalPowerAtLeast: member(b, first, "type"); json.write_string(b, "CreaturesYouControlTotalPowerAtLeast")
	member(b, first, "minimum"); encode_i32(b, y.minimum)

	case ParsedCondition_YouControlLandSubtypeAny: member(b, first, "type"); json.write_string(b, "YouControlLandSubtypeAny")
	member(b, first, "subtypes"); enc_dyn_string(b, y.subtypes)

	case ParsedCondition_YouControlSubtypeCountAtLeast: member(b, first, "type"); json.write_string(b, "YouControlSubtypeCountAtLeast")
	member(b, first, "subtype"); encode_string(b, y.subtype)
	member(b, first, "count"); encode_int(b, y.count)

	case ParsedCondition_YouControlCoreTypeCountAtLeast: member(b, first, "type"); json.write_string(b, "YouControlCoreTypeCountAtLeast")
	member(b, first, "core_type"); encode_CoreType(b, y.core_type)
	member(b, first, "count"); encode_int(b, y.count)

	case ParsedCondition_YouControlColorPermanentCountAtLeast: member(b, first, "type"); json.write_string(b, "YouControlColorPermanentCountAtLeast")
	member(b, first, "color"); encode_ManaColor(b, y.color)
	member(b, first, "count"); encode_int(b, y.count)

	case ParsedCondition_YouControlSubtypeOrGraveyardCardSubtype: member(b, first, "type"); json.write_string(b, "YouControlSubtypeOrGraveyardCardSubtype")
	member(b, first, "subtype"); encode_string(b, y.subtype)

	case ParsedCondition_YouControlLegendaryCreature: _ = y; member(b, first, "type"); json.write_string(b, "YouControlLegendaryCreature")
	case ParsedCondition_YouControlNamedPlaneswalker: member(b, first, "type"); json.write_string(b, "YouControlNamedPlaneswalker")
	member(b, first, "name"); encode_string(b, y.name)

	case ParsedCondition_ControlsCreatureWithKeyword: member(b, first, "type"); json.write_string(b, "ControlsCreatureWithKeyword")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)

	case ParsedCondition_YouControlCreatureWithPowerAtLeast: member(b, first, "type"); json.write_string(b, "YouControlCreatureWithPowerAtLeast")
	member(b, first, "minimum"); encode_i32(b, y.minimum)

	case ParsedCondition_YouControlCreatureWithPt: member(b, first, "type"); json.write_string(b, "YouControlCreatureWithPt")
	member(b, first, "power"); encode_i32(b, y.power)
	member(b, first, "toughness"); encode_i32(b, y.toughness)

	case ParsedCondition_YouControlAnotherColorlessCreature: _ = y; member(b, first, "type"); json.write_string(b, "YouControlAnotherColorlessCreature")
	case ParsedCondition_YouControlSnowPermanentCountAtLeast: member(b, first, "type"); json.write_string(b, "YouControlSnowPermanentCountAtLeast")
	member(b, first, "count"); encode_int(b, y.count)

	case ParsedCondition_YouControlDifferentPowerCreatureCountAtLeast: member(b, first, "type"); json.write_string(b, "YouControlDifferentPowerCreatureCountAtLeast")
	member(b, first, "count"); encode_int(b, y.count)

	case ParsedCondition_YouControlLandsWithSameNameAtLeast: member(b, first, "type"); json.write_string(b, "YouControlLandsWithSameNameAtLeast")
	member(b, first, "count"); encode_int(b, y.count)

	case ParsedCondition_YouControlNoCreatures: _ = y; member(b, first, "type"); json.write_string(b, "YouControlNoCreatures")
