	}; strings.write_byte(b, '}')
	case AttachmentReferent_Host: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Host")
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	}
