	case "SourceInZone": when COVERAGE do cov_hit("ParsedCondition::SourceInZone");
		tmp: ParsedCondition_SourceInZone
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ParsedCondition_SourceInZone) -> bool {
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("ParsedCondition::SourceInZone.zone") } else { return fail("ParsedCondition::SourceInZone.zone missing") }
	return true
		}) { return fail("ParsedCondition::SourceInZone") }
		out^ = tmp
	case "SourceIsAttacking": when COVERAGE do cov_hit("ParsedCondition::SourceIsAttacking"); out^ = ParsedCondition_SourceIsAttacking{}
	case "SourceIsAttackingOrBlocking": when COVERAGE do cov_hit("ParsedCondition::SourceIsAttackingOrBlocking"); out^ = ParsedCondition_SourceIsAttackingOrBlocking{}
