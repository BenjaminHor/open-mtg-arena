	case StaticMode_CanBlockShadow: _ = y; json.write_string(b, "CanBlockShadow")
	case StaticMode_AssignNoCombatDamage: _ = y; json.write_string(b, "AssignNoCombatDamage")
	case StaticMode_UntapsDuringEachOtherPlayersUntapStep: _ = y; json.write_string(b, "UntapsDuringEachOtherPlayersUntapStep")
	case StaticMode_MaxUntapPerType: strings.write_byte(b, '{'); json.write_string(b, "MaxUntapPerType"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "max"); encode_u32(b, y.max)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_EntersWithAdditionalCounters: strings.write_byte(b, '{'); json.write_string(b, "EntersWithAdditionalCounters"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CountersCantBeRemoved: strings.write_byte(b, '{'); json.write_string(b, "CountersCantBeRemoved"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_CountsAsNamed: strings.write_byte(b, '{'); json.write_string(b, "CountsAsNamed"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "name"); encode_string(b, y.name)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case StaticMode_Other: strings.write_byte(b, '{'); json.write_string(b, "Other"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	}
}

