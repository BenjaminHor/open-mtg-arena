	case DamageModification_Minus: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Minus")
	member(b, first, "value"); encode_u32(b, y.value)
	}; strings.write_byte(b, '}')
	case DamageModification_PreventionMinus: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PreventionMinus")
	member(b, first, "value"); encode_PreventionFormula(b, y.value)
	}; strings.write_byte(b, '}')
	case DamageModification_SetToSourcePower: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SetToSourcePower"); strings.write_byte(b, '}')
	case DamageModification_SetTo: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SetTo")
	member(b, first, "value"); encode_u32(b, y.value)
	}; strings.write_byte(b, '}')
	case DamageModification_LifeFloor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "LifeFloor")
	member(b, first, "minimum"); encode_i32(b, y.minimum)
	}; strings.write_byte(b, '}')
	}
}

encode_DamageModification_members :: proc(b: ^strings.Builder, x: DamageModification, first: ^bool) {
