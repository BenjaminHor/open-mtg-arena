decode_PreventionFormula :: proc(v: json.Value, out: ^PreventionFormula) -> bool {
	// untagged: the first variant that decodes wins, as in serde.
	{ tmp: PreventionFormula_Fixed; if decode_quiet_proc(v, &tmp._0, decode_u32) { out^ = tmp; return true } }
	if v.kind == .Object { tmp: PreventionFormula_Quantity; if decode_quiet_proc(v, &tmp, proc(v: json.Value, out: ^PreventionFormula_Quantity) -> bool {
	if fv, found := get_any(v, "quantity"); found { if !decode_QuantityExpr(fv, &out.quantity) do return fail("PreventionFormula::Quantity.quantity") } else { return fail("PreventionFormula::Quantity.quantity missing") }
	return true
	}) { out^ = tmp; return true } }
	if v.kind == .Object { tmp: PreventionFormula_Fraction; if decode_quiet_proc(v, &tmp, proc(v: json.Value, out: ^PreventionFormula_Fraction) -> bool {
	if fv, found := get_any(v, "numerator"); found { if !decode_u32(fv, &out.numerator) do return fail("PreventionFormula::Fraction.numerator") } else { return fail("PreventionFormula::Fraction.numerator missing") }
	if fv, found := get_any(v, "denominator"); found { if !decode_u32(fv, &out.denominator) do return fail("PreventionFormula::Fraction.denominator") } else { return fail("PreventionFormula::Fraction.denominator missing") }
	if fv, found := get_any(v, "rounding"); found { if !decode_RoundingMode(fv, &out.rounding) do return fail("PreventionFormula::Fraction.rounding") } else { return fail("PreventionFormula::Fraction.rounding missing") }
	return true
	}) { out^ = tmp; return true } }
	return fail("PreventionFormula: no untagged variant matched")
}

encode_PreventionFormula :: proc(b: ^strings.Builder, x: PreventionFormula) {
	#partial switch y in x {
	case PreventionFormula_Fixed: encode_u32(b, y._0)
	case PreventionFormula_Quantity: strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "quantity"); encode_QuantityExpr(b, y.quantity)
	}; strings.write_byte(b, '}')
	case PreventionFormula_Fraction: strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "numerator"); encode_u32(b, y.numerator)
	member(b, first, "denominator"); encode_u32(b, y.denominator)
	member(b, first, "rounding"); encode_RoundingMode(b, y.rounding)
	}; strings.write_byte(b, '}')
	}
}

decode_DamageTargetPlayerScope :: proc(v: json.Value, out: ^DamageTargetPlayerScope) -> bool {
	if v.kind != .Object do return fail("DamageTargetPlayerScope: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("DamageTargetPlayerScope: no tag")
	switch tv.text {
	case "Any": out^ = DamageTargetPlayerScope_Any{}
	case "Opponent": out^ = DamageTargetPlayerScope_Opponent{}
	case "Controller": out^ = DamageTargetPlayerScope_Controller{}
	case "SourceChosenPlayer": out^ = DamageTargetPlayerScope_SourceChosenPlayer{}
	case "Specific": tmp: DamageTargetPlayerScope_Specific; if !decode_PlayerId(json.get_or_null(v, "data"), &tmp._0) do return fail("DamageTargetPlayerScope::Specific"); out^ = tmp
	case: return fail("DamageTargetPlayerScope: unknown variant")
	}
	return true
}

encode_DamageTargetPlayerScope :: proc(b: ^strings.Builder, x: DamageTargetPlayerScope) {
	#partial switch y in x {
	case DamageTargetPlayerScope_Any: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Any"); strings.write_byte(b, '}')
	case DamageTargetPlayerScope_Opponent: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Opponent"); strings.write_byte(b, '}')
	case DamageTargetPlayerScope_Controller: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Controller"); strings.write_byte(b, '}')
	case DamageTargetPlayerScope_SourceChosenPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceChosenPlayer"); strings.write_byte(b, '}')
	case DamageTargetPlayerScope_Specific: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Specific"); member(b, &f, "data"); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	}
}

decode_TokenCharacteristics :: proc(v: json.Value, out: ^TokenCharacteristics) -> bool {
	if v.kind != .Object do return fail("TokenCharacteristics: not an object")
	if fv, found := get_any(v, "display_name"); found { if !decode_string(fv, &out.display_name) do return fail("TokenCharacteristics.display_name") } else { return fail("TokenCharacteristics.display_name missing") }
	if fv, found := get_any(v, "power"); found { if !dec_opt_i32(fv, &out.power) do return fail("TokenCharacteristics.power") }
	if fv, found := get_any(v, "toughness"); found { if !dec_opt_i32(fv, &out.toughness) do return fail("TokenCharacteristics.toughness") }
	if fv, found := get_any(v, "loyalty"); found { if !dec_opt_u32(fv, &out.loyalty) do return fail("TokenCharacteristics.loyalty") }
	if fv, found := get_any(v, "core_types"); found { if !dec_dyn_CoreType(fv, &out.core_types) do return fail("TokenCharacteristics.core_types") } else { return fail("TokenCharacteristics.core_types missing") }
	if fv, found := get_any(v, "subtypes"); found { if !dec_dyn_string(fv, &out.subtypes) do return fail("TokenCharacteristics.subtypes") } else { return fail("TokenCharacteristics.subtypes missing") }
	if fv, found := get_any(v, "supertypes"); found { if !dec_dyn_Supertype(fv, &out.supertypes) do return fail("TokenCharacteristics.supertypes") } else { return fail("TokenCharacteristics.supertypes missing") }
	if fv, found := get_any(v, "colors"); found { if !dec_dyn_ManaColor(fv, &out.colors) do return fail("TokenCharacteristics.colors") } else { return fail("TokenCharacteristics.colors missing") }
	if fv, found := get_any(v, "keywords"); found { if !dec_dyn_Keyword(fv, &out.keywords) do return fail("TokenCharacteristics.keywords") } else { return fail("TokenCharacteristics.keywords missing") }
	return true
}

encode_TokenCharacteristics :: proc(b: ^strings.Builder, x: TokenCharacteristics) {
	strings.write_byte(b, '{')
	f := true
	encode_TokenCharacteristics_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_TokenCharacteristics_members :: proc(b: ^strings.Builder, x: TokenCharacteristics, first: ^bool) {
	member(b, first, "display_name"); encode_string(b, x.display_name)
	member(b, first, "power"); enc_opt_i32(b, x.power)
	member(b, first, "toughness"); enc_opt_i32(b, x.toughness)
	if !(x.loyalty == nil) { member(b, first, "loyalty"); enc_opt_u32(b, x.loyalty) }
	member(b, first, "core_types"); enc_dyn_CoreType(b, x.core_types)
	member(b, first, "subtypes"); enc_dyn_string(b, x.subtypes)
	member(b, first, "supertypes"); enc_dyn_Supertype(b, x.supertypes)
	member(b, first, "colors"); enc_dyn_ManaColor(b, x.colors)
	member(b, first, "keywords"); enc_dyn_Keyword(b, x.keywords)
}

decode_TokenAttackRequest :: proc(v: json.Value, out: ^TokenAttackRequest) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("TokenAttackRequest: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("TokenAttackRequest: not a string or object")
	}
	switch variant {
	case "Unspecified": out^ = TokenAttackRequest_Unspecified{}
	case "Named":
		tmp: TokenAttackRequest_Named
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^TokenAttackRequest_Named) -> bool {
	if fv, found := get_any(v, "first"); found { if !decode_PlayerId(fv, &out.first_) do return fail("TokenAttackRequest::Named.first") } else { return fail("TokenAttackRequest::Named.first missing") }
	if fv, found := get_any(v, "rest"); found { if !dec_dyn_PlayerId(fv, &out.rest) do return fail("TokenAttackRequest::Named.rest") } else { return fail("TokenAttackRequest::Named.rest missing") }
	return true
		}) { return fail("TokenAttackRequest::Named") }
		out^ = tmp
	case: return fail("TokenAttackRequest: unknown variant")
	}
	return true
}

encode_TokenAttackRequest :: proc(b: ^strings.Builder, x: TokenAttackRequest) {
	#partial switch y in x {
	case TokenAttackRequest_Unspecified: _ = y; json.write_string(b, "Unspecified")
	case TokenAttackRequest_Named: strings.write_byte(b, '{'); json.write_string(b, "Named"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "first"); encode_PlayerId(b, y.first_)
	member(b, first, "rest"); enc_dyn_PlayerId(b, y.rest)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_TokenHostRequest :: proc(v: json.Value, out: ^TokenHostRequest) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("TokenHostRequest: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("TokenHostRequest: not a string or object")
	}
	switch variant {
	case "NotRequested": out^ = TokenHostRequest_NotRequested{}
	case "Bound": tmp: TokenHostRequest_Bound; if !decode_AttachTarget(body, &tmp._0) do return fail("TokenHostRequest::Bound"); out^ = tmp
	case "Unbound": out^ = TokenHostRequest_Unbound{}
	case: return fail("TokenHostRequest: unknown variant")
	}
	return true
}

encode_TokenHostRequest :: proc(b: ^strings.Builder, x: TokenHostRequest) {
	#partial switch y in x {
	case TokenHostRequest_NotRequested: _ = y; json.write_string(b, "NotRequested")
	case TokenHostRequest_Bound: strings.write_byte(b, '{'); json.write_string(b, "Bound"); strings.write_byte(b, ':'); encode_AttachTarget(b, y._0); strings.write_byte(b, '}')
	case TokenHostRequest_Unbound: _ = y; json.write_string(b, "Unbound")
	}
}

decode_ModalSelectionCondition :: proc(v: json.Value, out: ^ModalSelectionCondition) -> bool {
	if v.kind != .Object do return fail("ModalSelectionCondition: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ModalSelectionCondition: no tag")
	switch tv.text {
	case "Static":
		tmp: ModalSelectionCondition_Static
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ModalSelectionCondition_Static) -> bool {
	if fv, found := get_any(v, "condition"); found { if !decode_StaticCondition(fv, &out.condition) do return fail("ModalSelectionCondition::Static.condition") } else { return fail("ModalSelectionCondition::Static.condition missing") }
	return true
		}) { return fail("ModalSelectionCondition::Static") }
		out^ = tmp
	case "AdditionalCostPaid":
		tmp: ModalSelectionCondition_AdditionalCostPaid
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ModalSelectionCondition_AdditionalCostPaid) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_AdditionalCostPaymentSource(fv, &out.source) do return fail("ModalSelectionCondition::AdditionalCostPaid.source") }
	if fv, found := get_any(v, "origin"); found { if !dec_opt_AdditionalCostOrigin(fv, &out.origin) do return fail("ModalSelectionCondition::AdditionalCostPaid.origin") }
	if fv, found := get_any(v, "origin_ordinal"); found { if !dec_opt_u32(fv, &out.origin_ordinal) do return fail("ModalSelectionCondition::AdditionalCostPaid.origin_ordinal") }
	if fv, found := get_any(v, "variant"); found { if !dec_opt_KickerVariant(fv, &out.variant) do return fail("ModalSelectionCondition::AdditionalCostPaid.variant") }
	if fv, found := get_any(v, "kicker_cost"); found { if !dec_opt_ManaCost(fv, &out.kicker_cost) do return fail("ModalSelectionCondition::AdditionalCostPaid.kicker_cost") }
	if fv, found := get_any(v, "min_count"); found { if !decode_u32(fv, &out.min_count) do return fail("ModalSelectionCondition::AdditionalCostPaid.min_count") } else { out.min_count = default_ModalSelectionCondition_AbilityCondition_default_min_count() }
	return true
		}) { return fail("ModalSelectionCondition::AdditionalCostPaid") }
		out^ = tmp
	case: return fail("ModalSelectionCondition: unknown variant")
	}
	return true
}

encode_ModalSelectionCondition :: proc(b: ^strings.Builder, x: ModalSelectionCondition) {
	#partial switch y in x {
	case ModalSelectionCondition_Static: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Static")
	member(b, first, "condition"); encode_StaticCondition(b, y.condition)
	}; strings.write_byte(b, '}')
	case ModalSelectionCondition_AdditionalCostPaid: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AdditionalCostPaid")
	if !(skip_ModalSelectionCondition_AdditionalCostPaymentSource_is_any(y.source)) { member(b, first, "source"); encode_AdditionalCostPaymentSource(b, y.source) }
	if !(y.origin == nil) { member(b, first, "origin"); enc_opt_AdditionalCostOrigin(b, y.origin) }
	if !(y.origin_ordinal == nil) { member(b, first, "origin_ordinal"); enc_opt_u32(b, y.origin_ordinal) }
	if !(y.variant == nil) { member(b, first, "variant"); enc_opt_KickerVariant(b, y.variant) }
	if !(y.kicker_cost == nil) { member(b, first, "kicker_cost"); enc_opt_ManaCost(b, y.kicker_cost) }
	if !(skip_ModalSelectionCondition_AbilityCondition_is_default_min_count(y.min_count)) { member(b, first, "min_count"); encode_u32(b, y.min_count) }
	}; strings.write_byte(b, '}')
	}
}

encode_ModalSelectionCondition_members :: proc(b: ^strings.Builder, x: ModalSelectionCondition, first: ^bool) {
	#partial switch y in x {
	case ModalSelectionCondition_Static: member(b, first, "type"); json.write_string(b, "Static")
	member(b, first, "condition"); encode_StaticCondition(b, y.condition)

	case ModalSelectionCondition_AdditionalCostPaid: member(b, first, "type"); json.write_string(b, "AdditionalCostPaid")
	if !(skip_ModalSelectionCondition_AdditionalCostPaymentSource_is_any(y.source)) { member(b, first, "source"); encode_AdditionalCostPaymentSource(b, y.source) }
	if !(y.origin == nil) { member(b, first, "origin"); enc_opt_AdditionalCostOrigin(b, y.origin) }
	if !(y.origin_ordinal == nil) { member(b, first, "origin_ordinal"); enc_opt_u32(b, y.origin_ordinal) }
	if !(y.variant == nil) { member(b, first, "variant"); enc_opt_KickerVariant(b, y.variant) }
	if !(y.kicker_cost == nil) { member(b, first, "kicker_cost"); enc_opt_ManaCost(b, y.kicker_cost) }
	if !(skip_ModalSelectionCondition_AbilityCondition_is_default_min_count(y.min_count)) { member(b, first, "min_count"); encode_u32(b, y.min_count) }

	}
}

