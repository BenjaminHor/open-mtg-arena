	member(b, first, "target"); enc_ptr_TargetFilter(b, y.target)
	if !(skip_QuantityRef_is_sum_aggregate(y.aggregate)) { member(b, first, "aggregate"); encode_AggregateFunction(b, y.aggregate) }
	if !(y.group_by == nil) { member(b, first, "group_by"); enc_opt_DamageGroupKey(b, y.group_by) }
	if !(skip_QuantityRef_is_default_damage_kind(y.damage_kind)) { member(b, first, "damage_kind"); encode_DamageKindFilter(b, y.damage_kind) }
	if !(skip_QuantityRef_is_total_damage_channel(y.channel)) { member(b, first, "channel"); encode_DamageChannel(b, y.channel) }
	}; strings.write_byte(b, '}')
	case QuantityRef_NotedNumber: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NotedNumber"); strings.write_byte(b, '}')
	case QuantityRef_ChosenNumber: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChosenNumber"); strings.write_byte(b, '}')
	case QuantityRef_PlayerChosenNumber: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PlayerChosenNumber")
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	}; strings.write_byte(b, '}')
	case QuantityRef_AttackedThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AttackedThisTurn")
	member(b, first, "scope"); encode_CountScope(b, y.scope)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }
	}; strings.write_byte(b, '}')
	case QuantityRef_DescendedThisTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DescendedThisTurn"); strings.write_byte(b, '}')
