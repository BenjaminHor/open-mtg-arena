decode_ProtectionColorSet :: proc(v: json.Value, out: ^ProtectionColorSet) -> bool {
	if v.kind != .String do return fail("ProtectionColorSet: not a string")
	str := v.text
	switch str {
	case "OutsideCommanderColorIdentity": out^ = .OutsideCommanderColorIdentity
	case "AmongPermanentsYouControl": out^ = .AmongPermanentsYouControl
	case: return fail("ProtectionColorSet: unknown variant")
	}
	return true
}

encode_ProtectionColorSet :: proc(b: ^strings.Builder, x: ProtectionColorSet) {
	@(static, rodata) NAMES := [ProtectionColorSet]string{
		.OutsideCommanderColorIdentity = "OutsideCommanderColorIdentity",
		.AmongPermanentsYouControl = "AmongPermanentsYouControl",
	}
	json.write_string(b, NAMES[x])
}

