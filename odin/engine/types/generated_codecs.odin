	when COVERAGE do cov_hit("LifeRedistributionOption")
	if v.kind != .Object do return fail("LifeRedistributionOption: not an object")
	if fv, found := get_any(v, "assignment"); found { if !dec_dyn_t2_PlayerId_i32(fv, &out.assignment) do return fail("LifeRedistributionOption.assignment") } else { return fail("LifeRedistributionOption.assignment missing") }
	return true
}

encode_LifeRedistributionOption :: proc(b: ^strings.Builder, x: LifeRedistributionOption) {
	strings.write_byte(b, '{')
