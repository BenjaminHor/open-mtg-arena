decode_SpellCostCriterion :: proc(v: json.Value, out: ^SpellCostCriterion) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("SpellCostCriterion: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("SpellCostCriterion: not a string or object")
	}
	switch variant {
	case "ManaValue":
		tmp: SpellCostCriterion_ManaValue
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^SpellCostCriterion_ManaValue) -> bool {
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("SpellCostCriterion::ManaValue.comparator") } else { return fail("SpellCostCriterion::ManaValue.comparator missing") }
	if fv, found := get_any(v, "value"); found { if !decode_u32(fv, &out.value) do return fail("SpellCostCriterion::ManaValue.value") } else { return fail("SpellCostCriterion::ManaValue.value missing") }
	return true
		}) { return fail("SpellCostCriterion::ManaValue") }
		out^ = tmp
	case "HasXInCost": out^ = SpellCostCriterion_HasXInCost{}
	case: return fail("SpellCostCriterion: unknown variant")
	}
	return true
}

encode_SpellCostCriterion :: proc(b: ^strings.Builder, x: SpellCostCriterion) {
	#partial switch y in x {
	case SpellCostCriterion_ManaValue: strings.write_byte(b, '{'); json.write_string(b, "ManaValue"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_u32(b, y.value)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case SpellCostCriterion_HasXInCost: _ = y; json.write_string(b, "HasXInCost")
	}
}

