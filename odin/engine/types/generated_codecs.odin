	case "MinDeckSizeOver": when COVERAGE do cov_hit("CompanionCondition::MinDeckSizeOver"); tmp: CompanionCondition_MinDeckSizeOver; if !decode_u32(json.get_or_null(v, "data"), &tmp._0) do return fail("CompanionCondition::MinDeckSizeOver"); out^ = tmp
	case "PermanentsHaveActivatedAbilities": when COVERAGE do cov_hit("CompanionCondition::PermanentsHaveActivatedAbilities"); out^ = CompanionCondition_PermanentsHaveActivatedAbilities{}
	case: return fail("CompanionCondition: unknown variant")
	}
	return true
}

encode_CompanionCondition :: proc(b: ^strings.Builder, x: CompanionCondition) {
	#partial switch y in x {
	case CompanionCondition_EvenManaValues: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EvenManaValues"); strings.write_byte(b, '}')
	case CompanionCondition_NoRepeatedManaSymbols: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NoRepeatedManaSymbols"); strings.write_byte(b, '}')
