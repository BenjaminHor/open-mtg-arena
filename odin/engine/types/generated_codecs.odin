	case "SpellCastOrCopy": out^ = TriggerMode_SpellCastOrCopy{}
	case "AbilityCast": out^ = TriggerMode_AbilityCast{}
	case "AbilityResolves": out^ = TriggerMode_AbilityResolves{}
	case "AbilityTriggered":
		tmp: TriggerMode_AbilityTriggered
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^TriggerMode_AbilityTriggered) -> bool {
	if fv, found := get_any(v, "cause"); found { if !decode_TriggerCause(fv, &out.cause) do return fail("TriggerMode::AbilityTriggered.cause") } else { return fail("TriggerMode::AbilityTriggered.cause missing") }
	if fv, found := get_any(v, "source"); found { if !decode_CausedAbilitySource(fv, &out.source) do return fail("TriggerMode::AbilityTriggered.source") } else { return fail("TriggerMode::AbilityTriggered.source missing") }
	return true
		}) { return fail("TriggerMode::AbilityTriggered") }
		out^ = tmp
	case "SpellAbilityCast": out^ = TriggerMode_SpellAbilityCast{}
