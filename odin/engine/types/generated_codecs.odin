decode_WardCost :: proc(v: json.Value, out: ^WardCost) -> bool {
	when COVERAGE do cov_hit("WardCost")
	if v.kind != .Object do return fail("WardCost: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("WardCost: no tag")
	switch tv.text {
	case "Mana": when COVERAGE do cov_hit("WardCost::Mana"); tmp: WardCost_Mana; if !decode_ManaCost(json.get_or_null(v, "data"), &tmp._0) do return fail("WardCost::Mana"); out^ = tmp
	case "PayLife": when COVERAGE do cov_hit("WardCost::PayLife"); tmp: WardCost_PayLife; if !decode_i32(json.get_or_null(v, "data"), &tmp._0) do return fail("WardCost::PayLife"); out^ = tmp
	case "PayLifeEqualToPower": when COVERAGE do cov_hit("WardCost::PayLifeEqualToPower"); out^ = WardCost_PayLifeEqualToPower{}
	case "Discard": when COVERAGE do cov_hit("WardCost::Discard");
		tmp: WardCost_Discard
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^WardCost_Discard) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("WardCost::Discard.count") } else { return fail("WardCost::Discard.count missing") }
	if fv, found := get_any(v, "filter"); found { if !dec_opt_TargetFilter(fv, &out.filter) do return fail("WardCost::Discard.filter") }
	if fv, found := get_any(v, "selection"); found { if !decode_CardSelectionMode(fv, &out.selection) do return fail("WardCost::Discard.selection") } else { return fail("WardCost::Discard.selection missing") }
	return true
		}) { return fail("WardCost::Discard") }
		out^ = tmp
	case "Sacrifice": when COVERAGE do cov_hit("WardCost::Sacrifice");
		tmp: WardCost_Sacrifice
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^WardCost_Sacrifice) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("WardCost::Sacrifice.count") } else { return fail("WardCost::Sacrifice.count missing") }
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("WardCost::Sacrifice.filter") } else { return fail("WardCost::Sacrifice.filter missing") }
	return true
		}) { return fail("WardCost::Sacrifice") }
		out^ = tmp
	case "Waterbend": when COVERAGE do cov_hit("WardCost::Waterbend"); tmp: WardCost_Waterbend; if !decode_ManaCost(json.get_or_null(v, "data"), &tmp._0) do return fail("WardCost::Waterbend"); out^ = tmp
	case "Compound": when COVERAGE do cov_hit("WardCost::Compound"); tmp: WardCost_Compound; if !dec_dyn_WardCost(json.get_or_null(v, "data"), &tmp._0) do return fail("WardCost::Compound"); out^ = tmp
	case "GetPlayerCounters": when COVERAGE do cov_hit("WardCost::GetPlayerCounters");
		tmp: WardCost_GetPlayerCounters
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^WardCost_GetPlayerCounters) -> bool {
	if fv, found := get_any(v, "counter_kind"); found { if !decode_PlayerCounterKind(fv, &out.counter_kind) do return fail("WardCost::GetPlayerCounters.counter_kind") } else { return fail("WardCost::GetPlayerCounters.counter_kind missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("WardCost::GetPlayerCounters.count") } else { return fail("WardCost::GetPlayerCounters.count missing") }
	return true
		}) { return fail("WardCost::GetPlayerCounters") }
		out^ = tmp
	case: return fail("WardCost: unknown variant")
	}
	return true
}

encode_WardCost :: proc(b: ^strings.Builder, x: WardCost) {
	#partial switch y in x {
	case WardCost_Mana: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Mana"); member(b, &f, "data"); encode_ManaCost(b, y._0); strings.write_byte(b, '}')
	case WardCost_PayLife: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PayLife"); member(b, &f, "data"); encode_i32(b, y._0); strings.write_byte(b, '}')
	case WardCost_PayLifeEqualToPower: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PayLifeEqualToPower"); strings.write_byte(b, '}')
	case WardCost_Discard: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Discard"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter)
	member(b, first, "selection"); encode_CardSelectionMode(b, y.selection)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WardCost_Sacrifice: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Sacrifice"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WardCost_Waterbend: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Waterbend"); member(b, &f, "data"); encode_ManaCost(b, y._0); strings.write_byte(b, '}')
	case WardCost_Compound: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Compound"); member(b, &f, "data"); enc_dyn_WardCost(b, y._0); strings.write_byte(b, '}')
	case WardCost_GetPlayerCounters: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "GetPlayerCounters"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "counter_kind"); encode_PlayerCounterKind(b, y.counter_kind)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_ActivationRestriction :: proc(v: json.Value, out: ^ActivationRestriction) -> bool {
	when COVERAGE do cov_hit("ActivationRestriction")
	if v.kind != .Object do return fail("ActivationRestriction: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ActivationRestriction: no tag")
	switch tv.text {
	case "AsSorcery": when COVERAGE do cov_hit("ActivationRestriction::AsSorcery"); out^ = ActivationRestriction_AsSorcery{}
	case "AsInstant": when COVERAGE do cov_hit("ActivationRestriction::AsInstant"); out^ = ActivationRestriction_AsInstant{}
	case "DuringYourTurn": when COVERAGE do cov_hit("ActivationRestriction::DuringYourTurn"); out^ = ActivationRestriction_DuringYourTurn{}
	case "DuringYourUpkeep": when COVERAGE do cov_hit("ActivationRestriction::DuringYourUpkeep"); out^ = ActivationRestriction_DuringYourUpkeep{}
	case "DuringCombat": when COVERAGE do cov_hit("ActivationRestriction::DuringCombat"); out^ = ActivationRestriction_DuringCombat{}
	case "BeforeAttackersDeclared": when COVERAGE do cov_hit("ActivationRestriction::BeforeAttackersDeclared"); out^ = ActivationRestriction_BeforeAttackersDeclared{}
	case "BeforeCombatDamage": when COVERAGE do cov_hit("ActivationRestriction::BeforeCombatDamage"); out^ = ActivationRestriction_BeforeCombatDamage{}
	case "OnlyOnceEachTurn": when COVERAGE do cov_hit("ActivationRestriction::OnlyOnceEachTurn"); out^ = ActivationRestriction_OnlyOnceEachTurn{}
	case "OnlyOnce": when COVERAGE do cov_hit("ActivationRestriction::OnlyOnce"); out^ = ActivationRestriction_OnlyOnce{}
	case "MaxTimesEachTurn": when COVERAGE do cov_hit("ActivationRestriction::MaxTimesEachTurn");
		tmp: ActivationRestriction_MaxTimesEachTurn
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^ActivationRestriction_MaxTimesEachTurn) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_u8(fv, &out.count) do return fail("ActivationRestriction::MaxTimesEachTurn.count") } else { return fail("ActivationRestriction::MaxTimesEachTurn.count missing") }
	return true
		}) { return fail("ActivationRestriction::MaxTimesEachTurn") }
		out^ = tmp
	case "RequiresCondition": when COVERAGE do cov_hit("ActivationRestriction::RequiresCondition");
		tmp: ActivationRestriction_RequiresCondition
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^ActivationRestriction_RequiresCondition) -> bool {
	if fv, found := get_any(v, "condition"); found { if !dec_opt_ParsedCondition(fv, &out.condition) do return fail("ActivationRestriction::RequiresCondition.condition") }
	return true
		}) { return fail("ActivationRestriction::RequiresCondition") }
		out^ = tmp
	case "IsSolved": when COVERAGE do cov_hit("ActivationRestriction::IsSolved"); out^ = ActivationRestriction_IsSolved{}
	case "SourceIsHarnessed": when COVERAGE do cov_hit("ActivationRestriction::SourceIsHarnessed"); out^ = ActivationRestriction_SourceIsHarnessed{}
	case "ClassLevelIs": when COVERAGE do cov_hit("ActivationRestriction::ClassLevelIs");
		tmp: ActivationRestriction_ClassLevelIs
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^ActivationRestriction_ClassLevelIs) -> bool {
	if fv, found := get_any(v, "level"); found { if !decode_u8(fv, &out.level) do return fail("ActivationRestriction::ClassLevelIs.level") } else { return fail("ActivationRestriction::ClassLevelIs.level missing") }
	return true
		}) { return fail("ActivationRestriction::ClassLevelIs") }
		out^ = tmp
	case "LevelCounterRange": when COVERAGE do cov_hit("ActivationRestriction::LevelCounterRange");
		tmp: ActivationRestriction_LevelCounterRange
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^ActivationRestriction_LevelCounterRange) -> bool {
	if fv, found := get_any(v, "minimum"); found { if !decode_u32(fv, &out.minimum) do return fail("ActivationRestriction::LevelCounterRange.minimum") } else { return fail("ActivationRestriction::LevelCounterRange.minimum missing") }
	if fv, found := get_any(v, "maximum"); found { if !dec_opt_u32(fv, &out.maximum) do return fail("ActivationRestriction::LevelCounterRange.maximum") }
	return true
		}) { return fail("ActivationRestriction::LevelCounterRange") }
		out^ = tmp
	case "CounterThreshold": when COVERAGE do cov_hit("ActivationRestriction::CounterThreshold");
		tmp: ActivationRestriction_CounterThreshold
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^ActivationRestriction_CounterThreshold) -> bool {
	if fv, found := get_any(v, "counters"); found { if !decode_CounterMatch(fv, &out.counters) do return fail("ActivationRestriction::CounterThreshold.counters") } else { return fail("ActivationRestriction::CounterThreshold.counters missing") }
	if fv, found := get_any(v, "minimum"); found { if !decode_u32(fv, &out.minimum) do return fail("ActivationRestriction::CounterThreshold.minimum") } else { return fail("ActivationRestriction::CounterThreshold.minimum missing") }
	if fv, found := get_any(v, "maximum"); found { if !dec_opt_u32(fv, &out.maximum) do return fail("ActivationRestriction::CounterThreshold.maximum") }
	return true
		}) { return fail("ActivationRestriction::CounterThreshold") }
		out^ = tmp
	case "MatchesCardCastTiming": when COVERAGE do cov_hit("ActivationRestriction::MatchesCardCastTiming"); out^ = ActivationRestriction_MatchesCardCastTiming{}
	case: return fail("ActivationRestriction: unknown variant")
	}
	return true
}

encode_ActivationRestriction :: proc(b: ^strings.Builder, x: ActivationRestriction) {
	#partial switch y in x {
	case ActivationRestriction_AsSorcery: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AsSorcery"); strings.write_byte(b, '}')
	case ActivationRestriction_AsInstant: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AsInstant"); strings.write_byte(b, '}')
	case ActivationRestriction_DuringYourTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DuringYourTurn"); strings.write_byte(b, '}')
	case ActivationRestriction_DuringYourUpkeep: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DuringYourUpkeep"); strings.write_byte(b, '}')
	case ActivationRestriction_DuringCombat: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DuringCombat"); strings.write_byte(b, '}')
	case ActivationRestriction_BeforeAttackersDeclared: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BeforeAttackersDeclared"); strings.write_byte(b, '}')
	case ActivationRestriction_BeforeCombatDamage: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BeforeCombatDamage"); strings.write_byte(b, '}')
	case ActivationRestriction_OnlyOnceEachTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OnlyOnceEachTurn"); strings.write_byte(b, '}')
	case ActivationRestriction_OnlyOnce: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OnlyOnce"); strings.write_byte(b, '}')
	case ActivationRestriction_MaxTimesEachTurn: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "MaxTimesEachTurn"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "count"); encode_u8(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ActivationRestriction_RequiresCondition: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RequiresCondition"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "condition"); enc_opt_ParsedCondition(b, y.condition)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ActivationRestriction_IsSolved: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "IsSolved"); strings.write_byte(b, '}')
	case ActivationRestriction_SourceIsHarnessed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceIsHarnessed"); strings.write_byte(b, '}')
	case ActivationRestriction_ClassLevelIs: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ClassLevelIs"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "level"); encode_u8(b, y.level)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ActivationRestriction_LevelCounterRange: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "LevelCounterRange"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	if !(y.maximum == nil) { member(b, first, "maximum"); enc_opt_u32(b, y.maximum) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ActivationRestriction_CounterThreshold: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CounterThreshold"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "counters"); encode_CounterMatch(b, y.counters)
	member(b, first, "minimum"); encode_u32(b, y.minimum)
	if !(y.maximum == nil) { member(b, first, "maximum"); enc_opt_u32(b, y.maximum) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ActivationRestriction_MatchesCardCastTiming: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "MatchesCardCastTiming"); strings.write_byte(b, '}')
	}
}

decode_PartnerType :: proc(v: json.Value, out: ^PartnerType) -> bool {
	when COVERAGE do cov_hit("PartnerType")
	if v.kind != .Object do return fail("PartnerType: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("PartnerType: no tag")
	switch tv.text {
	case "Generic": when COVERAGE do cov_hit("PartnerType::Generic"); out^ = PartnerType_Generic{}
	case "With": when COVERAGE do cov_hit("PartnerType::With"); tmp: PartnerType_With; if !decode_string(json.get_or_null(v, "data"), &tmp._0) do return fail("PartnerType::With"); out^ = tmp
	case "FriendsForever": when COVERAGE do cov_hit("PartnerType::FriendsForever"); out^ = PartnerType_FriendsForever{}
	case "CharacterSelect": when COVERAGE do cov_hit("PartnerType::CharacterSelect"); out^ = PartnerType_CharacterSelect{}
	case "DoctorsCompanion": when COVERAGE do cov_hit("PartnerType::DoctorsCompanion"); out^ = PartnerType_DoctorsCompanion{}
	case "ChooseABackground": when COVERAGE do cov_hit("PartnerType::ChooseABackground"); out^ = PartnerType_ChooseABackground{}
	case: return fail("PartnerType: unknown variant")
	}
	return true
}

encode_PartnerType :: proc(b: ^strings.Builder, x: PartnerType) {
	#partial switch y in x {
	case PartnerType_Generic: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Generic"); strings.write_byte(b, '}')
	case PartnerType_With: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "With"); member(b, &f, "data"); encode_string(b, y._0); strings.write_byte(b, '}')
	case PartnerType_FriendsForever: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "FriendsForever"); strings.write_byte(b, '}')
	case PartnerType_CharacterSelect: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CharacterSelect"); strings.write_byte(b, '}')
	case PartnerType_DoctorsCompanion: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DoctorsCompanion"); strings.write_byte(b, '}')
	case PartnerType_ChooseABackground: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChooseABackground"); strings.write_byte(b, '}')
	}
}

