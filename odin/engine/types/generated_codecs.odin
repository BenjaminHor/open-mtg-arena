}

decode_ControlChangeEvidence :: proc(v: json.Value, out: ^ControlChangeEvidence) -> bool {
	when COVERAGE do cov_hit("ControlChangeEvidence")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ControlChangeEvidence: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ControlChangeEvidence: not a string or object")
	}
	switch variant {
	case "Unrecorded": when COVERAGE do cov_hit("ControlChangeEvidence::Unrecorded"); out^ = ControlChangeEvidence_Unrecorded{}
	case "Observed": when COVERAGE do cov_hit("ControlChangeEvidence::Observed"); tmp: ControlChangeEvidence_Observed; if !decode_u64(body, &tmp._0) do return fail("ControlChangeEvidence::Observed"); out^ = tmp
	case: return fail("ControlChangeEvidence: unknown variant")
	}
	return true
}

encode_ControlChangeEvidence :: proc(b: ^strings.Builder, x: ControlChangeEvidence) {
	#partial switch y in x {
	case ControlChangeEvidence_Unrecorded: _ = y; json.write_string(b, "Unrecorded")
	case ControlChangeEvidence_Observed: strings.write_byte(b, '{'); json.write_string(b, "Observed"); strings.write_byte(b, ':'); encode_u64(b, y._0); strings.write_byte(b, '}')
	}
}

