	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("DebugAction::GivePlayerCounters.player_id") } else { return fail("DebugAction::GivePlayerCounters.player_id missing") }
	if fv, found := get_any(v, "counter_kind"); found { if !decode_PlayerCounterKind(fv, &out.counter_kind) do return fail("DebugAction::GivePlayerCounters.counter_kind") } else { return fail("DebugAction::GivePlayerCounters.counter_kind missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("DebugAction::GivePlayerCounters.count") } else { return fail("DebugAction::GivePlayerCounters.count missing") }
	return true
		}) { return fail("DebugAction::GivePlayerCounters") }
		out^ = tmp
	case "GiveEnergy": when COVERAGE do cov_hit("DebugAction::GiveEnergy");
		tmp: DebugAction_GiveEnergy
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^DebugAction_GiveEnergy) -> bool {
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("DebugAction::GiveEnergy.player_id") } else { return fail("DebugAction::GiveEnergy.player_id missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("DebugAction::GiveEnergy.count") } else { return fail("DebugAction::GiveEnergy.count missing") }
	return true
		}) { return fail("DebugAction::GiveEnergy") }
		out^ = tmp
	case "AddMana": when COVERAGE do cov_hit("DebugAction::AddMana");
		tmp: DebugAction_AddMana
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^DebugAction_AddMana) -> bool {
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("DebugAction::AddMana.player_id") } else { return fail("DebugAction::AddMana.player_id missing") }
	if fv, found := get_any(v, "mana"); found { if !dec_dyn_ManaType(fv, &out.mana) do return fail("DebugAction::AddMana.mana") } else { return fail("DebugAction::AddMana.mana missing") }
	return true
		}) { return fail("DebugAction::AddMana") }
		out^ = tmp
	case "SetInfiniteMana": when COVERAGE do cov_hit("DebugAction::SetInfiniteMana");
		tmp: DebugAction_SetInfiniteMana
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^DebugAction_SetInfiniteMana) -> bool {
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("DebugAction::SetInfiniteMana.player_id") } else { return fail("DebugAction::SetInfiniteMana.player_id missing") }
	if fv, found := get_any(v, "enabled"); found { if !decode_bool(fv, &out.enabled) do return fail("DebugAction::SetInfiniteMana.enabled") } else { return fail("DebugAction::SetInfiniteMana.enabled missing") }
	return true
		}) { return fail("DebugAction::SetInfiniteMana") }
		out^ = tmp
	case "SetPhase": when COVERAGE do cov_hit("DebugAction::SetPhase");
		tmp: DebugAction_SetPhase
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^DebugAction_SetPhase) -> bool {
	if fv, found := get_any(v, "phase"); found { if !decode_Phase(fv, &out.phase) do return fail("DebugAction::SetPhase.phase") } else { return fail("DebugAction::SetPhase.phase missing") }
	if fv, found := get_any(v, "active_player"); found { if !decode_PlayerId(fv, &out.active_player) do return fail("DebugAction::SetPhase.active_player") } else { return fail("DebugAction::SetPhase.active_player missing") }
	return true
		}) { return fail("DebugAction::SetPhase") }
		out^ = tmp
	case "RunStateBasedActions": when COVERAGE do cov_hit("DebugAction::RunStateBasedActions"); out^ = DebugAction_RunStateBasedActions{}
	case "CreateToken": when COVERAGE do cov_hit("DebugAction::CreateToken");
		tmp: DebugAction_CreateToken
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^DebugAction_CreateToken) -> bool {
	if fv, found := get_any(v, "request"); found { if !decode_DebugTokenRequest(fv, &out.request) do return fail("DebugAction::CreateToken.request") } else { return fail("DebugAction::CreateToken.request missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("DebugAction::CreateToken.count") } else { out.count = default_DebugAction_default_debug_create_count() }
	if fv, found := get_any(v, "run_etb"); found { if !decode_bool(fv, &out.run_etb) do return fail("DebugAction::CreateToken.run_etb") } else { out.run_etb = default_DebugAction_default_true() }
	return true
		}) { return fail("DebugAction::CreateToken") }
		out^ = tmp
	case "CreateTokenCopy": when COVERAGE do cov_hit("DebugAction::CreateTokenCopy");
		tmp: DebugAction_CreateTokenCopy
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^DebugAction_CreateTokenCopy) -> bool {
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("DebugAction::CreateTokenCopy.source_id") } else { return fail("DebugAction::CreateTokenCopy.source_id missing") }
	if fv, found := get_any(v, "owner"); found { if !decode_PlayerId(fv, &out.owner) do return fail("DebugAction::CreateTokenCopy.owner") } else { return fail("DebugAction::CreateTokenCopy.owner missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("DebugAction::CreateTokenCopy.count") } else { out.count = default_DebugAction_default_debug_create_count() }
	if fv, found := get_any(v, "nonlegendary"); found { if !decode_bool(fv, &out.nonlegendary) do return fail("DebugAction::CreateTokenCopy.nonlegendary") }
	return true
		}) { return fail("DebugAction::CreateTokenCopy") }
		out^ = tmp
	case: return fail("DebugAction: unknown variant")
	}
	return true
}

encode_DebugAction :: proc(b: ^strings.Builder, x: DebugAction) {
	#partial switch y in x {
	case DebugAction_MoveToZone: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "MoveToZone"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "to_zone"); encode_Zone(b, y.to_zone)
	if !(y.library_position == nil) { member(b, first, "library_position"); enc_opt_LibraryPosition(b, y.library_position) }
	member(b, first, "simulate"); encode_bool(b, y.simulate)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_CreateCard: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CreateCard"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card_name"); encode_string(b, y.card_name)
	member(b, first, "owner"); encode_PlayerId(b, y.owner)
	member(b, first, "zone"); encode_Zone(b, y.zone)
	member(b, first, "count"); encode_u32(b, y.count)
	if !(y.attach_to == nil) { member(b, first, "attach_to"); enc_opt_AttachTarget(b, y.attach_to) }
	member(b, first, "run_etb"); encode_bool(b, y.run_etb)
	member(b, first, "nonlegendary"); encode_bool(b, y.nonlegendary)
	member(b, first, "creation_kind"); encode_DebugCardCreationKind(b, y.creation_kind)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_RemoveObject: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RemoveObject"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_Sacrifice: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Sacrifice"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_DrawCards: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DrawCards"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_Mill: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Mill"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case DebugAction_Reveal: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Reveal"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "count"); encode_u32(b, y.count)
