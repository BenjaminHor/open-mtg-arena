		tmp: TriggerCollectionOperation_ObserveEventBatch
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^TriggerCollectionOperation_ObserveEventBatch) -> bool {
	if fv, found := get_any(v, "events"); found { if !dec_dyn_GameEvent(fv, &out.events) do return fail("TriggerCollectionOperation::ObserveEventBatch.events") } else { return fail("TriggerCollectionOperation::ObserveEventBatch.events missing") }
	return true
