	return true
		}) { return fail("TriggerCollectionOperation::MarkSpeedTriggerUsed") }
		out^ = tmp
	case: return fail("TriggerCollectionOperation: unknown variant")
	}
	return true
}

encode_TriggerCollectionOperation :: proc(b: ^strings.Builder, x: TriggerCollectionOperation) {
	#partial switch y in x {
	case TriggerCollectionOperation_PrepareEventBatch: strings.write_byte(b, '{'); json.write_string(b, "PrepareEventBatch"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "events"); enc_dyn_GameEvent(b, y.events)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerCollectionOperation_ObserveEventBatch: strings.write_byte(b, '{'); json.write_string(b, "ObserveEventBatch"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "events"); enc_dyn_GameEvent(b, y.events)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerCollectionOperation_RecordTriggerFired: strings.write_byte(b, '{'); json.write_string(b, "RecordTriggerFired"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "constraint"); enc_opt_TriggerConstraint(b, y.constraint)
	member(b, first, "source_context"); enc_ptr_opt_TriggerSourceContext(b, y.source_context)
	member(b, first, "definition_ref"); enc_opt_TriggerDefinitionRef(b, y.definition_ref)
	member(b, first, "event"); encode_GameEvent(b, y.event)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerCollectionOperation_RecordBatchedZoneChanges: strings.write_byte(b, '{'); json.write_string(b, "RecordBatchedZoneChanges"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "definition_ref"); encode_TriggerDefinitionRef(b, y.definition_ref)
	member(b, first, "turn_zone_change_keys"); enc_dyn_t2_u32_int(b, y.turn_zone_change_keys)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerCollectionOperation_AllocateTimestamp: _ = y; json.write_string(b, "AllocateTimestamp")
	case TriggerCollectionOperation_RecordCombatDamageCastingPermission: strings.write_byte(b, '{'); json.write_string(b, "RecordCombatDamageCastingPermission"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	member(b, first, "grants_freerunning"); encode_bool(b, y.grants_freerunning)
	member(b, first, "creature_types"); enc_dyn_string(b, y.creature_types)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case TriggerCollectionOperation_MarkSpeedTriggerUsed: strings.write_byte(b, '{'); json.write_string(b, "MarkSpeedTriggerUsed"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

