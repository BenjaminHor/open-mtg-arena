	if fv, found := get_any(v, "initiative"); found { if !dec_opt_PlayerId(fv, &out.initiative) do return fail("GameState.initiative") }
	return true
}

encode_GameState :: proc(b: ^strings.Builder, x: GameState) {
	strings.write_byte(b, '{')
	f := true
	encode_GameState_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_GameState_members :: proc(b: ^strings.Builder, x: GameState, first: ^bool) {
	member(b, first, "turn_number"); encode_u32(b, x.turn_number)
	member(b, first, "active_player"); encode_PlayerId(b, x.active_player)
	member(b, first, "phase"); encode_Phase(b, x.phase)
	member(b, first, "players"); enc_dyn_Player(b, x.players)
	member(b, first, "priority_player"); encode_PlayerId(b, x.priority_player)
	if !(x.turn_decision_controller == nil) { member(b, first, "turn_decision_controller"); enc_opt_PlayerId(b, x.turn_decision_controller) }
	if !(x.turn_decision_control_timestamp == nil) { member(b, first, "turn_decision_control_timestamp"); enc_opt_u64(b, x.turn_decision_control_timestamp) }
	if !(x.active_full_turn_control == nil) { member(b, first, "active_full_turn_control"); enc_opt_ActivePlayerControl(b, x.active_full_turn_control) }
	if !(x.active_combat_phase_control == nil) { member(b, first, "active_combat_phase_control"); enc_opt_ActivePlayerControl(b, x.active_combat_phase_control) }
	if !(skip_GameState_ActiveLibrarySearches_is_empty_ActiveLibrarySearches(x.active_library_searches)) { member(b, first, "active_library_searches"); encode_ActiveLibrarySearches(b, x.active_library_searches) }
	if !(skip_GameState_ActiveSearchDecisionControls_is_empty_ActiveSearchDecisionControls(x.active_search_decision_controls)) { member(b, first, "active_search_decision_controls"); encode_ActiveSearchDecisionControls(b, x.active_search_decision_controls) }
	member(b, first, "objects"); encode_with_sorted(b, x.objects)
	member(b, first, "next_object_id"); encode_u64(b, x.next_object_id)
	member(b, first, "next_delayed_trigger_token"); encode_u64(b, x.next_delayed_trigger_token)
	member(b, first, "next_delayed_trigger_instance"); encode_u64(b, x.next_delayed_trigger_instance)
	member(b, first, "next_resolution_cast_offer_id"); encode_u64(b, x.next_resolution_cast_offer_id)
	member(b, first, "next_logical_zone_change_group_id"); encode_u64(b, x.next_logical_zone_change_group_id)
