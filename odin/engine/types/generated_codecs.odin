	if fv, found := get_any(v, "phase"); found { if !decode_Phase(fv, &out.phase) do return fail("DelayedTriggerCondition::AtNextPhaseForPlayer.phase") } else { return fail("DelayedTriggerCondition::AtNextPhaseForPlayer.phase missing") }
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("DelayedTriggerCondition::AtNextPhaseForPlayer.player") } else { return fail("DelayedTriggerCondition::AtNextPhaseForPlayer.player missing") }
	if fv, found := get_any(v, "gate"); found { if !decode_TurnGate(fv, &out.gate) do return fail("DelayedTriggerCondition::AtNextPhaseForPlayer.gate") } else { out.gate = TurnGate(TurnGate_None{}) }
	if fv, found := get_any(v, "binding"); found { if !decode_DelayedTriggerPlayerBinding(fv, &out.binding) do return fail("DelayedTriggerCondition::AtNextPhaseForPlayer.binding") } else { out.binding = DelayedTriggerPlayerBinding(DelayedTriggerPlayerBinding_Controller{}) }
	return true
		}) { return fail("DelayedTriggerCondition::AtNextPhaseForPlayer") }
		out^ = tmp
	case "AtBeginningOfAddedPhase": when COVERAGE do cov_hit("DelayedTriggerCondition::AtBeginningOfAddedPhase");
		tmp: DelayedTriggerCondition_AtBeginningOfAddedPhase
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DelayedTriggerCondition_AtBeginningOfAddedPhase) -> bool {
	if fv, found := get_any(v, "phase"); found { if !decode_Phase(fv, &out.phase) do return fail("DelayedTriggerCondition::AtBeginningOfAddedPhase.phase") } else { return fail("DelayedTriggerCondition::AtBeginningOfAddedPhase.phase missing") }
	if fv, found := get_any(v, "entry"); found { if !dec_opt_ExtraPhaseId(fv, &out.entry) do return fail("DelayedTriggerCondition::AtBeginningOfAddedPhase.entry") }
	return true
		}) { return fail("DelayedTriggerCondition::AtBeginningOfAddedPhase") }
		out^ = tmp
