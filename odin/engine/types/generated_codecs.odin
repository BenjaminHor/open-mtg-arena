	if v.kind != .Object do return fail("AttackerInfo: not an object")
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("AttackerInfo.object_id") } else { return fail("AttackerInfo.object_id missing") }
