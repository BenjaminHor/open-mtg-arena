	if !(!x.mana_spent_to_cast) { member(b, first, "mana_spent_to_cast"); encode_bool(b, x.mana_spent_to_cast) }
	if !(skip_GameObject_ColoredManaCount_is_empty_ColoredManaCount(x.colors_spent_to_cast)) { member(b, first, "colors_spent_to_cast"); encode_ColoredManaCount(b, x.colors_spent_to_cast) }
	if !(x.mana_spent_to_cast_amount == 0) { member(b, first, "mana_spent_to_cast_amount"); encode_u32(b, x.mana_spent_to_cast_amount) }
	if !(x.phyrexian_life_paid == 0) { member(b, first, "phyrexian_life_paid"); encode_u32(b, x.phyrexian_life_paid) }
	if !((len(x.mana_spent_source_snapshots) == 0)) { member(b, first, "mana_spent_source_snapshots"); enc_dyn_ManaSpentSourceSnapshot(b, x.mana_spent_source_snapshots) }
	if !(skip_GameObject_is_default_PhaseStatus(x.phase_status)) { member(b, first, "phase_status"); encode_PhaseStatus(b, x.phase_status) }
	if !((len(x.mana_spent_to_activate) == 0)) { member(b, first, "mana_spent_to_activate"); enc_dyn_ManaType(b, x.mana_spent_to_activate) }
}

decode_ResolvedCommandJournalEntry :: proc(v: json.Value, out: ^ResolvedCommandJournalEntry) -> bool {
	when COVERAGE do cov_hit("ResolvedCommandJournalEntry")
	if v.kind != .Object do return fail("ResolvedCommandJournalEntry: not an object")
	if fv, found := get_any(v, "ordinal"); found { if !decode_ResolvedCommandOrdinal(fv, &out.ordinal) do return fail("ResolvedCommandJournalEntry.ordinal") } else { return fail("ResolvedCommandJournalEntry.ordinal missing") }
	if fv, found := get_any(v, "node"); found { if !decode_RulesExecutionNodeRef(fv, &out.node) do return fail("ResolvedCommandJournalEntry.node") } else { return fail("ResolvedCommandJournalEntry.node missing") }
	if fv, found := get_any(v, "command"); found { if !dec_opt_ResolvedRulesCommand(fv, &out.command) do return fail("ResolvedCommandJournalEntry.command") }
	return true
}

encode_ResolvedCommandJournalEntry :: proc(b: ^strings.Builder, x: ResolvedCommandJournalEntry) {
