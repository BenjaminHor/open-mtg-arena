	if fv, found := get_any(v, "index"); found { if !decode_u8(fv, &out.index) do return fail("StickerLocator.index") } else { return fail("StickerLocator.index missing") }
	return true
}

encode_StickerLocator :: proc(b: ^strings.Builder, x: StickerLocator) {
	strings.write_byte(b, '{')
	f := true
	encode_StickerLocator_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_StickerLocator_members :: proc(b: ^strings.Builder, x: StickerLocator, first: ^bool) {
	member(b, first, "sheet"); encode_string(b, x.sheet)
	member(b, first, "index"); encode_u8(b, x.index)
}

