decode_DiscardFrameId :: proc(v: json.Value, out: ^DiscardFrameId) -> bool {
	when COVERAGE do cov_hit("DiscardFrameId")
	return decode_u64(v, cast(^u64)out)
}

encode_DiscardFrameId :: proc(b: ^strings.Builder, x: DiscardFrameId) {
	encode_u64(b, cast(u64)x)
}

decode_HeroEventKind :: proc(v: json.Value, out: ^HeroEventKind) -> bool {
	when COVERAGE do cov_hit("HeroEventKind")
	if v.kind != .Object do return fail("HeroEventKind: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("HeroEventKind: no tag")
	switch tv.text {
	case "ChromeOverload": when COVERAGE do cov_hit("HeroEventKind::ChromeOverload"); out^ = HeroEventKind_ChromeOverload{}
	case "KrangStratagem": when COVERAGE do cov_hit("HeroEventKind::KrangStratagem");
		tmp: HeroEventKind_KrangStratagem
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^HeroEventKind_KrangStratagem) -> bool {
	if fv, found := get_any(v, "remaining"); found { if !decode_int(fv, &out.remaining) do return fail("HeroEventKind::KrangStratagem.remaining") } else { return fail("HeroEventKind::KrangStratagem.remaining missing") }
	return true
		}) { return fail("HeroEventKind::KrangStratagem") }
		out^ = tmp
	case "Smackdown": when COVERAGE do cov_hit("HeroEventKind::Smackdown"); out^ = HeroEventKind_Smackdown{}
	case "RatKingRevolution": when COVERAGE do cov_hit("HeroEventKind::RatKingRevolution"); out^ = HeroEventKind_RatKingRevolution{}
	case "SavantiCurse": when COVERAGE do cov_hit("HeroEventKind::SavantiCurse"); out^ = HeroEventKind_SavantiCurse{}
	case "Infiltration": when COVERAGE do cov_hit("HeroEventKind::Infiltration"); out^ = HeroEventKind_Infiltration{}
	case "VillainMayhem": when COVERAGE do cov_hit("HeroEventKind::VillainMayhem"); out^ = HeroEventKind_VillainMayhem{}
	case: return fail("HeroEventKind: unknown variant")
	}
	return true
}

encode_HeroEventKind :: proc(b: ^strings.Builder, x: HeroEventKind) {
	#partial switch y in x {
	case HeroEventKind_ChromeOverload: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChromeOverload"); strings.write_byte(b, '}')
	case HeroEventKind_KrangStratagem: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "KrangStratagem"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "remaining"); encode_int(b, y.remaining)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case HeroEventKind_Smackdown: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Smackdown"); strings.write_byte(b, '}')
	case HeroEventKind_RatKingRevolution: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RatKingRevolution"); strings.write_byte(b, '}')
	case HeroEventKind_SavantiCurse: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SavantiCurse"); strings.write_byte(b, '}')
	case HeroEventKind_Infiltration: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Infiltration"); strings.write_byte(b, '}')
	case HeroEventKind_VillainMayhem: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "VillainMayhem"); strings.write_byte(b, '}')
	}
}

