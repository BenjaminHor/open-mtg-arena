decode_TargetSelectionSlot :: proc(v: json.Value, out: ^TargetSelectionSlot) -> bool {
	when COVERAGE do cov_hit("TargetSelectionSlot")
	if v.kind != .Object do return fail("TargetSelectionSlot: not an object")
	if fv, found := get_any(v, "legal_targets"); found { if !dec_dyn_TargetRef(fv, &out.legal_targets) do return fail("TargetSelectionSlot.legal_targets") } else { return fail("TargetSelectionSlot.legal_targets missing") }
	if fv, found := get_any(v, "optional"); found { if !decode_bool(fv, &out.optional) do return fail("TargetSelectionSlot.optional") }
	if fv, found := get_any(v, "chooser"); found { if !dec_opt_PlayerId(fv, &out.chooser) do return fail("TargetSelectionSlot.chooser") }
	if fv, found := get_any(v, "effect_kind"); found { if !decode_EffectKind(fv, &out.effect_kind) do return fail("TargetSelectionSlot.effect_kind") } else { return fail("TargetSelectionSlot.effect_kind missing") }
	if fv, found := get_any(v, "effect_detail"); found { if !decode_TargetEffectDetail(fv, &out.effect_detail) do return fail("TargetSelectionSlot.effect_detail") } else { out.effect_detail = TargetEffectDetail(TargetEffectDetail_None{}) }
	return true
}

encode_TargetSelectionSlot :: proc(b: ^strings.Builder, x: TargetSelectionSlot) {
	strings.write_byte(b, '{')
