decode_PlayerId :: proc(v: json.Value, out: ^PlayerId) -> bool {
	when COVERAGE do cov_hit("PlayerId")
	return decode_u8(v, cast(^u8)out)
}

encode_PlayerId :: proc(b: ^strings.Builder, x: PlayerId) {
	encode_u8(b, cast(u8)x)
}

decode_Phase :: proc(v: json.Value, out: ^Phase) -> bool {
	when COVERAGE do cov_hit("Phase")
	if v.kind != .String do return fail("Phase: not a string")
	str := v.text
	switch str {
	case "Untap": when COVERAGE do cov_hit("Phase::Untap"); out^ = .Untap
	case "Upkeep": when COVERAGE do cov_hit("Phase::Upkeep"); out^ = .Upkeep
	case "Draw": when COVERAGE do cov_hit("Phase::Draw"); out^ = .Draw
	case "PreCombatMain": when COVERAGE do cov_hit("Phase::PreCombatMain"); out^ = .PreCombatMain
	case "BeginCombat": when COVERAGE do cov_hit("Phase::BeginCombat"); out^ = .BeginCombat
	case "DeclareAttackers": when COVERAGE do cov_hit("Phase::DeclareAttackers"); out^ = .DeclareAttackers
	case "DeclareBlockers": when COVERAGE do cov_hit("Phase::DeclareBlockers"); out^ = .DeclareBlockers
	case "CombatDamage": when COVERAGE do cov_hit("Phase::CombatDamage"); out^ = .CombatDamage
	case "EndCombat": when COVERAGE do cov_hit("Phase::EndCombat"); out^ = .EndCombat
	case "PostCombatMain": when COVERAGE do cov_hit("Phase::PostCombatMain"); out^ = .PostCombatMain
	case "End": when COVERAGE do cov_hit("Phase::End"); out^ = .End
	case "Cleanup": when COVERAGE do cov_hit("Phase::Cleanup"); out^ = .Cleanup
	case: return fail("Phase: unknown variant")
	}
	return true
}

encode_Phase :: proc(b: ^strings.Builder, x: Phase) {
	@(static, rodata) NAMES := [Phase]string{
		.Untap = "Untap",
		.Upkeep = "Upkeep",
		.Draw = "Draw",
		.PreCombatMain = "PreCombatMain",
		.BeginCombat = "BeginCombat",
		.DeclareAttackers = "DeclareAttackers",
		.DeclareBlockers = "DeclareBlockers",
		.CombatDamage = "CombatDamage",
		.EndCombat = "EndCombat",
		.PostCombatMain = "PostCombatMain",
		.End = "End",
		.Cleanup = "Cleanup",
	}
	json.write_string(b, NAMES[x])
}

decode_Player :: proc(v: json.Value, out: ^Player) -> bool {
	when COVERAGE do cov_hit("Player")
	if v.kind != .Object do return fail("Player: not an object")
	if fv, found := get_any(v, "id"); found { if !decode_PlayerId(fv, &out.id) do return fail("Player.id") } else { return fail("Player.id missing") }
	if fv, found := get_any(v, "life"); found { if !decode_i32(fv, &out.life) do return fail("Player.life") } else { return fail("Player.life missing") }
	if fv, found := get_any(v, "has_no_life_total"); found { if !decode_bool(fv, &out.has_no_life_total) do return fail("Player.has_no_life_total") }
	if fv, found := get_any(v, "mana_pool"); found { if !decode_ManaPool(fv, &out.mana_pool) do return fail("Player.mana_pool") } else { return fail("Player.mana_pool missing") }
	if fv, found := get_any(v, "library"); found { if !dec_PVec_ObjectId(fv, &out.library) do return fail("Player.library") } else { return fail("Player.library missing") }
	if fv, found := get_any(v, "hand"); found { if !dec_PVec_ObjectId(fv, &out.hand) do return fail("Player.hand") } else { return fail("Player.hand missing") }
	if fv, found := get_any(v, "graveyard"); found { if !dec_PVec_ObjectId(fv, &out.graveyard) do return fail("Player.graveyard") } else { return fail("Player.graveyard missing") }
	if fv, found := get_any(v, "attraction_deck"); found { if !dec_PVec_ObjectId(fv, &out.attraction_deck) do return fail("Player.attraction_deck") }
	if fv, found := get_any(v, "contraption_deck"); found { if !dec_PVec_ObjectId(fv, &out.contraption_deck) do return fail("Player.contraption_deck") }
	if fv, found := get_any(v, "contraption_crank_sprocket"); found { if !decode_u8(fv, &out.contraption_crank_sprocket) do return fail("Player.contraption_crank_sprocket") } else { out.contraption_crank_sprocket = default_Player_default_contraption_crank_sprocket() }
	if fv, found := get_any(v, "sticker_sheets"); found { if !dec_dyn_string(fv, &out.sticker_sheets) do return fail("Player.sticker_sheets") }
	if fv, found := get_any(v, "has_drawn_this_turn"); found { if !decode_bool(fv, &out.has_drawn_this_turn) do return fail("Player.has_drawn_this_turn") } else { return fail("Player.has_drawn_this_turn missing") }
	if fv, found := get_any(v, "lands_played_this_turn"); found { if !decode_u8(fv, &out.lands_played_this_turn) do return fail("Player.lands_played_this_turn") } else { return fail("Player.lands_played_this_turn missing") }
	if fv, found := get_any(v, "poison_counters"); found { if !decode_u32(fv, &out.poison_counters) do return fail("Player.poison_counters") } else { return fail("Player.poison_counters missing") }
	if fv, found := get_any(v, "energy"); found { if !decode_u32(fv, &out.energy) do return fail("Player.energy") }
	if fv, found := get_any(v, "life_gained_this_turn"); found { if !decode_u32(fv, &out.life_gained_this_turn) do return fail("Player.life_gained_this_turn") }
	if fv, found := get_any(v, "life_lost_this_turn"); found { if !decode_u32(fv, &out.life_lost_this_turn) do return fail("Player.life_lost_this_turn") }
	if fv, found := get_any(v, "energy_paid_or_lost_this_turn"); found { if !decode_u32(fv, &out.energy_paid_or_lost_this_turn) do return fail("Player.energy_paid_or_lost_this_turn") }
	if fv, found := get_any(v, "life_lost_last_turn"); found { if !decode_u32(fv, &out.life_lost_last_turn) do return fail("Player.life_lost_last_turn") }
	if fv, found := get_any(v, "spells_cast_last_turn"); found { if !decode_u32(fv, &out.spells_cast_last_turn) do return fail("Player.spells_cast_last_turn") }
	if fv, found := get_any(v, "descended_this_turn"); found { if !decode_bool(fv, &out.descended_this_turn) do return fail("Player.descended_this_turn") }
	if fv, found := get_any(v, "cards_drawn_this_turn"); found { if !decode_u32(fv, &out.cards_drawn_this_turn) do return fail("Player.cards_drawn_this_turn") }
	if fv, found := get_any(v, "cards_drawn_last_turn"); found { if !decode_u32(fv, &out.cards_drawn_last_turn) do return fail("Player.cards_drawn_last_turn") }
	if fv, found := get_any(v, "opponent_spells_cast_since_own_last_turn"); found { if !decode_u32(fv, &out.opponent_spells_cast_since_own_last_turn) do return fail("Player.opponent_spells_cast_since_own_last_turn") }
	if fv, found := get_any(v, "cards_drawn_this_step"); found { if !decode_u32(fv, &out.cards_drawn_this_step) do return fail("Player.cards_drawn_this_step") }
	if fv, found := get_any(v, "speed"); found { if !dec_opt_u8(fv, &out.speed) do return fail("Player.speed") }
	if fv, found := get_any(v, "speed_trigger_used_this_turn"); found { if !decode_bool(fv, &out.speed_trigger_used_this_turn) do return fail("Player.speed_trigger_used_this_turn") }
	if fv, found := get_any(v, "crimes_committed_this_turn"); found { if !decode_u32(fv, &out.crimes_committed_this_turn) do return fail("Player.crimes_committed_this_turn") }
	if fv, found := get_any(v, "drew_from_empty_library"); found { if !decode_bool(fv, &out.drew_from_empty_library) do return fail("Player.drew_from_empty_library") }
	if fv, found := get_any(v, "turns_taken"); found { if !decode_u32(fv, &out.turns_taken) do return fail("Player.turns_taken") }
	if fv, found := get_any(v, "starting_deck_size"); found { if !decode_u32(fv, &out.starting_deck_size) do return fail("Player.starting_deck_size") }
	if fv, found := get_any(v, "is_eliminated"); found { if !decode_bool(fv, &out.is_eliminated) do return fail("Player.is_eliminated") }
	if fv, found := get_any(v, "bending_types_this_turn"); found { if !dec_dyn_BendingType(fv, &out.bending_types_this_turn) do return fail("Player.bending_types_this_turn") }
	if fv, found := get_any(v, "player_counters"); found { if !dec_map_PlayerCounterKind_u32(fv, &out.player_counters) do return fail("Player.player_counters") }
	if fv, found := get_any(v, "status"); found { if !decode_PlayerStatus(fv, &out.status) do return fail("Player.status") }
	if fv, found := get_any(v, "companion"); found { if !dec_opt_CompanionInfo(fv, &out.companion) do return fail("Player.companion") }
	if fv, found := get_any(v, "noted_number"); found { if !dec_opt_i32(fv, &out.noted_number) do return fail("Player.noted_number") }
	if fv, found := get_any(v, "chosen_attributes"); found { if !dec_dyn_ChosenAttribute(fv, &out.chosen_attributes) do return fail("Player.chosen_attributes") }
	return true
}

encode_Player :: proc(b: ^strings.Builder, x: Player) {
	strings.write_byte(b, '{')
	f := true
	encode_Player_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_Player_members :: proc(b: ^strings.Builder, x: Player, first: ^bool) {
	member(b, first, "id"); encode_PlayerId(b, x.id)
	member(b, first, "life"); encode_i32(b, x.life)
	if !(!x.has_no_life_total) { member(b, first, "has_no_life_total"); encode_bool(b, x.has_no_life_total) }
	member(b, first, "mana_pool"); encode_ManaPool(b, x.mana_pool)
	member(b, first, "library"); enc_PVec_ObjectId(b, x.library)
	member(b, first, "hand"); enc_PVec_ObjectId(b, x.hand)
	member(b, first, "graveyard"); enc_PVec_ObjectId(b, x.graveyard)
	member(b, first, "attraction_deck"); enc_PVec_ObjectId(b, x.attraction_deck)
	member(b, first, "contraption_deck"); enc_PVec_ObjectId(b, x.contraption_deck)
	member(b, first, "contraption_crank_sprocket"); encode_u8(b, x.contraption_crank_sprocket)
	if !((len(x.sticker_sheets) == 0)) { member(b, first, "sticker_sheets"); enc_dyn_string(b, x.sticker_sheets) }
	member(b, first, "has_drawn_this_turn"); encode_bool(b, x.has_drawn_this_turn)
	member(b, first, "lands_played_this_turn"); encode_u8(b, x.lands_played_this_turn)
	member(b, first, "poison_counters"); encode_u32(b, x.poison_counters)
	member(b, first, "energy"); encode_u32(b, x.energy)
	member(b, first, "life_gained_this_turn"); encode_u32(b, x.life_gained_this_turn)
	member(b, first, "life_lost_this_turn"); encode_u32(b, x.life_lost_this_turn)
	if !(x.energy_paid_or_lost_this_turn == 0) { member(b, first, "energy_paid_or_lost_this_turn"); encode_u32(b, x.energy_paid_or_lost_this_turn) }
	member(b, first, "life_lost_last_turn"); encode_u32(b, x.life_lost_last_turn)
	if !(x.spells_cast_last_turn == 0) { member(b, first, "spells_cast_last_turn"); encode_u32(b, x.spells_cast_last_turn) }
	member(b, first, "descended_this_turn"); encode_bool(b, x.descended_this_turn)
	member(b, first, "cards_drawn_this_turn"); encode_u32(b, x.cards_drawn_this_turn)
	if !(x.cards_drawn_last_turn == 0) { member(b, first, "cards_drawn_last_turn"); encode_u32(b, x.cards_drawn_last_turn) }
	if !(x.opponent_spells_cast_since_own_last_turn == 0) { member(b, first, "opponent_spells_cast_since_own_last_turn"); encode_u32(b, x.opponent_spells_cast_since_own_last_turn) }
	member(b, first, "cards_drawn_this_step"); encode_u32(b, x.cards_drawn_this_step)
	if !(x.speed == nil) { member(b, first, "speed"); enc_opt_u8(b, x.speed) }
	member(b, first, "speed_trigger_used_this_turn"); encode_bool(b, x.speed_trigger_used_this_turn)
	member(b, first, "crimes_committed_this_turn"); encode_u32(b, x.crimes_committed_this_turn)
	member(b, first, "drew_from_empty_library"); encode_bool(b, x.drew_from_empty_library)
	member(b, first, "turns_taken"); encode_u32(b, x.turns_taken)
	if !(x.starting_deck_size == 0) { member(b, first, "starting_deck_size"); encode_u32(b, x.starting_deck_size) }
	member(b, first, "is_eliminated"); encode_bool(b, x.is_eliminated)
	member(b, first, "bending_types_this_turn"); enc_dyn_BendingType(b, x.bending_types_this_turn)
	if !((len(x.player_counters) == 0)) { member(b, first, "player_counters"); enc_map_PlayerCounterKind_u32(b, x.player_counters) }
	member(b, first, "status"); encode_PlayerStatus(b, x.status)
	if !(x.companion == nil) { member(b, first, "companion"); enc_opt_CompanionInfo(b, x.companion) }
	if !(x.noted_number == nil) { member(b, first, "noted_number"); enc_opt_i32(b, x.noted_number) }
	if !((len(x.chosen_attributes) == 0)) { member(b, first, "chosen_attributes"); enc_dyn_ChosenAttribute(b, x.chosen_attributes) }
	member(b, first, "can_look_at_top_of_library"); encode_bool(b, x.can_look_at_top_of_library)
	member(b, first, "commander_color_identity"); enc_dyn_ManaColor(b, x.commander_color_identity)
}

decode_ActivePlayerControl :: proc(v: json.Value, out: ^ActivePlayerControl) -> bool {
	when COVERAGE do cov_hit("ActivePlayerControl")
	if v.kind != .Object do return fail("ActivePlayerControl: not an object")
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("ActivePlayerControl.controller") } else { return fail("ActivePlayerControl.controller missing") }
	if fv, found := get_any(v, "timestamp"); found { if !decode_u64(fv, &out.timestamp) do return fail("ActivePlayerControl.timestamp") } else { return fail("ActivePlayerControl.timestamp missing") }
	return true
}

encode_ActivePlayerControl :: proc(b: ^strings.Builder, x: ActivePlayerControl) {
	strings.write_byte(b, '{')
	f := true
	encode_ActivePlayerControl_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ActivePlayerControl_members :: proc(b: ^strings.Builder, x: ActivePlayerControl, first: ^bool) {
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	member(b, first, "timestamp"); encode_u64(b, x.timestamp)
}

decode_ActiveLibrarySearches :: proc(v: json.Value, out: ^ActiveLibrarySearches) -> bool {
	when COVERAGE do cov_hit("ActiveLibrarySearches")
	return dec_map_PlayerId_ActiveLibrarySearch(v, cast(^map[PlayerId]ActiveLibrarySearch)out)
}

encode_ActiveLibrarySearches :: proc(b: ^strings.Builder, x: ActiveLibrarySearches) {
