		}) { return fail("QuantityRef::SpellsCastThisGame") }
		out^ = tmp
	case "CardsCycled":
		tmp: QuantityRef_CardsCycled
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityRef_CardsCycled) -> bool {
	if fv, found := get_any(v, "scope"); found { if !decode_CountScope(fv, &out.scope) do return fail("QuantityRef::CardsCycled.scope") } else { return fail("QuantityRef::CardsCycled.scope missing") }
	if fv, found := get_any(v, "window"); found { if !decode_CyclingHistoryWindow(fv, &out.window) do return fail("QuantityRef::CardsCycled.window") } else { return fail("QuantityRef::CardsCycled.window missing") }
	if fv, found := get_any(v, "name"); found { if !dec_opt_string(fv, &out.name) do return fail("QuantityRef::CardsCycled.name") }
	return true
		}) { return fail("QuantityRef::CardsCycled") }
		out^ = tmp
	case "CounterAddedThisTurn":
		tmp: QuantityRef_CounterAddedThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityRef_CounterAddedThisTurn) -> bool {
	if fv, found := get_any(v, "actor"); found { if !decode_CountScope(fv, &out.actor) do return fail("QuantityRef::CounterAddedThisTurn.actor") } else { return fail("QuantityRef::CounterAddedThisTurn.actor missing") }
	if fv, found := get_any(v, "counters"); found { if !decode_CounterMatch(fv, &out.counters) do return fail("QuantityRef::CounterAddedThisTurn.counters") } else { return fail("QuantityRef::CounterAddedThisTurn.counters missing") }
	if fv, found := get_any(v, "target"); found { if !decode_TargetFilter(fv, &out.target) do return fail("QuantityRef::CounterAddedThisTurn.target") } else { return fail("QuantityRef::CounterAddedThisTurn.target missing") }
	return true
		}) { return fail("QuantityRef::CounterAddedThisTurn") }
		out^ = tmp
	case "CardsDiscardedThisTurn":
		tmp: QuantityRef_CardsDiscardedThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityRef_CardsDiscardedThisTurn) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerScope(fv, &out.player) do return fail("QuantityRef::CardsDiscardedThisTurn.player") } else { return fail("QuantityRef::CardsDiscardedThisTurn.player missing") }
	return true
		}) { return fail("QuantityRef::CardsDiscardedThisTurn") }
		out^ = tmp
	case "TokensCreatedThisTurn":
		tmp: QuantityRef_TokensCreatedThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityRef_TokensCreatedThisTurn) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerScope(fv, &out.player) do return fail("QuantityRef::TokensCreatedThisTurn.player") } else { return fail("QuantityRef::TokensCreatedThisTurn.player missing") }
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("QuantityRef::TokensCreatedThisTurn.filter") } else { return fail("QuantityRef::TokensCreatedThisTurn.filter missing") }
	return true
		}) { return fail("QuantityRef::TokensCreatedThisTurn") }
		out^ = tmp
	case "PlayerActionsThisTurn":
		tmp: QuantityRef_PlayerActionsThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityRef_PlayerActionsThisTurn) -> bool {
	if fv, found := get_any(v, "player"); found { if !decode_PlayerScope(fv, &out.player) do return fail("QuantityRef::PlayerActionsThisTurn.player") } else { return fail("QuantityRef::PlayerActionsThisTurn.player missing") }
	if fv, found := get_any(v, "action"); found { if !decode_PlayerActionKind(fv, &out.action) do return fail("QuantityRef::PlayerActionsThisTurn.action") } else { return fail("QuantityRef::PlayerActionsThisTurn.action missing") }
	return true
		}) { return fail("QuantityRef::PlayerActionsThisTurn") }
		out^ = tmp
	case "DungeonsCompleted": out^ = QuantityRef_DungeonsCompleted{}
	case "CostXPaid": out^ = QuantityRef_CostXPaid{}
	case "KickerCount": out^ = QuantityRef_KickerCount{}
	case "AdditionalCostPaymentCount": out^ = QuantityRef_AdditionalCostPaymentCount{}
	case "AdditionalCostPaymentCountFor":
		tmp: QuantityRef_AdditionalCostPaymentCountFor
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityRef_AdditionalCostPaymentCountFor) -> bool {
	if fv, found := get_any(v, "origin"); found { if !decode_AdditionalCostOrigin(fv, &out.origin) do return fail("QuantityRef::AdditionalCostPaymentCountFor.origin") } else { return fail("QuantityRef::AdditionalCostPaymentCountFor.origin missing") }
	if fv, found := get_any(v, "origin_ordinal"); found { if !dec_opt_u32(fv, &out.origin_ordinal) do return fail("QuantityRef::AdditionalCostPaymentCountFor.origin_ordinal") }
	return true
		}) { return fail("QuantityRef::AdditionalCostPaymentCountFor") }
		out^ = tmp
	case "ConvokedCreatureCount": out^ = QuantityRef_ConvokedCreatureCount{}
	case "TimesCostPaidThisResolution": out^ = QuantityRef_TimesCostPaidThisResolution{}
	case "ManaSpentToCast":
		tmp: QuantityRef_ManaSpentToCast
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityRef_ManaSpentToCast) -> bool {
	if fv, found := get_any(v, "scope"); found { if !decode_CastManaObjectScope(fv, &out.scope) do return fail("QuantityRef::ManaSpentToCast.scope") } else { return fail("QuantityRef::ManaSpentToCast.scope missing") }
	if fv, found := get_any(v, "metric"); found { if !decode_CastManaSpentMetric(fv, &out.metric) do return fail("QuantityRef::ManaSpentToCast.metric") } else { return fail("QuantityRef::ManaSpentToCast.metric missing") }
	return true
		}) { return fail("QuantityRef::ManaSpentToCast") }
		out^ = tmp
	case "ColorsInCommandersColorIdentity": out^ = QuantityRef_ColorsInCommandersColorIdentity{}
	case "CommanderCastFromCommandZoneCount": out^ = QuantityRef_CommanderCastFromCommandZoneCount{}
	case "CommanderManaValue":
		tmp: QuantityRef_CommanderManaValue
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityRef_CommanderManaValue) -> bool {
	if fv, found := get_any(v, "owner"); found { if !decode_ControllerRef(fv, &out.owner) do return fail("QuantityRef::CommanderManaValue.owner") } else { return fail("QuantityRef::CommanderManaValue.owner missing") }
	return true
		}) { return fail("QuantityRef::CommanderManaValue") }
		out^ = tmp
	case "DistinctColorsAmong", "DistinctColorsAmongPermanents":
		tmp: QuantityRef_DistinctColorsAmong
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityRef_DistinctColorsAmong) -> bool {
	if fv, found := get_any(v, "source", "filter"); found { if !decode_CardTypeSetSource(fv, &out.source) do return fail("QuantityRef::DistinctColorsAmong.source") } else { return fail("QuantityRef::DistinctColorsAmong.source missing") }
	return true
		}) { return fail("QuantityRef::DistinctColorsAmong") }
		out^ = tmp
	case "DistinctCounterKindsAmong":
		tmp: QuantityRef_DistinctCounterKindsAmong
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityRef_DistinctCounterKindsAmong) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("QuantityRef::DistinctCounterKindsAmong.filter") } else { return fail("QuantityRef::DistinctCounterKindsAmong.filter missing") }
	return true
		}) { return fail("QuantityRef::DistinctCounterKindsAmong") }
		out^ = tmp
	case "VoteCount":
		tmp: QuantityRef_VoteCount
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityRef_VoteCount) -> bool {
	if fv, found := get_any(v, "choice_index"); found { if !decode_u32(fv, &out.choice_index) do return fail("QuantityRef::VoteCount.choice_index") } else { return fail("QuantityRef::VoteCount.choice_index missing") }
	return true
		}) { return fail("QuantityRef::VoteCount") }
		out^ = tmp
	case: return fail("QuantityRef: unknown variant")
	}
	return true
}

encode_QuantityRef :: proc(b: ^strings.Builder, x: QuantityRef) {
	#partial switch y in x {
	case QuantityRef_HandSize: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HandSize")
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	}; strings.write_byte(b, '}')
	case QuantityRef_LifeTotal: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "LifeTotal")
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	}; strings.write_byte(b, '}')
	case QuantityRef_GraveyardSize: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GraveyardSize")
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	}; strings.write_byte(b, '}')
	case QuantityRef_LifeAboveStarting: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "LifeAboveStarting"); strings.write_byte(b, '}')
	case QuantityRef_StartingLifeTotal: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "StartingLifeTotal")
	if !(skip_QuantityRef_is_player_scope_controller(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }
	}; strings.write_byte(b, '}')
	case QuantityRef_StartingDeckSize: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "StartingDeckSize")
	if !(skip_QuantityRef_is_player_scope_controller(y.player)) { member(b, first, "player"); encode_PlayerScope(b, y.player) }
	}; strings.write_byte(b, '}')
	case QuantityRef_TriggeringDiscoverValue: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TriggeringDiscoverValue"); strings.write_byte(b, '}')
	case QuantityRef_TriggeringScryLookCount: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TriggeringScryLookCount"); strings.write_byte(b, '}')
	case QuantityRef_TriggeringScryBottomCount: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TriggeringScryBottomCount"); strings.write_byte(b, '}')
	case QuantityRef_ObjectCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ObjectCount")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case QuantityRef_ObjectCountDistinct: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ObjectCountDistinct")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "qualities"); enc_dyn_SharedQuality(b, y.qualities)
	}; strings.write_byte(b, '}')
	case QuantityRef_ObjectCountBySharedQuality: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ObjectCountBySharedQuality")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "quality"); encode_SharedQuality(b, y.quality)
	member(b, first, "aggregate"); encode_AggregateFunction(b, y.aggregate)
	}; strings.write_byte(b, '}')
	case QuantityRef_PlayerCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PlayerCount")
	member(b, first, "filter"); encode_PlayerFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case QuantityRef_CountersOn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CountersOn")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)
	if !(y.counter_type == nil) { member(b, first, "counter_type"); enc_opt_CounterType(b, y.counter_type) }
	}; strings.write_byte(b, '}')
	case QuantityRef_CountersOnObjects: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CountersOnObjects")
	if !(y.counter_type == nil) { member(b, first, "counter_type"); enc_opt_CounterType(b, y.counter_type) }
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case QuantityRef_PlayerCounter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PlayerCounter")
	member(b, first, "kind"); encode_PlayerCounterKind(b, y.kind)
	member(b, first, "scope"); encode_CountScope(b, y.scope)
	}; strings.write_byte(b, '}')
	case QuantityRef_TargetControllerCounter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TargetControllerCounter")
	member(b, first, "kind"); encode_PlayerCounterKind(b, y.kind)
	}; strings.write_byte(b, '}')
	case QuantityRef_Variable: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Variable")
	member(b, first, "name"); encode_string(b, y.name)
	}; strings.write_byte(b, '}')
	case QuantityRef_Power: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Power")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)
	}; strings.write_byte(b, '}')
	case QuantityRef_BasePower: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "BasePower")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)
	}; strings.write_byte(b, '}')
	case QuantityRef_Intensity: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Intensity")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)
	}; strings.write_byte(b, '}')
	case QuantityRef_Toughness: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Toughness")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)
	}; strings.write_byte(b, '}')
	case QuantityRef_ObjectManaValue: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ObjectManaValue")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)
	}; strings.write_byte(b, '}')
	case QuantityRef_TargetObjectManaValue: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TargetObjectManaValue")
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case QuantityRef_ObjectColorCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ObjectColorCount")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)
	}; strings.write_byte(b, '}')
	case QuantityRef_ObjectNameWordCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ObjectNameWordCount")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)
	}; strings.write_byte(b, '}')
	case QuantityRef_NameStickerLetterCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "NameStickerLetterCount")
	member(b, first, "stickers"); encode_NameStickerSet(b, y.stickers)
	member(b, first, "letters"); encode_LetterQuery(b, y.letters)
	}; strings.write_byte(b, '}')
	case QuantityRef_ObjectTypelineComponentCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ObjectTypelineComponentCount")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)
	}; strings.write_byte(b, '}')
	case QuantityRef_ManaSymbolsInManaCost: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ManaSymbolsInManaCost")
	member(b, first, "scope"); encode_ObjectScope(b, y.scope)
	member(b, first, "color"); enc_opt_ManaColor(b, y.color)
	}; strings.write_byte(b, '}')
	case QuantityRef_SelfManaValue: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SelfManaValue"); strings.write_byte(b, '}')
	case QuantityRef_PropertyAggregate: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PropertyAggregate"); encode_PropertyAggregate_members(b, y._0, &f); strings.write_byte(b, '}')
	case QuantityRef_ControlledByEachPlayer: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControlledByEachPlayer")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "aggregate"); encode_AggregateFunction(b, y.aggregate)
	if !(skip_QuantityRef_is_player_relation_all(y.relation)) { member(b, first, "relation"); encode_PlayerRelation(b, y.relation) }
	}; strings.write_byte(b, '}')
	case QuantityRef_TargetZoneCardCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TargetZoneCardCount")
	member(b, first, "zone"); encode_ZoneRef(b, y.zone)
	if !(skip_QuantityRef_is_target_zone_count_scope_default(y.scope)) { member(b, first, "scope"); encode_ControllerRef(b, y.scope) }
	if !(skip_QuantityRef_is_count_binding_default(y.binding)) { member(b, first, "binding"); encode_CountBinding(b, y.binding) }
	}; strings.write_byte(b, '}')
	case QuantityRef_Devotion: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Devotion")
	member(b, first, "colors"); encode_DevotionColors(b, y.colors)
	}; strings.write_byte(b, '}')
	case QuantityRef_DistinctCardTypes: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DistinctCardTypes")
	member(b, first, "source"); encode_CardTypeSetSource(b, y.source)
	}; strings.write_byte(b, '}')
	case QuantityRef_SharedCardTypes: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SharedCardTypes")
	member(b, first, "source"); encode_CardTypeSetSource(b, y.source)
	}; strings.write_byte(b, '}')
	case QuantityRef_DistinctSubtypes: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DistinctSubtypes")
	member(b, first, "source"); encode_CardTypeSetSource(b, y.source)
	member(b, first, "exclude"); encode_SubtypeExclusion(b, y.exclude)
	if !(y.restrict == nil) { member(b, first, "restrict"); enc_opt_SubtypeSet(b, y.restrict) }
	}; strings.write_byte(b, '}')
	case QuantityRef_CardsExiledBySource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CardsExiledBySource"); strings.write_byte(b, '}')
	case QuantityRef_DeployedBossCount: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DeployedBossCount"); strings.write_byte(b, '}')
	case QuantityRef_ExiledCardPower: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ExiledCardPower")
	member(b, first, "index"); encode_u32(b, y.index)
	}; strings.write_byte(b, '}')
	case QuantityRef_ZoneCardCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ZoneCardCount")
	member(b, first, "zone"); encode_ZoneRef(b, y.zone)
	member(b, first, "card_types"); enc_dyn_TypeFilter(b, y.card_types)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }
	member(b, first, "scope"); encode_CountScope(b, y.scope)
	}; strings.write_byte(b, '}')
	case QuantityRef_BasicLandTypeCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "BasicLandTypeCount")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)
	}; strings.write_byte(b, '}')
	case QuantityRef_TrackedSetSize: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TrackedSetSize"); strings.write_byte(b, '}')
	case QuantityRef_FilteredTrackedSetSize: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "FilteredTrackedSetSize")
	member(b, first, "filter"); enc_ptr_TargetFilter(b, y.filter)
	if !(y.caused_by == nil) { member(b, first, "caused_by"); enc_opt_ThisWayCause(b, y.caused_by) }
	if !(y.destination == nil) { member(b, first, "destination"); enc_opt_Zone(b, y.destination) }
	}; strings.write_byte(b, '}')
	case QuantityRef_ExiledFromHandThisResolution: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ExiledFromHandThisResolution"); strings.write_byte(b, '}')
	case QuantityRef_PreviousEffectAmount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PreviousEffectAmount")
	if !(skip_QuantityRef_is_total_damage_channel(y.channel)) { member(b, first, "channel"); encode_DamageChannel(b, y.channel) }
	if !(skip_QuantityRef_is_sum_aggregate(y.aggregate)) { member(b, first, "aggregate"); encode_AggregateFunction(b, y.aggregate) }
	}; strings.write_byte(b, '}')
	case QuantityRef_PreviousEffectCount: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PreviousEffectCount"); strings.write_byte(b, '}')
	case QuantityRef_LifeLost: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "LifeLost")
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	if !(skip_QuantityRef_TurnWindow_is_this_turn(y.window)) { member(b, first, "window"); encode_TurnWindow(b, y.window) }
	}; strings.write_byte(b, '}')
	case QuantityRef_PartySize: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PartySize")
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	}; strings.write_byte(b, '}')
	case QuantityRef_UnspentMana: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UnspentMana")
	member(b, first, "color"); enc_opt_ManaColor(b, y.color)
	}; strings.write_byte(b, '}')
	case QuantityRef_Speed: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Speed")
	member(b, first, "player"); encode_PlayerScope(b, y.player)
	}; strings.write_byte(b, '}')
	case QuantityRef_EventContextAmount: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EventContextAmount"); strings.write_byte(b, '}')
	case QuantityRef_EventContextPlayerCount: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "EventContextPlayerCount")
