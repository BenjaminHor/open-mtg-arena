	switch variant {
	case "OptionalEffectPerformed": when COVERAGE do cov_hit("EffectOutcomeSignal::OptionalEffectPerformed"); out^ = EffectOutcomeSignal_OptionalEffectPerformed{}
	case "CurrentScopeSucceeded": when COVERAGE do cov_hit("EffectOutcomeSignal::CurrentScopeSucceeded"); out^ = EffectOutcomeSignal_CurrentScopeSucceeded{}
	case "Guessed": when COVERAGE do cov_hit("EffectOutcomeSignal::Guessed");
		tmp: EffectOutcomeSignal_Guessed
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^EffectOutcomeSignal_Guessed) -> bool {
	if fv, found := get_any(v, "outcome"); found { if !decode_GuessOutcome(fv, &out.outcome) do return fail("EffectOutcomeSignal::Guessed.outcome") } else { return fail("EffectOutcomeSignal::Guessed.outcome missing") }
	return true
		}) { return fail("EffectOutcomeSignal::Guessed") }
		out^ = tmp
	case "RevealUntilMatched": when COVERAGE do cov_hit("EffectOutcomeSignal::RevealUntilMatched"); out^ = EffectOutcomeSignal_RevealUntilMatched{}
	case "RepeatDirectiveReached": when COVERAGE do cov_hit("EffectOutcomeSignal::RepeatDirectiveReached"); out^ = EffectOutcomeSignal_RepeatDirectiveReached{}
	case: return fail("EffectOutcomeSignal: unknown variant")
	}
	return true
}

encode_EffectOutcomeSignal :: proc(b: ^strings.Builder, x: EffectOutcomeSignal) {
	#partial switch y in x {
	case EffectOutcomeSignal_OptionalEffectPerformed: _ = y; json.write_string(b, "OptionalEffectPerformed")
