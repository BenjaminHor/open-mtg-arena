decode_EntryOwnershipActor :: proc(v: json.Value, out: ^EntryOwnershipActor) -> bool {
	when COVERAGE do cov_hit("EntryOwnershipActor")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("EntryOwnershipActor: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("EntryOwnershipActor: not a string or object")
	}
	switch variant {
	case "Unrecorded": when COVERAGE do cov_hit("EntryOwnershipActor::Unrecorded"); out^ = EntryOwnershipActor_Unrecorded{}
	case "NoPlayer": when COVERAGE do cov_hit("EntryOwnershipActor::NoPlayer"); out^ = EntryOwnershipActor_NoPlayer{}
	case "Player": when COVERAGE do cov_hit("EntryOwnershipActor::Player"); tmp: EntryOwnershipActor_Player; if !decode_PlayerId(body, &tmp._0) do return fail("EntryOwnershipActor::Player"); out^ = tmp
	case: return fail("EntryOwnershipActor: unknown variant")
	}
	return true
}

encode_EntryOwnershipActor :: proc(b: ^strings.Builder, x: EntryOwnershipActor) {
	#partial switch y in x {
	case EntryOwnershipActor_Unrecorded: _ = y; json.write_string(b, "Unrecorded")
	case EntryOwnershipActor_NoPlayer: _ = y; json.write_string(b, "NoPlayer")
	case EntryOwnershipActor_Player: strings.write_byte(b, '{'); json.write_string(b, "Player"); strings.write_byte(b, ':'); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	}
}

decode_DrawEventStage :: proc(v: json.Value, out: ^DrawEventStage) -> bool {
	when COVERAGE do cov_hit("DrawEventStage")
	if v.kind != .String do return fail("DrawEventStage: not a string")
	str := v.text
	switch str {
	case "Instruction": when COVERAGE do cov_hit("DrawEventStage::Instruction"); out^ = .Instruction
	case "Individual": when COVERAGE do cov_hit("DrawEventStage::Individual"); out^ = .Individual
	case: return fail("DrawEventStage: unknown variant")
	}
	return true
}

encode_DrawEventStage :: proc(b: ^strings.Builder, x: DrawEventStage) {
	@(static, rodata) NAMES := [DrawEventStage]string{
		.Instruction = "Instruction",
		.Individual = "Individual",
	}
	json.write_string(b, NAMES[x])
}

decode_SearchFoundDisposition :: proc(v: json.Value, out: ^SearchFoundDisposition) -> bool {
	when COVERAGE do cov_hit("SearchFoundDisposition")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("SearchFoundDisposition: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("SearchFoundDisposition: not a string or object")
	}
	switch variant {
	case "Original": when COVERAGE do cov_hit("SearchFoundDisposition::Original"); out^ = SearchFoundDisposition_Original{}
	case "Modified": when COVERAGE do cov_hit("SearchFoundDisposition::Modified"); tmp: SearchFoundDisposition_Modified; if !decode_BoundSearchFoundDisposition(body, &tmp._0) do return fail("SearchFoundDisposition::Modified"); out^ = tmp
	case: return fail("SearchFoundDisposition: unknown variant")
	}
	return true
}

encode_SearchFoundDisposition :: proc(b: ^strings.Builder, x: SearchFoundDisposition) {
	#partial switch y in x {
	case SearchFoundDisposition_Original: _ = y; json.write_string(b, "Original")
	case SearchFoundDisposition_Modified: strings.write_byte(b, '{'); json.write_string(b, "Modified"); strings.write_byte(b, ':'); encode_BoundSearchFoundDisposition(b, y._0); strings.write_byte(b, '}')
	}
}

decode_DieRollIgnoreRule :: proc(v: json.Value, out: ^DieRollIgnoreRule) -> bool {
	when COVERAGE do cov_hit("DieRollIgnoreRule")
	if v.kind != .Object do return fail("DieRollIgnoreRule: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("DieRollIgnoreRule: no tag")
	str := tv.text
	switch str {
	case "Lowest": when COVERAGE do cov_hit("DieRollIgnoreRule::Lowest"); out^ = .Lowest
	case: return fail("DieRollIgnoreRule: unknown variant")
	}
	return true
}

encode_DieRollIgnoreRule :: proc(b: ^strings.Builder, x: DieRollIgnoreRule) {
	strings.write_byte(b, '{')
	f := true
	encode_DieRollIgnoreRule_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_DieRollIgnoreRule_members :: proc(b: ^strings.Builder, x: DieRollIgnoreRule, first: ^bool) {
	_ = x
	@(static, rodata) NAMES := [DieRollIgnoreRule]string{
		.Lowest = "Lowest",
	}
	member(b, first, "type"); json.write_string(b, NAMES[x])
}

decode_CounterPlacement :: proc(v: json.Value, out: ^CounterPlacement) -> bool {
	when COVERAGE do cov_hit("CounterPlacement")
	// untagged: the first variant that decodes wins, as in serde.
	if v.kind == .Object { tmp: CounterPlacement_Object; if decode_quiet_proc(v, &tmp, proc(v: json.Value, out: ^CounterPlacement_Object) -> bool {
	if fv, found := get_any(v, "actor"); found { if !decode_PlayerId(fv, &out.actor) do return fail("CounterPlacement::Object.actor") }
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("CounterPlacement::Object.object_id") } else { return fail("CounterPlacement::Object.object_id missing") }
	if fv, found := get_any(v, "counter_type"); found { if !decode_CounterType(fv, &out.counter_type) do return fail("CounterPlacement::Object.counter_type") } else { return fail("CounterPlacement::Object.counter_type missing") }
	if fv, found := get_any(v, "cause"); found { if !decode_CounterCause(fv, &out.cause) do return fail("CounterPlacement::Object.cause") } else { out.cause = CounterCause.Other }
	return true
	}) { out^ = tmp; return true } }
	if v.kind == .Object { tmp: CounterPlacement_Player; if decode_quiet_proc(v, &tmp, proc(v: json.Value, out: ^CounterPlacement_Player) -> bool {
	if fv, found := get_any(v, "actor"); found { if !decode_PlayerId(fv, &out.actor) do return fail("CounterPlacement::Player.actor") } else { return fail("CounterPlacement::Player.actor missing") }
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("CounterPlacement::Player.player_id") } else { return fail("CounterPlacement::Player.player_id missing") }
	if fv, found := get_any(v, "counter_kind"); found { if !decode_PlayerCounterKind(fv, &out.counter_kind) do return fail("CounterPlacement::Player.counter_kind") } else { return fail("CounterPlacement::Player.counter_kind missing") }
	if fv, found := get_any(v, "cause"); found { if !decode_CounterCause(fv, &out.cause) do return fail("CounterPlacement::Player.cause") } else { out.cause = CounterCause.Other }
	return true
	}) { out^ = tmp; return true } }
	if v.kind == .Object { tmp: CounterPlacement_Energy; if decode_quiet_proc(v, &tmp, proc(v: json.Value, out: ^CounterPlacement_Energy) -> bool {
	if fv, found := get_any(v, "actor"); found { if !decode_PlayerId(fv, &out.actor) do return fail("CounterPlacement::Energy.actor") } else { return fail("CounterPlacement::Energy.actor missing") }
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("CounterPlacement::Energy.player_id") } else { return fail("CounterPlacement::Energy.player_id missing") }
	if fv, found := get_any(v, "cause"); found { if !decode_CounterCause(fv, &out.cause) do return fail("CounterPlacement::Energy.cause") } else { out.cause = CounterCause.Other }
	return true
	}) { out^ = tmp; return true } }
	return fail("CounterPlacement: no untagged variant matched")
}

encode_CounterPlacement :: proc(b: ^strings.Builder, x: CounterPlacement) {
	#partial switch y in x {
	case CounterPlacement_Object: strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "actor"); encode_PlayerId(b, y.actor)
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	member(b, first, "cause"); encode_CounterCause(b, y.cause)
	}; strings.write_byte(b, '}')
	case CounterPlacement_Player: strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "actor"); encode_PlayerId(b, y.actor)
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "counter_kind"); encode_PlayerCounterKind(b, y.counter_kind)
	member(b, first, "cause"); encode_CounterCause(b, y.cause)
	}; strings.write_byte(b, '}')
	case CounterPlacement_Energy: strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "actor"); encode_PlayerId(b, y.actor)
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "cause"); encode_CounterCause(b, y.cause)
	}; strings.write_byte(b, '}')
	}
}

encode_CounterPlacement_members :: proc(b: ^strings.Builder, x: CounterPlacement, first: ^bool) {
	#partial switch y in x {
	case CounterPlacement_Object:
	member(b, first, "actor"); encode_PlayerId(b, y.actor)
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	member(b, first, "counter_type"); encode_CounterType(b, y.counter_type)
	member(b, first, "cause"); encode_CounterCause(b, y.cause)

	case CounterPlacement_Player:
	member(b, first, "actor"); encode_PlayerId(b, y.actor)
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "counter_kind"); encode_PlayerCounterKind(b, y.counter_kind)
	member(b, first, "cause"); encode_CounterCause(b, y.cause)

	case CounterPlacement_Energy:
	member(b, first, "actor"); encode_PlayerId(b, y.actor)
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "cause"); encode_CounterCause(b, y.cause)

	}
}

