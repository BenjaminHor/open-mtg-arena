	if fv, found := get_any(v, "card"); found { if !decode_DungeonCardView(fv, &out.card) do return fail("DungeonPreview.card") } else { return fail("DungeonPreview.card missing") }
	if fv, found := get_any(v, "rooms"); found { if !dec_dyn_DungeonRoomNodeView(fv, &out.rooms) do return fail("DungeonPreview.rooms") } else { return fail("DungeonPreview.rooms missing") }
	if fv, found := get_any(v, "room_count"); found { if !decode_u8(fv, &out.room_count) do return fail("DungeonPreview.room_count") } else { return fail("DungeonPreview.room_count missing") }
	return true
}

