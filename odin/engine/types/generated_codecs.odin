decode_PendingTrigger :: proc(v: json.Value, out: ^PendingTrigger) -> bool {
	when COVERAGE do cov_hit("PendingTrigger")
	if v.kind != .Object do return fail("PendingTrigger: not an object")
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("PendingTrigger.source_id") } else { return fail("PendingTrigger.source_id missing") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("PendingTrigger.controller") } else { return fail("PendingTrigger.controller missing") }
	if fv, found := get_any(v, "condition"); found { if !dec_opt_TriggerCondition(fv, &out.condition) do return fail("PendingTrigger.condition") }
	if fv, found := get_any(v, "ability"); found { if !dec_ptr_ResolvedAbility(fv, &out.ability) do return fail("PendingTrigger.ability") } else { return fail("PendingTrigger.ability missing") }
	if fv, found := get_any(v, "timestamp"); found { if !decode_u32(fv, &out.timestamp) do return fail("PendingTrigger.timestamp") } else { return fail("PendingTrigger.timestamp missing") }
	if fv, found := get_any(v, "target_constraints"); found { if !dec_dyn_TargetSelectionConstraint(fv, &out.target_constraints) do return fail("PendingTrigger.target_constraints") }
	if fv, found := get_any(v, "distribute"); found { if !dec_opt_DistributionUnit(fv, &out.distribute) do return fail("PendingTrigger.distribute") }
	if fv, found := get_any(v, "trigger_event"); found { if !dec_opt_GameEvent(fv, &out.trigger_event) do return fail("PendingTrigger.trigger_event") }
	if fv, found := get_any(v, "modal"); found { if !dec_opt_ModalChoice(fv, &out.modal) do return fail("PendingTrigger.modal") }
	if fv, found := get_any(v, "mode_abilities"); found { if !dec_dyn_AbilityDefinition(fv, &out.mode_abilities) do return fail("PendingTrigger.mode_abilities") }
	if fv, found := get_any(v, "description"); found { if !dec_opt_string(fv, &out.description) do return fail("PendingTrigger.description") }
	if fv, found := get_any(v, "may_trigger_origin"); found { if !dec_opt_MayTriggerOrigin(fv, &out.may_trigger_origin) do return fail("PendingTrigger.may_trigger_origin") }
	if fv, found := get_any(v, "subject_match_count"); found { if !dec_opt_u32(fv, &out.subject_match_count) do return fail("PendingTrigger.subject_match_count") }
	if fv, found := get_any(v, "die_result"); found { if !dec_opt_i32(fv, &out.die_result) do return fail("PendingTrigger.die_result") }
	if fv, found := get_any(v, "provenance"); found { if !dec_opt_SyntheticTriggerProvenance(fv, &out.provenance) do return fail("PendingTrigger.provenance") }
	return true
}

encode_PendingTrigger :: proc(b: ^strings.Builder, x: PendingTrigger) {
	strings.write_byte(b, '{')
	f := true
	encode_PendingTrigger_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PendingTrigger_members :: proc(b: ^strings.Builder, x: PendingTrigger, first: ^bool) {
	member(b, first, "source_id"); encode_ObjectId(b, x.source_id)
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	member(b, first, "condition"); enc_opt_TriggerCondition(b, x.condition)
	member(b, first, "ability"); enc_ptr_ResolvedAbility(b, x.ability)
	member(b, first, "timestamp"); encode_u32(b, x.timestamp)
	if !((len(x.target_constraints) == 0)) { member(b, first, "target_constraints"); enc_dyn_TargetSelectionConstraint(b, x.target_constraints) }
	if !(x.distribute == nil) { member(b, first, "distribute"); enc_opt_DistributionUnit(b, x.distribute) }
	if !(x.trigger_event == nil) { member(b, first, "trigger_event"); enc_opt_GameEvent(b, x.trigger_event) }
	if !(x.modal == nil) { member(b, first, "modal"); enc_opt_ModalChoice(b, x.modal) }
	if !((len(x.mode_abilities) == 0)) { member(b, first, "mode_abilities"); enc_dyn_AbilityDefinition(b, x.mode_abilities) }
	if !(x.description == nil) { member(b, first, "description"); enc_opt_string(b, x.description) }
	if !(x.may_trigger_origin == nil) { member(b, first, "may_trigger_origin"); enc_opt_MayTriggerOrigin(b, x.may_trigger_origin) }
	if !(x.subject_match_count == nil) { member(b, first, "subject_match_count"); enc_opt_u32(b, x.subject_match_count) }
	if !(x.die_result == nil) { member(b, first, "die_result"); enc_opt_i32(b, x.die_result) }
	if !(x.provenance == nil) { member(b, first, "provenance"); enc_opt_SyntheticTriggerProvenance(b, x.provenance) }
}

decode_TriggerFiring :: proc(v: json.Value, out: ^TriggerFiring) -> bool {
	when COVERAGE do cov_hit("TriggerFiring")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("TriggerFiring: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("TriggerFiring: not a string or object")
	}
	switch variant {
	case "Ordinary": when COVERAGE do cov_hit("TriggerFiring::Ordinary"); out^ = TriggerFiring_Ordinary{}
	case "LegacyDelayed": when COVERAGE do cov_hit("TriggerFiring::LegacyDelayed"); out^ = TriggerFiring_LegacyDelayed{}
	case "ReceiptEligible": when COVERAGE do cov_hit("TriggerFiring::ReceiptEligible"); tmp: TriggerFiring_ReceiptEligible; if !decode_DelayedTriggerOrigin(body, &tmp._0) do return fail("TriggerFiring::ReceiptEligible"); out^ = tmp
	case "UnknownLegacy": when COVERAGE do cov_hit("TriggerFiring::UnknownLegacy"); out^ = TriggerFiring_UnknownLegacy{}
	case: return fail("TriggerFiring: unknown variant")
	}
	return true
}

encode_TriggerFiring :: proc(b: ^strings.Builder, x: TriggerFiring) {
	#partial switch y in x {
	case TriggerFiring_Ordinary: _ = y; json.write_string(b, "Ordinary")
	case TriggerFiring_LegacyDelayed: _ = y; json.write_string(b, "LegacyDelayed")
	case TriggerFiring_ReceiptEligible: strings.write_byte(b, '{'); json.write_string(b, "ReceiptEligible"); strings.write_byte(b, ':'); encode_DelayedTriggerOrigin(b, y._0); strings.write_byte(b, '}')
	case TriggerFiring_UnknownLegacy: _ = y; json.write_string(b, "UnknownLegacy")
	}
}

decode_PendingTriggerContext :: proc(v: json.Value, out: ^PendingTriggerContext) -> bool {
	when COVERAGE do cov_hit("PendingTriggerContext")
	if v.kind != .Object do return fail("PendingTriggerContext: not an object")
	if fv, found := get_any(v, "pending"); found { if !decode_PendingTrigger(fv, &out.pending) do return fail("PendingTriggerContext.pending") } else { return fail("PendingTriggerContext.pending missing") }
	if fv, found := get_any(v, "trigger_events"); found { if !dec_dyn_GameEvent(fv, &out.trigger_events) do return fail("PendingTriggerContext.trigger_events") }
	if fv, found := get_any(v, "duration_events"); found { if !dec_dyn_DurationEvent(fv, &out.duration_events) do return fail("PendingTriggerContext.duration_events") }
	if fv, found := get_any(v, "dispatch_origin"); found { if !decode_PendingTriggerDispatchOrigin(fv, &out.dispatch_origin) do return fail("PendingTriggerContext.dispatch_origin") }
	if fv, found := get_any(v, "batch_origin"); found { if !decode_DeferredTriggerBatchOrigin(fv, &out.batch_origin) do return fail("PendingTriggerContext.batch_origin") }
	if fv, found := get_any(v, "firing"); found { if !decode_TriggerFiring(fv, &out.firing) do return fail("PendingTriggerContext.firing") } else { out.firing = TriggerFiring(TriggerFiring_UnknownLegacy{}) }
	if fv, found := get_any(v, "causes"); found { if !dec_dyn_GameEvent(fv, &out.causes) do return fail("PendingTriggerContext.causes") }
	return true
}

encode_PendingTriggerContext :: proc(b: ^strings.Builder, x: PendingTriggerContext) {
	strings.write_byte(b, '{')
	f := true
	encode_PendingTriggerContext_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PendingTriggerContext_members :: proc(b: ^strings.Builder, x: PendingTriggerContext, first: ^bool) {
	member(b, first, "pending"); encode_PendingTrigger(b, x.pending)
	if !((len(x.trigger_events) == 0)) { member(b, first, "trigger_events"); enc_dyn_GameEvent(b, x.trigger_events) }
	if !((len(x.duration_events) == 0)) { member(b, first, "duration_events"); enc_dyn_DurationEvent(b, x.duration_events) }
