	case "NonMana": when COVERAGE do cov_hit("FlashbackCost::NonMana"); tmp: FlashbackCost_NonMana; if !decode_AbilityCost(json.get_or_null(v, "data"), &tmp._0) do return fail("FlashbackCost::NonMana"); out^ = tmp
