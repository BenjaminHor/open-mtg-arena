	when COVERAGE do cov_hit("ChosenCounterCountCondition")
	if v.kind != .Object do return fail("ChosenCounterCountCondition: not an object")
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("ChosenCounterCountCondition.comparator") } else { return fail("ChosenCounterCountCondition.comparator missing") }
	if fv, found := get_any(v, "rhs"); found { if !decode_QuantityExpr(fv, &out.rhs) do return fail("ChosenCounterCountCondition.rhs") } else { return fail("ChosenCounterCountCondition.rhs missing") }
	return true
}

