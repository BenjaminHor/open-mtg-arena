decode_DelayedTriggerCondition :: proc(v: json.Value, out: ^DelayedTriggerCondition) -> bool {
	if v.kind != .Object do return fail("DelayedTriggerCondition: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("DelayedTriggerCondition: no tag")
	switch tv.text {
	case "AtNextPhase":
		tmp: DelayedTriggerCondition_AtNextPhase
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DelayedTriggerCondition_AtNextPhase) -> bool {
	if fv, found := get_any(v, "phase"); found { if !decode_Phase(fv, &out.phase) do return fail("DelayedTriggerCondition::AtNextPhase.phase") } else { return fail("DelayedTriggerCondition::AtNextPhase.phase missing") }
	return true
		}) { return fail("DelayedTriggerCondition::AtNextPhase") }
		out^ = tmp
	case "AtNextPhaseForPlayer":
		tmp: DelayedTriggerCondition_AtNextPhaseForPlayer
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DelayedTriggerCondition_AtNextPhaseForPlayer) -> bool {
	if fv, found := get_any(v, "phase"); found { if !decode_Phase(fv, &out.phase) do return fail("DelayedTriggerCondition::AtNextPhaseForPlayer.phase") } else { return fail("DelayedTriggerCondition::AtNextPhaseForPlayer.phase missing") }
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("DelayedTriggerCondition::AtNextPhaseForPlayer.player") } else { return fail("DelayedTriggerCondition::AtNextPhaseForPlayer.player missing") }
	if fv, found := get_any(v, "gate"); found { if !decode_TurnGate(fv, &out.gate) do return fail("DelayedTriggerCondition::AtNextPhaseForPlayer.gate") } else { out.gate = TurnGate(TurnGate_None{}) }
	if fv, found := get_any(v, "binding"); found { if !decode_DelayedTriggerPlayerBinding(fv, &out.binding) do return fail("DelayedTriggerCondition::AtNextPhaseForPlayer.binding") } else { out.binding = DelayedTriggerPlayerBinding(DelayedTriggerPlayerBinding_Controller{}) }
	return true
		}) { return fail("DelayedTriggerCondition::AtNextPhaseForPlayer") }
		out^ = tmp
	case "AtBeginningOfAddedPhase":
		tmp: DelayedTriggerCondition_AtBeginningOfAddedPhase
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DelayedTriggerCondition_AtBeginningOfAddedPhase) -> bool {
	if fv, found := get_any(v, "phase"); found { if !decode_Phase(fv, &out.phase) do return fail("DelayedTriggerCondition::AtBeginningOfAddedPhase.phase") } else { return fail("DelayedTriggerCondition::AtBeginningOfAddedPhase.phase missing") }
	if fv, found := get_any(v, "entry"); found { if !dec_opt_ExtraPhaseId(fv, &out.entry) do return fail("DelayedTriggerCondition::AtBeginningOfAddedPhase.entry") }
	return true
		}) { return fail("DelayedTriggerCondition::AtBeginningOfAddedPhase") }
		out^ = tmp
	case "AtBeginningOfGrantedTurn":
		tmp: DelayedTriggerCondition_AtBeginningOfGrantedTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DelayedTriggerCondition_AtBeginningOfGrantedTurn) -> bool {
	if fv, found := get_any(v, "phase"); found { if !decode_Phase(fv, &out.phase) do return fail("DelayedTriggerCondition::AtBeginningOfGrantedTurn.phase") } else { return fail("DelayedTriggerCondition::AtBeginningOfGrantedTurn.phase missing") }
	if fv, found := get_any(v, "turn"); found { if !dec_opt_ExtraTurnId(fv, &out.turn) do return fail("DelayedTriggerCondition::AtBeginningOfGrantedTurn.turn") }
	return true
		}) { return fail("DelayedTriggerCondition::AtBeginningOfGrantedTurn") }
		out^ = tmp
	case "WhenLeavesPlay":
		tmp: DelayedTriggerCondition_WhenLeavesPlay
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DelayedTriggerCondition_WhenLeavesPlay) -> bool {
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("DelayedTriggerCondition::WhenLeavesPlay.object_id") } else { return fail("DelayedTriggerCondition::WhenLeavesPlay.object_id missing") }
	return true
		}) { return fail("DelayedTriggerCondition::WhenLeavesPlay") }
		out^ = tmp
	case "WhenDies":
		tmp: DelayedTriggerCondition_WhenDies
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DelayedTriggerCondition_WhenDies) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("DelayedTriggerCondition::WhenDies.filter") } else { return fail("DelayedTriggerCondition::WhenDies.filter missing") }
	return true
		}) { return fail("DelayedTriggerCondition::WhenDies") }
		out^ = tmp
	case "WhenLeavesPlayFiltered":
		tmp: DelayedTriggerCondition_WhenLeavesPlayFiltered
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DelayedTriggerCondition_WhenLeavesPlayFiltered) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("DelayedTriggerCondition::WhenLeavesPlayFiltered.filter") } else { return fail("DelayedTriggerCondition::WhenLeavesPlayFiltered.filter missing") }
	return true
		}) { return fail("DelayedTriggerCondition::WhenLeavesPlayFiltered") }
		out^ = tmp
	case "WhenEntersBattlefield":
		tmp: DelayedTriggerCondition_WhenEntersBattlefield
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DelayedTriggerCondition_WhenEntersBattlefield) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("DelayedTriggerCondition::WhenEntersBattlefield.filter") } else { return fail("DelayedTriggerCondition::WhenEntersBattlefield.filter missing") }
	return true
		}) { return fail("DelayedTriggerCondition::WhenEntersBattlefield") }
		out^ = tmp
	case "WhenDiesOrExiled":
		tmp: DelayedTriggerCondition_WhenDiesOrExiled
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DelayedTriggerCondition_WhenDiesOrExiled) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("DelayedTriggerCondition::WhenDiesOrExiled.filter") } else { return fail("DelayedTriggerCondition::WhenDiesOrExiled.filter missing") }
	return true
		}) { return fail("DelayedTriggerCondition::WhenDiesOrExiled") }
		out^ = tmp
	case "WheneverEvent":
		tmp: DelayedTriggerCondition_WheneverEvent
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DelayedTriggerCondition_WheneverEvent) -> bool {
	if fv, found := get_any(v, "trigger"); found { if !dec_ptr_TriggerDefinition(fv, &out.trigger) do return fail("DelayedTriggerCondition::WheneverEvent.trigger") } else { return fail("DelayedTriggerCondition::WheneverEvent.trigger missing") }
	if fv, found := get_any(v, "expiry"); found { if !decode_WheneverEventExpiry(fv, &out.expiry) do return fail("DelayedTriggerCondition::WheneverEvent.expiry") } else { out.expiry = WheneverEventExpiry(WheneverEventExpiry_EndOfTurn{}) }
	return true
		}) { return fail("DelayedTriggerCondition::WheneverEvent") }
		out^ = tmp
	case "WhenNextEvent":
		tmp: DelayedTriggerCondition_WhenNextEvent
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^DelayedTriggerCondition_WhenNextEvent) -> bool {
	if fv, found := get_any(v, "trigger"); found { if !dec_ptr_TriggerDefinition(fv, &out.trigger) do return fail("DelayedTriggerCondition::WhenNextEvent.trigger") } else { return fail("DelayedTriggerCondition::WhenNextEvent.trigger missing") }
	if fv, found := get_any(v, "or_trigger"); found { if !dec_ptr_TriggerDefinition(fv, &out.or_trigger) do return fail("DelayedTriggerCondition::WhenNextEvent.or_trigger") }
	if fv, found := get_any(v, "lifetime"); found { if !decode_DelayedTriggerLifetime(fv, &out.lifetime) do return fail("DelayedTriggerCondition::WhenNextEvent.lifetime") }
	return true
		}) { return fail("DelayedTriggerCondition::WhenNextEvent") }
		out^ = tmp
	case: return fail("DelayedTriggerCondition: unknown variant")
	}
	return true
}

encode_DelayedTriggerCondition :: proc(b: ^strings.Builder, x: DelayedTriggerCondition) {
	#partial switch y in x {
	case DelayedTriggerCondition_AtNextPhase: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AtNextPhase")
	member(b, first, "phase"); encode_Phase(b, y.phase)
	}; strings.write_byte(b, '}')
	case DelayedTriggerCondition_AtNextPhaseForPlayer: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AtNextPhaseForPlayer")
	member(b, first, "phase"); encode_Phase(b, y.phase)
	member(b, first, "player"); encode_PlayerId(b, y.player)
	if !(skip_DelayedTriggerCondition_TurnGate_is_none(y.gate)) { member(b, first, "gate"); encode_TurnGate(b, y.gate) }
	if !(skip_DelayedTriggerCondition_DelayedTriggerPlayerBinding_is_controller(y.binding)) { member(b, first, "binding"); encode_DelayedTriggerPlayerBinding(b, y.binding) }
	}; strings.write_byte(b, '}')
	case DelayedTriggerCondition_AtBeginningOfAddedPhase: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AtBeginningOfAddedPhase")
	member(b, first, "phase"); encode_Phase(b, y.phase)
	if !(y.entry == nil) { member(b, first, "entry"); enc_opt_ExtraPhaseId(b, y.entry) }
	}; strings.write_byte(b, '}')
	case DelayedTriggerCondition_AtBeginningOfGrantedTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AtBeginningOfGrantedTurn")
	member(b, first, "phase"); encode_Phase(b, y.phase)
	if !(y.turn == nil) { member(b, first, "turn"); enc_opt_ExtraTurnId(b, y.turn) }
	}; strings.write_byte(b, '}')
	case DelayedTriggerCondition_WhenLeavesPlay: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WhenLeavesPlay")
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	}; strings.write_byte(b, '}')
	case DelayedTriggerCondition_WhenDies: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WhenDies")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case DelayedTriggerCondition_WhenLeavesPlayFiltered: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WhenLeavesPlayFiltered")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case DelayedTriggerCondition_WhenEntersBattlefield: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WhenEntersBattlefield")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case DelayedTriggerCondition_WhenDiesOrExiled: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WhenDiesOrExiled")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case DelayedTriggerCondition_WheneverEvent: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WheneverEvent")
	member(b, first, "trigger"); enc_ptr_TriggerDefinition(b, y.trigger)
	if !(skip_DelayedTriggerCondition_WheneverEventExpiry_is_end_of_turn(y.expiry)) { member(b, first, "expiry"); encode_WheneverEventExpiry(b, y.expiry) }
	}; strings.write_byte(b, '}')
	case DelayedTriggerCondition_WhenNextEvent: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WhenNextEvent")
	member(b, first, "trigger"); enc_ptr_TriggerDefinition(b, y.trigger)
	member(b, first, "or_trigger"); enc_ptr_TriggerDefinition(b, y.or_trigger)
	if !(skip_DelayedTriggerCondition_DelayedTriggerLifetime_is_this_turn(y.lifetime)) { member(b, first, "lifetime"); encode_DelayedTriggerLifetime(b, y.lifetime) }
	}; strings.write_byte(b, '}')
	}
}

encode_DelayedTriggerCondition_members :: proc(b: ^strings.Builder, x: DelayedTriggerCondition, first: ^bool) {
	#partial switch y in x {
	case DelayedTriggerCondition_AtNextPhase: member(b, first, "type"); json.write_string(b, "AtNextPhase")
	member(b, first, "phase"); encode_Phase(b, y.phase)

	case DelayedTriggerCondition_AtNextPhaseForPlayer: member(b, first, "type"); json.write_string(b, "AtNextPhaseForPlayer")
	member(b, first, "phase"); encode_Phase(b, y.phase)
	member(b, first, "player"); encode_PlayerId(b, y.player)
	if !(skip_DelayedTriggerCondition_TurnGate_is_none(y.gate)) { member(b, first, "gate"); encode_TurnGate(b, y.gate) }
	if !(skip_DelayedTriggerCondition_DelayedTriggerPlayerBinding_is_controller(y.binding)) { member(b, first, "binding"); encode_DelayedTriggerPlayerBinding(b, y.binding) }

	case DelayedTriggerCondition_AtBeginningOfAddedPhase: member(b, first, "type"); json.write_string(b, "AtBeginningOfAddedPhase")
	member(b, first, "phase"); encode_Phase(b, y.phase)
	if !(y.entry == nil) { member(b, first, "entry"); enc_opt_ExtraPhaseId(b, y.entry) }

	case DelayedTriggerCondition_AtBeginningOfGrantedTurn: member(b, first, "type"); json.write_string(b, "AtBeginningOfGrantedTurn")
	member(b, first, "phase"); encode_Phase(b, y.phase)
	if !(y.turn == nil) { member(b, first, "turn"); enc_opt_ExtraTurnId(b, y.turn) }

	case DelayedTriggerCondition_WhenLeavesPlay: member(b, first, "type"); json.write_string(b, "WhenLeavesPlay")
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)

	case DelayedTriggerCondition_WhenDies: member(b, first, "type"); json.write_string(b, "WhenDies")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case DelayedTriggerCondition_WhenLeavesPlayFiltered: member(b, first, "type"); json.write_string(b, "WhenLeavesPlayFiltered")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case DelayedTriggerCondition_WhenEntersBattlefield: member(b, first, "type"); json.write_string(b, "WhenEntersBattlefield")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case DelayedTriggerCondition_WhenDiesOrExiled: member(b, first, "type"); json.write_string(b, "WhenDiesOrExiled")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case DelayedTriggerCondition_WheneverEvent: member(b, first, "type"); json.write_string(b, "WheneverEvent")
	member(b, first, "trigger"); enc_ptr_TriggerDefinition(b, y.trigger)
	if !(skip_DelayedTriggerCondition_WheneverEventExpiry_is_end_of_turn(y.expiry)) { member(b, first, "expiry"); encode_WheneverEventExpiry(b, y.expiry) }

	case DelayedTriggerCondition_WhenNextEvent: member(b, first, "type"); json.write_string(b, "WhenNextEvent")
	member(b, first, "trigger"); enc_ptr_TriggerDefinition(b, y.trigger)
	member(b, first, "or_trigger"); enc_ptr_TriggerDefinition(b, y.or_trigger)
	if !(skip_DelayedTriggerCondition_DelayedTriggerLifetime_is_this_turn(y.lifetime)) { member(b, first, "lifetime"); encode_DelayedTriggerLifetime(b, y.lifetime) }

	}
}

decode_GameRestriction :: proc(v: json.Value, out: ^GameRestriction) -> bool {
	if v.kind != .Object do return fail("GameRestriction: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("GameRestriction: no tag")
	switch tv.text {
	case "DamagePreventionDisabled":
		tmp: GameRestriction_DamagePreventionDisabled
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^GameRestriction_DamagePreventionDisabled) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("GameRestriction::DamagePreventionDisabled.source") } else { return fail("GameRestriction::DamagePreventionDisabled.source missing") }
	if fv, found := get_any(v, "expiry"); found { if !decode_RestrictionExpiry(fv, &out.expiry) do return fail("GameRestriction::DamagePreventionDisabled.expiry") } else { return fail("GameRestriction::DamagePreventionDisabled.expiry missing") }
	if fv, found := get_any(v, "scope"); found { if !dec_opt_RestrictionScope(fv, &out.scope) do return fail("GameRestriction::DamagePreventionDisabled.scope") }
	return true
		}) { return fail("GameRestriction::DamagePreventionDisabled") }
		out^ = tmp
	case "ProhibitActivity":
		tmp: GameRestriction_ProhibitActivity
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^GameRestriction_ProhibitActivity) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("GameRestriction::ProhibitActivity.source") } else { return fail("GameRestriction::ProhibitActivity.source missing") }
	if fv, found := get_any(v, "affected_players"); found { if !decode_RestrictionPlayerScope(fv, &out.affected_players) do return fail("GameRestriction::ProhibitActivity.affected_players") } else { return fail("GameRestriction::ProhibitActivity.affected_players missing") }
	if fv, found := get_any(v, "expiry"); found { if !decode_RestrictionExpiry(fv, &out.expiry) do return fail("GameRestriction::ProhibitActivity.expiry") } else { return fail("GameRestriction::ProhibitActivity.expiry missing") }
	if fv, found := get_any(v, "activity"); found { if !decode_ProhibitedActivity(fv, &out.activity) do return fail("GameRestriction::ProhibitActivity.activity") } else { return fail("GameRestriction::ProhibitActivity.activity missing") }
	return true
		}) { return fail("GameRestriction::ProhibitActivity") }
		out^ = tmp
	case "CantEnterBattlefieldFrom":
		tmp: GameRestriction_CantEnterBattlefieldFrom
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^GameRestriction_CantEnterBattlefieldFrom) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("GameRestriction::CantEnterBattlefieldFrom.source") } else { return fail("GameRestriction::CantEnterBattlefieldFrom.source missing") }
	if fv, found := get_any(v, "expiry"); found { if !decode_RestrictionExpiry(fv, &out.expiry) do return fail("GameRestriction::CantEnterBattlefieldFrom.expiry") } else { return fail("GameRestriction::CantEnterBattlefieldFrom.expiry missing") }
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("GameRestriction::CantEnterBattlefieldFrom.filter") } else { return fail("GameRestriction::CantEnterBattlefieldFrom.filter missing") }
	return true
		}) { return fail("GameRestriction::CantEnterBattlefieldFrom") }
		out^ = tmp
	case: return fail("GameRestriction: unknown variant")
	}
	return true
}

encode_GameRestriction :: proc(b: ^strings.Builder, x: GameRestriction) {
	#partial switch y in x {
	case GameRestriction_DamagePreventionDisabled: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DamagePreventionDisabled")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "expiry"); encode_RestrictionExpiry(b, y.expiry)
	if !(y.scope == nil) { member(b, first, "scope"); enc_opt_RestrictionScope(b, y.scope) }
	}; strings.write_byte(b, '}')
	case GameRestriction_ProhibitActivity: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ProhibitActivity")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "affected_players"); encode_RestrictionPlayerScope(b, y.affected_players)
	member(b, first, "expiry"); encode_RestrictionExpiry(b, y.expiry)
	member(b, first, "activity"); encode_ProhibitedActivity(b, y.activity)
	}; strings.write_byte(b, '}')
	case GameRestriction_CantEnterBattlefieldFrom: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CantEnterBattlefieldFrom")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "expiry"); encode_RestrictionExpiry(b, y.expiry)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	}
}

encode_GameRestriction_members :: proc(b: ^strings.Builder, x: GameRestriction, first: ^bool) {
	#partial switch y in x {
	case GameRestriction_DamagePreventionDisabled: member(b, first, "type"); json.write_string(b, "DamagePreventionDisabled")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "expiry"); encode_RestrictionExpiry(b, y.expiry)
	if !(y.scope == nil) { member(b, first, "scope"); enc_opt_RestrictionScope(b, y.scope) }

	case GameRestriction_ProhibitActivity: member(b, first, "type"); json.write_string(b, "ProhibitActivity")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "affected_players"); encode_RestrictionPlayerScope(b, y.affected_players)
	member(b, first, "expiry"); encode_RestrictionExpiry(b, y.expiry)
	member(b, first, "activity"); encode_ProhibitedActivity(b, y.activity)

	case GameRestriction_CantEnterBattlefieldFrom: member(b, first, "type"); json.write_string(b, "CantEnterBattlefieldFrom")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "expiry"); encode_RestrictionExpiry(b, y.expiry)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	}
}

decode_NextSpellModifier :: proc(v: json.Value, out: ^NextSpellModifier) -> bool {
	if v.kind != .Object do return fail("NextSpellModifier: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("NextSpellModifier: no tag")
	switch tv.text {
	case "CantBeCountered": out^ = NextSpellModifier_CantBeCountered{}
	case "HasKeyword":
		tmp: NextSpellModifier_HasKeyword
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^NextSpellModifier_HasKeyword) -> bool {
	if fv, found := get_any(v, "keyword"); found { if !decode_Keyword(fv, &out.keyword) do return fail("NextSpellModifier::HasKeyword.keyword") } else { return fail("NextSpellModifier::HasKeyword.keyword missing") }
	return true
		}) { return fail("NextSpellModifier::HasKeyword") }
		out^ = tmp
	case "CastAsThoughFlash": out^ = NextSpellModifier_CastAsThoughFlash{}
	case "WithoutPayingManaCost": out^ = NextSpellModifier_WithoutPayingManaCost{}
	case: return fail("NextSpellModifier: unknown variant")
	}
	return true
}

encode_NextSpellModifier :: proc(b: ^strings.Builder, x: NextSpellModifier) {
	#partial switch y in x {
	case NextSpellModifier_CantBeCountered: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CantBeCountered"); strings.write_byte(b, '}')
	case NextSpellModifier_HasKeyword: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HasKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)
	}; strings.write_byte(b, '}')
	case NextSpellModifier_CastAsThoughFlash: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CastAsThoughFlash"); strings.write_byte(b, '}')
	case NextSpellModifier_WithoutPayingManaCost: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "WithoutPayingManaCost"); strings.write_byte(b, '}')
	}
}

encode_NextSpellModifier_members :: proc(b: ^strings.Builder, x: NextSpellModifier, first: ^bool) {
	#partial switch y in x {
	case NextSpellModifier_CantBeCountered: _ = y; member(b, first, "type"); json.write_string(b, "CantBeCountered")
	case NextSpellModifier_HasKeyword: member(b, first, "type"); json.write_string(b, "HasKeyword")
	member(b, first, "keyword"); encode_Keyword(b, y.keyword)

	case NextSpellModifier_CastAsThoughFlash: _ = y; member(b, first, "type"); json.write_string(b, "CastAsThoughFlash")
	case NextSpellModifier_WithoutPayingManaCost: _ = y; member(b, first, "type"); json.write_string(b, "WithoutPayingManaCost")
	}
}

decode_PendingEntersModifications :: proc(v: json.Value, out: ^PendingEntersModifications) -> bool {
	if v.kind != .Object do return fail("PendingEntersModifications: not an object")
	if fv, found := get_any(v, "modifications"); found { if !dec_dyn_ContinuousModification(fv, &out.modifications) do return fail("PendingEntersModifications.modifications") }
	if fv, found := get_any(v, "cast_filter"); found { if !dec_opt_TargetFilter(fv, &out.cast_filter) do return fail("PendingEntersModifications.cast_filter") }
	return true
}

encode_PendingEntersModifications :: proc(b: ^strings.Builder, x: PendingEntersModifications) {
	strings.write_byte(b, '{')
	f := true
	encode_PendingEntersModifications_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PendingEntersModifications_members :: proc(b: ^strings.Builder, x: PendingEntersModifications, first: ^bool) {
	if !(len(x.modifications) == 0) { member(b, first, "modifications"); enc_dyn_ContinuousModification(b, x.modifications) }
	if !(x.cast_filter == nil) { member(b, first, "cast_filter"); enc_opt_TargetFilter(b, x.cast_filter) }
}

decode_CardPlayMode :: proc(v: json.Value, out: ^CardPlayMode) -> bool {
	if v.kind != .String do return fail("CardPlayMode: not a string")
	str := v.text
