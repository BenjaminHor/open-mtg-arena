	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("BoundSearchFoundGrant.controller") } else { return fail("BoundSearchFoundGrant.controller missing") }
	if fv, found := get_any(v, "grantee"); found { if !decode_PlayerId(fv, &out.grantee) do return fail("BoundSearchFoundGrant.grantee") } else { return fail("BoundSearchFoundGrant.grantee missing") }
	if fv, found := get_any(v, "mana_spend_permission"); found { if !dec_opt_ManaSpendPermission(fv, &out.mana_spend_permission) do return fail("BoundSearchFoundGrant.mana_spend_permission") }
	return true
}

