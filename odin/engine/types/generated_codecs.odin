	f := true
	encode_LibraryShuffleMode_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_LibraryShuffleMode_members :: proc(b: ^strings.Builder, x: LibraryShuffleMode, first: ^bool) {
	_ = x
	@(static, rodata) NAMES := [LibraryShuffleMode]string{
		.PerObject = "PerObject",
		.TerminalShuffle = "TerminalShuffle",
	}
	member(b, first, "type"); json.write_string(b, NAMES[x])
}

