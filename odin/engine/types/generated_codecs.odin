decode_CombatRequirement :: proc(v: json.Value, out: ^CombatRequirement) -> bool {
	when COVERAGE do cov_hit("CombatRequirement")
	if v.kind != .Object do return fail("CombatRequirement: not an object")
	tv, found := json.get(v, "kind")
	if !found || tv.kind != .String do return fail("CombatRequirement: no tag")
	switch tv.text {
	case "MustAttack": when COVERAGE do cov_hit("CombatRequirement::MustAttack");
		tmp: CombatRequirement_MustAttack
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CombatRequirement_MustAttack) -> bool {
	if fv, found := get_any(v, "defenders", "players"); found { if !dec_dyn_AttackTarget(fv, &out.defenders) do return fail("CombatRequirement::MustAttack.defenders") } else { return fail("CombatRequirement::MustAttack.defenders missing") }
	if fv, found := get_any(v, "sources"); found { if !dec_dyn_ObjectId(fv, &out.sources) do return fail("CombatRequirement::MustAttack.sources") }
	return true
		}) { return fail("CombatRequirement::MustAttack") }
		out^ = tmp
	case "MustBlock": when COVERAGE do cov_hit("CombatRequirement::MustBlock");
		tmp: CombatRequirement_MustBlock
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CombatRequirement_MustBlock) -> bool {
	if fv, found := get_any(v, "sources"); found { if !dec_dyn_ObjectId(fv, &out.sources) do return fail("CombatRequirement::MustBlock.sources") }
	if fv, found := get_any(v, "attackers"); found { if !dec_dyn_ObjectId(fv, &out.attackers) do return fail("CombatRequirement::MustBlock.attackers") }
	return true
		}) { return fail("CombatRequirement::MustBlock") }
		out^ = tmp
	case "CantAttack": when COVERAGE do cov_hit("CombatRequirement::CantAttack");
		tmp: CombatRequirement_CantAttack
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CombatRequirement_CantAttack) -> bool {
	if fv, found := get_any(v, "sources"); found { if !dec_dyn_ObjectId(fv, &out.sources) do return fail("CombatRequirement::CantAttack.sources") }
	return true
		}) { return fail("CombatRequirement::CantAttack") }
		out^ = tmp
	case "CantBlock": when COVERAGE do cov_hit("CombatRequirement::CantBlock");
		tmp: CombatRequirement_CantBlock
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CombatRequirement_CantBlock) -> bool {
	if fv, found := get_any(v, "sources"); found { if !dec_dyn_ObjectId(fv, &out.sources) do return fail("CombatRequirement::CantBlock.sources") }
	return true
		}) { return fail("CombatRequirement::CantBlock") }
		out^ = tmp
	case: return fail("CombatRequirement: unknown variant")
	}
	return true
}

encode_CombatRequirement :: proc(b: ^strings.Builder, x: CombatRequirement) {
	#partial switch y in x {
	case CombatRequirement_MustAttack: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "MustAttack")
	member(b, first, "defenders"); enc_dyn_AttackTarget(b, y.defenders)
	if !((len(y.sources) == 0)) { member(b, first, "sources"); enc_dyn_ObjectId(b, y.sources) }
	}; strings.write_byte(b, '}')
	case CombatRequirement_MustBlock: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "MustBlock")
	if !((len(y.sources) == 0)) { member(b, first, "sources"); enc_dyn_ObjectId(b, y.sources) }
	if !((len(y.attackers) == 0)) { member(b, first, "attackers"); enc_dyn_ObjectId(b, y.attackers) }
	}; strings.write_byte(b, '}')
	case CombatRequirement_CantAttack: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "CantAttack")
	if !((len(y.sources) == 0)) { member(b, first, "sources"); enc_dyn_ObjectId(b, y.sources) }
	}; strings.write_byte(b, '}')
	case CombatRequirement_CantBlock: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "kind"); json.write_string(b, "CantBlock")
	if !((len(y.sources) == 0)) { member(b, first, "sources"); enc_dyn_ObjectId(b, y.sources) }
	}; strings.write_byte(b, '}')
	}
}

encode_CombatRequirement_members :: proc(b: ^strings.Builder, x: CombatRequirement, first: ^bool) {
	#partial switch y in x {
	case CombatRequirement_MustAttack: member(b, first, "kind"); json.write_string(b, "MustAttack")
	member(b, first, "defenders"); enc_dyn_AttackTarget(b, y.defenders)
	if !((len(y.sources) == 0)) { member(b, first, "sources"); enc_dyn_ObjectId(b, y.sources) }

	case CombatRequirement_MustBlock: member(b, first, "kind"); json.write_string(b, "MustBlock")
	if !((len(y.sources) == 0)) { member(b, first, "sources"); enc_dyn_ObjectId(b, y.sources) }
	if !((len(y.attackers) == 0)) { member(b, first, "attackers"); enc_dyn_ObjectId(b, y.attackers) }

	case CombatRequirement_CantAttack: member(b, first, "kind"); json.write_string(b, "CantAttack")
	if !((len(y.sources) == 0)) { member(b, first, "sources"); enc_dyn_ObjectId(b, y.sources) }

	case CombatRequirement_CantBlock: member(b, first, "kind"); json.write_string(b, "CantBlock")
	if !((len(y.sources) == 0)) { member(b, first, "sources"); enc_dyn_ObjectId(b, y.sources) }

	}
}

