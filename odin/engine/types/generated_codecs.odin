decode_OutsideGameChoiceSource :: proc(v: json.Value, out: ^OutsideGameChoiceSource) -> bool {
	when COVERAGE do cov_hit("OutsideGameChoiceSource")
	if v.kind != .Object do return fail("OutsideGameChoiceSource: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("OutsideGameChoiceSource: no tag")
	switch tv.text {
	case "Sideboard": when COVERAGE do cov_hit("OutsideGameChoiceSource::Sideboard");
		tmp: OutsideGameChoiceSource_Sideboard
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^OutsideGameChoiceSource_Sideboard) -> bool {
	if fv, found := get_any(v, "sideboard_index"); found { if !decode_int(fv, &out.sideboard_index) do return fail("OutsideGameChoiceSource::Sideboard.sideboard_index") } else { return fail("OutsideGameChoiceSource::Sideboard.sideboard_index missing") }
	if fv, found := get_any(v, "card"); found { if !decode_CardFace(fv, &out.card) do return fail("OutsideGameChoiceSource::Sideboard.card") } else { return fail("OutsideGameChoiceSource::Sideboard.card missing") }
	return true
		}) { return fail("OutsideGameChoiceSource::Sideboard") }
		out^ = tmp
	case "FaceUpExile": when COVERAGE do cov_hit("OutsideGameChoiceSource::FaceUpExile");
		tmp: OutsideGameChoiceSource_FaceUpExile
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^OutsideGameChoiceSource_FaceUpExile) -> bool {
	if fv, found := get_any(v, "object_id"); found { if !decode_ObjectId(fv, &out.object_id) do return fail("OutsideGameChoiceSource::FaceUpExile.object_id") } else { return fail("OutsideGameChoiceSource::FaceUpExile.object_id missing") }
	return true
		}) { return fail("OutsideGameChoiceSource::FaceUpExile") }
		out^ = tmp
	case "BoosterPack": when COVERAGE do cov_hit("OutsideGameChoiceSource::BoosterPack");
		tmp: OutsideGameChoiceSource_BoosterPack
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^OutsideGameChoiceSource_BoosterPack) -> bool {
	if fv, found := get_any(v, "pack_slot"); found { if !decode_int(fv, &out.pack_slot) do return fail("OutsideGameChoiceSource::BoosterPack.pack_slot") } else { return fail("OutsideGameChoiceSource::BoosterPack.pack_slot missing") }
	if fv, found := get_any(v, "origin"); found { if !decode_PackOrigin(fv, &out.origin) do return fail("OutsideGameChoiceSource::BoosterPack.origin") } else { return fail("OutsideGameChoiceSource::BoosterPack.origin missing") }
	if fv, found := get_any(v, "card"); found { if !dec_ptr_CardFace(fv, &out.card) do return fail("OutsideGameChoiceSource::BoosterPack.card") } else { return fail("OutsideGameChoiceSource::BoosterPack.card missing") }
	return true
		}) { return fail("OutsideGameChoiceSource::BoosterPack") }
		out^ = tmp
	case "Companion": when COVERAGE do cov_hit("OutsideGameChoiceSource::Companion");
		tmp: OutsideGameChoiceSource_Companion
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^OutsideGameChoiceSource_Companion) -> bool {
	if fv, found := get_any(v, "card"); found { if !dec_ptr_CardFace(fv, &out.card) do return fail("OutsideGameChoiceSource::Companion.card") } else { return fail("OutsideGameChoiceSource::Companion.card missing") }
	return true
		}) { return fail("OutsideGameChoiceSource::Companion") }
		out^ = tmp
	case: return fail("OutsideGameChoiceSource: unknown variant")
	}
	return true
}

encode_OutsideGameChoiceSource :: proc(b: ^strings.Builder, x: OutsideGameChoiceSource) {
	#partial switch y in x {
	case OutsideGameChoiceSource_Sideboard: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Sideboard"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "sideboard_index"); encode_int(b, y.sideboard_index)
	member(b, first, "card"); encode_CardFace(b, y.card)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case OutsideGameChoiceSource_FaceUpExile: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "FaceUpExile"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "object_id"); encode_ObjectId(b, y.object_id)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case OutsideGameChoiceSource_BoosterPack: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BoosterPack"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "pack_slot"); encode_int(b, y.pack_slot)
	member(b, first, "origin"); encode_PackOrigin(b, y.origin)
	member(b, first, "card"); enc_ptr_CardFace(b, y.card)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case OutsideGameChoiceSource_Companion: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Companion"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card"); enc_ptr_CardFace(b, y.card)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

