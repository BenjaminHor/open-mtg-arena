	member(b, first, "actor"); encode_PlayerId(b, x.actor)
	member(b, first, "action"); encode_GameAction(b, x.action)
	if !(skip_RecordedAction_RecordedActionKind_is_submitted_RecordedActionKind(x.kind)) { member(b, first, "kind"); encode_RecordedActionKind(b, x.kind) }
}

