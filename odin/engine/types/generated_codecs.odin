decode_DeckSection :: proc(v: json.Value, out: ^DeckSection) -> bool {
	when COVERAGE do cov_hit("DeckSection")
	if v.kind != .String do return fail("DeckSection: not a string")
	str := v.text
	switch str {
	case "main_deck": when COVERAGE do cov_hit("DeckSection::main_deck"); out^ = .MainDeck
	case "sideboard": when COVERAGE do cov_hit("DeckSection::sideboard"); out^ = .Sideboard
	case "commander": when COVERAGE do cov_hit("DeckSection::commander"); out^ = .Commander
	case "companion": when COVERAGE do cov_hit("DeckSection::companion"); out^ = .Companion
	case "attraction_deck": when COVERAGE do cov_hit("DeckSection::attraction_deck"); out^ = .AttractionDeck
	case "planar_deck": when COVERAGE do cov_hit("DeckSection::planar_deck"); out^ = .PlanarDeck
	case "scheme_deck": when COVERAGE do cov_hit("DeckSection::scheme_deck"); out^ = .SchemeDeck
	case "contraption_deck": when COVERAGE do cov_hit("DeckSection::contraption_deck"); out^ = .ContraptionDeck
	case "signature_spell": when COVERAGE do cov_hit("DeckSection::signature_spell"); out^ = .SignatureSpell
	case "unknown": when COVERAGE do cov_hit("DeckSection::unknown"); out^ = .Unknown
	case: out^ = .Unknown
	}
	return true
}

encode_DeckSection :: proc(b: ^strings.Builder, x: DeckSection) {
	@(static, rodata) NAMES := [DeckSection]string{
		.MainDeck = "main_deck",
		.Sideboard = "sideboard",
		.Commander = "commander",
		.Companion = "companion",
		.AttractionDeck = "attraction_deck",
		.PlanarDeck = "planar_deck",
		.SchemeDeck = "scheme_deck",
		.ContraptionDeck = "contraption_deck",
		.SignatureSpell = "signature_spell",
		.Unknown = "unknown",
	}
	json.write_string(b, NAMES[x])
}

