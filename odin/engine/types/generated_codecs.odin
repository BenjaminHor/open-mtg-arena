decode_EachDamageRecipient :: proc(v: json.Value, out: ^EachDamageRecipient) -> bool {
	if v.kind != .Object do return fail("EachDamageRecipient: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("EachDamageRecipient: no tag")
	switch tv.text {
	case "Shared": tmp: EachDamageRecipient_Shared; if !decode_TargetFilter(json.get_or_null(v, "data"), &tmp._0) do return fail("EachDamageRecipient::Shared"); out^ = tmp
	case "EachController": out^ = EachDamageRecipient_EachController{}
	case "OtherBatchSource":
		tmp: EachDamageRecipient_OtherBatchSource
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^EachDamageRecipient_OtherBatchSource) -> bool {
	if fv, found := get_any(v, "source_filters"); found { if !dec__2_ptr_TargetFilter(fv, &out.source_filters) do return fail("EachDamageRecipient::OtherBatchSource.source_filters") } else { return fail("EachDamageRecipient::OtherBatchSource.source_filters missing") }
	return true
		}) { return fail("EachDamageRecipient::OtherBatchSource") }
		out^ = tmp
	case: return fail("EachDamageRecipient: unknown variant")
	}
	return true
}

encode_EachDamageRecipient :: proc(b: ^strings.Builder, x: EachDamageRecipient) {
	#partial switch y in x {
	case EachDamageRecipient_Shared: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Shared"); member(b, &f, "data"); encode_TargetFilter(b, y._0); strings.write_byte(b, '}')
	case EachDamageRecipient_EachController: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EachController"); strings.write_byte(b, '}')
	case EachDamageRecipient_OtherBatchSource: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OtherBatchSource"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "source_filters"); enc__2_ptr_TargetFilter(b, y.source_filters)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_CounterSourceRider :: proc(v: json.Value, out: ^CounterSourceRider) -> bool {
	if v.kind != .Object do return fail("CounterSourceRider: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("CounterSourceRider: no tag")
	switch tv.text {
	case "LosesAbilities":
		tmp: CounterSourceRider_LosesAbilities
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^CounterSourceRider_LosesAbilities) -> bool {
	if fv, found := get_any(v, "static_def"); found { if !dec_ptr_StaticDefinition(fv, &out.static_def) do return fail("CounterSourceRider::LosesAbilities.static_def") } else { return fail("CounterSourceRider::LosesAbilities.static_def missing") }
	if fv, found := get_any(v, "source_filter"); found { if !dec_ptr_TargetFilter(fv, &out.source_filter) do return fail("CounterSourceRider::LosesAbilities.source_filter") }
	if fv, found := get_any(v, "duration"); found { if !dec_ptr_Duration(fv, &out.duration) do return fail("CounterSourceRider::LosesAbilities.duration") } else { out.duration = default_CounterSourceRider_duration_until_host_leaves_play() }
	return true
		}) { return fail("CounterSourceRider::LosesAbilities") }
		out^ = tmp
	case "Destroy": out^ = CounterSourceRider_Destroy{}
	case: return fail("CounterSourceRider: unknown variant")
	}
	return true
}

encode_CounterSourceRider :: proc(b: ^strings.Builder, x: CounterSourceRider) {
	#partial switch y in x {
	case CounterSourceRider_LosesAbilities: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "LosesAbilities")
	member(b, first, "static_def"); enc_ptr_StaticDefinition(b, y.static_def)
	if !(y.source_filter == nil) { member(b, first, "source_filter"); enc_ptr_TargetFilter(b, y.source_filter) }
	member(b, first, "duration"); enc_ptr_Duration(b, y.duration)
	}; strings.write_byte(b, '}')
	case CounterSourceRider_Destroy: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Destroy"); strings.write_byte(b, '}')
	}
}

encode_CounterSourceRider_members :: proc(b: ^strings.Builder, x: CounterSourceRider, first: ^bool) {
	#partial switch y in x {
	case CounterSourceRider_LosesAbilities: member(b, first, "type"); json.write_string(b, "LosesAbilities")
	member(b, first, "static_def"); enc_ptr_StaticDefinition(b, y.static_def)
	if !(y.source_filter == nil) { member(b, first, "source_filter"); enc_ptr_TargetFilter(b, y.source_filter) }
	member(b, first, "duration"); enc_ptr_Duration(b, y.duration)

	case CounterSourceRider_Destroy: _ = y; member(b, first, "type"); json.write_string(b, "Destroy")
	}
}

