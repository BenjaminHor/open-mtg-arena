	member(b, first, "counters"); encode_with_counter_map_serde(b, x.counters)
	member(b, first, "tapped"); encode_bool(b, x.tapped)
	member(b, first, "is_suspected"); encode_bool(b, x.is_suspected)
	member(b, first, "was_prepared"); encode_bool(b, x.was_prepared)
	member(b, first, "attachments"); enc_dyn_AttachmentSnapshot(b, x.attachments)
	member(b, first, "intensity"); encode_u32(b, x.intensity)
}

