		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ProposedEvent_ProduceMana) -> bool {
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("ProposedEvent::ProduceMana.source_id") } else { return fail("ProposedEvent::ProduceMana.source_id missing") }
	if fv, found := get_any(v, "player_id"); found { if !decode_PlayerId(fv, &out.player_id) do return fail("ProposedEvent::ProduceMana.player_id") } else { return fail("ProposedEvent::ProduceMana.player_id missing") }
	if fv, found := get_any(v, "mana_type"); found { if !decode_ManaType(fv, &out.mana_type) do return fail("ProposedEvent::ProduceMana.mana_type") } else { return fail("ProposedEvent::ProduceMana.mana_type missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("ProposedEvent::ProduceMana.count") } else { out.count = default_ProposedEvent_default_produce_mana_count() }
	if fv, found := get_any(v, "tapped_for_mana"); found { if !decode_bool(fv, &out.tapped_for_mana) do return fail("ProposedEvent::ProduceMana.tapped_for_mana") }
