decode_PeriodItem :: proc(v: json.Value, out: ^PeriodItem) -> bool {
	when COVERAGE do cov_hit("PeriodItem")
	if v.kind != .Object do return fail("PeriodItem: not an object")
	if fv, found := get_any(v, "seat"); found { if !decode_PlayerId(fv, &out.seat) do return fail("PeriodItem.seat") } else { return fail("PeriodItem.seat missing") }
	if fv, found := get_any(v, "action"); found { if !decode_GameAction(fv, &out.action) do return fail("PeriodItem.action") } else { return fail("PeriodItem.action missing") }
	if fv, found := get_any(v, "play"); found { if !dec_opt_t2_int_PromptClass(fv, &out.play) do return fail("PeriodItem.play") }
	if fv, found := get_any(v, "mandatory_answer"); found { if !decode_bool(fv, &out.mandatory_answer) do return fail("PeriodItem.mandatory_answer") } else { return fail("PeriodItem.mandatory_answer missing") }
	if fv, found := get_any(v, "next_object_id"); found { if !decode_u64(fv, &out.next_object_id) do return fail("PeriodItem.next_object_id") } else { return fail("PeriodItem.next_object_id missing") }
	if fv, found := get_any(v, "minted_since"); found { if !decode_u64(fv, &out.minted_since) do return fail("PeriodItem.minted_since") } else { return fail("PeriodItem.minted_since missing") }
	if fv, found := get_any(v, "cost_move"); found { if !dec_opt_CostMove(fv, &out.cost_move) do return fail("PeriodItem.cost_move") }
	if fv, found := get_any(v, "point"); found { if !dec_opt_ChoicePoint(fv, &out.point) do return fail("PeriodItem.point") }
	return true
}

encode_PeriodItem :: proc(b: ^strings.Builder, x: PeriodItem) {
	strings.write_byte(b, '{')
	f := true
	encode_PeriodItem_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PeriodItem_members :: proc(b: ^strings.Builder, x: PeriodItem, first: ^bool) {
	member(b, first, "seat"); encode_PlayerId(b, x.seat)
	member(b, first, "action"); encode_GameAction(b, x.action)
	member(b, first, "play"); enc_opt_t2_int_PromptClass(b, x.play)
	member(b, first, "mandatory_answer"); encode_bool(b, x.mandatory_answer)
	member(b, first, "next_object_id"); encode_u64(b, x.next_object_id)
	member(b, first, "minted_since"); encode_u64(b, x.minted_since)
	member(b, first, "cost_move"); enc_opt_CostMove(b, x.cost_move)
	if !(x.point == nil) { member(b, first, "point"); enc_opt_ChoicePoint(b, x.point) }
}

