	if fv, found := get_any(v, "count"); found { if !decode_CostObjectCount(fv, &out.count) do return fail("AbilityCost::ExileMaterials.count") } else { out.count = default_CostObjectCount() }
	return true
		}) { return fail("AbilityCost::ExileMaterials") }
		out^ = tmp
	case "CollectEvidence": when COVERAGE do cov_hit("AbilityCost::CollectEvidence");
		tmp: AbilityCost_CollectEvidence
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_CollectEvidence) -> bool {
	if fv, found := get_any(v, "amount"); found { if !decode_u32(fv, &out.amount) do return fail("AbilityCost::CollectEvidence.amount") } else { return fail("AbilityCost::CollectEvidence.amount missing") }
	return true
		}) { return fail("AbilityCost::CollectEvidence") }
		out^ = tmp
	case "ExileWithAggregate": when COVERAGE do cov_hit("AbilityCost::ExileWithAggregate");
		tmp: AbilityCost_ExileWithAggregate
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_ExileWithAggregate) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("AbilityCost::ExileWithAggregate.filter") } else { return fail("AbilityCost::ExileWithAggregate.filter missing") }
	if fv, found := get_any(v, "function"); found { if !decode_AggregateFunction(fv, &out.function) do return fail("AbilityCost::ExileWithAggregate.function") } else { return fail("AbilityCost::ExileWithAggregate.function missing") }
	if fv, found := get_any(v, "property"); found { if !decode_ObjectProperty(fv, &out.property) do return fail("AbilityCost::ExileWithAggregate.property") } else { return fail("AbilityCost::ExileWithAggregate.property missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("AbilityCost::ExileWithAggregate.comparator") } else { return fail("AbilityCost::ExileWithAggregate.comparator missing") }
	if fv, found := get_any(v, "value"); found { if !decode_i32(fv, &out.value) do return fail("AbilityCost::ExileWithAggregate.value") } else { return fail("AbilityCost::ExileWithAggregate.value missing") }
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("AbilityCost::ExileWithAggregate.zone") } else { return fail("AbilityCost::ExileWithAggregate.zone missing") }
	return true
		}) { return fail("AbilityCost::ExileWithAggregate") }
		out^ = tmp
	case "TapCreatures": when COVERAGE do cov_hit("AbilityCost::TapCreatures");
		tmp: AbilityCost_TapCreatures
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_TapCreatures) -> bool {
	if fv, found := get_any(v, "requirement", "count"); found { if !decode_TapCreaturesRequirement(fv, &out.requirement) do return fail("AbilityCost::TapCreatures.requirement") } else { out.requirement = default_TapCreaturesRequirement() }
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("AbilityCost::TapCreatures.filter") } else { return fail("AbilityCost::TapCreatures.filter missing") }
	return true
		}) { return fail("AbilityCost::TapCreatures") }
		out^ = tmp
	case "RemoveCounter": when COVERAGE do cov_hit("AbilityCost::RemoveCounter");
		tmp: AbilityCost_RemoveCounter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_RemoveCounter) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("AbilityCost::RemoveCounter.count") } else { return fail("AbilityCost::RemoveCounter.count missing") }
	if fv, found := get_any(v, "counter_type"); found { if !decode_CounterMatch(fv, &out.counter_type) do return fail("AbilityCost::RemoveCounter.counter_type") } else { return fail("AbilityCost::RemoveCounter.counter_type missing") }
	if fv, found := get_any(v, "target"); found { if !dec_opt_TargetFilter(fv, &out.target) do return fail("AbilityCost::RemoveCounter.target") }
	if fv, found := get_any(v, "selection"); found { if !decode_CounterCostSelection(fv, &out.selection) do return fail("AbilityCost::RemoveCounter.selection") }
	return true
		}) { return fail("AbilityCost::RemoveCounter") }
		out^ = tmp
	case "PayEnergy": when COVERAGE do cov_hit("AbilityCost::PayEnergy");
		tmp: AbilityCost_PayEnergy
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_PayEnergy) -> bool {
	if fv, found := get_any(v, "amount"); found { if !decode_QuantityExpr(fv, &out.amount) do return fail("AbilityCost::PayEnergy.amount") } else { return fail("AbilityCost::PayEnergy.amount missing") }
	return true
		}) { return fail("AbilityCost::PayEnergy") }
		out^ = tmp
	case "PaySpeed": when COVERAGE do cov_hit("AbilityCost::PaySpeed");
		tmp: AbilityCost_PaySpeed
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_PaySpeed) -> bool {
	if fv, found := get_any(v, "amount"); found { if !decode_QuantityExpr(fv, &out.amount) do return fail("AbilityCost::PaySpeed.amount") } else { return fail("AbilityCost::PaySpeed.amount missing") }
	return true
		}) { return fail("AbilityCost::PaySpeed") }
		out^ = tmp
	case "ReturnToHand": when COVERAGE do cov_hit("AbilityCost::ReturnToHand");
		tmp: AbilityCost_ReturnToHand
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_ReturnToHand) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("AbilityCost::ReturnToHand.count") } else { return fail("AbilityCost::ReturnToHand.count missing") }
	if fv, found := get_any(v, "filter"); found { if !dec_opt_TargetFilter(fv, &out.filter) do return fail("AbilityCost::ReturnToHand.filter") }
	if fv, found := get_any(v, "from_zone"); found { if !dec_opt_Zone(fv, &out.from_zone) do return fail("AbilityCost::ReturnToHand.from_zone") }
	return true
		}) { return fail("AbilityCost::ReturnToHand") }
		out^ = tmp
	case "Unattach": when COVERAGE do cov_hit("AbilityCost::Unattach"); out^ = AbilityCost_Unattach{}
	case "UnattachFrom": when COVERAGE do cov_hit("AbilityCost::UnattachFrom");
		tmp: AbilityCost_UnattachFrom
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_UnattachFrom) -> bool {
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("AbilityCost::UnattachFrom.filter") } else { return fail("AbilityCost::UnattachFrom.filter missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("AbilityCost::UnattachFrom.count") } else { return fail("AbilityCost::UnattachFrom.count missing") }
	return true
		}) { return fail("AbilityCost::UnattachFrom") }
		out^ = tmp
	case "Mill": when COVERAGE do cov_hit("AbilityCost::Mill");
		tmp: AbilityCost_Mill
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_Mill) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("AbilityCost::Mill.count") } else { return fail("AbilityCost::Mill.count missing") }
	return true
		}) { return fail("AbilityCost::Mill") }
		out^ = tmp
	case "Exert": when COVERAGE do cov_hit("AbilityCost::Exert"); out^ = AbilityCost_Exert{}
	case "Blight": when COVERAGE do cov_hit("AbilityCost::Blight");
		tmp: AbilityCost_Blight
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_Blight) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("AbilityCost::Blight.count") } else { return fail("AbilityCost::Blight.count missing") }
	return true
		}) { return fail("AbilityCost::Blight") }
		out^ = tmp
	case "Reveal": when COVERAGE do cov_hit("AbilityCost::Reveal");
		tmp: AbilityCost_Reveal
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_Reveal) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("AbilityCost::Reveal.count") } else { out.count = default_AbilityCost_default_quantity_one() }
	if fv, found := get_any(v, "filter"); found { if !dec_opt_TargetFilter(fv, &out.filter) do return fail("AbilityCost::Reveal.filter") }
	if fv, found := get_any(v, "shared_quality"); found { if !dec_opt_SharedQuality(fv, &out.shared_quality) do return fail("AbilityCost::Reveal.shared_quality") }
	return true
		}) { return fail("AbilityCost::Reveal") }
		out^ = tmp
	case "Behold": when COVERAGE do cov_hit("AbilityCost::Behold");
		tmp: AbilityCost_Behold
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_Behold) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("AbilityCost::Behold.count") } else { out.count = default_AbilityCost_default_one() }
	if fv, found := get_any(v, "filter"); found { if !decode_TargetFilter(fv, &out.filter) do return fail("AbilityCost::Behold.filter") } else { return fail("AbilityCost::Behold.filter missing") }
	if fv, found := get_any(v, "action"); found { if !decode_BeholdCostAction(fv, &out.action) do return fail("AbilityCost::Behold.action") } else { return fail("AbilityCost::Behold.action missing") }
	if fv, found := get_any(v, "type_choice"); found { if !dec_opt_ChoiceType(fv, &out.type_choice) do return fail("AbilityCost::Behold.type_choice") }
	return true
		}) { return fail("AbilityCost::Behold") }
		out^ = tmp
	case "Composite": when COVERAGE do cov_hit("AbilityCost::Composite");
		tmp: AbilityCost_Composite
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_Composite) -> bool {
	if fv, found := get_any(v, "costs"); found { if !dec_dyn_AbilityCost(fv, &out.costs) do return fail("AbilityCost::Composite.costs") } else { return fail("AbilityCost::Composite.costs missing") }
	return true
		}) { return fail("AbilityCost::Composite") }
		out^ = tmp
	case "OneOf": when COVERAGE do cov_hit("AbilityCost::OneOf");
		tmp: AbilityCost_OneOf
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_OneOf) -> bool {
	if fv, found := get_any(v, "costs"); found { if !dec_dyn_AbilityCost(fv, &out.costs) do return fail("AbilityCost::OneOf.costs") } else { return fail("AbilityCost::OneOf.costs missing") }
	return true
		}) { return fail("AbilityCost::OneOf") }
		out^ = tmp
	case "Waterbend": when COVERAGE do cov_hit("AbilityCost::Waterbend");
		tmp: AbilityCost_Waterbend
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_Waterbend) -> bool {
	if fv, found := get_any(v, "cost"); found { if !decode_ManaCost(fv, &out.cost) do return fail("AbilityCost::Waterbend.cost") } else { return fail("AbilityCost::Waterbend.cost missing") }
	return true
		}) { return fail("AbilityCost::Waterbend") }
		out^ = tmp
	case "NinjutsuFamily": when COVERAGE do cov_hit("AbilityCost::NinjutsuFamily");
		tmp: AbilityCost_NinjutsuFamily
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_NinjutsuFamily) -> bool {
	if fv, found := get_any(v, "variant"); found { if !decode_NinjutsuVariant(fv, &out.variant) do return fail("AbilityCost::NinjutsuFamily.variant") } else { return fail("AbilityCost::NinjutsuFamily.variant missing") }
	if fv, found := get_any(v, "mana_cost"); found { if !decode_ManaCost(fv, &out.mana_cost) do return fail("AbilityCost::NinjutsuFamily.mana_cost") } else { return fail("AbilityCost::NinjutsuFamily.mana_cost missing") }
	return true
		}) { return fail("AbilityCost::NinjutsuFamily") }
		out^ = tmp
	case "EffectCost": when COVERAGE do cov_hit("AbilityCost::EffectCost");
		tmp: AbilityCost_EffectCost
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_EffectCost) -> bool {
	if fv, found := get_any(v, "effect"); found { if !dec_ptr_Effect(fv, &out.effect) do return fail("AbilityCost::EffectCost.effect") } else { return fail("AbilityCost::EffectCost.effect missing") }
	return true
		}) { return fail("AbilityCost::EffectCost") }
		out^ = tmp
	case "PerCounter": when COVERAGE do cov_hit("AbilityCost::PerCounter");
		tmp: AbilityCost_PerCounter
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_PerCounter) -> bool {
	if fv, found := get_any(v, "counter"); found { if !decode_CounterType(fv, &out.counter) do return fail("AbilityCost::PerCounter.counter") } else { return fail("AbilityCost::PerCounter.counter missing") }
	if fv, found := get_any(v, "target"); found { if !decode_TargetFilter(fv, &out.target) do return fail("AbilityCost::PerCounter.target") } else { return fail("AbilityCost::PerCounter.target missing") }
	if fv, found := get_any(v, "base"); found { if !dec_ptr_AbilityCost(fv, &out.base) do return fail("AbilityCost::PerCounter.base") } else { return fail("AbilityCost::PerCounter.base missing") }
	return true
		}) { return fail("AbilityCost::PerCounter") }
		out^ = tmp
	case "KeywordCostOfCastSpell": when COVERAGE do cov_hit("AbilityCost::KeywordCostOfCastSpell");
		tmp: AbilityCost_KeywordCostOfCastSpell
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_KeywordCostOfCastSpell) -> bool {
	if fv, found := get_any(v, "keyword"); found { if !decode_KeywordKind(fv, &out.keyword) do return fail("AbilityCost::KeywordCostOfCastSpell.keyword") } else { return fail("AbilityCost::KeywordCostOfCastSpell.keyword missing") }
	return true
		}) { return fail("AbilityCost::KeywordCostOfCastSpell") }
		out^ = tmp
	case "GetPlayerCounters": when COVERAGE do cov_hit("AbilityCost::GetPlayerCounters");
		tmp: AbilityCost_GetPlayerCounters
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_GetPlayerCounters) -> bool {
	if fv, found := get_any(v, "counter_kind"); found { if !decode_PlayerCounterKind(fv, &out.counter_kind) do return fail("AbilityCost::GetPlayerCounters.counter_kind") } else { return fail("AbilityCost::GetPlayerCounters.counter_kind missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("AbilityCost::GetPlayerCounters.count") } else { return fail("AbilityCost::GetPlayerCounters.count missing") }
	return true
		}) { return fail("AbilityCost::GetPlayerCounters") }
		out^ = tmp
	case "Unimplemented": when COVERAGE do cov_hit("AbilityCost::Unimplemented");
		tmp: AbilityCost_Unimplemented
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCost_Unimplemented) -> bool {
	if fv, found := get_any(v, "description"); found { if !decode_string(fv, &out.description) do return fail("AbilityCost::Unimplemented.description") } else { return fail("AbilityCost::Unimplemented.description missing") }
	return true
		}) { return fail("AbilityCost::Unimplemented") }
		out^ = tmp
	case: return fail("AbilityCost: unknown variant")
	}
	return true
}

encode_AbilityCost :: proc(b: ^strings.Builder, x: AbilityCost) {
	#partial switch y in x {
	case AbilityCost_Mana: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Mana")
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	}; strings.write_byte(b, '}')
	case AbilityCost_ManaDynamic: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ManaDynamic")
	member(b, first, "quantity"); encode_QuantityExpr(b, y.quantity)
	}; strings.write_byte(b, '}')
	case AbilityCost_Tap: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Tap"); strings.write_byte(b, '}')
	case AbilityCost_Untap: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Untap"); strings.write_byte(b, '}')
	case AbilityCost_Loyalty: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Loyalty")
	member(b, first, "amount"); encode_i32(b, y.amount)
	}; strings.write_byte(b, '}')
	case AbilityCost_SayPhrase: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SayPhrase")
	member(b, first, "phrase"); encode_string(b, y.phrase)
	}; strings.write_byte(b, '}')
	case AbilityCost_Sacrifice: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Sacrifice"); encode_SacrificeCost_members(b, y._0, &f); strings.write_byte(b, '}')
	case AbilityCost_PayLife: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PayLife")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	}; strings.write_byte(b, '}')
	case AbilityCost_Discard: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Discard")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter)
	member(b, first, "random"); encode_with_card_selection_bool_compat(b, y.selection)
	member(b, first, "self_ref"); encode_with_discard_self_scope_bool_compat(b, y.self_scope)
	}; strings.write_byte(b, '}')
	case AbilityCost_Exile: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Exile")
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "zone"); enc_opt_Zone(b, y.zone)
	member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case AbilityCost_ExileMaterials: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ExileMaterials")
	member(b, first, "materials"); encode_TargetFilter(b, y.materials)
	member(b, first, "count"); encode_CostObjectCount(b, y.count)
	}; strings.write_byte(b, '}')
	case AbilityCost_CollectEvidence: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CollectEvidence")
	member(b, first, "amount"); encode_u32(b, y.amount)
	}; strings.write_byte(b, '}')
	case AbilityCost_ExileWithAggregate: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ExileWithAggregate")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "function"); encode_AggregateFunction(b, y.function)
	member(b, first, "property"); encode_ObjectProperty(b, y.property)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_i32(b, y.value)
	member(b, first, "zone"); encode_Zone(b, y.zone)
	}; strings.write_byte(b, '}')
	case AbilityCost_TapCreatures: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "TapCreatures")
	member(b, first, "requirement"); encode_TapCreaturesRequirement(b, y.requirement)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	}; strings.write_byte(b, '}')
	case AbilityCost_RemoveCounter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RemoveCounter")
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "counter_type"); encode_CounterMatch(b, y.counter_type)
	member(b, first, "target"); enc_opt_TargetFilter(b, y.target)
	member(b, first, "selection"); encode_CounterCostSelection(b, y.selection)
	}; strings.write_byte(b, '}')
	case AbilityCost_PayEnergy: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PayEnergy")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	}; strings.write_byte(b, '}')
	case AbilityCost_PaySpeed: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PaySpeed")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)
	}; strings.write_byte(b, '}')
	case AbilityCost_ReturnToHand: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ReturnToHand")
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter)
	if !(y.from_zone == nil) { member(b, first, "from_zone"); enc_opt_Zone(b, y.from_zone) }
	}; strings.write_byte(b, '}')
	case AbilityCost_Unattach: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Unattach"); strings.write_byte(b, '}')
	case AbilityCost_UnattachFrom: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UnattachFrom")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}')
	case AbilityCost_Mill: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Mill")
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}')
	case AbilityCost_Exert: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Exert"); strings.write_byte(b, '}')
	case AbilityCost_Blight: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Blight")
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}')
	case AbilityCost_Reveal: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Reveal")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }
	if !(y.shared_quality == nil) { member(b, first, "shared_quality"); enc_opt_SharedQuality(b, y.shared_quality) }
	}; strings.write_byte(b, '}')
	case AbilityCost_Behold: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Behold")
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "action"); encode_BeholdCostAction(b, y.action)
	if !(y.type_choice == nil) { member(b, first, "type_choice"); enc_opt_ChoiceType(b, y.type_choice) }
	}; strings.write_byte(b, '}')
	case AbilityCost_Composite: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Composite")
	member(b, first, "costs"); enc_dyn_AbilityCost(b, y.costs)
	}; strings.write_byte(b, '}')
	case AbilityCost_OneOf: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "OneOf")
	member(b, first, "costs"); enc_dyn_AbilityCost(b, y.costs)
	}; strings.write_byte(b, '}')
	case AbilityCost_Waterbend: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Waterbend")
	member(b, first, "cost"); encode_ManaCost(b, y.cost)
	}; strings.write_byte(b, '}')
	case AbilityCost_NinjutsuFamily: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "NinjutsuFamily")
	member(b, first, "variant"); encode_NinjutsuVariant(b, y.variant)
	member(b, first, "mana_cost"); encode_ManaCost(b, y.mana_cost)
	}; strings.write_byte(b, '}')
	case AbilityCost_EffectCost: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "EffectCost")
	member(b, first, "effect"); enc_ptr_Effect(b, y.effect)
	}; strings.write_byte(b, '}')
	case AbilityCost_PerCounter: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PerCounter")
	member(b, first, "counter"); encode_CounterType(b, y.counter)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "base"); enc_ptr_AbilityCost(b, y.base)
	}; strings.write_byte(b, '}')
	case AbilityCost_KeywordCostOfCastSpell: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "KeywordCostOfCastSpell")
	member(b, first, "keyword"); encode_KeywordKind(b, y.keyword)
	}; strings.write_byte(b, '}')
	case AbilityCost_GetPlayerCounters: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "GetPlayerCounters")
	member(b, first, "counter_kind"); encode_PlayerCounterKind(b, y.counter_kind)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}')
	case AbilityCost_Unimplemented: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Unimplemented")
	member(b, first, "description"); encode_string(b, y.description)
	}; strings.write_byte(b, '}')
	}
}

encode_AbilityCost_members :: proc(b: ^strings.Builder, x: AbilityCost, first: ^bool) {
	#partial switch y in x {
	case AbilityCost_Mana: member(b, first, "type"); json.write_string(b, "Mana")
	member(b, first, "cost"); encode_ManaCost(b, y.cost)

	case AbilityCost_ManaDynamic: member(b, first, "type"); json.write_string(b, "ManaDynamic")
	member(b, first, "quantity"); encode_QuantityExpr(b, y.quantity)

	case AbilityCost_Tap: _ = y; member(b, first, "type"); json.write_string(b, "Tap")
	case AbilityCost_Untap: _ = y; member(b, first, "type"); json.write_string(b, "Untap")
	case AbilityCost_Loyalty: member(b, first, "type"); json.write_string(b, "Loyalty")
	member(b, first, "amount"); encode_i32(b, y.amount)

	case AbilityCost_SayPhrase: member(b, first, "type"); json.write_string(b, "SayPhrase")
	member(b, first, "phrase"); encode_string(b, y.phrase)

	case AbilityCost_Sacrifice: member(b, first, "type"); json.write_string(b, "Sacrifice"); encode_SacrificeCost_members(b, y._0, first)
	case AbilityCost_PayLife: member(b, first, "type"); json.write_string(b, "PayLife")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)

	case AbilityCost_Discard: member(b, first, "type"); json.write_string(b, "Discard")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter)
	member(b, first, "random"); encode_with_card_selection_bool_compat(b, y.selection)
	member(b, first, "self_ref"); encode_with_discard_self_scope_bool_compat(b, y.self_scope)

	case AbilityCost_Exile: member(b, first, "type"); json.write_string(b, "Exile")
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "zone"); enc_opt_Zone(b, y.zone)
	member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter)

	case AbilityCost_ExileMaterials: member(b, first, "type"); json.write_string(b, "ExileMaterials")
	member(b, first, "materials"); encode_TargetFilter(b, y.materials)
	member(b, first, "count"); encode_CostObjectCount(b, y.count)

	case AbilityCost_CollectEvidence: member(b, first, "type"); json.write_string(b, "CollectEvidence")
	member(b, first, "amount"); encode_u32(b, y.amount)

	case AbilityCost_ExileWithAggregate: member(b, first, "type"); json.write_string(b, "ExileWithAggregate")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "function"); encode_AggregateFunction(b, y.function)
	member(b, first, "property"); encode_ObjectProperty(b, y.property)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_i32(b, y.value)
	member(b, first, "zone"); encode_Zone(b, y.zone)

	case AbilityCost_TapCreatures: member(b, first, "type"); json.write_string(b, "TapCreatures")
	member(b, first, "requirement"); encode_TapCreaturesRequirement(b, y.requirement)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)

	case AbilityCost_RemoveCounter: member(b, first, "type"); json.write_string(b, "RemoveCounter")
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "counter_type"); encode_CounterMatch(b, y.counter_type)
	member(b, first, "target"); enc_opt_TargetFilter(b, y.target)
	member(b, first, "selection"); encode_CounterCostSelection(b, y.selection)

	case AbilityCost_PayEnergy: member(b, first, "type"); json.write_string(b, "PayEnergy")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)

	case AbilityCost_PaySpeed: member(b, first, "type"); json.write_string(b, "PaySpeed")
	member(b, first, "amount"); encode_QuantityExpr(b, y.amount)

	case AbilityCost_ReturnToHand: member(b, first, "type"); json.write_string(b, "ReturnToHand")
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter)
	if !(y.from_zone == nil) { member(b, first, "from_zone"); enc_opt_Zone(b, y.from_zone) }

	case AbilityCost_Unattach: _ = y; member(b, first, "type"); json.write_string(b, "Unattach")
	case AbilityCost_UnattachFrom: member(b, first, "type"); json.write_string(b, "UnattachFrom")
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "count"); encode_u32(b, y.count)

	case AbilityCost_Mill: member(b, first, "type"); json.write_string(b, "Mill")
	member(b, first, "count"); encode_u32(b, y.count)

	case AbilityCost_Exert: _ = y; member(b, first, "type"); json.write_string(b, "Exert")
	case AbilityCost_Blight: member(b, first, "type"); json.write_string(b, "Blight")
	member(b, first, "count"); encode_u32(b, y.count)

	case AbilityCost_Reveal: member(b, first, "type"); json.write_string(b, "Reveal")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	if !(y.filter == nil) { member(b, first, "filter"); enc_opt_TargetFilter(b, y.filter) }
	if !(y.shared_quality == nil) { member(b, first, "shared_quality"); enc_opt_SharedQuality(b, y.shared_quality) }

	case AbilityCost_Behold: member(b, first, "type"); json.write_string(b, "Behold")
	member(b, first, "count"); encode_u32(b, y.count)
	member(b, first, "filter"); encode_TargetFilter(b, y.filter)
	member(b, first, "action"); encode_BeholdCostAction(b, y.action)
	if !(y.type_choice == nil) { member(b, first, "type_choice"); enc_opt_ChoiceType(b, y.type_choice) }

	case AbilityCost_Composite: member(b, first, "type"); json.write_string(b, "Composite")
	member(b, first, "costs"); enc_dyn_AbilityCost(b, y.costs)

	case AbilityCost_OneOf: member(b, first, "type"); json.write_string(b, "OneOf")
	member(b, first, "costs"); enc_dyn_AbilityCost(b, y.costs)

	case AbilityCost_Waterbend: member(b, first, "type"); json.write_string(b, "Waterbend")
	member(b, first, "cost"); encode_ManaCost(b, y.cost)

	case AbilityCost_NinjutsuFamily: member(b, first, "type"); json.write_string(b, "NinjutsuFamily")
	member(b, first, "variant"); encode_NinjutsuVariant(b, y.variant)
	member(b, first, "mana_cost"); encode_ManaCost(b, y.mana_cost)

	case AbilityCost_EffectCost: member(b, first, "type"); json.write_string(b, "EffectCost")
	member(b, first, "effect"); enc_ptr_Effect(b, y.effect)

	case AbilityCost_PerCounter: member(b, first, "type"); json.write_string(b, "PerCounter")
	member(b, first, "counter"); encode_CounterType(b, y.counter)
	member(b, first, "target"); encode_TargetFilter(b, y.target)
	member(b, first, "base"); enc_ptr_AbilityCost(b, y.base)

	case AbilityCost_KeywordCostOfCastSpell: member(b, first, "type"); json.write_string(b, "KeywordCostOfCastSpell")
	member(b, first, "keyword"); encode_KeywordKind(b, y.keyword)

	case AbilityCost_GetPlayerCounters: member(b, first, "type"); json.write_string(b, "GetPlayerCounters")
	member(b, first, "counter_kind"); encode_PlayerCounterKind(b, y.counter_kind)
	member(b, first, "count"); encode_u32(b, y.count)

	case AbilityCost_Unimplemented: member(b, first, "type"); json.write_string(b, "Unimplemented")
	member(b, first, "description"); encode_string(b, y.description)

	}
}

decode_CastCostMode :: proc(v: json.Value, out: ^CastCostMode) -> bool {
	when COVERAGE do cov_hit("CastCostMode")
	if v.kind != .String do return fail("CastCostMode: not a string")
	str := v.text
	switch str {
	case "Alternative": when COVERAGE do cov_hit("CastCostMode::Alternative"); out^ = .Alternative
	case "Additional": when COVERAGE do cov_hit("CastCostMode::Additional"); out^ = .Additional
	case: return fail("CastCostMode: unknown variant")
	}
	return true
}

encode_CastCostMode :: proc(b: ^strings.Builder, x: CastCostMode) {
	@(static, rodata) NAMES := [CastCostMode]string{
		.Alternative = "Alternative",
		.Additional = "Additional",
	}
	json.write_string(b, NAMES[x])
}

decode_QuantityExpr :: proc(v: json.Value, out: ^QuantityExpr) -> bool {
	when COVERAGE do cov_hit("QuantityExpr")
	if v.kind != .Object do return fail("QuantityExpr: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("QuantityExpr: no tag")
	switch tv.text {
	case "Ref": when COVERAGE do cov_hit("QuantityExpr::Ref");
		tmp: QuantityExpr_Ref
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Ref) -> bool {
	if fv, found := get_any(v, "qty"); found { if !decode_QuantityRef(fv, &out.qty) do return fail("QuantityExpr::Ref.qty") } else { return fail("QuantityExpr::Ref.qty missing") }
	return true
		}) { return fail("QuantityExpr::Ref") }
		out^ = tmp
	case "Fixed": when COVERAGE do cov_hit("QuantityExpr::Fixed");
		tmp: QuantityExpr_Fixed
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Fixed) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_i32(fv, &out.value) do return fail("QuantityExpr::Fixed.value") } else { return fail("QuantityExpr::Fixed.value missing") }
	return true
		}) { return fail("QuantityExpr::Fixed") }
		out^ = tmp
	case "DivideRounded": when COVERAGE do cov_hit("QuantityExpr::DivideRounded");
		tmp: QuantityExpr_DivideRounded
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_DivideRounded) -> bool {
	if fv, found := get_any(v, "inner"); found { if !dec_ptr_QuantityExpr(fv, &out.inner) do return fail("QuantityExpr::DivideRounded.inner") } else { return fail("QuantityExpr::DivideRounded.inner missing") }
	if fv, found := get_any(v, "divisor"); found { if !decode_u32(fv, &out.divisor) do return fail("QuantityExpr::DivideRounded.divisor") } else { return fail("QuantityExpr::DivideRounded.divisor missing") }
	if fv, found := get_any(v, "rounding"); found { if !decode_RoundingMode(fv, &out.rounding) do return fail("QuantityExpr::DivideRounded.rounding") } else { return fail("QuantityExpr::DivideRounded.rounding missing") }
	return true
		}) { return fail("QuantityExpr::DivideRounded") }
		out^ = tmp
	case "Offset": when COVERAGE do cov_hit("QuantityExpr::Offset");
		tmp: QuantityExpr_Offset
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Offset) -> bool {
	if fv, found := get_any(v, "inner"); found { if !dec_ptr_QuantityExpr(fv, &out.inner) do return fail("QuantityExpr::Offset.inner") } else { return fail("QuantityExpr::Offset.inner missing") }
	if fv, found := get_any(v, "offset"); found { if !decode_i32(fv, &out.offset) do return fail("QuantityExpr::Offset.offset") } else { return fail("QuantityExpr::Offset.offset missing") }
	return true
		}) { return fail("QuantityExpr::Offset") }
		out^ = tmp
	case "ClampMin": when COVERAGE do cov_hit("QuantityExpr::ClampMin");
		tmp: QuantityExpr_ClampMin
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_ClampMin) -> bool {
	if fv, found := get_any(v, "inner"); found { if !dec_ptr_QuantityExpr(fv, &out.inner) do return fail("QuantityExpr::ClampMin.inner") } else { return fail("QuantityExpr::ClampMin.inner missing") }
	if fv, found := get_any(v, "minimum"); found { if !decode_i32(fv, &out.minimum) do return fail("QuantityExpr::ClampMin.minimum") } else { return fail("QuantityExpr::ClampMin.minimum missing") }
	return true
		}) { return fail("QuantityExpr::ClampMin") }
		out^ = tmp
	case "Multiply": when COVERAGE do cov_hit("QuantityExpr::Multiply");
		tmp: QuantityExpr_Multiply
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Multiply) -> bool {
	if fv, found := get_any(v, "factor"); found { if !decode_i32(fv, &out.factor) do return fail("QuantityExpr::Multiply.factor") } else { return fail("QuantityExpr::Multiply.factor missing") }
	if fv, found := get_any(v, "inner"); found { if !dec_ptr_QuantityExpr(fv, &out.inner) do return fail("QuantityExpr::Multiply.inner") } else { return fail("QuantityExpr::Multiply.inner missing") }
	return true
		}) { return fail("QuantityExpr::Multiply") }
		out^ = tmp
	case "Sum": when COVERAGE do cov_hit("QuantityExpr::Sum");
		tmp: QuantityExpr_Sum
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Sum) -> bool {
	if fv, found := get_any(v, "exprs"); found { if !dec_dyn_QuantityExpr(fv, &out.exprs) do return fail("QuantityExpr::Sum.exprs") } else { return fail("QuantityExpr::Sum.exprs missing") }
	return true
		}) { return fail("QuantityExpr::Sum") }
		out^ = tmp
	case "UpTo": when COVERAGE do cov_hit("QuantityExpr::UpTo");
		tmp: QuantityExpr_UpTo
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_UpTo) -> bool {
	if fv, found := get_any(v, "max"); found { if !dec_ptr_QuantityExpr(fv, &out.max) do return fail("QuantityExpr::UpTo.max") } else { return fail("QuantityExpr::UpTo.max missing") }
	return true
		}) { return fail("QuantityExpr::UpTo") }
		out^ = tmp
	case "Power": when COVERAGE do cov_hit("QuantityExpr::Power");
		tmp: QuantityExpr_Power
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Power) -> bool {
	if fv, found := get_any(v, "base"); found { if !decode_i32(fv, &out.base) do return fail("QuantityExpr::Power.base") } else { return fail("QuantityExpr::Power.base missing") }
	if fv, found := get_any(v, "exponent"); found { if !dec_ptr_QuantityExpr(fv, &out.exponent) do return fail("QuantityExpr::Power.exponent") } else { return fail("QuantityExpr::Power.exponent missing") }
	return true
		}) { return fail("QuantityExpr::Power") }
		out^ = tmp
	case "Difference": when COVERAGE do cov_hit("QuantityExpr::Difference");
		tmp: QuantityExpr_Difference
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Difference) -> bool {
	if fv, found := get_any(v, "left"); found { if !dec_ptr_QuantityExpr(fv, &out.left) do return fail("QuantityExpr::Difference.left") } else { return fail("QuantityExpr::Difference.left missing") }
	if fv, found := get_any(v, "right"); found { if !dec_ptr_QuantityExpr(fv, &out.right) do return fail("QuantityExpr::Difference.right") } else { return fail("QuantityExpr::Difference.right missing") }
	return true
		}) { return fail("QuantityExpr::Difference") }
		out^ = tmp
	case "Max": when COVERAGE do cov_hit("QuantityExpr::Max");
		tmp: QuantityExpr_Max
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^QuantityExpr_Max) -> bool {
	if fv, found := get_any(v, "exprs"); found { if !dec_dyn_QuantityExpr(fv, &out.exprs) do return fail("QuantityExpr::Max.exprs") } else { return fail("QuantityExpr::Max.exprs missing") }
	return true
		}) { return fail("QuantityExpr::Max") }
		out^ = tmp
	case: return fail("QuantityExpr: unknown variant")
	}
	return true
}

encode_QuantityExpr :: proc(b: ^strings.Builder, x: QuantityExpr) {
	#partial switch y in x {
	case QuantityExpr_Ref: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Ref")
	member(b, first, "qty"); encode_QuantityRef(b, y.qty)
	}; strings.write_byte(b, '}')
	case QuantityExpr_Fixed: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Fixed")
	member(b, first, "value"); encode_i32(b, y.value)
	}; strings.write_byte(b, '}')
	case QuantityExpr_DivideRounded: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "DivideRounded")
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)
	member(b, first, "divisor"); encode_u32(b, y.divisor)
	member(b, first, "rounding"); encode_RoundingMode(b, y.rounding)
	}; strings.write_byte(b, '}')
	case QuantityExpr_Offset: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Offset")
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)
	member(b, first, "offset"); encode_i32(b, y.offset)
	}; strings.write_byte(b, '}')
	case QuantityExpr_ClampMin: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ClampMin")
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)
	member(b, first, "minimum"); encode_i32(b, y.minimum)
	}; strings.write_byte(b, '}')
	case QuantityExpr_Multiply: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Multiply")
	member(b, first, "factor"); encode_i32(b, y.factor)
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)
	}; strings.write_byte(b, '}')
	case QuantityExpr_Sum: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Sum")
	member(b, first, "exprs"); enc_dyn_QuantityExpr(b, y.exprs)
	}; strings.write_byte(b, '}')
	case QuantityExpr_UpTo: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "UpTo")
	member(b, first, "max"); enc_ptr_QuantityExpr(b, y.max)
	}; strings.write_byte(b, '}')
	case QuantityExpr_Power: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Power")
	member(b, first, "base"); encode_i32(b, y.base)
	member(b, first, "exponent"); enc_ptr_QuantityExpr(b, y.exponent)
	}; strings.write_byte(b, '}')
	case QuantityExpr_Difference: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Difference")
	member(b, first, "left"); enc_ptr_QuantityExpr(b, y.left)
	member(b, first, "right"); enc_ptr_QuantityExpr(b, y.right)
	}; strings.write_byte(b, '}')
	case QuantityExpr_Max: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Max")
	member(b, first, "exprs"); enc_dyn_QuantityExpr(b, y.exprs)
	}; strings.write_byte(b, '}')
	}
}

encode_QuantityExpr_members :: proc(b: ^strings.Builder, x: QuantityExpr, first: ^bool) {
	#partial switch y in x {
	case QuantityExpr_Ref: member(b, first, "type"); json.write_string(b, "Ref")
	member(b, first, "qty"); encode_QuantityRef(b, y.qty)

	case QuantityExpr_Fixed: member(b, first, "type"); json.write_string(b, "Fixed")
	member(b, first, "value"); encode_i32(b, y.value)

	case QuantityExpr_DivideRounded: member(b, first, "type"); json.write_string(b, "DivideRounded")
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)
	member(b, first, "divisor"); encode_u32(b, y.divisor)
	member(b, first, "rounding"); encode_RoundingMode(b, y.rounding)

	case QuantityExpr_Offset: member(b, first, "type"); json.write_string(b, "Offset")
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)
	member(b, first, "offset"); encode_i32(b, y.offset)

	case QuantityExpr_ClampMin: member(b, first, "type"); json.write_string(b, "ClampMin")
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)
	member(b, first, "minimum"); encode_i32(b, y.minimum)

	case QuantityExpr_Multiply: member(b, first, "type"); json.write_string(b, "Multiply")
	member(b, first, "factor"); encode_i32(b, y.factor)
	member(b, first, "inner"); enc_ptr_QuantityExpr(b, y.inner)

	case QuantityExpr_Sum: member(b, first, "type"); json.write_string(b, "Sum")
	member(b, first, "exprs"); enc_dyn_QuantityExpr(b, y.exprs)

	case QuantityExpr_UpTo: member(b, first, "type"); json.write_string(b, "UpTo")
	member(b, first, "max"); enc_ptr_QuantityExpr(b, y.max)

	case QuantityExpr_Power: member(b, first, "type"); json.write_string(b, "Power")
	member(b, first, "base"); encode_i32(b, y.base)
	member(b, first, "exponent"); enc_ptr_QuantityExpr(b, y.exponent)

	case QuantityExpr_Difference: member(b, first, "type"); json.write_string(b, "Difference")
	member(b, first, "left"); enc_ptr_QuantityExpr(b, y.left)
	member(b, first, "right"); enc_ptr_QuantityExpr(b, y.right)

	case QuantityExpr_Max: member(b, first, "type"); json.write_string(b, "Max")
