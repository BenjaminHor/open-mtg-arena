	}; strings.write_byte(b, '}')
	case Effect_ChooseDrawnThisTurnPayOrTopdeck: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ChooseDrawnThisTurnPayOrTopdeck")
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
