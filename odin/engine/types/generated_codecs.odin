decode_SpentColor :: proc(v: json.Value, out: ^SpentColor) -> bool {
	if v.kind != .Object do return fail("SpentColor: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("SpentColor: no tag")
	switch tv.text {
	case "ColorWord":
		tmp: SpentColor_ColorWord
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^SpentColor_ColorWord) -> bool {
	if fv, found := get_any(v, "color"); found { if !decode_ManaColor(fv, &out.color) do return fail("SpentColor::ColorWord.color") } else { return fail("SpentColor::ColorWord.color missing") }
	return true
		}) { return fail("SpentColor::ColorWord") }
		out^ = tmp
	case "ManaSymbol":
		tmp: SpentColor_ManaSymbol
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^SpentColor_ManaSymbol) -> bool {
	if fv, found := get_any(v, "color"); found { if !decode_ManaColor(fv, &out.color) do return fail("SpentColor::ManaSymbol.color") } else { return fail("SpentColor::ManaSymbol.color missing") }
	return true
		}) { return fail("SpentColor::ManaSymbol") }
		out^ = tmp
	case: return fail("SpentColor: unknown variant")
	}
	return true
}

encode_SpentColor :: proc(b: ^strings.Builder, x: SpentColor) {
	#partial switch y in x {
	case SpentColor_ColorWord: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ColorWord")
	member(b, first, "color"); encode_ManaColor(b, y.color)
	}; strings.write_byte(b, '}')
	case SpentColor_ManaSymbol: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ManaSymbol")
	member(b, first, "color"); encode_ManaColor(b, y.color)
	}; strings.write_byte(b, '}')
	}
}

encode_SpentColor_members :: proc(b: ^strings.Builder, x: SpentColor, first: ^bool) {
	#partial switch y in x {
	case SpentColor_ColorWord: member(b, first, "type"); json.write_string(b, "ColorWord")
	member(b, first, "color"); encode_ManaColor(b, y.color)

	case SpentColor_ManaSymbol: member(b, first, "type"); json.write_string(b, "ManaSymbol")
	member(b, first, "color"); encode_ManaColor(b, y.color)

	}
}

