decode_DistributionUnit :: proc(v: json.Value, out: ^DistributionUnit) -> bool {
	when COVERAGE do cov_hit("DistributionUnit")
	if v.kind != .Object do return fail("DistributionUnit: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("DistributionUnit: no tag")
	switch tv.text {
	case "Damage": when COVERAGE do cov_hit("DistributionUnit::Damage"); out^ = DistributionUnit_Damage{}
	case "EvenSplitDamage": when COVERAGE do cov_hit("DistributionUnit::EvenSplitDamage"); out^ = DistributionUnit_EvenSplitDamage{}
	case "Counters": when COVERAGE do cov_hit("DistributionUnit::Counters"); tmp: DistributionUnit_Counters; if !decode_string(json.get_or_null(v, "data"), &tmp._0) do return fail("DistributionUnit::Counters"); out^ = tmp
	case "Life": when COVERAGE do cov_hit("DistributionUnit::Life"); out^ = DistributionUnit_Life{}
	case: return fail("DistributionUnit: unknown variant")
	}
	return true
}

encode_DistributionUnit :: proc(b: ^strings.Builder, x: DistributionUnit) {
	#partial switch y in x {
	case DistributionUnit_Damage: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Damage"); strings.write_byte(b, '}')
	case DistributionUnit_EvenSplitDamage: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EvenSplitDamage"); strings.write_byte(b, '}')
	case DistributionUnit_Counters: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Counters"); member(b, &f, "data"); encode_string(b, y._0); strings.write_byte(b, '}')
	case DistributionUnit_Life: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Life"); strings.write_byte(b, '}')
	}
}

decode_DistributionScope :: proc(v: json.Value, out: ^DistributionScope) -> bool {
	when COVERAGE do cov_hit("DistributionScope")
	if v.kind != .Object do return fail("DistributionScope: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("DistributionScope: no tag")
	switch tv.text {
	case "AnnouncedTargets": when COVERAGE do cov_hit("DistributionScope::AnnouncedTargets"); out^ = DistributionScope_AnnouncedTargets{}
	case "ResolutionCandidates": when COVERAGE do cov_hit("DistributionScope::ResolutionCandidates");
		tmp: DistributionScope_ResolutionCandidates
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^DistributionScope_ResolutionCandidates) -> bool {
	if fv, found := get_any(v, "pending_effect"); found { if !dec_ptr_ResolvedAbility(fv, &out.pending_effect) do return fail("DistributionScope::ResolutionCandidates.pending_effect") } else { return fail("DistributionScope::ResolutionCandidates.pending_effect missing") }
	return true
		}) { return fail("DistributionScope::ResolutionCandidates") }
		out^ = tmp
	case: return fail("DistributionScope: unknown variant")
	}
	return true
}

encode_DistributionScope :: proc(b: ^strings.Builder, x: DistributionScope) {
	#partial switch y in x {
	case DistributionScope_AnnouncedTargets: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AnnouncedTargets"); strings.write_byte(b, '}')
	case DistributionScope_ResolutionCandidates: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ResolutionCandidates"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "pending_effect"); enc_ptr_ResolvedAbility(b, y.pending_effect)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_PayableResource :: proc(v: json.Value, out: ^PayableResource) -> bool {
	when COVERAGE do cov_hit("PayableResource")
	if v.kind != .Object do return fail("PayableResource: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("PayableResource: no tag")
	switch tv.text {
	case "Energy": when COVERAGE do cov_hit("PayableResource::Energy"); out^ = PayableResource_Energy{}
	case "ManaGeneric": when COVERAGE do cov_hit("PayableResource::ManaGeneric");
		tmp: PayableResource_Mana
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^PayableResource_Mana) -> bool {
	if fv, found := get_any(v, "base_cost"); found { if !decode_ManaCost(fv, &out.base_cost) do return fail("PayableResource::Mana.base_cost") } else { return fail("PayableResource::Mana.base_cost missing") }
	if fv, found := get_any(v, "composition"); found { if !decode_ManaAmountComposition(fv, &out.composition) do return fail("PayableResource::Mana.composition") }
	return true
		}) { return fail("PayableResource::Mana") }
		out^ = tmp
	case "Counters": when COVERAGE do cov_hit("PayableResource::Counters"); out^ = PayableResource_Counters{}
	case "Life": when COVERAGE do cov_hit("PayableResource::Life"); out^ = PayableResource_Life{}
	case "Speed": when COVERAGE do cov_hit("PayableResource::Speed"); out^ = PayableResource_Speed{}
	case "LoopCollapse": when COVERAGE do cov_hit("PayableResource::LoopCollapse");
		tmp: PayableResource_LoopCollapse
		if !decode_variant(json.get_or_null(v, "data"), &tmp, proc(v: json.Value, out: ^PayableResource_LoopCollapse) -> bool {
	if fv, found := get_any(v, "axis"); found { if !decode_LoopCollapseAxis(fv, &out.axis) do return fail("PayableResource::LoopCollapse.axis") } else { return fail("PayableResource::LoopCollapse.axis missing") }
	return true
		}) { return fail("PayableResource::LoopCollapse") }
		out^ = tmp
	case: return fail("PayableResource: unknown variant")
	}
	return true
}

encode_PayableResource :: proc(b: ^strings.Builder, x: PayableResource) {
	#partial switch y in x {
	case PayableResource_Energy: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Energy"); strings.write_byte(b, '}')
	case PayableResource_Mana: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ManaGeneric"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "base_cost"); encode_ManaCost(b, y.base_cost)
	member(b, first, "composition"); encode_ManaAmountComposition(b, y.composition)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case PayableResource_Counters: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Counters"); strings.write_byte(b, '}')
	case PayableResource_Life: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Life"); strings.write_byte(b, '}')
	case PayableResource_Speed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Speed"); strings.write_byte(b, '}')
	case PayableResource_LoopCollapse: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "LoopCollapse"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "axis"); encode_LoopCollapseAxis(b, y.axis)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_RetargetScope :: proc(v: json.Value, out: ^RetargetScope) -> bool {
	when COVERAGE do cov_hit("RetargetScope")
	if v.kind != .Object do return fail("RetargetScope: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("RetargetScope: no tag")
	switch tv.text {
	case "Single": when COVERAGE do cov_hit("RetargetScope::Single"); out^ = RetargetScope_Single{}
	case "All": when COVERAGE do cov_hit("RetargetScope::All"); out^ = RetargetScope_All{}
	case "ForcedTo": when COVERAGE do cov_hit("RetargetScope::ForcedTo"); tmp: RetargetScope_ForcedTo; if !decode_TargetRef(json.get_or_null(v, "data"), &tmp._0) do return fail("RetargetScope::ForcedTo"); out^ = tmp
	case: return fail("RetargetScope: unknown variant")
	}
	return true
}

encode_RetargetScope :: proc(b: ^strings.Builder, x: RetargetScope) {
	#partial switch y in x {
	case RetargetScope_Single: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Single"); strings.write_byte(b, '}')
	case RetargetScope_All: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "All"); strings.write_byte(b, '}')
	case RetargetScope_ForcedTo: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ForcedTo"); member(b, &f, "data"); encode_TargetRef(b, y._0); strings.write_byte(b, '}')
	}
}

