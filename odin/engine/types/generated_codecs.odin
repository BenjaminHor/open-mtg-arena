decode_TargetSchedule :: proc(v: json.Value, out: ^TargetSchedule) -> bool {
	when COVERAGE do cov_hit("TargetSchedule")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("TargetSchedule: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("TargetSchedule: not a string or object")
	}
	switch variant {
	case "Constant": when COVERAGE do cov_hit("TargetSchedule::Constant"); tmp: TargetSchedule_Constant; if !decode_Ranking(body, &tmp._0) do return fail("TargetSchedule::Constant"); out^ = tmp
	case "RoundRobin": when COVERAGE do cov_hit("TargetSchedule::RoundRobin"); tmp: TargetSchedule_RoundRobin; if !dec_dyn_Ranking(body, &tmp._0) do return fail("TargetSchedule::RoundRobin"); out^ = tmp
	case "Piecewise": when COVERAGE do cov_hit("TargetSchedule::Piecewise"); tmp: TargetSchedule_Piecewise; if !dec_dyn_t2_u32_Ranking(body, &tmp._0) do return fail("TargetSchedule::Piecewise"); out^ = tmp
	case: return fail("TargetSchedule: unknown variant")
	}
	return true
}

encode_TargetSchedule :: proc(b: ^strings.Builder, x: TargetSchedule) {
	#partial switch y in x {
	case TargetSchedule_Constant: strings.write_byte(b, '{'); json.write_string(b, "Constant"); strings.write_byte(b, ':'); encode_Ranking(b, y._0); strings.write_byte(b, '}')
	case TargetSchedule_RoundRobin: strings.write_byte(b, '{'); json.write_string(b, "RoundRobin"); strings.write_byte(b, ':'); enc_dyn_Ranking(b, y._0); strings.write_byte(b, '}')
	case TargetSchedule_Piecewise: strings.write_byte(b, '{'); json.write_string(b, "Piecewise"); strings.write_byte(b, ':'); enc_dyn_t2_u32_Ranking(b, y._0); strings.write_byte(b, '}')
	}
}

