	case "ClaimPrize": out^ = TriggerMode_ClaimPrize{}
	case "CollectEvidence": out^ = TriggerMode_CollectEvidence{}
	case "CommitCrime": out^ = TriggerMode_CommitCrime{}
	case "CrankContraption": out^ = TriggerMode_CrankContraption{}
	case "Devoured": out^ = TriggerMode_Devoured{}
	case "Discover": out^ = TriggerMode_Discover{}
	case "Forage": out^ = TriggerMode_Forage{}
	case "FullyUnlock": out^ = TriggerMode_FullyUnlock{}
	case "GiveGift": out^ = TriggerMode_GiveGift{}
	case "ManifestDread": out^ = TriggerMode_ManifestDread{}
	case "Mentored": out^ = TriggerMode_Mentored{}
