decode_TriggerOrderGroup :: proc(v: json.Value, out: ^TriggerOrderGroup) -> bool {
	when COVERAGE do cov_hit("TriggerOrderGroup")
	if v.kind != .Object do return fail("TriggerOrderGroup: not an object")
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("TriggerOrderGroup.controller") } else { return fail("TriggerOrderGroup.controller missing") }
	if fv, found := get_any(v, "triggers"); found { if !dec_dyn_PendingTriggerContext(fv, &out.triggers) do return fail("TriggerOrderGroup.triggers") } else { return fail("TriggerOrderGroup.triggers missing") }
	if fv, found := get_any(v, "ordered"); found { if !decode_bool(fv, &out.ordered) do return fail("TriggerOrderGroup.ordered") } else { return fail("TriggerOrderGroup.ordered missing") }
	return true
}

encode_TriggerOrderGroup :: proc(b: ^strings.Builder, x: TriggerOrderGroup) {
	strings.write_byte(b, '{')
	f := true
	encode_TriggerOrderGroup_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_TriggerOrderGroup_members :: proc(b: ^strings.Builder, x: TriggerOrderGroup, first: ^bool) {
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	member(b, first, "triggers"); enc_dyn_PendingTriggerContext(b, x.triggers)
	member(b, first, "ordered"); encode_bool(b, x.ordered)
}

