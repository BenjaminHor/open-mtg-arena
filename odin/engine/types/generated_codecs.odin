	member(b, first, "props"); enc_dyn_FilterProp(b, y.props)
	}; strings.write_byte(b, '}')
	case FilterProp_Not: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Not")
