encode_ActiveSearchDecisionAuthority :: proc(b: ^strings.Builder, x: ActiveSearchDecisionAuthority) {
	#partial switch y in x {
	case ActiveSearchDecisionAuthority_LatchedController: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "latched_controller")
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	}; strings.write_byte(b, '}')
	case ActiveSearchDecisionAuthority_SearcherFallback: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "searcher_fallback"); strings.write_byte(b, '}')
	}
}

encode_ActiveSearchDecisionAuthority_members :: proc(b: ^strings.Builder, x: ActiveSearchDecisionAuthority, first: ^bool) {
	#partial switch y in x {
	case ActiveSearchDecisionAuthority_LatchedController: member(b, first, "type"); json.write_string(b, "latched_controller")
	member(b, first, "controller"); encode_PlayerId(b, y.controller)

	case ActiveSearchDecisionAuthority_SearcherFallback: _ = y; member(b, first, "type"); json.write_string(b, "searcher_fallback")
	}
}

decode_ResolvedRulesCommand :: proc(v: json.Value, out: ^ResolvedRulesCommand) -> bool {
	when COVERAGE do cov_hit("ResolvedRulesCommand")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ResolvedRulesCommand: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ResolvedRulesCommand: not a string or object")
	}
	switch variant {
	case "ManaInsert": when COVERAGE do cov_hit("ResolvedRulesCommand::ManaInsert"); tmp: ResolvedRulesCommand_ManaInsert; if !decode_ResolvedManaInsertCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::ManaInsert"); out^ = tmp
	case "ManaSpend": when COVERAGE do cov_hit("ResolvedRulesCommand::ManaSpend"); tmp: ResolvedRulesCommand_ManaSpend; if !decode_ResolvedManaSpendCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::ManaSpend"); out^ = tmp
	case "PlayerEdit": when COVERAGE do cov_hit("ResolvedRulesCommand::PlayerEdit"); tmp: ResolvedRulesCommand_PlayerEdit; if !decode_ResolvedPlayerEditCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::PlayerEdit"); out^ = tmp
	case "ObjectStatus": when COVERAGE do cov_hit("ResolvedRulesCommand::ObjectStatus"); tmp: ResolvedRulesCommand_ObjectStatus; if !decode_ResolvedObjectStatusCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::ObjectStatus"); out^ = tmp
	case "ObjectCounter": when COVERAGE do cov_hit("ResolvedRulesCommand::ObjectCounter"); tmp: ResolvedRulesCommand_ObjectCounter; if !decode_ResolvedObjectCounterCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::ObjectCounter"); out^ = tmp
	case "ObjectTransform": when COVERAGE do cov_hit("ResolvedRulesCommand::ObjectTransform"); tmp: ResolvedRulesCommand_ObjectTransform; if !decode_ResolvedObjectTransformCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::ObjectTransform"); out^ = tmp
	case "Attachment": when COVERAGE do cov_hit("ResolvedRulesCommand::Attachment"); tmp: ResolvedRulesCommand_Attachment; if !decode_ResolvedAttachmentCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::Attachment"); out^ = tmp
	case "DelayedTriggerInstall": when COVERAGE do cov_hit("ResolvedRulesCommand::DelayedTriggerInstall"); tmp: ResolvedRulesCommand_DelayedTriggerInstall; if !dec_ptr_ResolvedDelayedTriggerCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::DelayedTriggerInstall"); out^ = tmp
	case "ContinuousEffect", "ContinuousEffectInstall": when COVERAGE do cov_hit("ResolvedRulesCommand::ContinuousEffect"); tmp: ResolvedRulesCommand_ContinuousEffect; if !dec_ptr_ResolvedContinuousEffectEdit(body, &tmp._0) do return fail("ResolvedRulesCommand::ContinuousEffect"); out^ = tmp
	case "CombatMembership": when COVERAGE do cov_hit("ResolvedRulesCommand::CombatMembership"); tmp: ResolvedRulesCommand_CombatMembership; if !decode_ResolvedCombatMembershipCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::CombatMembership"); out^ = tmp
	case "ControllerOverride": when COVERAGE do cov_hit("ResolvedRulesCommand::ControllerOverride"); tmp: ResolvedRulesCommand_ControllerOverride; if !decode_ResolvedControllerOverrideCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::ControllerOverride"); out^ = tmp
	case "EntryProvenance": when COVERAGE do cov_hit("ResolvedRulesCommand::EntryProvenance"); tmp: ResolvedRulesCommand_EntryProvenance; if !decode_ResolvedEntryProvenanceCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::EntryProvenance"); out^ = tmp
	case "ObjectCease": when COVERAGE do cov_hit("ResolvedRulesCommand::ObjectCease"); tmp: ResolvedRulesCommand_ObjectCease; if !decode_ResolvedObjectCeaseCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::ObjectCease"); out^ = tmp
	case "PlayerLeave": when COVERAGE do cov_hit("ResolvedRulesCommand::PlayerLeave"); tmp: ResolvedRulesCommand_PlayerLeave; if !decode_ResolvedPlayerLeaveCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::PlayerLeave"); out^ = tmp
	case "TokenCreation": when COVERAGE do cov_hit("ResolvedRulesCommand::TokenCreation"); tmp: ResolvedRulesCommand_TokenCreation; if !dec_ptr_ResolvedTokenCreationCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::TokenCreation"); out^ = tmp
	case "Information": when COVERAGE do cov_hit("ResolvedRulesCommand::Information"); tmp: ResolvedRulesCommand_Information; if !decode_ResolvedInformationCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::Information"); out^ = tmp
	case "LedgerEdit": when COVERAGE do cov_hit("ResolvedRulesCommand::LedgerEdit"); tmp: ResolvedRulesCommand_LedgerEdit; if !decode_ResolvedLedgerEditCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::LedgerEdit"); out^ = tmp
	case "LibraryShuffle": when COVERAGE do cov_hit("ResolvedRulesCommand::LibraryShuffle"); tmp: ResolvedRulesCommand_LibraryShuffle; if !decode_ResolvedLibraryShuffleCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::LibraryShuffle"); out^ = tmp
	case "ZoneChange": when COVERAGE do cov_hit("ResolvedRulesCommand::ZoneChange"); tmp: ResolvedRulesCommand_ZoneChange; if !dec_ptr_ResolvedZoneChangeCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::ZoneChange"); out^ = tmp
	case "FrameTransition": when COVERAGE do cov_hit("ResolvedRulesCommand::FrameTransition"); tmp: ResolvedRulesCommand_FrameTransition; if !dec_ptr_ResolvedFrameTransitionCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::FrameTransition"); out^ = tmp
	case "TriggerCollection": when COVERAGE do cov_hit("ResolvedRulesCommand::TriggerCollection"); tmp: ResolvedRulesCommand_TriggerCollection; if !decode_ResolvedTriggerCollectionCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::TriggerCollection"); out^ = tmp
	case "StackPush": when COVERAGE do cov_hit("ResolvedRulesCommand::StackPush"); tmp: ResolvedRulesCommand_StackPush; if !dec_ptr_ResolvedStackPushCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::StackPush"); out^ = tmp
	case "StackEntryFinalize": when COVERAGE do cov_hit("ResolvedRulesCommand::StackEntryFinalize"); tmp: ResolvedRulesCommand_StackEntryFinalize; if !dec_ptr_ResolvedStackEntryFinalizeCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::StackEntryFinalize"); out^ = tmp
	case "UncommittedTriggerRemoval": when COVERAGE do cov_hit("ResolvedRulesCommand::UncommittedTriggerRemoval"); tmp: ResolvedRulesCommand_UncommittedTriggerRemoval; if !dec_ptr_ResolvedUncommittedTriggerRemovalCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::UncommittedTriggerRemoval"); out^ = tmp
	case "StackRemoval": when COVERAGE do cov_hit("ResolvedRulesCommand::StackRemoval"); tmp: ResolvedRulesCommand_StackRemoval; if !dec_ptr_ResolvedStackRemovalCommand(body, &tmp._0) do return fail("ResolvedRulesCommand::StackRemoval"); out^ = tmp
	case: return fail("ResolvedRulesCommand: unknown variant")
	}
	return true
}

encode_ResolvedRulesCommand :: proc(b: ^strings.Builder, x: ResolvedRulesCommand) {
	#partial switch y in x {
	case ResolvedRulesCommand_ManaInsert: strings.write_byte(b, '{'); json.write_string(b, "ManaInsert"); strings.write_byte(b, ':'); encode_ResolvedManaInsertCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_ManaSpend: strings.write_byte(b, '{'); json.write_string(b, "ManaSpend"); strings.write_byte(b, ':'); encode_ResolvedManaSpendCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_PlayerEdit: strings.write_byte(b, '{'); json.write_string(b, "PlayerEdit"); strings.write_byte(b, ':'); encode_ResolvedPlayerEditCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_ObjectStatus: strings.write_byte(b, '{'); json.write_string(b, "ObjectStatus"); strings.write_byte(b, ':'); encode_ResolvedObjectStatusCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_ObjectCounter: strings.write_byte(b, '{'); json.write_string(b, "ObjectCounter"); strings.write_byte(b, ':'); encode_ResolvedObjectCounterCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_ObjectTransform: strings.write_byte(b, '{'); json.write_string(b, "ObjectTransform"); strings.write_byte(b, ':'); encode_ResolvedObjectTransformCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_Attachment: strings.write_byte(b, '{'); json.write_string(b, "Attachment"); strings.write_byte(b, ':'); encode_ResolvedAttachmentCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_DelayedTriggerInstall: strings.write_byte(b, '{'); json.write_string(b, "DelayedTriggerInstall"); strings.write_byte(b, ':'); enc_ptr_ResolvedDelayedTriggerCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_ContinuousEffect: strings.write_byte(b, '{'); json.write_string(b, "ContinuousEffect"); strings.write_byte(b, ':'); enc_ptr_ResolvedContinuousEffectEdit(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_CombatMembership: strings.write_byte(b, '{'); json.write_string(b, "CombatMembership"); strings.write_byte(b, ':'); encode_ResolvedCombatMembershipCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_ControllerOverride: strings.write_byte(b, '{'); json.write_string(b, "ControllerOverride"); strings.write_byte(b, ':'); encode_ResolvedControllerOverrideCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_EntryProvenance: strings.write_byte(b, '{'); json.write_string(b, "EntryProvenance"); strings.write_byte(b, ':'); encode_ResolvedEntryProvenanceCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_ObjectCease: strings.write_byte(b, '{'); json.write_string(b, "ObjectCease"); strings.write_byte(b, ':'); encode_ResolvedObjectCeaseCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_PlayerLeave: strings.write_byte(b, '{'); json.write_string(b, "PlayerLeave"); strings.write_byte(b, ':'); encode_ResolvedPlayerLeaveCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_TokenCreation: strings.write_byte(b, '{'); json.write_string(b, "TokenCreation"); strings.write_byte(b, ':'); enc_ptr_ResolvedTokenCreationCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_Information: strings.write_byte(b, '{'); json.write_string(b, "Information"); strings.write_byte(b, ':'); encode_ResolvedInformationCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_LedgerEdit: strings.write_byte(b, '{'); json.write_string(b, "LedgerEdit"); strings.write_byte(b, ':'); encode_ResolvedLedgerEditCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_LibraryShuffle: strings.write_byte(b, '{'); json.write_string(b, "LibraryShuffle"); strings.write_byte(b, ':'); encode_ResolvedLibraryShuffleCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_ZoneChange: strings.write_byte(b, '{'); json.write_string(b, "ZoneChange"); strings.write_byte(b, ':'); enc_ptr_ResolvedZoneChangeCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_FrameTransition: strings.write_byte(b, '{'); json.write_string(b, "FrameTransition"); strings.write_byte(b, ':'); enc_ptr_ResolvedFrameTransitionCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_TriggerCollection: strings.write_byte(b, '{'); json.write_string(b, "TriggerCollection"); strings.write_byte(b, ':'); encode_ResolvedTriggerCollectionCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_StackPush: strings.write_byte(b, '{'); json.write_string(b, "StackPush"); strings.write_byte(b, ':'); enc_ptr_ResolvedStackPushCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_StackEntryFinalize: strings.write_byte(b, '{'); json.write_string(b, "StackEntryFinalize"); strings.write_byte(b, ':'); enc_ptr_ResolvedStackEntryFinalizeCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_UncommittedTriggerRemoval: strings.write_byte(b, '{'); json.write_string(b, "UncommittedTriggerRemoval"); strings.write_byte(b, ':'); enc_ptr_ResolvedUncommittedTriggerRemovalCommand(b, y._0); strings.write_byte(b, '}')
	case ResolvedRulesCommand_StackRemoval: strings.write_byte(b, '{'); json.write_string(b, "StackRemoval"); strings.write_byte(b, ':'); enc_ptr_ResolvedStackRemovalCommand(b, y._0); strings.write_byte(b, '}')
	}
