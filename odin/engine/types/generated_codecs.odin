	if !(y.source_keyword == nil) { member(b, first, "source_keyword"); enc_opt_KeywordKind(b, y.source_keyword) }
	}; strings.write_byte(b, '}')
	}
}

encode_ExcessRecipient_members :: proc(b: ^strings.Builder, x: ExcessRecipient, first: ^bool) {
