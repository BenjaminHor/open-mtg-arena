	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	member(b, first, "roller"); encode_PlayerId(b, x.roller)
	if !(x.quantity_controller == nil) { member(b, first, "quantity_controller"); enc_opt_PlayerId(b, x.quantity_controller) }
	if !(x.scoped_player == nil) { member(b, first, "scoped_player"); enc_opt_PlayerId(b, x.scoped_player) }
	member(b, first, "targets"); enc_dyn_TargetRef(b, x.targets)
	member(b, first, "results_table"); enc_dyn_DieResultBranch(b, x.results_table)
	if !(x.modifier == nil) { member(b, first, "modifier"); enc_opt_DieRollModifier(b, x.modifier) }
	if !(x.die_result == nil) { member(b, first, "die_result"); enc_opt_i32(b, x.die_result) }
	if !(x.trigger_context == nil) { member(b, first, "trigger_context"); enc_opt_ResolvingTriggerContext(b, x.trigger_context) }
	member(b, first, "continuation"); encode_DieRollContinuation(b, x.continuation)
	member(b, first, "chain_root_targets"); enc_dyn_TargetRef(b, x.chain_root_targets)
	member(b, first, "illegal_target_slots"); enc_dyn_int(b, x.illegal_target_slots)
	member(b, first, "chain_root_target_pins"); enc_dyn_opt_ObjectIncarnationRef(b, x.chain_root_target_pins)
	if !(x.declared_capture == nil) { member(b, first, "declared_capture"); enc_opt_CapturedDeclarationPayload(b, x.declared_capture) }
	member(b, first, "local_target_pins"); enc_dyn_opt_ObjectIncarnationRef(b, x.local_target_pins)
	member(b, first, "keyed_target_incarnations"); enc_dyn_ObjectIncarnationRef(b, x.keyed_target_incarnations)
	member(b, first, "declared_player"); enc_opt_DeclaredPlayerTarget(b, x.declared_player)
}

decode_MayTriggerAutoChoiceRecord :: proc(v: json.Value, out: ^MayTriggerAutoChoiceRecord) -> bool {
	when COVERAGE do cov_hit("MayTriggerAutoChoiceRecord")
	if v.kind != .Object do return fail("MayTriggerAutoChoiceRecord: not an object")
	if fv, found := get_any(v, "selector", "key"); found { if !decode_MayTriggerAutoChoiceSelector(fv, &out.selector) do return fail("MayTriggerAutoChoiceRecord.selector") } else { return fail("MayTriggerAutoChoiceRecord.selector missing") }
	if fv, found := get_any(v, "choice"); found { if !decode_AutoMayChoice(fv, &out.choice) do return fail("MayTriggerAutoChoiceRecord.choice") } else { return fail("MayTriggerAutoChoiceRecord.choice missing") }
	return true
}

encode_MayTriggerAutoChoiceRecord :: proc(b: ^strings.Builder, x: MayTriggerAutoChoiceRecord) {
	strings.write_byte(b, '{')
	f := true
	encode_MayTriggerAutoChoiceRecord_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_MayTriggerAutoChoiceRecord_members :: proc(b: ^strings.Builder, x: MayTriggerAutoChoiceRecord, first: ^bool) {
	member(b, first, "selector"); encode_MayTriggerAutoChoiceSelector(b, x.selector)
	member(b, first, "choice"); encode_AutoMayChoice(b, x.choice)
}

decode_UnActionState :: proc(v: json.Value, out: ^UnActionState) -> bool {
	when COVERAGE do cov_hit("UnActionState")
	if v.kind != .Object do return fail("UnActionState: not an object")
	if fv, found := get_any(v, "enabled_players"); found { if !dec_dyn_PlayerId(fv, &out.enabled_players) do return fail("UnActionState.enabled_players") }
	if fv, found := get_any(v, "menu"); found { if !dec_dyn_UnTellKind(fv, &out.menu) do return fail("UnActionState.menu") }
	if fv, found := get_any(v, "gotcha_offers"); found { if !dec_dyn_GotchaOffer(fv, &out.gotcha_offers) do return fail("UnActionState.gotcha_offers") }
	if fv, found := get_any(v, "pending_offers"); found { if !dec_dyn_GotchaOffer(fv, &out.pending_offers) do return fail("UnActionState.pending_offers") }
	if fv, found := get_any(v, "touchable"); found { if !dec_dyn_ObjectIncarnationRef(fv, &out.touchable) do return fail("UnActionState.touchable") }
	if fv, found := get_any(v, "next_offer_id"); found { if !decode_u64(fv, &out.next_offer_id) do return fail("UnActionState.next_offer_id") }
	return true
}

encode_UnActionState :: proc(b: ^strings.Builder, x: UnActionState) {
	strings.write_byte(b, '{')
	f := true
	encode_UnActionState_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_UnActionState_members :: proc(b: ^strings.Builder, x: UnActionState, first: ^bool) {
	if !((len(x.enabled_players) == 0)) { member(b, first, "enabled_players"); enc_dyn_PlayerId(b, x.enabled_players) }
	if !((len(x.menu) == 0)) { member(b, first, "menu"); enc_dyn_UnTellKind(b, x.menu) }
	if !((len(x.gotcha_offers) == 0)) { member(b, first, "gotcha_offers"); enc_dyn_GotchaOffer(b, x.gotcha_offers) }
	if !((len(x.pending_offers) == 0)) { member(b, first, "pending_offers"); enc_dyn_GotchaOffer(b, x.pending_offers) }
	if !((len(x.touchable) == 0)) { member(b, first, "touchable"); enc_dyn_ObjectIncarnationRef(b, x.touchable) }
	if !(x.next_offer_id == 0) { member(b, first, "next_offer_id"); encode_u64(b, x.next_offer_id) }
}

