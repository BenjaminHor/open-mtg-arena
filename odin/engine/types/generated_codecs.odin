decode_PlayerScope :: proc(v: json.Value, out: ^PlayerScope) -> bool {
	if v.kind != .Object do return fail("PlayerScope: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("PlayerScope: no tag")
	switch tv.text {
	case "Controller": out^ = PlayerScope_Controller{}
	case "ScopedPlayer": out^ = PlayerScope_ScopedPlayer{}
	case "Target": out^ = PlayerScope_Target{}
	case "Opponent":
		tmp: PlayerScope_Opponent
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerScope_Opponent) -> bool {
	if fv, found := get_any(v, "aggregate"); found { if !decode_AggregateFunction(fv, &out.aggregate) do return fail("PlayerScope::Opponent.aggregate") } else { return fail("PlayerScope::Opponent.aggregate missing") }
	return true
		}) { return fail("PlayerScope::Opponent") }
		out^ = tmp
	case "AllPlayers":
		tmp: PlayerScope_AllPlayers
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerScope_AllPlayers) -> bool {
	if fv, found := get_any(v, "aggregate"); found { if !decode_AggregateFunction(fv, &out.aggregate) do return fail("PlayerScope::AllPlayers.aggregate") } else { return fail("PlayerScope::AllPlayers.aggregate missing") }
	if fv, found := get_any(v, "exclude"); found { if !dec_ptr_PlayerScope(fv, &out.exclude) do return fail("PlayerScope::AllPlayers.exclude") }
	return true
		}) { return fail("PlayerScope::AllPlayers") }
		out^ = tmp
	case "RecipientController": out^ = PlayerScope_RecipientController{}
	case "DefendingPlayer": out^ = PlayerScope_DefendingPlayer{}
	case "ParentObjectTarget", "ParentObjectTargetController":
		tmp: PlayerScope_ParentObjectTarget
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerScope_ParentObjectTarget) -> bool {
	if fv, found := get_any(v, "possession"); found { if !decode_PossessionAxis(fv, &out.possession) do return fail("PlayerScope::ParentObjectTarget.possession") } else { out.possession = default_PlayerScope_default_parent_object_target_possession() }
	return true
		}) { return fail("PlayerScope::ParentObjectTarget") }
		out^ = tmp
	case "SourceChosenPlayer": out^ = PlayerScope_SourceChosenPlayer{}
	case "AnyTurn": out^ = PlayerScope_AnyTurn{}
	case "SpecificPlayer":
		tmp: PlayerScope_SpecificPlayer
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^PlayerScope_SpecificPlayer) -> bool {
	if fv, found := get_any(v, "id"); found { if !decode_PlayerId(fv, &out.id) do return fail("PlayerScope::SpecificPlayer.id") } else { return fail("PlayerScope::SpecificPlayer.id missing") }
	return true
		}) { return fail("PlayerScope::SpecificPlayer") }
		out^ = tmp
	case: return fail("PlayerScope: unknown variant")
	}
	return true
}

encode_PlayerScope :: proc(b: ^strings.Builder, x: PlayerScope) {
	#partial switch y in x {
	case PlayerScope_Controller: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Controller"); strings.write_byte(b, '}')
	case PlayerScope_ScopedPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ScopedPlayer"); strings.write_byte(b, '}')
	case PlayerScope_Target: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Target"); strings.write_byte(b, '}')
	case PlayerScope_Opponent: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Opponent")
	member(b, first, "aggregate"); encode_AggregateFunction(b, y.aggregate)
	}; strings.write_byte(b, '}')
	case PlayerScope_AllPlayers: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AllPlayers")
	member(b, first, "aggregate"); encode_AggregateFunction(b, y.aggregate)
	if !(y.exclude == nil) { member(b, first, "exclude"); enc_ptr_PlayerScope(b, y.exclude) }
	}; strings.write_byte(b, '}')
	case PlayerScope_RecipientController: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RecipientController"); strings.write_byte(b, '}')
	case PlayerScope_DefendingPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DefendingPlayer"); strings.write_byte(b, '}')
	case PlayerScope_ParentObjectTarget: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ParentObjectTarget")
	member(b, first, "possession"); encode_PossessionAxis(b, y.possession)
	}; strings.write_byte(b, '}')
	case PlayerScope_SourceChosenPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceChosenPlayer"); strings.write_byte(b, '}')
	case PlayerScope_AnyTurn: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AnyTurn"); strings.write_byte(b, '}')
	case PlayerScope_SpecificPlayer: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "SpecificPlayer")
	member(b, first, "id"); encode_PlayerId(b, y.id)
	}; strings.write_byte(b, '}')
	}
}

encode_PlayerScope_members :: proc(b: ^strings.Builder, x: PlayerScope, first: ^bool) {
	#partial switch y in x {
	case PlayerScope_Controller: _ = y; member(b, first, "type"); json.write_string(b, "Controller")
	case PlayerScope_ScopedPlayer: _ = y; member(b, first, "type"); json.write_string(b, "ScopedPlayer")
	case PlayerScope_Target: _ = y; member(b, first, "type"); json.write_string(b, "Target")
	case PlayerScope_Opponent: member(b, first, "type"); json.write_string(b, "Opponent")
	member(b, first, "aggregate"); encode_AggregateFunction(b, y.aggregate)

	case PlayerScope_AllPlayers: member(b, first, "type"); json.write_string(b, "AllPlayers")
	member(b, first, "aggregate"); encode_AggregateFunction(b, y.aggregate)
	if !(y.exclude == nil) { member(b, first, "exclude"); enc_ptr_PlayerScope(b, y.exclude) }

	case PlayerScope_RecipientController: _ = y; member(b, first, "type"); json.write_string(b, "RecipientController")
	case PlayerScope_DefendingPlayer: _ = y; member(b, first, "type"); json.write_string(b, "DefendingPlayer")
	case PlayerScope_ParentObjectTarget: member(b, first, "type"); json.write_string(b, "ParentObjectTarget")
	member(b, first, "possession"); encode_PossessionAxis(b, y.possession)

	case PlayerScope_SourceChosenPlayer: _ = y; member(b, first, "type"); json.write_string(b, "SourceChosenPlayer")
	case PlayerScope_AnyTurn: _ = y; member(b, first, "type"); json.write_string(b, "AnyTurn")
	case PlayerScope_SpecificPlayer: member(b, first, "type"); json.write_string(b, "SpecificPlayer")
	member(b, first, "id"); encode_PlayerId(b, y.id)

	}
}

