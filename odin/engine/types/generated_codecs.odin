		out^ = tmp
	case "IsChosenCreatureType": out^ = FilterProp_IsChosenCreatureType{}
	case "MostPrevalentCreatureTypeIn", "MostPrevalentCreatureTypeInLibrary":
		tmp: FilterProp_MostPrevalentCreatureTypeIn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_MostPrevalentCreatureTypeIn) -> bool {
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("FilterProp::MostPrevalentCreatureTypeIn.zone") } else { out.zone = default_FilterProp_default_most_prevalent_zone() }
	if fv, found := get_any(v, "scope"); found { if !decode_ControllerRef(fv, &out.scope) do return fail("FilterProp::MostPrevalentCreatureTypeIn.scope") } else { out.scope = default_FilterProp_default_most_prevalent_scope() }
	return true
		}) { return fail("FilterProp::MostPrevalentCreatureTypeIn") }
		out^ = tmp
	case "IsChosenColor": out^ = FilterProp_IsChosenColor{}
	case "IsChosenCardType": out^ = FilterProp_IsChosenCardType{}
	case "MatchesLastChosenCardPredicate": out^ = FilterProp_MatchesLastChosenCardPredicate{}
	case "HasSingleTarget": out^ = FilterProp_HasSingleTarget{}
	case "Modal": out^ = FilterProp_Modal{}
	case "PrepareSpell": out^ = FilterProp_PrepareSpell{}
	case "NotColor":
		tmp: FilterProp_NotColor
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_NotColor) -> bool {
	if fv, found := get_any(v, "color"); found { if !decode_ManaColor(fv, &out.color) do return fail("FilterProp::NotColor.color") } else { return fail("FilterProp::NotColor.color missing") }
	return true
		}) { return fail("FilterProp::NotColor") }
		out^ = tmp
	case "NotSupertype":
		tmp: FilterProp_NotSupertype
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_NotSupertype) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_Supertype(fv, &out.value) do return fail("FilterProp::NotSupertype.value") } else { return fail("FilterProp::NotSupertype.value missing") }
	return true
		}) { return fail("FilterProp::NotSupertype") }
		out^ = tmp
	case "Suspected": out^ = FilterProp_Suspected{}
	case "Renowned": out^ = FilterProp_Renowned{}
	case "Goaded": out^ = FilterProp_Goaded{}
	case "Prepared": out^ = FilterProp_Prepared{}
	case "ToughnessGTPower": out^ = FilterProp_ToughnessGTPower{}
	case "PowerExceedsBase": out^ = FilterProp_PowerExceedsBase{}
	case "AnyOf":
		tmp: FilterProp_AnyOf
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_AnyOf) -> bool {
	if fv, found := get_any(v, "props"); found { if !dec_dyn_FilterProp(fv, &out.props) do return fail("FilterProp::AnyOf.props") } else { return fail("FilterProp::AnyOf.props missing") }
	return true
		}) { return fail("FilterProp::AnyOf") }
		out^ = tmp
	case "Not":
		tmp: FilterProp_Not
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_Not) -> bool {
	if fv, found := get_any(v, "prop"); found { if !dec_ptr_FilterProp(fv, &out.prop) do return fail("FilterProp::Not.prop") } else { return fail("FilterProp::Not.prop missing") }
	return true
		}) { return fail("FilterProp::Not") }
		out^ = tmp
	case "InTrackedSet":
		tmp: FilterProp_InTrackedSet
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_InTrackedSet) -> bool {
	if fv, found := get_any(v, "id"); found { if !decode_TrackedSetId(fv, &out.id) do return fail("FilterProp::InTrackedSet.id") } else { return fail("FilterProp::InTrackedSet.id missing") }
	return true
		}) { return fail("FilterProp::InTrackedSet") }
		out^ = tmp
	case "Modified": out^ = FilterProp_Modified{}
	case "Historic": out^ = FilterProp_Historic{}
	case "NotHistoric": out^ = FilterProp_NotHistoric{}
	case "DifferentNameFrom":
		tmp: FilterProp_DifferentNameFrom
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_DifferentNameFrom) -> bool {
	if fv, found := get_any(v, "filter"); found { if !dec_ptr_TargetFilter(fv, &out.filter) do return fail("FilterProp::DifferentNameFrom.filter") } else { return fail("FilterProp::DifferentNameFrom.filter missing") }
	return true
		}) { return fail("FilterProp::DifferentNameFrom") }
		out^ = tmp
	case "DistinctFrom":
		tmp: FilterProp_DistinctFrom
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_DistinctFrom) -> bool {
	if fv, found := get_any(v, "reference"); found { if !dec_ptr_TargetFilter(fv, &out.reference) do return fail("FilterProp::DistinctFrom.reference") } else { return fail("FilterProp::DistinctFrom.reference missing") }
	return true
		}) { return fail("FilterProp::DistinctFrom") }
		out^ = tmp
	case "InAnyZone":
		tmp: FilterProp_InAnyZone
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_InAnyZone) -> bool {
	if fv, found := get_any(v, "zones"); found { if !dec_dyn_Zone(fv, &out.zones) do return fail("FilterProp::InAnyZone.zones") } else { return fail("FilterProp::InAnyZone.zones missing") }
	return true
		}) { return fail("FilterProp::InAnyZone") }
		out^ = tmp
	case "SharesQuality":
		tmp: FilterProp_SharesQuality
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_SharesQuality) -> bool {
	if fv, found := get_any(v, "quality"); found { if !decode_SharedQuality(fv, &out.quality) do return fail("FilterProp::SharesQuality.quality") } else { return fail("FilterProp::SharesQuality.quality missing") }
	if fv, found := get_any(v, "reference"); found { if !dec_ptr_TargetFilter(fv, &out.reference) do return fail("FilterProp::SharesQuality.reference") }
	if fv, found := get_any(v, "relation"); found { if !decode_SharedQualityRelation(fv, &out.relation) do return fail("FilterProp::SharesQuality.relation") }
	return true
		}) { return fail("FilterProp::SharesQuality") }
		out^ = tmp
	case "WasDealtDamageThisTurn": out^ = FilterProp_WasDealtDamageThisTurn{}
	case "DealtDamageThisTurn":
		tmp: FilterProp_DealtDamageThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_DealtDamageThisTurn) -> bool {
	if fv, found := get_any(v, "kind"); found { if !decode_DamageKindFilter(fv, &out.kind) do return fail("FilterProp::DealtDamageThisTurn.kind") }
	if fv, found := get_any(v, "recipient"); found { if !dec_opt_PlayerFilter(fv, &out.recipient) do return fail("FilterProp::DealtDamageThisTurn.recipient") }
	return true
		}) { return fail("FilterProp::DealtDamageThisTurn") }
		out^ = tmp
	case "EnteredThisTurn": out^ = FilterProp_EnteredThisTurn{}
	case "ControlledContinuouslySinceTurnBegan": out^ = FilterProp_ControlledContinuouslySinceTurnBegan{}
	case "ZoneChangedThisTurn":
		tmp: FilterProp_ZoneChangedThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_ZoneChangedThisTurn) -> bool {
	if fv, found := get_any(v, "from"); found { if !dec_opt_Zone(fv, &out.from) do return fail("FilterProp::ZoneChangedThisTurn.from") }
	if fv, found := get_any(v, "to"); found { if !dec_opt_Zone(fv, &out.to) do return fail("FilterProp::ZoneChangedThisTurn.to") }
	return true
		}) { return fail("FilterProp::ZoneChangedThisTurn") }
		out^ = tmp
	case "AttackedThisTurn":
		tmp: FilterProp_AttackedThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_AttackedThisTurn) -> bool {
	if fv, found := get_any(v, "defender"); found { if !dec_opt_ControllerRef(fv, &out.defender) do return fail("FilterProp::AttackedThisTurn.defender") }
	return true
		}) { return fail("FilterProp::AttackedThisTurn") }
		out^ = tmp
	case "BlockedThisTurn": out^ = FilterProp_BlockedThisTurn{}
	case "FoughtThisTurn": out^ = FilterProp_FoughtThisTurn{}
	case "AttackedOrBlockedThisTurn": out^ = FilterProp_AttackedOrBlockedThisTurn{}
	case "CountersPutOnThisTurn":
		tmp: FilterProp_CountersPutOnThisTurn
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_CountersPutOnThisTurn) -> bool {
	if fv, found := get_any(v, "actor"); found { if !decode_CountScope(fv, &out.actor) do return fail("FilterProp::CountersPutOnThisTurn.actor") } else { return fail("FilterProp::CountersPutOnThisTurn.actor missing") }
	if fv, found := get_any(v, "counters"); found { if !decode_CounterMatch(fv, &out.counters) do return fail("FilterProp::CountersPutOnThisTurn.counters") } else { return fail("FilterProp::CountersPutOnThisTurn.counters missing") }
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("FilterProp::CountersPutOnThisTurn.comparator") } else { return fail("FilterProp::CountersPutOnThisTurn.comparator missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("FilterProp::CountersPutOnThisTurn.count") } else { return fail("FilterProp::CountersPutOnThisTurn.count missing") }
	return true
		}) { return fail("FilterProp::CountersPutOnThisTurn") }
		out^ = tmp
	case "FaceDown": out^ = FilterProp_FaceDown{}
	case "Transformed": out^ = FilterProp_Transformed{}
	case "TargetsOnly":
		tmp: FilterProp_TargetsOnly
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_TargetsOnly) -> bool {
	if fv, found := get_any(v, "filter"); found { if !dec_ptr_TargetFilter(fv, &out.filter) do return fail("FilterProp::TargetsOnly.filter") } else { return fail("FilterProp::TargetsOnly.filter missing") }
	return true
		}) { return fail("FilterProp::TargetsOnly") }
		out^ = tmp
	case "Targets":
		tmp: FilterProp_Targets
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_Targets) -> bool {
	if fv, found := get_any(v, "filter"); found { if !dec_ptr_TargetFilter(fv, &out.filter) do return fail("FilterProp::Targets.filter") } else { return fail("FilterProp::Targets.filter missing") }
	return true
		}) { return fail("FilterProp::Targets") }
		out^ = tmp
	case "CouldBeTargetedByTriggeringSpell": out^ = FilterProp_CouldBeTargetedByTriggeringSpell{}
	case "HasXInManaCost": out^ = FilterProp_HasXInManaCost{}
	case "HasXInActivationCost": out^ = FilterProp_HasXInActivationCost{}
	case "WasKicked": out^ = FilterProp_WasKicked{}
	case "HasManaAbility": out^ = FilterProp_HasManaAbility{}
	case "HasNoAbilities": out^ = FilterProp_HasNoAbilities{}
	case "Named":
		tmp: FilterProp_Named
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_Named) -> bool {
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("FilterProp::Named.name") } else { return fail("FilterProp::Named.name missing") }
	return true
		}) { return fail("FilterProp::Named") }
		out^ = tmp
	case "SameName": out^ = FilterProp_SameName{}
	case "SameNameAsParentTarget": out^ = FilterProp_SameNameAsParentTarget{}
	case "SameNameAsExiledBySource": out^ = FilterProp_SameNameAsExiledBySource{}
	case "NameMatchesAnyPermanent":
		tmp: FilterProp_NameMatchesAnyPermanent
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_NameMatchesAnyPermanent) -> bool {
	if fv, found := get_any(v, "controller"); found { if !dec_opt_ControllerRef(fv, &out.controller) do return fail("FilterProp::NameMatchesAnyPermanent.controller") }
	return true
		}) { return fail("FilterProp::NameMatchesAnyPermanent") }
		out^ = tmp
	case "IsCommander": out^ = FilterProp_IsCommander{}
	case "SharesCreatureTypeWithCommander": out^ = FilterProp_SharesCreatureTypeWithCommander{}
	case "Other":
		tmp: FilterProp_Other
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^FilterProp_Other) -> bool {
	if fv, found := get_any(v, "value"); found { if !decode_string(fv, &out.value) do return fail("FilterProp::Other.value") } else { return fail("FilterProp::Other.value missing") }
	return true
		}) { return fail("FilterProp::Other") }
		out^ = tmp
	case: return fail("FilterProp: unknown variant")
	}
	return true
}

encode_FilterProp :: proc(b: ^strings.Builder, x: FilterProp) {
	#partial switch y in x {
	case FilterProp_Token: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Token"); strings.write_byte(b, '}')
	case FilterProp_NonToken: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "NonToken"); strings.write_byte(b, '}')
	case FilterProp_RepresentedByCard: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RepresentedByCard"); strings.write_byte(b, '}')
	case FilterProp_ControllerChoseLabel: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControllerChoseLabel")
	member(b, first, "label"); encode_string(b, y.label)
	}; strings.write_byte(b, '}')
	case FilterProp_ControllerMatches: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ControllerMatches")
	member(b, first, "player"); enc_ptr_PlayerFilter(b, y.player)
	}; strings.write_byte(b, '}')
	case FilterProp_WasPlayed: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "WasPlayed"); strings.write_byte(b, '}')
	case FilterProp_CastThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastThisTurn")
	member(b, first, "caster"); encode_ControllerRef(b, y.caster)
	}; strings.write_byte(b, '}')
	case FilterProp_Attacking: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Attacking")
	if !(y.defender == nil) { member(b, first, "defender"); enc_opt_ControllerRef(b, y.defender) }
	}; strings.write_byte(b, '}')
	case FilterProp_Blocking: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Blocking"); strings.write_byte(b, '}')
	case FilterProp_BlockingSource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BlockingSource"); strings.write_byte(b, '}')
	case FilterProp_CombatRelation: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CombatRelation")
	member(b, first, "relation"); encode_CombatRelation(b, y.relation)
	member(b, first, "subject"); encode_CombatRelationSubject(b, y.subject)
	}; strings.write_byte(b, '}')
	case FilterProp_BlockStatus: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "BlockStatus")
	member(b, first, "status"); encode_AttackerBlockStatus(b, y.status)
	}; strings.write_byte(b, '}')
	case FilterProp_AttackingAlone: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AttackingAlone"); strings.write_byte(b, '}')
	case FilterProp_BlockingAlone: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BlockingAlone"); strings.write_byte(b, '}')
	case FilterProp_Tapped: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Tapped"); strings.write_byte(b, '}')
	case FilterProp_Untapped: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Untapped"); strings.write_byte(b, '}')
	case FilterProp_IsSaddled: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "IsSaddled"); strings.write_byte(b, '}')
	case FilterProp_SaddledSource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SaddledSource"); strings.write_byte(b, '}')
	case FilterProp_CrewedThisTurn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CrewedThisTurn")
	member(b, first, "relation"); encode_CrewRelation(b, y.relation)
	}; strings.write_byte(b, '}')
	case FilterProp_ConvokedSource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ConvokedSource"); strings.write_byte(b, '}')
	case FilterProp_ProtectorMatches: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ProtectorMatches")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)
	}; strings.write_byte(b, '}')
	case FilterProp_HasHasteOrControlledSinceTurnBegan: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasHasteOrControlledSinceTurnBegan"); strings.write_byte(b, '}')
	case FilterProp_WithKeyword: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WithKeyword")
	member(b, first, "value"); encode_Keyword(b, y.value)
	}; strings.write_byte(b, '}')
	case FilterProp_HasKeywordKind: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HasKeywordKind")
	member(b, first, "value"); encode_KeywordKind(b, y.value)
	}; strings.write_byte(b, '}')
	case FilterProp_WithoutKeyword: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WithoutKeyword")
	member(b, first, "value"); encode_Keyword(b, y.value)
	}; strings.write_byte(b, '}')
	case FilterProp_WithoutKeywordKind: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "WithoutKeywordKind")
	member(b, first, "value"); encode_KeywordKind(b, y.value)
	}; strings.write_byte(b, '}')
	case FilterProp_CanEnchant: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CanEnchant")
	member(b, first, "target"); enc_ptr_TargetFilter(b, y.target)
	}; strings.write_byte(b, '}')
	case FilterProp_Counters: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Counters")
	member(b, first, "counters"); encode_CounterMatch(b, y.counters)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "count"); encode_QuantityExpr(b, y.count)
	}; strings.write_byte(b, '}')
	case FilterProp_Cmc: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Cmc")
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_QuantityExpr(b, y.value)
	}; strings.write_byte(b, '}')
	case FilterProp_ManaValueParity: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ManaValueParity")
	member(b, first, "parity"); encode_ParitySource(b, y.parity)
	}; strings.write_byte(b, '}')
	case FilterProp_ManaCostIn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ManaCostIn")
	member(b, first, "costs"); enc_dyn_ManaCost(b, y.costs)
	}; strings.write_byte(b, '}')
	case FilterProp_InZone: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "InZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	}; strings.write_byte(b, '}')
	case FilterProp_Owned: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Owned")
	member(b, first, "controller"); encode_ControllerRef(b, y.controller)
	}; strings.write_byte(b, '}')
	case FilterProp_Foretold: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Foretold"); strings.write_byte(b, '}')
	case FilterProp_HasAdventure: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "HasAdventure"); strings.write_byte(b, '}')
	case FilterProp_EnchantedBy: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EnchantedBy"); strings.write_byte(b, '}')
	case FilterProp_EquippedBy: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EquippedBy"); strings.write_byte(b, '}')
	case FilterProp_AttachedTo: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AttachedTo")
	member(b, first, "to"); encode_AttachmentReferent(b, y.to)
	}; strings.write_byte(b, '}')
	case FilterProp_HasAttachment: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HasAttachment")
	member(b, first, "kind"); encode_AttachmentKind(b, y.kind)
	if !(y.controller == nil) { member(b, first, "controller"); enc_opt_ControllerRef(b, y.controller) }
	if !(skip_FilterProp_SourceExclusion_is_include(y.exclude_source)) { member(b, first, "exclude_source"); encode_with_source_exclusion_bool_compat(b, y.exclude_source) }
	}; strings.write_byte(b, '}')
	case FilterProp_HasAnyAttachmentOf: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HasAnyAttachmentOf")
	member(b, first, "kinds"); enc_dyn_AttachmentKind(b, y.kinds)
	if !(y.controller == nil) { member(b, first, "controller"); enc_opt_ControllerRef(b, y.controller) }
	}; strings.write_byte(b, '}')
	case FilterProp_Another: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Another"); strings.write_byte(b, '}')
	case FilterProp_Unpaired: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Unpaired"); strings.write_byte(b, '}')
	case FilterProp_OtherThanTriggerObject: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OtherThanTriggerObject"); strings.write_byte(b, '}')
	case FilterProp_HasColor: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HasColor")
	member(b, first, "color"); encode_ManaColor(b, y.color)
	}; strings.write_byte(b, '}')
	case FilterProp_PtComparison: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PtComparison")
	member(b, first, "stat"); encode_PtStat(b, y.stat)
	member(b, first, "scope"); encode_PtValueScope(b, y.scope)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_QuantityExpr(b, y.value)
	}; strings.write_byte(b, '}')
	case FilterProp_PowerGTSource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PowerGTSource"); strings.write_byte(b, '}')
