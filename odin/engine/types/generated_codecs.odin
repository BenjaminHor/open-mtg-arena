		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_GrantStaticAbility) -> bool {
	if fv, found := get_any(v, "definition"); found { if !dec_ptr_StaticDefinition(fv, &out.definition) do return fail("ContinuousModification::GrantStaticAbility.definition") } else { return fail("ContinuousModification::GrantStaticAbility.definition missing") }
