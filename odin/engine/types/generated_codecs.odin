	if fv, found := get_any(v, "who"); found { if !decode_ProhibitionScope(fv, &out.who) do return fail("StaticMode::CantBeActivated.who") } else { return fail("StaticMode::CantBeActivated.who missing") }
	if fv, found := get_any(v, "source_filter"); found { if !decode_TargetFilter(fv, &out.source_filter) do return fail("StaticMode::CantBeActivated.source_filter") } else { return fail("StaticMode::CantBeActivated.source_filter missing") }
	if fv, found := get_any(v, "exemption"); found { if !decode_ActivationExemption(fv, &out.exemption) do return fail("StaticMode::CantBeActivated.exemption") }
	if fv, found := get_any(v, "kind"); found { if !dec_opt_ActivatedAbilityKind(fv, &out.kind) do return fail("StaticMode::CantBeActivated.kind") }
	return true
		}) { return fail("StaticMode::CantBeActivated") }
