}

decode_ParentTargetMissingReason :: proc(v: json.Value, out: ^ParentTargetMissingReason) -> bool {
	when COVERAGE do cov_hit("ParentTargetMissingReason")
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ParentTargetMissingReason: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ParentTargetMissingReason: not a string or object")
	}
	switch variant {
	case "Dig": when COVERAGE do cov_hit("ParentTargetMissingReason::Dig"); out^ = ParentTargetMissingReason_Dig{}
	case "ChooseFromZone": when COVERAGE do cov_hit("ParentTargetMissingReason::ChooseFromZone"); out^ = ParentTargetMissingReason_ChooseFromZone{}
	case "RevealHandChoice": when COVERAGE do cov_hit("ParentTargetMissingReason::RevealHandChoice"); out^ = ParentTargetMissingReason_RevealHandChoice{}
	case "ExileTop": when COVERAGE do cov_hit("ParentTargetMissingReason::ExileTop"); out^ = ParentTargetMissingReason_ExileTop{}
	case "RevealUntil": when COVERAGE do cov_hit("ParentTargetMissingReason::RevealUntil"); out^ = ParentTargetMissingReason_RevealUntil{}
	case "SearchLibrary": when COVERAGE do cov_hit("ParentTargetMissingReason::SearchLibrary"); out^ = ParentTargetMissingReason_SearchLibrary{}
	case "IllegalAnnouncement": when COVERAGE do cov_hit("ParentTargetMissingReason::IllegalAnnouncement");
		tmp: ParentTargetMissingReason_IllegalAnnouncement
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ParentTargetMissingReason_IllegalAnnouncement) -> bool {
	if fv, found := get_any(v, "origin"); found { if !decode_TargetReadOrigin(fv, &out.origin) do return fail("ParentTargetMissingReason::IllegalAnnouncement.origin") } else { return fail("ParentTargetMissingReason::IllegalAnnouncement.origin missing") }
	return true
		}) { return fail("ParentTargetMissingReason::IllegalAnnouncement") }
		out^ = tmp
	case: return fail("ParentTargetMissingReason: unknown variant")
	}
	return true
}

encode_ParentTargetMissingReason :: proc(b: ^strings.Builder, x: ParentTargetMissingReason) {
	#partial switch y in x {
	case ParentTargetMissingReason_Dig: _ = y; json.write_string(b, "Dig")
	case ParentTargetMissingReason_ChooseFromZone: _ = y; json.write_string(b, "ChooseFromZone")
	case ParentTargetMissingReason_RevealHandChoice: _ = y; json.write_string(b, "RevealHandChoice")
	case ParentTargetMissingReason_ExileTop: _ = y; json.write_string(b, "ExileTop")
	case ParentTargetMissingReason_RevealUntil: _ = y; json.write_string(b, "RevealUntil")
	case ParentTargetMissingReason_SearchLibrary: _ = y; json.write_string(b, "SearchLibrary")
	case ParentTargetMissingReason_IllegalAnnouncement: strings.write_byte(b, '{'); json.write_string(b, "IllegalAnnouncement"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "origin"); encode_TargetReadOrigin(b, y.origin)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

