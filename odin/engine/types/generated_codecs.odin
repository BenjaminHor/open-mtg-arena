	case WaitingFor_ChooseUntapSubset: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChooseUntapSubset"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
