decode_RoundingMode :: proc(v: json.Value, out: ^RoundingMode) -> bool {
	when COVERAGE do cov_hit("RoundingMode")
	if v.kind != .String do return fail("RoundingMode: not a string")
	str := v.text
	switch str {
	case "Up": when COVERAGE do cov_hit("RoundingMode::Up"); out^ = .Up
	case "Down": when COVERAGE do cov_hit("RoundingMode::Down"); out^ = .Down
	case: return fail("RoundingMode: unknown variant")
	}
	return true
}

encode_RoundingMode :: proc(b: ^strings.Builder, x: RoundingMode) {
	@(static, rodata) NAMES := [RoundingMode]string{
		.Up = "Up",
		.Down = "Down",
	}
	json.write_string(b, NAMES[x])
}

decode_ObjectScope :: proc(v: json.Value, out: ^ObjectScope) -> bool {
	when COVERAGE do cov_hit("ObjectScope")
	if v.kind != .Object do return fail("ObjectScope: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ObjectScope: no tag")
	switch tv.text {
	case "Source": when COVERAGE do cov_hit("ObjectScope::Source"); out^ = ObjectScope_Source{}
	case "Target": when COVERAGE do cov_hit("ObjectScope::Target"); out^ = ObjectScope_Target{}
	case "Recipient": when COVERAGE do cov_hit("ObjectScope::Recipient"); out^ = ObjectScope_Recipient{}
	case "EventSource": when COVERAGE do cov_hit("ObjectScope::EventSource"); out^ = ObjectScope_EventSource{}
	case "CostPaidObject": when COVERAGE do cov_hit("ObjectScope::CostPaidObject"); out^ = ObjectScope_CostPaidObject{}
	case "Anaphoric": when COVERAGE do cov_hit("ObjectScope::Anaphoric"); out^ = ObjectScope_Anaphoric{}
	case "Demonstrative": when COVERAGE do cov_hit("ObjectScope::Demonstrative"); out^ = ObjectScope_Demonstrative{}
	case "AmassedArmy": when COVERAGE do cov_hit("ObjectScope::AmassedArmy"); out^ = ObjectScope_AmassedArmy{}
	case "EventTarget": when COVERAGE do cov_hit("ObjectScope::EventTarget"); out^ = ObjectScope_EventTarget{}
	case "OtherRevealedCard": when COVERAGE do cov_hit("ObjectScope::OtherRevealedCard"); out^ = ObjectScope_OtherRevealedCard{}
	case "OwnedLinkedExileCard": when COVERAGE do cov_hit("ObjectScope::OwnedLinkedExileCard"); out^ = ObjectScope_OwnedLinkedExileCard{}
	case "BatchSource": when COVERAGE do cov_hit("ObjectScope::BatchSource"); out^ = ObjectScope_BatchSource{}
	case "ChainRootTarget": when COVERAGE do cov_hit("ObjectScope::ChainRootTarget"); out^ = ObjectScope_ChainRootTarget{}
	case "GrantingObject": when COVERAGE do cov_hit("ObjectScope::GrantingObject"); out^ = ObjectScope_GrantingObject{}
	case "SpecificObject": when COVERAGE do cov_hit("ObjectScope::SpecificObject");
		tmp: ObjectScope_SpecificObject
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ObjectScope_SpecificObject) -> bool {
	if fv, found := get_any(v, "object"); found { if !decode_ObjectIncarnationRef(fv, &out.object) do return fail("ObjectScope::SpecificObject.object") } else { return fail("ObjectScope::SpecificObject.object missing") }
	return true
		}) { return fail("ObjectScope::SpecificObject") }
		out^ = tmp
	case: return fail("ObjectScope: unknown variant")
	}
	return true
}

encode_ObjectScope :: proc(b: ^strings.Builder, x: ObjectScope) {
	#partial switch y in x {
	case ObjectScope_Source: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Source"); strings.write_byte(b, '}')
	case ObjectScope_Target: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Target"); strings.write_byte(b, '}')
	case ObjectScope_Recipient: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Recipient"); strings.write_byte(b, '}')
	case ObjectScope_EventSource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EventSource"); strings.write_byte(b, '}')
