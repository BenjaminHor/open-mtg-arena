	case "wrong_count": out^ = .WrongCount
	case "wrong_duration": out^ = .WrongDuration
	case "wrong_zone": out^ = .WrongZone
	case "missing_effect": out^ = .MissingEffect
	case "extra_effect": out^ = .ExtraEffect
	case "cost_wrong": out^ = .CostWrong
	case "condition_wrong": out^ = .ConditionWrong
	case "trigger_wrong": out^ = .TriggerWrong
	case "target_wrong": out^ = .TargetWrong
	case "other": out^ = .Other
	case: return fail("MisparseClass: unknown variant")
	}
	return true
}

encode_MisparseClass :: proc(b: ^strings.Builder, x: MisparseClass) {
	@(static, rodata) NAMES := [MisparseClass]string{
		.DroppedQualifier = "dropped_qualifier",
		.WrongPlayer = "wrong_player",
		.WrongObject = "wrong_object",
		.WrongCount = "wrong_count",
		.WrongDuration = "wrong_duration",
		.WrongZone = "wrong_zone",
		.MissingEffect = "missing_effect",
		.ExtraEffect = "extra_effect",
		.CostWrong = "cost_wrong",
		.ConditionWrong = "condition_wrong",
		.TriggerWrong = "trigger_wrong",
		.TargetWrong = "target_wrong",
		.Other = "other",
	}
	json.write_string(b, NAMES[x])
}

