decode_TokenSpec :: proc(v: json.Value, out: ^TokenSpec) -> bool {
	when COVERAGE do cov_hit("TokenSpec")
	if v.kind != .Object do return fail("TokenSpec: not an object")
	if fv, found := get_any(v, "characteristics"); found { if !decode_TokenCharacteristics(fv, &out.characteristics) do return fail("TokenSpec.characteristics") } else { return fail("TokenSpec.characteristics missing") }
	if fv, found := get_any(v, "script_name"); found { if !decode_string(fv, &out.script_name) do return fail("TokenSpec.script_name") } else { return fail("TokenSpec.script_name missing") }
	if fv, found := get_any(v, "static_abilities"); found { if !dec_dyn_StaticDefinition(fv, &out.static_abilities) do return fail("TokenSpec.static_abilities") } else { return fail("TokenSpec.static_abilities missing") }
	if fv, found := get_any(v, "enter_with_counters"); found { if !dec_dyn_t2_CounterType_u32(fv, &out.enter_with_counters) do return fail("TokenSpec.enter_with_counters") } else { return fail("TokenSpec.enter_with_counters missing") }
	if fv, found := get_any(v, "tapped"); found { if !decode_bool(fv, &out.tapped) do return fail("TokenSpec.tapped") } else { return fail("TokenSpec.tapped missing") }
	if fv, found := get_any(v, "enters_attacking"); found { if !decode_bool(fv, &out.enters_attacking) do return fail("TokenSpec.enters_attacking") } else { return fail("TokenSpec.enters_attacking missing") }
	if fv, found := get_any(v, "attack_request"); found { if !decode_TokenAttackRequest(fv, &out.attack_request) do return fail("TokenSpec.attack_request") } else { out.attack_request = TokenAttackRequest(TokenAttackRequest_Unspecified{}) }
	if fv, found := get_any(v, "sacrifice_at"); found { if !dec_opt_Duration(fv, &out.sacrifice_at) do return fail("TokenSpec.sacrifice_at") }
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("TokenSpec.source_id") } else { return fail("TokenSpec.source_id missing") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("TokenSpec.controller") } else { return fail("TokenSpec.controller missing") }
	if fv, found := get_any(v, "attach_to"); found { if !decode_TokenHostRequest(fv, &out.attach_to) do return fail("TokenSpec.attach_to") } else { out.attach_to = TokenHostRequest(TokenHostRequest_NotRequested{}) }
	return true
}

encode_TokenSpec :: proc(b: ^strings.Builder, x: TokenSpec) {
	strings.write_byte(b, '{')
	f := true
	encode_TokenSpec_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_TokenSpec_members :: proc(b: ^strings.Builder, x: TokenSpec, first: ^bool) {
	member(b, first, "characteristics"); encode_TokenCharacteristics(b, x.characteristics)
	member(b, first, "script_name"); encode_string(b, x.script_name)
	member(b, first, "static_abilities"); enc_dyn_StaticDefinition(b, x.static_abilities)
	member(b, first, "enter_with_counters"); enc_dyn_t2_CounterType_u32(b, x.enter_with_counters)
	member(b, first, "tapped"); encode_bool(b, x.tapped)
	member(b, first, "enters_attacking"); encode_bool(b, x.enters_attacking)
	if !(skip_TokenSpec_TokenAttackRequest_is_unspecified_TokenAttackRequest(x.attack_request)) { member(b, first, "attack_request"); encode_TokenAttackRequest(b, x.attack_request) }
	member(b, first, "sacrifice_at"); enc_opt_Duration(b, x.sacrifice_at)
	member(b, first, "source_id"); encode_ObjectId(b, x.source_id)
	member(b, first, "controller"); encode_PlayerId(b, x.controller)
	if !(skip_TokenSpec_TokenHostRequest_is_not_requested_TokenHostRequest(x.attach_to)) { member(b, first, "attach_to"); encode_TokenHostRequest(b, x.attach_to) }
}

decode_TokenBatch :: proc(v: json.Value, out: ^TokenBatch) -> bool {
	when COVERAGE do cov_hit("TokenBatch")
	if v.kind != .Object do return fail("TokenBatch: not an object")
	if fv, found := get_any(v, "owner"); found { if !decode_PlayerId(fv, &out.owner) do return fail("TokenBatch.owner") } else { return fail("TokenBatch.owner missing") }
	if fv, found := get_any(v, "spec"); found { if !dec_ptr_TokenSpec(fv, &out.spec) do return fail("TokenBatch.spec") } else { return fail("TokenBatch.spec missing") }
	if fv, found := get_any(v, "copy"); found { if !dec_ptr_CopyTokenSpec(fv, &out.copy) do return fail("TokenBatch.copy") }
	if fv, found := get_any(v, "enter_tapped"); found { if !decode_EtbTapState(fv, &out.enter_tapped) do return fail("TokenBatch.enter_tapped") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("TokenBatch.count") } else { return fail("TokenBatch.count missing") }
	if fv, found := get_any(v, "redirected_to"); found { if !dec_opt_Zone(fv, &out.redirected_to) do return fail("TokenBatch.redirected_to") }
	return true
}

encode_TokenBatch :: proc(b: ^strings.Builder, x: TokenBatch) {
	strings.write_byte(b, '{')
	f := true
	encode_TokenBatch_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_TokenBatch_members :: proc(b: ^strings.Builder, x: TokenBatch, first: ^bool) {
	member(b, first, "owner"); encode_PlayerId(b, x.owner)
	member(b, first, "spec"); enc_ptr_TokenSpec(b, x.spec)
	if !(x.copy == nil) { member(b, first, "copy"); enc_ptr_CopyTokenSpec(b, x.copy) }
	member(b, first, "enter_tapped"); encode_EtbTapState(b, x.enter_tapped)
	member(b, first, "count"); encode_u32(b, x.count)
	if !(x.redirected_to == nil) { member(b, first, "redirected_to"); enc_opt_Zone(b, x.redirected_to) }
}

