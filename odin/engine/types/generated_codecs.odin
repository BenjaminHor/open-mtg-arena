	case ContinuousModification_RetainAllOtherAbilitiesFromSource: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RetainAllOtherAbilitiesFromSource"); strings.write_byte(b, '}')
	case ContinuousModification_AddSupertype: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "AddSupertype")
