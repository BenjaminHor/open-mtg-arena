	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("AppliedReplacementKey::Object.source") } else { return fail("AppliedReplacementKey::Object.source missing") }
	if fv, found := get_any(v, "index"); found { if !decode_u64(fv, &out.index) do return fail("AppliedReplacementKey::Object.index") } else { return fail("AppliedReplacementKey::Object.index missing") }
	return true
		}) { return fail("AppliedReplacementKey::Object") }
		out^ = tmp
	case "Floating": when COVERAGE do cov_hit("AppliedReplacementKey::Floating");
		tmp: AppliedReplacementKey_Floating
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AppliedReplacementKey_Floating) -> bool {
	if fv, found := get_any(v, "index"); found { if !decode_u64(fv, &out.index) do return fail("AppliedReplacementKey::Floating.index") } else { return fail("AppliedReplacementKey::Floating.index missing") }
	return true
		}) { return fail("AppliedReplacementKey::Floating") }
		out^ = tmp
	case "StepEndMana": when COVERAGE do cov_hit("AppliedReplacementKey::StepEndMana");
		tmp: AppliedReplacementKey_StepEndMana
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AppliedReplacementKey_StepEndMana) -> bool {
	if fv, found := get_any(v, "index"); found { if !decode_u64(fv, &out.index) do return fail("AppliedReplacementKey::StepEndMana.index") } else { return fail("AppliedReplacementKey::StepEndMana.index missing") }
	return true
		}) { return fail("AppliedReplacementKey::StepEndMana") }
		out^ = tmp
	case "EntryControllerChoice": when COVERAGE do cov_hit("AppliedReplacementKey::EntryControllerChoice");
		tmp: AppliedReplacementKey_EntryControllerChoice
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AppliedReplacementKey_EntryControllerChoice) -> bool {
	if fv, found := get_any(v, "source"); found { if !decode_ObjectId(fv, &out.source) do return fail("AppliedReplacementKey::EntryControllerChoice.source") } else { return fail("AppliedReplacementKey::EntryControllerChoice.source missing") }
	if fv, found := get_any(v, "index"); found { if !decode_u64(fv, &out.index) do return fail("AppliedReplacementKey::EntryControllerChoice.index") } else { return fail("AppliedReplacementKey::EntryControllerChoice.index missing") }
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("AppliedReplacementKey::EntryControllerChoice.controller") } else { return fail("AppliedReplacementKey::EntryControllerChoice.controller missing") }
	return true
		}) { return fail("AppliedReplacementKey::EntryControllerChoice") }
		out^ = tmp
	case "Protection": when COVERAGE do cov_hit("AppliedReplacementKey::Protection");
		tmp: AppliedReplacementKey_Protection
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AppliedReplacementKey_Protection) -> bool {
	if fv, found := get_any(v, "quality"); found { if !decode_MatchedProtectionQuality(fv, &out.quality) do return fail("AppliedReplacementKey::Protection.quality") } else { return fail("AppliedReplacementKey::Protection.quality missing") }
	return true
		}) { return fail("AppliedReplacementKey::Protection") }
		out^ = tmp
	case: return fail("AppliedReplacementKey: unknown variant")
	}
	return true
}

encode_AppliedReplacementKey :: proc(b: ^strings.Builder, x: AppliedReplacementKey) {
	#partial switch y in x {
	case AppliedReplacementKey_Object: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Object")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "index"); encode_u64(b, y.index)
	}; strings.write_byte(b, '}')
	case AppliedReplacementKey_Floating: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Floating")
	member(b, first, "index"); encode_u64(b, y.index)
	}; strings.write_byte(b, '}')
	case AppliedReplacementKey_StepEndMana: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "StepEndMana")
	member(b, first, "index"); encode_u64(b, y.index)
	}; strings.write_byte(b, '}')
	case AppliedReplacementKey_EntryControllerChoice: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "EntryControllerChoice")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "index"); encode_u64(b, y.index)
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	}; strings.write_byte(b, '}')
	case AppliedReplacementKey_Protection: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Protection")
	member(b, first, "quality"); encode_MatchedProtectionQuality(b, y.quality)
	}; strings.write_byte(b, '}')
	}
}

encode_AppliedReplacementKey_members :: proc(b: ^strings.Builder, x: AppliedReplacementKey, first: ^bool) {
	#partial switch y in x {
	case AppliedReplacementKey_Object: member(b, first, "type"); json.write_string(b, "Object")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "index"); encode_u64(b, y.index)

	case AppliedReplacementKey_Floating: member(b, first, "type"); json.write_string(b, "Floating")
	member(b, first, "index"); encode_u64(b, y.index)

	case AppliedReplacementKey_StepEndMana: member(b, first, "type"); json.write_string(b, "StepEndMana")
	member(b, first, "index"); encode_u64(b, y.index)

	case AppliedReplacementKey_EntryControllerChoice: member(b, first, "type"); json.write_string(b, "EntryControllerChoice")
	member(b, first, "source"); encode_ObjectId(b, y.source)
	member(b, first, "index"); encode_u64(b, y.index)
	member(b, first, "controller"); encode_PlayerId(b, y.controller)

	case AppliedReplacementKey_Protection: member(b, first, "type"); json.write_string(b, "Protection")
	member(b, first, "quality"); encode_MatchedProtectionQuality(b, y.quality)

	}
}

decode_ParkedEntry :: proc(v: json.Value, out: ^ParkedEntry) -> bool {
	when COVERAGE do cov_hit("ParkedEntry")
	if v.kind != .Object do return fail("ParkedEntry: not an object")
	if fv, found := get_any(v, "event"); found { if !decode_GameEvent(fv, &out.event) do return fail("ParkedEntry.event") } else { return fail("ParkedEntry.event missing") }
	if fv, found := get_any(v, "state"); found { if !decode_ParkedEntryState(fv, &out.state) do return fail("ParkedEntry.state") } else { return fail("ParkedEntry.state missing") }
	if fv, found := get_any(v, "entry_attack"); found { if !dec_opt_EntryAttackDestination(fv, &out.entry_attack) do return fail("ParkedEntry.entry_attack") }
	if fv, found := get_any(v, "held_triggers"); found { if !dec_dyn_PendingTriggerContext(fv, &out.held_triggers) do return fail("ParkedEntry.held_triggers") }
	return true
}

encode_ParkedEntry :: proc(b: ^strings.Builder, x: ParkedEntry) {
	strings.write_byte(b, '{')
	f := true
	encode_ParkedEntry_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ParkedEntry_members :: proc(b: ^strings.Builder, x: ParkedEntry, first: ^bool) {
	member(b, first, "event"); encode_GameEvent(b, x.event)
	member(b, first, "state"); encode_ParkedEntryState(b, x.state)
	if !(x.entry_attack == nil) { member(b, first, "entry_attack"); enc_opt_EntryAttackDestination(b, x.entry_attack) }
	if !((len(x.held_triggers) == 0)) { member(b, first, "held_triggers"); enc_dyn_PendingTriggerContext(b, x.held_triggers) }
}

