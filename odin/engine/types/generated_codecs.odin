	strings.write_byte(b, '}')
}

encode_RoomCopiableHalves_members :: proc(b: ^strings.Builder, x: RoomCopiableHalves, first: ^bool) {
	member(b, first, "left"); encode_RoomHalfIdentity(b, x.left)
	if !(x.right == nil) { member(b, first, "right"); enc_opt_RoomHalfIdentity(b, x.right) }
}

decode_BackFaceData :: proc(v: json.Value, out: ^BackFaceData) -> bool {
	if v.kind != .Object do return fail("BackFaceData: not an object")
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("BackFaceData.name") } else { return fail("BackFaceData.name missing") }
	if fv, found := get_any(v, "power"); found { if !dec_opt_i32(fv, &out.power) do return fail("BackFaceData.power") }
	if fv, found := get_any(v, "toughness"); found { if !dec_opt_i32(fv, &out.toughness) do return fail("BackFaceData.toughness") }
	if fv, found := get_any(v, "loyalty"); found { if !dec_opt_u32(fv, &out.loyalty) do return fail("BackFaceData.loyalty") }
	if fv, found := get_any(v, "printed_loyalty"); found { if !dec_opt_PrintedLoyalty(fv, &out.printed_loyalty) do return fail("BackFaceData.printed_loyalty") }
	if fv, found := get_any(v, "defense"); found { if !dec_opt_u32(fv, &out.defense) do return fail("BackFaceData.defense") }
	if fv, found := get_any(v, "card_types"); found { if !decode_CardType(fv, &out.card_types) do return fail("BackFaceData.card_types") } else { return fail("BackFaceData.card_types missing") }
	if fv, found := get_any(v, "mana_cost"); found { if !decode_ManaCost(fv, &out.mana_cost) do return fail("BackFaceData.mana_cost") } else { return fail("BackFaceData.mana_cost missing") }
	if fv, found := get_any(v, "keywords"); found { if !dec_dyn_Keyword(fv, &out.keywords) do return fail("BackFaceData.keywords") } else { return fail("BackFaceData.keywords missing") }
	if fv, found := get_any(v, "abilities"); found { if !dec_dyn_AbilityDefinition(fv, &out.abilities) do return fail("BackFaceData.abilities") } else { return fail("BackFaceData.abilities missing") }
	if fv, found := get_any(v, "trigger_definitions"); found { if !decode_Definitions_TriggerDefinition(fv, &out.trigger_definitions) do return fail("BackFaceData.trigger_definitions") } else { return fail("BackFaceData.trigger_definitions missing") }
	if fv, found := get_any(v, "trigger_printed_origins"); found { if !dec_dyn_opt_TriggerPrintedOrigin(fv, &out.trigger_printed_origins) do return fail("BackFaceData.trigger_printed_origins") }
	if fv, found := get_any(v, "replacement_definitions"); found { if !decode_Definitions_ReplacementDefinition(fv, &out.replacement_definitions) do return fail("BackFaceData.replacement_definitions") } else { return fail("BackFaceData.replacement_definitions missing") }
	if fv, found := get_any(v, "static_definitions"); found { if !decode_Definitions_StaticDefinition(fv, &out.static_definitions) do return fail("BackFaceData.static_definitions") } else { return fail("BackFaceData.static_definitions missing") }
	if fv, found := get_any(v, "color"); found { if !dec_dyn_ManaColor(fv, &out.color) do return fail("BackFaceData.color") } else { return fail("BackFaceData.color missing") }
	if fv, found := get_any(v, "printed_ref"); found { if !dec_opt_PrintedCardRef(fv, &out.printed_ref) do return fail("BackFaceData.printed_ref") }
	if fv, found := get_any(v, "modal"); found { if !dec_opt_ModalChoice(fv, &out.modal) do return fail("BackFaceData.modal") }
	if fv, found := get_any(v, "additional_cost"); found { if !dec_opt_AdditionalCost(fv, &out.additional_cost) do return fail("BackFaceData.additional_cost") }
	if fv, found := get_any(v, "strive_cost"); found { if !dec_opt_ManaCost(fv, &out.strive_cost) do return fail("BackFaceData.strive_cost") }
	if fv, found := get_any(v, "casting_restrictions"); found { if !dec_dyn_CastingRestriction(fv, &out.casting_restrictions) do return fail("BackFaceData.casting_restrictions") } else { return fail("BackFaceData.casting_restrictions missing") }
	if fv, found := get_any(v, "casting_options"); found { if !dec_dyn_SpellCastingOption(fv, &out.casting_options) do return fail("BackFaceData.casting_options") } else { return fail("BackFaceData.casting_options missing") }
	if fv, found := get_any(v, "parse_warnings"); found { if !dec_dyn_OracleDiagnostic(fv, &out.parse_warnings) do return fail("BackFaceData.parse_warnings") }
	if fv, found := get_any(v, "layout_kind"); found { if !dec_opt_LayoutKind(fv, &out.layout_kind) do return fail("BackFaceData.layout_kind") }
	if fv, found := get_any(v, "is_swap_snapshot"); found { if !decode_bool(fv, &out.is_swap_snapshot) do return fail("BackFaceData.is_swap_snapshot") }
	return true
}

encode_BackFaceData :: proc(b: ^strings.Builder, x: BackFaceData) {
	strings.write_byte(b, '{')
	f := true
	encode_BackFaceData_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_BackFaceData_members :: proc(b: ^strings.Builder, x: BackFaceData, first: ^bool) {
	member(b, first, "name"); encode_string(b, x.name)
	member(b, first, "power"); enc_opt_i32(b, x.power)
	member(b, first, "toughness"); enc_opt_i32(b, x.toughness)
	member(b, first, "loyalty"); enc_opt_u32(b, x.loyalty)
	if !(x.printed_loyalty == nil) { member(b, first, "printed_loyalty"); enc_opt_PrintedLoyalty(b, x.printed_loyalty) }
	if !(x.defense == nil) { member(b, first, "defense"); enc_opt_u32(b, x.defense) }
	member(b, first, "card_types"); encode_CardType(b, x.card_types)
	member(b, first, "mana_cost"); encode_ManaCost(b, x.mana_cost)
	member(b, first, "keywords"); enc_dyn_Keyword(b, x.keywords)
	member(b, first, "abilities"); enc_dyn_AbilityDefinition(b, x.abilities)
	member(b, first, "trigger_definitions"); encode_Definitions_TriggerDefinition(b, x.trigger_definitions)
	if !(len(x.trigger_printed_origins) == 0) { member(b, first, "trigger_printed_origins"); enc_dyn_opt_TriggerPrintedOrigin(b, x.trigger_printed_origins) }
	member(b, first, "replacement_definitions"); encode_Definitions_ReplacementDefinition(b, x.replacement_definitions)
	member(b, first, "static_definitions"); encode_Definitions_StaticDefinition(b, x.static_definitions)
	member(b, first, "color"); enc_dyn_ManaColor(b, x.color)
	member(b, first, "printed_ref"); enc_opt_PrintedCardRef(b, x.printed_ref)
	member(b, first, "modal"); enc_opt_ModalChoice(b, x.modal)
	member(b, first, "additional_cost"); enc_opt_AdditionalCost(b, x.additional_cost)
	member(b, first, "strive_cost"); enc_opt_ManaCost(b, x.strive_cost)
	member(b, first, "casting_restrictions"); enc_dyn_CastingRestriction(b, x.casting_restrictions)
	member(b, first, "casting_options"); enc_dyn_SpellCastingOption(b, x.casting_options)
	if !(len(x.parse_warnings) == 0) { member(b, first, "parse_warnings"); enc_dyn_OracleDiagnostic(b, x.parse_warnings) }
	if !(x.layout_kind == nil) { member(b, first, "layout_kind"); enc_opt_LayoutKind(b, x.layout_kind) }
	if !(!x.is_swap_snapshot) { member(b, first, "is_swap_snapshot"); encode_bool(b, x.is_swap_snapshot) }
}

