	case DebugAction_ModifyCounters: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ModifyCounters"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
