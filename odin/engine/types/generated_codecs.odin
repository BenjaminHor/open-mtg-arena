	strings.write_byte(b, '}')
}

encode_AbilityUsageKey_members :: proc(b: ^strings.Builder, x: AbilityUsageKey, first: ^bool) {
	member(b, first, "source"); encode_ObjectId(b, x.source)
	member(b, first, "provenance"); enc_opt_ObjectIncarnationRef(b, x.provenance)
	member(b, first, "description"); enc_opt_string(b, x.description)
	member(b, first, "fingerprint"); encode_string(b, x.fingerprint)
