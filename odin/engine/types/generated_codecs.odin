	strings.write_byte(b, '}')
}

encode_ZoneSpend_members :: proc(b: ^strings.Builder, x: ZoneSpend, first: ^bool) {
	member(b, first, "zone"); encode_Zone(b, x.zone)
	member(b, first, "polarity"); encode_ZoneSpendPolarity(b, x.polarity)
}

decode_ManaRestriction :: proc(v: json.Value, out: ^ManaRestriction) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("ManaRestriction: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("ManaRestriction: not a string or object")
	}
	switch variant {
	case "OnlyForSpell": out^ = ManaRestriction_OnlyForSpell{}
	case "OnlyForSpellType": tmp: ManaRestriction_OnlyForSpellType; if !decode_string(body, &tmp._0) do return fail("ManaRestriction::OnlyForSpellType"); out^ = tmp
	case "OnlyForCreatureType": tmp: ManaRestriction_OnlyForCreatureType; if !decode_string(body, &tmp._0) do return fail("ManaRestriction::OnlyForCreatureType"); out^ = tmp
	case "OnlyForTypeSpellsOrAbilities":
		tmp: ManaRestriction_OnlyForTypeSpellsOrAbilities
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaRestriction_OnlyForTypeSpellsOrAbilities) -> bool {
	if fv, found := get_any(v, "spell_type"); found { if !decode_string(fv, &out.spell_type) do return fail("ManaRestriction::OnlyForTypeSpellsOrAbilities.spell_type") } else { return fail("ManaRestriction::OnlyForTypeSpellsOrAbilities.spell_type missing") }
	if fv, found := get_any(v, "ability"); found { if !decode_AbilityActivationScope(fv, &out.ability) do return fail("ManaRestriction::OnlyForTypeSpellsOrAbilities.ability") } else { return fail("ManaRestriction::OnlyForTypeSpellsOrAbilities.ability missing") }
	return true
		}) { return fail("ManaRestriction::OnlyForTypeSpellsOrAbilities") }
		out^ = tmp
	case "OnlyForActivation": out^ = ManaRestriction_OnlyForActivation{}
	case "OnlyForTaggedActivation": tmp: ManaRestriction_OnlyForTaggedActivation; if !decode_AbilityTag(body, &tmp._0) do return fail("ManaRestriction::OnlyForTaggedActivation"); out^ = tmp
	case "OnlyForXCosts": out^ = ManaRestriction_OnlyForXCosts{}
	case "OnlyForSpellWithKeywordKind": tmp: ManaRestriction_OnlyForSpellWithKeywordKind; if !decode_KeywordKind(body, &tmp._0) do return fail("ManaRestriction::OnlyForSpellWithKeywordKind"); out^ = tmp
	case "OnlyForSpellWithKeywordKindFromZone":
		data := body
		if data.kind != .Array || len(data.items) != 2 do return fail("ManaRestriction::OnlyForSpellWithKeywordKindFromZone")
		tmp: ManaRestriction_OnlyForSpellWithKeywordKindFromZone
		if !decode_KeywordKind(data.items[0], &tmp._0) do return fail("ManaRestriction::OnlyForSpellWithKeywordKindFromZone._0")
		if !decode_Zone(data.items[1], &tmp._1) do return fail("ManaRestriction::OnlyForSpellWithKeywordKindFromZone._1")
		out^ = tmp
	case "OnlyForSpellWithManaValue":
		tmp: ManaRestriction_OnlyForSpellWithManaValue
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaRestriction_OnlyForSpellWithManaValue) -> bool {
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("ManaRestriction::OnlyForSpellWithManaValue.comparator") } else { return fail("ManaRestriction::OnlyForSpellWithManaValue.comparator missing") }
	if fv, found := get_any(v, "value"); found { if !decode_u32(fv, &out.value) do return fail("ManaRestriction::OnlyForSpellWithManaValue.value") } else { return fail("ManaRestriction::OnlyForSpellWithManaValue.value missing") }
	return true
		}) { return fail("ManaRestriction::OnlyForSpellWithManaValue") }
		out^ = tmp
	case "OnlyForSpellMatchingCostCriteria":
		tmp: ManaRestriction_OnlyForSpellMatchingCostCriteria
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaRestriction_OnlyForSpellMatchingCostCriteria) -> bool {
	if fv, found := get_any(v, "spell_type"); found { if !dec_opt_string(fv, &out.spell_type) do return fail("ManaRestriction::OnlyForSpellMatchingCostCriteria.spell_type") }
	if fv, found := get_any(v, "criteria"); found { if !dec_dyn_SpellCostCriterion(fv, &out.criteria) do return fail("ManaRestriction::OnlyForSpellMatchingCostCriteria.criteria") } else { return fail("ManaRestriction::OnlyForSpellMatchingCostCriteria.criteria missing") }
	return true
		}) { return fail("ManaRestriction::OnlyForSpellMatchingCostCriteria") }
		out^ = tmp
	case "OnlyForSpellWithColorCount":
		tmp: ManaRestriction_OnlyForSpellWithColorCount
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^ManaRestriction_OnlyForSpellWithColorCount) -> bool {
	if fv, found := get_any(v, "comparator"); found { if !decode_Comparator(fv, &out.comparator) do return fail("ManaRestriction::OnlyForSpellWithColorCount.comparator") } else { return fail("ManaRestriction::OnlyForSpellWithColorCount.comparator missing") }
	if fv, found := get_any(v, "count"); found { if !decode_u32(fv, &out.count) do return fail("ManaRestriction::OnlyForSpellWithColorCount.count") } else { return fail("ManaRestriction::OnlyForSpellWithColorCount.count missing") }
	return true
		}) { return fail("ManaRestriction::OnlyForSpellWithColorCount") }
		out^ = tmp
	case "OnlyForSpellColor": tmp: ManaRestriction_OnlyForSpellColor; if !decode_ManaColor(body, &tmp._0) do return fail("ManaRestriction::OnlyForSpellColor"); out^ = tmp
	case "OnlyForSpellFromZone": tmp: ManaRestriction_OnlyForSpellFromZone; if !decode_ZoneSpend(body, &tmp._0) do return fail("ManaRestriction::OnlyForSpellFromZone"); out^ = tmp
	case "CannotCastSpellFromZone": tmp: ManaRestriction_CannotCastSpellFromZone; if !decode_Zone(body, &tmp._0) do return fail("ManaRestriction::CannotCastSpellFromZone"); out^ = tmp
	case "OnlyForFaceDownSpell": out^ = ManaRestriction_OnlyForFaceDownSpell{}
	case "OnlyForAny": tmp: ManaRestriction_OnlyForAny; if !dec_dyn_ManaRestriction(body, &tmp._0) do return fail("ManaRestriction::OnlyForAny"); out^ = tmp
	case "OnlyForSpecialAction": tmp: ManaRestriction_OnlyForSpecialAction; if !decode_SpecialAction(body, &tmp._0) do return fail("ManaRestriction::OnlyForSpecialAction"); out^ = tmp
	case "Impossible": out^ = ManaRestriction_Impossible{}
	case "ConvokePayment": out^ = ManaRestriction_ConvokePayment{}
	case: return fail("ManaRestriction: unknown variant")
	}
	return true
}

encode_ManaRestriction :: proc(b: ^strings.Builder, x: ManaRestriction) {
	#partial switch y in x {
	case ManaRestriction_OnlyForSpell: _ = y; json.write_string(b, "OnlyForSpell")
	case ManaRestriction_OnlyForSpellType: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellType"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForCreatureType: strings.write_byte(b, '{'); json.write_string(b, "OnlyForCreatureType"); strings.write_byte(b, ':'); encode_string(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForTypeSpellsOrAbilities: strings.write_byte(b, '{'); json.write_string(b, "OnlyForTypeSpellsOrAbilities"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "spell_type"); encode_string(b, y.spell_type)
	member(b, first, "ability"); encode_AbilityActivationScope(b, y.ability)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForActivation: _ = y; json.write_string(b, "OnlyForActivation")
	case ManaRestriction_OnlyForTaggedActivation: strings.write_byte(b, '{'); json.write_string(b, "OnlyForTaggedActivation"); strings.write_byte(b, ':'); encode_AbilityTag(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForXCosts: _ = y; json.write_string(b, "OnlyForXCosts")
	case ManaRestriction_OnlyForSpellWithKeywordKind: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellWithKeywordKind"); strings.write_byte(b, ':'); encode_KeywordKind(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForSpellWithKeywordKindFromZone: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellWithKeywordKindFromZone"); strings.write_byte(b, ':'); strings.write_byte(b, '['); encode_KeywordKind(b, y._0); strings.write_byte(b, ','); encode_Zone(b, y._1); strings.write_byte(b, ']'); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForSpellWithManaValue: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellWithManaValue"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_u32(b, y.value)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForSpellMatchingCostCriteria: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellMatchingCostCriteria"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	if !(y.spell_type == nil) { member(b, first, "spell_type"); enc_opt_string(b, y.spell_type) }
	member(b, first, "criteria"); enc_dyn_SpellCostCriterion(b, y.criteria)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForSpellWithColorCount: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellWithColorCount"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForSpellColor: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellColor"); strings.write_byte(b, ':'); encode_ManaColor(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForSpellFromZone: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpellFromZone"); strings.write_byte(b, ':'); encode_ZoneSpend(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_CannotCastSpellFromZone: strings.write_byte(b, '{'); json.write_string(b, "CannotCastSpellFromZone"); strings.write_byte(b, ':'); encode_Zone(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForFaceDownSpell: _ = y; json.write_string(b, "OnlyForFaceDownSpell")
	case ManaRestriction_OnlyForAny: strings.write_byte(b, '{'); json.write_string(b, "OnlyForAny"); strings.write_byte(b, ':'); enc_dyn_ManaRestriction(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_OnlyForSpecialAction: strings.write_byte(b, '{'); json.write_string(b, "OnlyForSpecialAction"); strings.write_byte(b, ':'); encode_SpecialAction(b, y._0); strings.write_byte(b, '}')
	case ManaRestriction_Impossible: _ = y; json.write_string(b, "Impossible")
	case ManaRestriction_ConvokePayment: _ = y; json.write_string(b, "ConvokePayment")
	}
}

decode_TurnGate :: proc(v: json.Value, out: ^TurnGate) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("TurnGate: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("TurnGate: not a string or object")
	}
	switch variant {
	case "None": out^ = TurnGate_None{}
	case "AfterCreationTurn": out^ = TurnGate_AfterCreationTurn{}
	case "After": tmp: TurnGate_After; if !decode_u32(body, &tmp._0) do return fail("TurnGate::After"); out^ = tmp
	case: return fail("TurnGate: unknown variant")
	}
	return true
}

encode_TurnGate :: proc(b: ^strings.Builder, x: TurnGate) {
	#partial switch y in x {
	case TurnGate_None: _ = y; json.write_string(b, "None")
	case TurnGate_AfterCreationTurn: _ = y; json.write_string(b, "AfterCreationTurn")
	case TurnGate_After: strings.write_byte(b, '{'); json.write_string(b, "After"); strings.write_byte(b, ':'); encode_u32(b, y._0); strings.write_byte(b, '}')
	}
}

decode_DelayedTriggerPlayerBinding :: proc(v: json.Value, out: ^DelayedTriggerPlayerBinding) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("DelayedTriggerPlayerBinding: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("DelayedTriggerPlayerBinding: not a string or object")
	}
	switch variant {
	case "Controller": out^ = DelayedTriggerPlayerBinding_Controller{}
	case "ParentTargetOwner": out^ = DelayedTriggerPlayerBinding_ParentTargetOwner{}
	case "ChosenPlayer":
		tmp: DelayedTriggerPlayerBinding_ChosenPlayer
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^DelayedTriggerPlayerBinding_ChosenPlayer) -> bool {
	if fv, found := get_any(v, "index"); found { if !decode_u8(fv, &out.index) do return fail("DelayedTriggerPlayerBinding::ChosenPlayer.index") } else { return fail("DelayedTriggerPlayerBinding::ChosenPlayer.index missing") }
	return true
		}) { return fail("DelayedTriggerPlayerBinding::ChosenPlayer") }
		out^ = tmp
	case: return fail("DelayedTriggerPlayerBinding: unknown variant")
	}
	return true
}

encode_DelayedTriggerPlayerBinding :: proc(b: ^strings.Builder, x: DelayedTriggerPlayerBinding) {
	#partial switch y in x {
	case DelayedTriggerPlayerBinding_Controller: _ = y; json.write_string(b, "Controller")
	case DelayedTriggerPlayerBinding_ParentTargetOwner: _ = y; json.write_string(b, "ParentTargetOwner")
	case DelayedTriggerPlayerBinding_ChosenPlayer: strings.write_byte(b, '{'); json.write_string(b, "ChosenPlayer"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "index"); encode_u8(b, y.index)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_ExtraPhaseId :: proc(v: json.Value, out: ^ExtraPhaseId) -> bool {
	return decode_u64(v, cast(^u64)out)
}

encode_ExtraPhaseId :: proc(b: ^strings.Builder, x: ExtraPhaseId) {
	encode_u64(b, cast(u64)x)
}

decode_ExtraTurnId :: proc(v: json.Value, out: ^ExtraTurnId) -> bool {
	return decode_u64(v, cast(^u64)out)
}

encode_ExtraTurnId :: proc(b: ^strings.Builder, x: ExtraTurnId) {
	encode_u64(b, cast(u64)x)
}

decode_WheneverEventExpiry :: proc(v: json.Value, out: ^WheneverEventExpiry) -> bool {
	variant: string
	body: json.Value
	#partial switch v.kind {
	case .String: variant = v.text
	case .Object:
		if len(v.members) != 1 do return fail("WheneverEventExpiry: externally tagged object needs one key")
		variant, body = v.members[0].key, v.members[0].value
	case: return fail("WheneverEventExpiry: not a string or object")
	}
	switch variant {
	case "EndOfTurn": out^ = WheneverEventExpiry_EndOfTurn{}
	case "UntilControllersNextTurn":
		tmp: WheneverEventExpiry_UntilControllersNextTurn
		if !decode_variant(body, &tmp, proc(v: json.Value, out: ^WheneverEventExpiry_UntilControllersNextTurn) -> bool {
	if fv, found := get_any(v, "after"); found { if !decode_TurnGate(fv, &out.after) do return fail("WheneverEventExpiry::UntilControllersNextTurn.after") } else { return fail("WheneverEventExpiry::UntilControllersNextTurn.after missing") }
	return true
		}) { return fail("WheneverEventExpiry::UntilControllersNextTurn") }
		out^ = tmp
	case: return fail("WheneverEventExpiry: unknown variant")
	}
	return true
}

encode_WheneverEventExpiry :: proc(b: ^strings.Builder, x: WheneverEventExpiry) {
	#partial switch y in x {
	case WheneverEventExpiry_EndOfTurn: _ = y; json.write_string(b, "EndOfTurn")
	case WheneverEventExpiry_UntilControllersNextTurn: strings.write_byte(b, '{'); json.write_string(b, "UntilControllersNextTurn"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "after"); encode_TurnGate(b, y.after)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	}
}

decode_DelayedTriggerLifetime :: proc(v: json.Value, out: ^DelayedTriggerLifetime) -> bool {
	if v.kind != .String do return fail("DelayedTriggerLifetime: not a string")
	str := v.text
	switch str {
	case "ThisTurn": out^ = .ThisTurn
	case "Persistent": out^ = .Persistent
	case "Reflexive": out^ = .Reflexive
	case: return fail("DelayedTriggerLifetime: unknown variant")
	}
	return true
}

encode_DelayedTriggerLifetime :: proc(b: ^strings.Builder, x: DelayedTriggerLifetime) {
	@(static, rodata) NAMES := [DelayedTriggerLifetime]string{
		.ThisTurn = "ThisTurn",
		.Persistent = "Persistent",
		.Reflexive = "Reflexive",
	}
	json.write_string(b, NAMES[x])
}

decode_RestrictionScope :: proc(v: json.Value, out: ^RestrictionScope) -> bool {
	if v.kind != .Object do return fail("RestrictionScope: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("RestrictionScope: no tag")
	switch tv.text {
	case "SourcesControlledBy": tmp: RestrictionScope_SourcesControlledBy; if !decode_PlayerId(json.get_or_null(v, "data"), &tmp._0) do return fail("RestrictionScope::SourcesControlledBy"); out^ = tmp
	case "SpecificSource": tmp: RestrictionScope_SpecificSource; if !decode_ObjectId(json.get_or_null(v, "data"), &tmp._0) do return fail("RestrictionScope::SpecificSource"); out^ = tmp
	case "DamageToTarget": tmp: RestrictionScope_DamageToTarget; if !decode_ObjectId(json.get_or_null(v, "data"), &tmp._0) do return fail("RestrictionScope::DamageToTarget"); out^ = tmp
	case: return fail("RestrictionScope: unknown variant")
	}
	return true
}

encode_RestrictionScope :: proc(b: ^strings.Builder, x: RestrictionScope) {
	#partial switch y in x {
	case RestrictionScope_SourcesControlledBy: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourcesControlledBy"); member(b, &f, "data"); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	case RestrictionScope_SpecificSource: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SpecificSource"); member(b, &f, "data"); encode_ObjectId(b, y._0); strings.write_byte(b, '}')
	case RestrictionScope_DamageToTarget: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DamageToTarget"); member(b, &f, "data"); encode_ObjectId(b, y._0); strings.write_byte(b, '}')
	}
}

decode_RestrictionPlayerScope :: proc(v: json.Value, out: ^RestrictionPlayerScope) -> bool {
	if v.kind != .Object do return fail("RestrictionPlayerScope: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("RestrictionPlayerScope: no tag")
	switch tv.text {
	case "AllPlayers": out^ = RestrictionPlayerScope_AllPlayers{}
	case "SpecificPlayer": tmp: RestrictionPlayerScope_SpecificPlayer; if !decode_PlayerId(json.get_or_null(v, "data"), &tmp._0) do return fail("RestrictionPlayerScope::SpecificPlayer"); out^ = tmp
	case "TargetedPlayer": out^ = RestrictionPlayerScope_TargetedPlayer{}
	case "ParentTargetedPlayer": out^ = RestrictionPlayerScope_ParentTargetedPlayer{}
	case "ParentObjectTargetController": out^ = RestrictionPlayerScope_ParentObjectTargetController{}
	case "OpponentsOfSourceController": out^ = RestrictionPlayerScope_OpponentsOfSourceController{}
	case "DefendingPlayer": out^ = RestrictionPlayerScope_DefendingPlayer{}
	case "ScopedPlayer": out^ = RestrictionPlayerScope_ScopedPlayer{}
	case "SourceController": out^ = RestrictionPlayerScope_SourceController{}
	case: return fail("RestrictionPlayerScope: unknown variant")
	}
	return true
}

encode_RestrictionPlayerScope :: proc(b: ^strings.Builder, x: RestrictionPlayerScope) {
	#partial switch y in x {
	case RestrictionPlayerScope_AllPlayers: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AllPlayers"); strings.write_byte(b, '}')
	case RestrictionPlayerScope_SpecificPlayer: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SpecificPlayer"); member(b, &f, "data"); encode_PlayerId(b, y._0); strings.write_byte(b, '}')
	case RestrictionPlayerScope_TargetedPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "TargetedPlayer"); strings.write_byte(b, '}')
	case RestrictionPlayerScope_ParentTargetedPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ParentTargetedPlayer"); strings.write_byte(b, '}')
	case RestrictionPlayerScope_ParentObjectTargetController: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ParentObjectTargetController"); strings.write_byte(b, '}')
	case RestrictionPlayerScope_OpponentsOfSourceController: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OpponentsOfSourceController"); strings.write_byte(b, '}')
	case RestrictionPlayerScope_DefendingPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DefendingPlayer"); strings.write_byte(b, '}')
	case RestrictionPlayerScope_ScopedPlayer: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ScopedPlayer"); strings.write_byte(b, '}')
	case RestrictionPlayerScope_SourceController: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SourceController"); strings.write_byte(b, '}')
	}
}

decode_ProhibitedActivity :: proc(v: json.Value, out: ^ProhibitedActivity) -> bool {
	if v.kind != .Object do return fail("ProhibitedActivity: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ProhibitedActivity: no tag")
	switch tv.text {
	case "CastOnlyFromZones":
		tmp: ProhibitedActivity_CastOnlyFromZones
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ProhibitedActivity_CastOnlyFromZones) -> bool {
	if fv, found := get_any(v, "allowed_zones"); found { if !dec_dyn_Zone(fv, &out.allowed_zones) do return fail("ProhibitedActivity::CastOnlyFromZones.allowed_zones") } else { return fail("ProhibitedActivity::CastOnlyFromZones.allowed_zones missing") }
	return true
		}) { return fail("ProhibitedActivity::CastOnlyFromZones") }
		out^ = tmp
	case "CastSpells":
		tmp: ProhibitedActivity_CastSpells
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ProhibitedActivity_CastSpells) -> bool {
	if fv, found := get_any(v, "spell_filter"); found { if !dec_opt_TargetFilter(fv, &out.spell_filter) do return fail("ProhibitedActivity::CastSpells.spell_filter") }
	return true
		}) { return fail("ProhibitedActivity::CastSpells") }
		out^ = tmp
	case "ActivateAbilities":
		tmp: ProhibitedActivity_ActivateAbilities
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ProhibitedActivity_ActivateAbilities) -> bool {
	if fv, found := get_any(v, "exemption"); found { if !decode_ActivationExemption(fv, &out.exemption) do return fail("ProhibitedActivity::ActivateAbilities.exemption") } else { return fail("ProhibitedActivity::ActivateAbilities.exemption missing") }
	if fv, found := get_any(v, "only_tag"); found { if !dec_opt_AbilityTag(fv, &out.only_tag) do return fail("ProhibitedActivity::ActivateAbilities.only_tag") }
	return true
		}) { return fail("ProhibitedActivity::ActivateAbilities") }
		out^ = tmp
	case "Attack":
		tmp: ProhibitedActivity_Attack
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ProhibitedActivity_Attack) -> bool {
	if fv, found := get_any(v, "defended"); found { if !decode_AttackTargetFilter(fv, &out.defended) do return fail("ProhibitedActivity::Attack.defended") } else { return fail("ProhibitedActivity::Attack.defended missing") }
	if fv, found := get_any(v, "protected_player"); found { if !dec_opt_PlayerId(fv, &out.protected_player) do return fail("ProhibitedActivity::Attack.protected_player") }
	if fv, found := get_any(v, "protected_scope"); found { if !dec_opt_RestrictionPlayerScope(fv, &out.protected_scope) do return fail("ProhibitedActivity::Attack.protected_scope") }
	return true
		}) { return fail("ProhibitedActivity::Attack") }
		out^ = tmp
	case "ProhibitPlayFromZone":
		tmp: ProhibitedActivity_ProhibitPlayFromZone
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ProhibitedActivity_ProhibitPlayFromZone) -> bool {
	if fv, found := get_any(v, "zone"); found { if !decode_Zone(fv, &out.zone) do return fail("ProhibitedActivity::ProhibitPlayFromZone.zone") } else { return fail("ProhibitedActivity::ProhibitPlayFromZone.zone missing") }
	return true
		}) { return fail("ProhibitedActivity::ProhibitPlayFromZone") }
		out^ = tmp
	case "PlayLands":
		tmp: ProhibitedActivity_PlayLands
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ProhibitedActivity_PlayLands) -> bool {
	if fv, found := get_any(v, "land_filter"); found { if !dec_opt_TargetFilter(fv, &out.land_filter) do return fail("ProhibitedActivity::PlayLands.land_filter") }
	return true
		}) { return fail("ProhibitedActivity::PlayLands") }
		out^ = tmp
	case: return fail("ProhibitedActivity: unknown variant")
	}
	return true
}

encode_ProhibitedActivity :: proc(b: ^strings.Builder, x: ProhibitedActivity) {
	#partial switch y in x {
	case ProhibitedActivity_CastOnlyFromZones: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastOnlyFromZones")
	member(b, first, "allowed_zones"); enc_dyn_Zone(b, y.allowed_zones)
	}; strings.write_byte(b, '}')
	case ProhibitedActivity_CastSpells: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "CastSpells")
	if !(y.spell_filter == nil) { member(b, first, "spell_filter"); enc_opt_TargetFilter(b, y.spell_filter) }
	}; strings.write_byte(b, '}')
	case ProhibitedActivity_ActivateAbilities: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ActivateAbilities")
	member(b, first, "exemption"); encode_ActivationExemption(b, y.exemption)
	if !(y.only_tag == nil) { member(b, first, "only_tag"); enc_opt_AbilityTag(b, y.only_tag) }
	}; strings.write_byte(b, '}')
	case ProhibitedActivity_Attack: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "Attack")
	member(b, first, "defended"); encode_AttackTargetFilter(b, y.defended)
	if !(y.protected_player == nil) { member(b, first, "protected_player"); enc_opt_PlayerId(b, y.protected_player) }
	if !(y.protected_scope == nil) { member(b, first, "protected_scope"); enc_opt_RestrictionPlayerScope(b, y.protected_scope) }
	}; strings.write_byte(b, '}')
	case ProhibitedActivity_ProhibitPlayFromZone: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "ProhibitPlayFromZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	}; strings.write_byte(b, '}')
	case ProhibitedActivity_PlayLands: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "PlayLands")
	if !(y.land_filter == nil) { member(b, first, "land_filter"); enc_opt_TargetFilter(b, y.land_filter) }
	}; strings.write_byte(b, '}')
	}
}

encode_ProhibitedActivity_members :: proc(b: ^strings.Builder, x: ProhibitedActivity, first: ^bool) {
	#partial switch y in x {
	case ProhibitedActivity_CastOnlyFromZones: member(b, first, "type"); json.write_string(b, "CastOnlyFromZones")
	member(b, first, "allowed_zones"); enc_dyn_Zone(b, y.allowed_zones)

	case ProhibitedActivity_CastSpells: member(b, first, "type"); json.write_string(b, "CastSpells")
	if !(y.spell_filter == nil) { member(b, first, "spell_filter"); enc_opt_TargetFilter(b, y.spell_filter) }

	case ProhibitedActivity_ActivateAbilities: member(b, first, "type"); json.write_string(b, "ActivateAbilities")
	member(b, first, "exemption"); encode_ActivationExemption(b, y.exemption)
	if !(y.only_tag == nil) { member(b, first, "only_tag"); enc_opt_AbilityTag(b, y.only_tag) }

	case ProhibitedActivity_Attack: member(b, first, "type"); json.write_string(b, "Attack")
	member(b, first, "defended"); encode_AttackTargetFilter(b, y.defended)
	if !(y.protected_player == nil) { member(b, first, "protected_player"); enc_opt_PlayerId(b, y.protected_player) }
	if !(y.protected_scope == nil) { member(b, first, "protected_scope"); enc_opt_RestrictionPlayerScope(b, y.protected_scope) }

	case ProhibitedActivity_ProhibitPlayFromZone: member(b, first, "type"); json.write_string(b, "ProhibitPlayFromZone")
	member(b, first, "zone"); encode_Zone(b, y.zone)

	case ProhibitedActivity_PlayLands: member(b, first, "type"); json.write_string(b, "PlayLands")
	if !(y.land_filter == nil) { member(b, first, "land_filter"); enc_opt_TargetFilter(b, y.land_filter) }

	}
}

decode_ResolutionCastWindow :: proc(v: json.Value, out: ^ResolutionCastWindow) -> bool {
	if v.kind != .Object do return fail("ResolutionCastWindow: not an object")
	if fv, found := get_any(v, "max_casts"); found { if !dec_opt_u8(fv, &out.max_casts) do return fail("ResolutionCastWindow.max_casts") }
	if fv, found := get_any(v, "max_total_mv"); found { if !dec_opt_u32(fv, &out.max_total_mv) do return fail("ResolutionCastWindow.max_total_mv") }
	return true
}

encode_ResolutionCastWindow :: proc(b: ^strings.Builder, x: ResolutionCastWindow) {
	strings.write_byte(b, '{')
	f := true
	encode_ResolutionCastWindow_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ResolutionCastWindow_members :: proc(b: ^strings.Builder, x: ResolutionCastWindow, first: ^bool) {
	if !(x.max_casts == nil) { member(b, first, "max_casts"); enc_opt_u8(b, x.max_casts) }
	if !(x.max_total_mv == nil) { member(b, first, "max_total_mv"); enc_opt_u32(b, x.max_total_mv) }
}

