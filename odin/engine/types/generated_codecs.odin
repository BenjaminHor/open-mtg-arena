	f := true
	encode_ResolvedCommandJournalEntry_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ResolvedCommandJournalEntry_members :: proc(b: ^strings.Builder, x: ResolvedCommandJournalEntry, first: ^bool) {
	member(b, first, "ordinal"); encode_ResolvedCommandOrdinal(b, x.ordinal)
	member(b, first, "node"); encode_RulesExecutionNodeRef(b, x.node)
	if !(x.command == nil) { member(b, first, "command"); enc_opt_ResolvedRulesCommand(b, x.command) }
}

decode_SettlementNode :: proc(v: json.Value, out: ^SettlementNode) -> bool {
	when COVERAGE do cov_hit("SettlementNode")
	if v.kind != .Object do return fail("SettlementNode: not an object")
	if fv, found := get_any(v, "ordinal"); found { if !decode_SettlementNodeOrdinal(fv, &out.ordinal) do return fail("SettlementNode.ordinal") } else { return fail("SettlementNode.ordinal missing") }
	if fv, found := get_any(v, "identity"); found { if !decode_RulesExecutionNodeRef(fv, &out.identity) do return fail("SettlementNode.identity") } else { return fail("SettlementNode.identity missing") }
	if fv, found := get_any(v, "kind"); found { if !decode_RulesExecutionNodeKind(fv, &out.kind) do return fail("SettlementNode.kind") } else { return fail("SettlementNode.kind missing") }
	if fv, found := get_any(v, "caused_by"); found { if !dec_opt_RulesExecutionNodeRef(fv, &out.caused_by) do return fail("SettlementNode.caused_by") }
	if fv, found := get_any(v, "depends_on"); found { if !dec_dyn_RulesExecutionNodeRef(fv, &out.depends_on) do return fail("SettlementNode.depends_on") }
	if fv, found := get_any(v, "bundle_parent"); found { if !dec_opt_RulesExecutionNodeRef(fv, &out.bundle_parent) do return fail("SettlementNode.bundle_parent") }
	if fv, found := get_any(v, "produced_pips"); found { if !dec_dyn_ManaPipId(fv, &out.produced_pips) do return fail("SettlementNode.produced_pips") }
	if fv, found := get_any(v, "spent_pips"); found { if !dec_dyn_ManaPipId(fv, &out.spent_pips) do return fail("SettlementNode.spent_pips") }
	if fv, found := get_any(v, "journal_ordinals"); found { if !dec_dyn_ResolvedCommandOrdinal(fv, &out.journal_ordinals) do return fail("SettlementNode.journal_ordinals") }
	return true
}

encode_SettlementNode :: proc(b: ^strings.Builder, x: SettlementNode) {
	strings.write_byte(b, '{')
	f := true
	encode_SettlementNode_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_SettlementNode_members :: proc(b: ^strings.Builder, x: SettlementNode, first: ^bool) {
	member(b, first, "ordinal"); encode_SettlementNodeOrdinal(b, x.ordinal)
	member(b, first, "identity"); encode_RulesExecutionNodeRef(b, x.identity)
	member(b, first, "kind"); encode_RulesExecutionNodeKind(b, x.kind)
	if !(x.caused_by == nil) { member(b, first, "caused_by"); enc_opt_RulesExecutionNodeRef(b, x.caused_by) }
	if !((len(x.depends_on) == 0)) { member(b, first, "depends_on"); enc_dyn_RulesExecutionNodeRef(b, x.depends_on) }
	if !(x.bundle_parent == nil) { member(b, first, "bundle_parent"); enc_opt_RulesExecutionNodeRef(b, x.bundle_parent) }
	if !((len(x.produced_pips) == 0)) { member(b, first, "produced_pips"); enc_dyn_ManaPipId(b, x.produced_pips) }
	if !((len(x.spent_pips) == 0)) { member(b, first, "spent_pips"); enc_dyn_ManaPipId(b, x.spent_pips) }
	if !((len(x.journal_ordinals) == 0)) { member(b, first, "journal_ordinals"); enc_dyn_ResolvedCommandOrdinal(b, x.journal_ordinals) }
}

