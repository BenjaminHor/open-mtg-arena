encode_DeclaredPlayerTargetSlot_members :: proc(b: ^strings.Builder, x: DeclaredPlayerTargetSlot, first: ^bool) {
	member(b, first, "declared_position"); encode_int(b, x.declared_position)
	member(b, first, "stored_position"); enc_opt_int(b, x.stored_position)
}

decode_AbilityKind :: proc(v: json.Value, out: ^AbilityKind) -> bool {
	when COVERAGE do cov_hit("AbilityKind")
	if v.kind != .String do return fail("AbilityKind: not a string")
	str := v.text
	switch str {
	case "Spell": when COVERAGE do cov_hit("AbilityKind::Spell"); out^ = .Spell
	case "Activated": when COVERAGE do cov_hit("AbilityKind::Activated"); out^ = .Activated
	case "Database": when COVERAGE do cov_hit("AbilityKind::Database"); out^ = .Database
	case "BeginGame": when COVERAGE do cov_hit("AbilityKind::BeginGame"); out^ = .BeginGame
	case "Mulligan": when COVERAGE do cov_hit("AbilityKind::Mulligan"); out^ = .Mulligan
	case: return fail("AbilityKind: unknown variant")
	}
	return true
}

encode_AbilityKind :: proc(b: ^strings.Builder, x: AbilityKind) {
	@(static, rodata) NAMES := [AbilityKind]string{
		.Spell = "Spell",
		.Activated = "Activated",
		.Database = "Database",
		.BeginGame = "BeginGame",
		.Mulligan = "Mulligan",
	}
	json.write_string(b, NAMES[x])
}

decode_ResolvedCoinBranches :: proc(v: json.Value, out: ^ResolvedCoinBranches) -> bool {
	when COVERAGE do cov_hit("ResolvedCoinBranches")
	if v.kind != .Object do return fail("ResolvedCoinBranches: not an object")
	if fv, found := get_any(v, "won"); found { if !dec_opt_ResolvedAbility(fv, &out.won) do return fail("ResolvedCoinBranches.won") }
	if fv, found := get_any(v, "lost"); found { if !dec_opt_ResolvedAbility(fv, &out.lost) do return fail("ResolvedCoinBranches.lost") }
	return true
}

encode_ResolvedCoinBranches :: proc(b: ^strings.Builder, x: ResolvedCoinBranches) {
	strings.write_byte(b, '{')
	f := true
	encode_ResolvedCoinBranches_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ResolvedCoinBranches_members :: proc(b: ^strings.Builder, x: ResolvedCoinBranches, first: ^bool) {
	if !(x.won == nil) { member(b, first, "won"); enc_opt_ResolvedAbility(b, x.won) }
	if !(x.lost == nil) { member(b, first, "lost"); enc_opt_ResolvedAbility(b, x.lost) }
}

decode_AbilityCondition :: proc(v: json.Value, out: ^AbilityCondition) -> bool {
	when COVERAGE do cov_hit("AbilityCondition")
	if v.kind != .Object do return fail("AbilityCondition: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("AbilityCondition: no tag")
	switch tv.text {
	case "TriggerEventTargetDamagedBySourceThisTurn": when COVERAGE do cov_hit("AbilityCondition::TriggerEventTargetDamagedBySourceThisTurn"); out^ = AbilityCondition_TriggerEventTargetDamagedBySourceThisTurn{}
	case "TriggerEventTargetExploitedBySource": when COVERAGE do cov_hit("AbilityCondition::TriggerEventTargetExploitedBySource"); out^ = AbilityCondition_TriggerEventTargetExploitedBySource{}
	case "AdditionalCostPaid": when COVERAGE do cov_hit("AbilityCondition::AdditionalCostPaid");
		tmp: AbilityCondition_AdditionalCostPaid
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_AdditionalCostPaid) -> bool {
	if fv, found := get_any(v, "subject"); found { if !decode_ObjectScope(fv, &out.subject) do return fail("AbilityCondition::AdditionalCostPaid.subject") } else { out.subject = default_AbilityCondition_AbilityCondition_default_subject_source() }
	if fv, found := get_any(v, "source"); found { if !decode_AdditionalCostPaymentSource(fv, &out.source) do return fail("AbilityCondition::AdditionalCostPaid.source") }
	if fv, found := get_any(v, "origin"); found { if !dec_opt_AdditionalCostOrigin(fv, &out.origin) do return fail("AbilityCondition::AdditionalCostPaid.origin") }
	if fv, found := get_any(v, "origin_ordinal"); found { if !dec_opt_u32(fv, &out.origin_ordinal) do return fail("AbilityCondition::AdditionalCostPaid.origin_ordinal") }
	if fv, found := get_any(v, "variant"); found { if !dec_opt_KickerVariant(fv, &out.variant) do return fail("AbilityCondition::AdditionalCostPaid.variant") }
	if fv, found := get_any(v, "kicker_cost"); found { if !dec_opt_ManaCost(fv, &out.kicker_cost) do return fail("AbilityCondition::AdditionalCostPaid.kicker_cost") }
	if fv, found := get_any(v, "min_count"); found { if !decode_u32(fv, &out.min_count) do return fail("AbilityCondition::AdditionalCostPaid.min_count") } else { out.min_count = default_AbilityCondition_AbilityCondition_default_min_count() }
	return true
		}) { return fail("AbilityCondition::AdditionalCostPaid") }
		out^ = tmp
	case "AdditionalCostPaidInstead": when COVERAGE do cov_hit("AbilityCondition::AdditionalCostPaidInstead"); out^ = AbilityCondition_AdditionalCostPaidInstead{}
	case "AlternativeManaCostPaid": when COVERAGE do cov_hit("AbilityCondition::AlternativeManaCostPaid"); out^ = AbilityCondition_AlternativeManaCostPaid{}
	case "EffectOutcome": when COVERAGE do cov_hit("AbilityCondition::EffectOutcome");
		tmp: AbilityCondition_EffectOutcome
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_EffectOutcome) -> bool {
	if fv, found := get_any(v, "signal"); found { if !decode_EffectOutcomeSignal(fv, &out.signal) do return fail("AbilityCondition::EffectOutcome.signal") } else { return fail("AbilityCondition::EffectOutcome.signal missing") }
	return true
		}) { return fail("AbilityCondition::EffectOutcome") }
		out^ = tmp
	case "EventOutcomeWon": when COVERAGE do cov_hit("AbilityCondition::EventOutcomeWon"); out^ = AbilityCondition_EventOutcomeWon{}
	case "CoinFlipOutcome": when COVERAGE do cov_hit("AbilityCondition::CoinFlipOutcome");
		tmp: AbilityCondition_CoinFlipOutcome
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_CoinFlipOutcome) -> bool {
	if fv, found := get_any(v, "result"); found { if !decode_CoinFlipResult(fv, &out.result) do return fail("AbilityCondition::CoinFlipOutcome.result") } else { return fail("AbilityCondition::CoinFlipOutcome.result missing") }
	return true
		}) { return fail("AbilityCondition::CoinFlipOutcome") }
		out^ = tmp
	case "ChosenLabelIs": when COVERAGE do cov_hit("AbilityCondition::ChosenLabelIs");
		tmp: AbilityCondition_ChosenLabelIs
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^AbilityCondition_ChosenLabelIs) -> bool {
	if fv, found := get_any(v, "label"); found { if !decode_string(fv, &out.label) do return fail("AbilityCondition::ChosenLabelIs.label") } else { return fail("AbilityCondition::ChosenLabelIs.label missing") }
	return true
		}) { return fail("AbilityCondition::ChosenLabelIs") }
		out^ = tmp
	case "WhenYouDo": when COVERAGE do cov_hit("AbilityCondition::WhenYouDo"); out^ = AbilityCondition_WhenYouDo{}
