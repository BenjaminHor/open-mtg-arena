	case "CopyValues": when COVERAGE do cov_hit("ContinuousModification::CopyValues");
		tmp: ContinuousModification_CopyValues
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_CopyValues) -> bool {
	if fv, found := get_any(v, "values"); found { if !dec_ptr_CopiableValues(fv, &out.values) do return fail("ContinuousModification::CopyValues.values") } else { return fail("ContinuousModification::CopyValues.values missing") }
	if !decode_DisplayIdentity(v, &out.display) do return fail("ContinuousModification::CopyValues.display (flattened)")
	return true
		}) { return fail("ContinuousModification::CopyValues") }
		out^ = tmp
	case "CopyChosen": when COVERAGE do cov_hit("ContinuousModification::CopyChosen"); out^ = ContinuousModification_CopyChosen{}
	case "SetName": when COVERAGE do cov_hit("ContinuousModification::SetName");
		tmp: ContinuousModification_SetName
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ContinuousModification_SetName) -> bool {
	if fv, found := get_any(v, "name"); found { if !decode_string(fv, &out.name) do return fail("ContinuousModification::SetName.name") } else { return fail("ContinuousModification::SetName.name missing") }
	return true
