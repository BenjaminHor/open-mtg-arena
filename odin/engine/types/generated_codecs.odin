decode_ContestState :: proc(v: json.Value, out: ^ContestState) -> bool {
	when COVERAGE do cov_hit("ContestState")
	if v.kind != .Object do return fail("ContestState: not an object")
	if fv, found := get_any(v, "id"); found { if !decode_u64(fv, &out.id) do return fail("ContestState.id") }
	if fv, found := get_any(v, "kind"); found { if !decode_ContestKind(fv, &out.kind) do return fail("ContestState.kind") } else { return fail("ContestState.kind missing") }
	if fv, found := get_any(v, "phase"); found { if !decode_ContestPhase(fv, &out.phase) do return fail("ContestState.phase") } else { return fail("ContestState.phase missing") }
	if fv, found := get_any(v, "config"); found { if !decode_ContestConfig(fv, &out.config) do return fail("ContestState.config") } else { return fail("ContestState.config missing") }
	if fv, found := get_any(v, "contestants"); found { if !dec__2_Contestant(fv, &out.contestants) do return fail("ContestState.contestants") } else { return fail("ContestState.contestants missing") }
	if fv, found := get_any(v, "clock_ms"); found { if !decode_u64(fv, &out.clock_ms) do return fail("ContestState.clock_ms") } else { return fail("ContestState.clock_ms missing") }
	if fv, found := get_any(v, "go_at_ms"); found { if !dec_opt_u64(fv, &out.go_at_ms) do return fail("ContestState.go_at_ms") }
	if fv, found := get_any(v, "paused_since_ms"); found { if !dec_opt_u64(fv, &out.paused_since_ms) do return fail("ContestState.paused_since_ms") }
	if fv, found := get_any(v, "result"); found { if !dec_opt_ContestResult(fv, &out.result) do return fail("ContestState.result") }
	return true
}

encode_ContestState :: proc(b: ^strings.Builder, x: ContestState) {
	strings.write_byte(b, '{')
	f := true
	encode_ContestState_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ContestState_members :: proc(b: ^strings.Builder, x: ContestState, first: ^bool) {
	member(b, first, "id"); encode_u64(b, x.id)
	member(b, first, "kind"); encode_ContestKind(b, x.kind)
	member(b, first, "phase"); encode_ContestPhase(b, x.phase)
	member(b, first, "config"); encode_ContestConfig(b, x.config)
	member(b, first, "contestants"); enc__2_Contestant(b, x.contestants)
	member(b, first, "clock_ms"); encode_u64(b, x.clock_ms)
	if !(x.go_at_ms == nil) { member(b, first, "go_at_ms"); enc_opt_u64(b, x.go_at_ms) }
	if !(x.paused_since_ms == nil) { member(b, first, "paused_since_ms"); enc_opt_u64(b, x.paused_since_ms) }
	if !(x.result == nil) { member(b, first, "result"); enc_opt_ContestResult(b, x.result) }
}

