	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_ManaExpended: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ManaExpended"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player_id"); encode_PlayerId(b, y.player_id)
	member(b, first, "amount_spent"); encode_u32(b, y.amount_spent)
	member(b, first, "new_cumulative"); encode_u32(b, y.new_cumulative)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case GameEvent_PhysicalContestStarted: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PhysicalContestStarted"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "kind"); encode_ContestKind(b, y.kind)
