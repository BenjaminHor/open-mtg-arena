	return true
		}) { return fail("ManaProduction::AnyOneColor") }
		out^ = tmp
	case "AnyCombination": when COVERAGE do cov_hit("ManaProduction::AnyCombination");
		tmp: ManaProduction_AnyCombination
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ManaProduction_AnyCombination) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("ManaProduction::AnyCombination.count") } else { out.count = default_ManaProduction_default_quantity_one() }
	if fv, found := get_any(v, "color_options"); found { if !dec_dyn_ManaColor(fv, &out.color_options) do return fail("ManaProduction::AnyCombination.color_options") } else { out.color_options = default_ManaProduction_default_all_mana_colors() }
	return true
		}) { return fail("ManaProduction::AnyCombination") }
		out^ = tmp
	case "ChosenColor": when COVERAGE do cov_hit("ManaProduction::ChosenColor");
		tmp: ManaProduction_ChosenColor
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ManaProduction_ChosenColor) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("ManaProduction::ChosenColor.count") } else { out.count = default_ManaProduction_default_quantity_one() }
	if fv, found := get_any(v, "contribution"); found { if !decode_ManaContribution(fv, &out.contribution) do return fail("ManaProduction::ChosenColor.contribution") } else { out.contribution = default_ManaProduction_default_mana_contribution() }
	if fv, found := get_any(v, "fixed_alternative"); found { if !dec_opt_ManaColor(fv, &out.fixed_alternative) do return fail("ManaProduction::ChosenColor.fixed_alternative") }
	return true
		}) { return fail("ManaProduction::ChosenColor") }
		out^ = tmp
	case "NotedType": when COVERAGE do cov_hit("ManaProduction::NotedType");
		tmp: ManaProduction_NotedType
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ManaProduction_NotedType) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("ManaProduction::NotedType.count") } else { out.count = default_ManaProduction_default_quantity_one() }
	return true
		}) { return fail("ManaProduction::NotedType") }
		out^ = tmp
	case "OpponentLandColors": when COVERAGE do cov_hit("ManaProduction::OpponentLandColors");
		tmp: ManaProduction_OpponentLandColors
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ManaProduction_OpponentLandColors) -> bool {
	if fv, found := get_any(v, "count"); found { if !decode_QuantityExpr(fv, &out.count) do return fail("ManaProduction::OpponentLandColors.count") } else { out.count = default_ManaProduction_default_quantity_one() }
	return true
		}) { return fail("ManaProduction::OpponentLandColors") }
		out^ = tmp
	case "AnyCombinationOfObjectColors": when COVERAGE do cov_hit("ManaProduction::AnyCombinationOfObjectColors");
		tmp: ManaProduction_AnyCombinationOfObjectColors
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ManaProduction_AnyCombinationOfObjectColors) -> bool {
