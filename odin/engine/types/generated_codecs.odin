decode_ResolutionCastSuccessAction :: proc(v: json.Value, out: ^ResolutionCastSuccessAction) -> bool {
	if v.kind != .Object do return fail("ResolutionCastSuccessAction: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ResolutionCastSuccessAction: no tag")
	switch tv.text {
	case "BottomMisses": out^ = ResolutionCastSuccessAction_BottomMisses{}
	case "RippleOfferRemaining":
		tmp: ResolutionCastSuccessAction_RippleOfferRemaining
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ResolutionCastSuccessAction_RippleOfferRemaining) -> bool {
	if fv, found := get_any(v, "remaining_hits"); found { if !dec_dyn_ObjectId(fv, &out.remaining_hits) do return fail("ResolutionCastSuccessAction::RippleOfferRemaining.remaining_hits") } else { return fail("ResolutionCastSuccessAction::RippleOfferRemaining.remaining_hits missing") }
	return true
		}) { return fail("ResolutionCastSuccessAction::RippleOfferRemaining") }
		out^ = tmp
	case "FreeCastOfferRemaining":
		tmp: ResolutionCastSuccessAction_FreeCastOfferRemaining
		if !decode_variant(v, &tmp, proc(v: json.Value, out: ^ResolutionCastSuccessAction_FreeCastOfferRemaining) -> bool {
	if fv, found := get_any(v, "controller"); found { if !decode_PlayerId(fv, &out.controller) do return fail("ResolutionCastSuccessAction::FreeCastOfferRemaining.controller") } else { return fail("ResolutionCastSuccessAction::FreeCastOfferRemaining.controller missing") }
	if fv, found := get_any(v, "remaining_casts"); found { if !dec_opt_u8(fv, &out.remaining_casts) do return fail("ResolutionCastSuccessAction::FreeCastOfferRemaining.remaining_casts") }
	if fv, found := get_any(v, "remaining_mv_budget"); found { if !dec_opt_u32(fv, &out.remaining_mv_budget) do return fail("ResolutionCastSuccessAction::FreeCastOfferRemaining.remaining_mv_budget") }
	if fv, found := get_any(v, "face_policy"); found { if !dec_ptr_ResolutionCastFacePolicy(fv, &out.face_policy) do return fail("ResolutionCastSuccessAction::FreeCastOfferRemaining.face_policy") } else { return fail("ResolutionCastSuccessAction::FreeCastOfferRemaining.face_policy missing") }
	if fv, found := get_any(v, "zones"); found { if !dec_dyn_Zone(fv, &out.zones) do return fail("ResolutionCastSuccessAction::FreeCastOfferRemaining.zones") } else { return fail("ResolutionCastSuccessAction::FreeCastOfferRemaining.zones missing") }
	if fv, found := get_any(v, "graveyard_replacement", "exile_instead_of_graveyard"); found { if !dec_opt_SpellStackToGraveyardReplacement(fv, &out.graveyard_replacement) do return fail("ResolutionCastSuccessAction::FreeCastOfferRemaining.graveyard_replacement") }
	if fv, found := get_any(v, "enters_with_modifications"); found { if !decode_PendingEntersModifications(fv, &out.enters_with_modifications) do return fail("ResolutionCastSuccessAction::FreeCastOfferRemaining.enters_with_modifications") }
	if fv, found := get_any(v, "member_pool"); found { if !dec_dyn_ObjectId(fv, &out.member_pool) do return fail("ResolutionCastSuccessAction::FreeCastOfferRemaining.member_pool") }
	return true
		}) { return fail("ResolutionCastSuccessAction::FreeCastOfferRemaining") }
		out^ = tmp
	case: return fail("ResolutionCastSuccessAction: unknown variant")
	}
	return true
}

encode_ResolutionCastSuccessAction :: proc(b: ^strings.Builder, x: ResolutionCastSuccessAction) {
	#partial switch y in x {
	case ResolutionCastSuccessAction_BottomMisses: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BottomMisses"); strings.write_byte(b, '}')
	case ResolutionCastSuccessAction_RippleOfferRemaining: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "RippleOfferRemaining")
	member(b, first, "remaining_hits"); enc_dyn_ObjectId(b, y.remaining_hits)
	}; strings.write_byte(b, '}')
	case ResolutionCastSuccessAction_FreeCastOfferRemaining: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "FreeCastOfferRemaining")
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	if !(y.remaining_casts == nil) { member(b, first, "remaining_casts"); enc_opt_u8(b, y.remaining_casts) }
	if !(y.remaining_mv_budget == nil) { member(b, first, "remaining_mv_budget"); enc_opt_u32(b, y.remaining_mv_budget) }
	member(b, first, "face_policy"); enc_ptr_ResolutionCastFacePolicy(b, y.face_policy)
	member(b, first, "zones"); enc_dyn_Zone(b, y.zones)
	if !(y.graveyard_replacement == nil) { member(b, first, "graveyard_replacement"); enc_opt_SpellStackToGraveyardReplacement(b, y.graveyard_replacement) }
	if !(skip_ResolutionCastSuccessAction_PendingEntersModifications_is_empty(y.enters_with_modifications)) { member(b, first, "enters_with_modifications"); encode_PendingEntersModifications(b, y.enters_with_modifications) }
	if !(len(y.member_pool) == 0) { member(b, first, "member_pool"); enc_dyn_ObjectId(b, y.member_pool) }
	}; strings.write_byte(b, '}')
	}
}

encode_ResolutionCastSuccessAction_members :: proc(b: ^strings.Builder, x: ResolutionCastSuccessAction, first: ^bool) {
	#partial switch y in x {
	case ResolutionCastSuccessAction_BottomMisses: _ = y; member(b, first, "type"); json.write_string(b, "BottomMisses")
	case ResolutionCastSuccessAction_RippleOfferRemaining: member(b, first, "type"); json.write_string(b, "RippleOfferRemaining")
	member(b, first, "remaining_hits"); enc_dyn_ObjectId(b, y.remaining_hits)

	case ResolutionCastSuccessAction_FreeCastOfferRemaining: member(b, first, "type"); json.write_string(b, "FreeCastOfferRemaining")
	member(b, first, "controller"); encode_PlayerId(b, y.controller)
	if !(y.remaining_casts == nil) { member(b, first, "remaining_casts"); enc_opt_u8(b, y.remaining_casts) }
	if !(y.remaining_mv_budget == nil) { member(b, first, "remaining_mv_budget"); enc_opt_u32(b, y.remaining_mv_budget) }
	member(b, first, "face_policy"); enc_ptr_ResolutionCastFacePolicy(b, y.face_policy)
	member(b, first, "zones"); enc_dyn_Zone(b, y.zones)
	if !(y.graveyard_replacement == nil) { member(b, first, "graveyard_replacement"); enc_opt_SpellStackToGraveyardReplacement(b, y.graveyard_replacement) }
	if !(skip_ResolutionCastSuccessAction_PendingEntersModifications_is_empty(y.enters_with_modifications)) { member(b, first, "enters_with_modifications"); encode_PendingEntersModifications(b, y.enters_with_modifications) }
	if !(len(y.member_pool) == 0) { member(b, first, "member_pool"); enc_dyn_ObjectId(b, y.member_pool) }

	}
}

decode_ResolutionCastDelayedTriggerReceipt :: proc(v: json.Value, out: ^ResolutionCastDelayedTriggerReceipt) -> bool {
	if v.kind != .Object do return fail("ResolutionCastDelayedTriggerReceipt: not an object")
	if fv, found := get_any(v, "offer_id"); found { if !decode_ResolutionCastOfferId(fv, &out.offer_id) do return fail("ResolutionCastDelayedTriggerReceipt.offer_id") } else { return fail("ResolutionCastDelayedTriggerReceipt.offer_id missing") }
	if fv, found := get_any(v, "token"); found { if !decode_DelayedTriggerToken(fv, &out.token) do return fail("ResolutionCastDelayedTriggerReceipt.token") } else { return fail("ResolutionCastDelayedTriggerReceipt.token missing") }
	if fv, found := get_any(v, "instance"); found { if !decode_DelayedTriggerInstanceId(fv, &out.instance) do return fail("ResolutionCastDelayedTriggerReceipt.instance") } else { return fail("ResolutionCastDelayedTriggerReceipt.instance missing") }
	if fv, found := get_any(v, "source_id"); found { if !decode_ObjectId(fv, &out.source_id) do return fail("ResolutionCastDelayedTriggerReceipt.source_id") } else { return fail("ResolutionCastDelayedTriggerReceipt.source_id missing") }
	return true
}

encode_ResolutionCastDelayedTriggerReceipt :: proc(b: ^strings.Builder, x: ResolutionCastDelayedTriggerReceipt) {
	strings.write_byte(b, '{')
	f := true
	encode_ResolutionCastDelayedTriggerReceipt_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ResolutionCastDelayedTriggerReceipt_members :: proc(b: ^strings.Builder, x: ResolutionCastDelayedTriggerReceipt, first: ^bool) {
	member(b, first, "offer_id"); encode_ResolutionCastOfferId(b, x.offer_id)
	member(b, first, "token"); encode_DelayedTriggerToken(b, x.token)
	member(b, first, "instance"); encode_DelayedTriggerInstanceId(b, x.instance)
	member(b, first, "source_id"); encode_ObjectId(b, x.source_id)
}

