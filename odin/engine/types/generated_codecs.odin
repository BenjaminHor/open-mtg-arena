	member(b, first, "color"); enc_opt_ManaColor(b, y.color)
	member(b, first, "comparator"); encode_Comparator(b, y.comparator)
	member(b, first, "value"); encode_i32(b, y.value)
	}; strings.write_byte(b, '}')
	case FilterProp_HasSupertype: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "HasSupertype")
	member(b, first, "value"); encode_Supertype(b, y.value)
	}; strings.write_byte(b, '}')
	case FilterProp_IsChosenCreatureType: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "IsChosenCreatureType"); strings.write_byte(b, '}')
	case FilterProp_MostPrevalentCreatureTypeIn: strings.write_byte(b, '{'); { fst := true; first := &fst; member(b, first, "type"); json.write_string(b, "MostPrevalentCreatureTypeIn")
	member(b, first, "zone"); encode_Zone(b, y.zone)
	member(b, first, "scope"); encode_ControllerRef(b, y.scope)
	}; strings.write_byte(b, '}')
	case FilterProp_IsChosenColor: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "IsChosenColor"); strings.write_byte(b, '}')
	case FilterProp_IsChosenCardType: _ = y; strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "IsChosenCardType"); strings.write_byte(b, '}')
