	if !((len(y.mode_labels) == 0)) { member(b, first, "mode_labels"); enc_dyn_opt_string(b, y.mode_labels) }
	member(b, first, "selection"); encode_TargetSelectionProgress(b, y.selection)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaitingFor_DeclareAttackers: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DeclareAttackers"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "valid_attacker_ids"); enc_dyn_ObjectId(b, y.valid_attacker_ids)
	member(b, first, "valid_attack_targets"); enc_dyn_AttackTarget(b, y.valid_attack_targets)
	if !(y.valid_attack_targets_by_attacker == nil) { member(b, first, "valid_attack_targets_by_attacker"); enc_opt_map_ObjectId_dyn_AttackTarget(b, y.valid_attack_targets_by_attacker) }
	if !((len(y.attacker_constraints) == 0)) { member(b, first, "attacker_constraints"); enc_map_ObjectId_CombatRequirement(b, y.attacker_constraints) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaitingFor_DeclareBlockers: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DeclareBlockers"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "valid_blocker_ids"); enc_dyn_ObjectId(b, y.valid_blocker_ids)
	member(b, first, "valid_block_targets"); enc_map_ObjectId_dyn_ObjectId(b, y.valid_block_targets)
	if !((len(y.block_requirements) == 0)) { member(b, first, "block_requirements"); enc_map_ObjectId_BlockRequirement(b, y.block_requirements) }
	if !((len(y.blocker_constraints) == 0)) { member(b, first, "blocker_constraints"); enc_map_ObjectId_CombatRequirement(b, y.blocker_constraints) }
	if !((len(y.must_be_blocked_targets) == 0)) { member(b, first, "must_be_blocked_targets"); enc_map_ObjectId_dyn_ObjectId(b, y.must_be_blocked_targets) }
	if !((len(y.block_capacities) == 0)) { member(b, first, "block_capacities"); enc_map_ObjectId_opt_u32(b, y.block_capacities) }
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case WaitingFor_UntapChoice: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "UntapChoice"); member(b, &f, "data"); strings.write_byte(b, '{'); { fst := true; first := &fst
