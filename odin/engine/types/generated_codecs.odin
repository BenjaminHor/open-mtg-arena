	if fv, found := get_any(v, "turn_zone_change_index"); found { if !decode_int(fv, &out.turn_zone_change_index) do return fail("ZoneChangeLibraryKnowledgeStamp.turn_zone_change_index") } else { return fail("ZoneChangeLibraryKnowledgeStamp.turn_zone_change_index missing") }
	if fv, found := get_any(v, "source"); found { if !dec_opt_LibraryKnowledgeStamp(fv, &out.source) do return fail("ZoneChangeLibraryKnowledgeStamp.source") }
	if fv, found := get_any(v, "destination"); found { if !dec_opt_LibraryKnowledgeStamp(fv, &out.destination) do return fail("ZoneChangeLibraryKnowledgeStamp.destination") }
	return true
}

encode_ZoneChangeLibraryKnowledgeStamp :: proc(b: ^strings.Builder, x: ZoneChangeLibraryKnowledgeStamp) {
	strings.write_byte(b, '{')
	f := true
	encode_ZoneChangeLibraryKnowledgeStamp_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ZoneChangeLibraryKnowledgeStamp_members :: proc(b: ^strings.Builder, x: ZoneChangeLibraryKnowledgeStamp, first: ^bool) {
	member(b, first, "recorded_turn_number"); encode_u32(b, x.recorded_turn_number)
	member(b, first, "turn_zone_change_index"); encode_int(b, x.turn_zone_change_index)
	if !(x.source == nil) { member(b, first, "source"); enc_opt_LibraryKnowledgeStamp(b, x.source) }
	if !(x.destination == nil) { member(b, first, "destination"); enc_opt_LibraryKnowledgeStamp(b, x.destination) }
}

decode_FrameVec :: proc(v: json.Value, out: ^FrameVec) -> bool {
	when COVERAGE do cov_hit("FrameVec")
	return dec_dyn_ResolutionFrame(v, &out.frames)
}

encode_FrameVec :: proc(b: ^strings.Builder, x: FrameVec) {
	enc_dyn_ResolutionFrame(b, x.frames)
}

decode_ResolutionFrame :: proc(v: json.Value, out: ^ResolutionFrame) -> bool {
	when COVERAGE do cov_hit("ResolutionFrame")
	if v.kind != .Object do return fail("ResolutionFrame: not an object")
	tv, found := json.get(v, "type")
	if !found || tv.kind != .String do return fail("ResolutionFrame: no tag")
	switch tv.text {
	case "AbilityContinuation": when COVERAGE do cov_hit("ResolutionFrame::AbilityContinuation"); tmp: ResolutionFrame_AbilityContinuation; if !decode_AbilityContinuationFrame(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::AbilityContinuation"); out^ = tmp
	case "RepeatFor": when COVERAGE do cov_hit("ResolutionFrame::RepeatFor"); tmp: ResolutionFrame_RepeatFor; if !decode_PendingRepeatIteration(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::RepeatFor"); out^ = tmp
	case "RepeatUntil": when COVERAGE do cov_hit("ResolutionFrame::RepeatUntil"); tmp: ResolutionFrame_RepeatUntil; if !decode_PendingRepeatUntil(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::RepeatUntil"); out^ = tmp
	case "RepeatedOptionalPayment": when COVERAGE do cov_hit("ResolutionFrame::RepeatedOptionalPayment"); tmp: ResolutionFrame_RepeatedOptionalPayment; if !decode_RepeatedOptionalPaymentFrame(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::RepeatedOptionalPayment"); out^ = tmp
	case "ChangeZone": when COVERAGE do cov_hit("ResolutionFrame::ChangeZone"); tmp: ResolutionFrame_ChangeZone; if !dec_ptr_ChangeZoneFrame(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::ChangeZone"); out^ = tmp
	case "BatchDelivery": when COVERAGE do cov_hit("ResolutionFrame::BatchDelivery"); tmp: ResolutionFrame_BatchDelivery; if !dec_ptr_PendingBatchDeliveries(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::BatchDelivery"); out^ = tmp
	case "CounterMoves": when COVERAGE do cov_hit("ResolutionFrame::CounterMoves"); tmp: ResolutionFrame_CounterMoves; if !decode_PendingCounterMoveQueue(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::CounterMoves"); out^ = tmp
	case "CounterRemovals": when COVERAGE do cov_hit("ResolutionFrame::CounterRemovals"); tmp: ResolutionFrame_CounterRemovals; if !decode_PendingCounterRemovalQueue(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::CounterRemovals"); out^ = tmp
	case "CounterAdditions": when COVERAGE do cov_hit("ResolutionFrame::CounterAdditions"); tmp: ResolutionFrame_CounterAdditions; if !decode_PendingCounterAdditionQueue(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::CounterAdditions"); out^ = tmp
	case "CopyToken": when COVERAGE do cov_hit("ResolutionFrame::CopyToken"); tmp: ResolutionFrame_CopyToken; if !decode_PendingCopyTokenResolution(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::CopyToken"); out^ = tmp
	case "DebugCardEntries": when COVERAGE do cov_hit("ResolutionFrame::DebugCardEntries"); tmp: ResolutionFrame_DebugCardEntries; if !dec_ptr_PendingDebugCardEntries(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::DebugCardEntries"); out^ = tmp
	case "EachPlayerCopyChosen": when COVERAGE do cov_hit("ResolutionFrame::EachPlayerCopyChosen"); tmp: ResolutionFrame_EachPlayerCopyChosen; if !decode_PendingEachPlayerCopyChosen(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::EachPlayerCopyChosen"); out^ = tmp
	case "ChooseOneOf": when COVERAGE do cov_hit("ResolutionFrame::ChooseOneOf"); tmp: ResolutionFrame_ChooseOneOf; if !decode_PendingChooseOneOf(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::ChooseOneOf"); out^ = tmp
	case "VoteBallot": when COVERAGE do cov_hit("ResolutionFrame::VoteBallot"); tmp: ResolutionFrame_VoteBallot; if !decode_PendingVoteBallotIteration(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::VoteBallot"); out^ = tmp
	case "PerPlayerZoneChoice": when COVERAGE do cov_hit("ResolutionFrame::PerPlayerZoneChoice"); tmp: ResolutionFrame_PerPlayerZoneChoice; if !decode_PendingPerPlayerZoneChoice(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::PerPlayerZoneChoice"); out^ = tmp
	case "PerCategoryZoneChoice": when COVERAGE do cov_hit("ResolutionFrame::PerCategoryZoneChoice"); tmp: ResolutionFrame_PerCategoryZoneChoice; if !decode_PerCategoryZoneChoiceFrame(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::PerCategoryZoneChoice"); out^ = tmp
	case "OptionalEffect": when COVERAGE do cov_hit("ResolutionFrame::OptionalEffect"); tmp: ResolutionFrame_OptionalEffect; if !decode_OptionalEffectFrame(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::OptionalEffect"); out^ = tmp
	case "CoinFlip": when COVERAGE do cov_hit("ResolutionFrame::CoinFlip"); tmp: ResolutionFrame_CoinFlip; if !decode_PendingCoinFlip(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::CoinFlip"); out^ = tmp
	case "DieRoll": when COVERAGE do cov_hit("ResolutionFrame::DieRoll"); tmp: ResolutionFrame_DieRoll; if !dec_ptr_PendingDieRoll(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::DieRoll"); out^ = tmp
	case "Proliferate": when COVERAGE do cov_hit("ResolutionFrame::Proliferate"); tmp: ResolutionFrame_Proliferate; if !decode_PendingProliferateActions(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::Proliferate"); out^ = tmp
	case "MultiDraw": when COVERAGE do cov_hit("ResolutionFrame::MultiDraw"); tmp: ResolutionFrame_MultiDraw; if !decode_MultiDrawFrame(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::MultiDraw"); out^ = tmp
	case "Discard": when COVERAGE do cov_hit("ResolutionFrame::Discard"); tmp: ResolutionFrame_Discard; if !dec_ptr_DiscardFrame(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::Discard"); out^ = tmp
	case "ConniveReentry": when COVERAGE do cov_hit("ResolutionFrame::ConniveReentry"); tmp: ResolutionFrame_ConniveReentry; if !decode_PendingConniveReentry(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::ConniveReentry"); out^ = tmp
	case "LifeTotalAssignment": when COVERAGE do cov_hit("ResolutionFrame::LifeTotalAssignment"); tmp: ResolutionFrame_LifeTotalAssignment; if !decode_PendingLifeTotalAssignment(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::LifeTotalAssignment"); out^ = tmp
	case "SpellResolution": when COVERAGE do cov_hit("ResolutionFrame::SpellResolution"); tmp: ResolutionFrame_SpellResolution; if !decode_PendingSpellResolution(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::SpellResolution"); out^ = tmp
	case "MutateMerge": when COVERAGE do cov_hit("ResolutionFrame::MutateMerge"); tmp: ResolutionFrame_MutateMerge; if !decode_PendingMutateMerge(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::MutateMerge"); out^ = tmp
	case "CipherEncode": when COVERAGE do cov_hit("ResolutionFrame::CipherEncode"); tmp: ResolutionFrame_CipherEncode; if !decode_PendingCipherEncode(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::CipherEncode"); out^ = tmp
	case "EntryAttackSeat": when COVERAGE do cov_hit("ResolutionFrame::EntryAttackSeat"); tmp: ResolutionFrame_EntryAttackSeat; if !decode_PendingEntryAttackSeat(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::EntryAttackSeat"); out^ = tmp
	case "PostReplacement": when COVERAGE do cov_hit("ResolutionFrame::PostReplacement"); tmp: ResolutionFrame_PostReplacement; if !decode_PostReplacementDrainStack(json.get_or_null(v, "data"), &tmp._0) do return fail("ResolutionFrame::PostReplacement"); out^ = tmp
	case: return fail("ResolutionFrame: unknown variant")
	}
	return true
}

encode_ResolutionFrame :: proc(b: ^strings.Builder, x: ResolutionFrame) {
	#partial switch y in x {
	case ResolutionFrame_AbilityContinuation: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "AbilityContinuation"); member(b, &f, "data"); encode_AbilityContinuationFrame(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_RepeatFor: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RepeatFor"); member(b, &f, "data"); encode_PendingRepeatIteration(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_RepeatUntil: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RepeatUntil"); member(b, &f, "data"); encode_PendingRepeatUntil(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_RepeatedOptionalPayment: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "RepeatedOptionalPayment"); member(b, &f, "data"); encode_RepeatedOptionalPaymentFrame(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_ChangeZone: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChangeZone"); member(b, &f, "data"); enc_ptr_ChangeZoneFrame(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_BatchDelivery: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "BatchDelivery"); member(b, &f, "data"); enc_ptr_PendingBatchDeliveries(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_CounterMoves: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CounterMoves"); member(b, &f, "data"); encode_PendingCounterMoveQueue(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_CounterRemovals: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CounterRemovals"); member(b, &f, "data"); encode_PendingCounterRemovalQueue(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_CounterAdditions: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CounterAdditions"); member(b, &f, "data"); encode_PendingCounterAdditionQueue(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_CopyToken: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CopyToken"); member(b, &f, "data"); encode_PendingCopyTokenResolution(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_DebugCardEntries: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DebugCardEntries"); member(b, &f, "data"); enc_ptr_PendingDebugCardEntries(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_EachPlayerCopyChosen: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EachPlayerCopyChosen"); member(b, &f, "data"); encode_PendingEachPlayerCopyChosen(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_ChooseOneOf: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ChooseOneOf"); member(b, &f, "data"); encode_PendingChooseOneOf(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_VoteBallot: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "VoteBallot"); member(b, &f, "data"); encode_PendingVoteBallotIteration(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_PerPlayerZoneChoice: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PerPlayerZoneChoice"); member(b, &f, "data"); encode_PendingPerPlayerZoneChoice(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_PerCategoryZoneChoice: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PerCategoryZoneChoice"); member(b, &f, "data"); encode_PerCategoryZoneChoiceFrame(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_OptionalEffect: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "OptionalEffect"); member(b, &f, "data"); encode_OptionalEffectFrame(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_CoinFlip: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CoinFlip"); member(b, &f, "data"); encode_PendingCoinFlip(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_DieRoll: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "DieRoll"); member(b, &f, "data"); enc_ptr_PendingDieRoll(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_Proliferate: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Proliferate"); member(b, &f, "data"); encode_PendingProliferateActions(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_MultiDraw: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "MultiDraw"); member(b, &f, "data"); encode_MultiDrawFrame(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_Discard: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "Discard"); member(b, &f, "data"); enc_ptr_DiscardFrame(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_ConniveReentry: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "ConniveReentry"); member(b, &f, "data"); encode_PendingConniveReentry(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_LifeTotalAssignment: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "LifeTotalAssignment"); member(b, &f, "data"); encode_PendingLifeTotalAssignment(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_SpellResolution: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "SpellResolution"); member(b, &f, "data"); encode_PendingSpellResolution(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_MutateMerge: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "MutateMerge"); member(b, &f, "data"); encode_PendingMutateMerge(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_CipherEncode: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "CipherEncode"); member(b, &f, "data"); encode_PendingCipherEncode(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_EntryAttackSeat: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "EntryAttackSeat"); member(b, &f, "data"); encode_PendingEntryAttackSeat(b, y._0); strings.write_byte(b, '}')
	case ResolutionFrame_PostReplacement: strings.write_byte(b, '{'); f := true; member(b, &f, "type"); json.write_string(b, "PostReplacement"); member(b, &f, "data"); encode_PostReplacementDrainStack(b, y._0); strings.write_byte(b, '}')
	}
}

decode_ResolutionPaymentTranscriptEntry :: proc(v: json.Value, out: ^ResolutionPaymentTranscriptEntry) -> bool {
	when COVERAGE do cov_hit("ResolutionPaymentTranscriptEntry")
	if v.kind != .Object do return fail("ResolutionPaymentTranscriptEntry: not an object")
	if fv, found := get_any(v, "authenticated_actor"); found { if !decode_PlayerId(fv, &out.authenticated_actor) do return fail("ResolutionPaymentTranscriptEntry.authenticated_actor") } else { return fail("ResolutionPaymentTranscriptEntry.authenticated_actor missing") }
	if fv, found := get_any(v, "semantic_owner"); found { if !decode_PlayerId(fv, &out.semantic_owner) do return fail("ResolutionPaymentTranscriptEntry.semantic_owner") } else { return fail("ResolutionPaymentTranscriptEntry.semantic_owner missing") }
	if fv, found := get_any(v, "action"); found { if !decode_GameAction(fv, &out.action) do return fail("ResolutionPaymentTranscriptEntry.action") } else { return fail("ResolutionPaymentTranscriptEntry.action missing") }
	return true
}

encode_ResolutionPaymentTranscriptEntry :: proc(b: ^strings.Builder, x: ResolutionPaymentTranscriptEntry) {
	strings.write_byte(b, '{')
	f := true
	encode_ResolutionPaymentTranscriptEntry_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_ResolutionPaymentTranscriptEntry_members :: proc(b: ^strings.Builder, x: ResolutionPaymentTranscriptEntry, first: ^bool) {
	member(b, first, "authenticated_actor"); encode_PlayerId(b, x.authenticated_actor)
	member(b, first, "semantic_owner"); encode_PlayerId(b, x.semantic_owner)
	member(b, first, "action"); encode_GameAction(b, x.action)
}

decode_PaymentRecoveryCheckpoint :: proc(v: json.Value, out: ^PaymentRecoveryCheckpoint) -> bool {
	when COVERAGE do cov_hit("PaymentRecoveryCheckpoint")
	if v.kind != .Object do return fail("PaymentRecoveryCheckpoint: not an object")
	if fv, found := get_any(v, "state"); found { if !decode_with_persisted_checkpoint_state(fv, &out.state) do return fail("PaymentRecoveryCheckpoint.state") } else { return fail("PaymentRecoveryCheckpoint.state missing") }
	if fv, found := get_any(v, "events"); found { if !dec_dyn_GameEvent(fv, &out.events) do return fail("PaymentRecoveryCheckpoint.events") }
	if fv, found := get_any(v, "log_entries"); found { if !dec_dyn_GameLogEntry(fv, &out.log_entries) do return fail("PaymentRecoveryCheckpoint.log_entries") }
	if fv, found := get_any(v, "consumed"); found { if !decode_int(fv, &out.consumed) do return fail("PaymentRecoveryCheckpoint.consumed") }
	return true
}

encode_PaymentRecoveryCheckpoint :: proc(b: ^strings.Builder, x: PaymentRecoveryCheckpoint) {
	strings.write_byte(b, '{')
	f := true
	encode_PaymentRecoveryCheckpoint_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_PaymentRecoveryCheckpoint_members :: proc(b: ^strings.Builder, x: PaymentRecoveryCheckpoint, first: ^bool) {
	member(b, first, "state"); encode_with_persisted_checkpoint_state(b, x.state)
	if !((len(x.events) == 0)) { member(b, first, "events"); enc_dyn_GameEvent(b, x.events) }
	if !((len(x.log_entries) == 0)) { member(b, first, "log_entries"); enc_dyn_GameLogEntry(b, x.log_entries) }
	member(b, first, "consumed"); encode_int(b, x.consumed)
}

decode_SeatCreatedTokens :: proc(v: json.Value, out: ^SeatCreatedTokens) -> bool {
	when COVERAGE do cov_hit("SeatCreatedTokens")
	if v.kind != .Object do return fail("SeatCreatedTokens: not an object")
	if fv, found := get_any(v, "seat"); found { if !decode_PlayerId(fv, &out.seat) do return fail("SeatCreatedTokens.seat") } else { return fail("SeatCreatedTokens.seat missing") }
	if fv, found := get_any(v, "tokens"); found { if !dec_dyn_ObjectIncarnationRef(fv, &out.tokens) do return fail("SeatCreatedTokens.tokens") } else { return fail("SeatCreatedTokens.tokens missing") }
	return true
}

encode_SeatCreatedTokens :: proc(b: ^strings.Builder, x: SeatCreatedTokens) {
	strings.write_byte(b, '{')
	f := true
	encode_SeatCreatedTokens_members(b, x, &f)
	strings.write_byte(b, '}')
}

encode_SeatCreatedTokens_members :: proc(b: ^strings.Builder, x: SeatCreatedTokens, first: ^bool) {
	member(b, first, "seat"); encode_PlayerId(b, x.seat)
	member(b, first, "tokens"); enc_dyn_ObjectIncarnationRef(b, x.tokens)
}

decode_CoinFlipResult :: proc(v: json.Value, out: ^CoinFlipResult) -> bool {
	when COVERAGE do cov_hit("CoinFlipResult")
	if v.kind != .String do return fail("CoinFlipResult: not a string")
	str := v.text
	switch str {
	case "Won": when COVERAGE do cov_hit("CoinFlipResult::Won"); out^ = .Won
	case "Lost": when COVERAGE do cov_hit("CoinFlipResult::Lost"); out^ = .Lost
	case: return fail("CoinFlipResult: unknown variant")
	}
	return true
}

encode_CoinFlipResult :: proc(b: ^strings.Builder, x: CoinFlipResult) {
	@(static, rodata) NAMES := [CoinFlipResult]string{
		.Won = "Won",
		.Lost = "Lost",
	}
	json.write_string(b, NAMES[x])
}

decode_PendingPlayerScopeSacrificeCompletion :: proc(v: json.Value, out: ^PendingPlayerScopeSacrificeCompletion) -> bool {
	when COVERAGE do cov_hit("PendingPlayerScopeSacrificeCompletion")
	if v.kind != .Object do return fail("PendingPlayerScopeSacrificeCompletion: not an object")
	if fv, found := get_any(v, "announced"); found { if !dec_dyn_ObjectId(fv, &out.announced) do return fail("PendingPlayerScopeSacrificeCompletion.announced") }
	if fv, found := get_any(v, "sacrificed"); found { if !dec_dyn_ObjectId(fv, &out.sacrificed) do return fail("PendingPlayerScopeSacrificeCompletion.sacrificed") }
	if fv, found := get_any(v, "zone_changed"); found { if !dec_dyn_ObjectId(fv, &out.zone_changed) do return fail("PendingPlayerScopeSacrificeCompletion.zone_changed") }
	if fv, found := get_any(v, "departed_zone_change_indices"); found { if !dec_dyn_int(fv, &out.departed_zone_change_indices) do return fail("PendingPlayerScopeSacrificeCompletion.departed_zone_change_indices") }
	if fv, found := get_any(v, "deferred_events"); found { if !dec_dyn_GameEvent(fv, &out.deferred_events) do return fail("PendingPlayerScopeSacrificeCompletion.deferred_events") }
	if fv, found := get_any(v, "spans_replacement_pause"); found { if !decode_bool(fv, &out.spans_replacement_pause) do return fail("PendingPlayerScopeSacrificeCompletion.spans_replacement_pause") }
	if fv, found := get_any(v, "effect_kind"); found { if !dec_opt_EffectKind(fv, &out.effect_kind) do return fail("PendingPlayerScopeSacrificeCompletion.effect_kind") }
	if fv, found := get_any(v, "follow_up"); found { if !dec_opt_PendingPlayerScopeSacrificeFollowUp(fv, &out.follow_up) do return fail("PendingPlayerScopeSacrificeCompletion.follow_up") }
	if fv, found := get_any(v, "followed_up_sacrifices"); found { if !dec_dyn_ObjectId(fv, &out.followed_up_sacrifices) do return fail("PendingPlayerScopeSacrificeCompletion.followed_up_sacrifices") }
	if fv, found := get_any(v, "publish_fresh_tracked_set"); found { if !decode_bool(fv, &out.publish_fresh_tracked_set) do return fail("PendingPlayerScopeSacrificeCompletion.publish_fresh_tracked_set") }
	if fv, found := get_any(v, "propagate_parent_context"); found { if !decode_bool(fv, &out.propagate_parent_context) do return fail("PendingPlayerScopeSacrificeCompletion.propagate_parent_context") }
	if fv, found := get_any(v, "pending_deliveries"); found { if !dec_dyn_PendingSacrificeDelivery(fv, &out.pending_deliveries) do return fail("PendingPlayerScopeSacrificeCompletion.pending_deliveries") }
