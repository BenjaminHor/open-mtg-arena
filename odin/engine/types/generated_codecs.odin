encode_HeroEventApplyStep :: proc(b: ^strings.Builder, x: HeroEventApplyStep) {
	#partial switch y in x {
	case HeroEventApplyStep_Sacrifice: strings.write_byte(b, '{'); json.write_string(b, "Sacrifice"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "hero"); encode_PlayerId(b, y.hero)
	member(b, first, "card"); encode_ObjectId(b, y.card)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case HeroEventApplyStep_Discard: strings.write_byte(b, '{'); json.write_string(b, "Discard"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "hero"); encode_PlayerId(b, y.hero)
	member(b, first, "card"); encode_ObjectId(b, y.card)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case HeroEventApplyStep_Destroy: strings.write_byte(b, '{'); json.write_string(b, "Destroy"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card"); encode_ObjectId(b, y.card)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case HeroEventApplyStep_LoseLife: strings.write_byte(b, '{'); json.write_string(b, "LoseLife"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "amount"); encode_i32(b, y.amount)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case HeroEventApplyStep_GainLife: strings.write_byte(b, '{'); json.write_string(b, "GainLife"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	member(b, first, "amount"); encode_i32(b, y.amount)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case HeroEventApplyStep_Damage: strings.write_byte(b, '{'); json.write_string(b, "Damage"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card"); encode_ObjectId(b, y.card)
	member(b, first, "amount"); encode_u32(b, y.amount)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case HeroEventApplyStep_ZoneMove: strings.write_byte(b, '{'); json.write_string(b, "ZoneMove"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card"); encode_ObjectId(b, y.card)
	member(b, first, "dest"); encode_Zone(b, y.dest)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case HeroEventApplyStep_ShuffleLibrary: strings.write_byte(b, '{'); json.write_string(b, "ShuffleLibrary"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "player"); encode_PlayerId(b, y.player)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case HeroEventApplyStep_DiscardFiredBaxters: strings.write_byte(b, '{'); json.write_string(b, "DiscardFiredBaxters"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "cards"); enc_dyn_ObjectId(b, y.cards)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case HeroEventApplyStep_Tap: strings.write_byte(b, '{'); json.write_string(b, "Tap"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card"); encode_ObjectId(b, y.card)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case HeroEventApplyStep_AddCounters: strings.write_byte(b, '{'); json.write_string(b, "AddCounters"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card"); encode_ObjectId(b, y.card)
	member(b, first, "counter"); encode_CounterType(b, y.counter)
	member(b, first, "count"); encode_u32(b, y.count)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
	case HeroEventApplyStep_Bounce: strings.write_byte(b, '{'); json.write_string(b, "Bounce"); strings.write_byte(b, ':'); strings.write_byte(b, '{'); { fst := true; first := &fst
	member(b, first, "card"); encode_ObjectId(b, y.card)
	}; strings.write_byte(b, '}'); strings.write_byte(b, '}')
