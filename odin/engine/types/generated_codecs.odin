	if fv, found := get_any(v, "applied"); found { if !dec_dyn_AppliedReplacementKey(fv, &out.applied) do return fail("DeferredDamageChoice.applied") }
	if fv, found := get_any(v, "excess_recipient"); found { if !dec_opt_ExcessRecipient(fv, &out.excess_recipient) do return fail("DeferredDamageChoice.excess_recipient") }
	if fv, found := get_any(v, "lifelink_bonus"); found { if !decode_u32(fv, &out.lifelink_bonus) do return fail("DeferredDamageChoice.lifelink_bonus") }
	if fv, found := get_any(v, "candidates"); found { if !dec_dyn_ReplacementId(fv, &out.candidates) do return fail("DeferredDamageChoice.candidates") }
	return true
}

