	when COVERAGE do cov_hit("UnitDecision")
	if v.kind != .Object do return fail("UnitDecision: not an object")
	if fv, found := get_any(v, "pool_index"); found { if !decode_int(fv, &out.pool_index) do return fail("UnitDecision.pool_index") } else { return fail("UnitDecision.pool_index missing") }
