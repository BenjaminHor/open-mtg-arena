	when COVERAGE do cov_hit("CopyChosenSelection")
	if v.kind != .Object do return fail("CopyChosenSelection: not an object")
	if fv, found := get_any(v, "player"); found { if !decode_PlayerId(fv, &out.player) do return fail("CopyChosenSelection.player") } else { return fail("CopyChosenSelection.player missing") }
	if fv, found := get_any(v, "chosen"); found { if !dec_dyn_ObjectId(fv, &out.chosen) do return fail("CopyChosenSelection.chosen") } else { return fail("CopyChosenSelection.chosen missing") }
	return true
}

encode_CopyChosenSelection :: proc(b: ^strings.Builder, x: CopyChosenSelection) {
