		v.must_be_blocked_targets = cln_map_ObjectId_dyn_ObjectId(y.must_be_blocked_targets)
		v.block_capacities = cln_map_ObjectId_opt_u32(y.block_capacities)
		return v
	case WaitingFor_UntapChoice:
		v := y
		v.candidates = cln_dyn_ObjectId(y.candidates)
		v.chosen_not_to_untap = cln_dyn_ObjectId(y.chosen_not_to_untap)
		return v
	case WaitingFor_ChooseUntapSubset:
