clone_AbilityCondition :: proc(x: AbilityCondition) -> AbilityCondition {
	#partial switch y in x {
	case AbilityCondition_AdditionalCostPaid:
		v := y
		v.kicker_cost = cln_opt_ManaCost(y.kicker_cost)
		return v
	case AbilityCondition_CastDuringPhase:
		v := y
		v.phases = cln_dyn_Phase(y.phases)
		return v
	case AbilityCondition_CurrentPhaseIs:
		v := y
		v.phases = cln_dyn_Phase(y.phases)
		return v
	case AbilityCondition_RevealedHasCardType:
		v := y
		v.card_types = cln_dyn_CoreType(y.card_types)
		v.additional_filter = cln_opt_FilterProp(y.additional_filter)
		v.subtype_filter = cln_ptr_TargetFilter(y.subtype_filter)
		return v
	case AbilityCondition_ObjectsShareQuality:
		v := y
		v.subject = clone_TargetFilter(y.subject)
		v.reference = clone_TargetFilter(y.reference)
		return v
	case AbilityCondition_TargetSharesNameWithOtherExiledThisWay:
		v := y
		v.target = clone_TargetFilter(y.target)
		return v
	case AbilityCondition_QuantityCheck:
		v := y
		v.lhs = clone_QuantityExpr(y.lhs)
		v.rhs = clone_QuantityExpr(y.rhs)
		return v
	case AbilityCondition_QuantityQuality:
		v := y
		v.quantity = clone_QuantityExpr(y.quantity)
		return v
	case AbilityCondition_PreviousEffectAmount:
		v := y
		v.rhs = clone_QuantityExpr(y.rhs)
		return v
	case AbilityCondition_DiscardedCardMatchesFilter:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case AbilityCondition_TargetHasKeywordInstead:
		v := y
		v.keyword = clone_Keyword(y.keyword)
		return v
	case AbilityCondition_TargetMatchesFilter:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case AbilityCondition_TriggeringSpellTargetsFilter:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case AbilityCondition_SourceMatchesFilter:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case AbilityCondition_PostReplacementDamageSourceMatchesFilter:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case AbilityCondition_ZoneChangeObjectMatchesFilter:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case AbilityCondition_ControllerControlsMatching:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case AbilityCondition_ControllerControlledMatchingAsCast:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case AbilityCondition_ZoneChangedThisWay:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case AbilityCondition_CostPaidObjectMatchesFilter:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case AbilityCondition_ConditionInstead:
		v := y
		v.inner = cln_ptr_AbilityCondition(y.inner)
		return v
	case AbilityCondition_And:
		v := y
		v.conditions = cln_dyn_AbilityCondition(y.conditions)
		return v
	case AbilityCondition_Or:
		v := y
		v.conditions = cln_dyn_AbilityCondition(y.conditions)
		return v
	case AbilityCondition_Not:
		v := y
		v.condition = cln_ptr_AbilityCondition(y.condition)
		return v
	case AbilityCondition_SourceLacksKeyword:
		v := y
		v.keyword = clone_Keyword(y.keyword)
		return v
	case AbilityCondition_ScopedPlayerMatches:
		v := y
		v.filter = clone_PlayerFilter(y.filter)
		return v
	case AbilityCondition_PlayerAttackedPlayer:
		v := y
		v.attacker = clone_PlayerScope(y.attacker)
		v.defender = clone_PlayerScope(y.defender)
		return v
	}
	return x
}

