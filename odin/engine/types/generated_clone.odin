	case WaitingFor_ExertChoice:
		v := y
		v.permission = clone_TriggerDefinitionRef(y.permission)
		v.remaining = cln_dyn_PendingAttackExert(y.remaining)
		return v
	case WaitingFor_EnlistChoice:
		v := y
		v.eligible = cln_dyn_ObjectId(y.eligible)
		v.remaining = cln_dyn_ObjectId(y.remaining)
		return v
	case WaitingFor_ReplacementChoice:
