clone_Effect :: proc(x: Effect) -> Effect {
	#partial switch y in x {
	case Effect_StartYourEngines:
		v := y
		v.player_scope = clone_PlayerFilter(y.player_scope)
		return v
	case Effect_ChangeSpeed:
		v := y
		v.player_scope = clone_PlayerFilter(y.player_scope)
		v.amount = clone_QuantityExpr(y.amount)
		return v
	case Effect_DealDamage:
		v := y
		v.amount = clone_QuantityExpr(y.amount)
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_ResumeDamageBatch:
		v := y
		v.replaced = cln_dyn_ReplacedDamagePortion(y.replaced)
		v.remaining = cln_dyn_RawDamagePortion(y.remaining)
		return v
	case Effect_EachDealsDamageEqualToPower:
		v := y
		v.sources = clone_TargetFilter(y.sources)
		v.recipient = clone_TargetFilter(y.recipient)
		v.extra_source = cln_opt_TargetFilter(y.extra_source)
		return v
	case Effect_EachSourceDealsDamage:
		v := y
		v.sources = clone_TargetFilter(y.sources)
		v.amount = clone_QuantityExpr(y.amount)
		v.recipient = clone_EachDamageRecipient(y.recipient)
		return v
	case Effect_Draw:
		v := y
		v.count = clone_QuantityExpr(y.count)
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_Pump:
		v := y
		v.power = clone_PtValue(y.power)
		v.toughness = clone_PtValue(y.toughness)
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_PairWith:
		v := y
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_Destroy:
		v := y
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_Regenerate:
		v := y
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_RemoveAllDamage:
		v := y
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_Counter:
		v := y
		v.target = clone_TargetFilter(y.target)
		v.source_rider = cln_opt_CounterSourceRider(y.source_rider)
		v.countered_spell_zone = cln_opt_SpellStackToGraveyardReplacement(y.countered_spell_zone)
		return v
	case Effect_CounterAll:
		v := y
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_Token:
		v := y
		v.power = clone_PtValue(y.power)
		v.toughness = clone_PtValue(y.toughness)
		v.types = cln_dyn_string(y.types)
		v.colors = cln_dyn_ManaColor(y.colors)
		v.keywords = cln_dyn_Keyword(y.keywords)
		v.count = clone_QuantityExpr(y.count)
		v.owner = clone_TargetFilter(y.owner)
		v.attach_to = cln_opt_TargetFilter(y.attach_to)
		v.attack_destination = clone_TokenAttackDestination(y.attack_destination)
		v.supertypes = cln_dyn_Supertype(y.supertypes)
