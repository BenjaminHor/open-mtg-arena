clone_QuantityExpr :: proc(x: QuantityExpr) -> QuantityExpr {
	#partial switch y in x {
	case QuantityExpr_Ref:
		v := y
		v.qty = clone_QuantityRef(y.qty)
		return v
	case QuantityExpr_DivideRounded:
		v := y
		v.inner = cln_ptr_QuantityExpr(y.inner)
		return v
	case QuantityExpr_Offset:
		v := y
		v.inner = cln_ptr_QuantityExpr(y.inner)
		return v
	case QuantityExpr_ClampMin:
		v := y
		v.inner = cln_ptr_QuantityExpr(y.inner)
		return v
	case QuantityExpr_Multiply:
		v := y
		v.inner = cln_ptr_QuantityExpr(y.inner)
		return v
	case QuantityExpr_Sum:
		v := y
		v.exprs = cln_dyn_QuantityExpr(y.exprs)
		return v
	case QuantityExpr_UpTo:
		v := y
		v.max = cln_ptr_QuantityExpr(y.max)
		return v
	case QuantityExpr_Power:
		v := y
		v.exponent = cln_ptr_QuantityExpr(y.exponent)
		return v
	case QuantityExpr_Difference:
		v := y
		v.left = cln_ptr_QuantityExpr(y.left)
		v.right = cln_ptr_QuantityExpr(y.right)
		return v
	case QuantityExpr_Max:
		v := y
		v.exprs = cln_dyn_QuantityExpr(y.exprs)
		return v
	}
	return x
}

