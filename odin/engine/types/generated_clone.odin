		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_ProliferateTarget:
		v := y
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_ExileTopCardContest:
		v := y
		v.winner_effect = cln_ptr_AbilityDefinition(y.winner_effect)
		return v
	case Effect_Behold:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case Effect_Vote:
