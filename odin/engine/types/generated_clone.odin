clone_WaitingFor :: proc(x: WaitingFor) -> WaitingFor {
	#partial switch y in x {
	case WaitingFor_MeldPairChoice:
		v := y
		v.choices = cln_dyn_MeldSelection(y.choices)
		return v
	case WaitingFor_MeldAttackTargetChoice:
		v := y
		v.valid_targets = cln_dyn_AttackTarget(y.valid_targets)
		return v
	case WaitingFor_EntryAttackTargetChoice:
		v := y
		v.valid_targets = cln_dyn_AttackTarget(y.valid_targets)
		return v
	case WaitingFor_MulliganDecision:
		v := y
		v.pending = cln_dyn_MulliganDecisionEntry(y.pending)
		v.declared = cln_dyn_MulliganDeclaration(y.declared)
		return v
	case WaitingFor_OpeningHandBottomCards:
		v := y
		v.pending = cln_dyn_MulliganBottomEntry(y.pending)
		return v
	case WaitingFor_ManaSourceSelection:
		v := y
		v.options = cln_dyn_ManaSourceSelection(y.options)
		return v
	case WaitingFor_AssistChoosePlayer:
		v := y
		v.candidates = cln_dyn_PlayerId(y.candidates)
		return v
	case WaitingFor_ChooseXValue:
		v := y
		v.pending_cast = cln_ptr_PendingCast(y.pending_cast)
		v.x_cost_previews = cln_dyn_t2_u32_ManaCost(y.x_cost_previews)
		return v
	case WaitingFor_TargetSelection:
		v := y
		v.pending_cast = cln_ptr_PendingCast(y.pending_cast)
		v.target_slots = cln_dyn_TargetSelectionSlot(y.target_slots)
		v.mode_labels = cln_dyn_opt_string(y.mode_labels)
		v.selection = clone_TargetSelectionProgress(y.selection)
		return v
	case WaitingFor_DeclareAttackers:
		v := y
		v.valid_attacker_ids = cln_dyn_ObjectId(y.valid_attacker_ids)
		v.valid_attack_targets = cln_dyn_AttackTarget(y.valid_attack_targets)
		v.valid_attack_targets_by_attacker = cln_opt_map_ObjectId_dyn_AttackTarget(y.valid_attack_targets_by_attacker)
		v.attacker_constraints = cln_map_ObjectId_CombatRequirement(y.attacker_constraints)
		return v
	case WaitingFor_DeclareBlockers:
		v := y
		v.valid_blocker_ids = cln_dyn_ObjectId(y.valid_blocker_ids)
		v.valid_block_targets = cln_map_ObjectId_dyn_ObjectId(y.valid_block_targets)
