clone_GameAction :: proc(x: GameAction) -> GameAction {
	#partial switch y in x {
	case GameAction_CastSpell:
		v := y
		v.targets = cln_dyn_ObjectId(y.targets)
		return v
	case GameAction_DeclareAttackers:
		v := y
		v.attacks = cln_dyn_t2_ObjectId_AttackTarget(y.attacks)
		v.bands = cln_dyn_dyn_ObjectId(y.bands)
		return v
	case GameAction_DeclareBlockers:
		v := y
		v.assignments = cln_dyn_t2_ObjectId_ObjectId(y.assignments)
		return v
	case GameAction_ReorderHand:
		v := y
		v.order = cln_dyn_ObjectId(y.order)
		return v
	case GameAction_TapLandForMana:
		v := y
		v.selection = clone_ManaSourceSelection(y.selection)
		return v
	case GameAction_ActivateManaSource:
		v := y
		v.selection = clone_ManaSourceSelection(y.selection)
		return v
	case GameAction_SelectCards:
		v := y
		v.cards = cln_dyn_ObjectId(y.cards)
		return v
	case GameAction_ChooseRemoveCounterCostDistribution:
		v := y
		v.distribution = cln_dyn_CounterCostChoice(y.distribution)
		return v
	case GameAction_SelectCoinFlips:
		v := y
		v.keep_indices = cln_dyn_int(y.keep_indices)
		return v
	case GameAction_SelectDieRolls:
		v := y
		v.ignore_indices = cln_dyn_int(y.ignore_indices)
		return v
	case GameAction_ChooseOutsideGameCards:
		v := y
		v.selections = cln_dyn_OutsideGameSelection(y.selections)
		return v
	case GameAction_SelectTargets:
		v := y
		v.targets = cln_dyn_TargetRef(y.targets)
		return v
	case GameAction_ChooseReplacementAndRemember:
		v := y
		v.choice = clone_ReplacementAutoChoice(y.choice)
		return v
	case GameAction_OrderTriggers:
		v := y
		v.order = cln_dyn_int(y.order)
		return v
	case GameAction_OrderCostReductions:
		v := y
		v.order = cln_dyn_int(y.order)
		v.hybrid_announcement = cln_dyn_ManaCostShard(y.hybrid_announcement)
		return v
	case GameAction_CrewVehicle:
		v := y
		v.creature_ids = cln_dyn_ObjectId(y.creature_ids)
		return v
	case GameAction_SaddleMount:
		v := y
		v.creature_ids = cln_dyn_ObjectId(y.creature_ids)
		return v
	case GameAction_SubmitSideboard:
		v := y
		v.main = cln_dyn_DeckCardCount(y.main)
		v.sideboard = cln_dyn_DeckCardCount(y.sideboard)
		return v
	case GameAction_SubmitPilePartition:
		v := y
		v.pile_a = cln_dyn_ObjectId(y.pile_a)
		return v
	case GameAction_SelectModes:
		v := y
		v.indices = cln_dyn_int(y.indices)
		return v
	case GameAction_ChooseSecretAgendaNames:
		v := y
		v.names = cln_dyn_string(y.names)
		return v
	case GameAction_SetPhaseStops:
		v := y
		v.stops = cln_dyn_PhaseStop(y.stops)
		return v
	case GameAction_SetMayTriggerAutoChoice:
		v := y
		v.op = clone_MayTriggerAutoChoiceOp(y.op)
		return v
	case GameAction_AssignCombatDamage:
		v := y
		v.assignments = cln_dyn_t2_ObjectId_u32(y.assignments)
		return v
	case GameAction_AssignBlockerDamage:
		v := y
		v.assignments = cln_dyn_t2_ObjectId_u32(y.assignments)
		return v
	case GameAction_DistributeAmong:
		v := y
		v.distribution = cln_dyn_t2_TargetRef_u32(y.distribution)
		return v
	case GameAction_ChooseCounterMoveDistribution:
		v := y
		v.selections = cln_dyn_CounterMoveChoice(y.selections)
		return v
	case GameAction_ChooseCountersToRemove:
		v := y
		v.selections = cln_dyn_CounterRemoveChoice(y.selections)
		return v
	case GameAction_RetargetSpell:
		v := y
		v.new_targets = cln_dyn_opt_TargetRef(y.new_targets)
		return v
	case GameAction_SelectCategoryPermanents:
		v := y
		v.choices = cln_dyn_opt_ObjectId(y.choices)
		return v
	case GameAction_ChooseKeptCreatures:
		v := y
		v.kept = cln_dyn_ObjectId(y.kept)
		return v
	case GameAction_ChooseKeptPermanents:
		v := y
		v.kept = cln_dyn_ObjectId(y.kept)
		return v
	case GameAction_SubmitPhyrexianChoices:
		v := y
		v.choices = cln_dyn_ShardChoice(y.choices)
		return v
	case GameAction_ChooseManaColor:
		v := y
		v.choice = clone_ManaChoice(y.choice)
		return v
	case GameAction_PayManaAbilityMana:
		v := y
		v.payment = cln_dyn_ManaType(y.payment)
		return v
	case GameAction_Debug:
		v := y
		v._0 = clone_DebugAction(y._0)
		return v
	case GameAction_DeclareShortcut:
		v := y
		v.template = cln_opt_DecisionTemplate(y.template)
		return v
	case GameAction_EndContinuousEffect:
		v := y
		v.cost = clone_ManaCost(y.cost)
		return v
	}
	return x
}

