clone_BatchCompletion :: proc(x: BatchCompletion) -> BatchCompletion {
	#partial switch y in x {
	case BatchCompletion_RecordInstructionZoneResult:
		v := y
		v.settled_records = cln_opt_dyn_ZoneChangeRecord(y.settled_records)
		return v
	case BatchCompletion_CloakExileDeliveryComplete:
		v := y
		v.members = cln_dyn_CloakExileMember(y.members)
		return v
	case BatchCompletion_ExileFaceDownPileDeliveryComplete:
		v := y
		v.members = cln_dyn_ObjectId(y.members)
		return v
	case BatchCompletion_CastFromZoneExileDeliveryComplete:
		v := y
		v.ability = cln_ptr_ResolvedAbility(y.ability)
		v.in_place_ids = cln_dyn_ObjectId(y.in_place_ids)
		v.exile_delivery_ids = cln_dyn_ObjectId(y.exile_delivery_ids)
		return v
	case BatchCompletion_CascadeExileLoopComplete:
		v := y
		v.exiled_misses = cln_dyn_ObjectId(y.exiled_misses)
		return v
	case BatchCompletion_TopCardContestRoundComplete:
		v := y
		v.ability = cln_ptr_ResolvedAbility(y.ability)
		v.round = cln_dyn_t2_PlayerId_ObjectId(y.round)
		return v
	case BatchCompletion_PutOnTopComplete:
		v := y
		v.removed_exile_links = cln_dyn_ObjectId(y.removed_exile_links)
		return v
	case BatchCompletion_EffectZonePutAtLibraryPositionComplete:
		v := y
		v.chosen = cln_dyn_ObjectId(y.chosen)
		v.library_origin = cln_dyn_ObjectId(y.library_origin)
		v.library_position = clone_LibraryPosition(y.library_position)
		return v
	case BatchCompletion_ForEachCategoryExileComplete:
		v := y
		v.ability = cln_ptr_ResolvedAbility(y.ability)
		v.pool = cln_dyn_ObjectId(y.pool)
		v.remaining_member_filters = cln_dyn_TargetFilter(y.remaining_member_filters)
		v.chosen = cln_dyn_ObjectId(y.chosen)
		return v
	case BatchCompletion_SurveilKeepOnTop:
		v := y
		v.top_cards = cln_dyn_ObjectId(y.top_cards)
		v.graveyard_bound = cln_dyn_ObjectId(y.graveyard_bound)
		return v
	case BatchCompletion_ManifestDreadCleanup:
		v := y
		v.revealed = cln_dyn_ObjectId(y.revealed)
		return v
	case BatchCompletion_RevealRestPile:
		v := y
		v.rest_cards = cln_dyn_ObjectId(y.rest_cards)
		v.clear_markers = cln_dyn_ObjectId(y.clear_markers)
		v.publish_tracked_set = cln_opt_dyn_ObjectId(y.publish_tracked_set)
		v.reveal_until_hit_snapshot = cln_ptr_EventObjectSnapshot(y.reveal_until_hit_snapshot)
		v.kept_delivery = clone_DigKeptDeliveryOutcome(y.kept_delivery)
		v.continuation_targets = cln_dyn_ObjectId(y.continuation_targets)
		v.rest_delivery = clone_DigRestDeliveryOutcome(y.rest_delivery)
		return v
	case BatchCompletion_DigMassPutAllRestComplete:
		v := y
		v.selected = cln_dyn_ObjectId(y.selected)
		return v
	case BatchCompletion_DigMassPutAllComplete:
		v := y
		v.selected = cln_dyn_ObjectId(y.selected)
		return v
	case BatchCompletion_RemoveExileLinks:
		v := y
		v.returned_ids = cln_dyn_ObjectId(y.returned_ids)
		return v
	case BatchCompletion_LibrarySearchDeliverySettled:
		v := y
		v.resume = clone_LibrarySearchDeliveryResume(y.resume)
		return v
	case BatchCompletion_SearchPartitionPrimaryDelivered:
		v := y
		v.rest_ids = cln_dyn_ObjectId(y.rest_ids)
		v.resume = clone_LibrarySearchDeliveryResume(y.resume)
		return v
	case BatchCompletion_MilledDeliveryComplete:
		v := y
		v.cards = cln_dyn_ObjectId(y.cards)
		v.position = clone_LibraryPosition(y.position)
		return v
	case BatchCompletion_HordeMillFromLossDeliveryComplete:
		v := y
		v.milled = cln_dyn_ObjectId(y.milled)
		v.legendary_cohort = cln_dyn_ObjectId(y.legendary_cohort)
		return v
	case BatchCompletion_DestroyPopulationSettled:
		v := y
		v.ability = cln_ptr_ResolvedAbility(y.ability)
		v.settled_destroyed = cln_opt_dyn_ObjectId(y.settled_destroyed)
		return v
	case BatchCompletion_ChangeZonePopulationSettled:
		v := y
		v.tail = cln_ptr_ChangeZoneBatchTail(y.tail)
		v.settled = cln_opt_ChangeZoneSettled(y.settled)
		return v
	}
	return x
}

