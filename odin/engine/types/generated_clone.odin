clone_TriggeredManaResume :: proc(x: TriggeredManaResume) -> TriggeredManaResume {
	out := x
	out.current = cln_ptr_PendingTriggerContext(x.current)
	out.current_override = cln_opt_ProductionOverride(x.current_override)
	out.accepted_tail = cln_dyn_PendingTriggerContext(x.accepted_tail)
	out.collected_batches = cln_dyn_CollectedTriggerContextBatch(x.collected_batches)
	out.outer_resume = clone_ManaTriggerFixedPointResume(x.outer_resume)
	return out
}

cln_ptr_RandomDiscardCostPick :: proc(x: ^RandomDiscardCostPick) -> ^RandomDiscardCostPick {
