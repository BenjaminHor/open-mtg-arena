clone_PendingCast :: proc(x: PendingCast) -> PendingCast {
	out := x
	out.ability = cln_ptr_ResolvedAbility(x.ability)
	out.cost = clone_ManaCost(x.cost)
	out.base_cost = cln_opt_ManaCost(x.base_cost)
	out.declared_mana_additions = cln_dyn_ManaCost(x.declared_mana_additions)
	out.accepted_cost_reductions = cln_dyn_CostReductionEntry(x.accepted_cost_reductions)
	out.cost_reduction_election = cln_opt_CostReductionElection(x.cost_reduction_election)
	out.activation_cost_snapshot = cln_ptr_ActivationCostSnapshot(x.activation_cost_snapshot)
	out.activation_cost = cln_opt_AbilityCost(x.activation_cost)
	out.prepaid_finalization = cln_ptr_PrepaidSpellFinalization(x.prepaid_finalization)
	out.deferred_life_gain_cost = cln_opt_DeferredLifeGainCost(x.deferred_life_gain_cost)
	out.target_constraints = cln_dyn_TargetSelectionConstraint(x.target_constraints)
	out.alternative_cost_keyword = cln_opt_Keyword(x.alternative_cost_keyword)
	out.additional_cost_flow = cln_opt_AdditionalCost(x.additional_cost_flow)
	out.deferred_required_additional_cost = cln_opt_AbilityCost(x.deferred_required_additional_cost)
	out.additional_cost_queue = cln_dyn_AdditionalCostInstance(x.additional_cost_queue)
	out.deferred_modal_choice = cln_opt_ModalChoice(x.deferred_modal_choice)
	out.chosen_modes = cln_dyn_int(x.chosen_modes)
	out.declared_kickers_to_pay = cln_dyn_KickerVariant(x.declared_kickers_to_pay)
	out.declined_kickers = cln_dyn_KickerVariant(x.declined_kickers)
	out.convoked_creatures = cln_dyn_ObjectId(x.convoked_creatures)
	out.delved_cards = cln_dyn_ObjectId(x.delved_cards)
	out.deferred_sacrificed_permanents = cln_dyn_DeferredSpellSacrifice(x.deferred_sacrificed_permanents)
	out.deferred_tapped_permanents = cln_dyn_DeferredSpellTap(x.deferred_tapped_permanents)
	out.pinned_pool_units = cln_dyn_ManaPipId(x.pinned_pool_units)
	out.activation_trigger_collection = cln_ptr_PendingActivationTriggerCollection(x.activation_trigger_collection)
	out.activation_phyrexian_intent = cln_opt_ActivationPhyrexianIntent(x.activation_phyrexian_intent)
	return out
}

