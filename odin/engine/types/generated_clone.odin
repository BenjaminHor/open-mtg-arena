cln_ptr_ContestState :: proc(x: ^ContestState) -> ^ContestState {
	if x == nil do return nil
	p := new(ContestState)
	p^ = x^
	return p
}

cln_dyn_t2_PlayerId_u32 :: proc(x: [dynamic]Tuple2(PlayerId, u32)) -> [dynamic]Tuple2(PlayerId, u32) {
	out := make([dynamic]Tuple2(PlayerId, u32), len(x))
	copy(out[:], x[:])
	return out
}

cln_ptr_AbilityDefinition :: proc(x: ^AbilityDefinition) -> ^AbilityDefinition {
	if x == nil do return nil
	p := new(AbilityDefinition)
	p^ = clone_AbilityDefinition(x^)
	return p
}

cln_dyn_ptr_AbilityDefinition :: proc(x: [dynamic]^AbilityDefinition) -> [dynamic]^AbilityDefinition {
	out := make([dynamic]^AbilityDefinition, len(x))
	for item, i in x do out[i] = cln_ptr_AbilityDefinition(item)
	return out
}

cln_t2_PlayerId_PVec_ObjectId :: proc(x: Tuple2(PlayerId, PVec(ObjectId))) -> Tuple2(PlayerId, PVec(ObjectId)) {
	out := x
	out._1 = pvec_clone(x._1)
	return out
}

cln_dyn_CompanionRevealChoice :: proc(x: [dynamic]CompanionRevealChoice) -> [dynamic]CompanionRevealChoice {
