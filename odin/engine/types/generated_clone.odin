clone_AdditionalCost :: proc(x: AdditionalCost) -> AdditionalCost {
	#partial switch y in x {
	case AdditionalCost_Optional:
		v := y
		v.cost = clone_AbilityCost(y.cost)
		return v
	case AdditionalCost_Kicker:
		v := y
		v.costs = cln_dyn_AbilityCost(y.costs)
		return v
	case AdditionalCost_Choice:
		v := y
		v._0 = cln_dyn_AbilityCost(y._0)
		return v
