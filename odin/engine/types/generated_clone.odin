clone_StaticMode :: proc(x: StaticMode) -> StaticMode {
	#partial switch y in x {
	case StaticMode_CantBeActivated:
		v := y
		v.source_filter = clone_TargetFilter(y.source_filter)
		return v
	case StaticMode_CantCauseForcedAction:
		v := y
		v.actions = cln_dyn_CostCategory(y.actions)
		return v
	case StaticMode_CastWithKeyword:
		v := y
		v.keyword = clone_Keyword(y.keyword)
		return v
	case StaticMode_CastWithAlternativeCost:
		v := y
		v.cost = clone_AbilityCost(y.cost)
		return v
	case StaticMode_AlternativeKeywordCost:
		v := y
		v.cost = clone_AbilityCost(y.cost)
		return v
	case StaticMode_ModifyCost:
		v := y
		v.amount = clone_ManaCost(y.amount)
		v.spell_filter = cln_opt_TargetFilter(y.spell_filter)
		v.dynamic_count = cln_opt_QuantityRef(y.dynamic_count)
		return v
	case StaticMode_ImposeAdditionalCost:
		v := y
		v.cost = clone_AbilityCost(y.cost)
		v.spell_filter = cln_opt_TargetFilter(y.spell_filter)
		return v
	case StaticMode_ReduceAbilityCost:
		v := y
		v.dynamic_count = cln_opt_QuantityRef(y.dynamic_count)
		v.activator = cln_opt_PlayerFilter(y.activator)
		v.targets = cln_opt_TargetFilter(y.targets)
		return v
	case StaticMode_CantPayCost:
		v := y
		v.cost = clone_CostPaymentProhibition(y.cost)
		return v
	case StaticMode_PlayerProtection:
		v := y
		v._0 = clone_ProtectionTarget(y._0)
		return v
	case StaticMode_MustAttackDefender:
		v := y
		v.defender = clone_RequiredDefender(y.defender)
		return v
	case StaticMode_DoubleTriggers:
		v := y
		v.cause = clone_TriggerCause(y.cause)
		return v
	case StaticMode_GraveyardCastPermission:
		v := y
		v.extra_cost = cln_opt_CastExtraCost(y.extra_cost)
		v.enters_modifications = clone_PendingEntersModifications(y.enters_modifications)
		return v
	case StaticMode_TopOfLibraryCastPermission:
		v := y
		v.alt_cost = cln_opt_AbilityCost(y.alt_cost)
		return v
	case StaticMode_ExileCastPermission:
		v := y
		v.extra_cost = cln_opt_CastExtraCost(y.extra_cost)
		return v
	case StaticMode_CountersPersistAcrossZones:
		v := y
		v.excluded_zones = cln_dyn_Zone(y.excluded_zones)
		return v
	case StaticMode_PerTurnCastLimit:
		v := y
		v.spell_filter = cln_opt_TargetFilter(y.spell_filter)
		return v
	case StaticMode_SuppressTriggers:
		v := y
		v.source_filter = clone_TargetFilter(y.source_filter)
		v.trigger_source_filter = cln_opt_TargetFilter(y.trigger_source_filter)
		v.events = cln_dyn_SuppressedTriggerEvent(y.events)
		return v
	case StaticMode_CantBeBlockedExceptBy:
		v := y
		v.kind = clone_BlockExceptionKind(y.kind)
		return v
	case StaticMode_CantBeBlockedBy:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case StaticMode_AttachmentRestriction:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case StaticMode_MustBeBlocked:
		v := y
		v.by = cln_opt_TargetFilter(y.by)
		return v
	case StaticMode_MustBeBlockedByAll:
		v := y
		v.blockers = cln_opt_TargetFilter(y.blockers)
		return v
	case StaticMode_CrewContribution:
		v := y
		v.actions = cln_dyn_CrewAction(y.actions)
		return v
	case StaticMode_BlockRestriction:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case StaticMode_MaximumHandSize:
		v := y
		v.modification = clone_HandSizeModification(y.modification)
		return v
	case StaticMode_CantHaveKeyword:
		v := y
		v.keyword = clone_Keyword(y.keyword)
		return v
	case StaticMode_DefilerCostReduction:
		v := y
		v.mana_reduction = clone_ManaCost(y.mana_reduction)
		return v
	case StaticMode_SpendManaAsAnyColor:
		v := y
		v.spell_filter = cln_opt_TargetFilter(y.spell_filter)
		v.activation_source_filter = cln_opt_TargetFilter(y.activation_source_filter)
		return v
	case StaticMode_MaxUntapPerType:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	}
	return x
}

