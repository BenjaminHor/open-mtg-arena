	out.constraint = cln_opt_TriggerConstraint(x.constraint)
	out.condition = cln_opt_TriggerCondition(x.condition)
	out.attack_cost_condition = cln_opt_StaticCondition(x.attack_cost_condition)
	out.unless_pay = cln_opt_UnlessPayModifier(x.unless_pay)
	out.gotcha_condition = cln_opt_GotchaCondition(x.gotcha_condition)
