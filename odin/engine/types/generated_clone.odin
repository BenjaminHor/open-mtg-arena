clone_AbilityDefinition :: proc(x: AbilityDefinition) -> AbilityDefinition {
	out := x
	out.effect = cln_ptr_Effect(x.effect)
	out.reads_return_result = cln_opt_t2_ReturnResultId_ReturnResultReadSpec(x.reads_return_result)
	out.cost = cln_opt_AbilityCost(x.cost)
	out.sub_ability = cln_ptr_AbilityDefinition(x.sub_ability)
	out.else_ability = cln_ptr_AbilityDefinition(x.else_ability)
	out.duration = cln_opt_Duration(x.duration)
	out.activation_restrictions = cln_dyn_ActivationRestriction(x.activation_restrictions)
	out.activator_filter = cln_opt_PlayerFilter(x.activator_filter)
	out.condition = cln_opt_AbilityCondition(x.condition)
	out.optional_player = cln_opt_TargetFilter(x.optional_player)
	out.multi_target = cln_opt_MultiTargetSpec(x.multi_target)
	out.target_constraints = cln_dyn_TargetSelectionConstraint(x.target_constraints)
	out.unless_pay = cln_opt_UnlessPayModifier(x.unless_pay)
	out.modal = cln_opt_ModalChoice(x.modal)
	out.mode_abilities = cln_dyn_AbilityDefinition(x.mode_abilities)
	out.repeat_for = cln_opt_QuantityExpr(x.repeat_for)
	out.announced_x = cln_opt_QuantityExpr(x.announced_x)
	out.cost_reduction = cln_opt_CostReduction(x.cost_reduction)
	out.player_scope = cln_opt_PlayerFilter(x.player_scope)
	out.target_chooser = cln_opt_TargetFilter(x.target_chooser)
	out.repeat_until = cln_opt_RepeatContinuation(x.repeat_until)
	out.grant_chain = cln_dyn_ObjectIncarnationRef(x.grant_chain)
	return out
}

