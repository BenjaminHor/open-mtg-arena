		return v
	case CastingRestriction_SpendOnlyOnX:
		v := y
		v.colors = cln_dyn_ManaColor(y.colors)
		return v
	case CastingRestriction_OnlyFromZones:
		v := y
		v.zones = cln_dyn_Zone(y.zones)
		return v
	}
	return x
}

