	case WaitingFor_UnlessBounceChoice:
		v := y
		v.permanents = cln_dyn_ObjectId(y.permanents)
		v.pending_effect = cln_ptr_ResolvedAbility(y.pending_effect)
		return v
	case WaitingFor_ChooseRingBearer:
		v := y
		v.candidates = cln_dyn_ObjectId(y.candidates)
		return v
	case WaitingFor_ChooseRoomDoor:
		v := y
		v.options = cln_dyn_t2_DoorLockOp_RoomDoor(y.options)
		return v
	case WaitingFor_ChooseDungeon:
		v := y
		v.options = cln_dyn_DungeonPreview(y.options)
		return v
	case WaitingFor_ChooseDungeonRoom:
		v := y
		v.options = cln_dyn_RoomPreview(y.options)
		return v
	case WaitingFor_SpecializeColor:
		v := y
		v.options = cln_dyn_ManaColor(y.options)
		return v
	case WaitingFor_PayCost:
		v := y
		v.kind = clone_PayCostKind(y.kind)
		v.choices = cln_dyn_ObjectId(y.choices)
		v.resume = clone_CostResume(y.resume)
		return v
	case WaitingFor_ActivationCostOneOfChoice:
		v := y
		v.costs = cln_dyn_AbilityCost(y.costs)
		v.pending_cast = cln_ptr_PendingCast(y.pending_cast)
		return v
	case WaitingFor_CostTypeChoice:
		v := y
		v.choice_type = clone_ChoiceType(y.choice_type)
		v.options = cln_dyn_string(y.options)
		v.pending_cast = cln_ptr_PendingCast(y.pending_cast)
		return v
	case WaitingFor_BlightChoice:
		v := y
		v.creatures = cln_dyn_ObjectId(y.creatures)
		v.pending_cast = cln_ptr_PendingCast(y.pending_cast)
		return v
	case WaitingFor_PayManaAbilityMana:
		v := y
		v.options = cln_dyn_dyn_ManaType(y.options)
		v.pending_mana_ability = cln_ptr_PendingManaAbility(y.pending_mana_ability)
		return v
	case WaitingFor_ManaAbilityManaPayment:
		v := y
		v.pending_mana_ability = cln_ptr_PendingManaAbility(y.pending_mana_ability)
		return v
	case WaitingFor_ChooseManaColor:
		v := y
		v.choice = clone_ManaChoicePrompt(y.choice)
		v.context_ = clone_ManaChoiceContext(y.context_)
		return v
	case WaitingFor_CollectEvidenceChoice:
		v := y
		v.cards = cln_dyn_ObjectId(y.cards)
		v.resume = cln_ptr_CollectEvidenceResume(y.resume)
		return v
	case WaitingFor_HarmonizeTapChoice:
		v := y
		v.eligible_creatures = cln_dyn_ObjectId(y.eligible_creatures)
		v.pending_cast = cln_ptr_PendingCast(y.pending_cast)
		return v
	case WaitingFor_RevealUntilKeptChoice:
		v := y
		v.revealed_misses = cln_dyn_ObjectId(y.revealed_misses)
		return v
	case WaitingFor_RepeatDecision:
		v := y
		v.ability = cln_ptr_ResolvedAbility(y.ability)
		return v
	case WaitingFor_TopOrBottomChoice:
		v := y
		v.top_position = clone_LibraryPosition(y.top_position)
		return v
	case WaitingFor_PopulateChoice:
		v := y
		v.valid_tokens = cln_dyn_ObjectId(y.valid_tokens)
		return v
	case WaitingFor_ClashChooseOpponent:
		v := y
		v.candidates = cln_dyn_PlayerId(y.candidates)
		v.ability = cln_ptr_ResolvedAbility(y.ability)
		return v
	case WaitingFor_ChooseFromZoneOpponentChooser:
		v := y
		v.candidates = cln_dyn_PlayerId(y.candidates)
		v.ability = cln_ptr_ResolvedAbility(y.ability)
		return v
	case WaitingFor_ChooseAnnouncingOpponent:
		v := y
		v.candidates = cln_dyn_PlayerId(y.candidates)
		v.pending_cast = cln_ptr_PendingCast(y.pending_cast)
		return v
	case WaitingFor_ClashCardPlacement:
		v := y
		v.remaining = cln_dyn_t2_PlayerId_ObjectId(y.remaining)
		v.bottom_cards = cln_dyn_ObjectId(y.bottom_cards)
		return v
	case WaitingFor_PhysicalContest:
		v := y
		v.contest = cln_ptr_ContestState(y.contest)
		return v
	case WaitingFor_VoteChoice:
		v := y
		v.options = cln_dyn_string(y.options)
		v.option_labels = cln_dyn_string(y.option_labels)
		v.remaining_voters = cln_dyn_t2_PlayerId_u32(y.remaining_voters)
		v.tallies = cln_dyn_u32(y.tallies)
		v.ballots = pvec_clone(y.ballots)
		v.per_choice_effect = cln_dyn_ptr_AbilityDefinition(y.per_choice_effect)
		v.candidate_objects = pvec_clone(y.candidate_objects)
		v.outcome_template = cln_ptr_AbilityDefinition(y.outcome_template)
		v.chain_root_targets = cln_dyn_TargetRef(y.chain_root_targets)
		return v
	case WaitingFor_SeparatePilesChooseOpponent:
		v := y
		v.candidates = cln_dyn_PlayerId(y.candidates)
		v.eligible = pvec_clone(y.eligible)
		v.chosen_pile_effect = cln_ptr_AbilityDefinition(y.chosen_pile_effect)
		v.unchosen_pile_effect = cln_ptr_AbilityDefinition(y.unchosen_pile_effect)
		return v
	case WaitingFor_SeparatePilesPartition:
		v := y
		v.eligible = pvec_clone(y.eligible)
		v.remaining_subjects = pvec_clone(y.remaining_subjects)
		v.completed = pvec_clone(y.completed)
		v.chosen_pile_effect = cln_ptr_AbilityDefinition(y.chosen_pile_effect)
		v.unchosen_pile_effect = cln_ptr_AbilityDefinition(y.unchosen_pile_effect)
		return v
	case WaitingFor_SeparatePilesChoice:
		v := y
		v.pending = pvec_clone(y.pending)
		v.current = clone_PileResult(y.current)
		v.chosen_pile_effect = cln_ptr_AbilityDefinition(y.chosen_pile_effect)
		v.unchosen_pile_effect = cln_ptr_AbilityDefinition(y.unchosen_pile_effect)
		return v
	case WaitingFor_CompanionReveal:
		v := y
		v.eligible_companions = cln_dyn_CompanionRevealChoice(y.eligible_companions)
		return v
	case WaitingFor_ChooseLegend:
		v := y
		v.candidates = cln_dyn_ObjectId(y.candidates)
		return v
	case WaitingFor_BattleProtectorChoice:
		v := y
		v.candidates = cln_dyn_PlayerId(y.candidates)
		return v
	case WaitingFor_ProliferateChoice:
		v := y
		v.eligible = cln_dyn_TargetRef(y.eligible)
		return v
	case WaitingFor_TimeTravelChoice:
		v := y
		v.eligible = cln_dyn_TargetRef(y.eligible)
		return v
	case WaitingFor_ChooseObjectsSelection:
		v := y
		v.eligible = cln_dyn_TargetRef(y.eligible)
		v.trigger_event = cln_opt_GameEvent(y.trigger_event)
		return v
	case WaitingFor_CategoryChoice:
		v := y
		v.categories = cln_dyn_CoreType(y.categories)
		v.choose_filter = clone_TargetFilter(y.choose_filter)
		v.sacrifice_filter = clone_TargetFilter(y.sacrifice_filter)
		v.eligible_per_category = cln_dyn_dyn_ObjectId(y.eligible_per_category)
		v.remaining_players = cln_dyn_PlayerId(y.remaining_players)
		v.all_kept = cln_dyn_ObjectId(y.all_kept)
		v.scoped_players = cln_dyn_PlayerId(y.scoped_players)
		return v
	case WaitingFor_EachPlayerCopyChosenSelection:
		v := y
		v.eligible = cln_dyn_TargetRef(y.eligible)
		v.choose_filter = clone_TargetFilter(y.choose_filter)
		v.copy_modifications = cln_dyn_ContinuousModification(y.copy_modifications)
		v.remaining_players = cln_dyn_PlayerId(y.remaining_players)
		v.all_choices = cln_dyn_CopyChosenSelection(y.all_choices)
		v.scoped_players = cln_dyn_PlayerId(y.scoped_players)
		v.trigger_event = cln_opt_GameEvent(y.trigger_event)
		return v
	case WaitingFor_KeepWithinTotalPowerChoice:
		v := y
		v.eligible = cln_dyn_ObjectId(y.eligible)
		v.choose_filter = clone_TargetFilter(y.choose_filter)
		v.sacrifice_filter = clone_TargetFilter(y.sacrifice_filter)
		v.remaining_players = cln_dyn_PlayerId(y.remaining_players)
		v.all_kept = cln_dyn_ObjectId(y.all_kept)
		v.scoped_players = cln_dyn_PlayerId(y.scoped_players)
		return v
	case WaitingFor_KeepExactPermanentsChoice:
		v := y
		v.eligible = cln_dyn_ObjectId(y.eligible)
		v.choose_filter = clone_TargetFilter(y.choose_filter)
		v.sacrifice_filter = clone_TargetFilter(y.sacrifice_filter)
		v.remaining_players = cln_dyn_PlayerId(y.remaining_players)
		v.all_kept = cln_dyn_ObjectId(y.all_kept)
		v.scoped_players = cln_dyn_PlayerId(y.scoped_players)
		return v
	case WaitingFor_CopyRetarget:
		v := y
		v.target_slots = cln_dyn_CopyTargetSlot(y.target_slots)
		v.paradigm_remaining_offers = cln_opt_dyn_ObjectId(y.paradigm_remaining_offers)
		v.picks = cln_opt_dyn_opt_TargetRef(y.picks)
		v.announcer_election = cln_opt_AnnouncerElection(y.announcer_election)
		return v
	case WaitingFor_AssignCombatDamage:
		v := y
		v.blockers = cln_dyn_DamageSlot(y.blockers)
		v.assignment_modes = cln_dyn_CombatDamageAssignmentMode(y.assignment_modes)
		return v
	case WaitingFor_AssignBlockerDamage:
		v := y
		v.attackers = cln_dyn_ObjectId(y.attackers)
		return v
	case WaitingFor_DistributeAmong:
		v := y
		v.targets = cln_dyn_TargetRef(y.targets)
		v.scope = clone_DistributionScope(y.scope)
		return v
	case WaitingFor_MoveCountersDistribution:
		v := y
		v.available = cln_dyn_t2_CounterType_u32(y.available)
		v.destinations = cln_dyn_ObjectId(y.destinations)
		v.pending_effect = cln_ptr_ResolvedAbility(y.pending_effect)
		return v
	case WaitingFor_RemoveCountersChoice:
		v := y
		v.available = cln_dyn_t2_CounterType_u32(y.available)
		v.pending_effect = cln_ptr_ResolvedAbility(y.pending_effect)
		return v
	case WaitingFor_PayAmountChoice:
		v := y
		v.resource = clone_PayableResource(y.resource)
		v.pending_mana_ability = cln_ptr_PendingManaAbility(y.pending_mana_ability)
		return v
	case WaitingFor_RetargetChoice:
		v := y
		v.current_targets = cln_dyn_TargetRef(y.current_targets)
		v.slots = cln_dyn_RetargetSlotAddress(y.slots)
		v.slot_pools = cln_dyn_dyn_TargetRef(y.slot_pools)
		v.keep_is_distinct = cln_dyn_bool(y.keep_is_distinct)
		v.legal_new_targets = cln_dyn_TargetRef(y.legal_new_targets)
		return v
	case WaitingFor_CombatTaxPayment:
		v := y
		v.total_cost = clone_ManaCost(y.total_cost)
		v.per_creature = cln_dyn_t2_ObjectId_ManaCost(y.per_creature)
		v.pending = clone_CombatTaxPending(y.pending)
		return v
	case WaitingFor_PhyrexianPayment:
		v := y
		v.shards = cln_dyn_PhyrexianShard(y.shards)
		return v
	}
	return x
}

