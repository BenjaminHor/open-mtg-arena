		v.enter_with_counters = cln_dyn_t2_CounterType_QuantityExpr(y.enter_with_counters)
		return v
	case Effect_GainLife:
		v := y
		v.amount = clone_QuantityExpr(y.amount)
		v.player = clone_TargetFilter(y.player)
		return v
	case Effect_LoseLife:
		v := y
		v.amount = clone_QuantityExpr(y.amount)
		v.target = cln_opt_TargetFilter(y.target)
		return v
	case Effect_SetTapState:
		v := y
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_RemoveCounter:
		v := y
		v.count = clone_QuantityExpr(y.count)
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_Sacrifice:
		v := y
		v.target = clone_TargetFilter(y.target)
		v.count = clone_QuantityExpr(y.count)
		return v
	case Effect_DiscardCard:
		v := y
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_Mill:
		v := y
		v.count = clone_QuantityExpr(y.count)
		v.target = clone_TargetFilter(y.target)
		v.position = clone_LibraryPosition(y.position)
		return v
	case Effect_Scry:
		v := y
		v.count = clone_QuantityExpr(y.count)
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_PumpAll:
		v := y
		v.power = clone_PtValue(y.power)
		v.toughness = clone_PtValue(y.toughness)
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_DamageAll:
		v := y
		v.amount = clone_QuantityExpr(y.amount)
		v.target = clone_TargetFilter(y.target)
		v.player_filter = cln_opt_PlayerFilter(y.player_filter)
