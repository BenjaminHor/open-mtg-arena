clone_PerpetualModification :: proc(x: PerpetualModification) -> PerpetualModification {
	#partial switch y in x {
	case PerpetualModification_ModifyPowerToughness:
		v := y
		v.power = clone_QuantityExpr(y.power)
		v.toughness = clone_QuantityExpr(y.toughness)
		v.keywords = cln_dyn_Keyword(y.keywords)
		return v
	case PerpetualModification_GrantKeywords:
		v := y
		v.keywords = cln_dyn_Keyword(y.keywords)
		return v
	case PerpetualModification_Become:
		v := y
		v.creature_subtypes = cln_dyn_string(y.creature_subtypes)
		v.keywords = cln_dyn_Keyword(y.keywords)
		return v
	case PerpetualModification_ModifyCost:
		v := y
		v.amount = clone_ManaCost(y.amount)
		return v
	case PerpetualModification_GrantAbility:
		v := y
		v.modifications = cln_dyn_PerpetualGrantModification(y.modifications)
		return v
	}
	return x
}

