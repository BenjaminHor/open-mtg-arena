clone_GameState :: proc(x: GameState) -> GameState {
	out := x
	out.players = cln_dyn_Player(x.players)
	out.active_library_searches = clone_ActiveLibrarySearches(x.active_library_searches)
	out.active_search_decision_controls = clone_ActiveSearchDecisionControls(x.active_search_decision_controls)
	out.objects = clone_ObjectMap(x.objects)
	out.resolved_rules_journal = clone_ResolvedRulesJournal(x.resolved_rules_journal)
	out.active_payment_pins = cln_dyn_ManaPipId(x.active_payment_pins)
	out.active_simultaneous_entrants = cln_dyn_ObjectId(x.active_simultaneous_entrants)
	out.pre_entry_board_cache = clone_PreEntryBoardCache(x.pre_entry_board_cache)
	out.active_copy_token_resolution_tokens = cln_opt_dyn_ObjectId(x.active_copy_token_resolution_tokens)
	out.active_graveyard_permission_latch = cln_ptr_GraveyardPermissionLatch(x.active_graveyard_permission_latch)
	out.released_entry_rows = cln_dyn_int(x.released_entry_rows)
	out.battlefield = pvec_clone(x.battlefield)
	out.stack = pvec_clone(x.stack)
	out.stack_paid_facts = cln_map_ObjectId_StackPaidSnapshot(x.stack_paid_facts)
	out.exile = pvec_clone(x.exile)
	out.command_zone = pvec_clone(x.command_zone)
	out.combat = cln_opt_CombatState(x.combat)
	out.waiting_for = clone_WaitingFor(x.waiting_for)
	out.resolve_all_consent_run = cln_opt_ResolveAllConsentRun(x.resolve_all_consent_run)
	out.stack_resolution_session = cln_opt_StackResolutionSession(x.stack_resolution_session)
	out.active_interaction_slots = cln_dyn_ActiveInteractionSlot(x.active_interaction_slots)
	out.pending_replacement = cln_opt_PendingReplacement(x.pending_replacement)
	out.pending_combat_lifelink = cln_ptr_PendingCombatLifelink(x.pending_combat_lifelink)
	out.liminal_entries = cln_map_ObjectId_LiminalEntry(x.liminal_entries)
	out.pending_liminal_entry_resume = cln_opt_PendingLiminalEntryResume(x.pending_liminal_entry_resume)
	out.entering_aura_authority = cln_opt_EnteringAuraAuthority(x.entering_aura_authority)
	out.post_replacement_token_choice_applied = cln_opt_dyn_AppliedReplacementKey(x.post_replacement_token_choice_applied)
	out.deferred_entry_events = cln_dyn_ParkedEntry(x.deferred_entry_events)
	out.unsettled_entry_batch_events = cln_dyn_GameEvent(x.unsettled_entry_batch_events)
	out.layers_dirty = clone_LayersDirty(x.layers_dirty)
	out.static_gate_truth = cln_shared_dyn_t2_StaticGateKey_bool(x.static_gate_truth)
	out.trigger_index = clone_TriggerIndex(x.trigger_index)
	out.replacement_index = clone_ReplacementIndex(x.replacement_index)
	out.static_source_index = clone_StaticSourceIndex(x.static_source_index)
	out.play_trace = cln_ptr_PlayTrace(x.play_trace)
	out.precast_shortcut_runtime = clone_PrecastShortcutRuntime(x.precast_shortcut_runtime)
	out.life_safety_probe = cln_ptr_LifeSafetyProbe(x.life_safety_probe)
	out.public_state_dirty = clone_PublicStateDirty(x.public_state_dirty)
	out.transient_continuous_effects = pvec_clone(x.transient_continuous_effects)
