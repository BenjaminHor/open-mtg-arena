clone_FilterProp :: proc(x: FilterProp) -> FilterProp {
	#partial switch y in x {
	case FilterProp_ControllerMatches:
		v := y
		v.player = cln_ptr_PlayerFilter(y.player)
		return v
	case FilterProp_WithKeyword:
		v := y
		v.value = clone_Keyword(y.value)
		return v
	case FilterProp_WithoutKeyword:
		v := y
		v.value = clone_Keyword(y.value)
		return v
	case FilterProp_CanEnchant:
		v := y
		v.target = cln_ptr_TargetFilter(y.target)
		return v
	case FilterProp_Counters:
		v := y
		v.count = clone_QuantityExpr(y.count)
		return v
	case FilterProp_Cmc:
		v := y
		v.value = clone_QuantityExpr(y.value)
		return v
	case FilterProp_ManaCostIn:
		v := y
		v.costs = cln_dyn_ManaCost(y.costs)
		return v
	case FilterProp_AttachedTo:
		v := y
		v.to = clone_AttachmentReferent(y.to)
		return v
	case FilterProp_HasAnyAttachmentOf:
		v := y
		v.kinds = cln_dyn_AttachmentKind(y.kinds)
		return v
	case FilterProp_PtComparison:
		v := y
		v.value = clone_QuantityExpr(y.value)
		return v
	case FilterProp_AnyOf:
		v := y
		v.props = cln_dyn_FilterProp(y.props)
		return v
	case FilterProp_Not:
		v := y
		v.prop = cln_ptr_FilterProp(y.prop)
		return v
	case FilterProp_DifferentNameFrom:
		v := y
		v.filter = cln_ptr_TargetFilter(y.filter)
		return v
	case FilterProp_DistinctFrom:
		v := y
		v.reference = cln_ptr_TargetFilter(y.reference)
		return v
	case FilterProp_InAnyZone:
		v := y
		v.zones = cln_dyn_Zone(y.zones)
		return v
	case FilterProp_SharesQuality:
		v := y
		v.reference = cln_ptr_TargetFilter(y.reference)
		return v
	case FilterProp_DealtDamageThisTurn:
		v := y
		v.recipient = cln_opt_PlayerFilter(y.recipient)
		return v
	case FilterProp_TargetsOnly:
		v := y
		v.filter = cln_ptr_TargetFilter(y.filter)
		return v
	case FilterProp_Targets:
		v := y
		v.filter = cln_ptr_TargetFilter(y.filter)
		return v
	}
	return x
}

