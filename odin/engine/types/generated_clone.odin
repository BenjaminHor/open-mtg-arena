clone_CastingPermission :: proc(x: CastingPermission) -> CastingPermission {
	#partial switch y in x {
	case CastingPermission_ExileWithAltCost:
		v := y
		v.cost = clone_ManaCost(y.cost)
		v.constraint = cln_opt_CastPermissionConstraint(y.constraint)
		v.resolution_cleanup = cln_opt_ResolutionCastCleanup(y.resolution_cleanup)
		v.duration = cln_opt_Duration(y.duration)
		v.graveyard_replacement = cln_opt_SpellStackToGraveyardReplacement(y.graveyard_replacement)
		v.enters_with_modifications = clone_PendingEntersModifications(y.enters_with_modifications)
		v.cast_cost_modifier = cln_opt_CastCostModifier(y.cast_cost_modifier)
		return v
	case CastingPermission_PlayFromExile:
		v := y
		v.duration = clone_Duration(y.duration)
		v.card_filter = cln_opt_TargetFilter(y.card_filter)
		v.cast_cost_modifier = cln_opt_CastCostModifier(y.cast_cost_modifier)
		v.alt_ability_cost = cln_opt_AbilityCost(y.alt_ability_cost)
		return v
	case CastingPermission_ExileWithAltAbilityCost:
		v := y
		v.cost = clone_AbilityCost(y.cost)
		v.constraint = cln_opt_CastPermissionConstraint(y.constraint)
		v.duration = cln_opt_Duration(y.duration)
		v.cast_cost_modifier = cln_opt_CastCostModifier(y.cast_cost_modifier)
		return v
	case CastingPermission_Foretold:
		v := y
		v.cost = clone_ManaCost(y.cost)
		return v
	}
	return x
}

