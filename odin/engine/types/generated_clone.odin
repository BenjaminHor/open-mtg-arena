clone_ResolutionFrame :: proc(x: ResolutionFrame) -> ResolutionFrame {
	#partial switch y in x {
	case ResolutionFrame_AbilityContinuation:
		v := y
		v._0 = clone_AbilityContinuationFrame(y._0)
		return v
	case ResolutionFrame_RepeatFor:
		v := y
		v._0 = clone_PendingRepeatIteration(y._0)
		return v
	case ResolutionFrame_RepeatUntil:
		v := y
		v._0 = clone_PendingRepeatUntil(y._0)
		return v
	case ResolutionFrame_RepeatedOptionalPayment:
		v := y
		v._0 = clone_RepeatedOptionalPaymentFrame(y._0)
		return v
	case ResolutionFrame_ChangeZone:
		v := y
		v._0 = cln_ptr_ChangeZoneFrame(y._0)
		return v
	case ResolutionFrame_BatchDelivery:
		v := y
