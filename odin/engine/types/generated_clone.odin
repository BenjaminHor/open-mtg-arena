	case Effect_Adapt:
		v := y
		v.count = clone_QuantityExpr(y.count)
		return v
	case Effect_Endure:
		v := y
		v.amount = clone_QuantityExpr(y.amount)
		v.subject = clone_TargetFilter(y.subject)
		return v
	case Effect_BlightEffect:
		v := y
		v.player = clone_TargetFilter(y.player)
		return v
	case Effect_Seek:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		v.count = clone_QuantityExpr(y.count)
		return v
	case Effect_SetLifeTotal:
		v := y
		v.target = clone_TargetFilter(y.target)
		v.amount = clone_QuantityExpr(y.amount)
		return v
	case Effect_ExchangeLifeWithStat:
		v := y
		v.player = clone_TargetFilter(y.player)
		return v
	case Effect_ExchangeLifeTotals:
		v := y
		v.player_a = clone_TargetFilter(y.player_a)
		v.player_b = clone_TargetFilter(y.player_b)
		return v
	case Effect_GiveControl:
		v := y
		v.target = clone_TargetFilter(y.target)
		v.recipient = clone_TargetFilter(y.recipient)
		return v
	case Effect_RemoveFromCombat:
		v := y
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_BecomeBlocked:
		v := y
		v.target = clone_TargetFilter(y.target)
		return v
	case Effect_Conjure:
		v := y
		v.cards = cln_dyn_ConjureCard(y.cards)
		v.library_position = cln_opt_LibraryPosition(y.library_position)
		v.library_players = cln_opt_PlayerFilter(y.library_players)
		return v
	case Effect_CreateCardCopyByName:
		v := y
		v.count = clone_QuantityExpr(y.count)
		return v
	case Effect_ApplyPerpetual:
		v := y
		v.target = clone_TargetFilter(y.target)
		v.modification = clone_PerpetualModification(y.modification)
		return v
	case Effect_Intensify:
		v := y
		v.amount = clone_QuantityExpr(y.amount)
		return v
	case Effect_ChooseOneOf:
		v := y
		v.chooser = clone_PlayerFilter(y.chooser)
		v.branches = cln_dyn_AbilityDefinition(y.branches)
		return v
	}
	return x
}

