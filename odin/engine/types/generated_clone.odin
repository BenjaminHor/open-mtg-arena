clone_CastOfferKind :: proc(x: CastOfferKind) -> CastOfferKind {
	#partial switch y in x {
	case CastOfferKind_Miracle:
		v := y
		v.cost = clone_ManaCost(y.cost)
		return v
	case CastOfferKind_Madness:
		v := y
		v.cost = clone_ManaCost(y.cost)
		return v
	case CastOfferKind_Paradigm:
		v := y
		v.offers = cln_dyn_ObjectId(y.offers)
		return v
	case CastOfferKind_Cascade:
		v := y
		v.exiled_misses = cln_dyn_ObjectId(y.exiled_misses)
		return v
	case CastOfferKind_Discover:
		v := y
		v.exiled_misses = cln_dyn_ObjectId(y.exiled_misses)
		return v
	case CastOfferKind_Ripple:
		v := y
		v.remaining_hits = cln_dyn_ObjectId(y.remaining_hits)
		v.revealed_misses = cln_dyn_ObjectId(y.revealed_misses)
		return v
	case CastOfferKind_FreeCastWindow:
		v := y
		v.candidates = cln_dyn_ObjectId(y.candidates)
		v.face_policy = clone_ResolutionCastFacePolicy(y.face_policy)
		v.zones = cln_dyn_Zone(y.zones)
		v.graveyard_replacement = cln_opt_SpellStackToGraveyardReplacement(y.graveyard_replacement)
		v.member_pool = cln_dyn_ObjectId(y.member_pool)
		v.enters_with_modifications = clone_PendingEntersModifications(y.enters_with_modifications)
		return v
	case CastOfferKind_GraveyardPaidCast:
		v := y
		v.graveyard_replacement = cln_opt_SpellStackToGraveyardReplacement(y.graveyard_replacement)
		v.enters_with_modifications = clone_PendingEntersModifications(y.enters_with_modifications)
		v.additional_cost = cln_opt_ManaCost(y.additional_cost)
		v.cleanup = clone_ResolutionCastCleanup(y.cleanup)
		return v
	}
	return x
}

