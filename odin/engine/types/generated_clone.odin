clone_PendingCounterPostAction :: proc(x: PendingCounterPostAction) -> PendingCounterPostAction {
	#partial switch y in x {
	case PendingCounterPostAction_ContinueAmassAfterTokenCreation:
		v := y
		v.ability = cln_ptr_ResolvedAbility(y.ability)
		return v
	case PendingCounterPostAction_FinalizeAmass:
		v := y
		v.ability = cln_ptr_ResolvedAbility(y.ability)
		return v
	case PendingCounterPostAction_FinalizeTokenEntry:
		v := y
		v.sacrifice_at = cln_opt_Duration(y.sacrifice_at)
		return v
	case PendingCounterPostAction_ContinueTokenCreation:
		v := y
		v.spec = cln_ptr_TokenSpec(y.spec)
		return v
	case PendingCounterPostAction_ContinueTokenEventDelivery:
		v := y
		v.delivery = cln_ptr_PendingTokenEventDelivery(y.delivery)
		return v
	case PendingCounterPostAction_ContinueCopyTokenCreation:
		v := y
		v.copy = cln_ptr_CopyTokenSpec(y.copy)
		v.enter_with_counters = cln_dyn_t2_CounterType_u32(y.enter_with_counters)
		return v
	case PendingCounterPostAction_ApplyCopyTokenModificationsAndFinalize:
		v := y
		v.remaining_modifications = cln_dyn_ContinuousModification(y.remaining_modifications)
		return v
	case PendingCounterPostAction_ContinueCopyTokenEntryAfterAuraHost:
		v := y
		v.tail = cln_ptr_CopyTokenEntryTail(y.tail)
		return v
	case PendingCounterPostAction_ContinueNonLiminalCopyTokenAfterEntryPayment:
		v := y
		v.tail = cln_ptr_CopyTokenEntryTail(y.tail)
		return v
	case PendingCounterPostAction_FinalizeCommittedLiminalTokenEntry:
		v := y
		v.sacrifice_at = cln_opt_Duration(y.sacrifice_at)
		v.created_ids = cln_dyn_ObjectId(y.created_ids)
		return v
	case PendingCounterPostAction_ContinueLiminalCopyTokenBatch:
		v := y
		v.copy = cln_ptr_CopyTokenSpec(y.copy)
		v.enter_with_counters = cln_dyn_t2_CounterType_u32(y.enter_with_counters)
		return v
	case PendingCounterPostAction_FinishCopyTargetChoiceEntry:
		v := y
		v.resume_stage = clone_CopyEntryResumeStage(y.resume_stage)
		return v
	case PendingCounterPostAction_ContinueZoneDeliveryTail:
		v := y
		v.duration = cln_opt_Duration(y.duration)
		return v
	case PendingCounterPostAction_ContinuePlayerScopeSacrifice:
		v := y
		v.kept = cln_dyn_ObjectId(y.kept)
		v.scoped_players = cln_dyn_PlayerId(y.scoped_players)
		v.sacrifice_filter = clone_TargetFilter(y.sacrifice_filter)
		return v
	}
	return x
}

