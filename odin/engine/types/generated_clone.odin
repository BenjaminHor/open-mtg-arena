clone_CardFace :: proc(x: CardFace) -> CardFace {
	out := x
	out.mana_cost = clone_ManaCost(x.mana_cost)
	out.card_type = clone_CardType(x.card_type)
	out.power = cln_opt_PtValue(x.power)
	out.toughness = cln_opt_PtValue(x.toughness)
	out.keywords = cln_dyn_Keyword(x.keywords)
	out.abilities = cln_dyn_AbilityDefinition(x.abilities)
	out.triggers = cln_dyn_TriggerDefinition(x.triggers)
	out.static_abilities = cln_dyn_StaticDefinition(x.static_abilities)
	out.replacements = cln_dyn_ReplacementDefinition(x.replacements)
	out.cleave_variant = cln_opt_CleaveVariant(x.cleave_variant)
	out.color_override = cln_opt_dyn_ManaColor(x.color_override)
	out.color_identity = cln_dyn_ManaColor(x.color_identity)
	out.modal = cln_opt_ModalChoice(x.modal)
	out.additional_cost = cln_opt_AdditionalCost(x.additional_cost)
	out.casting_restrictions = cln_dyn_CastingRestriction(x.casting_restrictions)
	out.casting_options = cln_dyn_SpellCastingOption(x.casting_options)
	out.solve_condition = cln_opt_SolveCondition(x.solve_condition)
	out.strive_cost = cln_opt_ManaCost(x.strive_cost)
	out.attraction_lights = cln_dyn_u8(x.attraction_lights)
	out.parse_warnings = cln_dyn_OracleDiagnostic(x.parse_warnings)
	out.metadata = clone_CardMetadata(x.metadata)
	out.rarities = cln_dyn_Rarity(x.rarities)
	return out
}

clone_ManaCost :: proc(x: ManaCost) -> ManaCost {
	#partial switch y in x {
	case ManaCost_Cost:
		v := y
		v.shards = cln_dyn_ManaCostShard(y.shards)
		return v
	}
	return x
}

