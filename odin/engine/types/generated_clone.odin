	case TriggerCollectionOperation_RecordTriggerFired:
		v := y
		v.constraint = cln_opt_TriggerConstraint(y.constraint)
		v.source_context = cln_ptr_opt_TriggerSourceContext(y.source_context)
		v.definition_ref = cln_opt_TriggerDefinitionRef(y.definition_ref)
		v.event = clone_GameEvent(y.event)
		return v
	case TriggerCollectionOperation_RecordBatchedZoneChanges:
		v := y
		v.definition_ref = clone_TriggerDefinitionRef(y.definition_ref)
		v.turn_zone_change_keys = cln_dyn_t2_u32_int(y.turn_zone_change_keys)
		return v
	case TriggerCollectionOperation_RecordCombatDamageCastingPermission:
		v := y
		v.creature_types = cln_dyn_string(y.creature_types)
		return v
	}
	return x
}

