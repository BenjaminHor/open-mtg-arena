	case ProposedEvent_Destroy:
		v := y
		v.applied = cln_dyn_AppliedReplacementKey(y.applied)
		return v
	case ProposedEvent_Sacrifice:
		v := y
		v.applied = cln_dyn_AppliedReplacementKey(y.applied)
		return v
	case ProposedEvent_BeginTurn:
		v := y
		v.applied = cln_dyn_AppliedReplacementKey(y.applied)
		return v
	case ProposedEvent_BeginPhase:
		v := y
		v.applied = cln_dyn_AppliedReplacementKey(y.applied)
		return v
	case ProposedEvent_ProduceMana:
		v := y
		v.applied = cln_dyn_AppliedReplacementKey(y.applied)
		return v
	case ProposedEvent_EmptyManaPool:
		v := y
		v.units = cln_dyn_UnitDecision(y.units)
		v.applied = cln_dyn_AppliedReplacementKey(y.applied)
		return v
	case ProposedEvent_Planeswalk:
		v := y
		v.applied = cln_dyn_AppliedReplacementKey(y.applied)
		return v
	case ProposedEvent_Attach:
		v := y
		v.applied = cln_dyn_AppliedReplacementKey(y.applied)
		return v
	}
	return x
}

