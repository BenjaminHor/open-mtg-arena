clone_ResolvedAbility :: proc(x: ResolvedAbility) -> ResolvedAbility {
	out := x
	out.effect = clone_Effect(x.effect)
	out.targets = cln_dyn_TargetRef(x.targets)
	out.reads_return_result = cln_opt_t2_ReturnResultId_ReturnResultReadSpec(x.reads_return_result)
	out.trigger_source = cln_opt_TriggerSourceContext(x.trigger_source)
	out.trigger_definition_ref = cln_opt_TriggerDefinitionRef(x.trigger_definition_ref)
	out.delayed_origin = cln_ptr_DelayedAbilityOrigin(x.delayed_origin)
	out.target_incarnations = cln_dyn_ObjectIncarnationRef(x.target_incarnations)
	out.target_pins = cln_dyn_opt_ObjectIncarnationRef(x.target_pins)
	out.legacy_selected_target_incarnations = cln_dyn_ObjectIncarnationRef(x.legacy_selected_target_incarnations)
	out.chosen_target_slots = clone_ChosenTargetSlots(x.chosen_target_slots)
	out.activation_cost_reduction = cln_opt_CostReduction(x.activation_cost_reduction)
	out.activation_record = cln_ptr_AbilityActivationRecord(x.activation_record)
	out.announced_usage_key = cln_ptr_AbilityUsageKey(x.announced_usage_key)
	out.illegal_target_slots = cln_dyn_int(x.illegal_target_slots)
	out.unjudged_target_slots = cln_dyn_int(x.unjudged_target_slots)
	out.illegal_local_target_slots = cln_dyn_int(x.illegal_local_target_slots)
	out.declared_player_target_slots = cln_dyn_DeclaredPlayerTargetSlot(x.declared_player_target_slots)
	out.sub_ability = cln_ptr_ResolvedAbility(x.sub_ability)
	out.else_ability = cln_ptr_ResolvedAbility(x.else_ability)
	out.coin_branches = cln_ptr_ResolvedCoinBranches(x.coin_branches)
	out.duration = cln_opt_Duration(x.duration)
	out.condition = cln_opt_AbilityCondition(x.condition)
	out.context_ = clone_SpellContext(x.context_)
	out.optional_player = cln_opt_TargetFilter(x.optional_player)
	out.multi_target = cln_opt_MultiTargetSpec(x.multi_target)
	out.target_constraints = cln_dyn_TargetSelectionConstraint(x.target_constraints)
	out.selected_mode_labels = cln_dyn_string(x.selected_mode_labels)
	out.repeat_for = cln_opt_QuantityExpr(x.repeat_for)
	out.announced_x = cln_opt_QuantityExpr(x.announced_x)
	out.unless_pay = cln_opt_UnlessPayModifier(x.unless_pay)
	out.distribution = cln_opt_dyn_t2_TargetRef_u32(x.distribution)
	out.player_scope = cln_opt_PlayerFilter(x.player_scope)
	out.cost_paid_object = cln_opt_CostPaidObjectSnapshot(x.cost_paid_object)
	out.noted_mana_payment = cln_opt_NotedManaPayment(x.noted_mana_payment)
	out.cost_paid_objects = cln_dyn_CostPaidObjectRecord(x.cost_paid_objects)
	out.effect_context_object = cln_opt_CostPaidObjectSnapshot(x.effect_context_object)
	out.amassed_army_object = cln_opt_CostPaidObjectSnapshot(x.amassed_army_object)
	out.may_trigger_origin = cln_opt_MayTriggerOrigin(x.may_trigger_origin)
	out.target_chooser = cln_opt_TargetFilter(x.target_chooser)
	out.chosen_players = cln_dyn_PlayerId(x.chosen_players)
	out.repeat_until = cln_opt_RepeatContinuation(x.repeat_until)
	out.replacement_applied = cln_dyn_AppliedReplacementKey(x.replacement_applied)
	out.modal = cln_opt_ModalChoice(x.modal)
	out.mode_abilities = cln_dyn_AbilityDefinition(x.mode_abilities)
	return out
}

