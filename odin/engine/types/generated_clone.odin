	if x == nil do return nil
	p := new(PlayerFilter)
	p^ = clone_PlayerFilter(x^)
	return p
}

clone_TargetFilter :: proc(x: TargetFilter) -> TargetFilter {
	#partial switch y in x {
	case TargetFilter_Typed:
		v := y
		v._0 = clone_TypedFilter(y._0)
		return v
	case TargetFilter_Not:
		v := y
		v.filter = cln_ptr_TargetFilter(y.filter)
		return v
	case TargetFilter_Or:
		v := y
		v.filters = cln_dyn_TargetFilter(y.filters)
		return v
	case TargetFilter_And:
		v := y
		v.filters = cln_dyn_TargetFilter(y.filters)
		return v
	case TargetFilter_PlayerMatching:
		v := y
		v.player = cln_ptr_PlayerFilter(y.player)
		return v
	case TargetFilter_TrackedSetFiltered:
		v := y
		v.filter = cln_ptr_TargetFilter(y.filter)
		return v
	case TargetFilter_ChosenDamageSource:
		v := y
		v.filter = cln_ptr_TargetFilter(y.filter)
		return v
	}
	return x
}

