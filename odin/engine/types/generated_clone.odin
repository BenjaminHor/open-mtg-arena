clone_PendingDiscardForCostResume :: proc(x: PendingDiscardForCostResume) -> PendingDiscardForCostResume {
	#partial switch y in x {
	case PendingDiscardForCostResume_Chosen:
		v := y
		v.pending = clone_PendingCast(y.pending)
		v.chosen = cln_dyn_ObjectId(y.chosen)
		return v
	case PendingDiscardForCostResume_Random:
		v := y
		v.pending = clone_PendingCast(y.pending)
		v.remaining_eligible = cln_dyn_ObjectId(y.remaining_eligible)
		v.paused_pick = cln_ptr_RandomDiscardCostPick(y.paused_pick)
		return v
	}
	return x
}

