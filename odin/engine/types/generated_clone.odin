clone_GameEvent :: proc(x: GameEvent) -> GameEvent {
	#partial switch y in x {
	case GameEvent_HiddenSearchViewed:
		v := y
		v.cards = cln_dyn_LibrarySearchCardView(y.cards)
		v.audience = cln_dyn_PlayerId(y.audience)
		return v
	case GameEvent_AbilityActivated:
		v := y
		v.departed_source_lki = cln_ptr_LKISnapshot(y.departed_source_lki)
		v.activation_cost = clone_BoundActivationCost(y.activation_cost)
		return v
	case GameEvent_ZoneChanged:
		v := y
		v.record = cln_ptr_ZoneChangeRecord(y.record)
		return v
	case GameEvent_TappedForMana:
		v := y
		v.produced = cln_dyn_ManaType(y.produced)
		return v
	case GameEvent_ManaAbilityProduced:
		v := y
		v.produced = cln_dyn_ManaType(y.produced)
		return v
	case GameEvent_CreatureExerted:
		v := y
		v.attack_permission = cln_opt_TriggerDefinitionRef(y.attack_permission)
		return v
	case GameEvent_CreatureEnlisted:
		v := y
		v.tapped_snapshot = cln_ptr_CostPaidObjectSnapshot(y.tapped_snapshot)
		return v
	case GameEvent_PlayerLost:
		v := y
		v.reasons = cln_dyn_LossReason(y.reasons)
		return v
	case GameEvent_AbilityTriggered:
		v := y
		v.causes = cln_dyn_GameEvent(y.causes)
		return v
	case GameEvent_ResolutionHalted:
		v := y
		v.involved = cln_dyn_ObjectId(y.involved)
		return v
	case GameEvent_SagaChapterAbilityResolved:
		v := y
		v.saga = cln_ptr_TriggerSourceContext(y.saga)
		return v
	case GameEvent_EffectResolved:
		v := y
		v.subject = cln_ptr_EventObjectSnapshot(y.subject)
		return v
	case GameEvent_AttackersDeclared:
		v := y
		v.attacker_ids = cln_dyn_ObjectId(y.attacker_ids)
		v.attacks = cln_dyn_t2_ObjectId_AttackTarget(y.attacks)
		v.declaration_records = cln_dyn_AttackDeclarationRecord(y.declaration_records)
		return v
	case GameEvent_BlockersDeclared:
		v := y
		v.assignments = cln_dyn_t2_ObjectId_ObjectId(y.assignments)
		return v
	case GameEvent_CombatTaxDeclined:
		v := y
		v.dropped = cln_dyn_ObjectId(y.dropped)
		return v
	case GameEvent_VehicleCrewed:
		v := y
		v.creatures = cln_dyn_ObjectId(y.creatures)
		return v
	case GameEvent_Saddled:
		v := y
		v.creatures = cln_dyn_ObjectId(y.creatures)
		return v
	case GameEvent_CardsRevealed:
		v := y
		v.card_ids = cln_dyn_ObjectId(y.card_ids)
		v.card_names = cln_dyn_string(y.card_names)
		v.occurrences = cln_dyn_ObjectIncarnationRef(y.occurrences)
		return v
	case GameEvent_ChosenNumbersRevealed:
		v := y
		v.numbers = cln_dyn_t2_PlayerId_u32(y.numbers)
		return v
	case GameEvent_CombatDamageDealtToPlayer:
		v := y
		v.source_amounts = cln_dyn_t2_ObjectId_u32(y.source_amounts)
		v.source_incarnations = cln_dyn_ObjectIncarnationRef(y.source_incarnations)
		return v
	case GameEvent_StartingPlayerContest:
		v := y
		v.rounds = cln_dyn_ContestRound(y.rounds)
		return v
	case GameEvent_AttractionsRolledToVisit:
		v := y
		v.rolls = cln_dyn_u8(y.rolls)
		return v
	case GameEvent_CreatureExploited:
		v := y
		v.record = cln_ptr_ZoneChangeRecord(y.record)
		return v
	case GameEvent_VoteResolved:
		v := y
		v.tallies = cln_dyn_t2_string_u32(y.tallies)
		return v
	}
	return x
}

