	if x == nil do return nil
	p := new(ParsedCondition)
	p^ = clone_ParsedCondition(x^)
	return p
}

clone_ParsedCondition :: proc(x: ParsedCondition) -> ParsedCondition {
	#partial switch y in x {
	case ParsedCondition_SourceLacksKeyword:
		v := y
		v.keyword = clone_Keyword(y.keyword)
		return v
	case ParsedCondition_HandSizeOneOf:
		v := y
		v.counts = cln_dyn_int(y.counts)
		return v
	case ParsedCondition_QuantityVsEachOpponent:
		v := y
		v.lhs = clone_QuantityRef(y.lhs)
		v.rhs = clone_QuantityRef(y.rhs)
		return v
	case ParsedCondition_QuantityComparison:
		v := y
		v.lhs = clone_QuantityExpr(y.lhs)
		v.rhs = clone_QuantityExpr(y.rhs)
		return v
	case ParsedCondition_YouControlLandSubtypeAny:
		v := y
		v.subtypes = cln_dyn_string(y.subtypes)
		return v
	case ParsedCondition_ControlsCreatureWithKeyword:
		v := y
		v.keyword = clone_Keyword(y.keyword)
		return v
	case ParsedCondition_YouAttackedWithAtLeast:
		v := y
		v.filter = cln_opt_TargetFilter(y.filter)
		return v
	case ParsedCondition_YouCastSpellThisTurn:
		v := y
		v.filter = cln_opt_TargetFilter(y.filter)
		return v
	case ParsedCondition_BattlefieldEntriesThisTurn:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case ParsedCondition_PlayerCountAtLeast:
		v := y
		v.filter = clone_PlayerFilter(y.filter)
		return v
	case ParsedCondition_CurrentPhaseIs:
		v := y
		v.phases = cln_dyn_Phase(y.phases)
		return v
	case ParsedCondition_SpellTargetsFilter:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case ParsedCondition_And:
		v := y
		v.conditions = cln_dyn_ParsedCondition(y.conditions)
		return v
	case ParsedCondition_Or:
		v := y
		v.conditions = cln_dyn_ParsedCondition(y.conditions)
		return v
	case ParsedCondition_Not:
		v := y
		v.condition = cln_ptr_ParsedCondition(y.condition)
		return v
	}
	return x
}

