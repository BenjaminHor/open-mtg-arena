clone_AbilityCost :: proc(x: AbilityCost) -> AbilityCost {
	#partial switch y in x {
	case AbilityCost_Mana:
		v := y
		v.cost = clone_ManaCost(y.cost)
		return v
	case AbilityCost_ManaDynamic:
		v := y
		v.quantity = clone_QuantityExpr(y.quantity)
		return v
	case AbilityCost_Sacrifice:
		v := y
		v._0 = clone_SacrificeCost(y._0)
		return v
	case AbilityCost_PayLife:
		v := y
		v.amount = clone_QuantityExpr(y.amount)
		return v
	case AbilityCost_Discard:
		v := y
		v.count = clone_QuantityExpr(y.count)
		v.filter = cln_opt_TargetFilter(y.filter)
		return v
	case AbilityCost_Exile:
		v := y
		v.filter = cln_opt_TargetFilter(y.filter)
		return v
	case AbilityCost_ExileMaterials:
		v := y
		v.materials = clone_TargetFilter(y.materials)
		return v
	case AbilityCost_ExileWithAggregate:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case AbilityCost_TapCreatures:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case AbilityCost_RemoveCounter:
		v := y
		v.target = cln_opt_TargetFilter(y.target)
		return v
	case AbilityCost_PayEnergy:
		v := y
		v.amount = clone_QuantityExpr(y.amount)
		return v
	case AbilityCost_PaySpeed:
		v := y
		v.amount = clone_QuantityExpr(y.amount)
		return v
	case AbilityCost_ReturnToHand:
		v := y
		v.filter = cln_opt_TargetFilter(y.filter)
		return v
	case AbilityCost_UnattachFrom:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		return v
	case AbilityCost_Reveal:
		v := y
		v.count = clone_QuantityExpr(y.count)
		v.filter = cln_opt_TargetFilter(y.filter)
		return v
	case AbilityCost_Behold:
		v := y
		v.filter = clone_TargetFilter(y.filter)
		v.type_choice = cln_opt_ChoiceType(y.type_choice)
		return v
	case AbilityCost_Composite:
		v := y
		v.costs = cln_dyn_AbilityCost(y.costs)
		return v
	case AbilityCost_OneOf:
		v := y
		v.costs = cln_dyn_AbilityCost(y.costs)
		return v
	case AbilityCost_Waterbend:
		v := y
		v.cost = clone_ManaCost(y.cost)
		return v
	case AbilityCost_NinjutsuFamily:
		v := y
		v.mana_cost = clone_ManaCost(y.mana_cost)
		return v
	case AbilityCost_EffectCost:
		v := y
		v.effect = cln_ptr_Effect(y.effect)
		return v
	case AbilityCost_PerCounter:
		v := y
		v.target = clone_TargetFilter(y.target)
		v.base = cln_ptr_AbilityCost(y.base)
		return v
	}
	return x
}

