clone_PendingCostMoveResume :: proc(x: PendingCostMoveResume) -> PendingCostMoveResume {
	#partial switch y in x {
	case PendingCostMoveResume_Cast:
		v := y
		v.pending = cln_ptr_PendingCast(y.pending)
		v.chosen = cln_dyn_ObjectId(y.chosen)
		v.completion = clone_PendingCostMoveCompletion(y.completion)
		v.deferred_cost_events = cln_dyn_GameEvent(y.deferred_cost_events)
		v.departure_record_indices = cln_dyn_int(y.departure_record_indices)
		return v
	case PendingCostMoveResume_SacrificeForCost:
		v := y
		v.pending = cln_ptr_PendingCast(y.pending)
		v.chosen = cln_dyn_ObjectId(y.chosen)
		v.completion = clone_PendingSacrificeCostCompletion(y.completion)
		v.deferred_cost_events = cln_dyn_GameEvent(y.deferred_cost_events)
		v.departure_record_indices = cln_dyn_int(y.departure_record_indices)
		return v
	case PendingCostMoveResume_WardSacrificePayment:
		v := y
		v.pending_effect = cln_ptr_ResolvedAbility(y.pending_effect)
		v.resume = clone_WardSacrificePaymentResume(y.resume)
		v.trigger_event = cln_opt_GameEvent(y.trigger_event)
		return v
	case PendingCostMoveResume_ReplacementMayCost:
		v := y
		v.remaining = cln_dyn_ObjectId(y.remaining)
		v.outer_replacement = cln_ptr_PendingReplacement(y.outer_replacement)
		return v
	case PendingCostMoveResume_ReplacementMayCostInnerChoice:
		v := y
		v.outer_replacement = cln_ptr_PendingReplacement(y.outer_replacement)
		return v
	case PendingCostMoveResume_Foretell:
		v := y
		v.cost = clone_ManaCost(y.cost)
		return v
	case PendingCostMoveResume_CollectEvidencePayment:
		v := y
		v.chosen = cln_dyn_ObjectId(y.chosen)
		v.resume = cln_ptr_CollectEvidenceResume(y.resume)
		return v
	case PendingCostMoveResume_UnlessBouncePayment:
		v := y
		v.permanents = cln_dyn_ObjectId(y.permanents)
		v.pending_effect = cln_ptr_ResolvedAbility(y.pending_effect)
		return v
	case PendingCostMoveResume_ManaAbilityPayment:
		v := y
		v.pending = cln_ptr_PendingManaAbility(y.pending)
		v.cursor = clone_ManaAbilityCostCursor(y.cursor)
		return v
	case PendingCostMoveResume_ActivationMillPayment:
		v := y
		v.pending = cln_ptr_PendingCast(y.pending)
		return v
	case PendingCostMoveResume_CounterCostRemovalPayment:
		v := y
		v.pending = cln_ptr_PendingCast(y.pending)
		v.removal = cln_ptr_PausedCounterCostRemoval(y.removal)
		v.completion = clone_PendingCostMoveCompletion(y.completion)
		return v
	case PendingCostMoveResume_LoyaltyActivation:
		v := y
		v.resolved = cln_ptr_ResolvedAbility(y.resolved)
		return v
	case PendingCostMoveResume_CounterAdditionUnlessPayment:
		v := y
		v.cost = clone_AbilityCost(y.cost)
		v.pending_effect = cln_ptr_ResolvedAbility(y.pending_effect)
		v.trigger_event = cln_opt_GameEvent(y.trigger_event)
		v.remaining = cln_dyn_PlayerId(y.remaining)
		v.unpaid_suffix = cln_ptr_UnpaidCostSuffix(y.unpaid_suffix)
		return v
	case PendingCostMoveResume_RandomDiscardUnlessPayment:
		v := y
		v._0 = cln_ptr_RandomDiscardUnlessPaymentResume(y._0)
		return v
	case PendingCostMoveResume_TurnFaceUpCostMove:
		v := y
		v.chosen = cln_dyn_ObjectId(y.chosen)
		v.remaining_cost = cln_ptr_AbilityCost(y.remaining_cost)
		v.deferred_cost_events = cln_dyn_GameEvent(y.deferred_cost_events)
		v.departure_record_indices = cln_dyn_int(y.departure_record_indices)
		return v
	case PendingCostMoveResume_PlayerScopeUnlessSettlement:
		v := y
		v._0 = cln_ptr_PlayerScopeUnlessSettlement(y._0)
		return v
	}
	return x
}

cln_ptr_ManaAbilityResume :: proc(x: ^ManaAbilityResume) -> ^ManaAbilityResume {
	if x == nil do return nil
	p := new(ManaAbilityResume)
	p^ = clone_ManaAbilityResume(x^)
	return p
}

clone_DeferredLifeCostResume :: proc(x: DeferredLifeCostResume) -> DeferredLifeCostResume {
	#partial switch y in x {
	case DeferredLifeCostResume_Cast:
		v := y
		v.pending = cln_ptr_PendingCast(y.pending)
		v.remaining_life_payments = cln_dyn_u32(y.remaining_life_payments)
		return v
	case DeferredLifeCostResume_PayAmount:
		v := y
		v.pending_entry = cln_ptr_PendingReplacement(y.pending_entry)
		return v
	case DeferredLifeCostResume_ManaRoot:
		v := y
		v.resume = cln_ptr_ManaAbilityResume(y.resume)
		v.remaining_life_payments = cln_dyn_u32(y.remaining_life_payments)
		return v
	case DeferredLifeCostResume_TurnFaceUp:
		v := y
		v.remaining_cost = cln_ptr_AbilityCost(y.remaining_cost)
		return v
	}
	return x
}

cln_ptr_PendingTriggerContext :: proc(x: ^PendingTriggerContext) -> ^PendingTriggerContext {
	if x == nil do return nil
	p := new(PendingTriggerContext)
	p^ = clone_PendingTriggerContext(x^)
	return p
}

